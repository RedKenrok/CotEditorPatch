+
+import Foundation
+import Testing
+@testable import CotEditor
+
+/// Creating, renaming, moving and deleting items of a remote folder, against a fake server, with the
+/// open files that the changes affect.
+@MainActor struct RemoteFolderChangeTests {
+
+    // MARK: Protocol
+
+    @Test func folderChangeRequestsAreEncoded() throws {
+
+        let mkdir = RemoteSFTPCodec.packet(for: .mkdir(path: "/d", attributes: RemoteFileAttributes(permissions: 0o777)), id: 1)
+        #expect(mkdir == RemoteSFTPCodec.frame(type: .mkdir, payload: Data([0, 0, 0, 1, 0, 0, 0, 2]) + Data("/d".utf8) + Data([0, 0, 0, 4, 0, 0, 0x01, 0xFF])))
+
+        let rmdir = RemoteSFTPCodec.packet(for: .rmdir(path: "/d"), id: 2)
+        #expect(rmdir == RemoteSFTPCodec.frame(type: .rmdir, payload: Data([0, 0, 0, 2, 0, 0, 0, 2]) + Data("/d".utf8)))
+
+        let rename = RemoteSFTPCodec.packet(for: .rename(from: "/a", to: "/b"), id: 3)
+        #expect(rename == RemoteSFTPCodec.frame(type: .rename, payload: Data([0, 0, 0, 3, 0, 0, 0, 2]) + Data("/a".utf8) + Data([0, 0, 0, 2]) + Data("/b".utf8)))
+    }
+
+
+    @Test func numberedNamesFollowTheLocalFileBrowser() {
+
+        #expect(Array(RemoteItemName.variants(of: "Untitled.txt").prefix(3)) == ["Untitled.txt", "Untitled 2.txt", "Untitled 3.txt"])
+        #expect(Array(RemoteItemName.variants(of: "untitled folder").prefix(2)) == ["untitled folder", "untitled folder 2"])
+        #expect(Array(RemoteItemName.variants(of: "notes 4.md").prefix(2)) == ["notes 4.md", "notes 5.md"], "a numbered name counts on")
+        #expect(Array(RemoteItemName.variants(of: ".profile").prefix(2)) == [".profile", ".profile 2"], "a leading dot is no extension")
+    }
+
+
+    // MARK: Creating
+
+    @Test(.timeLimit(.minutes(1))) func newItemsTakeTheFirstFreeNameAndTheServersUmask() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.configure { $0.umask = 0o002 }
+        await bed.server.addFile("/srv/Untitled.txt", "taken")
+
+        let file = try await bed.pool.withFolderEditingConnection(to: bed.endpoint, destination: .fake) { transport in
+            try await RemoteFolderChanges.create(.file, named: "Untitled.txt", in: "/srv", with: transport)
+        }
+        let folder = try await bed.pool.withFolderEditingConnection(to: bed.endpoint, destination: .fake) { transport in
+            try await RemoteFolderChanges.create(.folder, named: "untitled folder", in: "/srv", with: transport)
+        }
+
+        #expect(file.name == "Untitled 2.txt")
+        #expect(await bed.server.contents(of: "/srv/Untitled.txt") == "taken", "the existing file is untouched")
+        #expect(await bed.server.contents(of: "/srv/Untitled 2.txt") == "")
+        #expect(await bed.server.file(at: "/srv/Untitled 2.txt")?.mode == 0o664, "the file asks for 0666 and the server narrows it")
+        #expect(folder.name == "untitled folder")
+        #expect(folder.attributes.mode == 0o775, "the folder asks for 0777 and the server narrows it")
+        #expect(await bed.server.log.contains(.open(path: "/srv/Untitled.txt", flags: RemoteOpenFlags([.write, .create, .exclusive]).rawValue)))
+
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aCreatedItemShowsInTheTreeAtOnce() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/dir/a.txt", "")
+        let session = try await self.makeSession(bed)
+
+        let first = try #require(try await session.createItem(.folder, in: session.tree.root))
+        let second = try #require(try await session.createItem(.folder, in: session.tree.root))
+
+        #expect(first.name == "untitled folder")
+        #expect(second.name == "untitled folder 2")
+        #expect(session.tree.node(atRelativePath: ["untitled folder 2"]) === second)
+        #expect(await bed.pool.hasConnection(to: bed.endpoint, destination: .fake, role: .files), "changes use the connection for files")
+
+        await session.waitForArchive()
+        await bed.tearDown()
+    }
+
+
+    // MARK: Renaming and Moving
+
+    @Test(.timeLimit(.minutes(1))) func aRenameRefusesATakenNameAndNeverReplacesAnything() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "A")
+        await bed.server.addFile("/srv/b.txt", "B")
+        let session = try await self.makeSession(bed)
+        let a = try #require(session.tree.node(atRelativePath: ["a.txt"]))
+
+        await #expect(throws: RemoteItemChangeError.nameTaken("b.txt")) { try await session.rename(a, to: "b.txt") }
+        #expect(await bed.server.contents(of: "/srv/b.txt") == "B")
+
+        try await session.rename(a, to: "c.txt")
+        #expect(await bed.server.contents(of: "/srv/c.txt") == "A")
+        #expect(await bed.server.contents(of: "/srv/a.txt") == nil)
+        #expect(session.tree.node(atRelativePath: ["c.txt"]) != nil)
+        #expect(session.tree.node(atRelativePath: ["a.txt"]) == nil)
+        #expect(!(await bed.server.log.contains { if case .rename = $0 { true } else { false } }), "posix-rename, which replaces, is never used")
+
+        await session.waitForArchive()
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func anItemCreatedAtTheDestinationMeanwhileIsKept() async throws {
