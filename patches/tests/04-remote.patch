+/// A fake server, prompts and a private recovery folder for one test.
+@MainActor final class RemoteTestBed {
+
+    let server = FakeSFTPServer()
+    let prompts = ScriptedRemotePrompts()
+    let recoveryRoot: URL
+
+    /// An endpoint of this test's own, so that files of tests running at the same time are different files.
+    let endpoint = RemoteEndpoint(host: "server-" + UUID().uuidString.prefix(8).lowercased(), user: nil, port: nil)
+    private(set) var pool: RemoteConnectionPool!
+    private var documents: [RemoteDocument] = []
+
+
+    init(limits: RemoteLimits = RemoteLimits()) async {
+
+        self.recoveryRoot = FileManager.default.temporaryDirectory.appending(path: "RemoteTests-" + UUID().uuidString, directoryHint: .isDirectory)
+        self.pool = await self.server.makePool(limits: limits)
+    }
+
+
+    var environment: RemoteEnvironment {
+
+        RemoteEnvironment(pool: self.pool, prompts: self.prompts, recoveryRoot: self.recoveryRoot,
+                          recoveryTiming: RemoteRecoveryTiming(debounce: .seconds(3600), maximumDelay: .seconds(3600)),
+                          folderArchiveRoot: self.folderArchiveRoot)
+    }
+
+
+    /// Where this test's folder windows keep their records, inside the recovery folder so that tearing down removes it.
+    var folderArchiveRoot: URL {
+
+        self.recoveryRoot.appending(component: "Folders", directoryHint: .isDirectory)
+    }
+
+
+    func identity(_ path: String) -> RemoteFileIdentity {
+
+        RemoteFileIdentity(profileID: nil, endpoint: self.endpoint, destination: .fake, requestedPath: path, path: path)
+    }
+
+
+    /// Opens a remote file as the open command does, without attaching it to a window.
+    func open(_ path: String) async throws -> RemoteDocument {
+
+        let document = try await RemoteOpenCoordinator.open(RemoteOpenRequest(profileID: nil, endpoint: self.endpoint, path: path),
+                                                            in: nil, window: nil, environment: self.environment, attach: false)
+        self.documents.append(document)
+
+        return document
+    }
+
+
+    /// Waits until no document holds the record any more; closing releases it asynchronously.
+    func waitUntilReleased(_ documentID: UUID) async throws {
+
+        try await waitUntil { RemoteRecoveryStore.unclaimedManifests(in: self.recoveryRoot).contains { $0.documentID == documentID } }
+    }
+
+
+    /// Keeps a document so that `tearDown()` closes it before the recovery folder goes.
+    func track(_ document: RemoteDocument) {
+
+        if !self.documents.contains(where: { $0 === document }) {
+            self.documents.append(document)
+        }
+    }
+
+
+    /// Closes every document the test opened, then removes the recovery folder.
+    ///
+    /// A document left open would go on autosaving into a folder that no longer exists.
+    func tearDown() async {
+
+        for document in self.documents {
+            // closing twice does nothing more
+            document.close()
+        }
+        await self.pool.closeAll()
+        // records are relinquished asynchronously after their documents close
+        try? await Task.sleep(for: .milliseconds(50))
+        try? FileManager.default.removeItem(at: self.recoveryRoot)
+    }
+}
