+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+import Combine
+import Defaults
+import SwiftTerm
+
+
+/// A terminal engine backed by SwiftTerm's local-process terminal view.
+///
+/// SwiftTerm launches the process and moves bytes; this type owns the policy around it: what the
+/// shell may do to the app (clipboard, links, window), and how the process is stopped. SwiftTerm's own
+/// `terminate()` only signals the shell and never reaps it, and signals its PID even after it exited,
+/// so shutdown is driven from here instead.
+@MainActor final class SwiftTermEngine: TerminalEngine {
+
+    /// Lines kept above the screen. Bounded so that a long-running session cannot grow without limit.
+    static let scrollback = 10_000
+
+    var onExit: ((TerminalExitStatus) -> Void)?
+    var onTitleChange: ((String) -> Void)?
+    var onNotification: ((TerminalNotification) -> Void)?
+
+    var view: NSView { self.container }
+
+    var focusView: NSView { self.hostView }
+
+    private let hostView: TerminalHostView
+    private let container: TerminalContainerView
+
+    // SwiftTerm holds these weakly, so the engine keeps them alive.
+    private let terminalPolicy: TerminalDelegatePolicy
+    private let processEvents: ProcessEvents
+
+    private var colorObservers: [AnyCancellable] = []
+    private var shellPID: pid_t = 0
+    private var hasExited = false
+    private var isShutDown = false
+
+
+    init() {
+
+        var options = TerminalOptions.default
+        options.scrollback = Self.scrollback
+
+        let hostView = TerminalHostView(frame: NSRect(x: 0, y: 0, width: 640, height: 400),
+                                        font: .monospacedSystemFont(ofSize: NSFont.systemFontSize, weight: .regular),
+                                        options: options)
+        self.hostView = hostView
+        self.container = TerminalContainerView(terminalView: hostView)
+        self.terminalPolicy = TerminalDelegatePolicy(hostView: hostView)
+        self.processEvents = ProcessEvents()
+
+        // Option composes characters on many keyboard layouts (such as @ or dead-key accents),
+        // so it must not be taken over as Meta.
+        hostView.optionAsMetaKey = false
+        hostView.applyThemeColors()
+        TerminalHostView.installEditingShortcutMonitor()
+
+        hostView.terminalDelegate = self.terminalPolicy
+        hostView.processDelegate = self.processEvents
+        self.processEvents.engine = self
+        self.terminalPolicy.onTitleChange = { [weak self] title in self?.onTitleChange?(title) }
+
+        // SwiftTerm decodes OSC 777 notifications itself, but passes them to a delegate method that its
+        // view implements as doing nothing and does not forward, so the engine takes the sequence over.
+        // SwiftTerm feeds output to the parser on the main queue.
+        hostView.getTerminal().registerOscHandler(code: 777) { [weak self] payload in
+            MainActor.assumeIsolated {
+                guard let notification = TerminalNotification(osc777: payload) else { return }
+                self?.onNotification?(notification)
+            }
+        }
+        
+        // Everything that decides the terminal's theme; appearance changes arrive through the view itself.
+        self.colorObservers = [
+            Publishers.MergeMany(
+                UserDefaults.standard.publisher(for: .terminalTheme).map { _ in }.eraseToAnyPublisher(),
+                UserDefaults.standard.publisher(for: .terminalUsesThemeColors).map { _ in }.eraseToAnyPublisher(),
+                UserDefaults.standard.publisher(for: .theme).map { _ in }.eraseToAnyPublisher(),
+                UserDefaults.standard.publisher(for: .pinsThemeAppearance).map { _ in }.eraseToAnyPublisher(),
+                UserDefaults.standard.publisher(for: .documentAppearance).map { _ in }.eraseToAnyPublisher(),
+                NotificationCenter.default.publisher(for: DidManagerUpdateSettingMessage<ThemeManager>.name, object: ThemeManager.shared).map { _ in }.eraseToAnyPublisher()
+            )
+            .receive(on: DispatchQueue.main)
+            .sink { [weak hostView] in hostView?.applyThemeColors() },
+        ]
+    }
+
+
+    func start(_ configuration: TerminalLaunchConfiguration) throws(TerminalLaunchError) {
+
+        guard !self.isShutDown, self.shellPID == 0 else { throw .spawnFailed }
+
+        self.hostView.startProcess(executable: configuration.executable,
+                                   args: configuration.arguments,
+                                   environment: configuration.environment,
+                                   execName: configuration.argv0,
+                                   currentDirectory: configuration.currentDirectory)
+
+        // SwiftTerm reports a failed fork only by not running.
+        guard self.hostView.process.running, self.hostView.process.shellPid > 0 else { throw .spawnFailed }
+
+        self.shellPID = self.hostView.process.shellPid
+    }
+
+
+    func shutDown() {
+
+        guard !self.isShutDown else { return }
+        self.isShutDown = true
+
+        self.onExit = nil
+        self.onTitleChange = nil
+        self.onNotification = nil
+        self.processEvents.engine = nil
+
+        if self.shellPID > 0, !self.hasExited {
+            let process = self.hostView.process!
+            let foreground = process.childfd >= 0 ? tcgetpgrp(process.childfd) : -1
+            let reaper = TerminalProcessReaper(shell: self.shellPID, foreground: foreground)
+            reaper.hangUp()
+
+            // Closes the pseudo-terminal, which hangs up the session, and cancels SwiftTerm's exit
+            // monitor so that only the reaper below waits for the shell.
+            process.terminate()
+
+            Task.detached(priority: .utility) {
+                reaper.reap(grace: .seconds(2))
+            }
+        }
+        // An exited shell was already reaped by SwiftTerm: its PID must never be signaled again.
+        // The pseudo-terminal is closed when the view and its process object are released.
+
+        self.container.removeFromSuperview()
+    }
+
+
+    /// Stops the process for application termination, waiting briefly instead of in the background.
+    ///
+    /// - Returns: The reaper that still needs to wait, or `nil` if nothing is running.
+    func shutDownForTermination() -> TerminalProcessReaper? {
+
+        guard !self.isShutDown else { return nil }
+
+        let reaper: TerminalProcessReaper? = if self.shellPID > 0, !self.hasExited, let process = self.hostView.process {
+            TerminalProcessReaper(shell: self.shellPID,
+                                  foreground: process.childfd >= 0 ? tcgetpgrp(process.childfd) : -1)
+        } else {
+            nil
+        }
+
+        self.isShutDown = true
+        self.onExit = nil
+        self.onTitleChange = nil
+        self.onNotification = nil
+        self.processEvents.engine = nil
+
+        reaper?.hangUp()
+        if reaper != nil {
+            self.hostView.process.terminate()
+        }
+
+        return reaper
+    }
+
+
+    /// The web address a clicked link in the terminal may open, or `nil` if it must be ignored.
+    ///
+    /// Links come from untrusted output. Only web pages with a host are opened: file paths and other
+    /// schemes could launch applications or scripts that the output names.
+    ///
+    /// - Parameter link: The link text or target as the terminal reports it.
+    /// - Returns: The URL to open, or `nil`.
+    nonisolated static func openableURL(for link: String) -> URL? {
+        
+        guard
+            let url = URL(string: link),
+            let scheme = url.scheme?.lowercased(),
+            ["http", "https"].contains(scheme),
+            url.host?.isEmpty == false
+        else { return nil }
+        
+        return url
+    }
+    
+    
+    // MARK: Inspection
+    
+    /// The shell's process ID, or 0 before it started.
+    var processID: pid_t { self.shellPID }
+    
+    /// The controlling side of the pseudo-terminal, or -1 once it is closed.
+    var pseudoTerminalDescriptor: Int32 { self.hostView.process.childfd }
+    
+    /// The visible screen as text, one line per row.
+    var bufferText: String {
+        
+        let terminal = self.hostView.getTerminal()
+        
+        // Characters made of several scalars, such as a letter with a combining accent, are kept in the
+        // terminal's own table; exporting cells without it would drop them.
+        return (0..<terminal.rows)
+            .compactMap { terminal.getLine(row: $0)?.translateToString(trimRight: true, characterProvider: terminal.getCharacter(for:)) }
+            .joined(separator: "\n")
+    }
+    
+    
+    /// Sends text to the process as if typed.
+    func type(_ text: String) {
+        
+        self.hostView.send(txt: text)
+    }
+    
+    
+    fileprivate func processDidTerminate(waitStatus: Int32?) {
+
+        guard !self.isShutDown, !self.hasExited else { return }
+
+        self.hasExited = true
+        self.onExit?(TerminalExitStatus(waitStatus: waitStatus ?? 0))
+    }
+}
+
+
+// MARK: - Process Events
+
+/// Receives SwiftTerm's process callbacks.
+///
+/// SwiftTerm delivers them on the main queue; the preconcurrency conformance checks that at run time.
+@MainActor private final class ProcessEvents: @preconcurrency LocalProcessTerminalViewDelegate {
+
+    weak var engine: SwiftTermEngine?
+
+
+    func sizeChanged(source: LocalProcessTerminalView, newCols: Int, newRows: Int) { }
+
+    func setTerminalTitle(source: LocalProcessTerminalView, title: String) { }
+
+    func hostCurrentDirectoryUpdate(source: TerminalView, directory: String?) { }
+
+
+    func processTerminated(source: TerminalView, exitCode: Int32?) {
+
+        // SwiftTerm passes the raw wait status here despite the parameter name.
+        self.engine?.processDidTerminate(waitStatus: exitCode)
+    }
+}
+
+
+// MARK: - Terminal Delegate Policy
+
+/// Stands between the terminal and the app, deciding which requests from the shell's output are honored.
+///
+/// `LocalProcessTerminalView` is its own terminal delegate and would let any program write to and even
+/// read the general pasteboard through escape sequences, or open arbitrary URLs and files.
+/// Terminal output is untrusted, so those requests are refused here while the rest is forwarded.
+@MainActor private final class TerminalDelegatePolicy: @preconcurrency TerminalViewDelegate {
+
+    weak var hostView: TerminalHostView?
+    var onTitleChange: ((String) -> Void)?
+
+
+    init(hostView: TerminalHostView) {
+
+        self.hostView = hostView
+    }
+
+
+    func sizeChanged(source: TerminalView, newCols: Int, newRows: Int) {
+
+        // Forward so that SwiftTerm resizes the pseudo-terminal.
+        self.hostView?.sizeChanged(source: source, newCols: newCols, newRows: newRows)
+    }
+
+
+    func setTerminalTitle(source: TerminalView, title: String) {
+
+        self.onTitleChange?(title)
+    }
+
+
+    func hostCurrentDirectoryUpdate(source: TerminalView, directory: String?) {
+
+        // The shell's reported directory is not tracked: tabs only claim their starting directory.
+    }
+
+
+    func send(source: TerminalView, data: ArraySlice<UInt8>) {
+
+        self.hostView?.send(source: source, data: data)
+    }
+
+
+    func scrolled(source: TerminalView, position: Double) { }
+
+    func rangeChanged(source: TerminalView, startY: Int, endY: Int) { }
+
+
+    func requestOpenLink(source: TerminalView, link: String, params: [String: String]) {
+
+        // Reached only when the user clicks a link.
+        guard let url = SwiftTermEngine.openableURL(for: link) else { return }
+
+        _ = NSWorkspace.shared.open(url)
+    }
+
+
+    func bell(source: TerminalView) {
+
+        NSSound.beep()
+    }
+
+
+    func clipboardCopy(source: TerminalView, content: Data) {
+
+        // Refused: output must not replace what the user copied (OSC 52).
+    }
+
+
+    func clipboardRead(source: TerminalView) -> Data? {
+
+        // Refused: output must not read what the user copied (OSC 52).
+        nil
+    }
+
+
+    func iTermContent(source: TerminalView, content: ArraySlice<UInt8>) {
+
+        // Inline file transfers from output are not accepted.
+    }
+}
