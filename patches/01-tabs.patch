+
+import AppKit
+import Defaults
+
+
+/// Tabs that are not files, whatever their kind.
+///
+/// They share the file tabs' order, selection, strip and close paths. See `DirectoryTabItem`.
+extension DirectoryDocument {
+
+    // MARK: Public Properties
+
+    /// Every tab that is not a file, in tab order.
+    var tabItems: [any DirectoryTabItem] {
+
+        self.tabState.entries.compactMap(\.item)
+    }
+
+
+    /// The tab the window shows, if the selected tab is not a file.
+    var activeTabItem: (any DirectoryTabItem)? {
+
+        guard UserDefaults.standard[.usesDirectoryFileTabs] else { return nil }
+
+        return self.tabState.entries.first { $0.id == self.tabState.selectedID }?.item
+    }
+
+
+    var windowContentViewController: WindowContentViewController? {
+
+        self.windowController?.contentViewController as? WindowContentViewController
+    }
+
+
+    // MARK: Opening and Selection
+
+    /// Adds a tab and selects it.
+    ///
+    /// - Parameter item: The tab to add.
+    /// - Returns: `false` if the window cannot have such tabs now, because it has closed or tabs are off.
+    @discardableResult func openTabItem(_ item: any DirectoryTabItem) -> Bool {
+
+        guard !self.isClosed, UserDefaults.standard[.usesDirectoryFileTabs] else { return false }
+
+        if self.tabState.entry(for: item) == nil {
+            item.didJoin(self)
+            self.tabState.insert(item)
+            self.membershipGeneration += 1
+        }
+        self.selectTabItem(item)
+
+        return true
+    }
+
+
+    func selectTabItem(_ item: any DirectoryTabItem) {
+
+        guard let entry = self.tabState.entry(for: item) else { return }
+
+        self.selectionGeneration += 1
+        self.tabState.select(entry.id)
+        self.detachCurrentDocument()
+        self.windowContentViewController?.showActiveTab()
+        self.windowController?.synchronizeWindowTitleWithDocumentName()
+        self.invalidateRestorableState()
+        // The file browser keeps highlighting the last file as context; the tab is not a file.
+    }
+
+
+    // MARK: Closing
+
+    /// Closes a tab after its own approval.
+    ///
+    /// - Parameter item: The tab to close.
+    /// - Returns: `true` if the tab closed.
+    @discardableResult func closeTabItem(_ item: any DirectoryTabItem) async -> Bool {
+
+        guard
+            self.tabState.entry(for: item) != nil,
+            !self.isConfirmingClose,
+            self.pendingItemCloses.insert(item.id).inserted
+        else { return false }
+        defer { self.pendingItemCloses.remove(item.id) }
+
+        self.notifyTabItemsOfReview()
+        guard await item.approveTabClose(in: self) else { return false }
+
+        // The tab may have gone while a sheet was up.
+        guard self.tabState.entry(for: item) != nil else { return false }
+
+        self.removeTabItem(item)
+
+        return true
+    }
+
+
+    /// Removes a tab without asking, tears it down and shows the tab that takes over the selection.
+    ///
+    /// For callers that already have the user's approval, or whose tab has nothing left to ask about.
+    func removeTabItem(_ item: any DirectoryTabItem) {
+
+        let wasSelected = self.activeTabItem === item
+
+        guard self.tabState.remove(item) != nil else { return }
+
+        self.membershipGeneration += 1
+        item.tearDown()
+        self.windowContentViewController?.releaseTabViewController(for: item)
+
+        if wasSelected {
+            self.showSelectedTabAfterRemoval()
+        }
+        self.invalidateRestorableState()
+    }
+
+
+    /// Removes every tab that is not a file without asking.
+    func closeAllTabItems() {
+
+        for item in self.tabItems {
+            self.removeTabItem(item)
+        }
+    }
+
+
+    /// Lets every tab that is not a file put away what it shows over the window before a review.
+    func notifyTabItemsOfReview() {
+
+        for item in self.tabItems {
+            item.directoryWillShowReview()
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    /// Shows whatever tab is selected after the selected tab went away.
+    private func showSelectedTabAfterRemoval() {
+
+        switch self.tabState.entries.first(where: { $0.id == self.tabState.selectedID })?.content {
+            case .file(let document):
+                self.selectDocument(document)
+            case .item(let item):
+                self.selectTabItem(item)
+            case nil:
+                self.windowContentViewController?.showActiveTab()
+                self.windowController?.synchronizeWindowTitleWithDocumentName()
+        }
+    }
+}
