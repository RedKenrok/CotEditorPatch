+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Network
+
+/// A TCP relay on the loopback interface between `ssh` and the fixture's SFTP server, which a test can cut on cue.
+///
+/// It listens on the port the fixture reserved for its `fixture-proxy` host and forwards every
+/// connection to the SFTP server, so that a real session can lose its connection in the middle of an
+/// operation, as on a network that drops.
+final class FixtureRelay: @unchecked Sendable {
+
+    private let listener: NWListener
+    private let serverPort: NWEndpoint.Port
+    private let queue = DispatchQueue(label: "FixtureRelay")
+    private let lock = NSLock()
+    private var connections: [NWConnection] = []
+    private var remainingBeforeCut: Int?
+
+
+    private init(listener: NWListener, serverPort: NWEndpoint.Port) {
+
+        self.listener = listener
+        self.serverPort = serverPort
+    }
+
+
+    /// Starts relaying on the fixture's proxy port.
+    static func start(_ fixture: URL) async throws -> FixtureRelay {
+
+        func port(_ name: String) throws -> NWEndpoint.Port {
+            let text = try String(contentsOf: fixture.appending(path: name), encoding: .utf8).trimmingCharacters(in: .whitespacesAndNewlines)
+            guard let value = UInt16(text), let port = NWEndpoint.Port(rawValue: value) else { throw CocoaError(.fileReadCorruptFile) }
+            return port
+        }
+
+        let parameters = NWParameters.tcp
+        parameters.requiredLocalEndpoint = .hostPort(host: "127.0.0.1", port: try port("proxy-port"))
+        parameters.allowLocalEndpointReuse = true
+        let relay = FixtureRelay(listener: try NWListener(using: parameters), serverPort: try port("sftp-port"))
+        try await relay.listen()
+
+        return relay
+    }
+
+
+    /// Cuts every connection once the client has sent this many more bytes, or stops cutting with `nil`.
+    func cut(afterSending count: Int?) {
+
+        self.lock.withLock { self.remainingBeforeCut = count }
+    }
+
+
+    func stop() {
+
+        self.listener.cancel()
+        self.cutAll()
+    }
+
+
+    // MARK: Private Methods
+
+    private func listen() async throws {
+
+        let listener = self.listener
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, any Error>) in
+            let once = NSLock()
+            nonisolated(unsafe) var resumed = false
+            listener.stateUpdateHandler = { state in
+                once.lock()
+                defer { once.unlock() }
+                guard !resumed else { return }
+                switch state {
+                    case .ready:
+                        resumed = true
+                        continuation.resume()
+                    case .failed(let error):
+                        resumed = true
+                        continuation.resume(throwing: error)
+                    default:
+                        break
+                }
+            }
+            listener.newConnectionHandler = { [weak self] client in
+                self?.relay(client)
+            }
+            listener.start(queue: self.queue)
+        }
+    }
+
+
+    private func relay(_ client: NWConnection) {
+
+        let server = NWConnection(host: "127.0.0.1", port: self.serverPort, using: .tcp)
+        self.lock.withLock { self.connections += [client, server] }
+        client.start(queue: self.queue)
+        server.start(queue: self.queue)
+        self.pump(from: client, to: server, countsTowardsCut: true)
+        self.pump(from: server, to: client, countsTowardsCut: false)
+    }
+
+
+    private func pump(from source: NWConnection, to destination: NWConnection, countsTowardsCut: Bool) {
+
+        source.receive(minimumIncompleteLength: 1, maximumLength: 65536) { [weak self] data, _, isComplete, error in
+            guard let self else { return }
+
+            if let data, !data.isEmpty {
+                if countsTowardsCut {
+                    let cuts: Bool = self.lock.withLock {
+                        guard let remaining = self.remainingBeforeCut else { return false }
+                        self.remainingBeforeCut = remaining - data.count
+                        return remaining - data.count <= 0
+                    }
+                    if cuts {
+                        self.lock.withLock { self.remainingBeforeCut = nil }
+                        return self.cutAll()
+                    }
+                }
+                destination.send(content: data, completion: .contentProcessed { _ in })
+            }
+            if isComplete || error != nil {
+                source.cancel()
+                destination.cancel()
+                return
+            }
+            self.pump(from: source, to: destination, countsTowardsCut: countsTowardsCut)
+        }
+    }
+
+
+    private func cutAll() {
+
+        let connections = self.lock.withLock {
+            defer { self.connections.removeAll() }
+            return self.connections
+        }
+        for connection in connections {
+            connection.forceCancel()
+        }
+    }
+}
