+/// A channel that plays back fixed bytes, one reply per request written, then ends.
+private final class ScriptedChannel: RemoteByteChannel, @unchecked Sendable {
+
+    private let stream: AsyncStream<Data>
+    private let continuation: AsyncStream<Data>.Continuation
+    private var iterator: AsyncStream<Data>.AsyncIterator
+    private let replies: RemoteLockedValue<[Data]>
+
+
+    init(replies: [Data]) {
+
+        (self.stream, self.continuation) = AsyncStream<Data>.makeStream()
+        self.iterator = self.stream.makeAsyncIterator()
+        self.replies = RemoteLockedValue(replies)
+    }
+
+
+    func write(_ data: Data) async throws {
+
+        let reply = self.replies.withLock { $0.isEmpty ? nil : $0.removeFirst() }
+        if let reply {
+            self.continuation.yield(reply)
+        } else {
+            self.continuation.finish()
+        }
+    }
+
+
+    func read() async throws -> Data? {
+
+        await self.iterator.next()
+    }
+
+
+    func close() async {
+
+        self.continuation.finish()
+    }
+
+
+    func diagnostics() async -> String {
+
+        ""
+    }
+}
+
+
+/// A channel that hands the client the server's reply, and lets it read it, before its write returns.
+private final class ReplyingWhileWritingChannel: RemoteByteChannel, @unchecked Sendable {
+
+    private let reply: Data
+    private let stream: AsyncStream<Data>
+    private let continuation: AsyncStream<Data>.Continuation
+    private var iterator: AsyncStream<Data>.AsyncIterator
+    private let reads = RemoteLockedValue(0)
+
+
+    init(reply: Data) {
+
+        self.reply = reply
+        (self.stream, self.continuation) = AsyncStream<Data>.makeStream()
+        self.iterator = self.stream.makeAsyncIterator()
+    }
+
+
+    func write(_ data: Data) async throws {
+
+        let readsBefore = self.reads.withLock { $0 }
+        self.continuation.yield(self.reply)
+
+        // Returns only once the client has taken the reply and is reading again, or after a while.
+        let deadline = ContinuousClock.now + .seconds(1)
+        while self.reads.withLock({ $0 }) < readsBefore + 2, ContinuousClock.now < deadline {
+            try await Task.sleep(for: .milliseconds(5))
+        }
+    }
+
+
+    func read() async throws -> Data? {
+
+        self.reads.withLock { $0 += 1 }
+        return await self.iterator.next()
+    }
+
+
+    func close() async {
+
+        self.continuation.finish()
+    }
+
+
+    func diagnostics() async -> String {
+
+        ""
+    }
+}
