+            RemoteTermination.isInProgress = false
+            try await bed.waitUntilReleased(ids.index)
+
+            RemoteFolderRestoration.run(environment: bed.environment, reopensWindows: true)
+            let restored = try #require(RemoteFolderOpenCoordinator.session(for: session.identity))
+            let restoredDirectory = try #require(restored.directory)
+            defer { restoredDirectory.close() }
+
+            let shown = try #require(restoredDirectory.activeFileDocument as? RemoteDocument)
+            bed.track(shown)
+            #expect(shown.documentID == ids.index, "the file that was showing shows again")
+            #expect(shown.textStorage.string == "unsent")
+            let members = restoredDirectory.documents.compactMap { $0 as? RemoteDocument }
+            members.forEach(bed.track)
+            #expect(members.allSatisfy { [ids.about, ids.index].contains($0.documentID) }, "the window's members come back, without tabs")
+            #expect(restoredDirectory.tabDocuments.isEmpty)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func withWindowRestorationOffFolderRecordsAreRemoved() async throws {
+
+        try await self.withRemote { _, _, bed in
+            let identity = RemoteFolderIdentity(profileID: nil, endpoint: bed.endpoint, destination: .fake, requestedPath: "/srv", path: "/srv")
+            let archive = RemoteFolderArchive(windowID: UUID(), identity: identity)
+            try RemoteFolderArchiveStore.write(archive, in: bed.folderArchiveRoot)
+            #expect(RemoteFolderArchiveStore.archives(in: bed.folderArchiveRoot).map(\.windowID) == [archive.windowID])
+
+            RemoteFolderRestoration.run(environment: bed.environment, reopensWindows: false)
+
+            #expect(RemoteFolderArchiveStore.archives(in: bed.folderArchiveRoot).isEmpty)
+            #expect(RemoteFolderOpenCoordinator.session(for: identity) == nil)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func invalidFolderRecordsAreSkipped() async throws {
+
+        try await self.withRemote { _, _, bed in
+            let root = bed.folderArchiveRoot
+            try RemoteRecoveryStore.prepareRoot(root)
+            let windowID = UUID()
+            var identity = RemoteFolderIdentity(profileID: nil, endpoint: bed.endpoint, destination: .fake, requestedPath: "relative", path: "/srv")
+            try RemoteFolderArchiveStore.write(RemoteFolderArchive(windowID: windowID, identity: identity), in: root)
+            identity.requestedPath = "/srv"
+            identity.endpoint.host = "-oProxyCommand=evil"
+            try RemoteFolderArchiveStore.write(RemoteFolderArchive(windowID: UUID(), identity: identity), in: root)
+            try Data("not a property list".utf8).write(to: root.appending(path: UUID().uuidString + ".plist"))
+
+            #expect(RemoteFolderArchiveStore.archives(in: root).isEmpty)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aCanceledCloseKeepsTheWindowAndItsRecord() async throws {
+
+        try await self.withRemoteFolder { session, directory, bed in
+            let index = try await self.waitForNode(["index.html"], in: session)
+            session.activate(index)
+            let document = try await self.waitForDocument(at: "/srv/site/index.html", in: directory, bed: bed)
+            document.replaceText(with: "edited")
+            await session.waitForArchive()
+
+            bed.prompts.closeChoices = [.cancel]
+            #expect(await !directory.canClose())
+            #expect(directory.tabDocuments.contains { $0 === document })
+            #expect(RemoteFolderArchiveStore.archive(of: session.windowID, in: bed.folderArchiveRoot) != nil)
+            #expect(RemoteFolderOpenCoordinator.session(for: session.identity) === session)
+
+            bed.prompts.closeChoices = [.discard]
+            #expect(await directory.canClose())
+            directory.close()
+            try await self.wait { RemoteFolderArchiveStore.archive(of: session.windowID, in: bed.folderArchiveRoot) == nil }
+            #expect(RemoteFolderOpenCoordinator.session(for: session.identity) == nil)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func tabsThatAreNotFilesWorkInARemoteFolderWindow() async throws {
+
+        try await self.withRemoteFolder { session, directory, bed in
+            let kind = FakeTabKind()
+            directory.tabKinds = [kind.kind] + DirectoryTabKind.registered
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+
+            let index = try await self.waitForNode(["index.html"], in: session)
+            session.activate(index)
+            let document = try await self.waitForDocument(at: "/srv/site/index.html", in: directory, bed: bed)
+            document.replaceText(with: "edited")
+            directory.selectTabItem(item)
+            directory.selectDocument(document)
+            directory.selectTabItem(item)
+            #expect(item.controllers.count == 1, "the tab keeps its controller across switching")
+
+            bed.prompts.closeChoices = [.cancel]
+            #expect(await !directory.canClose())
+            #expect(item.tearDownCount == 0, "a canceled close stops nothing")
+            #expect(directory.tabItems.first === item)
+
+            let tabs = try #require(try await self.archivedTabs(of: session, bed: bed))
+            let archive = try #require(try PropertyListSerialization.propertyList(from: tabs, format: nil) as? [String: Any])
+            #expect((archive["entries"] as? [[String: Any]])?.compactMap { $0["kind"] as? String } == ["fake", RemoteTabArchive.kind])
+        }
+    }
+
+
+    // MARK: Helpers
+
+    /// Runs the body with a remote folder window of `/srv/site`, which holds `index.html` and `src/app.js`.
+    func withRemoteFolder(_ body: (RemoteFolderSession, DirectoryDocument, RemoteTestBed) async throws -> Void) async throws {
+
+        try await self.withRemote { _, _, bed in
+            await bed.server.addFile("/srv/site/index.html", "<p>")
+            await bed.server.addFile("/srv/site/src/app.js", "app")
+
+            let session = try await self.openFolder("/srv/site", bed: bed)
+            let directory = try #require(session.directory)
+            defer {
+                for session in RemoteFolderOpenCoordinator.openSessions where session.identity.endpoint == bed.endpoint {
+                    session.directory?.close()
+                }
+            }
+
+            try await body(session, directory, bed)
+        }
+    }
+
+
+    func openFolder(_ path: String, bed: RemoteTestBed) async throws -> RemoteFolderSession {
+
+        try await RemoteFolderOpenCoordinator.open(RemoteFolderRequest(profileID: nil, endpoint: bed.endpoint, path: path), environment: bed.environment)
+    }
+
+
+    /// Waits until the node at the path below the root is in the tree.
+    @discardableResult func waitForNode(_ components: [String], in session: RemoteFolderSession) async throws -> RemoteDirectoryNode {
+
+        try await self.wait { session.tree.node(atRelativePath: components) != nil }
+
+        return try #require(session.tree.node(atRelativePath: components))
+    }
+
+
+    /// Expands the folder at the path and waits for its listing.
+    func expand(_ components: [String], in session: RemoteFolderSession) async throws {
+
+        let node = try await self.waitForNode(components, in: session)
+        session.tree.expand(node)
+        try await self.wait { !node.isLoading && node.children != nil }
+    }
+
+
+    /// Waits until the window has the document of the remote file.
+    func waitForDocument(at path: String, in directory: DirectoryDocument, bed: RemoteTestBed) async throws -> RemoteDocument {
+
+        try await self.wait { directory.tabDocuments.contains { ($0 as? RemoteDocument)?.identity.path == path } || directory.documents.contains { ($0 as? RemoteDocument)?.identity.path == path } }
+        let document = try #require((directory.documents.first { ($0 as? RemoteDocument)?.identity.path == path }) as? RemoteDocument)
+        bed.track(document)
+
+        return document
+    }
+
+
+    /// Lets the main queue run what is on it, several times over, as a view's deferred updates are.
+    func drainMainQueue(turns: Int = 30) async {
+
+        for _ in 0..<turns {
+            await withCheckedContinuation { continuation in
+                DispatchQueue.main.async { continuation.resume() }
+            }
+        }
+    }
+
+
+    /// The tabs as the window's record stores them.
+    private func archivedTabs(of session: RemoteFolderSession, bed: RemoteTestBed) async throws -> Data? {
+
+        await session.waitForArchive()
+
+        return RemoteFolderArchiveStore.archive(of: session.windowID, in: bed.folderArchiveRoot)?.tabs
+    }
+}
+
+
+private extension NSView {
+
+    /// The first view of the type in the hierarchy below this one.
+    func firstSubview<T: NSView>(of type: T.Type) -> T? {
+
+        for subview in self.subviews {
+            if let match = subview as? T ?? subview.firstSubview(of: type) { return match }
+        }
+        return nil
+    }
+}
