+                if case .rename = request { return .dropBeforeHandling }
+                return .proceed
+            }
+            guard case .unresolved = await document.saveCoordinator.perform(.save) else { Issue.record("expected an unknown outcome"); return }
+
+            await bed.server.setHook(nil)
+            await bed.server.clearLog()
+            #expect(await document.saveCoordinator.perform(.save) == .previousSaveNotApplied)
+            #expect(await !bed.server.hasMutated)
+            #expect(await bed.server.contents(of: "/srv/a.txt") == "old")
+            let retained = await document.record?.manifest.retainedTemporaryPaths ?? []
+            #expect(retained.count == 1, "the temporary file of the lost connection is reported, not deleted")
+            #expect(await bed.server.contents(of: try #require(retained.first)) == "new")
