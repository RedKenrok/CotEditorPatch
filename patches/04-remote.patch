+//
+//  RemoteAskpass.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import OSLog
+import Synchronization
+
+
+/// Answers the questions of the `ssh` connections CotEditor starts, such as for a password, a one-time
+/// code or a key's passphrase, by asking the user.
+///
+/// `ssh` runs the bundled `RemoteAskpass.sh` as its askpass program, which hands the question to this
+/// server over a Unix socket in a folder of its own that only the user can open, with a random token
+/// that only the `ssh` processes CotEditor starts get. The answer goes back through the socket to the
+/// program, whose output `ssh` reads; it never appears in an argument, the environment, a file or a
+/// log, and is not kept.
+final class RemoteAskpass: Sendable {
+
+    /// Asks the user a question of `ssh`.
+    ///
+    /// - Parameters:
+    ///   - prompt: The question as `ssh` put it, such as `Enter passphrase for key '…':`.
+    ///   - isConfirmation: Whether it is a yes or no question rather than one that takes text.
+    /// - Returns: The answer, or `nil` if the user canceled.
+    typealias Answerer = @Sendable (_ prompt: String, _ isConfirmation: Bool) async -> String?
+
+
+    /// The app's server, which the app's prompts answer.
+    static let shared = RemoteAskpass()
+
+    /// The most bytes a question may take, so that a stray client cannot make the server read without end.
+    private static let maximumRequestLength = 64 * 1024
+
+    private struct State {
+
+        var answerer: Answerer?
+        var socketPath: String?
+        var listener: Int32 = -1
+        var source: (any DispatchSourceRead)?
+    }
+
+    private let state = Mutex(State())
+    private let token = (0..<32).map { _ in String(format: "%02x", UInt8.random(in: .min ... .max)) }.joined()
+    private let queue = DispatchQueue(label: "local.coteditor-tabs.RemoteAskpass")
+
+
+    // MARK: Public Methods
+
+    /// Sets who answers the questions, and starts listening for them; `nil` stops answering.
+    func setAnswerer(_ answerer: Answerer?) {
+
+        self.state.withLock { $0.answerer = answerer }
+        if answerer != nil {
+            self.startListening()
+        }
+    }
+
+
+    /// Stops listening and removes the socket, as a test does with a server of its own.
+    func stop() {
+
+        let (listener, source, path) = self.state.withLock { state in
+            defer {
+                state.listener = -1
+                state.source = nil
+                state.socketPath = nil
+                state.answerer = nil
+            }
+            return (state.listener, state.source, state.socketPath)
+        }
+        source?.cancel()
+        if listener >= 0 {
+            close(listener)
+        }
+        if let path {
+            try? FileManager.default.removeItem(atPath: RemotePath.parent(of: path))
+        }
+    }
+
+
+    /// The environment that makes an `ssh` process ask its questions here, or `nil` if nobody answers them.
+    var environment: [String: String]? {
+
+        guard
+            let helper = Self.helperURL,
+            let socketPath = self.state.withLock({ $0.answerer != nil ? $0.socketPath : nil })
+        else { return nil }
+
+        return [
+            "SSH_ASKPASS": helper.path(percentEncoded: false),
+            // ssh asks through the program even if it has a terminal, such as when the app runs from one.
+            "SSH_ASKPASS_REQUIRE": "force",
+            "COTEDITOR_ASKPASS_SOCKET": socketPath,
+            "COTEDITOR_ASKPASS_TOKEN": self.token,
+        ]
+    }
+
+
+    /// The bundled askpass program, copied with the command-line tools.
+    static var helperURL: URL? {
+
+        guard let url = Bundle.main.sharedSupportURL?.appending(path: "bin/RemoteAskpass.sh", directoryHint: .notDirectory) else { return nil }
+
+        return FileManager.default.isExecutableFile(atPath: url.path(percentEncoded: false)) ? url : nil
+    }
+
+
+    /// Answers with the prompts of the current remote environment, for the app's server.
+    @MainActor static func answerWithPrompts(_ prompt: String, isConfirmation: Bool) async -> String? {
+
+        await RemoteEnvironment.current.prompts.answerSSHQuestion(prompt, isConfirmation: isConfirmation, window: nil)
+    }
+
+
+    // MARK: Private Methods
+
+    private func startListening() {
+
+        guard self.state.withLock({ $0.listener < 0 }) else { return }
+
+        // The path of a Unix socket is limited to 104 bytes, so it goes in a short folder of its own.
+        let folder = URL(filePath: NSTemporaryDirectory(), directoryHint: .isDirectory)
+            .appending(path: "cot-ask-" + String(self.token.prefix(8)), directoryHint: .isDirectory)
+        let path = folder.appending(path: "s", directoryHint: .notDirectory).path(percentEncoded: false)
+        do {
+            try? FileManager.default.removeItem(at: folder)
+            try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        } catch {
+            return Logger.app.error("Failed to make the folder of the askpass socket: \(error)")
+        }
+
+        let listener = socket(AF_UNIX, SOCK_STREAM, 0)
+        guard listener >= 0 else { return }
+
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        let bytes = Array(path.utf8)
+        guard bytes.count < MemoryLayout.size(ofValue: address.sun_path) else {
+            close(listener)
+            return
+        }
+        withUnsafeMutableBytes(of: &address.sun_path) { buffer in
+            buffer.copyBytes(from: bytes)
+            buffer[bytes.count] = 0
+        }
+        let bound = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { bind(listener, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
+        }
+        guard bound == 0, chmod(path, 0o600) == 0, listen(listener, 8) == 0 else {
+            close(listener)
+            return
+        }
+
+        let source = DispatchSource.makeReadSource(fileDescriptor: listener, queue: self.queue)
+        source.setEventHandler { [weak self] in
+            let client = accept(listener, nil, nil)
+            guard client >= 0 else { return }
+            self?.serve(client)
+        }
+        source.resume()
+
+        self.state.withLock { state in
+            state.listener = listener
+            state.socketPath = path
+            state.source = source
+        }
+    }
+
+
+    /// Reads a question, asks it, and writes the answer, on a task of its own so that other questions can come meanwhile.
+    private func serve(_ client: Int32) {
+
+        // Only the user's own processes may ask, as the folder's permissions already ensure.
+        var userID = uid_t()
+        var groupID = gid_t()
+        guard getpeereid(client, &userID, &groupID) == 0, userID == getuid() else {
+            close(client)
+            return
+        }
+
+        let answerer = self.state.withLock(\.answerer)
+        let token = self.token
+        Task.detached {
+            defer { close(client) }
+
+            // token, confirmation marker and prompt, each ended by a NUL
+            var request = Data()
+            var buffer = [UInt8](repeating: 0, count: 4096)
+            while request.count(where: { $0 == 0 }) < 3, request.count < Self.maximumRequestLength {
+                let count = read(client, &buffer, buffer.count)
+                guard count > 0 else { return }
+                request.append(contentsOf: buffer[0..<count])
+            }
+            let fields = request.split(separator: 0, omittingEmptySubsequences: false).map { String(bytes: $0, encoding: .utf8) ?? "" }
+            guard fields.count >= 3, Self.isEqual(fields[0], token) else { return }
+
+            let isConfirmation = (fields[1] == "confirm")
+            let answer = await answerer?(RemoteSSHProcess.sanitized(fields[2]), isConfirmation)
+
+            var reply = Data((answer.map { "1" + $0 } ?? "0").utf8)
+            _ = reply.withUnsafeBytes { write(client, $0.baseAddress, $0.count) }
+            reply.resetBytes(in: 0..<reply.count)
+        }
+    }
+
+
+    /// Compares in time that does not depend on where the strings differ.
+    private static func isEqual(_ lhs: String, _ rhs: String) -> Bool {
+
+        let lhs = Array(lhs.utf8)
+        let rhs = Array(rhs.utf8)
+        guard lhs.count == rhs.count else { return false }
+
+        return zip(lhs, rhs).reduce(0) { $0 | ($1.0 ^ $1.1) } == 0
+    }
+}
+
