+    @Test(.timeLimit(.minutes(1))) func overlappingCloseRequestsAreRefused() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            #expect(await directory.openDocument(at: urls[0]))
+            let first = try #require(self.member(at: urls[0], in: directory) as? Document)
+            first.textStorage.replaceCharacters(in: NSRange(0..<0), with: "edited ")
+            first.updateChangeCount(.changeDone)
+
+            // The member answers only when the test says so, so the requests below overlap the first one
+            // however fast saving is on this machine.
+            let approval = PendingApproval()
+            let approveMemberClose = directory.approveMemberClose
+            directory.approveMemberClose = { _ in await approval.wait() }
+            let windowClose = Task { await directory.canClose() }
+            try await self.wait { approval.isWaiting }
+            #expect(await directory.canClose() == false)
+            #expect(await directory.closeDocument(first) == false)
+            approval.answer(true)
+            #expect(await windowClose.value)
+            #expect(directory.tabDocuments.count == 1)
+            #expect(approval.requestCount == 1, "the refused requests never asked the member")
+            directory.approveMemberClose = approveMemberClose
+
+            // Once the request finishes, closing works again.
+            #expect(await directory.closeDocument(first))
+            #expect(directory.tabDocuments.isEmpty)
+        }
+    }
