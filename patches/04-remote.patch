+++ b/CotEditor/Sources/Remote/RemoteRecoveryStore.swift
@@ -0,0 +1,822 @@
+//
+//  RemoteRecoveryStore.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import OSLog
+
+
+/// The settings that decide how a text generation becomes bytes on the server.
+struct RemoteTextSettings: Codable, Equatable, Sendable {
+
+    /// The raw value of the `String.Encoding`.
+    var encoding: UInt
+    var hasUTF8BOM: Bool
+
+    /// The index of the line ending in `LineEnding.allCases`.
+    var lineEnding: Int
+    var syntaxName: String
+}
+
+
+/// The durable description of one remote document's recovery record.
+///
+/// It names every file the record needs, by name, size and digest. Data files are never changed
+/// once written, so a manifest that was written completely always refers to complete data.
+struct RemoteRecoveryManifest: Codable, Equatable, Sendable {
+
+    /// A data file of the record.
+    struct StoredFile: Codable, Equatable, Sendable {
+
+        var name: String
+        var digest: String
+        var size: Int
+    }
+
+
+    /// The version of the file last confirmed on the server.
+    struct Baseline: Codable, Equatable, Sendable {
+
+        var file: StoredFile
+        var attributes: RemoteFileAttributes?
+    }
+
+
+    /// The editor's text as of a generation. Text is stored as UTF-8, so nothing is lost whatever
+    /// encoding the file is saved in.
+    struct Text: Codable, Equatable, Sendable {
+
+        var generation: Int
+        var file: StoredFile
+        var settings: RemoteTextSettings
+    }
+
+
+    /// A save or repair that changes the server, from the moment its snapshot is durable until its
+    /// outcome is known.
+    struct Operation: Codable, Equatable, Sendable {
+
+        enum Kind: String, Codable, Sendable {
+
+            /// Uploading to a temporary file and renaming it over the target.
+            case replace
+            /// Rewriting the target through its own handle.
+            case inPlace
+            /// Creating a new file (Save As Remote).
+            case create
+            /// Writing the version an interrupted in-place save started from back to the target.
+            case restore
+        }
+
+
+        enum State: String, Codable, Sendable {
+
+            /// Nothing that changes the target has been sent.
+            case prepared
+            /// The rename has been sent. Until it is confirmed, the target may be either version.
+            case committing
+            /// Writes to the target may have reached the server. Until checked, it may be partly written.
+            case writingInPlace
+            /// Creating the new file may have reached the server.
+            case creating
+        }
+
+
+        var id: UUID
+        var kind: Kind
+        var state: State
+        var targetPath: String
+        var temporaryPath: String?
+
+        /// The bytes being written.
+        var snapshot: StoredFile
+
+        /// The version the operation expects on the server before it writes.
+        var original: StoredFile
+
+        /// For writes in place, the version to write back if the write is interrupted.
+        var restoreCopy: StoredFile?
+
+        /// The text generation the snapshot was made from, or `nil` for a restore.
+        var generation: Int?
+        var settings: RemoteTextSettings?
+
+
+        /// Whether the target may have changed, so that the outcome must be checked before anything else is written.
+        var mayHaveChangedTarget: Bool {
+
+            self.state != .prepared
+        }
+    }
+
+
+    static let currentFormatVersion = 1
+
+    var formatVersion = Self.currentFormatVersion
+    var documentID: UUID
+    var identity: RemoteFileIdentity
+    var baseline: Baseline
+    var text: Text?
+    var operation: Operation?
+
+    /// The latest remote version the user reviewed after a conflict.
+    var reviewed: StoredFile?
+
+    /// Temporary files left on the server whose removal could not be done or confirmed.
+    var retainedTemporaryPaths: [String] = []
+
+    /// Writes in place to a file the document no longer edits, after Save As Remote, whose outcome
+    /// is still unknown. Their data, including the version to restore, is kept for the user.
+    var detachedOperations: [Operation] = []
+
+    /// The unresolved operation that a repair under way replaced. It comes back if the repair ends
+    /// without writing, so that the repair can still be offered.
+    var supersededOperation: Operation?
+
+    /// Whether the user agreed to rewrite this file in place.
+    var consentsToInPlaceSaving = false
+
+    /// Whether a document shows the record in this app.
+    var isOpen = true
+
+    /// Whether the document has a window of its own, rather than a tab in a folder window.
+    var isStandalone = false
+
+    /// Whether the user closed the document keeping its unsent changes.
+    var keepsAfterClose = false
+
+    var modificationDate = Date.now
+
+
+    /// Reads stored text, which is always written as UTF-8.
+    static func decodeText(_ data: Data) throws -> String {
+
+        guard let string = String(data: data, encoding: .utf8) else { throw RemoteRecoveryError.damaged("text that is not UTF-8") }
+
+        return string
+    }
+
+
+    /// The names of every data file the manifest needs.
+    var referencedFileNames: Set<String> {
+
+        var names: Set<String> = [self.baseline.file.name]
+        if let text { names.insert(text.file.name) }
+        if let operation {
+            names.insert(operation.snapshot.name)
+            names.insert(operation.original.name)
+            if let restoreCopy = operation.restoreCopy { names.insert(restoreCopy.name) }
+        }
+        if let reviewed { names.insert(reviewed.name) }
+        for operation in self.detachedOperations + [self.supersededOperation].compactMap(\.self) {
+            names.insert(operation.snapshot.name)
+            names.insert(operation.original.name)
+            if let restoreCopy = operation.restoreCopy { names.insert(restoreCopy.name) }
+        }
+
+        return names
+    }
+}
+
+
+enum RemoteRecoveryError: Error, Equatable {
+
+    /// Another document in this or another running instance of the app holds the record.
+    case inUse
+
+    /// The record is incomplete or does not describe what its folder claims.
+    case damaged(String)
+
+    /// A file could not be written or read.
+    case fileSystem(Int32)
+}
+
+
+extension RemoteRecoveryError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .inUse:
+                String(localized: "RemoteRecoveryError.inUse.description",
+                       defaultValue: "The recovered changes are in use by another window or another CotEditor.", table: "Remote")
+            case .damaged:
+                String(localized: "RemoteRecoveryError.damaged.description",
+                       defaultValue: "The recovered changes are damaged.", table: "Remote")
+            case .fileSystem(let code):
+                String(localized: "RemoteRecoveryError.fileSystem.description",
+                       defaultValue: "Unsent changes could not be saved on this Mac: \(String(cString: strerror(code))).", table: "Remote",
+                       comment: "%@ is a system error message such as “No space left on device”")
+        }
+    }
+}
+
+
+/// Where the recovery records of remote documents are kept.
+enum RemoteRecoveryStore {
+
+    /// `~/Library/Application Support/<bundle identifier>/RemoteDocuments`.
+    static var defaultRoot: URL {
+
+        URL.applicationSupportDirectory
+            .appending(component: Bundle.main.bundleIdentifier ?? "CotEditor", directoryHint: .isDirectory)
+            .appending(component: "RemoteDocuments", directoryHint: .isDirectory)
+    }
+
+
+    /// Creates the root folder, private to the user, and checks that it is a real folder.
+    static func prepareRoot(_ root: URL) throws {
+
+        try FileManager.default.createDirectory(at: root.deletingLastPathComponent(), withIntermediateDirectories: true)
+        if mkdir(root.path(percentEncoded: false), 0o700) != 0, errno != EEXIST {
+            throw RemoteRecoveryError.fileSystem(errno)
+        }
+
+        var status = stat()
+        guard lstat(root.path(percentEncoded: false), &status) == 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+        guard status.st_mode & S_IFMT == S_IFDIR, status.st_uid == getuid() else {
+            throw RemoteRecoveryError.damaged("the recovery folder is not a folder of this user")
+        }
+        if status.st_mode & 0o077 != 0 {
+            chmod(root.path(percentEncoded: false), 0o700)
+        }
+    }
+
+
+    /// The manifests of the records that no running document holds, newest first.
+    ///
+    /// Damaged records are left alone, so that nothing is deleted that could still be recovered by hand.
+    static func unclaimedManifests(in root: URL) -> [RemoteRecoveryManifest] {
+
+        guard let names = try? FileManager.default.contentsOfDirectory(atPath: root.path(percentEncoded: false)) else { return [] }
+
+        return names
+            .compactMap(UUID.init(uuidString:))
+            .compactMap { try? RemoteRecoveryRecord.unclaimedManifest(in: root, documentID: $0) }
+            .sorted { $0.modificationDate > $1.modificationDate }
+    }
+
+
+    /// Writes a new file that must not exist yet, and flushes it to permanent storage.
+    static func writeExclusively(_ data: Data, to url: URL) throws {
+
+        let descriptor = Darwin.open(url.path(percentEncoded: false), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0o600)
+        guard descriptor >= 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+        defer { Darwin.close(descriptor) }
+
+        try data.withUnsafeBytes { buffer in
+            var offset = 0
+            while offset < buffer.count {
+                let written = Darwin.write(descriptor, buffer.baseAddress! + offset, buffer.count - offset)
+                if written < 0 {
+                    if errno == EINTR { continue }
+                    throw RemoteRecoveryError.fileSystem(errno)
+                }
+                offset += written
+            }
+        }
+
+        // F_FULLFSYNC also flushes the drive's own cache; fsync is the fallback where it is unsupported.
+        guard fcntl(descriptor, F_FULLFSYNC) == 0 || fsync(descriptor) == 0 else {
+            throw RemoteRecoveryError.fileSystem(errno)
+        }
+    }
+
+
+    static func synchronizeDirectory(_ directory: URL) throws {
+
+        let descriptor = Darwin.open(directory.path(percentEncoded: false), O_RDONLY | O_DIRECTORY | O_CLOEXEC)
+        guard descriptor >= 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+        defer { Darwin.close(descriptor) }
+
+        guard fsync(descriptor) == 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+    }
+}
+
+
+/// One remote document's recovery record: a private folder with immutable data files and a manifest.
+///
+/// One actor serializes every change to the record. Data files are written exclusively, flushed and
+/// made durable before a manifest that refers to them replaces the previous one atomically; only
+/// then are files that no manifest refers to any more removed. A crash at any point leaves either
+/// the previous manifest or the new one, each with all its data.
+///
+/// A lock file held while the record is open keeps another document, or another running instance of
+/// the app, from using or cleaning the same record.
+actor RemoteRecoveryRecord {
+
+    /// The points at which writing can be interrupted, for tests that simulate crashes.
+    enum Step: Equatable, Sendable {
+
+        case dataWritten(String)
+        case manifestWritten
+        case manifestReplaced
+        case cleanup
+    }
+
+
+    nonisolated let documentID: UUID
+    nonisolated let directory: URL
+
+    /// The manifest as it was when the record was opened or created.
+    nonisolated let initialManifest: RemoteRecoveryManifest
+
+    private(set) var manifest: RemoteRecoveryManifest
+    private var lockDescriptor: Int32
+    private var faultInjector: (@Sendable (Step) throws -> Void)?
+
+    private static let manifestName = "manifest.plist"
+    private static let lockName = "lock"
+
+
+    private init(documentID: UUID, directory: URL, manifest: RemoteRecoveryManifest, lockDescriptor: Int32) {
+
+        self.documentID = documentID
+        self.directory = directory
+        self.manifest = manifest
+        self.initialManifest = manifest
+        self.lockDescriptor = lockDescriptor
+    }
+
+
+    deinit {
+        if self.lockDescriptor >= 0 {
+            Darwin.close(self.lockDescriptor)
+        }
+    }
+
+
+    // MARK: Opening
+
+    /// Creates a record for a newly downloaded file.
+    ///
+    /// - Parameters:
+    ///   - root: The folder of all records.
+    ///   - documentID: The document's ID, which names the record.
+    ///   - identity: The remote file.
+    ///   - baseline: The file's contents as downloaded.
+    ///   - attributes: The file's attributes when it was read.
+    ///   - isStandalone: Whether the document opens in a window of its own.
+    static func create(in root: URL, documentID: UUID, identity: RemoteFileIdentity, baseline: Data, attributes: RemoteFileAttributes?, isStandalone: Bool) throws -> RemoteRecoveryRecord {
+        try RemoteRecoveryStore.prepareRoot(root)
+
+        let directory = root.appending(component: documentID.uuidString, directoryHint: .isDirectory)
+        guard mkdir(directory.path(percentEncoded: false), 0o700) == 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+
+        let lock = try Self.lock(directory)
+        do {
+            let file = try Self.writeDataFile(baseline, prefix: "baseline", in: directory)
+            var manifest = RemoteRecoveryManifest(documentID: documentID, identity: identity,
+                                                  baseline: .init(file: file, attributes: attributes))
+            manifest.isStandalone = isStandalone
+            try Self.writeManifest(manifest, in: directory, faultInjector: nil)
+
+            return RemoteRecoveryRecord(documentID: documentID, directory: directory, manifest: manifest, lockDescriptor: lock)
+        } catch {
+            Darwin.close(lock)
+            try? FileManager.default.removeItem(at: directory)
+            throw error
+        }
+    }
+
+
+    /// Opens an existing record and holds it.
+    ///
+    /// - Throws: `RemoteRecoveryError.inUse` if another document holds it, or `.damaged` if it does not validate.
+    static func open(in root: URL, documentID: UUID) throws -> RemoteRecoveryRecord {
+
+        let directory = root.appending(component: documentID.uuidString, directoryHint: .isDirectory)
+        let lock = try Self.lock(directory)
+        do {
+            let manifest = try Self.readManifest(in: directory, documentID: documentID)
+            return RemoteRecoveryRecord(documentID: documentID, directory: directory, manifest: manifest, lockDescriptor: lock)
+        } catch {
+            Darwin.close(lock)
+            throw error
+        }
+    }
+
+
+    /// Reads the manifest of a record that no document holds, holding it only while reading.
+    ///
+    /// - Throws: `RemoteRecoveryError.inUse` if a document holds it, or `.damaged` if it does not validate.
+    fileprivate static func unclaimedManifest(in root: URL, documentID: UUID) throws -> RemoteRecoveryManifest {
+
+        let directory = root.appending(component: documentID.uuidString, directoryHint: .isDirectory)
+        let lock = try Self.lock(directory, waits: false)
+        defer { Darwin.close(lock) }
+
+        return try Self.readManifest(in: directory, documentID: documentID)
+    }
+
+
+    /// Releases the record for other documents. The record stays on disk.
+    func relinquish() {
+
+        guard self.lockDescriptor >= 0 else { return }
+
+        Darwin.close(self.lockDescriptor)
+        self.lockDescriptor = -1
+    }
+
+
+    func setFaultInjector(_ injector: (@Sendable (Step) throws -> Void)?) {
+
+        self.faultInjector = injector
+    }
+
+
+    // MARK: Reading
+
+    /// The contents of a data file, checked against its digest.
+    ///
+    /// Data files never change once written, so they can be read without the actor.
+    nonisolated func data(of file: RemoteRecoveryManifest.StoredFile) throws -> Data {
+
+        let url = self.directory.appending(component: file.name, directoryHint: .notDirectory)
+        let descriptor = Darwin.open(url.path(percentEncoded: false), O_RDONLY | O_NOFOLLOW | O_CLOEXEC)
+        guard descriptor >= 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+        let data = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true).readDataToEndOfFile()
+
+        guard data.count == file.size, RemoteDigest.of(data) == file.digest else {
+            throw RemoteRecoveryError.damaged("\(file.name) does not match its digest")
+        }
+
+        return data
+    }
+
+
+    func baselineData() throws -> Data {
+
+        try self.data(of: self.manifest.baseline.file)
+    }
+
+
+    /// The latest recovered text and its settings, if any text was stored.
+    func text() throws -> (string: String, generation: Int, settings: RemoteTextSettings)? {
+
+        guard let text = self.manifest.text else { return nil }
+
+        return (try RemoteRecoveryManifest.decodeText(try self.data(of: text.file)), text.generation, text.settings)
+    }
+
+
+    // MARK: Writing
+
+    /// Stores a text generation.
+    ///
+    /// A generation that is not newer than the stored one is ignored, so a late write can never
+    /// replace newer text.
+    ///
+    /// - Returns: `true` if the text was stored, `false` if it was stale.
+    @discardableResult func writeText(_ string: String, settings: RemoteTextSettings, generation: Int) throws -> Bool {
+
+        if let current = self.manifest.text, current.generation >= generation { return false }
+
+        let file = try self.writeData(Data(string.utf8), prefix: "text")
+        var manifest = self.manifest
+        manifest.text = .init(generation: generation, file: file, settings: settings)
+        try self.publish(manifest)
+
+        return true
+    }
+
+
+    /// Makes a snapshot durable and records an operation that is about to change the server.
+    ///
+    /// - Parameters:
+    ///   - kind: What the operation does.
+    ///   - targetPath: The path it writes.
+    ///   - snapshot: The bytes it writes.
+    ///   - original: The version it expects on the server.
+    ///   - restoreCopy: For a write in place, the version to write back if it is interrupted.
+    ///   - generation: The text generation of the snapshot, or `nil` if it is not the editor's text.
+    ///   - settings: The text settings of the snapshot.
+    ///   - replacedOperationID: An unresolved operation that the user explicitly approved overwriting, after reviewing the server's version.
+    /// - Throws: An error if another operation is unresolved, or if writing fails; then nothing may be sent.
+    func beginOperation(kind: RemoteRecoveryManifest.Operation.Kind, targetPath: String, snapshot: Data, original: RemoteRecoveryManifest.StoredFile, restoreCopy: RemoteRecoveryManifest.StoredFile? = nil, generation: Int?, settings: RemoteTextSettings?, replacing replacedOperationID: UUID? = nil) throws -> RemoteRecoveryManifest.Operation {
+        var detached: RemoteRecoveryManifest.Operation?
+        if let operation = self.manifest.operation, operation.mayHaveChangedTarget, operation.id != replacedOperationID {
+            // A new file elsewhere may be created while an earlier write is unresolved; that write is kept aside.
+            guard kind == .create, operation.kind != .create else {
+                throw RemoteRecoveryError.damaged("operation \(operation.id) is unresolved")
+            }
+            detached = operation
+        }
+
+        let file = try self.writeData(snapshot, prefix: "snapshot")
+        let operation = RemoteRecoveryManifest.Operation(id: UUID(), kind: kind, state: .prepared, targetPath: targetPath,
+                                                         snapshot: file, original: original, restoreCopy: restoreCopy,
+                                                         generation: generation, settings: settings)
+        var manifest = self.manifest
+        if let replaced = manifest.operation, replaced.id == replacedOperationID {
+            manifest.supersededOperation = replaced
+        }
+        manifest.operation = operation
+        if let detached {
+            manifest.detachedOperations.append(detached)
+        }
+        try self.publish(manifest)
+
+        return operation
+    }
+
+
+    /// Moves an operation to a new state. A stale operation ID is ignored.
+    func updateOperation(id: UUID, state: RemoteRecoveryManifest.Operation.State, temporaryPath: String? = nil) throws {
+
+        guard var operation = self.manifest.operation, operation.id == id else { return }
+
+        operation.state = state
+        if let temporaryPath {
+            operation.temporaryPath = temporaryPath
+        }
+        var manifest = self.manifest
+        manifest.operation = operation
+        try self.publish(manifest)
+    }
+
+
+    /// Changes what an operation that has not touched the target will do. A stale operation ID is ignored.
+    func changeOperation(id: UUID, kind: RemoteRecoveryManifest.Operation.Kind, restoreCopy: RemoteRecoveryManifest.StoredFile?) throws {
+
+        guard var operation = self.manifest.operation, operation.id == id, !operation.mayHaveChangedTarget else { return }
+
+        operation.kind = kind
+        operation.restoreCopy = restoreCopy
+        var manifest = self.manifest
+        manifest.operation = operation
+        try self.publish(manifest)
+    }
+
+
+    /// Records the temporary file an operation creates, before it is created, or that it was removed.
+    ///
+    /// A temporary file on the server is only ever removed by the exact path recorded here.
+    func setTemporaryPath(_ path: String?, operationID: UUID) throws {
+
+        guard var operation = self.manifest.operation, operation.id == operationID else { return }
+
+        operation.temporaryPath = path
+        var manifest = self.manifest
+        manifest.operation = operation
+        try self.publish(manifest)
+    }
+
+
+    /// Changes where the file is reached, as when the host resolves to another destination.
+    func updateIdentity(_ identity: RemoteFileIdentity) throws {
+
+        var manifest = self.manifest
+        manifest.identity = identity
+        try self.publish(manifest)
+    }
+
+
+    /// Records that an operation's snapshot is now on the server: the snapshot becomes the baseline.
+    ///
+    /// Only the operation's own fields change. Newer text stays as it is, so a generation stored
+    /// while the upload ran is still an unsent change afterwards.
+    ///
+    /// - Parameters:
+    ///   - id: The operation. A stale ID is ignored.
+    ///   - attributes: The target's attributes after the operation.
+    ///   - identity: The new identity, when the operation created a file at another path.
+    func completeOperation(id: UUID, attributes: RemoteFileAttributes?, identity: RemoteFileIdentity? = nil) throws {
+
+        guard let operation = self.manifest.operation, operation.id == id else { return }
+
+        var manifest = self.manifest
+        manifest.baseline = .init(file: operation.snapshot, attributes: attributes)
+        manifest.operation = nil
+        manifest.supersededOperation = nil
+        manifest.reviewed = nil
+        if let identity {
+            manifest.identity = identity
+        }
+        if let temporaryPath = operation.temporaryPath {
+            manifest.retainedTemporaryPaths.removeAll { $0 == temporaryPath }
+        }
+        try self.publish(manifest)
+    }
+
+
+    /// Records that an operation ended without changing the target.
+    ///
+    /// - Parameters:
+    ///   - id: The operation. A stale ID is ignored.
+    ///   - retainedTemporaryPath: A temporary file that was left on the server, to report it.
+    func abandonOperation(id: UUID, retainedTemporaryPath: String? = nil) throws {
+
+        guard self.manifest.operation?.id == id else { return }
+
+        var manifest = self.manifest
+        manifest.operation = manifest.supersededOperation
+        manifest.supersededOperation = nil
+        if let retainedTemporaryPath, !manifest.retainedTemporaryPaths.contains(retainedTemporaryPath) {
+            manifest.retainedTemporaryPaths.append(retainedTemporaryPath)
+        }
+        try self.publish(manifest)
+    }
+
+
+    /// Stores a remote version the user reviewed after a conflict.
+    func storeReviewedVersion(_ data: Data) throws -> RemoteRecoveryManifest.StoredFile {
+
+        let file = try self.writeData(data, prefix: "reviewed")
+        var manifest = self.manifest
+        manifest.reviewed = file
+        try self.publish(manifest)
+
+        return file
+    }
+
+
+    /// Makes a freshly downloaded version the baseline and drops the stored text, as when the user
+    /// reverts to the remote version.
+    func adoptRemoteVersion(_ data: Data, attributes: RemoteFileAttributes?) throws {
+
+        guard self.manifest.operation?.mayHaveChangedTarget != true else {
+            throw RemoteRecoveryError.damaged("an unresolved operation must be resolved first")
+        }
+
+        let file = try self.writeData(data, prefix: "baseline")
+        var manifest = self.manifest
+        manifest.baseline = .init(file: file, attributes: attributes)
+        manifest.text = nil
+        manifest.operation = nil
+        manifest.reviewed = nil
+        try self.publish(manifest)
+    }
+
+
+    func setConsentsToInPlaceSaving(_ consents: Bool) throws {
+
+        var manifest = self.manifest
+        manifest.consentsToInPlaceSaving = consents
+        try self.publish(manifest)
+    }
+
+
+    func setPresentation(isOpen: Bool, isStandalone: Bool? = nil, keepsAfterClose: Bool? = nil) throws {
+
+        var manifest = self.manifest
+        manifest.isOpen = isOpen
+        if let isStandalone { manifest.isStandalone = isStandalone }
+        if let keepsAfterClose { manifest.keepsAfterClose = keepsAfterClose }
+        try self.publish(manifest)
+    }
+
+
+    /// Deletes the record from disk and releases it.
+    func remove() throws {
+
+        try FileManager.default.removeItem(at: self.directory)
+        self.relinquish()
+    }
+
+
+    // MARK: Private Methods
+
+    private func writeData(_ data: Data, prefix: String) throws -> RemoteRecoveryManifest.StoredFile {
+
+        let file = try Self.writeDataFile(data, prefix: prefix, in: self.directory)
+        try self.faultInjector?(.dataWritten(file.name))
+
+        return file
+    }
+
+
+    /// Replaces the manifest, then removes the data files it no longer refers to.
+    private func publish(_ manifest: RemoteRecoveryManifest) throws {
+
+        var manifest = manifest
+        manifest.modificationDate = .now
+
+        try Self.writeManifest(manifest, in: self.directory, faultInjector: self.faultInjector)
+        self.manifest = manifest
+        try self.faultInjector?(.manifestReplaced)
+
+        try self.faultInjector?(.cleanup)
+        self.removeUnreferencedFiles()
+    }
+
+
+    /// Removes every file of the folder that the current manifest does not refer to.
+    private func removeUnreferencedFiles() {
+
+        let keep = self.manifest.referencedFileNames.union([Self.manifestName, Self.lockName])
+        guard let names = try? FileManager.default.contentsOfDirectory(atPath: self.directory.path(percentEncoded: false)) else { return }
+
+        for name in names where !keep.contains(name) {
+            // unlink removes a link itself, never what it points to
+            unlink(self.directory.appending(component: name).path(percentEncoded: false))
+        }
+    }
+
+
+    /// Takes the record's lock.
+    ///
+    /// - Parameter waits: Whether to keep trying for a moment before reporting the record as in use.
+    private static func lock(_ directory: URL, waits: Bool = true) throws -> Int32 {
+
+        let path = directory.appending(component: Self.lockName).path(percentEncoded: false)
+        let descriptor = Darwin.open(path, O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0o600)
+        guard descriptor >= 0 else { throw RemoteRecoveryError.fileSystem(errno) }
+
+        // A process forked at this moment, such as a terminal's shell, holds a copy of the descriptor
+        // until it runs its program, so a lock just released can look taken for an instant.
+        let attempts = waits ? 25 : 1
+        for attempt in 0..<attempts {
+            if flock(descriptor, LOCK_EX | LOCK_NB) == 0 { return descriptor }
+            let code = errno
+            guard code == EWOULDBLOCK, attempt < attempts - 1 else {
+                Darwin.close(descriptor)
+                throw code == EWOULDBLOCK ? RemoteRecoveryError.inUse : RemoteRecoveryError.fileSystem(code)
+            }
+            usleep(20_000)
+        }
+
+        return descriptor
+    }
+
+
+    private static func writeDataFile(_ data: Data, prefix: String, in directory: URL) throws -> RemoteRecoveryManifest.StoredFile {
+
+        let name = prefix + "-" + UUID().uuidString.lowercased()
+        try RemoteRecoveryStore.writeExclusively(data, to: directory.appending(component: name, directoryHint: .notDirectory))
+
+        return .init(name: name, digest: RemoteDigest.of(data), size: data.count)
+    }
+
+
+    private static func writeManifest(_ manifest: RemoteRecoveryManifest, in directory: URL, faultInjector: (@Sendable (Step) throws -> Void)?) throws {
+        let encoder = PropertyListEncoder()
+        encoder.outputFormat = .binary
+        let data = try encoder.encode(manifest)
+
+        let temporaryURL = directory.appending(component: "manifest-" + UUID().uuidString.lowercased() + ".tmp")
+        try RemoteRecoveryStore.writeExclusively(data, to: temporaryURL)
+        try faultInjector?(.manifestWritten)
+
+        guard rename(temporaryURL.path(percentEncoded: false), directory.appending(component: Self.manifestName).path(percentEncoded: false)) == 0 else {
+            let code = errno
+            unlink(temporaryURL.path(percentEncoded: false))
+            throw RemoteRecoveryError.fileSystem(code)
+        }
+        try RemoteRecoveryStore.synchronizeDirectory(directory)
+    }
+
+
+    private static func readManifest(in directory: URL, documentID: UUID) throws -> RemoteRecoveryManifest {
+
+        let url = directory.appending(component: Self.manifestName, directoryHint: .notDirectory)
+        let descriptor = Darwin.open(url.path(percentEncoded: false), O_RDONLY | O_NOFOLLOW | O_CLOEXEC)
+        guard descriptor >= 0 else { throw RemoteRecoveryError.damaged("no manifest") }
+        let data = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true).readDataToEndOfFile()
+
+        let manifest: RemoteRecoveryManifest
+        do {
+            manifest = try PropertyListDecoder().decode(RemoteRecoveryManifest.self, from: data)
+        } catch {
+            throw RemoteRecoveryError.damaged("unreadable manifest")
+        }
+
+        // The manifest is validated before any path it names is used.
+        guard manifest.formatVersion == RemoteRecoveryManifest.currentFormatVersion else { throw RemoteRecoveryError.damaged("unknown format") }
+        guard manifest.documentID == documentID else { throw RemoteRecoveryError.damaged("the manifest belongs to another record") }
+        guard
+            (try? manifest.identity.endpoint.validated()) == manifest.identity.endpoint,
+            (try? RemotePath.validated(manifest.identity.path)) != nil,
+            (try? RemotePath.validated(manifest.identity.requestedPath)) != nil
+        else { throw RemoteRecoveryError.damaged("invalid identity") }
+
+        for name in manifest.referencedFileNames {
+            guard
+                name.wholeMatch(of: /[a-z]+-[0-9a-f-]{36}/) != nil,
+                (try? FileManager.default.attributesOfItem(atPath: directory.appending(component: name).path(percentEncoded: false))[.type] as? FileAttributeType) == .typeRegular
+            else { throw RemoteRecoveryError.damaged("missing or invalid data file \(name)") }
+        }
+
+        return manifest
+    }
+}
