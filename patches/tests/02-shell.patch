+    @Test(.timeLimit(.minutes(1))) func arrowKeysMoveByWordAndLineAsOnTheMac() async throws {
+        
+        // `\033[?1h` switches the cursor keys to application mode, as full-screen programs do.
+        for (setup, bytes) in [("", ["1b", "62", "1b", "66", "01", "05"]),
+                               (#"printf '\033[?1h'; "#, ["1b", "62", "1b", "66", "1b", "4f", "48", "1b", "4f", "46"])]
+        {
+            let engine = SwiftTermEngine()
+            defer { engine.shutDown() }
+            var didExit = false
+            engine.onExit = { _ in didExit = true }
+            let window = Self.makeWindow(showing: engine)
+            defer { window.close() }
+            
+            try engine.start(self.shell("stty raw -echo; \(setup)echo READY; head -c \(bytes.count) | od -An -tx1; stty sane", in: FileManager.default.temporaryDirectory))
+            try await self.wait { engine.bufferText.contains("READY") }
+            #expect(window.makeFirstResponder(engine.focusView))
+            
+            // Option-arrows arrive as key events, Command-arrows as key equivalents first.
+            let arrow = { (modifiers: NSEvent.ModifierFlags, key: Int, keyCode: UInt16) throws -> NSEvent in
+                let character = String(UnicodeScalar(UInt16(key))!)
+                return try #require(NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: modifiers.union([.numericPad, .function]),
+                                                     timestamp: 0, windowNumber: window.windowNumber, context: nil,
+                                                     characters: character, charactersIgnoringModifiers: character, isARepeat: false, keyCode: keyCode))
+            }
+            engine.focusView.keyDown(with: try arrow(.option, NSLeftArrowFunctionKey, 123))
+            engine.focusView.keyDown(with: try arrow(.option, NSRightArrowFunctionKey, 124))
+            #expect(window.performKeyEquivalent(with: try arrow(.command, NSLeftArrowFunctionKey, 123)))
+            #expect(window.performKeyEquivalent(with: try arrow(.command, NSRightArrowFunctionKey, 124)))
+            
+            // The system's od separates bytes with two spaces.
+            let expected = bytes.joined(separator: "  ")
+            try await self.wait { didExit && engine.bufferText.contains(expected) }
+        }
+    }
