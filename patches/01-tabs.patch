+import AppKit
+
+
+/// A tab in a directory window that shows something other than a file, such as a terminal.
+///
+/// The directory's tab state, content host, close handling and archive treat every such tab through
+/// this protocol alone, so a new kind of tab needs no branches of its own in them. An item is never
+/// a document: it is not in the document registry, never marks the window as edited, and leaves
+/// `activeFileDocument` nil while it is selected, so that no file command reaches a hidden editor.
+@MainActor protocol DirectoryTabItem: AnyObject {
+
+    /// The tab's identity, which the tab keeps unless another tab already has it.
+    var id: UUID { get }
+
+    /// The archive kind of the tab, as registered in `DirectoryTabKind`.
+    var tabKind: String { get }
+
+    /// The title in the tab strip and the window subtitle.
+    ///
+    /// The strip refreshes when an observable property read here changes.
+    var tabTitle: String { get }
+
+    var tabIcon: NSImage? { get }
+
+    /// The tooltip in the tab strip. Like the title, it refreshes with the observable properties it reads.
+    var tabToolTip: String { get }
+
+    /// The accessibility label of the content area while the tab is selected.
+    var tabAccessibilityLabel: String { get }
+
+    /// Makes the controller that shows the tab.
+    ///
+    /// The window asks once per tab and keeps the controller while the tab is open, so switching tabs
+    /// only moves its view in and out of the window.
+    func makeTabViewController(in directory: DirectoryDocument) -> any DirectoryTabViewController
+
+    /// Called once when the tab joins a directory, before it is shown.
+    func didJoin(_ directory: DirectoryDocument)
+
+    /// Asks whether this one tab may close, which may show a sheet in the directory's window.
+    func approveTabClose(in directory: DirectoryDocument) async -> Bool
+
+    /// Called before the directory shows a review of its own, such as a close confirmation.
+    ///
+    /// Anything the tab shows over the window, such as a sheet that the tab's content asked for,
+    /// must go away now, so that the review is the only thing the user answers.
+    func directoryWillShowReview()
+
+    /// Stops whatever the tab runs. Called once, after every approval, when the tab leaves its directory.
+    func tearDown()
+
+    /// The fields to archive for the tab, or `nil` if it cannot be restored.
+    func archivedFields() -> [String: Any]?
+
+    /// The commands of the tab's context menu.
+    func tabContextMenuItems(in directory: DirectoryDocument) -> [DirectoryTabBar.MenuItem]
+}
+
+
+extension DirectoryTabItem {
+
+    var tabAccessibilityLabel: String  { self.tabTitle }
+
+    func didJoin(_ directory: DirectoryDocument) { }
+
+    func approveTabClose(in directory: DirectoryDocument) async -> Bool { true }
+
+    func directoryWillShowReview() { }
+
+    func tabContextMenuItems(in directory: DirectoryDocument) -> [DirectoryTabBar.MenuItem] { [] }
+}
+
+
+/// The controller the content host shows for a `DirectoryTabItem`.
+@MainActor protocol DirectoryTabViewController: NSViewController {
+
+    /// Moves keyboard focus into the tab.
+    func focusTabContent()
+}
+
+
+/// What a directory needs to know about a kind of `DirectoryTabItem` as a whole.
+///
+/// This is not a plugin system: the patch that adds a kind of tab registers it in `registered`.
+@MainActor struct DirectoryTabKind {
+
+    /// The kind of the tab's archive entries.
+    var archiveKind: String
+
+    /// Asks once for all tabs of this kind before a window with them closes, without stopping anything.
+    ///
+    /// Closing stops each tab through `DirectoryTabItem.tearDown()` only once every approval has been given.
+    var approveClosingWindow: @MainActor (_ items: [any DirectoryTabItem], _ directory: DirectoryDocument) async -> Bool = { _, _ in true }
+
+    /// Recreates the archived tabs of this kind, in archived order. The directory inserts and selects them.
+    ///
+    /// The entries are untrusted: invalid ones must be skipped rather than fail the others.
+    var restore: @MainActor (_ entries: [DirectoryTabArchive.ForeignEntry], _ directory: DirectoryDocument) -> [any DirectoryTabItem] = { _, _ in [] }
+
+    /// Reopens archived tabs of this kind that are member documents rather than items, such as files that
+    /// are not in the folder. The directory adopts each document under its tab ID, and selects it if it
+    /// has the archived selection.
+    ///
+    /// The entries are untrusted, as for `restore`.
+    var restoreDocuments: @MainActor (_ entries: [DirectoryTabArchive.ForeignEntry], _ directory: DirectoryDocument) -> [(tabID: UUID, document: DataDocument)] = { _, _ in [] }
+
+    /// The commands in the tab strip's “+” menu that open tabs of this kind, if any.
+    var addMenuItems: (@MainActor (_ directory: DirectoryDocument) -> [DirectoryTabBar.MenuItem])?
+
+
+    /// The kinds of tabs besides files that this app has, in the order of the “+” menu.
+    static var registered: [DirectoryTabKind] {
+
+        []
+    }
+}
