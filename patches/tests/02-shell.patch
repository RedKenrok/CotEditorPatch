+            #expect(await directory.openDocument(at: urls[0]))
+            let terminal = try #require(directory.openTerminalTab(in: urls[0].deletingLastPathComponent()))
+            terminal.rename(to: "Server")
+            #expect(await directory.openDocument(at: urls[1]))
+            directory.selectTerminal(terminal)
+            let ids = directory.tabState.entries.map(\.id)
+            let data = self.encodeRestorableState(of: directory)
+            directory.close()
+            let madeBeforeRestore = engines.made.count
+
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                try await self.wait { restored.tabDocuments.count == 2 }
+                #expect(restored.tabState.entries.map(\.id) == ids)
+                #expect(restored.tabState.selectedID == ids[1], "the selected terminal is still selected")
+                let placeholder = try #require(restored.activeTerminalSession)
+                #expect(placeholder.lifecycle == .inactive)
+                #expect(placeholder.title == "Server")
+                #expect(restored.activeFileDocument == nil)
+                #expect(engines.made.count == madeBeforeRestore, "restoration never starts a shell")
+
+                placeholder.start()
+                #expect(placeholder.isLive)
+                let started = try #require(engines.made.last?.configurations.first?.currentDirectory)
+                #expect(URL(filePath: started).resolvingSymlinksInPath().standardizedFileURL.path(percentEncoded: false)
+                        == urls[0].deletingLastPathComponent().resolvingSymlinksInPath().standardizedFileURL.path(percentEncoded: false))
+            }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func terminalTabsReorderButStayInTheirWindow() async throws {
+        
+        try await self.withTerminals { directory, urls, _, _ in
+            #expect(await directory.openDocument(at: urls[0]))
+            let terminal = try #require(directory.openTerminalTab())
+            #expect(await directory.openDocument(at: urls[1]))
+            let ids = directory.tabState.entries.map(\.id)
+            
+            directory.moveTab(id: ids[1], to: 2)
+            #expect(directory.tabState.entries.map(\.id) == [ids[0], ids[2], ids[1]])
+            
+            // Detachable terminals are outside the terminal patch: the command is neither offered nor carried out.
+            #expect(!directory.canMoveTabToNewWindow(id: ids[1]))
+            #expect(directory.tabPresentations.first { $0.id == ids[1] }?.canMoveToNewWindow == false)
+            #expect(!directory.moveTabToNewWindow(id: ids[1]))
+            #expect(directory.terminalSessions.first === terminal)
+            #expect(terminal.isLive)
+            
+            let data = self.encodeRestorableState(of: directory)
+            directory.close()
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                try await self.wait { restored.tabDocuments.count == 2 }
+                #expect(restored.tabState.entries.map(\.id) == [ids[0], ids[2], ids[1]], "the moved order survives a relaunch")
+            }
+        }
+    }
+    
+    
+    @Test(.timeLimit(.minutes(1))) func reconcilingFilesKeepsTerminalPlaces() async throws {
+
+        try await self.withTerminals { directory, urls, _, _ in
+            #expect(await directory.openDocument(at: urls[0]))
+            let terminal = try #require(directory.openTerminalTab())
+            #expect(await directory.openDocument(at: urls[1]))
+            let ids = directory.tabState.entries.map(\.id)
+
+            directory.tabState.reconcile(with: directory.tabDocuments)
+            #expect(directory.tabState.entries.map(\.id) == ids)
+            #expect(directory.tabState.entries[1].terminalSession === terminal)
+        }
+    }
+}
+
+
+// MARK: - Fixtures
+
+extension DirectoryTabTests {
+
+    /// Runs the body with fake terminal engines and scripted prompts installed.
+    ///
+    /// - Parameter registersDocument: Whether the directory joins the document controller, for app-wide coordinators.
+    func withTerminals(makesWindow: Bool = false, registersDocument: Bool = false,
+                       _ body: (DirectoryDocument, [URL], FakeTerminalEngines, ScriptedTerminalPrompts) async throws -> Void) async throws
+    {
+        let engines = FakeTerminalEngines()
+        let prompts = ScriptedTerminalPrompts()
+        let originalFactory = TerminalSession.defaultEngineFactory
+        let originalPrompts = TerminalPrompts.current
+        TerminalSession.defaultEngineFactory = engines.make
+        TerminalPrompts.current = prompts
+        defer {
+            TerminalSession.defaultEngineFactory = originalFactory
+            TerminalPrompts.current = originalPrompts
+        }
+
+        try await self.withDirectory(makesWindow: makesWindow) { directory, urls in
+            if registersDocument {
+                NSDocumentController.shared.addDocument(directory)
+            }
+            defer {
+                if registersDocument {
+                    NSDocumentController.shared.removeDocument(directory)
+                }
+            }
+            try await body(directory, urls, engines, prompts)
+        }
+    }
+}
+
+
+/// A fake terminal view that takes keyboard focus like the real one.
+private final class FocusableTerminalView: NSView {
+    
+    override var acceptsFirstResponder: Bool { true }
+}
+
+
+extension DirectoryTabTests {
+    
+    static func firstOutlineView(in view: NSView) -> NSOutlineView? {
+        
+        (view as? NSOutlineView) ?? view.subviews.lazy.compactMap { Self.firstOutlineView(in: $0) }.first
+    }
+}
+
+
+/// Answers terminal prompts from a script and records what was asked.
+@MainActor final class ScriptedTerminalPrompts: TerminalPrompting {
+
+    var answers: [Bool] = []
+    var suspends = false
+    private(set) var closeRequests: [TerminalCloseRequest] = []
+    private(set) var enableRequests = 0
+    private(set) var pending: CheckedContinuation<Bool, Never>?
+
+
+    func confirmClosing(_ request: TerminalCloseRequest, window: NSWindow?) async -> Bool {
+
+        self.closeRequests.append(request)
+
+        if self.suspends {
+            return await withCheckedContinuation { self.pending = $0 }
+        }
+        return self.answers.isEmpty ? false : self.answers.removeFirst()
+    }
+
+
+    func confirmEnablingTabs(window: NSWindow?) async -> Bool {
+
+        self.enableRequests += 1
+        return self.answers.isEmpty ? false : self.answers.removeFirst()
+    }
+
+
+    func askForTitle(current: String, window: NSWindow?) async -> String? {
+
+        nil
+    }
+
+
+    func resume(with answer: Bool) {
+
+        self.pending?.resume(returning: answer)
+        self.pending = nil
+        self.suspends = false
+    }
+}
+
+
+/// A root whose terminals run elsewhere, through a launcher that runs a fixed program.
+@MainActor final class FakeTerminalRoot: DirectoryRoot, TerminalLaunchProviding {
+
+    var error: (any Error)?
+    private(set) var launchCount = 0
+
+
+    var displayName: String  { "Elsewhere" }
+
+    var subtitle: String  { "elsewhere:/folder" }
+
+
+    func makeSidebarViewController(for directory: DirectoryDocument) -> NSViewController {
+
+        let controller = NSViewController()
+        controller.view = NSView(frame: NSRect(x: 0, y: 0, width: 200, height: 400))
+        return controller
+    }
+
+
+    func directoryDidChangeState(_ directory: DirectoryDocument) { }
+
+    func directoryDidClose(_ directory: DirectoryDocument) { }
+
+
+    func makeTerminalLauncher(for directory: DirectoryDocument) async throws -> TerminalLauncher {
+
+        if let error { throw error }
+
+        return TerminalLauncher(location: "elsewhere:/folder") { [weak self] in
+            self?.launchCount += 1
+            return TerminalLaunchConfiguration(executable: "/usr/bin/true", argv0: "true", arguments: [], environment: [], currentDirectory: "/")
+        }
+    }
+}
