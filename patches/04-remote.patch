+import AppKit
+
+
+/// Where a remote folder window's folder is and how it was reached.
+///
+/// Two identities are the same folder only if they name the same canonical path, by its bytes,
+/// through the same endpoint to the same destination, as file identities do. A window's identity
+/// never changes: when the folder's path or the connection leads elsewhere later, the other place is
+/// another folder, for another window.
+struct RemoteFolderIdentity: Codable, Hashable, Sendable {
+
+    /// The saved connection the folder was opened with, if any.
+    var profileID: UUID?
+    var endpoint: RemoteEndpoint
+    var destination: RemoteDestination
+
+    /// The path the user asked for, which is resolved again on reconnecting to notice a change.
+    var requestedPath: String
+
+    /// The folder's canonical path, as `REALPATH` returned it.
+    var path: String
+
+
+    /// The name of the folder, `/` for the file system's root.
+    var name: String {
+
+        (self.path == "/") ? "/" : RemoteFileIdentity.fileName(of: self.path)
+    }
+
+
+    /// The user and host, as the user knows them.
+    var connectionName: String {
+
+        "\(self.destination.user)@\(self.endpoint.host)"
+    }
+
+
+    /// The location in the form `user@host:/path`.
+    var displayLocation: String {
+
+        "\(self.connectionName):\(self.path)"
+    }
+
+
+    /// The location, with the port if it is not SSH's usual one.
+    var fullLocation: String {
+
+        guard self.destination.port != 22 else { return self.displayLocation }
+
+        return String(localized: "RemoteFolder.locationWithPort", defaultValue: "\(self.displayLocation) (port \(self.destination.port))", table: "Remote",
+                      comment: "a remote folder's location followed by its port (%@ is the location, %lld the port)")
+    }
+
+
+    /// The request that opens this identity's folder again, as the user asked for it.
+    var request: RemoteFolderRequest {
+
+        RemoteFolderRequest(profileID: self.profileID, endpoint: self.endpoint, path: self.requestedPath)
+    }
+
+
+    static func == (lhs: Self, rhs: Self) -> Bool {
+
+        lhs.endpoint == rhs.endpoint && lhs.destination == rhs.destination && RemotePath.isSame(lhs.path, rhs.path)
+    }
+
+
+    func hash(into hasher: inout Hasher) {
+
+        hasher.combine(self.endpoint)
+        hasher.combine(self.destination)
+        hasher.combine(Array(self.path.utf8))
+    }
+}
+
+
+/// What the user asked to open as a folder.
+struct RemoteFolderRequest: Equatable, Sendable {
+
+    /// The path that asks for the folder the server starts a session in, `REALPATH(".")`, which need not be the account's home.
+    static let startingFolder = "."
+
+    var profileID: UUID?
+    var endpoint: RemoteEndpoint
+    var path: String
+}
+
+
+enum RemoteFolderError: Error, Equatable {
+
+    /// The item at the path is not a folder.
+    case notAFolder(path: String)
+}
+
+
+extension RemoteFolderError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .notAFolder(let path):
+                String(localized: "RemoteFolderError.notAFolder", defaultValue: "“\(RemotePath.displayName(of: path))” is not a folder.", table: "Remote",
+                       comment: "%@ is a file name")
+        }
+    }
+}
+
+
+/// Opens remote folders in windows, and keeps one window per folder.
+@MainActor enum RemoteFolderOpenCoordinator {
+
+    private struct PendingKey: Hashable {
+
+        var endpoint: RemoteEndpoint
+        /// The path's bytes, as for files.
+        var path: [UInt8]
+    }
+
+
+    private struct Entry {
+
+        weak var session: RemoteFolderSession?
+    }
+
+
+    /// The open folder windows, by identity.
+    private static var sessions: [RemoteFolderIdentity: Entry] = [:]
+
+    /// Opens under way, so that asking twice at once opens the folder once.
+    private static var pending: [PendingKey: Task<RemoteFolderSession, any Error>] = [:]
+
+
+    // MARK: Opening
+
+    /// Opens a remote folder in a window of its own, or brings forward the window that shows it already.
+    ///
+    /// - Parameters:
+    ///   - request: What to open.
+    ///   - environment: The services the window and its documents work with.
+    /// - Returns: The session of the window.
+    @discardableResult static func open(_ request: RemoteFolderRequest, environment: RemoteEnvironment = .current) async throws -> RemoteFolderSession {
+
+        let key = PendingKey(endpoint: try request.endpoint.validated(), path: Array(request.path.utf8))
+        if let task = self.pending[key] {
+            let session = try await task.value
+            session.showWindow()
+            return session
+        }
+
+        let task = Task {
+            let identity = try await self.resolve(request, environment: environment)
+            return self.open(identity, environment: environment)
+        }
+        self.pending[key] = task
+        defer { self.pending[key] = nil }
+
+        return try await task.value
+    }
+
+
+    /// Opens a window for a folder whose identity was just resolved, or brings forward the one that has it.
+    ///
+    /// - Parameters:
+    ///   - identity: The folder, resolved on the server.
+    ///   - environment: The services the window works with.
+    /// - Returns: The session of the window.
+    @discardableResult static func open(_ identity: RemoteFolderIdentity, environment: RemoteEnvironment) -> RemoteFolderSession {
+
+        if let session = self.session(for: identity) {
+            session.showWindow()
+            return session
+        }
+
+        let session = RemoteFolderSession(identity: identity, environment: environment)
+        self.register(session)
+        session.openWindow()
+        session.start()
+        RemoteConnectionLibrary.shared.noteRecentFolder(identity)
+
+        return session
+    }
+
+
+    /// Finds the folder a request names on the server, and checks that it is a folder that can be listed.
+    ///
+    /// - Throws: `RemoteFolderError.notAFolder`, or the error of the failed request.
+    static func resolve(_ request: RemoteFolderRequest, environment: RemoteEnvironment) async throws -> RemoteFolderIdentity {
+
+        let endpoint = try request.endpoint.validated()
+        let isStartingFolder = (request.path == RemoteFolderRequest.startingFolder)
+        let path = isStartingFolder ? request.path : try RemotePath.validated(request.path)
+        let destination = try await environment.pool.destination(for: endpoint)
+
+        let canonicalPath = try await environment.pool.withBrowsingConnection(to: endpoint, destination: destination) { transport in
+            try await self.resolveFolder(path, with: transport)
+        }
+
+        // The window then stands for the folder found, not for wherever a later session happens to start.
+        return RemoteFolderIdentity(profileID: request.profileID, endpoint: endpoint, destination: destination,
+                                    requestedPath: isStartingFolder ? canonicalPath : path, path: canonicalPath)
+    }
+
+
+    /// Resolves a path to a folder and proves that it can be listed.
+    ///
+    /// - Returns: The canonical path of the folder.
+    nonisolated static func resolveFolder(_ path: String, with transport: any RemoteDirectoryTransport) async throws -> String {
+
+        let canonicalPath = try await transport.realpath(path)
+        let attributes = try await transport.stat(canonicalPath)
+
+        switch attributes.kind {
+            case .directory, .unknown:
+                // Opening the folder proves both that it is one and that it can be listed.
+                let handle: RemoteDirectoryHandle
+                do {
+                    handle = try await transport.openDirectory(canonicalPath)
+                } catch let error as RemoteSFTPError where error.status == .failure {
+                    throw RemoteFolderError.notAFolder(path: canonicalPath)
+                }
+                try? await transport.closeDirectory(handle)
+            default:
+                throw RemoteFolderError.notAFolder(path: canonicalPath)
+        }
+
+        return canonicalPath
+    }
+
+
+    // MARK: Registry
+
+    /// The window that shows the folder, if one is open.
+    static func session(for identity: RemoteFolderIdentity) -> RemoteFolderSession? {
+
+        self.sessions[identity]?.session
+    }
+
+
+    /// Every open folder window's session.
+    static var openSessions: [RemoteFolderSession] {
+
+        self.sessions.values.compactMap(\.session)
+    }
+
+
+    static func register(_ session: RemoteFolderSession) {
+
+        self.sessions[session.identity] = Entry(session: session)
+    }
+
+
+    static func unregister(_ session: RemoteFolderSession) {
+
+        guard self.sessions[session.identity]?.session === session else { return }
+
+        self.sessions[session.identity] = nil
+    }
+}
