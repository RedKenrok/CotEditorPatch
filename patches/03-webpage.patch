+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Observation
+
+
+/// The state of one webpage tab: what it shows, and what its last navigation did.
+///
+/// It is not a document: it has no file and no edited marker. The web view and its navigation history
+/// belong to the tab's `WebPageViewController`, which reports WebKit's events here. Events carry a
+/// token for the navigation they belong to, and only the navigation started last may change the state,
+/// so a late completion or cancellation of an older load never overwrites a newer one.
+@MainActor @Observable final class WebPageSession {
+
+    /// A navigation that did not reach its page.
+    struct Failure: Equatable {
+
+        /// The address the navigation was going to.
+        var url: URL?
+        var message: String
+        /// Whether the request can be sent again: only a GET without a body, whose pairing with WebKit's
+        /// policy decision was unambiguous, ever is.
+        var isRetryable: Bool
+        /// Whether the failure happened before the page changed, so the previous page is still shown.
+        var keepsPreviousPage: Bool
+    }
+
+
+    /// Something the user asked for that a webpage tab does not do, such as a download.
+    struct Notice: Equatable {
+
+        var message: String
+    }
+
+
+    /// The main-frame request WebKit decided to load, before it became a navigation.
+    struct PolicyDecision: Equatable {
+
+        var url: URL?
+        var isSafeToRepeat: Bool
+    }
+
+
+    /// Identifies one WebKit navigation.
+    struct NavigationToken: Hashable {
+
+        private let id: ObjectIdentifier
+
+        init(_ object: AnyObject) {
+
+            self.id = ObjectIdentifier(object)
+        }
+    }
+
+
+    enum Lifecycle: Equatable {
+
+        /// A new tab that has not loaded anything.
+        case empty
+        /// A restored tab that waits for the user to load its address.
+        case restored
+        /// A tab whose web view has been asked to load something.
+        case active
+        /// The web content process ended; nothing reloads by itself.
+        case contentProcessEnded
+        case closed
+    }
+
+
+    // MARK: Public Properties
+
+    let id: UUID
+
+    private(set) var lifecycle: Lifecycle
+
+    /// The address of the page that last committed, as the web view reports it, including redirects.
+    private(set) var currentURL: URL?
+
+    /// The address a restored tab offers to load.
+    private(set) var restoredURL: URL?
+
+    /// The page's own title, sanitized for the tab strip.
+    private(set) var pageTitle: String?
+
+    private(set) var isLoading = false
+    private(set) var canGoBack = false
+    private(set) var canGoForward = false
+
+    private(set) var failure: Failure?
+    private(set) var notice: Notice?
+
+
+    /// The controller showing the tab, once the window has made it.
+    @ObservationIgnored weak var controller: WebPageViewController?
+
+
+    // MARK: Private Properties
+
+    @ObservationIgnored private var currentNavigation: NavigationToken?
+    @ObservationIgnored private var currentNavigationDecision: PolicyDecision?
+    @ObservationIgnored private var currentNavigationHasCommitted = false
+    @ObservationIgnored private var pendingDecision: PolicyDecision?
+
+
+    // MARK: Lifecycle
+
+    /// Makes a new, empty tab.
+    init(id: UUID = UUID()) {
+
+        self.id = id
+        self.lifecycle = .empty
+    }
+
+
+    /// Makes a tab restored from the archive, which loads nothing until the user asks.
+    ///
+    /// - Parameters:
+    ///   - id: The archived tab ID.
+    ///   - url: The archived address, already checked against the navigation policy, or `nil` for an empty tab.
+    ///   - title: The archived title.
+    init(id: UUID, restoring url: URL?, title: String?) {
+
+        self.id = id
+        self.restoredURL = url
+        self.pageTitle = title.flatMap(Self.sanitizedTitle)
+        self.lifecycle = (url == nil) ? .empty : .restored
+    }
+
+
+    // MARK: Presentation
+
+    /// The title for the tab: the page's title, then the host, then “Webpage”.
+    var title: String {
+
+        if let pageTitle { return pageTitle }
+        if let host = (self.currentURL ?? self.restoredURL)?.host(percentEncoded: false), !host.isEmpty { return host }
+
+        return Self.defaultTitle
+    }
+
+
+    /// The address the tab stands for: the shown page's, or the one a restored tab offers.
+    var address: URL? {
+
+        self.currentURL ?? self.restoredURL
+    }
+
+
+    static var defaultTitle: String {
+
+        String(localized: "WebPageSession.defaultTitle", defaultValue: "Webpage", table: "WebPages",
+               comment: "name of a webpage tab that shows no page yet")
+    }
+
+
+    /// Makes a page title fit for the tab strip: one line, without surrounding space, and not endless.
+    nonisolated static func sanitizedTitle(_ title: String) -> String? {
+
+        let line = title.split(whereSeparator: { $0.isWhitespace || $0.isNewline }).joined(separator: " ")
+
+        guard !line.isEmpty else { return nil }
+
+        return line.count > 200 ? String(line.prefix(200)) + "…" : line
+    }
+
+
+    // MARK: Requests
+
+    /// Notes that the web view was asked to load something, which ends the empty or restored state.
+    func willLoad() {
+
+        guard self.lifecycle != .closed else { return }
+
+        self.lifecycle = .active
+        self.restoredURL = nil
+        self.failure = nil
+        self.notice = nil
+    }
+
+
+    /// Notes that the user stopped loading. Stopping is not a failure.
+    func didStop() {
+
+        guard self.lifecycle != .closed else { return }
+
+        self.currentNavigation = nil
+        self.currentNavigationDecision = nil
+        self.pendingDecision = nil
+        self.isLoading = false
+    }
+
+
+    func show(_ notice: Notice) {
+
+        guard self.lifecycle != .closed else { return }
+
+        self.notice = notice
+    }
+
+
+    func dismissMessages() {
+
+        self.failure = nil
+        self.notice = nil
+    }
+
+
+    // MARK: WebKit Events
+
+    /// Records WebKit's policy decision for a main-frame navigation that is allowed to start.
+    ///
+    /// WebKit decides before the navigation exists, so the decision is attached to the next navigation
+    /// that starts, or to the current one if it turns out to be a redirect.
+    ///
+    /// - Parameters:
+    ///   - url: The requested address.
+    ///   - isSafeToRepeat: Whether the request is a GET without a body.
+    func didDecide(url: URL?, isSafeToRepeat: Bool) {
+
+        guard self.lifecycle != .closed else { return }
+
+        self.pendingDecision = PolicyDecision(url: url, isSafeToRepeat: isSafeToRepeat)
+    }
+
+
+    /// A main-frame navigation started; it replaces any other as the one whose events count.
+    ///
+    /// - Parameters:
+    ///   - token: The navigation.
+    ///   - url: The address the web view reports for it.
+    func didStartProvisionalNavigation(_ token: NavigationToken, url: URL?) {
+
+        guard self.lifecycle != .closed else { return }
+
+        // The decision belongs to this navigation only if it asked for the same address. Anything
+        // else is ambiguous, and an ambiguous navigation is never retried.
+        let decision = self.pendingDecision
+        self.pendingDecision = nil
+        self.currentNavigation = token
+        self.currentNavigationHasCommitted = false
+        self.currentNavigationDecision = if let decision, decision.url == url {
+            decision
+        } else {
+            PolicyDecision(url: url, isSafeToRepeat: false)
+        }
+        self.lifecycle = .active
+        self.isLoading = true
+        self.failure = nil
+        self.notice = nil
+    }
+
+
+    /// The server redirected the current navigation. A redirect is safe to repeat only if both requests were.
+    func didReceiveRedirect(_ token: NavigationToken, url: URL?) {
+
+        guard token == self.currentNavigation else { return }
+
+        let redirect = self.pendingDecision
+        self.pendingDecision = nil
+        let isSafeToRepeat = (self.currentNavigationDecision?.isSafeToRepeat ?? false)
+            && (redirect?.isSafeToRepeat ?? false) && (redirect?.url == url)
+        self.currentNavigationDecision = PolicyDecision(url: url, isSafeToRepeat: isSafeToRepeat)
+    }
+
+
+    func didCommit(_ token: NavigationToken) {
+
+        guard token == self.currentNavigation else { return }
+
+        self.currentNavigationHasCommitted = true
+    }
+
+
+    func didFinish(_ token: NavigationToken) {
+
+        guard token == self.currentNavigation else { return }
+
+        self.currentNavigation = nil
+        self.currentNavigationDecision = nil
+        self.isLoading = false
+    }
+
+
+    /// The current navigation failed.
+    ///
+    /// Cancellations, including those caused by a newer navigation, Stop or a policy refusal, are not failures.
+    ///
+    /// - Parameters:
+    ///   - token: The navigation.
+    ///   - error: WebKit's error.
+    func didFail(_ token: NavigationToken, error: any Error) {
+
+        guard token == self.currentNavigation else { return }
+
+        let decision = self.currentNavigationDecision
+        let hasCommitted = self.currentNavigationHasCommitted
+        self.currentNavigation = nil
+        self.currentNavigationDecision = nil
+        self.isLoading = false
+
+        guard !Self.isCancellation(error) else { return }
+
+        self.failure = Failure(url: decision?.url, message: error.localizedDescription,
+                               isRetryable: decision?.isSafeToRepeat == true && decision?.url.flatMap(WebPageNavigationPolicy.refusal(for:)) == nil,
+                               keepsPreviousPage: !hasCommitted)
+    }
+
+
+    /// The web view reported its current address, title or history.
+    func didUpdate(url: URL?, title: String?, isLoading: Bool, canGoBack: Bool, canGoForward: Bool) {
+
+        guard self.lifecycle != .closed, self.lifecycle != .restored else { return }
+
+        if let url, url.absoluteString != "about:blank" {
+            self.currentURL = url
+        }
+        self.pageTitle = title.flatMap(Self.sanitizedTitle)
+        self.isLoading = isLoading
+        self.canGoBack = canGoBack
+        self.canGoForward = canGoForward
+    }
+
+
+    /// The process showing the page ended. The page is gone, and nothing reloads by itself.
+    func contentProcessDidTerminate() {
+
+        guard self.lifecycle != .closed else { return }
+
+        self.currentNavigation = nil
+        self.currentNavigationDecision = nil
+        self.pendingDecision = nil
+        self.isLoading = false
+        self.lifecycle = .contentProcessEnded
+    }
+
+
+    func close() {
+
+        self.currentNavigation = nil
+        self.pendingDecision = nil
+        self.isLoading = false
+        self.lifecycle = .closed
+    }
+
+
+    // MARK: Private Methods
+
+    private static func isCancellation(_ error: any Error) -> Bool {
+
+        let error = error as NSError
+
+        return switch (error.domain, error.code) {
+            case (NSURLErrorDomain, NSURLErrorCancelled): true
+            // WebKit's “frame load interrupted by policy change”, reported when a decision cancels a load
+            case ("WebKitErrorDomain", 102): true
+            default: false
+        }
+    }
+}
