+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// The terminal part of a directory's tab archive.
+///
+/// Terminal tabs are entries of kind `terminal` in the versioned `DirectoryTabArchive` list, which keeps
+/// the order of every tab and hands entries of kinds it does not reopen itself to later code. A build
+/// without terminals skips them, so this adds to version 1 without breaking it.
+///
+/// Only what is needed to offer a new session is kept: the tab ID, the user's name for the tab, the
+/// shell, and the starting folder. Output, commands, environment and clipboard contents are never archived.
+struct TerminalTabArchive: Equatable {
+
+    struct Entry: Equatable {
+
+        var id: UUID
+        var customTitle: String?
+        var shellPath: String?
+        var startingDirectory: URL
+    }
+
+
+    static let kind = "terminal"
+
+    var terminals: [Entry]
+
+
+    // MARK: Encoding
+
+    /// The archive form of a terminal tab.
+    @MainActor static func tab(for session: TerminalSession, id: UUID) -> DirectoryTabArchive.Tab {
+
+        self.tab(for: Entry(id: id, customTitle: session.customTitle, shellPath: session.shellPath,
+                            startingDirectory: session.startingDirectory))
+    }
+
+
+    /// The archive form of a terminal entry.
+    static func tab(for entry: Entry) -> DirectoryTabArchive.Tab {
+
+        var fields: [String: Any] = ["path": entry.startingDirectory.path(percentEncoded: false)]
+        fields["title"] = entry.customTitle
+        fields["shell"] = entry.shellPath
+        fields["directory"] = try? entry.startingDirectory.bookmarkData()
+
+        return DirectoryTabArchive.Tab(id: entry.id, kind: Self.kind, fields: fields)
+    }
+
+
+    // MARK: Decoding
+
+    /// Reads the terminal entries of an archive.
+    ///
+    /// Archived values are untrusted: titles are sanitized, shells must be absolute paths (they are
+    /// validated again at launch), and a starting folder that no longer resolves keeps its saved path
+    /// so that the tab can offer to choose another. The directory archive has already dropped entries
+    /// without a valid and unique ID.
+    ///
+    /// - Parameters:
+    ///   - archive: The decoded directory archive.
+    ///   - resolveBookmark: Resolves a folder bookmark, or returns `nil`.
+    init(archive: DirectoryTabArchive, resolveBookmark: (Data) -> URL? = Self.resolveBookmark) {
+
+        self.init(entries: archive.foreignEntries(ofKind: Self.kind), resolveBookmark: resolveBookmark)
+    }
+
+
+    /// Reads archived terminal entries, as `init(archive:resolveBookmark:)` does.
+    ///
+    /// - Parameters:
+    ///   - entries: The directory archive's entries of kind `terminal`.
+    ///   - resolveBookmark: Resolves a folder bookmark, or returns `nil`.
+    init(entries: [DirectoryTabArchive.ForeignEntry], resolveBookmark: (Data) -> URL? = Self.resolveBookmark) {
+
+        self.terminals = entries.filter { $0.kind == Self.kind }.compactMap { entry in
+            let fields = entry.fields
+            let savedPath = (fields["path"] as? String).flatMap { $0.hasPrefix("/") ? $0 : nil }
+            guard let directory = (fields["directory"] as? Data).flatMap(resolveBookmark)
+                    ?? savedPath.map({ URL(filePath: $0, directoryHint: .isDirectory) })
+            else { return nil }
+
+            return Entry(id: entry.id,
+                         customTitle: (fields["title"] as? String).flatMap(TerminalSession.sanitizedTitle),
+                         shellPath: (fields["shell"] as? String).flatMap { $0.hasPrefix("/") ? $0 : nil },
+                         startingDirectory: directory)
+        }
+    }
+
+
+    /// Resolves a folder bookmark.
+    ///
+    /// An app with terminals is not sandboxed, so a plain bookmark suffices: it follows a renamed or moved folder.
+    static func resolveBookmark(_ data: Data) -> URL? {
+
+        var isStale = false
+        guard
+            let url = try? URL(resolvingBookmarkData: data, options: [.withoutUI, .withoutMounting], bookmarkDataIsStale: &isStale),
+            url.isFileURL
+        else { return nil }
+
+        return url
+    }
+}
