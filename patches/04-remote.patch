+import Foundation
+
+
+/// The host aliases in the user's SSH configuration, to choose from instead of typing them.
+///
+/// Only the names are read, from the `Host` lines of `~/.ssh/config` and the files it includes. What an
+/// alias connects to is left to `ssh -G`, which applies the whole configuration as `ssh` does; this
+/// reader never decides a user, port or address itself.
+enum RemoteSSHConfigHosts {
+
+    /// The most files and the most bytes per file read, so that a strange configuration cannot stall the sheet.
+    private static let maximumFiles = 32
+    private static let maximumFileSize = 1 << 20
+
+
+    /// The aliases in the user's SSH configuration, in the order they appear.
+    static var userAliases: [String] {
+
+        let folder = FileManager.default.homeDirectoryForCurrentUser.appending(path: ".ssh", directoryHint: .isDirectory)
+
+        return self.aliases(inConfigurationAt: folder.appending(path: "config"), sshFolder: folder)
+    }
+
+
+    /// The aliases a configuration file names, following its `Include` lines.
+    ///
+    /// Patterns (with `*`, `?` or `!`) are left out, since they name no one host, as are names that could
+    /// not be passed to `ssh` as a host.
+    ///
+    /// - Parameters:
+    ///   - url: The configuration file.
+    ///   - sshFolder: The folder relative `Include` paths start from, as for `ssh`.
+    static func aliases(inConfigurationAt url: URL, sshFolder: URL) -> [String] {
+
+        var aliases: [String] = []
+        var visited: Set<String> = []
+        self.collect(from: url, sshFolder: sshFolder, into: &aliases, visited: &visited)
+
+        return aliases
+    }
+
+
+    // MARK: Private Methods
+
+    private static func collect(from url: URL, sshFolder: URL, into aliases: inout [String], visited: inout Set<String>) {
+
+        let path = url.resolvingSymlinksInPath().path(percentEncoded: false)
+        guard visited.count < self.maximumFiles, visited.insert(path).inserted else { return }
+        guard
+            let size = (try? FileManager.default.attributesOfItem(atPath: path))?[.size] as? Int, size <= self.maximumFileSize,
+            let data = FileManager.default.contents(atPath: path),
+            let text = String(data: data, encoding: .utf8)
+        else { return }
+
+        for line in text.split(whereSeparator: \.isNewline) {
+            let words = self.words(of: line)
+            guard let keyword = words.first?.lowercased() else { continue }
+
+            switch keyword {
+                case "host":
+                    for name in words.dropFirst() where self.isAlias(name) && !aliases.contains(name) {
+                        aliases.append(name)
+                    }
+                case "include":
+                    for pattern in words.dropFirst() {
+                        for included in self.expand(pattern, sshFolder: sshFolder) {
+                            self.collect(from: included, sshFolder: sshFolder, into: &aliases, visited: &visited)
+                        }
+                    }
+                default:
+                    continue
+            }
+        }
+    }
+
+
+    /// The words of a configuration line: the keyword, which may be followed by `=`, then its arguments, which may be quoted.
+    private static func words(of line: Substring) -> [String] {
+
+        var words: [String] = []
+        var word = ""
+        var isQuoted = false
+        for character in line.trimmingCharacters(in: .whitespaces) {
+            switch character {
+                case "#" where !isQuoted && word.isEmpty:
+                    return words
+                case "\"":
+                    isQuoted.toggle()
+                // "=" separates only the keyword from its arguments.
+                case " " where !isQuoted, "\t" where !isQuoted, "=" where !isQuoted && words.isEmpty:
+                    if !word.isEmpty {
+                        words.append(word)
+                        word = ""
+                    }
+                default:
+                    word.append(character)
+            }
+        }
+        if !word.isEmpty {
+            words.append(word)
+        }
+
+        return words
+    }
+
+
+    private static func isAlias(_ name: String) -> Bool {
+
+        !name.contains(where: { "*?!".contains($0) }) && RemoteEndpoint.isValidName(name) && !name.contains("@") && !name.contains("/")
+    }
+
+
+    /// The files an `Include` argument names, sorted, as `ssh` reads them.
+    private static func expand(_ pattern: String, sshFolder: URL) -> [URL] {
+
+        let expanded: String = if pattern.hasPrefix("~/") {
+            FileManager.default.homeDirectoryForCurrentUser.path(percentEncoded: false) + "/" + pattern.dropFirst(2)
+        } else if pattern.hasPrefix("/") {
+            pattern
+        } else {
+            sshFolder.appending(path: pattern).path(percentEncoded: false)
+        }
+
+        var result = glob_t()
+        defer { globfree(&result) }
+        guard glob(expanded, 0, nil, &result) == 0 else { return [] }
+
+        return (0..<Int(result.gl_pathc))
+            .compactMap { result.gl_pathv[$0].map { String(cString: $0) } }
+            .sorted()
+            .map { URL(filePath: $0, directoryHint: .notDirectory) }
+    }
+}
