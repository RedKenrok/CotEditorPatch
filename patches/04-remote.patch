+/// A row of the remote sidebar.
+private final class RemoteFileCellView: NSTableCellView {
+
+    static let identifier = NSUserInterfaceItemIdentifier("RemoteFileCell")
+
+    private let iconView = NSImageView()
+    private let nameField = NSTextField(labelWithString: "")
+    private let progressIndicator = NSProgressIndicator()
+    private let button = NSButton()
+
+
+    init() {
+
+        super.init(frame: .zero)
+
+        self.identifier = Self.identifier
+        self.imageView = self.iconView
+        self.textField = self.nameField
+
+        self.nameField.lineBreakMode = .byTruncatingMiddle
+        self.nameField.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+        self.progressIndicator.style = .spinning
+        self.progressIndicator.controlSize = .small
+        self.progressIndicator.isDisplayedWhenStopped = false
+        self.button.bezelStyle = .inline
+        self.button.controlSize = .small
+        self.button.isHidden = true
+
+        let stack = NSStackView(views: [self.iconView, self.nameField, self.progressIndicator, self.button])
+        stack.spacing = 4
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        self.addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.leadingAnchor.constraint(equalTo: self.leadingAnchor),
+            stack.trailingAnchor.constraint(lessThanOrEqualTo: self.trailingAnchor),
+            stack.centerYAnchor.constraint(equalTo: self.centerYAnchor),
+            self.iconView.widthAnchor.constraint(equalToConstant: 16),
+            self.iconView.heightAnchor.constraint(equalToConstant: 16),
+        ])
+    }
+
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+
+        fatalError("init(coder:) has not been implemented")
+    }
+
+
+    /// Makes the name editable until the editing ends, which the delegate is told of.
+    func beginEditingName(_ name: String, delegate: any NSTextFieldDelegate) {
+
+        // The name is edited as plain text, without the highlight of a filter match.
+        self.nameField.stringValue = name
+        self.nameField.textColor = .labelColor
+        self.nameField.isEditable = true
+        self.nameField.delegate = delegate
+    }
+
+
+    @MainActor func configure(node: RemoteDirectoryNode, isOpening: Bool, isFiltering: Bool, matchedRange: NSRange?) {
+
+        self.nameField.isEditable = false
+        self.iconView.image = Self.icon(for: node)
+        self.iconView.contentTintColor = nil
+        self.iconView.alphaValue = node.isHidden ? 0.5 : 1
+        self.nameField.font = .systemFont(ofSize: NSFont.systemFontSize)
+        self.nameField.stringValue = node.name
+        // As in the local file browser: hidden names dimmed, and while filtering, the matches bold on dimmed names.
+        self.nameField.textColor = if node.isHidden {
+            .tertiaryLabelColor
+        } else if isFiltering || node.isStale {
+            .secondaryLabelColor
+        } else {
+            .labelColor
+        }
+        if let matchedRange {
+            let paragraphStyle = NSMutableParagraphStyle()
+            paragraphStyle.lineBreakMode = .byTruncatingMiddle
+            let name = NSMutableAttributedString(string: node.name, attributes: [.paragraphStyle: paragraphStyle,
+                                                                                 .font: NSFont.systemFont(ofSize: NSFont.systemFontSize)])
+            name.addAttribute(.foregroundColor, value: NSColor.labelColor, range: matchedRange)
+            name.applyFontTraits(.boldFontMask, range: matchedRange)
+            self.nameField.attributedStringValue = name
+        }
+        self.button.isHidden = true
+
+        if isOpening || node.isLoading || node.resolution == .resolving {
+            self.progressIndicator.startAnimation(nil)
+        } else {
+            self.progressIndicator.stopAnimation(nil)
+        }
+
+        self.setAccessibilityLabel(Self.accessibilityLabel(for: node, isOpening: isOpening))
+    }
+
+
+    @MainActor func configure(status: RemoteFileBrowserViewController.StatusItem, target: AnyObject, retryAction: Selector) {
+
+        let node = status.node
+        self.iconView.image = nil
+        self.iconView.alphaValue = 1
+        self.nameField.textColor = .secondaryLabelColor
+        self.nameField.font = .systemFont(ofSize: NSFont.smallSystemFontSize)
+        self.progressIndicator.stopAnimation(nil)
+        self.button.isHidden = true
+
+        switch status.kind {
+            case .loading:
+                self.nameField.stringValue = String(localized: "RemoteFolder.loading", defaultValue: "Loading…", table: "Remote")
+                self.progressIndicator.startAnimation(nil)
+            case .problem:
+                self.iconView.image = NSImage(systemSymbolName: "exclamationmark.triangle", accessibilityDescription: nil)
+                self.iconView.contentTintColor = .systemOrange
+                self.nameField.stringValue = Self.problemMessage(for: node)
+                self.button.title = (node.problem == .offline)
+                    ? String(localized: "RemoteFolder.reconnect", defaultValue: "Reconnect", table: "Remote", comment: "button label")
+                    : String(localized: "RemoteFolder.retry", defaultValue: "Retry", table: "Remote", comment: "button label")
+                self.button.isHidden = (node.problem == .windowLimit || node.problem == .tooDeep || node.isLoopOrOutside)
+                self.button.target = target
+                self.button.action = retryAction
+            case .incomplete:
+                self.nameField.stringValue = Self.limitMessage(for: node.limit)
+            case .omitted:
+                self.nameField.stringValue = String(localized: "RemoteFolder.status.omitted", defaultValue: "\(node.omittedCount) items can’t be shown",
+                                                    table: "Remote", comment: "%lld is a number of folder entries whose names are not usable")
+            case .empty:
+                self.nameField.stringValue = String(localized: "RemoteFolder.status.empty", defaultValue: "Empty folder", table: "Remote")
+        }
+        self.setAccessibilityLabel(self.nameField.stringValue)
+    }
+
+
+    @MainActor private static func icon(for node: RemoteDirectoryNode) -> NSImage? {
+
+        let symbolName = switch (node.kind, node.resolution) {
+            case (.directory, _), (_, .directory): "folder"
+            case (_, .loop), (_, .outsideRoot): "folder.badge.questionmark"
+            case (.symbolicLink, _): "arrow.up.right.square"
+            case (.other, _), (_, .other): "questionmark.square.dashed"
+            case (.unknown, .unresolved), (.unknown, .resolving), (.unknown, .failed): "questionmark.folder"
+            default: "doc"
+        }
+
+        return NSImage(systemSymbolName: symbolName, accessibilityDescription: nil)
+    }
+
+
+    @MainActor private static func accessibilityLabel(for node: RemoteDirectoryNode, isOpening: Bool) -> String {
+
+        let kind = switch (node.kind, node.resolution) {
+            case (.directory, _), (_, .directory):
+                String(localized: "RemoteFolder.kind.folder", defaultValue: "folder", table: "Remote")
+            case (.symbolicLink, _):
+                String(localized: "RemoteFolder.kind.link", defaultValue: "link", table: "Remote")
+            case (.other, _), (_, .other):
+                String(localized: "RemoteFolder.kind.special", defaultValue: "special file", table: "Remote")
+            case (.unknown, .unresolved), (.unknown, .failed):
+                String(localized: "RemoteFolder.kind.unknown", defaultValue: "unknown type", table: "Remote")
+            default:
+                String(localized: "RemoteFolder.kind.file", defaultValue: "file", table: "Remote")
+        }
+        var parts = [node.name, kind]
+        if node.isLoading || isOpening {
+            parts.append(String(localized: "RemoteFolder.loading", defaultValue: "Loading…", table: "Remote"))
+        }
+        if node.problem != nil {
+            parts.append(Self.problemMessage(for: node))
+        }
+        if node.isStale {
+            parts.append(String(localized: "RemoteFolder.state.stale", defaultValue: "not refreshed", table: "Remote"))
+        }
+
+        return parts.joined(separator: ", ")
+    }
+
+
+    @MainActor private static func problemMessage(for node: RemoteDirectoryNode) -> String {
+
+        switch node.problem {
+            case .failed(let message):
+                return message
+            case .offline:
+                return String(localized: "RemoteFolder.status.offlineFolder", defaultValue: "Not listed while offline", table: "Remote")
+            case .windowLimit:
+                return String(localized: "RemoteFolder.status.windowLimit", defaultValue: "The window holds as many items as it can. Collapse other folders to list this one.",
+                              table: "Remote")
+            case .tooDeep:
+                return String(localized: "RemoteFolder.status.tooDeep", defaultValue: "This folder is too deep below the root to list.", table: "Remote")
+            case nil:
+                break
+        }
+
+        switch node.resolution {
+            case .failed(let message):
+                return message
+            case .loop:
+                return String(localized: "RemoteFolder.status.loop", defaultValue: "This link leads to a folder that contains it.", table: "Remote")
+            case .outsideRoot(let target):
+                return String(localized: "RemoteFolder.status.outsideRoot", defaultValue: "This link leads outside the folder, to \(target).", table: "Remote",
+                              comment: "%@ is a path on the server")
+            default:
+                return ""
+        }
+    }
+
+
+    private static func limitMessage(for limit: RemoteListingLimit?) -> String {
+
+        switch limit {
+            case .entries(let count):
+                String(localized: "RemoteFolder.status.incompleteEntries", defaultValue: "Listing incomplete: only the first \(count) items are read.",
+                       table: "Remote", comment: "%lld is the most entries a listing reads")
+            case .nameBytes(let count):
+                String(localized: "RemoteFolder.status.incompleteNames",
+                       defaultValue: "Listing incomplete: the names take more than \(count.formatted(.byteCount(style: .file))).", table: "Remote",
+                       comment: "%@ is a size such as 8 MB")
+            case nil:
+                ""
+        }
+    }
+}
