+import Network
+
+/// A small HTTP/1.1 server on a loopback address for webpage tests, which counts every request.
+///
+/// It serves canned responses per path, never listens beyond the loopback interface, and closes each
+/// connection after one response, so that every request WebKit makes arrives as a request of its own.
+final class WebPageTestServer: @unchecked Sendable {
+
+    enum Response: Sendable {
+
+        case page(String, headers: [String: String] = [:])
+        case redirect(String)
+        case status(Int)
+        /// Closes the connection without answering, which WebKit reports as a failed load.
+        case drop
+    }
+
+
+    struct Request: Sendable, Equatable {
+
+        var method: String
+        var path: String
+    }
+
+
+    private let listener: NWListener
+    private let queue = DispatchQueue(label: "WebPageTestServer")
+    private let lock = NSLock()
+    private var routes: [String: Response] = [:]
+    private var requests: [Request] = []
+
+    private(set) var port: UInt16 = 0
+
+
+    /// The loopback address the server listens on.
+    let host: String
+
+
+    /// Makes a server on a loopback address, `127.0.0.1` or `::1`.
+    init(host: String = "127.0.0.1") throws {
+
+        self.host = host
+        let parameters = NWParameters.tcp
+        parameters.requiredLocalEndpoint = .hostPort(host: NWEndpoint.Host(host), port: .any)
+        parameters.allowLocalEndpointReuse = true
+        self.listener = try NWListener(using: parameters)
+    }
+
+
+    /// Starts listening on a free port of `127.0.0.1`.
+    func start() async throws {
+
+        let listener = self.listener
+        let queue = self.queue
+        self.port = try await withCheckedThrowingContinuation { continuation in
+            let once = NSLock()
+            nonisolated(unsafe) var resumed = false
+            listener.stateUpdateHandler = { state in
+                once.lock()
+                defer { once.unlock() }
+                guard !resumed else { return }
+                switch state {
+                    case .ready:
+                        resumed = true
+                        continuation.resume(returning: listener.port?.rawValue ?? 0)
+                    case .failed(let error):
+                        resumed = true
+                        continuation.resume(throwing: error)
+                    default:
+                        break
+                }
+            }
+            listener.newConnectionHandler = { [weak self] connection in
+                self?.handle(connection)
+            }
+            listener.start(queue: queue)
+        }
+    }
+
+
+    deinit {
+        self.listener.cancel()
+    }
+
+
+    func stop() {
+
+        self.listener.cancel()
+    }
+
+
+    /// The address of a path on the server, such as `http://127.0.0.1:port/path`.
+    func url(_ path: String) -> URL {
+
+        let host = self.host.contains(":") ? "[\(self.host)]" : self.host
+
+        return URL(string: "http://\(host):\(self.port)\(path)")!
+    }
+
+
+    func route(_ path: String, _ response: Response) {
+
+        self.lock.withLock { self.routes[path] = response }
+    }
+
+
+    /// How many requests reached the path, optionally only those with the method.
+    func count(_ path: String, method: String? = nil) -> Int {
+
+        self.lock.withLock { self.requests.count { $0.path == path && (method == nil || $0.method == method) } }
+    }
+
+
+    // MARK: Private Methods
+
+    private func handle(_ connection: NWConnection) {
+
+        connection.start(queue: self.queue)
+        self.receive(on: connection, buffer: Data())
+    }
+
+
+    private func receive(on connection: NWConnection, buffer: Data) {
+
+        connection.receive(minimumIncompleteLength: 1, maximumLength: 65536) { [weak self] data, _, isComplete, error in
+            guard let self else { return connection.cancel() }
+
+            var buffer = buffer
+            if let data { buffer.append(data) }
+
+            guard let headerEnd = buffer.range(of: Data("\r\n\r\n".utf8)) else {
+                if isComplete || error != nil { connection.cancel() } else { self.receive(on: connection, buffer: buffer) }
+                return
+            }
+
+            let head = String(decoding: buffer[..<headerEnd.lowerBound], as: UTF8.self)
+            let lines = head.components(separatedBy: "\r\n")
+            let requestLine = lines.first?.split(separator: " ") ?? []
+            let contentLength = lines.dropFirst()
+                .first { $0.lowercased().hasPrefix("content-length:") }
+                .flatMap { Int($0.split(separator: ":", maxSplits: 1)[1].trimmingCharacters(in: .whitespaces)) } ?? 0
+            guard buffer.count - headerEnd.upperBound >= contentLength else {
+                return self.receive(on: connection, buffer: buffer)
+            }
+
+            let method = requestLine.first.map(String.init) ?? ""
+            let target = requestLine.dropFirst().first.map(String.init) ?? "/"
+            let path = String(target.split(separator: "?", maxSplits: 1).first ?? "/")
+
+            let response: Response? = self.lock.withLock {
+                self.requests.append(Request(method: method, path: path))
+                return self.routes[path]
+            }
+            self.respond(response ?? .status(404), on: connection)
+        }
+    }
+
+
+    private func respond(_ response: Response, on connection: NWConnection) {
+
+        let status: String
+        var headers: [String: String] = ["Connection": "close", "Cache-Control": "no-store"]
+        var body = ""
+        switch response {
+            case .page(let html, let extra):
+                status = "200 OK"
+                headers["Content-Type"] = "text/html; charset=utf-8"
+                headers.merge(extra) { $1 }
+                body = html
+            case .redirect(let location):
+                status = "302 Found"
+                headers["Location"] = location
+            case .status(let code):
+                status = "\(code) Status"
+            case .drop:
+                return connection.cancel()
+        }
+        headers["Content-Length"] = String(body.utf8.count)
+
+        let head = "HTTP/1.1 \(status)\r\n" + headers.map { "\($0): \($1)\r\n" }.joined() + "\r\n"
+        connection.send(content: Data((head + body).utf8), completion: .contentProcessed { _ in connection.cancel() })
+    }
+}
