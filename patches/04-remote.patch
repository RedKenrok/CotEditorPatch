+
+
+    // MARK: Actions
+
+    @objc private func outlineViewClicked(_ sender: Any?) {
+
+        guard let node = self.clickedNode else { return }
+
+        // A click opens a file; folders open with their disclosure triangle or a double click.
+        if !node.mayBeFolder || node.kind == .symbolicLink {
+            self.session.activate(node)
+        }
+    }
+
+
+    @objc private func outlineViewDoubleClicked(_ sender: Any?) {
+
+        let row = self.outlineView.clickedRow
+        guard row >= 0 else { return }
+
+        switch self.outlineView.item(atRow: row) {
+            case let node as RemoteDirectoryNode where node.isFolder:
+                if self.outlineView.isItemExpanded(node) {
+                    self.outlineView.collapseItem(node)
+                } else {
+                    self.outlineView.expandItem(node)
+                }
+            case let node as RemoteDirectoryNode:
+                self.session.activate(node)
+            case let status as StatusItem:
+                self.retry(status)
+            default:
+                break
+        }
+    }
+
+
+    @objc private func openClicked(_ sender: Any?) {
