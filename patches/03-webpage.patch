+import AppKit
+import WebKit
+import Defaults
+
+
+/// Webpage tabs in a directory window.
+///
+/// Webpages are tabs that are not files (see `DirectoryTabItem`). Closing one never asks: WebKit offers
+/// no public way to let a page object to its tab closing, so they add a teardown but no approval to the
+/// window's close handling, and a page's `beforeunload` handler does not run when its tab, window or
+/// the app closes.
+extension DirectoryDocument {
+
+    var webPageSessions: [WebPageSession] {
+
+        self.tabItems.compactMap { $0 as? WebPageSession }
+    }
+
+
+    var activeWebPageSession: WebPageSession? {
+
+        self.activeTabItem as? WebPageSession
+    }
+
+
+    /// Opens a webpage tab, first offering to turn file tabs on if they are off.
+    func requestWebPageTab() async {
+
+        guard !self.isClosed else { return }
+
+        if !UserDefaults.standard[.usesDirectoryFileTabs] {
+            guard await WebPagePrompts.current.confirmEnablingTabs(window: self.windowForSheet) else { return }
+            guard !self.isClosed else { return }
+            // Reuses the file-tab transition: the preference observer reconciles every directory window.
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+        }
+
+        self.openWebPageTab()
+    }
+
+
+    /// Opens and selects an empty webpage tab, with the keyboard focus in its address field.
+    ///
+    /// - Returns: The new session, or `nil` if the window cannot have webpage tabs now.
+    @discardableResult func openWebPageTab() -> WebPageSession? {
+
+        let session = WebPageSession()
+        guard self.openTabItem(session) else { return nil }
+        self.windowContentViewController?.focusActiveTab()
+
+        return session
+    }
+
+
+    /// Removes every website's cookies and stored data after asking, for every tab in every window.
+    func clearWebsiteData() async {
+
+        guard await WebPagePrompts.current.confirmClearingWebsiteData(window: self.windowForSheet) else { return }
+
+        let store = WKWebsiteDataStore.default()
+        await store.removeData(ofTypes: WKWebsiteDataStore.allWebsiteDataTypes(), modifiedSince: .distantPast)
+    }
+}
+
+
+// MARK: - Tab Contract
+
+extension WebPageSession: DirectoryTabItem {
+
+    var tabKind: String  { WebPageTabArchive.kind }
+
+    var tabTitle: String  { self.title }
+
+    var tabIcon: NSImage?  { NSImage(systemSymbolName: "globe", accessibilityDescription: nil) }
+
+    var tabToolTip: String  { self.address?.absoluteString ?? Self.defaultTitle }
+
+    var tabAccessibilityLabel: String {
+
+        String(localized: "WebPageTab.accessibilityLabel", defaultValue: "Webpage: \(self.title)", table: "WebPages",
+               comment: "accessibility label of a webpage tab's content (%@ is the page title)")
+    }
+
+
+    func makeTabViewController(in directory: DirectoryDocument) -> any DirectoryTabViewController {
+
+        let controller = WebPageViewController(session: self, directoryDocument: directory)
+        self.controller = controller
+        return controller
+    }
+
+
+    func directoryWillShowReview() {
+
+        self.controller?.dialogPresenter.dismiss()
+    }
+
+
+    func tearDown() {
+
+        self.controller?.tearDown()
+        self.close()
+    }
+
+
+    func archivedFields() -> [String: Any]? {
+
+        WebPageTabArchive.fields(for: .init(id: self.id, url: self.address, title: self.pageTitle))
+    }
+
+
+    func tabContextMenuItems(in directory: DirectoryDocument) -> [DirectoryTabBar.MenuItem] {
+
+        [
+            .init(title: String(localized: "WebPageMenu.clearWebsiteData", defaultValue: "Clear Website Data…", table: "WebPages",
+                                comment: "context menu item of a webpage tab"),
+                  systemImage: "trash") { [weak directory] in
+                Task { await directory?.clearWebsiteData() }
+            },
+        ]
+    }
+}
+
+
+extension DirectoryTabKind {
+
+    /// Webpage tabs.
+    ///
+    /// Restored webpages are placeholders that show their address; nothing is loaded until the user
+    /// asks, so restoring a folder window contacts no website.
+    static let webPage = DirectoryTabKind(
+        archiveKind: WebPageTabArchive.kind,
+        restore: { entries, _ in
+            WebPageTabArchive(entries: entries).webPages.map { entry in
+                WebPageSession(id: entry.id, restoring: entry.url, title: entry.title)
+            }
+        },
+        addMenuItems: { [$0.newWebPageMenuItem] })
+}
+
+
+// MARK: - Main Menu
+
+@MainActor enum WebPageMenu {
+
+    /// Adds New Webpage Tab to the File menu, after New Shell Tab or else after New Tab.
+    ///
+    /// Like New Shell Tab, it has no default shortcut; users can assign one in the Shortcuts settings.
+    static func install(in mainMenu: NSMenu) {
+
+        guard
+            let fileMenu = mainMenu.items.lazy.compactMap(\.submenu)
+                .first(where: { $0.items.contains { $0.action == #selector(NSWindow.performClose(_:)) } })
+        else { return assertionFailure() }
+
+        let anchor = fileMenu.items.firstIndex { $0.action == #selector(DirectoryDocument.newTerminalTab(_:)) }
+            ?? fileMenu.items.firstIndex { $0.action == Selector(("newDocumentAsTab:")) }
+        guard let anchor else { return }
+
+        let item = NSMenuItem(title: String(localized: "WebPageMenu.newWebPageTab", defaultValue: "New Webpage Tab", table: "WebPages",
+                                            comment: "File menu item opening a webpage tab in the folder window"),
+                              action: #selector(DirectoryDocument.newWebPageTab(_:)), keyEquivalent: "")
+        item.image = NSImage(systemSymbolName: "globe", accessibilityDescription: nil)
+        fileMenu.insertItem(item, at: anchor + 1)
+    }
+}
+
+
+extension DirectoryDocument {
+
+    @IBAction func newWebPageTab(_ sender: Any?) {
+
+        Task {
+            await self.requestWebPageTab()
+        }
+    }
+
+
+    /// Validates the webpage commands.
+    ///
+    /// - Returns: The validation result, or `nil` for other commands.
+    func validateWebPageItem(_ item: any NSValidatedUserInterfaceItem) -> Bool? {
+
+        switch item.action {
+            case #selector(newWebPageTab(_:)):
+                !self.isClosed
+            default:
+                nil
+        }
+    }
+
+
+    /// The entry of the tab strip's “+” menu that opens a webpage tab.
+    var newWebPageMenuItem: DirectoryTabBar.MenuItem {
+
+        .init(title: String(localized: "WebPageMenu.newWebPage", defaultValue: "New Webpage", table: "WebPages",
+                            comment: "menu item in the tab strip’s add menu"),
+              systemImage: "globe") { [weak self] in
+            Task { await self?.requestWebPageTab() }
+        }
+    }
+}
