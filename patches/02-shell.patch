+import AppKit
+import Defaults
+
+
+/// Terminal tabs in a directory window.
+///
+/// Terminals are tabs that are not files (see `DirectoryTabItem`): they share the file tabs' order,
+/// selection, strip and close paths, but never appear in the document registry, never mark the window
+/// as edited, and leave `activeFileDocument` nil while selected.
+extension DirectoryDocument {
+
+    // MARK: Public Properties
+
+    var terminalSessions: [TerminalSession] {
+
+        self.tabItems.compactMap { $0 as? TerminalSession }
+    }
+
+
+    /// The terminal the window shows, if a terminal tab is selected.
+    var activeTerminalSession: TerminalSession? {
+
+        self.activeTabItem as? TerminalSession
+    }
+
+
+    // MARK: Opening
+
+    /// Opens a terminal tab on this Mac, first offering to turn file tabs on if they are off.
+    ///
+    /// - Parameter directory: The folder to start in, or `nil` for the directory itself
+    ///   (see `localTerminalDirectory`).
+    func requestTerminalTab(in directory: URL? = nil) async {
+
+        guard await self.prepareTabsForTerminal() else { return }
+
+        self.openTerminalTab(in: directory)
+    }
+
+
+    /// Opens a terminal tab where the window's root runs its terminals, such as on a server,
+    /// first offering to turn file tabs on if they are off.
+    ///
+    /// If the root cannot start one, the error is shown and no tab opens: a shell on this Mac in its
+    /// place could be mistaken for the one the user asked for.
+    func requestRootTerminalTab() async {
+
+        guard
+            let provider = self.root as? any TerminalLaunchProviding,
+            await self.prepareTabsForTerminal()
+        else { return }
+
+        do {
+            let launcher = try await provider.makeTerminalLauncher(for: self)
+            guard !self.isClosed else { return }
+            self.openTerminalTab(launcher: launcher)
+        } catch {
+            self.presentErrorAsSheet(error)
+        }
+    }
+
+
+    /// Opens, selects and starts a terminal tab whose processes a launcher starts.
+    ///
+    /// - Returns: The new session, or `nil` if the window cannot have terminal tabs now.
+    @discardableResult func openTerminalTab(launcher: TerminalLauncher) -> TerminalSession? {
+
+        guard !self.isClosed, UserDefaults.standard[.usesDirectoryFileTabs] else { return nil }
+
+        let session = TerminalSession(defaultTitle: self.nextTerminalTitle(), startingDirectory: FileManager.default.homeDirectoryForCurrentUser,
+                                      launcher: launcher)
+        guard self.openTabItem(session) else { return nil }
+        session.start()
+        self.windowContentViewController?.focusActiveTab()
+
+        return session
+    }
+
+
+    /// Opens, selects and starts a terminal tab on this Mac.
+    ///
+    /// - Parameter directory: The folder to start in, or `nil` for the directory itself
+    ///   (see `localTerminalDirectory`).
+    /// - Returns: The new session, or `nil` if the window cannot have terminal tabs now.
+    @discardableResult func openTerminalTab(in directory: URL? = nil) -> TerminalSession? {
+
+        guard !self.isClosed, UserDefaults.standard[.usesDirectoryFileTabs] else { return nil }
+
+        let session = TerminalSession(defaultTitle: self.nextTerminalTitle(), startingDirectory: directory ?? self.localTerminalDirectory)
+        guard self.openTabItem(session) else { return nil }
+        session.start()
+        self.windowContentViewController?.focusActiveTab()
+
+        return session
+    }
+
+
+    // MARK: Selection
+
+    func selectTerminal(_ session: TerminalSession) {
+
+        self.selectTabItem(session)
+    }
+
+
+    // MARK: Closing
+
+    /// Closes a terminal tab, asking first if it is running.
+    ///
+    /// - Parameter session: The terminal to close.
+    /// - Returns: `true` if the tab closed.
+    @discardableResult func closeTerminal(_ session: TerminalSession) async -> Bool {
+
+        await self.closeTabItem(session)
+    }
+
+
+    /// Asks once for all running terminals of the window, without stopping anything.
+    ///
+    /// - Parameter reason: What the user is doing.
+    /// - Returns: `true` if there is nothing running or the user agreed to stop it.
+    func confirmClosingLiveTerminals(reason: TerminalCloseRequest.Scope) async -> Bool {
+
+        let liveCount = self.terminalSessions.count(where: \.isLive)
+
+        guard liveCount > 0 else { return true }
+
+        return await TerminalPrompts.current.confirmClosing(.many(scope: reason, liveCount: liveCount), window: self.windowForSheet)
+    }
+
+
+    /// Removes every terminal tab without asking, stopping the processes.
+    ///
+    /// For callers that already have the user's approval, or that must end terminals anyway.
+    func closeAllTerminals() {
+
+        for session in self.terminalSessions {
+            self.removeTabItem(session)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    /// Makes sure the window shows tabs, offering to turn file tabs on if they are off.
+    ///
+    /// - Returns: `true` if a terminal tab can open now.
+    private func prepareTabsForTerminal() async -> Bool {
+
+        guard !self.isClosed else { return false }
+
+        if !UserDefaults.standard[.usesDirectoryFileTabs] {
+            guard await TerminalPrompts.current.confirmEnablingTabs(window: self.windowForSheet) else { return false }
+            guard !self.isClosed else { return false }
+            // Reuses the file-tab transition: the preference observer reconciles every directory window.
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+        }
+
+        return true
+    }
+
+
+    /// The first of “Terminal”, “Terminal 2”, “Terminal 3”… not used by another tab in the window.
+    ///
+    /// - Parameter others: Sessions that are about to join the window and whose titles are taken too.
+    fileprivate func nextTerminalTitle(besides others: [TerminalSession] = []) -> String {
+
+        let used = Set((self.terminalSessions + others).map(\.defaultTitle))
+
+        return (1...).lazy
+            .map { number in
+                number == 1
+                    ? String(localized: "TerminalSession.defaultTitle", defaultValue: "Shell", table: "Terminal",
+                             comment: "default name of the first terminal tab in a window")
+                    : String(localized: "TerminalSession.numberedTitle", defaultValue: "Shell \(number)", table: "Terminal",
+                             comment: "default name of further terminal tabs in a window (%lld is a number starting at 2)")
+            }
+            .first { !used.contains($0) }!
+    }
+}
