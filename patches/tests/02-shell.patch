+    @Test(.timeLimit(.minutes(1))) func controlKeysReachTheShellBeforeMenuShortcuts() async throws {
+        
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        var didExit = false
+        engine.onExit = { _ in didExit = true }
+        let window = Self.makeWindow(showing: engine)
+        defer { window.close() }
+        
+        // A menu item bound to ⌃C, as a user could configure in the Shortcuts settings.
+        let probe = MenuProbe()
+        let item = NSMenuItem(title: "Probe", action: #selector(MenuProbe.fire(_:)), keyEquivalent: "c")
+        item.keyEquivalentModifierMask = .control
+        item.target = probe
+        let menu = try #require(NSApp.mainMenu?.items.first?.submenu)
+        menu.addItem(item)
+        defer { menu.removeItem(item) }
+        
+        try engine.start(self.shell("stty raw -echo; echo READY; head -c 1 | od -An -tx1; stty sane", in: FileManager.default.temporaryDirectory))
+        try await self.wait { engine.bufferText.contains("READY") }
+        #expect(window.makeFirstResponder(engine.focusView))
+        
+        let controlC = try #require(NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: .control, timestamp: 0,
+                                                     windowNumber: window.windowNumber, context: nil,
+                                                     characters: "\u{3}", charactersIgnoringModifiers: "c", isARepeat: false, keyCode: 8))
+        #expect(NSApp.mainMenu?.performKeyEquivalent(with: controlC) == true, "the menu item would take ⌃C")
+        #expect(probe.count == 1)
+        
+        #expect(window.performKeyEquivalent(with: controlC), "the focused terminal claims ⌃C first")
+        try await self.wait { didExit && engine.bufferText.contains("03") }
+        #expect(probe.count == 1, "the menu item was not triggered by the terminal")
+        
+        let commandK = try #require(NSEvent.keyEvent(with: .keyDown, location: .zero, modifierFlags: .command, timestamp: 0,
+                                                     windowNumber: window.windowNumber, context: nil,
+                                                     characters: "k", charactersIgnoringModifiers: "k", isARepeat: false, keyCode: 40))
+        #expect(!engine.focusView.performKeyEquivalent(with: commandK), "command shortcuts stay with the menu")
+    }
