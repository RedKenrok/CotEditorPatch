+    @Test(.timeLimit(.minutes(1))) func resubmittingAFormAsksFirst() async throws {
+
+        try await self.withWebPages { directory, _, server, prompts in
+            server.route("/form", .page("<title>Form</title><form id=form method=post action='/result'><input name=a value=1></form>"))
+            server.route("/result", .page("<title>Result</title><a id=link href='/other'>other</a>"))
+            server.route("/other", .page("<title>Other</title>"))
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+
+            controller.load(server.url("/form"))
+            try await self.wait { session.title == "Form" && !session.isLoading }
+            _ = try await self.evaluate("document.getElementById('form').submit()", in: controller.webView)
+            try await self.wait { session.title == "Result" && !session.isLoading }
+            #expect(server.count("/result", method: "POST") == 1)
+
+            // Cancel sends nothing and keeps the page.
+            prompts.resubmits = false
+            controller.webView.reload()
+            try await self.wait { prompts.resubmissionRequests.count == 1 }
+            try await Task.sleep(for: .milliseconds(300))
+            #expect(server.count("/result", method: "POST") == 1)
+            #expect(session.title == "Result")
+
+            prompts.resubmits = true
+            controller.webView.reload()
+            try await self.wait { server.count("/result", method: "POST") == 2 }
+            #expect(prompts.resubmissionRequests.count == 2)
+
+            // Going back to the result may come from the page cache; it must never resend without asking.
+            _ = try await self.evaluate("document.getElementById('link').click()", in: controller.webView)
+            try await self.wait { session.title == "Other" && !session.isLoading }
+            prompts.resubmits = false
+            controller.webView.goBack()
+            try await Task.sleep(for: .milliseconds(500))
+            #expect(server.count("/result", method: "POST") == 2)
+        }
+    }
