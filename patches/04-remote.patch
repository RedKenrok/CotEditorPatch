+
+
+    /// Makes the header of the sidebar: where the folder is, how it is connected, and Refresh.
+    static func makeHeaderAccessory(session: RemoteFolderSession) -> NSSplitViewItemAccessoryViewController {
+
+        let header = NSHostingView(rootView: RemoteFolderHeader(session: session))
+        header.sizingOptions = [.intrinsicContentSize]
