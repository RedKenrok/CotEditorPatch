+import Foundation
+
+
+/// An SFTP version 3 session over a byte channel.
+///
+/// Requests carry IDs, so several may be outstanding; each waits for the response with its ID. The
+/// session fails as a whole, failing every outstanding request, when the channel ends, the server
+/// breaks the protocol, a transfer makes no progress for too long, or a request's task is canceled.
+/// A failed session is never used again.
+actor RemoteSFTPClient {
+
+    private let channel: any RemoteByteChannel
+    private let limits: RemoteLimits
+
+    private var framer: RemoteSFTPFramer
+    private var nextID: UInt32 = 1
+    private var pending: [UInt32: CheckedContinuation<RemoteSFTPResponse, any Error>] = [:]
+    private var versionContinuation: CheckedContinuation<(version: UInt32, extensions: [String: Data]), any Error>?
+    private var failure: (any Error)?
+    private var lastProgress = ContinuousClock.now
+    private var readerTask: Task<Void, Never>?
+    private var watchdogTask: Task<Void, Never>?
+
+    /// The extensions the server advertised, with their version strings.
+    private(set) var extensions: [String: Data] = [:]
+
+
+    init(channel: any RemoteByteChannel, limits: RemoteLimits) {
+
+        self.channel = channel
+        self.limits = limits
+        self.framer = RemoteSFTPFramer(maximumPacketLength: limits.maximumPacketLength)
+    }
+
+
+    /// Whether the session has failed or closed.
+    var isClosed: Bool {
+
+        self.failure != nil
+    }
+
+
+    /// Whether the server renames over an existing file atomically (`posix-rename@openssh.com`).
+    var supportsPOSIXRename: Bool {
+
+        self.extensions[RemoteSFTPExtension.posixRename] == Data("1".utf8)
+    }
+
+
+    /// Whether the server can flush an open file to disk (`fsync@openssh.com`).
+    var supportsFsync: Bool {
+
+        self.extensions[RemoteSFTPExtension.fsync] == Data("1".utf8)
+    }
+
+
+    /// Negotiates the protocol version.
+    ///
+    /// - Throws: `RemoteConnectionError.noSFTPService` if the server does not answer as an SFTP server.
+    func start() async throws {
+
+        self.readerTask = Task { await self.readChannel() }
+        self.watchdogTask = Task { await self.watchProgress() }
+        self.lastProgress = .now
+
+        let reply: (version: UInt32, extensions: [String: Data])
+        do {
+            // The reply can arrive as soon as the request is written, so the client waits for it first.
+            reply = try await withCheckedThrowingContinuation { continuation in
+                if let failure = self.failure {
+                    continuation.resume(throwing: failure)
+                } else {
+                    self.versionContinuation = continuation
+                    Task {
+                        do {
+                            try await self.channel.write(RemoteSFTPCodec.initializationPacket())
+                        } catch {
+                            self.fail(with: error)
+                        }
+                    }
+                }
+            }
+        } catch let error as RemoteConnectionError where error == .connectionLost {
+            // ssh reports why it could not start only on its diagnostic output
+            let diagnostics = await self.channel.diagnostics()
+            let classified = RemoteConnectionError.classify(status: nil, diagnostics: diagnostics)
+            if case .sshFailed = classified {
+                throw RemoteConnectionError.noSFTPService(diagnostics: diagnostics)
+            }
+            throw classified
+        }
+
+        guard reply.version >= RemoteSFTPCodec.version else {
+            self.fail(with: RemoteSFTPProtocolError(description: "unsupported protocol version \(reply.version)"))
+            throw RemoteConnectionError.noSFTPService(diagnostics: "")
+        }
+
+        self.extensions = reply.extensions
+    }
+
+
+    /// Ends the session and the channel.
+    func close() async {
+
+        self.fail(with: RemoteConnectionError.connectionLost)
+        await self.channel.close()
+    }
+
+
+    /// Sends a request and waits for its response.
+    ///
+    /// Canceling the waiting task ends the whole session, since the request may already be on its way.
+    func send(_ request: RemoteSFTPRequest) async throws -> RemoteSFTPResponse {
+
+        if let failure = self.failure { throw failure }
+
+        let id = self.nextID
+        self.nextID = (self.nextID == .max) ? 1 : self.nextID + 1
+        let packet = RemoteSFTPCodec.packet(for: request, id: id)
+        if self.pending.isEmpty {
+            self.lastProgress = .now
+        }
+
+        return try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                if let failure = self.failure {
+                    return continuation.resume(throwing: failure)
+                }
+                self.pending[id] = continuation
+                Task {
+                    do {
+                        try await self.channel.write(packet)
+                    } catch {
+                        self.fail(with: error)
+                    }
+                }
+            }
+        } onCancel: {
+            Task { await self.fail(with: CancellationError()) }
+        }
+    }
+
+
+    // MARK: Typed Requests
+
+    /// Sends a request that is answered by a status, and throws unless the status is OK.
+    func expectStatus(_ request: RemoteSFTPRequest, operation: RemoteSFTPOperation, path: String? = nil) async throws {
+
+        let response = try await self.send(request)
+        guard case .status(let code, let message) = response else { throw Self.unexpected(response) }
+        guard code == RemoteSFTPStatusCode.ok.rawValue else {
+            throw RemoteSFTPError(code: code, message: message, operation: operation, path: path)
+        }
+    }
+
+
+    func expectHandle(_ request: RemoteSFTPRequest, operation: RemoteSFTPOperation, path: String? = nil) async throws -> Data {
+
+        switch try await self.send(request) {
+            case .handle(let handle):
+                return handle
+            case .status(let code, let message):
+                throw RemoteSFTPError(code: code, message: message, operation: operation, path: path)
+            case let response:
+                throw Self.unexpected(response)
+        }
+    }
+
+
+    func expectAttributes(_ request: RemoteSFTPRequest, operation: RemoteSFTPOperation, path: String? = nil) async throws -> RemoteFileAttributes {
+
+        switch try await self.send(request) {
+            case .attributes(let attributes):
+                return attributes
+            case .status(let code, let message):
+                throw RemoteSFTPError(code: code, message: message, operation: operation, path: path)
+            case let response:
+                throw Self.unexpected(response)
+        }
+    }
+
+
+    /// Sends a request that is answered by a single name, as `REALPATH` and `READLINK` are.
+    func expectName(_ request: RemoteSFTPRequest, operation: RemoteSFTPOperation, path: String? = nil) async throws -> String {
+
+        switch try await self.send(request) {
+            case .name(let entries):
+                guard entries.count == 1, let entry = entries.first else {
+                    throw RemoteSFTPProtocolError(description: "expected one name, got \(entries.count)")
+                }
+                // A path is used as a string, so one that is not valid UTF-8 cannot be followed.
+                guard let name = entry.name else { throw RemoteSFTPProtocolError(description: "a name that is not valid UTF-8") }
+                return name
+            case .status(let code, let message):
+                throw RemoteSFTPError(code: code, message: message, operation: operation, path: path)
+            case let response:
+                throw Self.unexpected(response)
+        }
+    }
+
+
+    /// Sends a `READDIR` request.
+    ///
+    /// - Returns: The next entries of the folder, or `nil` at its end.
+    func expectNames(_ request: RemoteSFTPRequest, path: String? = nil) async throws -> [RemoteSFTPResponse.NameEntry]? {
+
+        switch try await self.send(request) {
+            case .name(let entries):
+                return entries
+            case .status(let code, _) where code == RemoteSFTPStatusCode.endOfFile.rawValue:
+                return nil
+            case .status(let code, let message):
+                throw RemoteSFTPError(code: code, message: message, operation: .listFolder, path: path)
+            case let response:
+                throw Self.unexpected(response)
+        }
+    }
+
+
+    /// Sends a `READ` request.
+    ///
+    /// - Returns: The data read, or `nil` at the end of the file.
+    func expectData(_ request: RemoteSFTPRequest, path: String? = nil) async throws -> Data? {
+
+        switch try await self.send(request) {
+            case .data(let data):
+                return data
+            case .status(let code, _) where code == RemoteSFTPStatusCode.endOfFile.rawValue:
+                return nil
+            case .status(let code, let message):
+                throw RemoteSFTPError(code: code, message: message, operation: .read, path: path)
+            case let response:
+                throw Self.unexpected(response)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    private static func unexpected(_ response: RemoteSFTPResponse) -> RemoteSFTPProtocolError {
+
+        RemoteSFTPProtocolError(description: "unexpected response \(response)")
+    }
+
+
+    /// Reads the channel until it ends, handing each packet to its waiting request.
+    private func readChannel() async {
+
+        do {
+            while let data = try await self.channel.read() {
+                try self.receive(data)
+            }
+            self.fail(with: RemoteConnectionError.connectionLost)
+        } catch {
+            self.fail(with: error)
+        }
+    }
+
+
+    private func receive(_ data: Data) throws {
+
+        self.framer.append(data)
+
+        while let packet = try self.framer.nextPacket() {
+            self.lastProgress = .now
+
+            if let continuation = self.versionContinuation {
+                self.versionContinuation = nil
+                continuation.resume(with: Result { try RemoteSFTPCodec.decodeVersion(type: packet.type, payload: packet.payload) })
+                continue
+            }
+
+            let (id, response) = try RemoteSFTPCodec.decodeResponse(type: packet.type, payload: packet.payload)
+            guard let continuation = self.pending.removeValue(forKey: id) else {
+                throw RemoteSFTPProtocolError(description: "response to unknown request \(id)")
+            }
+            continuation.resume(returning: response)
+        }
+    }
+
+
+    /// Fails the session when requests wait longer than allowed without any packet arriving.
+    private func watchProgress() async {
+
+        let interval = min(self.limits.noProgressTimeout / 4, .seconds(1))
+        while self.failure == nil {
+            try? await Task.sleep(for: interval)
+            guard self.failure == nil else { return }
+
+            let isWaiting = !self.pending.isEmpty || self.versionContinuation != nil
+            if isWaiting, ContinuousClock.now - self.lastProgress > self.limits.noProgressTimeout {
+                self.fail(with: RemoteConnectionError.timedOut)
+            }
+        }
+    }
+
+
+    /// Fails every outstanding request and ends the session. Only the first failure is kept.
+    private func fail(with error: any Error) {
+
+        guard self.failure == nil else { return }
+
+        self.failure = error
+        self.watchdogTask?.cancel()
+
+        for continuation in self.pending.values {
+            continuation.resume(throwing: error)
+        }
+        self.pending.removeAll()
+        self.versionContinuation?.resume(throwing: error)
+        self.versionContinuation = nil
+
+        Task { [channel] in await channel.close() }
+    }
+}
+
+
+/// What an SFTP request was doing, for error messages.
+enum RemoteSFTPOperation: String, Sendable {
+
+    case open
+    case close
+    case read
+    case write
+    case stat
+    case setAttributes
+    case remove
+    case resolvePath
+    case readLink
+    case rename
+    case sync
+    case openFolder
+    case listFolder
+    case createFolder
+    case removeFolder
+}
+
+
+/// A request that the server answered with a failure status.
+///
+/// The status is the server's definite answer: the operation was carried out or it was not. Only a
+/// lost reply leaves the outcome unknown, and that is a `RemoteConnectionError`, never this.
+struct RemoteSFTPError: Error, Equatable {
+
+    var code: UInt32
+    var message: String
+    var operation: RemoteSFTPOperation
+    var path: String?
+
+
+    var status: RemoteSFTPStatusCode? {
+
+        RemoteSFTPStatusCode(rawValue: self.code)
+    }
+}
+
+
+extension RemoteSFTPError: LocalizedError {
+
+    var errorDescription: String? {
+
+        let name = self.path.map { RemotePath.displayName(of: $0) } ?? ""
+
+        return switch self.status {
+            case .noSuchFile:
+                String(localized: "RemoteSFTPError.noSuchFile.description", defaultValue: "“\(name)” does not exist on the server.", table: "Remote",
+                       comment: "%@ is a file name")
+            case .permissionDenied:
+                String(localized: "RemoteSFTPError.permissionDenied.description",
+                       defaultValue: "You don’t have permission to access “\(name)” on the server.", table: "Remote",
+                       comment: "%@ is a file name")
+            case .operationUnsupported:
+                String(localized: "RemoteSFTPError.unsupported.description", defaultValue: "The server does not support this operation.", table: "Remote")
+            default:
+                String(localized: "RemoteSFTPError.failure.description", defaultValue: "The server reported an error.", table: "Remote")
+        }
+    }
+
+
+    var failureReason: String? {
+
+        self.message.isEmpty ? nil : RemoteSSHProcess.sanitized(self.message)
+    }
+}
+
+
+extension RemotePath {
+
+    /// The last component of a path, for messages.
+    static func displayName(of path: String) -> String {
+
+        path.split(separator: "/").last.map(String.init) ?? path
+    }
+}
