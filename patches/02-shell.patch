+
+import AppKit
+import SwiftUI
+
+
+/// Shows one terminal tab: the session's terminal view, and its state when it is not running.
+///
+/// The terminal view belongs to the session's engine, not to this controller, so switching tabs
+/// only moves the view in and out of the window. The process and its screen keep going meanwhile.
+final class TerminalTabViewController: NSViewController, DirectoryTabViewController {
+
+    let session: TerminalSession
+
+    private weak var directoryDocument: DirectoryDocument?
+    private var statusView: NSHostingView<TerminalStatusView>?
+    
+    /// Stretches the status view over the whole tab while there is no terminal view to show.
+    private var statusFillConstraint: NSLayoutConstraint?
+    private weak var embeddedEngineView: NSView?
+    private var observationTask: Task<Void, Never>?
+
+
+    init(session: TerminalSession, directoryDocument: DirectoryDocument?) {
+
+        self.session = session
+        self.directoryDocument = directoryDocument
+
+        super.init(nibName: nil, bundle: nil)
+    }
+
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+
+        fatalError("init(coder:) has not been implemented")
+    }
+
+
+    isolated deinit {
+        self.observationTask?.cancel()
+    }
+
+
+    override func loadView() {
+
+        let view = NSView()
+        view.setAccessibilityElement(true)
+        view.setAccessibilityRole(.group)
+        self.view = view
+        
+        self.update()
+    }
+
+
+    override func viewWillAppear() {
+
+        super.viewWillAppear()
+
+        self.update()
+
+        self.observationTask?.cancel()
+        self.observationTask = Task { [weak self, session] in
+            for await _ in Observations({ (session.lifecycle, session.engineGeneration, session.title, session.startingDirectory) }) {
+                guard !Task.isCancelled else { return }
+                self?.update()
+            }
+        }
+    }
+
+
+    override func viewDidDisappear() {
+
+        super.viewDidDisappear()
+
+        self.observationTask?.cancel()
+        self.observationTask = nil
+    }
+
+
+    // MARK: Public Methods
+
+    func focusTabContent() {
+
+        self.focus()
+    }
+
+
+    /// Moves keyboard focus to the terminal, or to the primary button while it is not running.
+    func focus() {
+
+        self.update()
+
+        guard let window = self.view.window else { return }
+
+        if let engine = self.session.engine, engine.focusView.window === window {
+            window.makeFirstResponder(engine.focusView)
+        } else if let statusView, statusView.window === window {
+            window.makeFirstResponder(statusView)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    private func update() {
+
+        guard self.isViewLoaded else { return }
+
+        // Embed the current engine's view, replacing a previous engine's.
+        let engineView = self.session.engine?.view
+        if self.embeddedEngineView !== engineView {
+            if self.embeddedEngineView?.superview === self.view {
+                self.embeddedEngineView?.removeFromSuperview()
+            }
+            if let engineView {
+                engineView.translatesAutoresizingMaskIntoConstraints = false
+                self.view.addSubview(engineView, positioned: .below, relativeTo: nil)
+                NSLayoutConstraint.activate([
+                    engineView.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+                    engineView.trailingAnchor.constraint(equalTo: self.view.trailingAnchor),
+                    engineView.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor),
+                    engineView.bottomAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.bottomAnchor),
+                ])
+            }
+            self.embeddedEngineView = engineView
+        }
+
+        let status = TerminalStatusView(session: self.session,
+                                        start: { [weak self] in self?.start() },
+                                        chooseFolder: { [weak self] in self?.chooseFolder() },
+                                        close: { [weak self] in self?.closeTab() })
+        if let statusView {
+            statusView.rootView = status
+        } else {
+            let statusView = NSHostingView(rootView: status)
+            // Only the height of the status content matters. By default a hosting view also turns the
+            // content's minimum and maximum size into required constraints, and the empty status of a
+            // running terminal has a maximum width of zero, which would squeeze the whole content pane.
+            statusView.sizingOptions = [.intrinsicContentSize]
+            statusView.setContentHuggingPriority(.defaultLow, for: .horizontal)
+            statusView.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+            statusView.translatesAutoresizingMaskIntoConstraints = false
+            self.view.addSubview(statusView)
+            NSLayoutConstraint.activate([
+                statusView.leadingAnchor.constraint(equalTo: self.view.leadingAnchor),
+                statusView.trailingAnchor.constraint(equalTo: self.view.trailingAnchor),
+                statusView.bottomAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.bottomAnchor),
+                statusView.topAnchor.constraint(greaterThanOrEqualTo: self.view.safeAreaLayoutGuide.topAnchor),
+            ])
+            self.statusView = statusView
+            self.statusFillConstraint = statusView.topAnchor.constraint(equalTo: self.view.safeAreaLayoutGuide.topAnchor)
+        }
+        // An exited shell's tab is about to close by itself, so there is nothing to explain, unless it stays to show a failure.
+        self.statusView?.isHidden = switch self.session.lifecycle {
+            case .running, .closed: true
+            case .exited: !self.session.keepsTabAfterExit
+            case .inactive, .failed: false
+        }
+        self.statusFillConstraint?.isActive = (engineView == nil)
+
+        self.view.setAccessibilityLabel(self.session.title)
+    }
+
+
+    private func start() {
+
+        self.session.start()
+        self.focus()
+    }
+
+
+    private func closeTab() {
+
+        Task { [session, directoryDocument] in
+            await directoryDocument?.closeTabItem(session)
+        }
+    }
+
+
+    /// Lets the user pick another starting folder, then starts there.
+    private func chooseFolder() {
+
+        guard let window = self.view.window else { return }
+
+        let panel = NSOpenPanel()
+        panel.canChooseFiles = false
+        panel.canChooseDirectories = true
+        panel.canCreateDirectories = false
+        panel.allowsMultipleSelection = false
+        panel.prompt = String(localized: "TerminalStatus.chooseFolder.prompt", defaultValue: "Start Here", table: "Terminal",
+                              comment: "button label in the panel choosing the folder a terminal starts in")
+        panel.directoryURL = TerminalLaunchConfiguration.isUsableDirectory(self.session.startingDirectory)
+            ? self.session.startingDirectory
+            : self.directoryDocument?.fileURL
+
+        Task {
+            guard await panel.beginSheetModal(for: window) == .OK, let url = panel.url else { return }
+
+            self.session.changeStartingDirectory(to: url)
+            self.directoryDocument?.invalidateRestorableState()
+            self.start()
+        }
+    }
+}
+
+
+// MARK: - Status View
+
+/// Explains a terminal that is not running and offers what can be done about it.
+struct TerminalStatusView: View {
+
+    let session: TerminalSession
+    let start: () -> Void
+    let chooseFolder: () -> Void
+    let close: () -> Void
+
+
+    var body: some View {
+
+        switch self.session.lifecycle {
+            case .exited where self.session.keepsTabAfterExit:
+                // The output stays visible above, since it usually says why the session ended.
+                HStack {
+                    Label(String(localized: "TerminalStatus.ended", defaultValue: "Session ended", table: "Terminal"), systemImage: "exclamationmark.triangle")
+                        .foregroundStyle(.secondary)
+                    Spacer()
+                    Button(String(localized: "TerminalStatus.startNewSession", defaultValue: "Start New Session", table: "Terminal", comment: "button label"),
+                           action: self.start)
+                    Button(String(localized: "TerminalStatus.closeTab", defaultValue: "Close Tab", table: "Terminal", comment: "button label"),
+                           action: self.close)
+                }
+                .controlSize(.small)
+                .padding(.horizontal, 12)
+                .padding(.vertical, 8)
+                .background(.bar)
+
+            case .running, .exited, .closed:
+                EmptyView()
+
+            case .inactive:
+                self.placeholder(
+                    systemImage: "apple.terminal",
+                    title: String(localized: "TerminalStatus.inactive.title", defaultValue: "Shell Not Running", table: "Terminal"),
+                    message: String(localized: "TerminalStatus.inactive.message",
+                                    defaultValue: "Processes and their output are not restored after CotEditor quits.", table: "Terminal"),
+                    primary: String(localized: "TerminalStatus.startNewSession", defaultValue: "Start New Session", table: "Terminal",
+                                    comment: "button label"))
+
+            case .failed(let error):
+                self.placeholder(
+                    systemImage: "exclamationmark.triangle",
+                    title: error.errorDescription ?? "",
+                    message: error.recoverySuggestion ?? "",
+                    primary: String(localized: "TerminalStatus.retry", defaultValue: "Try Again", table: "Terminal", comment: "button label"))
+        }
+    }
+
+
+    private func placeholder(systemImage: String, title: String, message: String, primary: String) -> some View {
+
+        let directory = self.session.startingDirectory
+        let launcher = self.session.launcher
+        // A launcher's terminal starts where the launcher says, so it has no local folder to be missing or to choose.
+        let directoryIsUsable = launcher != nil || TerminalLaunchConfiguration.isUsableDirectory(directory)
+        let location = launcher?.location ?? directory.path(percentEncoded: false)
+
+        return VStack(spacing: 12) {
+            Image(systemName: systemImage)
+                .font(.system(size: 36))
+                .foregroundStyle(.secondary)
+                .accessibilityHidden(true)
+            Text(title)
+                .font(.headline)
+            Text(message)
+                .foregroundStyle(.secondary)
+                .multilineTextAlignment(.center)
+            Text(directoryIsUsable
+                 ? String(localized: "TerminalStatus.startsIn", defaultValue: "Starts in “\(location)”.", table: "Terminal",
+                          comment: "%@ is the folder path a new terminal session starts in")
+                 : String(localized: "TerminalStatus.missingFolder",
+                          defaultValue: "The starting folder “\(directory.path(percentEncoded: false))” no longer exists.", table: "Terminal",
+                          comment: "%@ is the folder path"))
+                .font(.callout)
+                .foregroundStyle(directoryIsUsable ? AnyShapeStyle(.secondary) : AnyShapeStyle(.orange))
+                .multilineTextAlignment(.center)
+                .textSelection(.enabled)
+            HStack {
+                if directoryIsUsable {
+                    Button(primary, action: self.start)
+                        .keyboardShortcut(.defaultAction)
+                }
+                if launcher == nil {
+                    Button(String(localized: "TerminalStatus.chooseFolder", defaultValue: "Choose Folder…", table: "Terminal", comment: "button label"),
+                           action: self.chooseFolder)
+                }
+                Button(String(localized: "TerminalStatus.closeTab", defaultValue: "Close Tab", table: "Terminal", comment: "button label"),
+                       action: self.close)
+            }
+        }
+        .padding(24)
+        .frame(maxWidth: 480)
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .accessibilityElement(children: .contain)
+    }
+}
