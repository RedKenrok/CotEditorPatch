+
+import Foundation
+import os
+import Testing
+@testable import CotEditor
+
+/// Listing remote folders over SFTP: the protocol, the bounds, and the browsing connection.
+struct RemoteDirectoryListingTests {
+
+    // MARK: Protocol
+
+    @Test func folderRequestsAreEncoded() throws {
+
+        let opendir = RemoteSFTPCodec.packet(for: .opendir(path: "/srv"), id: 7)
+        #expect(opendir == RemoteSFTPCodec.frame(type: .opendir, payload: Data([0, 0, 0, 7, 0, 0, 0, 4]) + Data("/srv".utf8)))
+
+        let readdir = RemoteSFTPCodec.packet(for: .readdir(handle: Data("h".utf8)), id: 8)
+        #expect(readdir == RemoteSFTPCodec.frame(type: .readdir, payload: Data([0, 0, 0, 8, 0, 0, 0, 1]) + Data("h".utf8)))
+    }
+
+
+    @Test func namesThatAreNotUTF8AreDecodedAsBytes() throws {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(UInt32(3))  // request ID
+        writer.write(UInt32(1))
+        writer.write(string: Data([0x66, 0xFF]))
+        writer.write(string: Data())
+        writer.write(RemoteFileAttributes())
+
+        let (id, response) = try RemoteSFTPCodec.decodeResponse(type: RemoteSFTPPacketType.name.rawValue, payload: writer.data)
+        #expect(id == 3)
+        guard case .name(let entries) = response else { Issue.record("expected names"); return }
+        #expect(entries.first?.nameBytes == Data([0x66, 0xFF]))
+        #expect(entries.first?.name == nil)
+    }
+
+
+    @Test func nameCountsLargerThanThePacketAreRefused() throws {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(UInt32(3))
+        writer.write(UInt32(1_000_000))
+        writer.write(string: "a")
+
+        #expect(throws: RemoteSFTPProtocolError.self) {
+            try RemoteSFTPCodec.decodeResponse(type: RemoteSFTPPacketType.name.rawValue, payload: writer.data)
+        }
+    }
+
+
+    // MARK: Listing
+
+    @Test func aFolderIsListedInBatchesUntilTheEnd() async throws {
+
+        let server = FakeSFTPServer()
+        for index in 0..<150 {
+            await server.addFile("/srv/file \(index).txt", "")
+        }
+        await server.addDirectory("/srv/sub")
+        await server.configure { $0.directoryBatchSize = 40 }
+        let transport = try await self.connect(to: server)
+
+        let batches = OSAllocatedUnfairLock(initialState: [[String]]())
+        let listing = try await transport.listDirectory(at: "/srv", limits: RemoteLimits()) { entries in
+            batches.withLock { $0.append(entries.map(\.name)) }
+        }
+
+        #expect(listing.isComplete)
+        #expect(listing.entries.count == 151)
+        #expect(batches.withLock { $0.map(\.count) } == [38, 40, 40, 33], "each batch is told as it arrives, without . and ..")
+        #expect(batches.withLock { $0.flatMap(\.self) } == listing.entries.map(\.name))
+        #expect(!listing.entries.contains { $0.name == "." || $0.name == ".." })
+        #expect(listing.entries.first { $0.name == "sub" }?.attributes.kind == .directory)
+        #expect(await server.log.filter { if case .readdir = $0 { true } else { false } }.count == 5, "four batches and the end")
+        #expect(await server.openHandleCount == 0)
+        await transport.disconnect()
+    }
+
+
+    @Test func anEmptyFolderIsCompleteAndAnUnreadableOneFails() async throws {
+
+        let server = FakeSFTPServer()
+        await server.addDirectory("/srv/empty")
+        await server.addDirectory("/srv/locked", mode: 0o000)
+        let transport = try await self.connect(to: server)
+
+        let empty = try await transport.listDirectory(at: "/srv/empty", limits: RemoteLimits())
+        #expect(empty.isComplete)
+        #expect(empty.entries.isEmpty)
+
+        await #expect { try await transport.listDirectory(at: "/srv/locked", limits: RemoteLimits()) } throws: { error in
+            (error as? RemoteSFTPError)?.status == .permissionDenied
+        }
+        await transport.disconnect()
+    }
+
+
+    @Test func namesDifferingInNormalizationOrCaseAreSeparateEntries() async throws {
+
+        let server = FakeSFTPServer()
+        let composed = "caf\u{E9}.txt"
+        let decomposed = "cafe\u{301}.txt"
+        await server.addFile("/srv/" + composed, "composed")
+        await server.addFile("/srv/" + decomposed, "decomposed")
+        await server.addFile("/srv/Readme", "")
+        await server.addFile("/srv/README", "")
+        let transport = try await self.connect(to: server)
+
+        let listing = try await transport.listDirectory(at: "/srv", limits: RemoteLimits())
+        let names = listing.entries.map { Array($0.name.utf8) }
+
+        #expect(listing.entries.count == 4)
+        #expect(names.contains(Array(composed.utf8)))
+        #expect(names.contains(Array(decomposed.utf8)))
+        #expect(Set(listing.entries.map(\.name)).count == 3, "Swift’s string equality alone would merge them")
+        await transport.disconnect()
+    }
+
+
+    @Test func unusableNamesAreLeftOutAndCountedAndDuplicatesMerged() async throws {
+
+        let server = FakeSFTPServer()
+        await server.addFile("/srv/good.txt", "")
+        await server.configure { server in
+            server.rawEntries["/srv"] = [Data([0x66, 0xFF]), Data(), Data("a/b".utf8), Data("bell\u{7}".utf8), Data("good.txt".utf8), Data(".".utf8)]
+        }
+        let transport = try await self.connect(to: server)
+
+        let listing = try await transport.listDirectory(at: "/srv", limits: RemoteLimits())
+
+        #expect(listing.entries.map(\.name) == ["good.txt"])
+        #expect(listing.omittedCount == 4)
+        #expect(listing.isComplete)
+        await transport.disconnect()
+    }
+
+
+    @Test func largeFoldersStopAtTheLimitAndCloseTheirHandle() async throws {
+
+        let server = FakeSFTPServer()
+        for index in 0..<30 {
+            await server.addFile("/srv/\(index)", "")
+        }
+        await server.configure { $0.directoryBatchSize = 7 }
+        let transport = try await self.connect(to: server)
+
+        // Hidden names count too, and the bound counts every entry the server sends.
+        let byCount = try await transport.listDirectory(at: "/srv", limits: RemoteLimits(maximumListingEntries: 20))
+        #expect(byCount.limit == .entries(20))
+        #expect(byCount.entries.count < 20)
+
+        let byBytes = try await transport.listDirectory(at: "/srv", limits: RemoteLimits(maximumListingNameBytes: 16))
+        #expect(byBytes.limit == .nameBytes(16))
+
+        #expect(await server.openHandleCount == 0)
+        await transport.disconnect()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aListingThatNeverEndsIsBounded() async throws {
+
+        let server = FakeSFTPServer()
+        await server.addDirectory("/srv/endless")
+        await server.configure { $0.endlessFolders = ["/srv/endless"] }
+        let transport = try await self.connect(to: server)
+
+        let listing = try await transport.listDirectory(at: "/srv/endless", limits: RemoteLimits(maximumListingEntries: 50))
+
+        #expect(listing.limit == .entries(50))
+        #expect(await server.openHandleCount == 0)
+        await transport.disconnect()
+    }
+
+
+    @Test func theHandleIsClosedWhenTheServerFailsOrTheListingIsCanceled() async throws {
+
+        let server = FakeSFTPServer()
+        for index in 0..<10 {
+            await server.addFile("/srv/\(index)", "")
+        }
+        await server.configure { $0.directoryBatchSize = 2 }
+        let transport = try await self.connect(to: server)
+
+        // a failure in the middle
+        let count = FakeCounter()
+        await server.setHook { request in
+            guard case .readdir = request else { return .proceed }
+            return await count.increment() == 3 ? .fail(.failure) : .proceed
+        }
+        await #expect(throws: RemoteSFTPError.self) { try await transport.listDirectory(at: "/srv", limits: RemoteLimits()) }
+        #expect(await server.openHandleCount == 0)
+
+        // a cancellation between batches
+        let control = RemoteOperationControl()
+        await server.setHook { request in
+            if case .readdir = request, await count.increment() == 5 {
+                control.requestCancel()
+            }
+            return .proceed
+        }
+        await #expect(throws: RemoteOperationCanceled.self) {
+            try await RemoteOperationControl.$current.withValue(control) {
+                try await transport.listDirectory(at: "/srv", limits: RemoteLimits())
+            }
+        }
+        #expect(await server.openHandleCount == 0)
+        #expect(await !transport.isDisconnected, "a canceled listing leaves the connection usable")
+        await transport.disconnect()
+    }
+
+
+    @Test func foldersAreRecognizedWithoutTypesByOpeningThem() async throws {
+
+        let server = FakeSFTPServer()
+        await server.addDirectory("/srv/folder")
+        await server.addFile("/srv/file", "")
+        await server.configure {
+            $0.omitsListingTypes = true
+            $0.omitsStatTypes = true
+        }
+        let transport = try await self.connect(to: server)
+
+        let listing = try await transport.listDirectory(at: "/srv", limits: RemoteLimits())
+        #expect(listing.entries.allSatisfy { $0.attributes.kind == .unknown })
+
+        #expect(try await RemotePoolTreeSource.resolve("/srv/folder", with: transport) == RemoteResolvedItem(target: "/srv/folder", kind: .directory))
+        #expect(try await RemotePoolTreeSource.resolve("/srv/file", with: transport) == RemoteResolvedItem(target: "/srv/file", kind: .unknown))
+        #expect(await server.openHandleCount == 0)
+        await transport.disconnect()
+    }
+
+
