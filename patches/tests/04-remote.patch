+        let pool = await server.makePool()
+        let endpoint = RemoteEndpoint.fake
+
+        // A save's operation holds the file connection, paused.
+        let gate = FakeGate()
+        let upload = Task {
+            try await pool.withConnection(to: endpoint, destination: .fake) { transport in
+                _ = try await transport.stat("/srv/a.txt")
+                await gate.wait()
+                return try await transport.stat("/srv/a.txt")
+            }
+        }
+        try await waitUntil { await gate.hasArrived }
+
+        let listing = try await pool.withBrowsingConnection(to: endpoint, destination: .fake) { transport in
+            try await transport.listDirectory(at: "/srv/list", limits: RemoteLimits())
+        }
+        #expect(listing.entries.count == 20)
+        #expect(await pool.hasConnection(to: endpoint, destination: .fake, role: .browsing))
+        #expect(await pool.hasConnection(to: endpoint, destination: .fake, role: .files))
+
+        // A listing canceled meanwhile ends without touching the save's connection.
+        let control = RemoteOperationControl()
+        control.requestCancel()
+        await #expect(throws: RemoteOperationCanceled.self) {
+            try await RemoteOperationControl.$current.withValue(control) {
+                try await pool.withBrowsingConnection(to: endpoint, destination: .fake) { transport in
+                    try await transport.listDirectory(at: "/srv/list", limits: RemoteLimits())
+                }
+            }
+        }
