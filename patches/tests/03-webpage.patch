+    @Test(.timeLimit(.minutes(1))) func aFailedNavigationKeepsTheFormAndRetriesOnlyItsOwnRequest() async throws {
+
+        try await self.withWebPages { directory, _, server, _ in
+            server.route("/form", .page("<title>Form</title><input id=field>"))
+            server.route("/next", .drop)
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+
+            controller.load(server.url("/form"))
+            try await self.wait { session.title == "Form" && !session.isLoading }
+            _ = try await self.evaluate("document.getElementById('field').value = 'kept'", in: controller.webView)
+
+            _ = try await self.evaluate("location.href = '/next'", in: controller.webView)
+            try await self.wait { session.failure != nil }
+            let failure = try #require(session.failure)
+            #expect(failure.url == server.url("/next"), "the failure names the page that failed")
+            #expect(failure.isRetryable)
+            #expect(failure.keepsPreviousPage)
+            // Nothing replaces the page afterwards, such as an error document.
+            try await Task.sleep(for: .milliseconds(300))
+            #expect(controller.webView.url == server.url("/form"))
+            #expect(session.currentURL == server.url("/form"))
+            #expect(try await self.evaluate("document.getElementById('field').value", in: controller.webView) == "kept")
+
+            // Retry asks for the failed page, never for the page that is showing.
+            server.route("/next", .page("<title>Next</title>"))
+            let attempts = server.count("/next")
+            controller.retry()
+            try await self.wait { session.title == "Next" && !session.isLoading }
+            #expect(server.count("/next") > attempts)
+            #expect(server.count("/form") == 1)
+            #expect(session.failure == nil)
+        }
+    }
