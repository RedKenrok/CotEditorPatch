+    // MARK: Quitting and Preferences
+
+    @Test(.timeLimit(.minutes(1))) func quittingAsksAboutRunningTerminalsBeforeEditedRemoteFiles() async throws {
+
+        try await self.withTerminals(registersDocument: true) { directory, _, _, terminalPrompts in
+            let bed = await RemoteTestBed()
+            let original = RemoteEnvironment.current
+            RemoteEnvironment.current = bed.environment
+            defer { RemoteEnvironment.current = original }
+            defer { TerminalTermination.revokeConsent() }
+
+            await bed.server.addFile("/srv/a.txt", "a")
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            document.replaceText(with: "edited")
+            _ = try #require(directory.openTerminalTab())
+            let record = try #require(document.record?.directory)
+
+            // Canceling the terminal consent ends the quit before any document is reviewed.
+            terminalPrompts.answers = [false]
+            let receiver = ReviewReceiver()
+            NSDocumentController.shared.reviewUnsavedDocuments(withAlertTitle: nil, cancellable: true, delegate: receiver,
+                                                               didReviewAllSelector: #selector(ReviewReceiver.documentController(_:didReviewAll:contextInfo:)),
+                                                               contextInfo: nil)
+            try await self.wait { receiver.result != nil }
+            #expect(receiver.result == false)
+            #expect(bed.prompts.asked.isEmpty, "the remote file was not asked about")
+            #expect(!RemoteTermination.isInProgress)
+            #expect(document.isDocumentEdited)
+            #expect(FileManager.default.fileExists(atPath: record.path(percentEncoded: false)))
+            #expect(directory.activeTerminalSession?.isLive == true)
+
+            // With the consent given, AppKit does not review a document that autosaves in place: it
+            // autosaves it, which for a remote file writes its recovery copy, and lets the app quit.
+            terminalPrompts.answers = [true]
+            let second = ReviewReceiver()
+            NSDocumentController.shared.reviewUnsavedDocuments(withAlertTitle: nil, cancellable: true, delegate: second,
+                                                               didReviewAllSelector: #selector(ReviewReceiver.documentController(_:didReviewAll:contextInfo:)),
+                                                               contextInfo: nil)
+            try await self.wait { second.result != nil }
+            #expect(second.result == true)
+            #expect(bed.prompts.asked.isEmpty, "the remote close review is not shown at quit")
+            #expect(RemoteTermination.isInProgress, "documents closed from here on keep their records for restoration")
+            try await self.wait { document.durableGeneration == document.generation }
+            #expect(try await document.record?.text()?.string == "edited", "the edits are on this Mac before the app quits")
+            #expect(FileManager.default.fileExists(atPath: record.path(percentEncoded: false)))
+            RemoteTermination.isInProgress = false
+
+            document.close()
+            await bed.tearDown()
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func turningTabsOffKeepsAnEditedRemoteFile() async throws {
+
+        try await self.withRemote(makesWindow: true) { directory, urls, bed in
+            await bed.server.addFile("/srv/a.txt", "a")
+            #expect(await directory.openDocument(at: urls[0]))
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            document.replaceText(with: "edited")
+            let id = try #require(directory.tabState.entry(for: document)?.id)
+            let record = try #require(document.record?.directory)
+            directory.selectDocument(try #require(self.member(at: urls[0], in: directory)))
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            #expect(bed.prompts.asked.isEmpty, "turning tabs off closes nothing, so nothing is asked")
+            #expect(document.isDocumentEdited)
+            #expect(document.directoryDocument === directory, "the edited file stays a member while hidden")
+            #expect(FileManager.default.fileExists(atPath: record.path(percentEncoded: false)))
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+            #expect(directory.tabState.entry(for: document)?.id == id, "it comes back in its tab")
+            #expect(document.textStorage.string == "edited")
+        }
+    }
+
+
+    // MARK: Mixed Tabs
+
+    @Test(.timeLimit(.minutes(1))) func remoteTabsKeepTheirEditorStateAcrossSwitches() async throws {
+
+        try await self.withRemote(makesWindow: true) { directory, urls, bed in
+            await bed.server.addFile("/srv/a.txt", "line one\nline two\nline three")
+            #expect(await directory.openDocument(at: urls[0]))
+            let local = try #require(directory.activeFileDocument)
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            let content = try #require(directory.windowContentViewController)
+            let editor = try #require(content.documentViewController)
+            let textView = try #require(editor.focusedTextView)
+
+            // An edit through the text view, so that it can be undone, and a selection after it.
+            textView.setSelectedRange(NSRange(location: 0, length: 0))
+            textView.insertText("new ", replacementRange: textView.selectedRange())
+            textView.setSelectedRange(NSRange(location: 9, length: 4))
+
+            directory.selectDocument(local)
+            directory.selectDocument(document)
+            #expect(content.documentViewController === editor, "the remote file keeps its editor")
+            #expect(editor.focusedTextView?.selectedRange() == NSRange(location: 9, length: 4))
+            #expect(document.undoManager?.canUndo == true)
+            document.undoManager?.undo()
+            #expect(document.textStorage.string == "line one\nline two\nline three")
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func remoteTerminalAndFileTabsComeBackTogetherInTheirOrder() async throws {
+
+        try await self.withTerminals { directory, urls, _, _ in
+            let bed = await RemoteTestBed()
+            let original = RemoteEnvironment.current
+            RemoteEnvironment.current = bed.environment
+            defer { RemoteEnvironment.current = original }
+
+            await bed.server.addFile("/srv/a.txt", "a")
+            await bed.server.addFile("/srv/b.txt", "b")
+            #expect(await directory.openDocument(at: urls[0]))
+            let first = try await bed.openInDirectory("/srv/a.txt", directory)
+            let terminal = try #require(directory.openTerminalTab())
+            let second = try await bed.openInDirectory("/srv/b.txt", directory)
+
+            // Reorder: b, the local file, the terminal, a.
+            directory.moveTab(id: try #require(directory.tabState.entry(for: second)?.id), to: 0)
+            directory.moveTab(id: try #require(directory.tabState.entry(for: first)?.id), to: 3)
+            directory.selectTerminal(terminal)
+            let order = directory.tabState.entries.map(\.id)
+            #expect(order.count == 4)
+            #expect(directory.tabState.entries.last?.document === first)
+
+            let data = self.encodeRestorableState(of: directory)
+            // Clean files leave no record when they close, so they come back as placeholders.
+            directory.close()
+            await bed.server.clearLog()
+
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                try await self.wait { restored.tabState.entries.count == 4 }
+                #expect(restored.tabState.entries.map(\.id) == order)
+                #expect(restored.activeTerminalSession?.id == terminal.id, "the terminal keeps the selection")
+                #expect(restored.activeTerminalSession?.isLive == false, "as a placeholder")
+                #expect(restored.tabDocuments.compactMap { ($0 as? RemoteDocument)?.identity.path } == ["/srv/b.txt", "/srv/a.txt"])
+                #expect(await bed.server.log.isEmpty, "restoring does not connect")
+                for case let document as RemoteDocument in restored.tabDocuments {
+                    bed.track(document)
+                }
+            }
+            await bed.tearDown()
+        }
+    }
+
+
+    // MARK: Helpers
+
+    /// Runs the body with a directory, a fake server, and the fake's environment for the app's commands.
+    func withRemote(makesWindow: Bool = false, _ body: (DirectoryDocument, [URL], RemoteTestBed) async throws -> Void) async throws {
+
+        let bed = await RemoteTestBed()
+        let original = RemoteEnvironment.current
+        RemoteEnvironment.current = bed.environment
+        defer { RemoteEnvironment.current = original }
+
+        try await self.withDirectory(makesWindow: makesWindow) { directory, urls in
+            try await body(directory, urls, bed)
+        }
+        await bed.tearDown()
+    }
+}
+
+
+extension RemoteTestBed {
+
+    /// Opens a remote file in a directory window, as the tab strip's command does.
+    func openInDirectory(_ path: String, _ directory: DirectoryDocument) async throws -> RemoteDocument {
+
+        let document = try await RemoteOpenCoordinator.open(RemoteOpenRequest(profileID: nil, endpoint: self.endpoint, path: path),
+                                                            in: directory, window: nil, environment: self.environment)
+        self.track(document)
+
+        return document
+    }
+}
+
+
+/// Receives the result of the document controller's review of unsaved documents, as the app's quit does.
+@MainActor final class ReviewReceiver: NSObject {
+
+    private(set) var result: Bool?
+
+
+    @objc func documentController(_ documentController: NSDocumentController, didReviewAll: Bool, contextInfo: UnsafeMutableRawPointer?) {
+
+        self.result = didReviewAll
+    }
+}
