+    case conflict(RemoteConflict)
+    /// The operation failed without changing the target.
+    case failed(RemoteSaveFailure)
+    /// The target may or may not have changed. It must be checked before anything else is written.
+    case unresolved(RemoteSaveFailure)
+    /// The save was not attempted.
+    case refused(RemoteSaveRefusal)
+    /// An earlier interrupted save turned out not to have changed the server.
+    case previousSaveNotApplied
+    /// The text encoding would lose characters.
+    case lossyEncoding(RemoteSaveFailure)
+    /// The changes could not be made durable on this Mac. Nothing was sent.
+    case recoveryFailed(RemoteSaveFailure)
+    /// The server confirmed the save, but it could not be recorded on this Mac.
+    case unconfirmedLocally(RemoteSaveFailure)
+}
+
+
+/// Runs a remote document's saves and repairs, one at a time.
+///
+/// Every save follows the same order: the snapshot and all edits are made durable on this Mac first,
+/// then the server's file is checked against the version the edits are based on, then written, then
+/// verified. The state recorded before each step that can change the server decides what a failure
+/// means: before it, the target is unchanged; after it, the outcome is unknown until the target has
+/// been read and compared, which happens before anything else is written.
+///
+/// SFTP has no conditional write, so a writer that changes the file between the last check and the
+/// commit cannot be excluded. Everything else that can be observed is checked, twice for a
+/// replacing save, and a detected change is never overwritten.
+@MainActor final class RemoteSaveCoordinator {
+
+    /// What to write.
+    enum Request: Equatable {
+
+        /// The editor's text, over the version it is based on.
+        case save
+        /// The editor's text, over the remote version the user reviewed after a conflict.
+        case replaceReviewed
+        /// The editor's text, in place over the reviewed version, after an interrupted write in place.
+        case retryInPlace
+        /// The version from before an interrupted write in place, over the reviewed version.
+        case restoreOriginal
+        /// The editor's text, as a new file at the path.
+        case saveAs(path: String)
+    }
+
+
+    private enum PhaseResult: Sendable {
+
+        case committed(RemoteFileAttributes, resolvedPath: String?)
+        case needsInPlace
+        case conflict(RemoteConflict)
+        case refused(RemoteSaveRefusal)
+        case notWritten(any Error)
+        case thrown(any Error)
+        /// The user canceled before anything could reach the target.
+        case canceled
+    }
+
+
+    private enum Reconciliation {
+
+        case committed
+        case notApplied
+        case conflict(RemoteConflict)
+        case unresolved(any Error)
+    }
+
+
+    private unowned let document: RemoteDocument
+    private let lock = RemoteAsyncLock()
+
+    /// The change-count tokens of operations under way, applied only if their snapshot reaches the server.
+    private var acknowledgements: [UUID: Any] = [:]
+
+    private(set) var isBusy = false
+
+
+    init(document: RemoteDocument) {
+
+        self.document = document
+    }
+
+
+    // MARK: Interactive Saving
+
+    /// Saves, and walks the user through any conflict or failure.
+    ///
+    /// - Returns: `true` if the editor's text reached the server.
+    @discardableResult func save() async -> Bool {
+
+        await self.saveInteractively(.save)
+    }
+
+
+    /// Asks for a path on the same server and saves the text there as a new file.
+    ///
+    /// - Returns: `true` if the new file was created and the document now edits it.
+    @discardableResult func saveAsRemote() async -> Bool {
+
+        let identity = self.document.identity
+        let suggestion = RemotePath.appending(Self.copyName(of: identity.fileName), to: RemotePath.parent(of: identity.path))
+        guard let path = await self.document.environment.prompts.askForRemotePath(suggestedPath: suggestion, connectionName: identity.connectionName,
+                                                                      window: self.document.windowForSheet)
+        else { return false }
+
+        return await self.saveInteractively(.saveAs(path: path))
+    }
+
+
+    /// Runs work while no save or repair can start, after waiting for the one under way.
+    ///
+    /// A folder window holds a document's saves while it renames, moves or deletes the file, so that no
+    /// save can write to the old path meanwhile.
+    func withSavesHeld<T>(_ work: () async throws -> T) async rethrows -> T {
+
+        await self.lock.lock()
+        defer { Task { await self.lock.unlock() } }
+
+        return try await work()
+    }
+
+
+    /// Waits until no save or repair runs.
+    func waitUntilIdle() async {
+
+        await self.lock.lock()
+        await self.lock.unlock()
+    }
+
+
+    private func saveInteractively(_ request: Request) async -> Bool {
+
+        let prompts = self.document.environment.prompts
+        let fileName = self.document.identity.fileName
+        var request = request
+
+        while true {
+            let window = self.document.windowForSheet
+            let title = String(localized: "RemoteProgress.saving", defaultValue: "Saving “\(fileName)”…", table: "Remote",
+                               comment: "title of the progress sheet of a remote save (%@ is the file name)")
+
+            switch await RemoteProgressSheet.run(title: title, window: window, { await self.perform(request) }) {
+                case .saved:
+                    return request != .restoreOriginal
+
+                case .canceled:
+                    return false
+
+                case .lossyEncoding(let failure):
+                    guard await self.document.presentErrorForRecovery(failure.error) else { return false }
+
+                case .conflict(let conflict):
+                    let reviewed = await self.document.record?.manifest.reviewed
+                    let isReviewed = conflict.remoteData != nil && reviewed?.digest == conflict.remoteDigest
+                    var choices: [RemoteConflictChoice] = []
+                    if conflict.remoteData != nil { choices.append(.openRemoteVersion) }
+                    choices.append(.saveAsRemote)
+                    if isReviewed {
+                        choices.append(.replace)
+                        if conflict.followsInterruptedInPlaceSave { choices.append(.restoreOriginal) }
+                    }
+
+                    switch await prompts.resolveConflict(conflict, fileName: fileName, choices: choices, window: window) {
+                        case .keepEditing:
+                            return false
+                        case .openRemoteVersion:
+                            await self.document.openRemoteVersion(conflict)
+                            return false
+                        case .saveAsRemote:
+                            return await self.saveAsRemote()
+                        case .replace:
+                            request = conflict.followsInterruptedInPlaceSave ? .retryInPlace : .replaceReviewed
+                        case .restoreOriginal:
+                            request = .restoreOriginal
+                    }
+
+                case .previousSaveNotApplied:
+                    guard await self.handleFailure(RemoteSaveError.previousSaveNotApplied, canRetry: true) else { return false }
+                    request = .save
+
+                case .failed(let failure), .unresolved(let failure), .recoveryFailed(let failure), .unconfirmedLocally(let failure):
+                    guard await self.handleFailure(failure.error, canRetry: true) else { return false }
+
+                case .refused(let refusal):
+                    _ = await self.handleFailure(refusal, canRetry: false)
+                    return false
+            }
+        }
+    }
+
+
+    /// Reports a failure and carries out the user's choice.
+    ///
+    /// - Returns: `true` if the user chose to retry.
+    private func handleFailure(_ error: any Error, canRetry: Bool) async -> Bool {
+
+        switch await self.document.environment.prompts.reportFailure(error, fileName: self.document.identity.fileName, canRetry: canRetry,
+                                                         window: self.document.windowForSheet)
+        {
+            case .retry:
+                return true
+            case .saveLocalCopy:
+                self.document.saveTo(nil)
+                return false
+            case .dismiss:
+                return false
+        }
+    }
+
+
+    // MARK: Operations
+
+    /// Runs a save or repair after any that is under way.
+    func perform(_ request: Request) async -> RemoteSaveOutcome {
+
+        await self.lock.lock()
+        self.isBusy = true
+        self.document.saveStateDidChange()
+        defer {
+            self.isBusy = false
+            self.document.saveStateDidChange()
+            Task { await self.lock.unlock() }
+        }
+
+        guard let record = self.document.record else { return .failed(.init(RemoteSaveError.noRecoveryRecord)) }
+
+        switch request {
+            case .save, .replaceReviewed, .saveAs:
+                // An earlier operation whose outcome is unknown must be resolved before anything else is
+                // written to the same file. A new file elsewhere may be created meanwhile.
+                if let operation = await record.manifest.operation {
+                    if case .saveAs = request, operation.mayHaveChangedTarget, operation.kind != .create {
+                        break
+                    }
+                    if operation.mayHaveChangedTarget {
+                        switch await self.reconcile(operation, record: record) {
+                            case .committed:
+                                // The file the user asks to create again is the one that was created.
+                                if case .saveAs(let path) = request, operation.kind == .create, RemotePath.isSame(path, operation.targetPath) {
+                                    return .saved
+                                }
+                                if !self.document.isDocumentEdited, request == .save { return .saved }
+                            case .notApplied:
+                                return .previousSaveNotApplied
+                            case .conflict(let conflict):
+                                return .conflict(conflict)
+                            case .unresolved(let error):
+                                return .unresolved(.init(error))
+                        }
+                    } else {
+                        // prepared but never sent, for example before a crash
+                        try? await record.abandonOperation(id: operation.id, retainedTemporaryPath: operation.temporaryPath)
+                    }
+                }
+
+            case .retryInPlace, .restoreOriginal:
+                break
+        }
+
+        switch await self.checkDestination(record: record) {
+            case nil: break
+            case let outcome?: return outcome
+        }
+
+        switch request {
+            case .save:
+                return await self.runSave(record: record, expectsReviewed: false, repairs: nil)
+            case .replaceReviewed:
+                return await self.runSave(record: record, expectsReviewed: true, repairs: nil)
+            case .retryInPlace, .restoreOriginal:
+                guard let operation = await record.manifest.operation, operation.mayHaveChangedTarget else {
+                    return .failed(.init(RemoteSaveError.outcomeUnknown))
+                }
+                return request == .retryInPlace
+                    ? await self.runSave(record: record, expectsReviewed: true, repairs: operation)
+                    : await self.runRestore(record: record, repairs: operation)
+            case .saveAs(let path):
+                return await self.runCreate(record: record, path: path)
+        }
+    }
+
+
+    /// Downloads the file as it is on the server now, after checking that it is still the same file.
+    func downloadCurrentVersion() async throws -> RemoteFileContents {
+
+        let identity = self.document.identity
+        let limits = await self.document.environment.pool.limits
+
+        return try await self.document.environment.pool.withReadingConnection(to: identity.endpoint, destination: identity.destination) { transport in
+            if let conflict = try await Self.checkIdentity(identity, transport) {
+                throw conflict.reason == .missing ? RemoteSaveError.targetMissing : RemoteTransferError.notRegularFile
+            }
+            return try await transport.readFile(at: identity.path, limit: limits.transferCap)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    /// Asks before saving if the host now resolves to another destination.
+    ///
+    /// - Returns: `nil` to go on, or the outcome to end with.
+    private func checkDestination(record: RemoteRecoveryRecord) async -> RemoteSaveOutcome? {
+
+        let identity = self.document.identity
+        let destination: RemoteDestination
+        do {
+            destination = try await self.document.environment.pool.destination(for: identity.endpoint)
+        } catch {
+            return .failed(.init(error))
+        }
+
+        guard destination != identity.destination else { return nil }
+
+        let confirms = await self.document.environment.prompts.confirmDestinationChange(from: identity.destination, to: destination, window: self.document.windowForSheet)
+        guard confirms else { return .canceled }
+
+        // The file there is compared with the baseline before anything is written, so a different file is a conflict.
+        var newIdentity = identity
+        newIdentity.destination = destination
+        do {
+            try await record.updateIdentity(newIdentity)
+        } catch {
+            return .recoveryFailed(.init(error))
+        }
+        self.document.adoptIdentity(newIdentity)
+
+        return nil
+    }
+
+
+    /// Saves the editor's text over the expected version, replacing the file where that is safe and
+    /// rewriting it in place, with the user's consent, where it is not.
+    ///
+    /// - Parameters:
+    ///   - expectsReviewed: Whether the server should have the version the user reviewed, rather than the baseline.
+    ///   - repairs: The interrupted write in place that the user approved overwriting, if this is a repair.
+    private func runSave(record: RemoteRecoveryRecord, expectsReviewed: Bool, repairs interrupted: RemoteRecoveryManifest.Operation?) async -> RemoteSaveOutcome {
+
+        let limits = await self.document.environment.pool.limits
+
+        // 1. Snapshot: text, settings, generation and token are taken together, without suspending.
+        do {
+            try self.document.prepareForSaving(for: .saveOperation)
+        } catch {
+            return .lossyEncoding(.init(error))
+        }
+        let snapshot = self.document.encodedContents()
+        let settings = self.document.textSettings
+        let generation = self.document.generation
+        let token = self.document.changeCountToken(for: .saveOperation)
+
+        // 2. Recovery first: every edit so far is durable before anything is sent, whatever its size.
+        guard await self.document.persistLatestGeneration() else {
+            return .recoveryFailed(.init(self.document.recoveryError ?? RemoteSaveError.noRecoveryRecord))
+        }
+        guard snapshot.count <= limits.transferCap else { return .refused(.tooLarge(limit: limits.transferCap)) }
+
+        let manifest = await record.manifest
+        let expected: RemoteRecoveryManifest.StoredFile
+        if expectsReviewed {
+            guard let reviewed = manifest.reviewed else { return .failed(.init(RemoteSaveError.outcomeUnknown)) }
+            expected = reviewed
+        } else {
+            expected = manifest.baseline.file
+        }
+
+        let operation: RemoteRecoveryManifest.Operation
+        do {
+            operation = try await record.beginOperation(kind: interrupted == nil ? .replace : .inPlace, targetPath: self.document.identity.path,
+                                                        snapshot: snapshot, original: expected,
+                                                        restoreCopy: interrupted.map { $0.restoreCopy ?? $0.original },
+                                                        generation: generation, settings: settings, replacing: interrupted?.id)
+        } catch {
+            return .recoveryFailed(.init(error))
+        }
+        self.acknowledgements[operation.id] = token
+
+        let phase = Phase(record: record, operationID: operation.id, identity: self.document.identity, expected: expected, snapshot: snapshot, limits: limits)
+        let identity = phase.identity
+        var result: PhaseResult = .needsInPlace
+        if interrupted == nil {
+            result = await self.attempt(identity) { transport in
+                try await Self.replace(transport, phase)
+            }
+        }
+
+        if case .needsInPlace = result {
+            if !(await record.manifest.consentsToInPlaceSaving) {
+                guard await self.document.environment.prompts.confirmInPlaceSaving(fileName: identity.fileName, window: self.document.windowForSheet) else {
+                    try? await record.abandonOperation(id: operation.id)
+                    self.acknowledgements[operation.id] = nil
+                    return .canceled
+                }
+                do {
+                    try await record.setConsentsToInPlaceSaving(true)
+                } catch {
+                    try? await record.abandonOperation(id: operation.id)
+                    return .recoveryFailed(.init(error))
+                }
+            }
+            if interrupted == nil {
+                try? await record.changeOperation(id: operation.id, kind: .inPlace, restoreCopy: expected)
+            }
+            // The consent may have taken a while, so the check is repeated as part of writing.
+            result = await self.attempt(identity) { transport in
+                try await Self.writeInPlace(transport, phase)
+            }
+        }
+
+        return await self.finish(operation, result: result, record: record)
+    }
+
+
+    /// Writes the version from before an interrupted write in place back over the reviewed version.
+    ///
+    /// A successful restore makes that version the baseline again, but the editor's text is still unsent.
+    private func runRestore(record: RemoteRecoveryRecord, repairs interrupted: RemoteRecoveryManifest.Operation) async -> RemoteSaveOutcome {
+
+        let limits = await self.document.environment.pool.limits
+        let manifest = await record.manifest
+
+        guard let reviewed = manifest.reviewed else { return .failed(.init(RemoteSaveError.outcomeUnknown)) }
+
+        let restoreCopy = interrupted.restoreCopy ?? interrupted.original
+        let snapshot: Data
+        let operation: RemoteRecoveryManifest.Operation
+        do {
+            snapshot = try record.data(of: restoreCopy)
+            operation = try await record.beginOperation(kind: .restore, targetPath: self.document.identity.path, snapshot: snapshot,
+                                                        original: reviewed, restoreCopy: restoreCopy, generation: nil, settings: nil,
+                                                        replacing: interrupted.id)
+        } catch {
+            return .recoveryFailed(.init(error))
+        }
+
+        let phase = Phase(record: record, operationID: operation.id, identity: self.document.identity, expected: reviewed, snapshot: snapshot, limits: limits)
+        let result = await self.attempt(phase.identity) { transport in
+            try await Self.writeInPlace(transport, phase)
+        }
+
+        return await self.finish(operation, result: result, record: record)
+    }
+
+
+    /// Saves the editor's text as a new file, never replacing an existing one.
+    private func runCreate(record: RemoteRecoveryRecord, path: String) async -> RemoteSaveOutcome {
+
+        let limits = await self.document.environment.pool.limits
+        let newPath: String
+        do {
+            newPath = try RemotePath.validated(path)
+        } catch {
+            return .refused(.missingAttributes)
+        }
+
+        do {
+            try self.document.prepareForSaving(for: .saveAsOperation)
+        } catch {
+            return .lossyEncoding(.init(error))
+        }
+        let snapshot = self.document.encodedContents()
+        let settings = self.document.textSettings
+        let generation = self.document.generation
+        let token = self.document.changeCountToken(for: .saveOperation)
+
+        guard await self.document.persistLatestGeneration() else {
+            return .recoveryFailed(.init(self.document.recoveryError ?? RemoteSaveError.noRecoveryRecord))
+        }
+        guard snapshot.count <= limits.transferCap else { return .refused(.tooLarge(limit: limits.transferCap)) }
+
+        let operation: RemoteRecoveryManifest.Operation
+        do {
+            operation = try await record.beginOperation(kind: .create, targetPath: newPath, snapshot: snapshot,
+                                                        original: await record.manifest.baseline.file, generation: generation, settings: settings)
+        } catch {
+            return .recoveryFailed(.init(error))
+        }
+        self.acknowledgements[operation.id] = token
+
+        let identity = self.document.identity
+        let result = await self.attempt(identity) { transport in
+            try await Self.create(transport, record: record, operationID: operation.id, path: newPath, snapshot: snapshot, limits: limits)
+        }
+
+        return await self.finish(operation, result: result, record: record)
+    }
+
+
+    /// Runs a phase on the file's connection, turning thrown errors into a result.
+    private func attempt(_ identity: RemoteFileIdentity, _ body: @escaping @Sendable (any RemoteFileTransport) async throws -> PhaseResult) async -> PhaseResult {
+        do {
+            return try await self.document.environment.pool.withConnection(to: identity.endpoint, destination: identity.destination, body)
+        } catch is RemoteOperationCanceled {
+            // Only raised while nothing can have reached the target.
+            return .canceled
+        } catch {
+            return .thrown(error)
+        }
+    }
+
+
+    /// Records how an operation ended and acknowledges its snapshot if it reached the server.
+    private func finish(_ operation: RemoteRecoveryManifest.Operation, result: PhaseResult, record: RemoteRecoveryRecord) async -> RemoteSaveOutcome {
+
+        switch result {
+            case .committed(let attributes, let resolvedPath):
+                var newIdentity: RemoteFileIdentity?
+                if operation.kind == .create {
+                    newIdentity = self.document.identity
+                    newIdentity?.requestedPath = operation.targetPath
+                    newIdentity?.path = resolvedPath ?? operation.targetPath
+                }
+                do {
+                    try await record.completeOperation(id: operation.id, attributes: attributes, identity: newIdentity)
+                } catch {
+                    // The recorded state still says the target may have changed, so the next save or
+                    // launch checks the server and confirms the result.
+                    self.acknowledgements[operation.id] = nil
+                    return .unconfirmedLocally(.init(error))
+                }
+                if let newIdentity {
+                    self.document.adoptIdentity(newIdentity)
+                }
+                self.acknowledge(operation)
+                return .saved
+
+            case .conflict(let conflict):
+                await self.abandon(operation, record: record)
+                return .conflict(conflict)
+
+            case .refused(let refusal):
+                await self.abandon(operation, record: record)
+                return .refused(refusal)
+
+            case .notWritten(let error):
+                await self.abandon(operation, record: record)
+                return .failed(.init(error))
+
+            case .thrown(let error):
+                // The recorded state, not the kind of error, decides whether the target may have changed.
+                let current = await record.manifest.operation
+                if current?.id == operation.id, current?.mayHaveChangedTarget == true {
+                    return .unresolved(.init(error))
+                }
+                await self.abandon(operation, record: record)
+                return .failed(.init(error))
+
+            case .needsInPlace:
+                await self.abandon(operation, record: record)
+                return .failed(.init(RemoteSaveError.outcomeUnknown))
+
+            case .canceled:
+                await self.abandon(operation, record: record)
+                return .canceled
+        }
+    }
+
+
+    /// Records that an operation ended without changing the target, keeping any temporary file it left for the report.
+    ///
+    /// - Parameter retainedPath: Another path to report as left on the server, such as a new file whose creation was uncertain.
+    private func abandon(_ operation: RemoteRecoveryManifest.Operation, record: RemoteRecoveryRecord, retaining retainedPath: String? = nil) async {
+
+        self.acknowledgements[operation.id] = nil
+
+        let current = await record.manifest.operation
+        guard current?.id == operation.id else { return }
+
+        try? await record.abandonOperation(id: operation.id, retainedTemporaryPath: current?.temporaryPath ?? retainedPath)
+    }
+
+
+    /// Marks the editor as saved up to the operation's snapshot, and not beyond.
+    private func acknowledge(_ operation: RemoteRecoveryManifest.Operation) {
+
+        // A restore writes an old version, not the editor's text.
+        guard operation.kind != .restore else {
+            self.acknowledgements[operation.id] = nil
+            return
+        }
+
+        if let token = self.acknowledgements.removeValue(forKey: operation.id) {
+            self.document.updateChangeCount(withToken: token, for: .saveOperation)
+        } else {
+            // After a relaunch there is no token; the editor is saved if its text encodes to the snapshot.
+            self.document.synchronizeEditedStateWithBaseline()
+        }
+        self.document.didConfirmSave()
+    }
+
+
+    /// Checks the server's file after an operation whose outcome is unknown.
+    private func reconcile(_ operation: RemoteRecoveryManifest.Operation, record: RemoteRecoveryRecord) async -> Reconciliation {
+
+        let identity = self.document.identity
+        let limits = await self.document.environment.pool.limits
+        let isCreation = operation.kind == .create
+
+        enum Observation: Sendable {
+
+            case contents(RemoteFileContents, resolvedPath: String?)
+            case missing
+            case identityChanged(RemoteConflict)
+            case tooLarge
+        }
+
+        let observation: Observation
+        do {
+            observation = try await self.document.environment.pool.withReadingConnection(to: identity.endpoint, destination: identity.destination) { transport in
+                if !isCreation, let conflict = try await Self.checkIdentity(identity, transport) {
+                    return conflict.reason == .missing ? .missing : .identityChanged(conflict)
+                }
+                do {
+                    let contents = try await transport.readFile(at: operation.targetPath, limit: limits.transferCap)
+                    let resolvedPath = isCreation ? try await transport.realpath(operation.targetPath) : nil
+                    return .contents(contents, resolvedPath: resolvedPath)
+                } catch let error as RemoteSFTPError where error.status == .noSuchFile {
+                    return .missing
+                } catch is RemoteTransferError {
+                    return .tooLarge
+                }
+            }
+        } catch {
+            return .unresolved(error)
+        }
+
+        switch observation {
+            case .contents(let contents, let resolvedPath):
+                if contents.digest == operation.snapshot.digest {
+                    return await self.finish(operation, result: .committed(contents.attributesAfter, resolvedPath: resolvedPath), record: record) == .saved
+                        ? .committed
+                        : .unresolved(RemoteSaveError.outcomeUnknown)
+                }
+                if !isCreation, contents.digest == operation.original.digest {
+                    // The server still has the version from before, so the operation did not take effect.
+                    await self.abandon(operation, record: record)
+                    return .notApplied
+                }
+                // Even bytes that look like a partial upload may have been written by someone else. Only
+                // a write in place can have left a mixed file, so only that stays unresolved until a
+                // reviewed repair; after a replacement or a creation, the file there is simply not ours.
+                let followsInPlaceWrite = operation.kind == .inPlace || operation.kind == .restore
+                if !followsInPlaceWrite {
+                    await self.abandon(operation, record: record, retaining: isCreation ? operation.targetPath : nil)
+                }
+                return .conflict(RemoteConflict(reason: isCreation ? .destinationTaken : .unknownAfterInterruption, remoteData: contents.data,
+                                                followsInterruptedInPlaceSave: followsInPlaceWrite))
+
+            case .missing where isCreation:
+                // Nothing was created, so a new exclusive attempt may follow after the user asks for it.
+                await self.abandon(operation, record: record)
+                return .notApplied
+
+            case .missing:
+                return .unresolved(RemoteSaveError.targetMissing)
+
+            case .identityChanged, .tooLarge:
+                return .unresolved(RemoteSaveError.outcomeUnknown)
+        }
+    }
+
+
+    // MARK: Remote Phases
+
+    /// Checks that the path still resolves to the same regular file.
+    ///
+    /// - Returns: A conflict if it does not, or `nil` if it does.
+    private nonisolated static func checkIdentity(_ identity: RemoteFileIdentity, _ transport: any RemoteFileTransport) async throws -> RemoteConflict? {
+
+        do {
+            let resolvedPath = try await transport.realpath(identity.requestedPath)
+            guard RemotePath.isSame(resolvedPath, identity.path) else { return RemoteConflict(reason: .linkRetargeted) }
+
+            let attributes = try await transport.lstat(identity.path)
+            guard attributes.kind == .regular else { return RemoteConflict(reason: .typeChanged) }
+        } catch let error as RemoteSFTPError where error.status == .noSuchFile {
+            return RemoteConflict(reason: .missing)
+        }
+
+        return nil
+    }
+
+
+    /// Reads the target and checks that it is the expected version and did not change while it was read.
+    ///
+    /// - Returns: The contents, or the result that ends the phase.
+    private nonisolated static func readExpectedTarget(_ identity: RemoteFileIdentity, expected: RemoteRecoveryManifest.StoredFile, _ transport: any RemoteFileTransport, limits: RemoteLimits) async throws -> Result<RemoteFileContents, PhaseEnd> {
+        if let conflict = try await self.checkIdentity(identity, transport) { return .failure(.init(result: .conflict(conflict))) }
+
+        let contents: RemoteFileContents
+        do {
+            contents = try await transport.readFile(at: identity.path, limit: limits.transferCap)
+        } catch let error as RemoteSFTPError where error.status == .noSuchFile {
+            return .failure(.init(result: .conflict(RemoteConflict(reason: .missing))))
+        } catch RemoteTransferError.notRegularFile {
+            return .failure(.init(result: .refused(.notRegularFile)))
+        } catch RemoteTransferError.tooLarge {
+            return .failure(.init(result: .conflict(RemoteConflict(reason: .contentChanged))))
+        }
+
+        guard contents.attributesBefore.matchesForChangeDetection(contents.attributesAfter) else {
+            return .failure(.init(result: .conflict(RemoteConflict(reason: .changedWhileReading, remoteData: contents.data))))
+        }
+        guard contents.digest == expected.digest else {
+            return .failure(.init(result: .conflict(RemoteConflict(reason: .contentChanged, remoteData: contents.data))))
+        }
+
+        return .success(contents)
+    }
+
+
+    /// What a phase that writes the target works with.
+    private struct Phase: Sendable {
+
+        var record: RemoteRecoveryRecord
+        var operationID: UUID
+        var identity: RemoteFileIdentity
+
+        /// The version the server should have before anything is written.
+        var expected: RemoteRecoveryManifest.StoredFile
+        var snapshot: Data
+        var limits: RemoteLimits
+    }
+
+
+    /// A result that ends a phase early, as an error so that it can travel through `Result`.
+    private struct PhaseEnd: Error {
+
+        var result: PhaseResult
+    }
+
+
+    /// Uploads to a temporary file beside the target and renames it over the target (plan steps 3 to 10).
+    private nonisolated static func replace(_ transport: any RemoteFileTransport, _ phase: Phase) async throws -> PhaseResult {
+
+        let (record, operationID, identity, expected, snapshot, limits) = (phase.record, phase.operationID, phase.identity, phase.expected, phase.snapshot, phase.limits)
+        let control = RemoteOperationControl.current
+
+        // 3, 4. identity and baseline
+        control?.begin(.checking)
+        let current: RemoteFileContents
+        switch try await self.readExpectedTarget(identity, expected: expected, transport, limits: limits) {
+            case .success(let contents): current = contents
+            case .failure(let end): return end.result
+        }
+        let target = current.attributesAfter
+        guard !target.hasSetIDBit else { return .refused(.setIDBit) }
+        guard
+            await transport.capabilities.supportsPOSIXRename,
+            target.userID != nil, target.groupID != nil, let mode = target.mode
+        else { return .needsInPlace }
+
+        // 5. an exclusively created temporary file, recorded before it exists
+        let temporaryPath = RemotePath.appending(".\(identity.fileName).cot-\(Self.randomSuffix())", to: RemotePath.parent(of: identity.path))
+        try await record.setTemporaryPath(temporaryPath, operationID: operationID)
+
+        let handle: RemoteFileHandle
+        do {
+            handle = try await transport.open(temporaryPath, mode: .createExclusive(permissions: 0o600))
+        } catch let error as RemoteSFTPError {
+            // The server refused, so nothing was created. A folder the user cannot write leaves only rewriting in place.
+            try await record.setTemporaryPath(nil, operationID: operationID)
+            if error.status == .permissionDenied { return .needsInPlace }
+            return .notWritten(error)
+        }
+
+        do {
+            let created = try await transport.fstat(handle)
+            guard created.userID == target.userID, created.groupID == target.groupID else {
+                // A replacement would change the file's owner or group.
+                try? await transport.close(handle)
+                try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+                return .needsInPlace
+            }
+            guard mode & 0o200 != 0 else {
+                try? await transport.close(handle)
+                try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+                return .refused(.notWritable)
+            }
+
+            // 6. upload; every write status, then fsync on the open handle, then close
+            control?.begin(.uploading, totalBytes: snapshot.count)
+            do {
+                try await transport.write(snapshot, to: handle)
+                if await transport.capabilities.supportsFsync {
+                    try await transport.fsync(handle)
+                }
+            } catch where error is RemoteSFTPError || error is RemoteOperationCanceled {
+                try? await transport.close(handle)
+                throw error
+            }
+            try await transport.close(handle)
+
+            // 7. verify size, bytes and permissions
+            control?.begin(.verifying, totalBytes: snapshot.count)
+            let written = try await transport.stat(temporaryPath)
+            let readBack = try await transport.readFile(at: temporaryPath, limit: limits.transferCap)
+            guard written.size == UInt64(snapshot.count), readBack.digest == RemoteDigest.of(snapshot) else {
+                try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+                return .notWritten(RemoteSaveError.verificationFailed)
+            }
+            try await transport.setPermissions(mode, at: temporaryPath)
+            guard try await transport.stat(temporaryPath).mode == mode else {
+                try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+                return .notWritten(RemoteSaveError.verificationFailed)
+            }
+
+            // 8. check the target again, bytes included, whatever its attributes say
+            control?.begin(.checking)
+            let again: RemoteFileContents
+            switch try await self.readExpectedTarget(identity, expected: expected, transport, limits: limits) {
+                case .success(let contents): again = contents
+                case .failure(let end):
+                    try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+                    return end.result
+            }
+            guard again.attributesAfter.matchesForChangeDetection(target) else {
+                try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+                return .conflict(RemoteConflict(reason: .contentChanged, remoteData: again.data))
+            }
+
+            // The last moment to stop: from the rename on, the target may change.
+            try control?.checkCancellation()
+
+        } catch is RemoteOperationCanceled {
+            try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+            return .canceled
+        } catch where error is RemoteSFTPError || error is RemoteTransferError {
+            // The server answered, so the connection still works and the temporary file can go.
+            try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+            return .notWritten(error)
+        }
+
+        // 9. commit
+        control?.disallowCancellation()
+        control?.begin(.committing)
+        try await record.updateOperation(id: operationID, state: .committing)
+        do {
+            try await transport.rename(temporaryPath, to: identity.path)
+        } catch let error as RemoteSFTPError {
+            // The server refused the rename, so the target is unchanged.
+            try await record.updateOperation(id: operationID, state: .prepared)
+            try await self.removeTemporaryFile(temporaryPath, transport, record: record, operationID: operationID)
+            return .notWritten(error)
+        }
+        try await record.setTemporaryPath(nil, operationID: operationID)
+
+        // 10. confirm
+        let final = try await transport.stat(identity.path)
+        guard final.size == UInt64(snapshot.count), final.mode == mode else { throw RemoteSaveError.unconfirmedCommit }
+
+        return .committed(final, resolvedPath: nil)
+    }
+
+
+    /// Rewrites the target through its own handle, keeping its owner, group, mode, links and attributes.
+    private nonisolated static func writeInPlace(_ transport: any RemoteFileTransport, _ phase: Phase) async throws -> PhaseResult {
+
+        let (record, operationID, identity, expected, snapshot, limits) = (phase.record, phase.operationID, phase.identity, phase.expected, phase.snapshot, phase.limits)
+        let control = RemoteOperationControl.current
+        control?.begin(.checking)
+
+        let current: RemoteFileContents
+        switch try await self.readExpectedTarget(identity, expected: expected, transport, limits: limits) {
+            case .success(let contents): current = contents
+            case .failure(let end): return end.result
+        }
+        let target = current.attributesAfter
+        guard !target.hasSetIDBit else { return .refused(.setIDBit) }
+
+        let handle: RemoteFileHandle
+        do {
+            handle = try await transport.open(identity.path, mode: .existing)
+        } catch let error as RemoteSFTPError {
+            return error.status == .permissionDenied ? .refused(.notWritable) : .notWritten(error)
+        }
+
+        let opened: RemoteFileAttributes
+        do {
+            opened = try await transport.fstat(handle)
+        } catch let error as RemoteSFTPError {
+            try? await transport.close(handle)
+            return .notWritten(error)
+        }
+        guard opened.kind == .regular, opened.matchesForChangeDetection(target) else {
+            try? await transport.close(handle)
+            return .conflict(RemoteConflict(reason: .contentChanged))
+        }
+
+        // The last moment to stop: from here on, any failure leaves the outcome unknown, since a
+        // write may have reached the file, so the write in place is finished rather than canceled.
+        do {
+            try control?.checkCancellation()
+        } catch {
+            try? await transport.close(handle)
+            return .canceled
+        }
+        control?.disallowCancellation()
+        control?.begin(.committing, totalBytes: snapshot.count)
+        try await record.updateOperation(id: operationID, state: .writingInPlace)
+
+        try await transport.write(snapshot, to: handle)
+        if snapshot.count < current.data.count {
+            try await transport.truncate(handle, to: UInt64(snapshot.count))
+        }
+        if await transport.capabilities.supportsFsync {
+            try await transport.fsync(handle)
+        }
+        try await transport.close(handle)
+
+        let written = try await transport.stat(identity.path)
+        guard written.size == UInt64(snapshot.count) else { throw RemoteSaveError.unconfirmedCommit }
+        let readBack = try await transport.readFile(at: identity.path, limit: limits.transferCap)
+        guard readBack.digest == RemoteDigest.of(snapshot) else { throw RemoteSaveError.unconfirmedCommit }
+
+        return .committed(readBack.attributesAfter, resolvedPath: nil)
+    }
+
+
+    /// Creates a new file exclusively and writes it.
+    private nonisolated static func create(_ transport: any RemoteFileTransport, record: RemoteRecoveryRecord, operationID: UUID, path: String, snapshot: Data, limits: RemoteLimits) async throws -> PhaseResult {
+        // The last moment to stop: once the file may exist, the creation is finished rather than canceled.
+        let control = RemoteOperationControl.current
+        try control?.checkCancellation()
+        control?.disallowCancellation()
+        control?.begin(.committing, totalBytes: snapshot.count)
+        try await record.updateOperation(id: operationID, state: .creating)
+
+        let handle: RemoteFileHandle
+        do {
+            handle = try await transport.open(path, mode: .createExclusive(permissions: 0o644))
+        } catch let error as RemoteSFTPError {
+            // The server refused, so this attempt created nothing.
+            try await record.updateOperation(id: operationID, state: .prepared)
+            if (try? await transport.lstat(path)) != nil {
+                return .notWritten(RemoteSaveError.destinationExists)
+            }
+            return .notWritten(error)
+        }
+
+        try await transport.write(snapshot, to: handle)
+        if await transport.capabilities.supportsFsync {
+            try await transport.fsync(handle)
+        }
+        try await transport.close(handle)
+
+        let written = try await transport.stat(path)
+        guard written.size == UInt64(snapshot.count) else { throw RemoteSaveError.unconfirmedCommit }
+        let readBack = try await transport.readFile(at: path, limit: limits.transferCap)
+        guard readBack.digest == RemoteDigest.of(snapshot) else { throw RemoteSaveError.unconfirmedCommit }
+
+        return .committed(readBack.attributesAfter, resolvedPath: try await transport.realpath(path))
+    }
+
+
+    /// Removes a temporary file by its recorded path during an uninterrupted operation.
+    ///
+    /// If the server refuses, the path stays recorded, so that it is reported rather than forgotten.
+    private nonisolated static func removeTemporaryFile(_ path: String, _ transport: any RemoteFileTransport, record: RemoteRecoveryRecord, operationID: UUID) async throws {
+        do {
+            try await transport.remove(path)
+            try await record.setTemporaryPath(nil, operationID: operationID)
+        } catch is RemoteSFTPError {
+            return
+        }
+    }
+
+
+    private nonisolated static func randomSuffix() -> String {
+
+        (0..<6).map { _ in String(format: "%02x", UInt8.random(in: 0...255)) }.joined()
+    }
+
+
+    /// A name for a copy, such as `index copy.html` for `index.html`.
+    private static func copyName(of name: String) -> String {
+
+        let base = (name as NSString).deletingPathExtension
+        let pathExtension = (name as NSString).pathExtension
+        let copy = String(localized: "RemoteSave.copyName", defaultValue: "\(base) copy", table: "Remote",
+                          comment: "suggested name for Save As Remote (%@ is the original name without its extension)")
+
+        return pathExtension.isEmpty ? copy : copy + "." + pathExtension
+    }
+}
