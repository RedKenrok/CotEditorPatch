+            let wrote = FakeFlag()
+            await bed.server.setHook { request in
+                switch request {
+                    case .write("/srv/site/page.txt", _, _):
+                        await wrote.set()
+                        return .proceed
+                    case .fsetstat("/srv/site/page.txt", .some) where step == "truncate": return .dropAfterHandling
+                    case .fsync("/srv/site/page.txt") where step == "fsync": return .dropAfterHandling
+                    case .close("/srv/site/page.txt") where step == "close": return await wrote.isSet ? .dropAfterHandling : .proceed
+                    default: return .proceed
+                }
+            }
