+            await directory.closeTab(id: terminal.id)
+            #expect(prompts.closeRequests == [.tab(title: "Shell")])
+            #expect(directory.terminalSessions.first === terminal)
+            #expect(engine.shutDownCount == 0, "canceling never stops the process")
