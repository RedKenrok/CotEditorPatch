+/// A tree source whose listings and resolutions the test sets, and can hold until it lets them go.
+actor ScriptedTreeSource: RemoteDirectoryTreeSource {
+
+    enum Item {
+
+        case file(String)
+        case folder(String)
+        case link(String)
+        case untyped(String)
+    }
+
+
+    private var listings: [String: Result<RemoteDirectoryListing, any Error>] = [:]
+    private var batches: [String: [[RemoteDirectoryEntry]]] = [:]
+    private var resolutions: [String: Result<RemoteResolvedItem, any Error>] = [:]
+    private var gates: [String: FakeGate] = [:]
+    private(set) var requests: [String] = []
+    private(set) var pendingCount = 0
+
+
+    func set(_ path: String, _ items: [Item]) {
+
+        self.listings[path] = .success(RemoteDirectoryListing(entries: items.map(Self.entry)))
+        self.batches[path] = nil
+    }
+
+
+    /// Sets a listing that arrives in batches: each batch is told before the listing is held or returned.
+    func setBatches(_ path: String, _ batches: [[Item]]) {
+
+        self.listings[path] = .success(RemoteDirectoryListing(entries: batches.flatMap(\.self).map(Self.entry)))
+        self.batches[path] = batches.map { $0.map(Self.entry) }
+    }
+
+
+    private static func entry(_ item: Item) -> RemoteDirectoryEntry {
+
+        switch item {
+            case .file(let name): RemoteDirectoryEntry(name: name, attributes: RemoteFileAttributes(size: 0, permissions: UInt32(S_IFREG) | 0o644))
+            case .folder(let name): RemoteDirectoryEntry(name: name, attributes: RemoteFileAttributes(permissions: UInt32(S_IFDIR) | 0o755))
+            case .link(let name): RemoteDirectoryEntry(name: name, attributes: RemoteFileAttributes(permissions: UInt32(S_IFLNK) | 0o777))
+            case .untyped(let name): RemoteDirectoryEntry(name: name, attributes: RemoteFileAttributes(size: 0))
+        }
+    }
+
+
+    func fail(_ path: String, _ error: any Error) {
+
+        self.listings[path] = .failure(error)
+    }
+
+
+    func resolve(_ path: String, _ item: RemoteResolvedItem) {
+
+        self.resolutions[path] = .success(item)
+    }
+
+
+    func failResolution(_ path: String, _ error: any Error) {
+
+        self.resolutions[path] = .failure(error)
+    }
+
+
+    /// Holds the next listing of the path until the returned gate opens.
+    func hold(_ path: String) -> FakeGate {
+
+        let gate = FakeGate()
+        self.gates[path] = gate
+        return gate
+    }
+
+
+    /// Lets later listings of the path through without holding them.
+    func release(_ path: String) {
+
+        self.gates[path] = nil
+    }
+
+
+    func clearRequests() {
+
+        self.requests.removeAll()
+    }
+
+
+    func list(_ path: String, control: RemoteOperationControl, onBatch: @escaping @Sendable ([RemoteDirectoryEntry]) -> Void) async throws -> RemoteDirectoryListing {
+
+        for batch in self.batches[path] ?? [] {
+            onBatch(batch)
+        }
+
+        return try await self.list(path, control: control)
+    }
+
+
+    func list(_ path: String, control: RemoteOperationControl) async throws -> RemoteDirectoryListing {
+
+        self.requests.append("list \(path)")
+        try control.checkCancellation()
+
+        // A held reply is already on its way: canceling no longer stops it, so only the tree's own checks can drop it.
+        let result = self.listings[path]
+        if let gate = self.gates[path] {
+            self.pendingCount += 1
+            await gate.wait()
+            self.pendingCount -= 1
+        }
+
+        guard let result else { throw RemoteSFTPError(code: RemoteSFTPStatusCode.noSuchFile.rawValue, message: "", operation: .listFolder, path: path) }
+        return try result.get()
+    }
+
+
+    func resolve(_ path: String, control: RemoteOperationControl) async throws -> RemoteResolvedItem {
+
+        self.requests.append("resolve \(path)")
+        try control.checkCancellation()
+
+        guard let result = self.resolutions[path] else { throw RemoteSFTPError(code: RemoteSFTPStatusCode.noSuchFile.rawValue, message: "", operation: .resolvePath, path: path) }
+        return try result.get()
+    }
+}
