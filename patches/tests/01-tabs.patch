+    @Test(.timeLimit(.minutes(1))) func togglingPreferenceKeepsIdentitiesAndEditedFiles() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            for url in urls {
+                #expect(await directory.openDocument(at: url))
+            }
+            let members = try urls.map { try #require(self.member(at: $0, in: directory)) }
+            members[0].updateChangeCount(.changeDone)
+            let ids = directory.tabState.entries.map(\.id)
+
+            // The unedited inactive file goes; the edited one and the visible one stay owned.
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            #expect(self.member(at: urls[0], in: directory) === members[0])
+            #expect(self.member(at: urls[1], in: directory) == nil)
+            #expect(directory.activeFileDocument === members[2])
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+            #expect(directory.tabDocuments.map(ObjectIdentifier.init) == [members[0], members[2]].map(ObjectIdentifier.init))
+            #expect(directory.tabState.entries.map(\.id) == [ids[0], ids[2]])
+            #expect(directory.tabState.selectedID == ids[2])
+            #expect(directory.activeFileDocument === members[2])
+        }
