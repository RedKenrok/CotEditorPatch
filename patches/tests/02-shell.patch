+        let stored = try #require((decoded["entries"] as? [[String: Any]])?.first)
+        #expect(Set(stored.keys).isSubset(of: ["id", "kind", "title", "shell", "directory", "path"]), "no output, commands or environment are archived")
+    }
+
+
+    @Test func archiveRejectsDamagedEntries() {
+
+        let id = UUID()
+        let archive: [String: Any] = [
+            "version": DirectoryTabArchive.version,
+            "entries": [
+                ["id": id.uuidString, "kind": "terminal", "path": "/tmp", "title": "\u{1B}[31m", "shell": "relative/sh"],
+                ["id": id.uuidString, "kind": "terminal", "path": "/tmp"],
+                ["id": "not-a-uuid", "kind": "terminal", "path": "/tmp"],
+                ["id": UUID().uuidString, "kind": "terminal", "path": "relative/path"],
+                ["id": UUID().uuidString, "kind": "unknown"],
+            ],
+            "selectedID": "",
+        ]
+
+        let decoded = DirectoryTabArchive(archive: archive, legacyBookmarks: nil, currentBookmark: nil, resolve: { _ in nil })
+        let restored = TerminalTabArchive(archive: decoded, resolveBookmark: { _ in nil })
+        #expect(restored.terminals.count == 1)
+        #expect(restored.terminals.first?.id == id)
+        #expect(restored.terminals.first?.customTitle == "[31m")
+        #expect(restored.terminals.first?.shellPath == nil)
+        #expect(decoded.selectedID == nil)
+
+        let unknownVersion = DirectoryTabArchive(archive: ["version": 99, "entries": archive["entries"]!],
+                                                 legacyBookmarks: nil, currentBookmark: nil, resolve: { _ in nil })
+        #expect(TerminalTabArchive(archive: unknownVersion).terminals.isEmpty)
+    }
+}
