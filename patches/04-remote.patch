+
+import Foundation
+
+
+/// The packets of SFTP version 3, as far as editing files and browsing and changing folders need them.
+///
+/// See draft-ietf-secsh-filexfer-02 for the protocol, and OpenSSH's PROTOCOL file for the
+/// `posix-rename@openssh.com` and `fsync@openssh.com` extensions.
+enum RemoteSFTPPacketType: UInt8, Sendable {
+
+    case initialize = 1
+    case version = 2
+    case open = 3
+    case close = 4
+    case read = 5
+    case write = 6
+    case lstat = 7
+    case fstat = 8
+    case setstat = 9
+    case fsetstat = 10
+    case opendir = 11
+    case readdir = 12
+    case remove = 13
+    case mkdir = 14
+    case rmdir = 15
+    case realpath = 16
+    case stat = 17
+    case rename = 18
+    case readlink = 19
+    case status = 101
+    case handle = 102
+    case data = 103
+    case name = 104
+    case attributes = 105
+    case extended = 200
+    case extendedReply = 201
+}
+
+
+/// Flags of an SFTP `OPEN` request.
+struct RemoteOpenFlags: OptionSet, Sendable {
+
+    let rawValue: UInt32
+
+    static let read = Self(rawValue: 0x01)
+    static let write = Self(rawValue: 0x02)
+    static let append = Self(rawValue: 0x04)
+    static let create = Self(rawValue: 0x08)
+    static let truncate = Self(rawValue: 0x10)
+    static let exclusive = Self(rawValue: 0x20)
+}
+
+
+/// SFTP status codes.
+enum RemoteSFTPStatusCode: UInt32, Sendable {
+
+    case ok = 0
+    case endOfFile = 1
+    case noSuchFile = 2
+    case permissionDenied = 3
+    case failure = 4
+    case badMessage = 5
+    case noConnection = 6
+    case connectionLost = 7
+    case operationUnsupported = 8
+}
+
+
+enum RemoteSFTPExtension {
+
+    static let posixRename = "posix-rename@openssh.com"
+    static let fsync = "fsync@openssh.com"
+}
+
+
+enum RemoteSFTPRequest: Sendable {
+
+    case open(path: String, flags: RemoteOpenFlags, attributes: RemoteFileAttributes)
+    case close(handle: Data)
+    case read(handle: Data, offset: UInt64, length: UInt32)
+    case write(handle: Data, offset: UInt64, data: Data)
+    case lstat(path: String)
+    case fstat(handle: Data)
+    case stat(path: String)
+    case setstat(path: String, attributes: RemoteFileAttributes)
+    case fsetstat(handle: Data, attributes: RemoteFileAttributes)
+    case remove(path: String)
+    case realpath(path: String)
+    case readlink(path: String)
+    case posixRename(from: String, to: String)
+    case fsync(handle: Data)
+    case opendir(path: String)
+    case readdir(handle: Data)
+    case mkdir(path: String, attributes: RemoteFileAttributes)
+    case rmdir(path: String)
+    /// The plain rename, which the draft makes an error when the destination exists.
+    case rename(from: String, to: String)
+}
+
+
+enum RemoteSFTPResponse: Equatable, Sendable {
+
+    struct NameEntry: Equatable, Sendable {
+
+        /// The name as the server sent it. A folder listing can hold names that are not valid UTF-8.
+        var nameBytes: Data
+        var attributes: RemoteFileAttributes
+
+
+        /// The name, if it is valid UTF-8.
+        var name: String? {
+
+            String(validating: self.nameBytes, as: UTF8.self)
+        }
+    }
+
+
+    case status(code: UInt32, message: String)
+    case handle(Data)
+    case data(Data)
+    case name([NameEntry])
+    case attributes(RemoteFileAttributes)
+    case extendedReply(Data)
+}
+
+
+/// A violation of the protocol by the other side. The connection cannot be trusted afterwards.
+struct RemoteSFTPProtocolError: Error, Equatable, CustomStringConvertible {
+
+    var description: String
+}
+
+
+enum RemoteSFTPCodec {
+
+    static let version: UInt32 = 3
+
+
+    // MARK: Encoding
+
+    /// The `INIT` packet that opens a session.
+    static func initializationPacket() -> Data {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(Self.version)
+
+        return self.frame(type: .initialize, payload: writer.data)
+    }
+
+
+    /// The framed packet of a request.
+    static func packet(for request: RemoteSFTPRequest, id: UInt32) -> Data {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(id)
+
+        let type: RemoteSFTPPacketType
+        switch request {
+            case .open(let path, let flags, let attributes):
+                type = .open
+                writer.write(string: path)
+                writer.write(flags.rawValue)
+                writer.write(attributes)
+            case .close(let handle):
+                type = .close
+                writer.write(string: handle)
+            case .read(let handle, let offset, let length):
+                type = .read
+                writer.write(string: handle)
+                writer.write(offset)
+                writer.write(length)
+            case .write(let handle, let offset, let data):
+                type = .write
+                writer.write(string: handle)
+                writer.write(offset)
+                writer.write(string: data)
+            case .lstat(let path):
+                type = .lstat
+                writer.write(string: path)
+            case .fstat(let handle):
+                type = .fstat
+                writer.write(string: handle)
+            case .stat(let path):
+                type = .stat
+                writer.write(string: path)
+            case .setstat(let path, let attributes):
+                type = .setstat
+                writer.write(string: path)
+                writer.write(attributes)
+            case .fsetstat(let handle, let attributes):
+                type = .fsetstat
+                writer.write(string: handle)
+                writer.write(attributes)
+            case .remove(let path):
+                type = .remove
+                writer.write(string: path)
+            case .realpath(let path):
+                type = .realpath
+                writer.write(string: path)
+            case .readlink(let path):
+                type = .readlink
+                writer.write(string: path)
+            case .posixRename(let from, let to):
+                type = .extended
+                writer.write(string: RemoteSFTPExtension.posixRename)
+                writer.write(string: from)
+                writer.write(string: to)
+            case .fsync(let handle):
+                type = .extended
+                writer.write(string: RemoteSFTPExtension.fsync)
+                writer.write(string: handle)
+            case .opendir(let path):
+                type = .opendir
+                writer.write(string: path)
+            case .readdir(let handle):
+                type = .readdir
+                writer.write(string: handle)
+            case .mkdir(let path, let attributes):
+                type = .mkdir
+                writer.write(string: path)
+                writer.write(attributes)
+            case .rmdir(let path):
+                type = .rmdir
+                writer.write(string: path)
+            case .rename(let from, let to):
+                type = .rename
+                writer.write(string: from)
+                writer.write(string: to)
+        }
+
+        return self.frame(type: type, payload: writer.data)
+    }
+
+
+    /// Prefixes a payload with its length and type.
+    static func frame(type: RemoteSFTPPacketType, payload: Data) -> Data {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(UInt32(payload.count + 1))
+        writer.write(type.rawValue)
+        writer.data.append(payload)
+
+        return writer.data
+    }
+
+
+    // MARK: Decoding
+
+    /// Reads the server's `VERSION` reply.
+    ///
+    /// - Returns: The protocol version and the advertised extensions with their data.
+    static func decodeVersion(type: UInt8, payload: Data) throws(RemoteSFTPProtocolError) -> (version: UInt32, extensions: [String: Data]) {
+
+        guard type == RemoteSFTPPacketType.version.rawValue else {
+            throw RemoteSFTPProtocolError(description: "expected VERSION, got packet type \(type)")
+        }
+
+        var reader = RemoteSFTPReader(payload)
+        let version = try reader.readUInt32()
+        var extensions: [String: Data] = [:]
+        while !reader.isAtEnd {
+            let name = try reader.readUTF8String()
+            let data = try reader.readString()
+            // the first announcement of a name counts
+            if extensions[name] == nil {
+                extensions[name] = data
+            }
+        }
+
+        return (version, extensions)
+    }
+
+
+    /// Reads a response packet.
+    ///
+    /// - Returns: The request ID the response answers, and the response.
+    static func decodeResponse(type: UInt8, payload: Data) throws(RemoteSFTPProtocolError) -> (id: UInt32, response: RemoteSFTPResponse) {
+
+        guard let packetType = RemoteSFTPPacketType(rawValue: type) else {
+            throw RemoteSFTPProtocolError(description: "unknown packet type \(type)")
+        }
+
+        var reader = RemoteSFTPReader(payload)
+        let id = try reader.readUInt32()
+
+        let response: RemoteSFTPResponse
+        switch packetType {
+            case .status:
+                let code = try reader.readUInt32()
+                // Very old servers omit the message and language tag.
+                let message = reader.isAtEnd ? "" : RemoteSSHProcess.lossyString(try reader.readString())
+                if !reader.isAtEnd {
+                    _ = try reader.readString()
+                }
+                response = .status(code: code, message: message)
+            case .handle:
+                let handle = try reader.readString()
+                guard handle.count <= 256 else { throw RemoteSFTPProtocolError(description: "handle longer than 256 bytes") }
+                response = .handle(handle)
+            case .data:
+                response = .data(try reader.readString())
+            case .name:
+                let count = try reader.readUInt32()
+                // Each entry takes at least 12 bytes, so the count cannot exceed what the packet holds.
+                guard Int(count) <= reader.remainingCount / 12 else { throw RemoteSFTPProtocolError(description: "name count larger than the packet") }
+                var entries: [RemoteSFTPResponse.NameEntry] = []
+                entries.reserveCapacity(Int(count))
+                for _ in 0..<count {
+                    let name = try reader.readString()
+                    _ = try reader.readString()  // the long name, meant for display only
+                    entries.append(.init(nameBytes: name, attributes: try reader.readAttributes()))
+                }
+                response = .name(entries)
+            case .attributes:
+                response = .attributes(try reader.readAttributes())
+            case .extendedReply:
+                response = .extendedReply(reader.readRemaining())
+            default:
+                throw RemoteSFTPProtocolError(description: "unexpected packet type \(type) from the server")
+        }
+
+        guard reader.isAtEnd else {
+            throw RemoteSFTPProtocolError(description: "\(reader.remainingCount) unexpected bytes after packet type \(type)")
+        }
+
+        return (id, response)
+    }
+}
+
+
+/// Splits the byte stream from the server into packets.
+struct RemoteSFTPFramer {
+
+    let maximumPacketLength: Int
+
+    private var buffer = Data()
+
+
+    init(maximumPacketLength: Int) {
+
+        self.maximumPacketLength = maximumPacketLength
+    }
+
+
+    mutating func append(_ data: Data) {
+
+        self.buffer.append(data)
+    }
+
+
+    /// The next complete packet, or `nil` if more bytes are needed.
+    mutating func nextPacket() throws(RemoteSFTPProtocolError) -> (type: UInt8, payload: Data)? {
+
+        guard self.buffer.count >= 4 else { return nil }
+
+        let start = self.buffer.startIndex
+        let length = self.buffer[start..<start + 4].reduce(0) { $0 << 8 | Int($1) }
+
+        guard length >= 1 else { throw RemoteSFTPProtocolError(description: "empty packet") }
+        guard length <= self.maximumPacketLength else {
+            throw RemoteSFTPProtocolError(description: "packet of \(length) bytes exceeds the limit of \(self.maximumPacketLength)")
+        }
+        guard self.buffer.count >= 4 + length else { return nil }
+
+        let type = self.buffer[start + 4]
+        let payload = Data(self.buffer[start + 5..<start + 4 + length])
+        self.buffer = Data(self.buffer[(start + 4 + length)...])
+
+        return (type, payload)
+    }
+}
+
+
+struct RemoteSFTPWriter {
+
+    var data = Data()
+
+
+    mutating func write(_ value: UInt8) {
+
+        self.data.append(value)
+    }
+
+
+    mutating func write(_ value: UInt32) {
+
+        withUnsafeBytes(of: value.bigEndian) { self.data.append(contentsOf: $0) }
+    }
+
+
+    mutating func write(_ value: UInt64) {
+
+        withUnsafeBytes(of: value.bigEndian) { self.data.append(contentsOf: $0) }
+    }
+
+
+    mutating func write(string: Data) {
+
+        self.write(UInt32(string.count))
+        self.data.append(string)
+    }
+
+
+    mutating func write(string: String) {
+
+        self.write(string: Data(string.utf8))
+    }
+
+
+    mutating func write(_ attributes: RemoteFileAttributes) {
+
+        var flags: UInt32 = 0
+        if attributes.size != nil { flags |= 0x1 }
+        if attributes.userID != nil, attributes.groupID != nil { flags |= 0x2 }
+        if attributes.permissions != nil { flags |= 0x4 }
+        if attributes.accessTime != nil, attributes.modificationTime != nil { flags |= 0x8 }
+
+        self.write(flags)
+        if let size = attributes.size { self.write(size) }
+        if let userID = attributes.userID, let groupID = attributes.groupID {
+            self.write(userID)
+            self.write(groupID)
+        }
+        if let permissions = attributes.permissions { self.write(permissions) }
+        if let accessTime = attributes.accessTime, let modificationTime = attributes.modificationTime {
+            self.write(accessTime)
+            self.write(modificationTime)
+        }
+    }
+}
+
+
+struct RemoteSFTPReader {
+
+    private let data: Data
+    private var offset: Int
+
+
+    init(_ data: Data) {
+
+        self.data = data
+        self.offset = data.startIndex
+    }
+
+
+    var isAtEnd: Bool  { self.offset >= self.data.endIndex }
+
+    var remainingCount: Int  { self.data.endIndex - self.offset }
+
+
+    mutating func readUInt8() throws(RemoteSFTPProtocolError) -> UInt8 {
+
+        try self.require(1)
+        defer { self.offset += 1 }
+
+        return self.data[self.offset]
+    }
+
+
+    mutating func readUInt32() throws(RemoteSFTPProtocolError) -> UInt32 {
+
+        try self.require(4)
+        defer { self.offset += 4 }
+
+        return self.data[self.offset..<self.offset + 4].reduce(0) { $0 << 8 | UInt32($1) }
+    }
+
+
+    mutating func readUInt64() throws(RemoteSFTPProtocolError) -> UInt64 {
+
+        try self.require(8)
+        defer { self.offset += 8 }
+
+        return self.data[self.offset..<self.offset + 8].reduce(0) { $0 << 8 | UInt64($1) }
+    }
+
+
+    mutating func readString() throws(RemoteSFTPProtocolError) -> Data {
+
+        let length = Int(try self.readUInt32())
+        try self.require(length)
+        defer { self.offset += length }
+
+        return Data(self.data[self.offset..<self.offset + length])
+    }
+
+
+    /// Reads a string that must be valid UTF-8, such as a path.
+    mutating func readUTF8String() throws(RemoteSFTPProtocolError) -> String {
+
+        let data = try self.readString()
+        guard let string = String(data: data, encoding: .utf8) else {
+            throw RemoteSFTPProtocolError(description: "a name that is not valid UTF-8")
+        }
+
+        return string
+    }
+
+
+    mutating func readRemaining() -> Data {
+
+        defer { self.offset = self.data.endIndex }
+
+        return Data(self.data[self.offset...])
+    }
+
+
+    mutating func readAttributes() throws(RemoteSFTPProtocolError) -> RemoteFileAttributes {
+
+        let flags = try self.readUInt32()
+        var attributes = RemoteFileAttributes()
+        if flags & 0x1 != 0 { attributes.size = try self.readUInt64() }
+        if flags & 0x2 != 0 {
+            attributes.userID = try self.readUInt32()
+            attributes.groupID = try self.readUInt32()
+        }
+        if flags & 0x4 != 0 { attributes.permissions = try self.readUInt32() }
+        if flags & 0x8 != 0 {
+            attributes.accessTime = try self.readUInt32()
+            attributes.modificationTime = try self.readUInt32()
+        }
+        if flags & 0x8000_0000 != 0 {
+            let count = try self.readUInt32()
+            guard Int(count) <= self.remainingCount / 8 else { throw RemoteSFTPProtocolError(description: "extended attribute count larger than the packet") }
+            for _ in 0..<count {
+                _ = try self.readString()
+                _ = try self.readString()
+            }
+        }
+
+        return attributes
+    }
+
+
+    private func require(_ count: Int) throws(RemoteSFTPProtocolError) {
+
+        guard count >= 0, self.remainingCount >= count else {
+            throw RemoteSFTPProtocolError(description: "packet ends early")
+        }
+    }
+}
