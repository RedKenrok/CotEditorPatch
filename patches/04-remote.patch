+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// A host key a server offered, which is not known yet.
+struct RemoteOfferedHostKey: Equatable, Sendable {
+
+    /// The key's line for a known hosts file, with the host's name as `ssh` looks it up.
+    var knownHostsLine: String
+
+    /// The key's SHA-256 fingerprint, as `ssh-keygen -l` shows it, such as `SHA256:…`.
+    var fingerprint: String
+
+    /// The kind of key, such as `ED25519`.
+    var keyType: String
+
+    /// The host's name in the known hosts file, such as `[example.com]:2222`.
+    var hostName: String
+
+    /// The user's known hosts file, where the key goes if the user trusts it.
+    var knownHostsFile: URL
+
+    /// Whether the user's configuration hashes the names it adds.
+    var hashesName: Bool
+}
+
+
+/// Adding the key of a server that is not known yet, after the user checked its fingerprint.
+///
+/// Connections check host keys strictly, and never accept a new key on their own. For an unknown key,
+/// a connection of its own learns the key the server offers, into a temporary file, without
+/// authenticating; the user sees its fingerprint, and only if the user trusts it is that exact key
+/// added to the user's known hosts file. The connection that follows still checks strictly, so it
+/// succeeds only if the server still offers the key the user saw. A key that changed is never offered
+/// for trust: that takes the user editing the known hosts file.
+enum RemoteHostKeyTrust {
+
+    /// Learns the host key the endpoint's server offers, through the endpoint's jump hosts.
+    ///
+    /// - Throws: `RemoteConnectionError.hostKeyNotVerified` if no key could be learned, such as when a jump host's key is not known either.
+    static func offeredKey(for endpoint: RemoteEndpoint, limits: RemoteLimits, overrides: RemoteSSHCommand.TestOverrides? = nil) async throws -> RemoteOfferedHostKey {
+
+        let configuration = try await RemoteSSHProcess.evaluateConfiguration(for: endpoint, limits: limits, overrides: overrides)
+        let jumpHosts = try await RemoteSFTPTransport.jumpHosts(for: endpoint, limits: limits, overrides: overrides)
+        guard let knownHostsFile = configuration.userKnownHostsFile.flatMap(Self.expandedPath) else {
+            throw RemoteConnectionError.unreadableConfiguration
+        }
+
+        let folder = FileManager.default.temporaryDirectory.appending(path: "CotEditor-HostKey-" + UUID().uuidString, directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: folder) }
+        let learned = folder.appending(path: "known_hosts")
+
+        // The connection fails at authentication, by design; what counts is the key it wrote.
+        let result = try await Self.run(RemoteSSHCommand.executableURL,
+                                        RemoteSSHCommand.hostKeyLearningArguments(for: endpoint, through: jumpHosts, knownHostsFile: learned, overrides: overrides))
+        guard
+            let text = try? String(contentsOf: learned, encoding: .utf8),
+            let line = text.split(whereSeparator: \.isNewline).first.map(String.init),
+            let hostName = line.split(separator: " ").first.map(String.init)
+        else {
+            throw RemoteConnectionError.hostKeyNotVerified(diagnostics: RemoteSSHProcess.sanitized(String(result.errorOutput.suffix(limits.diagnosticsLength))))
+        }
+
+        // `256 SHA256:… [host]:port (ED25519)`
+        let listing = try await Self.run(URL(filePath: "/usr/bin/ssh-keygen"), ["-l", "-E", "sha256", "-f", learned.path(percentEncoded: false)])
+        let fields = listing.output.split(separator: " ")
+        guard listing.status == 0, fields.count >= 3, let keyType = fields.last?.trimmingCharacters(in: CharacterSet(charactersIn: "()\n")) else {
+            throw RemoteConnectionError.hostKeyNotVerified(diagnostics: listing.errorOutput)
+        }
+
+        return RemoteOfferedHostKey(knownHostsLine: line, fingerprint: String(fields[1]), keyType: keyType, hostName: hostName,
+                                    knownHostsFile: knownHostsFile, hashesName: configuration.hashesKnownHosts)
+    }
+
+
+    /// Adds a key the user trusts to the user's known hosts file, hashing its name if the configuration asks for that.
+    static func trust(_ key: RemoteOfferedHostKey) async throws {
+
+        var line = key.knownHostsLine
+        if key.hashesName {
+            let folder = FileManager.default.temporaryDirectory.appending(path: "CotEditor-HostKey-" + UUID().uuidString, directoryHint: .isDirectory)
+            try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+            defer { try? FileManager.default.removeItem(at: folder) }
+            let file = folder.appending(path: "known_hosts")
+            try Data((line + "\n").utf8).write(to: file)
+            let result = try await Self.run(URL(filePath: "/usr/bin/ssh-keygen"), ["-H", "-f", file.path(percentEncoded: false)])
+            guard result.status == 0, let hashed = try String(contentsOf: file, encoding: .utf8).split(whereSeparator: \.isNewline).first else {
+                throw RemoteConnectionError.hostKeyNotVerified(diagnostics: result.errorOutput)
+            }
+            line = String(hashed)
+        }
+
+        let file = key.knownHostsFile
+        try FileManager.default.createDirectory(at: file.deletingLastPathComponent(), withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        if !FileManager.default.fileExists(atPath: file.path(percentEncoded: false)) {
+            FileManager.default.createFile(atPath: file.path(percentEncoded: false), contents: nil, attributes: [.posixPermissions: 0o600])
+        }
+
+        let handle = try FileHandle(forUpdating: file)
+        defer { try? handle.close() }
+        let end = try handle.seekToEnd()
+        // A file that does not end with a line break would join the new line to its last one.
+        var prefix = ""
+        if end > 0 {
+            try handle.seek(toOffset: end - 1)
+            if try handle.read(upToCount: 1) != Data("\n".utf8) {
+                prefix = "\n"
+            }
+        }
+        try handle.write(contentsOf: Data((prefix + line + "\n").utf8))
+    }
+
+
+    /// Asks the user whether to trust the key an endpoint's server offers, and adds it if so, for the connection pool.
+    ///
+    /// - Returns: Whether the key was added, so that connecting again can succeed.
+    @MainActor static func review(_ endpoint: RemoteEndpoint, limits: RemoteLimits) async throws -> Bool {
+
+        let key = try await self.offeredKey(for: endpoint, limits: limits)
+        guard await RemoteEnvironment.current.prompts.confirmHostKey(key, host: endpoint.host, window: nil) else { return false }
+
+        try await self.trust(key)
+        return true
+    }
+
+
+    // MARK: Private Methods
+
+    /// A path of `ssh -G`'s output as a file URL: without quotes, and with `~` for the home folder.
+    private static func expandedPath(_ path: String) -> URL? {
+
+        let path = path.trimmingCharacters(in: CharacterSet(charactersIn: "\""))
+        if path.hasPrefix("~/") {
+            return FileManager.default.homeDirectoryForCurrentUser.appending(path: String(path.dropFirst(2)), directoryHint: .notDirectory)
+        }
+
+        return path.hasPrefix("/") ? URL(filePath: path, directoryHint: .notDirectory) : nil
+    }
+
+
+    private static func run(_ executable: URL, _ arguments: [String]) async throws -> (status: Int32, output: String, errorOutput: String) {
+
+        let process = Process()
+        process.executableURL = executable
+        process.arguments = arguments
+        // Learning a key asks nothing, so the process gets no askpass program.
+        process.environment = RemoteSSHCommand.environment(from: ProcessInfo.processInfo.environment, askpass: nil)
+        process.currentDirectoryURL = URL(filePath: "/", directoryHint: .isDirectory)
+        let outputPipe = Pipe()
+        let errorPipe = Pipe()
+        process.standardInput = FileHandle.nullDevice
+        process.standardOutput = outputPipe
+        process.standardError = errorPipe
+
+        let status: Int32 = try await withCheckedThrowingContinuation { continuation in
+            process.terminationHandler = { continuation.resume(returning: $0.terminationStatus) }
+            do {
+                try process.run()
+            } catch {
+                process.terminationHandler = nil
+                continuation.resume(throwing: error)
+            }
+        }
+
+        // Both outputs are short, so they are read after the process has ended.
+        let output = RemoteSSHProcess.lossyString((try? outputPipe.fileHandleForReading.readToEnd()) ?? Data())
+        let errorOutput = RemoteSSHProcess.lossyString((try? errorPipe.fileHandleForReading.readToEnd()) ?? Data())
+
+        return (status, output, errorOutput)
+    }
+}
