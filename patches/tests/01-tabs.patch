+/// A close approval that stays pending until the test answers it.
+@MainActor final class PendingApproval {
+
+    private var continuation: CheckedContinuation<Bool, Never>?
+    private(set) var requestCount = 0
+
+    var isWaiting: Bool { self.continuation != nil }
+
+
+    func wait() async -> Bool {
+
+        self.requestCount += 1
+        return await withCheckedContinuation { self.continuation = $0 }
+    }
+
+
+    func answer(_ approves: Bool) {
+
+        self.continuation?.resume(returning: approves)
+        self.continuation = nil
+    }
+}
