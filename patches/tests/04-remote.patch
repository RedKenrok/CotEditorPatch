+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Testing
+@testable import CotEditor
+
+/// Framing and decoding of SFTP packets, including what a hostile or broken server could send.
+struct RemoteSFTPCodecTests {
+
+    // MARK: Framing
+
+    @Test func packetsSplitAndJoinedAnywhereAreReassembled() throws {
+
+        let first = RemoteSFTPCodec.frame(type: .status, payload: Data([0, 0, 0, 7, 0, 0, 0, 0]))
+        let second = RemoteSFTPCodec.frame(type: .handle, payload: Data([0, 0, 0, 8, 0, 0, 0, 2, 0x41, 0x42]))
+        let stream = first + second
+
+        for split in 0...stream.count {
+            var framer = RemoteSFTPFramer(maximumPacketLength: 1024)
+            var packets: [(type: UInt8, payload: Data)] = []
+            for chunk in [stream.prefix(split), stream.dropFirst(split)] {
+                framer.append(Data(chunk))
+                while let packet = try framer.nextPacket() {
+                    packets.append(packet)
+                }
+            }
+            #expect(packets.map(\.type) == [RemoteSFTPPacketType.status.rawValue, RemoteSFTPPacketType.handle.rawValue], "split at \(split)")
+        }
+    }
+
+
+    @Test func oversizedAndEmptyPacketsAreRefused() throws {
+
+        var framer = RemoteSFTPFramer(maximumPacketLength: 16)
+        framer.append(Data([0, 0, 0, 17, 101]))
+        #expect(throws: RemoteSFTPProtocolError.self) { try framer.nextPacket() }
+
+        var empty = RemoteSFTPFramer(maximumPacketLength: 16)
+        empty.append(Data([0, 0, 0, 0]))
+        #expect(throws: RemoteSFTPProtocolError.self) { try empty.nextPacket() }
+
+        var partial = RemoteSFTPFramer(maximumPacketLength: 16)
+        partial.append(Data([0, 0, 0, 5, 101, 0]))
+        #expect(try partial.nextPacket() == nil, "an incomplete packet waits for more bytes")
+    }
+
+
+    // MARK: Requests
+
+    @Test func requestsEncodePathsLiterally() throws {
+
+        let path = "/srv/it's a \"test\" $(rm -rf) `x` * -n e\u{301}.txt"
+        let packet = RemoteSFTPCodec.packet(for: .open(path: path, flags: [.write, .create, .exclusive], attributes: RemoteFileAttributes(permissions: 0o600)), id: 9)
+
+        var framer = RemoteSFTPFramer(maximumPacketLength: 1024)
+        framer.append(packet)
+        let frame = try #require(try framer.nextPacket())
+        #expect(frame.type == RemoteSFTPPacketType.open.rawValue)
+
+        var reader = RemoteSFTPReader(frame.payload)
+        #expect(try reader.readUInt32() == 9)
+        #expect(try reader.readUTF8String() == path, "no quoting, globbing or normalization")
+        #expect(try reader.readUInt32() == 0x2A)
+        #expect(try reader.readAttributes() == RemoteFileAttributes(permissions: 0o600))
+        #expect(reader.isAtEnd)
+    }
+
+
+    @Test func extensionsUseTheirOpenSSHNames() throws {
+
+        var framer = RemoteSFTPFramer(maximumPacketLength: 1024)
+        framer.append(RemoteSFTPCodec.packet(for: .posixRename(from: "/a", to: "/b"), id: 1))
+        framer.append(RemoteSFTPCodec.packet(for: .fsync(handle: Data("h".utf8)), id: 2))
+
+        var rename = RemoteSFTPReader(try #require(try framer.nextPacket()).payload)
+        _ = try rename.readUInt32()
+        #expect(try rename.readUTF8String() == "posix-rename@openssh.com")
+        #expect(try rename.readUTF8String() == "/a")
+        #expect(try rename.readUTF8String() == "/b")
+
+        var fsync = RemoteSFTPReader(try #require(try framer.nextPacket()).payload)
+        _ = try fsync.readUInt32()
+        #expect(try fsync.readUTF8String() == "fsync@openssh.com")
+        #expect(try fsync.readString() == Data("h".utf8))
+    }
+
+
+    // MARK: Responses
+
+    @Test func versionListsExtensionsAndKeepsTheFirstAnnouncement() throws {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(UInt32(3))
+        writer.write(string: "posix-rename@openssh.com")
+        writer.write(string: "1")
+        writer.write(string: "posix-rename@openssh.com")
+        writer.write(string: "2")
+
+        let version = try RemoteSFTPCodec.decodeVersion(type: RemoteSFTPPacketType.version.rawValue, payload: writer.data)
+        #expect(version.version == 3)
+        #expect(version.extensions == ["posix-rename@openssh.com": Data("1".utf8)])
+
+        #expect(throws: RemoteSFTPProtocolError.self) {
+            try RemoteSFTPCodec.decodeVersion(type: RemoteSFTPPacketType.status.rawValue, payload: writer.data)
+        }
+    }
+
+
+    @Test func statusMayOmitItsMessage() throws {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(UInt32(4))
+        writer.write(UInt32(2))
+        let short = try RemoteSFTPCodec.decodeResponse(type: RemoteSFTPPacketType.status.rawValue, payload: writer.data)
+        #expect(short.id == 4)
+        #expect(short.response == .status(code: 2, message: ""))
+
+        writer.write(string: "No such file")
+        writer.write(string: "en")
+        let full = try RemoteSFTPCodec.decodeResponse(type: RemoteSFTPPacketType.status.rawValue, payload: writer.data)
+        #expect(full.response == .status(code: 2, message: "No such file"))
+    }
+
+
+    @Test func attributesRoundTripAndExtendedAttributesAreSkipped() throws {
+
+        let attributes = RemoteFileAttributes(size: 12, userID: 501, groupID: 20, permissions: 0o100644, accessTime: 1, modificationTime: 2)
+        var writer = RemoteSFTPWriter()
+        writer.write(UInt32(1))
+        writer.write(attributes)
+        #expect(try RemoteSFTPCodec.decodeResponse(type: RemoteSFTPPacketType.attributes.rawValue, payload: writer.data).response == .attributes(attributes))
+        #expect(attributes.kind == .regular)
+        #expect(attributes.mode == 0o644)
+
+        var extended = RemoteSFTPWriter()
+        extended.write(UInt32(1))
+        extended.write(UInt32(0x8000_0001))
+        extended.write(UInt64(5))
+        extended.write(UInt32(1))
+        extended.write(string: "name")
+        extended.write(string: "value")
+        #expect(try RemoteSFTPCodec.decodeResponse(type: RemoteSFTPPacketType.attributes.rawValue, payload: extended.data).response == .attributes(RemoteFileAttributes(size: 5)))
+    }
+
+
+    @Test func malformedResponsesAreProtocolErrors() {
+
+        func response(_ type: RemoteSFTPPacketType, _ build: (inout RemoteSFTPWriter) -> Void) -> (UInt8, Data) {
+
+            var writer = RemoteSFTPWriter()
+            writer.write(UInt32(1))
+            build(&writer)
+            return (type.rawValue, writer.data)
+        }
+
+        let cases: [(String, (UInt8, Data))] = [
+            ("truncated string", response(.data) { $0.write(UInt32(100)); $0.data.append(Data([1, 2])) }),
+            ("trailing bytes", response(.handle) { $0.write(string: "h"); $0.write(UInt8(0)) }),
+            ("huge handle", response(.handle) { $0.write(string: Data(count: 300)) }),
+            ("name count beyond the packet", response(.name) { $0.write(UInt32(1_000_000)) }),
+            ("unknown type", (250, Data([0, 0, 0, 1]))),
+            ("request type from the server", response(.open) { $0.write(string: "/x") }),
+            ("missing ID", (RemoteSFTPPacketType.status.rawValue, Data([0, 0]))),
+        ]
+
+        for (name, (type, payload)) in cases {
+            #expect(throws: RemoteSFTPProtocolError.self, "\(name)") {
+                try RemoteSFTPCodec.decodeResponse(type: type, payload: payload)
+            }
+        }
+    }
+}
