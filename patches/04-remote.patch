+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// A saved connection: a name for an endpoint, so that it can be picked instead of typed.
+///
+/// Profiles hold no credentials. Authentication is left to OpenSSH and the user's keys or agent.
+struct RemoteConnectionProfile: Codable, Identifiable, Hashable, Sendable {
+
+    var id: UUID
+    var name: String
+    var endpoint: RemoteEndpoint
+
+
+    init(id: UUID = UUID(), name: String, endpoint: RemoteEndpoint) {
+
+        self.id = id
+        self.name = name
+        self.endpoint = endpoint
+    }
+}
+
+
+/// A folder recently opened in a window, for Open Recent Remote Folder.
+struct RemoteRecentFolder: Codable, Hashable, Sendable {
+
+    /// The saved connection it was opened with, or `nil` for a typed host.
+    var profileID: UUID?
+    var endpoint: RemoteEndpoint
+
+    /// The path as the user asked for it.
+    var path: String
+
+    /// The user and host, as the folder was reached, for the menu.
+    var connectionName: String
+}
+
+
+/// Saved connections and the paths recently opened through each endpoint, kept in the user defaults.
+///
+/// Paths of files and of folders are remembered apart, since each sheet offers only its own kind.
+@MainActor final class RemoteConnectionLibrary {
+
+    static let shared = RemoteConnectionLibrary(defaults: .standard)
+
+    private static let profilesKey = "remoteConnectionProfiles"
+    private static let recentPathsKey = "remoteRecentPaths"
+    private static let recentFolderPathsKey = "remoteRecentFolderPaths"
+    private static let recentFoldersKey = "remoteRecentFolders"
+    private static let maximumRecentPaths = 10
+
+    private let defaults: UserDefaults
+
+
+    init(defaults: UserDefaults) {
+
+        self.defaults = defaults
+    }
+
+
+    /// The saved connections, sorted by name. Damaged or invalid entries are left out.
+    var profiles: [RemoteConnectionProfile] {
+
+        guard
+            let data = self.defaults.data(forKey: Self.profilesKey),
+            let profiles = try? JSONDecoder().decode([RemoteConnectionProfile].self, from: data)
+        else { return [] }
+
+        return profiles
+            .filter { (try? $0.endpoint.validated()) != nil }
+            .sorted { $0.name.localizedStandardCompare($1.name) == .orderedAscending }
+    }
+
+
+    func profile(id: UUID) -> RemoteConnectionProfile? {
+
+        self.profiles.first { $0.id == id }
+    }
+
+
+    /// Saves a connection, replacing one with the same ID.
+    func save(_ profile: RemoteConnectionProfile) {
+
+        var profiles = self.profiles.filter { $0.id != profile.id }
+        profiles.append(profile)
+        self.store(profiles)
+    }
+
+
+    func remove(id: UUID) {
+
+        self.store(self.profiles.filter { $0.id != id })
+    }
+
+
+    /// The paths recently opened through the endpoint, newest first.
+    func recentPaths(for endpoint: RemoteEndpoint) -> [String] {
+
+        let all = self.defaults.dictionary(forKey: Self.recentPathsKey) as? [String: [String]] ?? [:]
+
+        return (all[Self.key(for: endpoint)] ?? []).filter { (try? RemotePath.validated($0)) != nil }
+    }
+
+
+    /// Remembers a path opened through the endpoint.
+    func noteRecentPath(_ path: String, for endpoint: RemoteEndpoint) {
+
+        self.note(path, for: endpoint, key: Self.recentPathsKey)
+    }
+
+
+    /// The folders recently opened through the endpoint, newest first.
+    func recentFolderPaths(for endpoint: RemoteEndpoint) -> [String] {
+
+        let all = self.defaults.dictionary(forKey: Self.recentFolderPathsKey) as? [String: [String]] ?? [:]
+
+        return (all[Self.key(for: endpoint)] ?? []).filter { (try? RemotePath.validated($0)) != nil }
+    }
+
+
+    /// The folders recently opened in windows, newest first, for Open Recent Remote Folder.
+    var recentFolders: [RemoteRecentFolder] {
+
+        guard
+            let data = self.defaults.data(forKey: Self.recentFoldersKey),
+            let folders = try? JSONDecoder().decode([RemoteRecentFolder].self, from: data)
+        else { return [] }
+
+        return folders.filter { (try? $0.endpoint.validated()) == $0.endpoint && (try? RemotePath.validated($0.path)) != nil }
+    }
+
+
+    /// Remembers a folder opened in a window.
+    func noteRecentFolder(_ identity: RemoteFolderIdentity) {
+
+        self.note(identity.requestedPath, for: identity.endpoint, key: Self.recentFolderPathsKey)
+
+        let folder = RemoteRecentFolder(profileID: identity.profileID, endpoint: identity.endpoint, path: identity.requestedPath,
+                                        connectionName: identity.connectionName)
+        let folders = [folder] + self.recentFolders.filter { !($0.endpoint == folder.endpoint && RemotePath.isSame($0.path, folder.path)) }
+        guard let data = try? JSONEncoder().encode(Array(folders.prefix(Self.maximumRecentPaths))) else { return assertionFailure() }
+        self.defaults.set(data, forKey: Self.recentFoldersKey)
+    }
+
+
+    func clearRecentFolders() {
+
+        self.defaults.removeObject(forKey: Self.recentFoldersKey)
+    }
+
+
+    private func note(_ path: String, for endpoint: RemoteEndpoint, key defaultsKey: String) {
+
+        var all = self.defaults.dictionary(forKey: defaultsKey) as? [String: [String]] ?? [:]
+        let key = Self.key(for: endpoint)
+        all[key] = Array(([path] + (all[key] ?? []).filter { !RemotePath.isSame($0, path) }).prefix(Self.maximumRecentPaths))
+        self.defaults.set(all, forKey: defaultsKey)
+    }
+
+
+    private func store(_ profiles: [RemoteConnectionProfile]) {
+
+        guard let data = try? JSONEncoder().encode(profiles) else { return assertionFailure() }
+
+        self.defaults.set(data, forKey: Self.profilesKey)
+    }
+
+
+    private static func key(for endpoint: RemoteEndpoint) -> String {
+
+        [endpoint.user ?? "", endpoint.host, endpoint.port.map(String.init) ?? ""].joined(separator: "\u{1F}")
+    }
+}
