+    @Test(.timeLimit(.minutes(1))) func closingWebPagesNeverAsksAndACancelledCloseKeepsThem() async throws {
+
+        try await self.withWebPages { directory, _, server, prompts in
+            server.route("/a", .page("<title>Page A</title>"))
+            let blocker = FakeTabKind()
+            directory.tabKinds = [.webPage, blocker.kind]
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+            controller.load(server.url("/a"))
+            try await self.wait { session.title == "Page A" && !session.isLoading }
+            #expect(directory.openTabItem(FakeTabItem()))
+
+            // Another tab's review cancels the window close; every webview stays loaded.
+            blocker.approveWindow = { false }
+            #expect(await directory.canClose() == false)
+            #expect(session.lifecycle == .active)
+            #expect(controller.webView.url == server.url("/a"))
+
+            // A second webpage closes at once, without asking.
+            let other = try #require(directory.openWebPageTab())
+            #expect(await directory.closeTabItem(other))
+            #expect(other.lifecycle == .closed)
+            #expect(await directory.closeTabItem(other) == false, "a closed tab cannot close twice")
+            #expect(prompts.totalRequestCount == 0)
+
+            blocker.approveWindow = { true }
+            #expect(await directory.canClose())
+            #expect(session.lifecycle == .active, "approval alone stops nothing")
+            directory.close()
+            #expect(session.lifecycle == .closed)
+            #expect(controller.webView.navigationDelegate == nil)
+        }
+    }
