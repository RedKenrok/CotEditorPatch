+    @Test func malformedPacketsAndUnknownRepliesEndTheSession() async throws {
+
+        // a reply to a request that was never sent
+        var stray = RemoteSFTPWriter()
+        stray.write(UInt32(999))
+        stray.write(UInt32(0))
+        let unknownID = ScriptedChannel(replies: [Self.versionPacket(), RemoteSFTPCodec.frame(type: .status, payload: stray.data)])
+        let client = RemoteSFTPClient(channel: unknownID, limits: RemoteLimits())
+        try await client.start()
+        await #expect(throws: RemoteSFTPProtocolError.self) { try await client.send(.stat(path: "/")) }
+        #expect(await client.isClosed)
+
+        // a length that exceeds the limit
+        let oversized = ScriptedChannel(replies: [Self.versionPacket(), Data([0x7F, 0xFF, 0xFF, 0xFF, 101])])
+        let second = RemoteSFTPClient(channel: oversized, limits: RemoteLimits())
+        try await second.start()
+        await #expect(throws: RemoteSFTPProtocolError.self) { try await second.send(.stat(path: "/")) }
+
+        // a path that is not UTF-8, which cannot be used as a path
+        var name = RemoteSFTPWriter()
+        name.write(UInt32(1))  // the ID of the first request
+        name.write(UInt32(1))
+        name.write(string: Data([0x2F, 0xFF]))
+        name.write(string: Data())
+        name.write(RemoteFileAttributes())
+        let notUTF8 = ScriptedChannel(replies: [Self.versionPacket(), RemoteSFTPCodec.frame(type: .name, payload: name.data)])
+        let fourth = RemoteSFTPClient(channel: notUTF8, limits: RemoteLimits())
+        try await fourth.start()
+        await #expect(throws: RemoteSFTPProtocolError.self) { try await fourth.expectName(.realpath(path: "/"), operation: .resolvePath) }
+
+        // the channel ends
+        let ending = ScriptedChannel(replies: [Self.versionPacket()])
+        let third = RemoteSFTPClient(channel: ending, limits: RemoteLimits())
+        try await third.start()
+        await #expect(throws: RemoteConnectionError.connectionLost) { try await third.send(.stat(path: "/")) }
+    }
