+/// What the user asks to connect to: an SSH host alias, and optional overrides of the user and port
+/// that the alias's configuration would choose.
+///
+/// Host and user are separate fields, and no other `ssh` arguments exist, so what the user types can
+/// never become an option or a command.
+struct RemoteEndpoint: Codable, Hashable, Sendable {
+
+    var host: String
+    var user: String?
+    var port: Int?
+
+
+    /// Characters that OpenSSH expands in configuration tokens or that a shell would interpret.
+    ///
+    /// The user's configuration may use `%h` or `%r` in commands such as `Match exec`, so such
+    /// characters in a host or user name could change what those commands do.
+    private static let forbiddenCharacters = CharacterSet(charactersIn: "%$`;|&<>'\"\\")
+
+
+    /// Checks the fields and returns them trimmed of surrounding spaces.
+    ///
+    /// - Throws: `RemoteInputError` naming the first invalid field.
+    func validated() throws(RemoteInputError) -> Self {
+
+        let host = self.host.trimmingCharacters(in: .whitespaces)
+        let user = self.user?.trimmingCharacters(in: .whitespaces).nilIfEmpty
+
+        // `@` and `/` would let the destination argument carry a user name or an SSH URI.
+        guard Self.isValidName(host), !host.contains("@"), !host.contains("/") else { throw .invalidHost }
+        if let user, !Self.isValidName(user) { throw .invalidUser }
+        if let port = self.port, !(1...65535).contains(port) { throw .invalidPort }
+
+        return Self(host: host, user: user, port: self.port)
+    }
+
+
+    /// Whether a host or user name is safe to pass to `ssh`.
+    static func isValidName(_ name: String) -> Bool {
+
+        !name.isEmpty
+            && name.utf8.count <= 255
+            && !name.hasPrefix("-")
+            && name.unicodeScalars.allSatisfy { scalar in
+                !CharacterSet.whitespacesAndNewlines.contains(scalar)
+                    && !CharacterSet.controlCharacters.contains(scalar)
+                    && !Self.forbiddenCharacters.contains(scalar)
+            }
+    }
+}
+
+
+/// The connection that the user's SSH configuration makes of an endpoint, as `ssh -G` reports it.
+struct RemoteDestination: Codable, Hashable, Sendable {
+
+    var hostName: String
+    var user: String
+    var port: Int
+
+    /// The jump hosts or proxy command the connection passes through, as the configuration names them, if any.
+    var route: String?
+}
+
+
+/// Where a remote file is and how it was reached.
+///
+/// Two identities are the same file only if they name the same path through the same endpoint to
+/// the same destination. Two aliases that reach the same address stay different files, since they
+/// may differ in user, route or trust.
+struct RemoteFileIdentity: Codable, Hashable, Sendable {
+
+    /// The saved connection the file was opened with, if any.
+    var profileID: UUID?
+    var endpoint: RemoteEndpoint
+    var destination: RemoteDestination
+
+    /// The path the user asked for. It is resolved again before each save, so that a symbolic link
+    /// that now points elsewhere is noticed.
+    var requestedPath: String
+
+    /// The path as the server's `REALPATH` returned it: the file that is actually edited.
+    var path: String
+
+
+    /// The name of the file.
+    var fileName: String {
+
+        Self.fileName(of: self.path)
+    }
+
+
+    /// The last component of a remote path.
+    static func fileName(of path: String) -> String {
+
+        path.split(separator: "/", omittingEmptySubsequences: true).last.map(String.init) ?? path
+    }
+
+
+    /// The user and host, as the user knows them.
+    var connectionName: String {
+
+        "\(self.destination.user)@\(self.endpoint.host)"
+    }
+
+
+    /// The location in the form `user@host:/path`, for tooltips, the inspector and Copy Path.
+    var displayLocation: String {
+
+        "\(self.connectionName):\(self.path)"
+    }
+
+
+    static func == (lhs: Self, rhs: Self) -> Bool {
+
+        lhs.endpoint == rhs.endpoint && lhs.destination == rhs.destination && RemotePath.isSame(lhs.path, rhs.path)
+    }
+
+
+    func hash(into hasher: inout Hasher) {
+
+        hasher.combine(self.endpoint)
+        hasher.combine(self.destination)
+        hasher.combine(Array(self.path.utf8))
+    }
+}
+
+
+enum RemotePath {
+
+    /// Checks a remote path that the user typed.
+    ///
+    /// The path is kept literally: spaces, quotes, wildcards and Unicode are neither interpreted nor
+    /// normalized, since it only ever travels inside SFTP packets.
+    ///
+    /// - Throws: `RemoteInputError.invalidPath` if the path is not absolute or has control characters.
+    static func validated(_ path: String) throws(RemoteInputError) -> String {
+
+        guard
+            path.hasPrefix("/"),
+            path.utf8.count <= 4096,
+            !path.unicodeScalars.contains(where: { CharacterSet.controlCharacters.contains($0) || $0.value == 0 })
+        else { throw .invalidPath }
+
+        return path
+    }
+
+
+    /// Whether two paths name the same item on the server.
+    ///
+    /// Paths are compared byte by byte. Swift's string comparison treats composed and decomposed
+    /// characters as equal, but a server's file system generally does not: `café` written either
+    /// way can be two different files.
+    static func isSame(_ lhs: String, _ rhs: String) -> Bool {
+
+        lhs.utf8.elementsEqual(rhs.utf8)
+    }
+
+
+    /// The folder that contains the item at the path.
+    static func parent(of path: String) -> String {
+
+        guard let index = path.lastIndex(of: "/") else { return "." }
+
+        return index == path.startIndex ? "/" : String(path[..<index])
+    }
+
+
+    /// The path of an item in a folder.
+    static func appending(_ name: String, to folder: String) -> String {
+
+        folder.hasSuffix("/") ? folder + name : folder + "/" + name
+    }
+
+
+    /// A name that is safe as a local file name, derived from an untrusted remote name.
+    ///
+    /// A name with a slash, a NUL, a leading dot, or more than 255 bytes is replaced by `file` plus
+    /// its extension, if it has a usable one. The extension still lets the syntax be chosen from it.
+    static func localFileName(for remoteName: String) -> String {
+
+        let isUsable = !remoteName.isEmpty
+            && !remoteName.hasPrefix(".")
+            && !remoteName.contains("/")
+            && !remoteName.contains(":")
+            && !remoteName.unicodeScalars.contains(where: { $0.value == 0 || CharacterSet.controlCharacters.contains($0) })
+            && remoteName.utf8.count <= Int(NAME_MAX)
+
+        if isUsable { return remoteName }
+
+        let pathExtension = (remoteName as NSString).pathExtension
+        let isUsableExtension = !pathExtension.isEmpty
+            && pathExtension.utf8.count <= 32
+            && pathExtension.unicodeScalars.allSatisfy { CharacterSet.alphanumerics.contains($0) }
+
+        return isUsableExtension ? "file." + pathExtension : "file"
+    }
+}
+
+
+/// File attributes as an SFTP version 3 server reports them. Every field is optional in the protocol.
+struct RemoteFileAttributes: Codable, Hashable, Sendable {
+
+    enum Kind: Sendable {
+
+        case regular
+        case directory
+        case symbolicLink
+        case other
+        case unknown
+    }
+
+
+    var size: UInt64?
+    var userID: UInt32?
+    var groupID: UInt32?
+    var permissions: UInt32?
+    var accessTime: UInt32?
+    var modificationTime: UInt32?
+
+
+    var kind: Kind {
+
+        guard let permissions else { return .unknown }
+
+        switch permissions & UInt32(S_IFMT) {
+            case UInt32(S_IFREG): return .regular
+            case UInt32(S_IFDIR): return .directory
+            case UInt32(S_IFLNK): return .symbolicLink
+            // Some servers send the permission bits without the type.
+            case 0: return .unknown
+            default: return .other
+        }
+    }
+
+
+    /// The permission bits without the file type.
+    var mode: UInt32? {
+
+        self.permissions.map { $0 & 0o7777 }
+    }
+
+
+    /// Whether the file runs with its owner's or group's rights.
+    var hasSetIDBit: Bool {
+
+        (self.permissions ?? 0) & UInt32(S_ISUID | S_ISGID) != 0
+    }
+
+
+    /// Whether the two describe the same unchanged file, as far as the attributes tell.
+    ///
+    /// Access times are ignored, since reading the file to check it can change them. An attribute that
+    /// only one side reports counts as a difference.
+    func matchesForChangeDetection(_ other: Self) -> Bool {
+
+        self.size == other.size
+            && self.modificationTime == other.modificationTime
+            && self.userID == other.userID
+            && self.groupID == other.groupID
+            && self.permissions == other.permissions
+    }
+}
+
+
+/// A file's contents with a digest to compare versions by.
+struct RemoteFileContents: Sendable {
+
+    var data: Data
+    var digest: String
+
+    /// The attributes of the open file before and after it was read.
+    var attributesBefore: RemoteFileAttributes
+    var attributesAfter: RemoteFileAttributes
+
+
+    init(data: Data, attributesBefore: RemoteFileAttributes, attributesAfter: RemoteFileAttributes) {
+
+        self.data = data
+        self.digest = RemoteDigest.of(data)
+        self.attributesBefore = attributesBefore
+        self.attributesAfter = attributesAfter
+    }
+}
+
+
+enum RemoteDigest {
+
+    /// The SHA-256 digest of the data, in hexadecimal.
+    static func of(_ data: Data) -> String {
+
+        SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+}
+
+
+/// Sizes and times that bound remote work, collected in one place so that tests can shrink them.
+struct RemoteLimits: Sendable {
+
+    /// The most bytes a remote file may have to be read or written.
+    ///
+    /// A save reads the whole file to compare it with the version it was based on, so this is also
+    /// the size up to which that check is affordable.
+    var transferCap = 16 * 1024 * 1024
+
+    /// The size of each read and write request.
+    var chunkSize = 32 * 1024
+
+    /// How many read or write requests may be outstanding at once.
+    var requestsInFlight = 4
+
+    /// The longest packet accepted from a server. OpenSSH's own limit is 256 KiB.
+    var maximumPacketLength = 256 * 1024 + 1024
+
+    /// How long a transfer may make no progress before the connection is given up.
+    var noProgressTimeout: Duration = .seconds(30)
+
+    /// How long an unused connection stays open.
+    var idleTimeout: Duration = .seconds(120)
+
+    /// How long any single operation may take.
+    var operationTimeout: Duration = .seconds(600)
+
+    /// How many more times an operation that only reads is tried on a new connection after the connection was lost.
+    var readRetries = 2
+
+    /// How many folder listings may run at once on a browsing connection.
+    var browsingRequestsInFlight = 4
+
+    /// The most entries one folder listing reads, counting hidden ones.
+    var maximumListingEntries = 10_000
+
+    /// The most bytes of names one folder listing reads, counting hidden ones.
+    var maximumListingNameBytes = 8 * 1024 * 1024
+
+    /// The most items a folder window keeps in its tree.
+    var maximumTreeNodes = 50_000
+
+    /// The most bytes of names a folder window keeps in its tree.
+    var maximumTreeNameBytes = 32 * 1024 * 1024
+
+    /// How deep below its root a folder window's tree goes.
+    var maximumTreeDepth = 64
+
+    /// How often a visible folder window lists its expanded folders again, since SFTP cannot watch them.
+    var folderRefreshInterval: Duration = .seconds(30)
+
+    /// How long `ssh` gets to exit after its pipes close, before it is terminated.
+    var shutdownGracePeriod: Duration = .seconds(2)
+
+    /// How much of `ssh`'s diagnostic output is kept for error messages.
+    var diagnosticsLength = 4096
+}
+
+
+enum RemoteInputError: Error, Equatable {
+
+    case invalidHost
+    case invalidUser
+    case invalidPort
+    case invalidPath
+}
+
+
+extension RemoteInputError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .invalidHost:
+                String(localized: "RemoteInputError.invalidHost", defaultValue: "The host name is not valid.", table: "Remote")
+            case .invalidUser:
+                String(localized: "RemoteInputError.invalidUser", defaultValue: "The user name is not valid.", table: "Remote")
+            case .invalidPort:
+                String(localized: "RemoteInputError.invalidPort", defaultValue: "The port must be a number from 1 to 65535.", table: "Remote")
+            case .invalidPath:
+                String(localized: "RemoteInputError.invalidPath", defaultValue: "The path must be absolute, starting with “/”.", table: "Remote")
+        }
+    }
+
+
+    var recoverySuggestion: String? {
+
+        switch self {
+            case .invalidHost:
+                String(localized: "RemoteInputError.invalidHost.recoverySuggestion",
+                       defaultValue: "Enter a host name or an alias from your SSH configuration, without spaces, quotes or a user name.",
+                       table: "Remote")
+            case .invalidUser:
+                String(localized: "RemoteInputError.invalidUser.recoverySuggestion",
+                       defaultValue: "Enter the user name without spaces or quotes, or leave it empty to use the one your SSH configuration chooses.",
+                       table: "Remote")
+            case .invalidPort, .invalidPath:
+                nil
+        }
+    }
+}
+
+
+extension String {
+
+    /// The string, or `nil` if it is empty.
+    var nilIfEmpty: String? {
+
+        self.isEmpty ? nil : self
+    }
+}
