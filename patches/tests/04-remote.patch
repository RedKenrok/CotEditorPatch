@@ -0,0 +1,259 @@
+//
+//  RemoteRecoveryTests.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Testing
+import FileEncoding
+@testable import CotEditor
+
+/// The recovery record: durability, ordering of generations, crash consistency and validation.
+struct RemoteRecoveryTests {
+
+    private struct SimulatedCrash: Error { }
+
+    private let root = FileManager.default.temporaryDirectory.appending(path: "RemoteRecoveryTests-" + UUID().uuidString, directoryHint: .isDirectory)
+    private let identity = RemoteFileIdentity(profileID: nil, endpoint: .fake, destination: .fake, requestedPath: "/srv/a.txt", path: "/srv/a.txt")
+    private let settings = RemoteTextSettings(encoding: String.Encoding.utf8.rawValue, hasUTF8BOM: false, lineEnding: 0, syntaxName: "None")
+
+
+    private func makeRecord(_ id: UUID = UUID(), baseline: String = "base") throws -> RemoteRecoveryRecord {
+
+        try RemoteRecoveryRecord.create(in: self.root, documentID: id, identity: self.identity, baseline: Data(baseline.utf8), attributes: nil, isStandalone: false)
+    }
+
+
+    @Test func recordsArePrivateAndHeldByOneDocument() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let id = UUID()
+        let record = try self.makeRecord(id)
+
+        let attributes = try FileManager.default.attributesOfItem(atPath: record.directory.path(percentEncoded: false))
+        #expect(attributes[.posixPermissions] as? Int == 0o700)
+        let baseline = await record.manifest.baseline.file.name
+        #expect(try FileManager.default.attributesOfItem(atPath: record.directory.appending(path: baseline).path(percentEncoded: false))[.posixPermissions] as? Int == 0o600)
+        #expect(try FileManager.default.attributesOfItem(atPath: self.root.path(percentEncoded: false))[.posixPermissions] as? Int == 0o700)
+
+        #expect(throws: RemoteRecoveryError.inUse) { try RemoteRecoveryRecord.open(in: self.root, documentID: id) }
+        #expect(RemoteRecoveryStore.unclaimedManifests(in: self.root).isEmpty, "a held record is not offered")
+
+        await record.relinquish()
+        let reopened = try RemoteRecoveryRecord.open(in: self.root, documentID: id)
+        #expect(try reopened.data(of: reopened.initialManifest.baseline.file) == Data("base".utf8))
+        await reopened.relinquish()
+        // A process forked meanwhile by another test holds a copy of the lock until it runs its program.
+        try await waitUntil { RemoteRecoveryStore.unclaimedManifests(in: self.root).map(\.documentID) == [id] }
+    }
+
+
+    @Test func staleGenerationsNeverReplaceNewerText() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let record = try self.makeRecord()
+
+        #expect(try await record.writeText("two", settings: self.settings, generation: 2))
+        #expect(try await !record.writeText("one", settings: self.settings, generation: 1))
+        #expect(try await !record.writeText("again", settings: self.settings, generation: 2))
+        #expect(try await record.text()?.string == "two")
+        await record.relinquish()
+    }
+
+
+    @Test func completingUploadAKeepsGenerationBAcrossARestart() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let id = UUID()
+        let record = try self.makeRecord(id)
+
+        // Snapshot A starts uploading, then generation B is stored, then A completes.
+        try await record.writeText("A", settings: self.settings, generation: 1)
+        let baseline = await record.manifest.baseline.file
+        let operation = try await record.beginOperation(kind: .replace, targetPath: "/srv/a.txt", snapshot: Data("A".utf8), original: baseline,
+                                                        generation: 1, settings: self.settings)
+        try await record.updateOperation(id: operation.id, state: .committing)
+        try await record.writeText("B", settings: RemoteTextSettings(encoding: String.Encoding.utf16.rawValue, hasUTF8BOM: false, lineEnding: 2, syntaxName: "Swift"),
+                                   generation: 2)
+        try await record.completeOperation(id: operation.id, attributes: nil)
+
+        // a late completion of the same operation changes nothing
+        try await record.completeOperation(id: operation.id, attributes: RemoteFileAttributes(size: 99))
+        await record.relinquish()
+
+        // after a restart, B and its settings are unsent edits against baseline A
+        let restarted = try RemoteRecoveryRecord.open(in: self.root, documentID: id)
+        let manifest = restarted.initialManifest
+        #expect(try restarted.data(of: manifest.baseline.file) == Data("A".utf8))
+        #expect(manifest.operation == nil)
+        #expect(manifest.text?.generation == 2)
+        #expect(manifest.text?.settings.syntaxName == "Swift")
+        #expect(try RemoteRecoveryManifest.decodeText(restarted.data(of: try #require(manifest.text).file)) == "B")
+        await restarted.relinquish()
+    }
+
+
+    @Test func anUnresolvedOperationBlocksAnotherUntilApprovedRepair() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let record = try self.makeRecord()
+        let baseline = await record.manifest.baseline.file
+
+        let first = try await record.beginOperation(kind: .inPlace, targetPath: "/srv/a.txt", snapshot: Data("1".utf8), original: baseline,
+                                                    restoreCopy: baseline, generation: 1, settings: self.settings)
+        try await record.updateOperation(id: first.id, state: .writingInPlace)
+
+        await #expect(throws: RemoteRecoveryError.self) {
+            try await record.beginOperation(kind: .replace, targetPath: "/srv/a.txt", snapshot: Data("2".utf8), original: baseline, generation: 2, settings: self.settings)
+        }
+        await #expect(throws: RemoteRecoveryError.self) { try await record.adoptRemoteVersion(Data("x".utf8), attributes: nil) }
+
+        let repair = try await record.beginOperation(kind: .inPlace, targetPath: "/srv/a.txt", snapshot: Data("2".utf8), original: baseline,
+                                                     restoreCopy: first.restoreCopy, generation: 2, settings: self.settings, replacing: first.id)
+        #expect(await record.manifest.operation?.id == repair.id)
+        #expect(await record.manifest.operation?.restoreCopy == baseline, "the version to restore is kept")
+        await record.relinquish()
+    }
+
+
+    @Test func aCrashAtAnyBoundaryLeavesACompleteManifest() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+
+        let steps: [(String, @Sendable (RemoteRecoveryRecord.Step) -> Bool)] = [
+            ("after a data file", { if case .dataWritten = $0 { true } else { false } }),
+            ("after writing the manifest", { $0 == .manifestWritten }),
+            ("after replacing the manifest", { $0 == .manifestReplaced }),
+            ("before cleanup", { $0 == .cleanup }),
+        ]
+
+        for (name, matches) in steps {
+            let id = UUID()
+            let record = try self.makeRecord(id)
+            try await record.writeText("old", settings: self.settings, generation: 1)
+            await record.setFaultInjector { step in
+                if matches(step) { throw SimulatedCrash() }
+            }
+
+            await #expect(throws: SimulatedCrash.self, "\(name)") { try await record.writeText("new", settings: self.settings, generation: 2) }
+            await record.relinquish()
+
+            // What survives on disk is either the old or the new manifest, with all its data.
+            let restarted = try RemoteRecoveryRecord.open(in: self.root, documentID: id)
+            let manifest = restarted.initialManifest
+            for name in manifest.referencedFileNames {
+                let file = [manifest.baseline.file, manifest.text?.file].compactMap(\.self).first { $0.name == name }
+                if let file {
+                    #expect(throws: Never.self, "\(name) is complete") { try restarted.data(of: file) }
+                }
+            }
+            let text = try RemoteRecoveryManifest.decodeText(restarted.data(of: try #require(manifest.text).file))
+            #expect(["old", "new"].contains(text), "\(name)")
+            await restarted.relinquish()
+        }
+    }
+
+
+    @Test func unreferencedFilesAreRemovedAndReferencedOnesKept() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let record = try self.makeRecord()
+
+        try await record.writeText("1", settings: self.settings, generation: 1)
+        try await record.writeText("2", settings: self.settings, generation: 2)
+        let reviewed = try await record.storeReviewedVersion(Data("server".utf8))
+
+        let names = Set(try FileManager.default.contentsOfDirectory(atPath: record.directory.path(percentEncoded: false)))
+        let manifest = await record.manifest
+        #expect(names == manifest.referencedFileNames.union(["manifest.plist", "lock"]))
+        #expect(names.contains(reviewed.name))
+        #expect(names.filter { $0.hasPrefix("text-") }.count == 1, "the older text generation is gone")
+        await record.relinquish()
+    }
+
+
+    @Test func damagedRecordsAreRejectedAndLeftAlone() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let id = UUID()
+        let record = try self.makeRecord(id)
+        let baseline = await record.manifest.baseline.file
+        await record.relinquish()
+
+        // bytes that no longer match their digest
+        let url = record.directory.appending(path: baseline.name)
+        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: url.path(percentEncoded: false))
+        try Data("tampered".utf8).write(to: url)
+        let reopened = try RemoteRecoveryRecord.open(in: self.root, documentID: id)
+        #expect(throws: RemoteRecoveryError.self) { try reopened.data(of: baseline) }
+        await reopened.relinquish()
+
+        // a manifest that names a file outside the record
+        var manifest = reopened.initialManifest
+        manifest.baseline.file.name = "../../escape"
+        try PropertyListEncoder().encode(manifest).write(to: record.directory.appending(path: "manifest.plist"))
+        #expect(throws: RemoteRecoveryError.self) { try RemoteRecoveryRecord.open(in: self.root, documentID: id) }
+
+        // a manifest copied into another record's folder
+        let other = UUID()
+        try FileManager.default.copyItem(at: record.directory, to: self.root.appending(path: other.uuidString))
+        #expect(throws: RemoteRecoveryError.self) { try RemoteRecoveryRecord.open(in: self.root, documentID: other) }
+
+        #expect(FileManager.default.fileExists(atPath: record.directory.path(percentEncoded: false)), "nothing damaged is deleted")
+    }
+
+
+    @Test func aFullDiskKeepsThePreviousGeneration() async throws {
+
+        defer { try? FileManager.default.removeItem(at: self.root) }
+        let id = UUID()
+        let record = try self.makeRecord(id)
+        try await record.writeText("kept", settings: self.settings, generation: 1)
+
+        await record.setFaultInjector { step in
+            if case .dataWritten = step { throw RemoteRecoveryError.fileSystem(ENOSPC) }
+        }
+        await #expect(throws: RemoteRecoveryError.fileSystem(ENOSPC)) { try await record.writeText("lost", settings: self.settings, generation: 2) }
+        #expect(try await record.text()?.string == "kept")
+        await record.relinquish()
+    }
+
+
+    @Test func recoveryWritesAreDebouncedWithAMaximumDelay() {
+
+        let timing = RemoteRecoveryTiming(debounce: .seconds(1), maximumDelay: .seconds(5))
+        let start = ContinuousClock.now
+
+        #expect(timing.deadline(firstChange: start, latestChange: start) == start + .seconds(1))
+        #expect(timing.deadline(firstChange: start, latestChange: start + .milliseconds(3500)) == start + .milliseconds(4500))
+        #expect(timing.deadline(firstChange: start, latestChange: start + .seconds(4.5)) == start + .seconds(5), "continuous typing still writes every 5 seconds")
+    }
+
+
+    @Test func recoveredTextEncodesLikeTheDocument() {
+
+        let settings = RemoteTextSettings(encoding: String.Encoding.utf8.rawValue, hasUTF8BOM: true, lineEnding: 0, syntaxName: "None")
+        #expect(RemoteTextEncoding.encode("a", settings: settings) == Data([0xEF, 0xBB, 0xBF, 0x61]))
+
+        let shiftJIS = RemoteTextSettings(encoding: String.Encoding.shiftJIS.rawValue, hasUTF8BOM: false, lineEnding: 0, syntaxName: "None")
+        #expect(RemoteTextEncoding.encode("¥", settings: shiftJIS) == "¥".convertYenSign(for: .shiftJIS).data(using: .shiftJIS, allowLossyConversion: true))
+    }
+}
