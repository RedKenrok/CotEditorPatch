+/// A file dragged out of the remote sidebar: the Finder receives it as a promise, which downloads it
+/// where it is dropped, and the sidebar itself as the item's path, to move it.
+final class RemoteFilePromiseProvider: NSFilePromiseProvider {
+
+    private(set) weak var node: RemoteDirectoryNode?
+    private let path: String
+
+
+    @MainActor init(node: RemoteDirectoryNode, fileType: String, delegate: any NSFilePromiseProviderDelegate) {
+
+        self.node = node
+        self.path = node.path
+
+        super.init()
+
+        self.fileType = fileType
+        self.delegate = delegate
+    }
+
+
+    override func writableTypes(for pasteboard: NSPasteboard) -> [NSPasteboard.PasteboardType] {
+
+        super.writableTypes(for: pasteboard) + [RemoteFileBrowserViewController.itemPasteboardType]
+    }
+
+
+    override func pasteboardPropertyList(forType type: NSPasteboard.PasteboardType) -> Any? {
+
+        (type == RemoteFileBrowserViewController.itemPasteboardType) ? self.path : super.pasteboardPropertyList(forType: type)
+    }
+}
