+    @Test(.timeLimit(.minutes(1)))
+    func everyLocalShellStartsInTheFolderWithoutParsingItsName() async throws {
+
+        let base = FileManager.default.temporaryDirectory.appending(path: "RemoteTerminal-" + UUID().uuidString, directoryHint: .isDirectory)
+        defer { try? FileManager.default.removeItem(at: base) }
+        try FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+
+        // Stands in for the account's shell: it only prints where it started.
+        let printer = base.appending(path: "print-folder")
+        try Data("#!/bin/sh\nprintf 'FOLDER=%s\\n' \"$(pwd -P)\"\n".utf8).write(to: printer)
+        try FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: printer.path(percentEncoded: false))
+
+        let shells = ["/bin/sh", "/bin/bash", "/bin/zsh", "/bin/dash", "/bin/ksh", "/bin/csh", "/bin/tcsh"].filter(FileManager.default.isExecutableFile(atPath:))
+        #expect(shells.count >= 5)
+
+        for (index, name) in Self.hostileNames.enumerated() {
+            // Each name in a folder of its own, since APFS cannot hold both forms of “café” side by side.
+            let folder = base.appending(path: "\(index)", directoryHint: .isDirectory).appending(path: name, directoryHint: .isDirectory)
+            try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+            let path = try Self.realPath(folder)
+
+            for shell in shells {
