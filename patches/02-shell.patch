index 000000000..8053ea3ed
--- /dev/null
+++ b/CotEditor/Sources/Terminal/TerminalNotifications.swift
@@ -0,0 +1,249 @@
+//
+//  TerminalNotifications.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
