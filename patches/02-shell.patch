+
+// MARK: - Tab Contract
+
+extension TerminalSession: DirectoryTabItem {
+
+    var tabKind: String  { TerminalTabArchive.kind }
+
+    var tabTitle: String  { self.title }
+
+    var tabIcon: NSImage?  { NSImage(systemSymbolName: "apple.terminal", accessibilityDescription: nil) }
+
+    /// The tooltip names the starting folder only; the shell may have moved elsewhere since.
+    var tabToolTip: String {
+
+        if let launcher = self.launcher {
+            return String(localized: "TerminalTab.tooltip.elsewhere", defaultValue: "Shell started in \(launcher.location)", table: "Terminal",
+                          comment: "tooltip of a terminal tab that runs elsewhere, such as on a server (%@ is a location such as user@host:/path)")
+        }
+
+        return String(localized: "TerminalTab.tooltip", defaultValue: "Shell started in \(self.startingDirectory.path(percentEncoded: false))",
+               table: "Terminal",
+               comment: "tooltip and accessibility hint of a terminal tab; it names the starting folder, not the shell’s current folder (%@ is a path)")
+    }
+
+
+    func makeTabViewController(in directory: DirectoryDocument) -> any DirectoryTabViewController {
+
+        TerminalTabViewController(session: self, directoryDocument: directory)
+    }
+
+
+    /// Makes the tab close by itself when its shell exits, as after typing `exit`.
+    ///
+    /// Nothing runs any more, so no confirmation is needed. The tab closes on the next turn of the main
+    /// queue rather than inside the exit callback, which the terminal view is still executing. By then
+    /// the tab may already be gone, for example after a close the user confirmed meanwhile.
+    func didJoin(_ directory: DirectoryDocument) {
+
+        self.onExit = { [weak directory, weak self] in
+            Task { @MainActor in
+                guard
+                    let directory, let self,
+                    case .exited = self.lifecycle,
+                    !self.keepsTabAfterExit,
+                    directory.tabState.entry(for: self) != nil
+                else { return }
+
+                directory.removeTabItem(self)
+            }
+        }
+        self.onNotification = { [weak directory, weak self] notification in
+            guard let directory, let self, directory.tabState.entry(for: self) != nil else { return }
+
+            directory.postTerminalNotification(notification, from: self)
+        }
+    }
+
+
+    func approveTabClose(in directory: DirectoryDocument) async -> Bool {
+
+        // Whether it is still running once the user answers does not matter: the user agreed to stop it.
+        guard self.isLive else { return true }
+
+        return await TerminalPrompts.current.confirmClosing(.tab(title: self.title), window: directory.windowForSheet)
+    }
+
+
+    func tearDown() {
+
+        self.close()
+    }
+
+
+    func archivedFields() -> [String: Any]? {
+
+        // Only the launcher knows how to start its terminals again.
+        guard self.launcher == nil else { return nil }
+
+        return TerminalTabArchive.tab(for: self, id: self.id).fields
+    }
+
+
+    func tabContextMenuItems(in directory: DirectoryDocument) -> [DirectoryTabBar.MenuItem] {
+
+        directory.terminalContextMenuItems(for: self)
+    }
+}
+
+
+extension DirectoryTabKind {
+
+    /// Terminal tabs.
+    ///
+    /// Restored terminals are placeholders that the user starts explicitly. No shell starts during
+    /// restoration: a process that ran before the app quit is gone, and silently starting another one,
+    /// possibly running startup files, is not what the user asked for.
+    static let terminal = DirectoryTabKind(
+        archiveKind: TerminalTabArchive.kind,
+        approveClosingWindow: { _, directory in await directory.confirmClosingLiveTerminals(reason: .window) },
+        restore: { entries, directory in
+            TerminalTabArchive(entries: entries).terminals.reduce(into: [TerminalSession]()) { sessions, entry in
+                sessions.append(TerminalSession(id: entry.id, defaultTitle: directory.nextTerminalTitle(besides: sessions),
+                                                customTitle: entry.customTitle, startingDirectory: entry.startingDirectory,
+                                                shellPath: entry.shellPath))
+            }
+        },
+        addMenuItems: { $0.newTerminalMenuItems })
+}
+
+
+extension DirectoryTabState.Entry {
+
+    var terminalSession: TerminalSession? {
+
+        self.item as? TerminalSession
+    }
+}
