+
+/// A remote folder window: the folder's identity, its tree, its connection state and its record for
+/// restoring the window. It is the root of the window's `DirectoryDocument`.
+///
+/// The identity is fixed for the window's life. Reconnecting and refreshing check that the connection
+/// and the folder's path still lead to the same place; if they lead elsewhere, the window goes
+/// offline and offers to open the other place in a window of its own, and never changes what it shows.
+///
+/// Files open through `RemoteOpenCoordinator` like any remote file and follow its rules; the tree
+/// never reloads an editor, clears its edited state, or moves its save baseline.
+@MainActor @Observable final class RemoteFolderSession: DirectoryRoot {
+
+    /// How the window's listing relates to the server.
+    enum Status: Equatable {
+
+        /// The listing follows the server.
+        case online
+        /// Checking the connection and the folder.
+        case connecting
+        /// Nothing is listed. The reason is given if the connection failed; a restored window has none.
+        case offline(message: String?)
+        /// The folder's path no longer leads to a folder.
+        case unavailable(message: String)
+        /// The folder's path or the connection now leads to another folder, shown here.
+        case changedLocation(RemoteFolderIdentity)
+    }
+
+
+    let windowID: UUID
+    let identity: RemoteFolderIdentity
+    @ObservationIgnored let environment: RemoteEnvironment
+    @ObservationIgnored let tree: RemoteDirectoryTree
+
+    private(set) var status: Status
+    var showsHiddenFiles = false  { didSet { self.scheduleArchive() } }
+
+    /// The files whose opening is under way, by the bytes of their path.
+    private(set) var pendingOpens: Set<[UInt8]> = []
+
+    /// The items being created, renamed, moved or deleted, by the bytes of their path.
+    @ObservationIgnored private(set) var changingItems: Set<[UInt8]> = []
+
+    @ObservationIgnored private(set) weak var directory: DirectoryDocument?
+
+    /// Called with each change of the tree, for the sidebar.
+    @ObservationIgnored var onTreeChange: (RemoteDirectoryTree.Change) -> Void = { _ in }
+
+    /// Called when the pending opens or changes change, for the sidebar's rows.
+    @ObservationIgnored var onPendingOpensChange: () -> Void = { }
+
+    /// Called to start editing the name of an item the window created, for the sidebar.
+    @ObservationIgnored var onBeginRenaming: (RemoteDirectoryNode) -> Void = { _ in }
+
+    @ObservationIgnored private var openTasks: [[UInt8]: (task: Task<Void, Never>, control: RemoteOperationControl)] = [:]
+    @ObservationIgnored private var latestActivation: [UInt8]?
+    @ObservationIgnored private var connectionTask: Task<Void, Never>?
+    @ObservationIgnored private var autoRefreshTask: Task<Void, Never>?
+    @ObservationIgnored private var archiveDebounceTask: Task<Void, Never>?
+    @ObservationIgnored private var lastTabs: Data?
+
+    /// The window's frame as of the latest record, for a record written after the window has gone.
+    @ObservationIgnored private var lastFrame: String?
+    @ObservationIgnored private var windowObservers: [any NSObjectProtocol] = []
+    @ObservationIgnored private var isClosed = false
+
+
+    // MARK: Lifecycle
+
+    /// Creates the session of a newly opened folder, which is online.
+    init(identity: RemoteFolderIdentity, environment: RemoteEnvironment, windowID: UUID = UUID()) {
+
+        self.windowID = windowID
+        self.identity = identity
+        self.environment = environment
+        self.status = .online
+        self.tree = RemoteDirectoryTree(rootPath: identity.path,
+                                        source: RemotePoolTreeSource(pool: environment.pool, endpoint: identity.endpoint, destination: identity.destination),
+                                        limits: RemoteLimits())
+
+        self.tree.onChange = { [weak self] change in
+            self?.treeDidChange(change)
+        }
+        self.tree.onConnectionFailure = { [weak self] error in
+            self?.goOffline(because: error)
+        }
+        Task { [weak self] in
+            // The pool's limits may be smaller, as in tests.
+            guard let self else { return }
+            self.tree.limits = await environment.pool.limits
+        }
+        self.startAutoRefresh()
+    }
+
+
+    /// Recreates a window's session from its record, offline: nothing is fetched until the user reconnects.
+    convenience init(restoring archive: RemoteFolderArchive, environment: RemoteEnvironment) {
+
+        self.init(identity: archive.identity, environment: environment, windowID: archive.windowID)
+
+        self.status = .offline(message: nil)
+        self.tree.isOffline = true
+        self.showsHiddenFiles = archive.showsHiddenFiles
+        self.lastTabs = archive.tabs
+        self.lastFrame = archive.windowFrame
+        if let snapshot = archive.snapshot {
+            self.tree.restore(snapshot)
+        }
+    }
+
+
+    /// Creates the window's directory document and shows its window.
+    ///
+    /// - Parameters:
+    ///   - frame: The window's frame, as `NSWindow.frameDescriptor` gives it, to restore it.
+    ///   - tabs: The archived tabs to restore.
+    func openWindow(frame: String? = nil, tabs: [String: Any]? = nil) {
+
+        let directory = DirectoryDocument(root: self)
+        self.directory = directory
+        NSDocumentController.shared.addDocument(directory)
+        directory.makeWindowControllers()
+
+        if let window = directory.windowController?.window {
+            if let frame {
+                window.setFrame(from: frame)
+            }
+            self.observe(window)
+        }
+        if let tabs {
+            directory.restoreTabs(fromArchive: tabs)
+        }
+        directory.showWindows()
+        self.scheduleArchive()
+    }
+
+
+    /// Brings the window forward.
+    func showWindow() {
+
+        self.directory?.windowController?.showWindow(nil)
+    }
+
+
+    /// Lists the root folder of a newly opened window.
+    func start() {
+
+        self.tree.refresh()
+    }
+
+
+    // MARK: Connection
+
+    /// Lists the root and the expanded folders again, after checking that the folder is still where it was.
+    func refresh() {
+
+        switch self.status {
+            case .online:
+                self.checkLocation(thenRefresh: true)
+            case .connecting:
+                break
+            case .offline, .unavailable, .changedLocation:
+                self.reconnect()
+        }
+    }
+
+
+    /// Connects again: checks the folder's identity, then lists the root and the expanded folders.
+    ///
+    /// It uploads nothing and reloads no editor.
+    func reconnect() {
+
+        guard self.status != .connecting, !self.isClosed else { return }
+
+        // Nothing from before may arrive while the identity is checked.
+        self.tree.invalidate()
+        self.status = .connecting
+        self.checkLocation(thenRefresh: true)
+    }
+
+
+    /// Opens the folder the window's path or connection now leads to, in a window of its own.
+    ///
+    /// The folder is resolved again first. If it moved once more meanwhile, the new place is shown for
+    /// review instead, and nothing opens.
+    func openChangedLocation() {
+
+        guard case .changedLocation(let candidate) = self.status else { return }
+
+        let environment = self.environment
+        self.connectionTask?.cancel()
+        self.connectionTask = Task {
+            do {
+                let current = try await RemoteFolderOpenCoordinator.resolve(candidate.request, environment: environment)
+                guard !Task.isCancelled else { return }
+                guard current == candidate, current.destination == candidate.destination else {
+                    self.status = .changedLocation(current)
+                    return
+                }
+                RemoteFolderOpenCoordinator.open(current, environment: environment)
+            } catch is CancellationError {
+                return
+            } catch {
+                self.directory?.presentErrorAsSheet(error)
+            }
+        }
+    }
+
+
+    /// Leaves the window offline, showing what it showed, after the user declined to open a changed location.
+    func dismissChangedLocation() {
+
+        guard case .changedLocation = self.status else { return }
+
+        self.status = .offline(message: String(localized: "RemoteFolder.status.changedLocationDismissed",
+                                               defaultValue: "The folder now leads elsewhere. This window stays offline.", table: "Remote"))
+    }
+
+
+    // MARK: Files
+
+    /// Opens a file of the tree in a tab, or selects it where it is already open.
+    ///
+    /// Only the file activated last takes the selection; an earlier open that finishes later joins the
+    /// tabs without being selected. Activating a file whose open is under way waits for that open.
+    func activate(_ node: RemoteDirectoryNode) {
+
+        // An item being renamed, moved or deleted may no longer be at its path.
+        guard let directory, !self.isClosed, !self.isChanging(node) else { return }
+
+        switch (node.kind, node.resolution) {
+            case (.directory, _), (_, .directory):
+                return self.tree.expand(node)
+            case (.unknown, .unresolved), (.symbolicLink, .unresolved), (.unknown, .failed), (.symbolicLink, .failed):
+                // What the entry is decides whether it expands or opens.
+                return self.tree.resolve(node, thenLoad: true) { [weak self] node in
+                    if node.isFolder {
+                        self?.tree.expand(node)
+                    } else if !node.isUnresolved {
+                        self?.activate(node)
+                    }
+                }
+            case (.other, _), (_, .other):
+                return directory.presentErrorAsSheet(RemoteTransferError.notRegularFile)
+            case (_, .outsideRoot(let target)):
+                return self.openFolderInNewWindow(path: target)
+            case (_, .loop), (_, .resolving):
+                return
+            default:
+                break
+        }
+
+        let key = Array(node.path.utf8)
+        self.latestActivation = key
+
+        if let document = self.openDocument(at: node) {
+            return self.show(document, in: directory)
+        }
+        guard self.openTasks[key] == nil else { return }
+
+        if case .offline = self.status {
+            return self.offerReconnect(toOpen: node)
+        }
+
+        let request = RemoteOpenRequest(profileID: self.identity.profileID, endpoint: self.identity.endpoint, path: node.path)
+        let environment = self.environment
+        let control = RemoteOperationControl()
+        let task = Task { [weak self, weak directory] in
+            defer {
+                self?.openTasks[key] = nil
+                self?.pendingOpens.remove(key)
+                self?.onPendingOpensChange()
+            }
+            do {
+                let document = try await RemoteOperationControl.$current.withValue(control) {
+                    try await RemoteOpenCoordinator.open(request, in: directory, window: directory?.windowForSheet,
+                                                         environment: environment, attach: false, asMember: true)
+                }
+                guard let self, let directory, !self.isClosed else { return }
+                self.show(document, in: directory, selects: self.latestActivation == key)
+            } catch is CancellationError, is RemoteOperationCanceled {
+                return
+            } catch {
+                guard let directory, self?.latestActivation == key else { return }
+                directory.presentErrorAsSheet(error)
+            }
+        }
+        self.openTasks[key] = (task, control)
+        self.pendingOpens.insert(key)
+        self.onPendingOpensChange()
+    }
+
+
+    /// Stops opening a file, if its open is under way and has not reached the point of no return.
+    func cancelOpening(_ node: RemoteDirectoryNode) {
+
+        self.openTasks[Array(node.path.utf8)]?.control.requestCancel()
+    }
+
+
+    /// Whether the file is being opened.
+    func isOpening(_ node: RemoteDirectoryNode) -> Bool {
+
+        self.pendingOpens.contains(Array(node.path.utf8))
+    }
+
+
+    /// The open document of the node's file, if its path is known to lead to one.
+    func openDocument(at node: RemoteDirectoryNode) -> RemoteDocument? {
+
+        let identity = RemoteFileIdentity(profileID: self.identity.profileID, endpoint: self.identity.endpoint, destination: self.identity.destination,
+                                          requestedPath: node.path, path: node.canonicalPath)
+
+        return RemoteDocumentRegistry.shared.document(for: identity)
+    }
+
+
+    /// Opens a folder of the tree, or a path, as the root of a window of its own.
+    func openFolderInNewWindow(path: String) {
+
+        let request = RemoteFolderRequest(profileID: self.identity.profileID, endpoint: self.identity.endpoint, path: path)
+        let environment = self.environment
+        Task {
+            do {
+                try await RemoteFolderOpenCoordinator.open(request, environment: environment)
+            } catch is CancellationError {
+                return
+            } catch {
+                self.directory?.presentErrorAsSheet(error)
+            }
+        }
+    }
+
+
+    /// Copies the location of an item, or of the folder, in the form `user@host:/path`.
+    func copyLocation(of node: RemoteDirectoryNode?) {
+
+        let path = node?.path ?? self.identity.path
+
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString("\(self.identity.connectionName):\(path)", forType: .string)
+    }
+
+
+    // MARK: Changing Items
+
+    /// Creates an empty file or folder in a folder of the tree, numbering its name if it is taken, and
+    /// shows it in the tree.
+    ///
+    /// - Returns: The new item's node, such as for the sidebar to start editing its name.
+    @discardableResult func createItem(_ kind: RemoteFolderChanges.Kind, in folder: RemoteDirectoryNode) async throws -> RemoteDirectoryNode? {
+
+        try self.checkOnline()
+
+        let name = (kind == .file) ? Self.newFileName : String(localized: "untitled folder", comment: "default folder name for new creation")
+        let title = (kind == .file)
+            ? String(localized: "RemoteProgress.creatingFile", defaultValue: "Creating a file…", table: "Remote")
+            : String(localized: "RemoteProgress.creatingFolder", defaultValue: "Creating a folder…", table: "Remote")
+        let folderPath = folder.path
+
+        let entry: RemoteDirectoryEntry
+        do {
+            entry = try await self.performChange(title: title) { transport in
+                try await RemoteFolderChanges.create(kind, named: name, in: folderPath, with: transport)
+            }
+        } catch {
+            self.tree.relist(folder)
+            throw error
+        }
+        guard !self.isClosed else { return nil }
+
+        let node = self.tree.insert(entry, into: folder)
+        if folder !== self.tree.root {
+            self.tree.expand(folder)
+        }
+        self.tree.relist(folder)
+
+        return node
+    }
+
+
+    /// Renames an item of the tree, refusing a name that is taken. Open files in or below it follow.
+    func rename(_ node: RemoteDirectoryNode, to name: String) async throws {
+
+        guard let parent = node.parent, !RemotePath.isSame(name, node.name) else { return }
+        guard RemotePath.isValidComponent(name) else { throw RemoteItemChangeError.invalidName(name) }
+
+        let title = String(localized: "RemoteProgress.renaming", defaultValue: "Renaming “\(node.name)”…", table: "Remote", comment: "%@ is a file name")
+        try await self.relocate(node, into: parent, title: title) { source, transport in
+            let destination = RemotePath.appending(name, to: RemotePath.parent(of: source))
+            try await RemoteFolderChanges.rename(source, to: destination, with: transport)
+            return name
+        }
+    }
+
+
+    /// Moves an item of the tree into another folder of it, numbering its name if it is taken there.
+    /// Open files in or below it follow.
+    func move(_ node: RemoteDirectoryNode, into folder: RemoteDirectoryNode) async throws {
+
+        guard
+            node.parent != nil, node.parent !== folder,
+            folder === self.tree.root || folder.isFolder,
+            folder !== node, !folder.isDescendant(of: node)
+        else { return }
+
+        let folderPath = folder.path
+        let title = String(localized: "RemoteProgress.moving", defaultValue: "Moving “\(node.name)”…", table: "Remote", comment: "%@ is a file name")
+        try await self.relocate(node, into: folder, title: title) { source, transport in
+            try await RemoteFolderChanges.move(source, into: folderPath, with: transport)
+        }
+    }
+
+
+    /// Deletes an item of the tree from the server, and a folder with everything in it, then closes the
+    /// open files that were deleted.
+    func delete(_ node: RemoteDirectoryNode) async throws {
+
+        guard let parent = node.parent else { return }
+
+        try self.checkOnline()
+
+        let path = node.path
+        let limits = await self.environment.pool.limits
+        let title = String(localized: "RemoteProgress.deleting", defaultValue: "Deleting “\(node.name)”…", table: "Remote", comment: "%@ is a file name")
+
+        do {
+            try await self.whileChanging(node) { documents in
+                _ = try await self.performChange(title: title) { transport in
+                    try await RemoteFolderChanges.delete(path, limits: limits, with: transport)
+                }
+                // A document edited meanwhile keeps its edits; saving it then finds the file gone.
+                for document in documents where !document.hasUnsentChanges {
+                    if let directory = document.directoryDocument {
+                        directory.closeMemberWithoutReview(document)
+                    } else {
+                        document.close()
+                    }
+                }
+            }
+        } catch {
+            self.tree.relist(parent)
+            throw error
+        }
+
+        self.tree.remove(node)
+        self.tree.relist(parent)
+    }
+
+
+    /// Uploads files and folders from this Mac into a folder of the tree, numbering names that are taken
+    /// there, and shows them in the tree.
+    ///
+    /// - Throws: `RemoteItemChangeError.notUploaded` naming the dropped items that were left out, after
+    ///   uploading the others.
+    func upload(_ urls: [URL], into folder: RemoteDirectoryNode) async throws {
+
+        try self.checkOnline()
+
+        let key = Array(folder.path.utf8)
+        guard !self.changingPaths.contains(where: { RemotePath.isAncestor($0, of: folder.path) || RemotePath.isAncestor(folder.path, of: $0) }) else {
+            throw RemoteItemChangeError.changeUnderWay(folder.name)
+        }
+        self.changingItems.insert(key)
+        self.onPendingOpensChange()
+        defer {
+            self.changingItems.remove(key)
+            self.onPendingOpensChange()
+        }
+
+        let transferCap = await self.environment.pool.limits.transferCap
+        let (items, skipped) = await Task.detached { RemoteUploadItem.scan(urls, transferCap: transferCap) }.value
+        let folderPath = folder.path
+        let title = String(localized: "RemoteProgress.uploading", defaultValue: "Uploading to “\(folder.name)”…", table: "Remote", comment: "%@ is a folder name")
+
+        let entries: [RemoteDirectoryEntry]
+        do {
+            entries = try await self.performChange(title: title) { transport in
+                var entries: [RemoteDirectoryEntry] = []
+                for item in items {
+                    entries.append(try await RemoteFolderChanges.upload(item, into: folderPath, with: transport))
+                }
+                return entries
+            }
+        } catch {
+            self.tree.relist(folder)
+            throw error
+        }
+
+        for entry in entries {
+            self.tree.insert(entry, into: folder)
+        }
+        if folder !== self.tree.root {
+            self.tree.expand(folder)
+        }
+        self.tree.relist(folder)
+
+        if !skipped.isEmpty {
+            throw RemoteItemChangeError.notUploaded(skipped)
+        }
+    }
+
+
+    /// Downloads a file of the tree, such as to save a copy on this Mac.
+    func download(_ node: RemoteDirectoryNode) async throws -> Data {
+
+        try self.checkOnline()
+
+        let identity = self.identity
+        let pool = self.environment.pool
+        let path = node.path
+        let limit = await pool.limits.transferCap
+
+        return try await pool.withReadingConnection(to: identity.endpoint, destination: identity.destination) { transport in
+            try await transport.readFile(at: path, limit: limit).data
+        }
+    }
+
+
+    /// Whether the item itself is being changed, such as renamed or uploaded to, for its row's spinner.
+    func isBeingChanged(_ node: RemoteDirectoryNode) -> Bool {
+
+        self.changingItems.contains(Array(node.path.utf8))
+    }
+
+
+    /// Whether the item or one above it is being changed.
+    func isChanging(_ node: RemoteDirectoryNode) -> Bool {
+
+        self.changingPaths.contains { RemotePath.isAncestor($0, of: node.path) }
+    }
+
+
+    var canCreateFiles: Bool  { true }
+
+
+    /// Creates an empty file in the folder of the selected tab's file, or in the root, opens it in a tab,
+    /// and lets the sidebar start editing its name.
+    func createFileInNewTab(in directory: DirectoryDocument) async {
+
+        var folder = self.tree.root
+        if let document = directory.activeFileDocument as? RemoteDocument,
+           let components = RemotePath.relativePath(of: RemotePath.parent(of: document.identity.requestedPath), in: self.identity.path),
+           let node = self.tree.node(atRelativePath: components), node.isFolder
+        {
+            folder = node
+        }
+
+        do {
+            guard let node = try await self.createItem(.file, in: folder) else { return }
+            self.activate(node)
+            self.onBeginRenaming(node)
+        } catch {
+            directory.presentErrorAsSheet(error)
+        }
+    }
+
+
+    // MARK: Directory Root
+
+    var displayName: String {
+
+        self.identity.name
+    }
+
+
+    var subtitle: String {
+
+        self.identity.displayLocation
+    }
+
+
+    func makeSidebarViewController(for directory: DirectoryDocument) -> NSViewController {
+
+        RemoteFileBrowserViewController(session: self)
+    }
+
+
+    func makeSidebarAccessoryViewController(for directory: DirectoryDocument) -> NSSplitViewItemAccessoryViewController? {
+
+        RemoteFileBrowserViewController.makeHeaderAccessory(session: self)
+    }
+
+
+    func directoryDidChangeState(_ directory: DirectoryDocument) {
+
+        self.scheduleArchive()
+    }
+
+
+    func directoryDidClose(_ directory: DirectoryDocument) {
+
+        guard !self.isClosed else { return }
+        self.isClosed = true
+
+        self.connectionTask?.cancel()
+        self.autoRefreshTask?.cancel()
+        for (_, open) in self.openTasks {
+            open.control.requestCancel()
+            open.task.cancel()
+        }
+        self.openTasks.removeAll()
+        self.tree.invalidate()
+        self.windowObservers.forEach(NotificationCenter.default.removeObserver)
+        self.windowObservers.removeAll()
+        RemoteFolderOpenCoordinator.unregister(self)
+
+        self.archiveDebounceTask?.cancel()
+        let root = self.environment.folderArchiveRoot
+        if RemoteTermination.isInProgress {
+            // The window comes back at the next launch, so its record must be complete before the app exits.
+            do {
+                try RemoteFolderArchiveStore.writeNow(self.makeArchive(frame: nil), in: root)
+            } catch {
+                Logger.app.error("Failed to keep a remote folder window for restoration: \(error)")
+            }
+        } else {
+            RemoteFolderArchiveStore.enqueueRemoval(windowID: self.windowID, in: root)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    /// Lists the expanded folders again now and then while the window shows, so that changes made by
+    /// others appear without Refresh. SFTP has no way to watch a folder.
+    ///
+    /// Nothing is listed while the window is hidden, offline, or listing or changing something already,
+    /// and the folder's location is checked only by Refresh and Reconnect.
+    private func startAutoRefresh() {
+
+        self.autoRefreshTask = Task { [weak self, pool = self.environment.pool] in
+            let interval = await pool.limits.folderRefreshInterval
+            while !Task.isCancelled {
+                try? await Task.sleep(for: interval)
+                guard let self, !self.isClosed else { return }
+                guard
+                    self.status == .online,
+                    self.changingItems.isEmpty,
+                    !self.tree.isBusy,
+                    let window = self.directory?.windowController?.window,
+                    window.isVisible, !window.isMiniaturized
+                else { continue }
+
+                self.tree.refresh()
+            }
+        }
+    }
+
+
+    /// The paths of the items being changed.
+    private var changingPaths: some Sequence<String> {
+
+        self.changingItems.lazy.compactMap { String(bytes: $0, encoding: .utf8) }
+    }
+
+
+    /// The name of a new file: `Untitled` with the default syntax's extension, as in a local folder.
+    private static var newFileName: String {
+
+        let name = String(localized: "Untitled", comment: "default name")
+        let pathExtension = (try? SyntaxManager.shared.setting(name: UserDefaults.standard[.syntax]))?.fileMap.extensions?.first
+
+        return pathExtension.map { name + "." + $0 } ?? name
+    }
+
+
+    private func checkOnline() throws(RemoteItemChangeError) {
+
+        guard self.status == .online, !self.isClosed else { throw .offline }
+    }
+
+
+    /// Runs a change on the server on the files connection, with a progress sheet if it takes long.
+    ///
+    /// - Throws: `RemoteItemChangeError.outcomeUnknown` if the connection ended before the server answered.
+    private func performChange<T: Sendable>(title: String, _ operation: @escaping @Sendable (any RemoteTransport) async throws -> T) async throws -> T {
+
+        let identity = self.identity
+        let pool = self.environment.pool
+
+        do {
+            return try await RemoteProgressSheet.run(title: title, window: self.directory?.windowForSheet) {
+                try await pool.withFolderEditingConnection(to: identity.endpoint, destination: identity.destination, operation)
+            }
+        } catch let error as RemoteConnectionError where error == .connectionLost || error == .timedOut {
+            throw RemoteItemChangeError.outcomeUnknown
+        } catch is RemoteSFTPProtocolError {
+            throw RemoteItemChangeError.outcomeUnknown
+        }
+    }
+
+
+    /// Renames or moves an item on the server, then shows it at its new place and makes the open files
+    /// in or below it follow.
+    ///
+    /// - Parameters:
+    ///   - node: The item.
+    ///   - folder: The folder it ends up in.
+    ///   - title: The title of the progress sheet.
+    ///   - operation: Renames or moves the item at the path, and returns its new name.
+    private func relocate(
+        _ node: RemoteDirectoryNode,
+        into folder: RemoteDirectoryNode,
+        title: String,
+        _ operation: @escaping @Sendable (String, any RemoteTransport) async throws -> String
+    ) async throws {
+
+        guard let parent = node.parent else { return }
+
+        try self.checkOnline()
+
+        let source = node.path
+        let oldCanonicalPath = RemotePath.appending(node.name, to: parent.canonicalPath)
+        let folderPath = folder.path
+        let folderCanonicalPath = folder.canonicalPath
+
+        let name: String
+        do {
+            name = try await self.whileChanging(node) { documents in
+                let name = try await self.performChange(title: title) { transport in try await operation(source, transport) }
+                try await self.follow(documents, from: (source, oldCanonicalPath),
+                                      to: (RemotePath.appending(name, to: folderPath), RemotePath.appending(name, to: folderCanonicalPath)))
+                return name
+            }
+        } catch {
+            self.tree.relist(parent)
+            if folder !== parent {
+                self.tree.relist(folder)
+            }
+            throw error
+        }
+
+        let wasExpanded = node.isExpanded
+        self.tree.remove(node)
+        if let moved = self.tree.insert(RemoteDirectoryEntry(name: name, attributes: node.attributes), into: folder), wasExpanded {
+            self.tree.expand(moved)
+        }
+        self.tree.relist(parent)
+        if folder !== parent {
+            self.tree.relist(folder)
+        }
+    }
+
+
+    /// Runs a change of an item while the saves of the open files in or below it are held.
+    ///
+    /// - Throws: `RemoteItemChangeError.fileInUse` before anything is sent, if such a file has changes that
+    ///   are not on the server, is being saved or opened; `changeUnderWay` if the item, or one above or
+    ///   below it, is being changed already.
+    private func whileChanging<T>(_ node: RemoteDirectoryNode, _ change: ([RemoteDocument]) async throws -> T) async throws -> T {
+
+        let key = Array(node.path.utf8)
+        let isOverlapping = self.changingPaths.contains { path in
+            RemotePath.isAncestor(path, of: node.path) || RemotePath.isAncestor(node.path, of: path)
+        }
+        guard !isOverlapping else { throw RemoteItemChangeError.changeUnderWay(node.name) }
+
+        let documents = self.openDocuments(atOrBelow: node)
+        try self.checkNotInUse(node, documents: documents)
+
+        self.changingItems.insert(key)
+        self.onPendingOpensChange()
+        defer {
+            self.changingItems.remove(key)
+            self.onPendingOpensChange()
+        }
+
+        return try await self.holdingSaves(of: documents[...]) {
+            // A save may have been under way until now.
+            try self.checkNotInUse(node, documents: documents)
+            return try await change(documents)
+        }
+    }
+
+
+    private func holdingSaves<T>(of documents: ArraySlice<RemoteDocument>, _ work: () async throws -> T) async throws -> T {
+
+        guard let document = documents.first else { return try await work() }
+
+        return try await document.saveCoordinator.withSavesHeld {
+            try await self.holdingSaves(of: documents.dropFirst(), work)
+        }
+    }
+
+
+    private func checkNotInUse(_ node: RemoteDirectoryNode, documents: [RemoteDocument]) throws(RemoteItemChangeError) {
+
+        if let document = documents.first(where: { $0.hasUnsentChanges || $0.saveCoordinator.isBusy }) {
+            throw .fileInUse(document.identity.fileName)
+        }
+        let openingPaths = self.pendingOpens.lazy.compactMap { String(bytes: $0, encoding: .utf8) }
+        if let opening = openingPaths.first(where: { RemotePath.isAncestor(node.path, of: $0) }) {
+            throw .fileInUse(RemoteFileIdentity.fileName(of: opening))
+        }
+    }
+
+
+    /// The open files at or below an item, through this window's connection: those whose file is there,
+    /// and those opened through a path that goes through it, such as through a link.
+    private func openDocuments(atOrBelow node: RemoteDirectoryNode) -> [RemoteDocument] {
+
+        let canonicalPath = node.parent.map { RemotePath.appending(node.name, to: $0.canonicalPath) } ?? node.path
+
+        return RemoteDocumentRegistry.shared.documents.filter { document in
+            document.identity.endpoint == self.identity.endpoint
+                && document.identity.destination == self.identity.destination
+                && (RemotePath.isAncestor(canonicalPath, of: document.identity.path) || RemotePath.isAncestor(node.path, of: document.identity.requestedPath))
+        }
+    }
+
+
+    /// Makes the open files follow an item that moved: each recovery record takes the new path first, then the document.
+    private func follow(_ documents: [RemoteDocument], from old: (path: String, canonicalPath: String), to new: (path: String, canonicalPath: String)) async throws {
+
+        func moved(_ path: String, from folder: String, to newFolder: String) -> String? {
+            RemotePath.relativePath(of: path, in: folder)?.reduce(newFolder) { RemotePath.appending($1, to: $0) }
+        }
+
+        var failure: (any Error)?
+        for document in documents {
+            var identity = document.identity
+            identity.requestedPath = moved(identity.requestedPath, from: old.path, to: new.path)
+                ?? moved(identity.requestedPath, from: old.canonicalPath, to: new.canonicalPath)
+                ?? identity.requestedPath
+            identity.path = moved(identity.path, from: old.canonicalPath, to: new.canonicalPath) ?? identity.path
+
+            do {
+                try await document.record?.updateIdentity(identity)
+                document.adoptIdentity(identity)
+            } catch {
+                failure = failure ?? error
+            }
+        }
+        if let failure { throw failure }
+    }
+
+
+    /// Checks that the connection and the folder's path still lead to this window's folder.
+    ///
+    /// - Parameter thenRefresh: Whether to list the root and the expanded folders once they do.
+    private func checkLocation(thenRefresh: Bool) {
+
+        let identity = self.identity
+        let environment = self.environment
+        let window = self.directory?.windowForSheet
+
+        self.connectionTask?.cancel()
+        self.connectionTask = Task {
+            let status: Status
+            do {
+                let destination = try await environment.pool.destination(for: identity.endpoint)
+                if destination != identity.destination {
+                    // The other server is only inspected, and only with the user's consent.
+                    let approves = await environment.prompts.confirmFolderDestinationChange(from: identity.destination, to: destination,
+                                                                                             folder: identity.displayLocation, window: window)
+                    guard approves else { throw RemoteFolderLocationError.destinationChanged }
+                    status = .changedLocation(try await RemoteFolderOpenCoordinator.resolve(identity.request, environment: environment))
+                } else {
+                    let canonicalPath = try await environment.pool.withBrowsingConnection(to: identity.endpoint, destination: identity.destination) { transport in
+                        try await RemoteFolderOpenCoordinator.resolveFolder(identity.requestedPath, with: transport)
+                    }
+                    if RemotePath.isSame(canonicalPath, identity.path) {
+                        status = .online
+                    } else {
+                        var candidate = identity
+                        candidate.path = canonicalPath
+                        status = .changedLocation(candidate)
+                    }
+                }
+            } catch is CancellationError {
+                return
+            } catch let error as RemoteSFTPError where error.status == .noSuchFile {
+                status = .unavailable(message: error.localizedDescription)
+            } catch let error as RemoteFolderError {
+                status = .unavailable(message: error.localizedDescription)
+            } catch {
+                status = .offline(message: Self.message(for: error))
+            }
+
+            guard !Task.isCancelled, !self.isClosed else { return }
+
+            self.status = status
+            self.tree.isOffline = (status != .online)
+            if status == .online {
+                if thenRefresh {
+                    self.tree.refresh()
+                }
+            } else {
+                // A window that changed location or lost its folder fetches nothing more.
+                self.tree.invalidate()
+            }
+        }
+    }
+
+
+    private func goOffline(because error: any Error) {
+
+        guard !self.isClosed, self.status == .online else { return }
+
+        self.status = .offline(message: Self.message(for: error))
+        self.tree.invalidate()
+        self.tree.isOffline = true
+    }
+
+
+    /// Shows a document that the tree opened: selects it here, or brings forward the window that has it.
+    ///
+    /// A document is never moved between windows.
+    private func show(_ document: RemoteDocument, in directory: DirectoryDocument, selects: Bool = true) {
+
+        if let owner = document.directoryDocument {
+            guard selects else { return }
+            if owner === directory {
+                directory.selectDocument(document)
+            } else {
+                RemoteOpenCoordinator.show(document)
+            }
+        } else if !document.windowControllers.isEmpty {
+            if selects {
+                document.showWindows()
+            }
+        } else {
+            directory.adoptMember(document, select: selects)
+            if selects {
+                directory.windowContentViewController?.focusActiveTab()
+            }
+        }
+    }
+
+
+    /// Explains that the window is offline, and reconnects if the user agrees.
+    private func offerReconnect(toOpen node: RemoteDirectoryNode) {
+
+        guard let window = self.directory?.windowForSheet else { return }
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemoteFolder.offline.open.message", defaultValue: "“\(node.name)” can’t be opened while the folder is offline.",
+                                   table: "Remote", comment: "%@ is a file name")
+        alert.informativeText = String(localized: "RemoteFolder.offline.open.information",
+                                       defaultValue: "The file is not on this Mac. Reconnect to download it.", table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemoteFolder.reconnect", defaultValue: "Reconnect", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.beginSheetModal(for: window) { [weak self] response in
+            guard response == .alertFirstButtonReturn else { return }
+            MainActor.assumeIsolated {
+                self?.reconnect()
+            }
+        }
+    }
+
+
+    private func treeDidChange(_ change: RemoteDirectoryTree.Change) {
+
+        self.onTreeChange(change)
+        if case .children = change {
+            self.scheduleArchive()
+        }
+    }
+
+
+    private func observe(_ window: NSWindow) {
+
+        for name in [NSWindow.didMoveNotification, NSWindow.didResizeNotification] {
+            self.windowObservers.append(NotificationCenter.default.addObserver(forName: name, object: window, queue: .main) { [weak self] _ in
+                MainActor.assumeIsolated {
+                    self?.scheduleArchive()
+                }
+            })
+        }
+    }
+
+
+    // MARK: Archive
+
+    /// Writes the window's record soon, once changes have settled.
+    private func scheduleArchive() {
+
+        guard !self.isClosed else { return }
+
+        if let directory, !directory.isClosed {
+            self.lastTabs = try? PropertyListSerialization.data(fromPropertyList: directory.tabArchive, format: .binary, options: 0)
+        }
+
+        self.archiveDebounceTask?.cancel()
+        self.archiveDebounceTask = Task { [weak self] in
+            try? await Task.sleep(for: .milliseconds(300))
+            guard !Task.isCancelled, let self, !self.isClosed else { return }
+            self.writeArchive()
+        }
+    }
+
+
+    private func writeArchive() {
+
+        RemoteFolderArchiveStore.enqueueWrite(self.makeArchive(frame: self.directory?.windowController?.window?.frameDescriptor),
+                                              in: self.environment.folderArchiveRoot)
+    }
+
+
+    private func makeArchive(frame: String?) -> RemoteFolderArchive {
+
+        if let frame {
+            self.lastFrame = frame
+        }
+
+        return RemoteFolderArchive(windowID: self.windowID, identity: self.identity, tabs: self.lastTabs, showsHiddenFiles: self.showsHiddenFiles,
+                                   windowFrame: self.lastFrame, snapshot: self.tree.snapshot)
+    }
+
+
+    /// Waits until every scheduled write of the window's record is done, for tests.
+    func waitForArchive() async {
+
+        if let debounce = self.archiveDebounceTask {
+            await debounce.value
+        }
+        await RemoteFolderArchiveStore.waitUntilIdle()
+    }
+
+
+    private static func message(for error: any Error) -> String {
+
+        [error.localizedDescription, (error as? any LocalizedError)?.recoverySuggestion]
+            .compactMap(\.self)
+            .joined(separator: " ")
+    }
+}
+
+
+/// Why a folder window did not reconnect.
+enum RemoteFolderLocationError: Error {
+
+    /// The connection now leads to another server, and the user did not want it inspected.
+    case destinationChanged
+    /// The folder is gone or now leads elsewhere, as the window's header says.
+    case folderUnavailable
+}
+
+
+extension RemoteFolderLocationError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .destinationChanged:
+                String(localized: "RemoteFolderLocationError.destinationChanged",
+                       defaultValue: "Your SSH configuration now connects to a different server.", table: "Remote")
+            case .folderUnavailable:
+                String(localized: "RemoteFolderLocationError.folderUnavailable",
+                       defaultValue: "The folder of this window is not available on the server.", table: "Remote")
+        }
+    }
+
+
+    var recoverySuggestion: String? {
+
+        String(localized: "RemoteFolderLocationError.recoverySuggestion", defaultValue: "Reconnect the window to review the change.", table: "Remote")
+    }
+}
+
+
+// MARK: Restoration
+
+/// Reopens remote folder windows at launch, offline.
+@MainActor enum RemoteFolderRestoration {
+
+    /// Reopens the windows whose records exist, without connecting. Their remote tabs recover from their
+    /// own recovery records, which claims those records before the launch recovery looks at the rest.
+    ///
+    /// - Parameters:
+    ///   - environment: The services the windows work with.
+    ///   - reopensWindows: Whether the system reopens windows; the records are removed otherwise.
+    static func run(environment: RemoteEnvironment, reopensWindows: Bool) {
+
+        let root = environment.folderArchiveRoot
+        let archives = RemoteFolderArchiveStore.archives(in: root)
+
+        guard reopensWindows else {
+            for archive in archives {
+                RemoteFolderArchiveStore.remove(windowID: archive.windowID, in: root)
+            }
+            return
+        }
+
+        // Oldest first, so the newest window ends up in front.
+        for archive in archives.reversed() {
+            guard RemoteFolderOpenCoordinator.session(for: archive.identity) == nil else {
+                RemoteFolderArchiveStore.remove(windowID: archive.windowID, in: root)
+                continue
+            }
+            let session = RemoteFolderSession(restoring: archive, environment: environment)
+            RemoteFolderOpenCoordinator.register(session)
+            session.openWindow(frame: archive.windowFrame, tabs: archive.tabArchive)
+        }
+    }
+}
