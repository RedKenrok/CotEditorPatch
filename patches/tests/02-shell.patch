+    @Test(.timeLimit(.minutes(1))) func terminalFillsTheContentPaneInEveryState() async throws {
+        
+        try await self.withTerminals(makesWindow: true) { directory, _, engines, _ in
+            let window = try #require(directory.windowControllers.first?.window)
+            let splitViewController = try #require(directory.windowController?.contentViewController as? NSSplitViewController)
+            let pane = try #require(splitViewController.splitViewItems.first { $0.behavior == .default })
+            window.setContentSize(NSSize(width: 1000, height: 700))
+            // The divider position is remembered across launches, so start from a known sidebar width.
+            splitViewController.splitView.setPosition(220, ofDividerAt: 0)
+            window.layoutIfNeeded()
+            let fileWidth = pane.viewController.view.frame.width
+            
+            // The pane must keep its width, and follow the window, whatever the terminal shows.
+            _ = try #require(directory.openTerminalTab())
+            let states: [(String, () -> Void)] = [
+                ("running", {}),
+                ("failed", { engines.nextStartError = .spawnFailed; _ = directory.openTerminalTab() }),
+            ]
+            for (state, enter) in states {
+                enter()
+                window.setContentSize(NSSize(width: 1000, height: 700))
+                window.layoutIfNeeded()
+                #expect(abs(pane.viewController.view.frame.width - fileWidth) < 2, "\(state): the terminal keeps the pane width")
+                
+                window.setContentSize(NSSize(width: 1300, height: 700))
+                window.layoutIfNeeded()
+                #expect(pane.viewController.view.frame.width > fileWidth + 250, "\(state): the pane follows the window")
+            }
+            
+            // A real terminal view, without a process, fills the pane with the grid centered in it.
+            engines.makeView = { SwiftTermEngine().view }
+            directory.selectTerminal(try #require(directory.openTerminalTab()))
+            let container = try #require(engines.made.last?.view as? TerminalContainerView)
+            let terminalView = container.terminalView
+            let cell = try #require(terminalView.cellSize)
+            let scrollerWidth = terminalView.reservedScrollerWidth
+            for size in [NSSize(width: 1000, height: 700), NSSize(width: 1300, height: 523)] {
+                window.setContentSize(size)
+                window.layoutIfNeeded()
+                #expect(abs(container.frame.width - pane.viewController.view.frame.width) < 2)
+                
+                // The scroller's strip lies inside the trailing margin, so it counts as margin.
+                let bounds = container.bounds
+                let frame = terminalView.frame
+                let margins = (leading: frame.minX - bounds.minX,
+                               trailing: bounds.maxX - frame.maxX + scrollerWidth,
+                               top: bounds.maxY - frame.maxY,
+                               bottom: frame.minY - bounds.minY)
+                #expect(abs(margins.leading - margins.trailing) <= 1, "\(size): \(margins)")
+                #expect(abs(margins.top - margins.bottom) <= 1, "\(size): \(margins)")
+                #expect(min(margins.leading, margins.top) >= scrollerWidth, "\(size): \(margins)")
+                
+                // Every whole cell that fits inside the minimum margins is used. SwiftTerm counts
+                // the cells of its own frame by dividing it by the cell size, as done here.
+                #expect(Int((frame.width - scrollerWidth) / cell.width) == Int((bounds.width - 2 * scrollerWidth) / cell.width), "\(size)")
+                #expect(Int(frame.height / cell.height) == Int((bounds.height - 2 * scrollerWidth) / cell.height), "\(size)")
+            }
+        }
+    }
