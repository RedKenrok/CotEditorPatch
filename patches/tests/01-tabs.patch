+/// Every test here changes the global file-tabs preference, so the suite (including its extensions
+/// in other files) must not interleave with itself.
+@Suite(.serialized) @MainActor struct DirectoryTabTests {
+
+    // MARK: Tab State
+
+    @Test func tabStatePreservesIdentityAndNeighborSelection() {
+
+        let state = DirectoryTabState()
+        let first = Document()
+        let second = Document()
+        let third = Document()
+        let firstID = state.insert(first).id
+        let secondID = state.insert(second).id
+        let thirdID = state.insert(third).id
+        #expect(state.selectedID == nil, "inserting never selects")
+        #expect(state.insert(first).id == firstID)
+        #expect(state.entries.map(\.id) == [firstID, secondID, thirdID])
+        state.select(secondID)
+        state.remove(first)
+        #expect(state.selectedID == secondID)
+        state.remove(second)
+        #expect(state.selectedID == thirdID)
+        state.remove(third)
+        #expect(state.selectedID == nil)
+        state.reconcile(with: [first, second])
+        #expect(state.entries.count == 2)
+        #expect(state.entry(for: first) != nil)
+    }
+
