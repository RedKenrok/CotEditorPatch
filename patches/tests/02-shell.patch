+    @Test func startRunsLoginShellInStartingDirectory() throws {
+
+        let engines = FakeTerminalEngines()
+        let directory = FileManager.default.temporaryDirectory
+        let session = TerminalSession(defaultTitle: "Shell", startingDirectory: directory, makeEngine: engines.make)
+        #expect(session.lifecycle == .inactive)
+        #expect(engines.made.isEmpty, "a session does nothing until it is started")
+
+        session.start()
+
+        let engine = try #require(engines.made.first)
+        let configuration = try #require(engine.configurations.first)
+        #expect(session.lifecycle == .running)
+        #expect(session.isLive)
+        #expect(configuration.currentDirectory == directory.path(percentEncoded: false))
+        #expect(configuration.argv0.hasPrefix("-"), "a leading hyphen makes the shell a login shell")
+        #expect(configuration.arguments.isEmpty, "no command is ever typed into or passed to the shell")
+
+        session.start()
+        #expect(engines.made.count == 1, "starting a running session does nothing")
+    }
