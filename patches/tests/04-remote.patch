+        defer { engine.shutDown() }
+        var status: TerminalExitStatus?
+        engine.onExit = { status = $0 }
+        try engine.start(try launcher.configuration())
+
+        // The fixture's shell is sh, whose prompt ends with “$ ”.
+        try await Self.wait { engine.bufferText.contains("$") }
+        (engine.focusView as? any NSTextInputClient)?.insertText("pwd -P; exit 5\r", replacementRange: NSRange(location: NSNotFound, length: 0))
+        try await Self.wait { status != nil && engine.bufferText.replacing("\n", with: "").contains("ü") }
+
+        #expect(status == TerminalExitStatus(code: 5))
+        #expect(engine.bufferText.replacing("\n", with: "").replacing("\0", with: "").contains(RemoteFileIdentity.fileName(of: path)))
+        #expect(!FileManager.default.fileExists(atPath: folder.deletingLastPathComponent().appending(path: "pwned").path(percentEncoded: false)))
+        await session.environment.pool.closeAll()
+    }
+
+
+    @Test(.enabled(if: RemoteDirectoryListingTests.fixture != nil, "needs scripts/remote-fixture.sh start"), .timeLimit(.minutes(1)))
+    func aFolderGoneOnTheServerStartsNoShell() async throws {
+
+        let fixture = try #require(RemoteDirectoryListingTests.fixture)
+        let path = fixture.appending(path: "data", directoryHint: .isDirectory).resolvingSymlinksInPath().path(percentEncoded: false) + "/gone-" + UUID().uuidString
+        let session = try await Self.session(folder: path, fixture: fixture)
+        let launcher = try await session.makeTerminalLauncher(for: DirectoryDocument(root: session))
+
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        var status: TerminalExitStatus?
+        engine.onExit = { status = $0 }
+        try engine.start(try launcher.configuration())
+
+        try await Self.wait { status != nil && engine.bufferText.contains("could not be entered") }
+        #expect(status == TerminalExitStatus(code: RemoteTerminalCommand.folderFailureStatus))
+        await session.environment.pool.closeAll()
+    }
+
+
+    // MARK: Private Methods
+
+    /// A folder window's session on the fixture's shell server, without its window.
+    private static func session(folder path: String, fixture: URL) async throws -> RemoteFolderSession {
+
+        let overrides = RemoteSSHCommand.TestOverrides(configurationFile: fixture.appending(path: "ssh_config"))
+        let endpoint = RemoteEndpoint(host: "fixture-shell", user: nil, port: nil)
+        let pool = RemoteConnectionPool()
+        await pool.configure(limits: RemoteLimits(), connector: { endpoint, limits in
+            try await RemoteSFTPTransport.connect(to: endpoint, limits: limits, overrides: overrides)
+        }, evaluator: { endpoint, limits in
+            try await RemoteSSHProcess.evaluateConfiguration(for: endpoint, limits: limits, overrides: overrides)
+        })
+        let destination = try await pool.destination(for: endpoint)
+        let root = FileManager.default.temporaryDirectory.appending(path: "RemoteTerminal-" + UUID().uuidString, directoryHint: .isDirectory)
+        let environment = RemoteEnvironment(pool: pool, prompts: ScriptedRemotePrompts(), recoveryRoot: root, recoveryTiming: RemoteRecoveryTiming(),
+                                            folderArchiveRoot: root.appending(path: "Folders"), sshOverrides: overrides)
+        let identity = RemoteFolderIdentity(profileID: nil, endpoint: endpoint, destination: destination, requestedPath: path, path: path)
+
+        return RemoteFolderSession(identity: identity, environment: environment)
+    }
+
+
+    /// The path as the file system resolves it, as `pwd -P` prints it: Foundation shows `/private/var` as `/var`.
+    private static func realPath(_ url: URL) throws -> String {
+
+        guard let resolved = realpath(url.path(percentEncoded: false), nil) else { throw CocoaError(.fileNoSuchFile) }
+        defer { free(resolved) }
+
+        return String(cString: resolved)
+    }
+
+
+    private static func run(_ executable: String, _ arguments: [String], shellVariable: URL, in folder: URL) async throws -> (status: Int32, output: String) {
+
+        let process = Process()
+        process.executableURL = URL(filePath: executable)
+        process.arguments = arguments
+        process.environment = ["PATH": "/usr/bin:/bin", "SHELL": shellVariable.path(percentEncoded: false), "HOME": folder.path(percentEncoded: false)]
+        process.currentDirectoryURL = folder
+        let pipe = Pipe()
+        process.standardOutput = pipe
+        process.standardError = FileHandle.nullDevice
+        process.standardInput = FileHandle.nullDevice
+
+        let status: Int32 = try await withCheckedThrowingContinuation { continuation in
+            process.terminationHandler = { continuation.resume(returning: $0.terminationStatus) }
+            do {
+                try process.run()
+            } catch {
+                continuation.resume(throwing: error)
+            }
+        }
+
+        return (status, String(bytes: pipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8) ?? "")
+    }
+
+
+    private static func wait(timeout: Duration = .seconds(15), until condition: () -> Bool) async throws {
+
+        let deadline = ContinuousClock.now + timeout
+        while !condition() {
+            guard ContinuousClock.now < deadline else {
+                Issue.record("Timed out waiting for condition")
+                return
+            }
+            try await Task.sleep(for: .milliseconds(20))
+        }
+    }
+}
