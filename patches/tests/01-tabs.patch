+    @Test(.timeLimit(.minutes(1))) func movedTabsKeepTheirOrder() async throws {
+
+        // With a window, so that the preference observer reconciles the tabs when they are turned back on.
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            for url in urls {
+                #expect(await directory.openDocument(at: url))
+            }
+            let ids = directory.tabState.entries.map(\.id)
+            let selected = directory.tabState.selectedID
+
+            directory.moveTab(id: ids[2], to: 0)
+            #expect(directory.tabState.entries.map(\.id) == [ids[2], ids[0], ids[1]])
+            #expect(directory.tabState.selectedID == selected, "moving a tab does not select it")
+
+            // Across turning tabs off and on, with every file kept open by its unsaved changes.
+            for document in directory.tabDocuments {
+                document.updateChangeCount(.changeDone)
+            }
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+            #expect(directory.tabState.entries.map(\.id) == [ids[2], ids[0], ids[1]])
+            for document in directory.tabDocuments {
+                document.updateChangeCount(.changeCleared)
+            }
+
+            // Across a relaunch; the files must be closed first, or they would still belong to this window.
+            let data = self.encodeRestorableState(of: directory)
+            directory.close()
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                try await self.wait { restored.tabDocuments.count == urls.count }
+                #expect(restored.tabState.entries.map(\.id) == [ids[2], ids[0], ids[1]])
+            }
+        }
+    }
