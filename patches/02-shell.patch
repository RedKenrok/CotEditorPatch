+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+
+
+/// A request to stop terminal work, described for the confirmation.
+enum TerminalCloseRequest: Equatable {
+
+    enum Scope: Equatable {
+
+        /// Closing a directory window.
+        case window
+        /// Quitting the app.
+        case quit
+        /// Turning off file tabs, which closes every terminal tab.
+        case disablingTabs
+    }
+
+
+    /// Closing one running terminal tab.
+    case tab(title: String)
+
+    /// Closing several terminal tabs at once, of which `liveCount` are running.
+    case many(scope: Scope, liveCount: Int)
+}
+
+
+/// The confirmations terminal tabs need.
+///
+/// Every decision goes through this protocol so that tests can answer without showing alerts.
+@MainActor protocol TerminalPrompting {
+
+    /// Asks whether terminal work may be stopped. Nothing may be stopped before this returns `true`.
+    func confirmClosing(_ request: TerminalCloseRequest, window: NSWindow?) async -> Bool
+
+    /// Asks whether to turn on file tabs, which terminals need.
+    func confirmEnablingTabs(window: NSWindow?) async -> Bool
+
+    /// Asks for a new tab name.
+    ///
+    /// - Returns: The entered name, which may be empty, or `nil` if canceled.
+    func askForTitle(current: String, window: NSWindow?) async -> String?
+}
+
+
+@MainActor enum TerminalPrompts {
+
+    /// The prompts in use; tests replace them.
+    static var current: any TerminalPrompting = TerminalAlertPrompts()
+}
+
+
+/// The standard prompts, as alerts.
+@MainActor struct TerminalAlertPrompts: TerminalPrompting {
+
+    func confirmClosing(_ request: TerminalCloseRequest, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+
+        let stopsWork = String(localized: "TerminalPrompt.stopsWork", defaultValue: "Anything running in it will be stopped.", table: "Terminal",
+                               comment: "explanation when closing a running terminal tab")
+        let stopsAllWork = String(localized: "TerminalPrompt.stopsAllWork", defaultValue: "Anything running in the shell tabs will be stopped.", table: "Terminal",
+                                  comment: "explanation when closing several terminal tabs")
+
+        switch request {
+            case .tab(let title):
+                alert.messageText = String(localized: "TerminalPrompt.closeTab.message", defaultValue: "Close the shell “\(title)”?", table: "Terminal",
+                                           comment: "%@ is the name of the terminal tab")
+                alert.informativeText = stopsWork
+                alert.addButton(withTitle: String(localized: "TerminalPrompt.closeTab.button", defaultValue: "Close Shell", table: "Terminal",
+                                                  comment: "button label"))
+
+            case .many(.window, _):
+                alert.messageText = String(localized: "TerminalPrompt.closeWindow.message", defaultValue: "Close this window with running shells?", table: "Terminal")
+                alert.informativeText = stopsAllWork
+                alert.addButton(withTitle: String(localized: "TerminalPrompt.closeWindow.button", defaultValue: "Close Window", table: "Terminal",
+                                                  comment: "button label"))
+
+            case .many(.quit, _):
+                alert.messageText = String(localized: "TerminalPrompt.quit.message", defaultValue: "Quit with running shells?", table: "Terminal")
+                alert.informativeText = stopsAllWork
+                alert.addButton(withTitle: String(localized: "TerminalPrompt.quit.button", defaultValue: "Quit", table: "Terminal",
+                                                  comment: "button label"))
+
+            case .many(.disablingTabs, let liveCount):
+                alert.messageText = String(localized: "TerminalPrompt.disableTabs.message", defaultValue: "Turn off file tabs?", table: "Terminal")
+                let closes = String(localized: "TerminalPrompt.disableTabs.information",
+                                    defaultValue: "Shells are only shown as tabs, so every shell tab in every folder window will be closed.",
+                                    table: "Terminal")
+                alert.informativeText = liveCount > 0 ? closes + " " + stopsAllWork : closes
+                alert.addButton(withTitle: String(localized: "TerminalPrompt.disableTabs.button", defaultValue: "Turn Off and Close Shells", table: "Terminal",
+                                                  comment: "button label"))
+        }
+        alert.addButton(withTitle: String(localized: "TerminalPrompt.cancel", defaultValue: "Cancel", table: "Terminal", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func confirmEnablingTabs(window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "TerminalPrompt.enableTabs.message", defaultValue: "Shells open as tabs", table: "Terminal")
+        alert.informativeText = String(localized: "TerminalPrompt.enableTabs.information",
+                                       defaultValue: "Shell tabs appear next to file tabs, which are turned off. Turning on file tabs applies to all folder windows.",
+                                       table: "Terminal")
+        alert.addButton(withTitle: String(localized: "TerminalPrompt.enableTabs.button", defaultValue: "Enable Tabs and Open Shell", table: "Terminal",
+                                          comment: "button label"))
+        alert.addButton(withTitle: String(localized: "TerminalPrompt.cancel", defaultValue: "Cancel", table: "Terminal", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func askForTitle(current: String, window: NSWindow?) async -> String? {
+
+        let field = NSTextField(string: current)
+        field.frame.size.width = 260
+        field.placeholderString = String(localized: "TerminalPrompt.rename.placeholder", defaultValue: "Automatic", table: "Terminal",
+                                         comment: "placeholder of the tab name field; leaving it empty returns to the automatic name")
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "TerminalPrompt.rename.message", defaultValue: "Rename Shell Tab", table: "Terminal")
+        alert.informativeText = String(localized: "TerminalPrompt.rename.information",
+                                       defaultValue: "Leave the name empty to use the automatic name.", table: "Terminal")
+        alert.accessoryView = field
+        alert.addButton(withTitle: String(localized: "TerminalPrompt.rename.button", defaultValue: "Rename", table: "Terminal", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "TerminalPrompt.cancel", defaultValue: "Cancel", table: "Terminal", comment: "button label"))
+        alert.window.initialFirstResponder = field
+
+        guard await Self.run(alert, window: window) == .alertFirstButtonReturn else { return nil }
+
+        return field.stringValue
+    }
+
+
+    /// Shows the alert as a sheet on the window, or as an application-modal alert without one.
+    private static func run(_ alert: NSAlert, window: NSWindow?) async -> NSApplication.ModalResponse {
+
+        if let window, window.isVisible, window.attachedSheet == nil {
+            await alert.beginSheetModal(for: window)
+        } else {
+            alert.runModal()
+        }
+    }
+}
