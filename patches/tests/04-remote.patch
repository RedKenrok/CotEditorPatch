+/// Remote files in directory windows, with a fake server and scripted prompts.
+///
+/// These are part of the serialized `DirectoryTabTests` suite: they change the same global
+/// preference, and the environment that restoration and the app's commands use.
+extension DirectoryTabTests {
+
+    // MARK: Opening
+
+    @Test(.timeLimit(.minutes(1))) func remoteFilesJoinTheTabsBesideLocalFiles() async throws {
+
+        try await self.withRemote { directory, urls, bed in
+            #expect(await directory.openDocument(at: urls[0]))
+            await bed.server.addFile("/srv/www/index.html", "<p>")
+            let recentBefore = NSDocumentController.shared.recentDocumentURLs
+
+            let document = try await bed.openInDirectory("/srv/www/index.html", directory)
+
+            #expect(directory.tabDocuments.count == 2)
+            #expect(directory.activeFileDocument === document)
+            #expect(document.directoryDocument === directory)
+            #expect(directory.fileNode?.node(at: URL(filePath: "/srv/www/index.html")) == nil, "the file browser shows only local files")
+            #expect(NSDocumentController.shared.recentDocumentURLs == recentBefore, "nothing is added to Open Recent")
+
+            let presentation = try #require(directory.tabPresentations.last)
+            #expect(presentation.title == "index.html")
+            #expect(presentation.tooltip == "editor@\(bed.endpoint.host):/srv/www/index.html")
+            #expect(presentation.badgeSymbolName == nil)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func openingAnOpenRemoteFileAgainSelectsItsTab() async throws {
+
+        try await self.withRemote { directory, urls, bed in
+            await bed.server.addFile("/srv/a.txt", "a")
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            #expect(await directory.openDocument(at: urls[0]))
+            #expect(directory.activeFileDocument !== document)
+
+            // two requests at the same time open the file once
+            async let first = bed.openInDirectory("/srv/a.txt", directory)
+            async let second = bed.openInDirectory("/srv/a.txt", directory)
+            #expect(try await first === document)
+            #expect(try await second === document)
+
+            #expect(directory.activeFileDocument === document)
+            #expect(directory.tabDocuments.count == 2)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func withTabsOffARemoteFileGetsAWindowOfItsOwn() async throws {
+
+        try await self.withRemote(makesWindow: true) { directory, _, bed in
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            await bed.server.addFile("/srv/a.txt", "a")
+
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            defer { document.close() }
+
+            #expect(document.directoryDocument == nil)
+            #expect(!directory.documents.contains { $0 === document })
+            #expect(document.windowControllers.first?.window?.subtitle == "editor@\(bed.endpoint.host)")
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aRemoteTabMovesToItsOwnWindowWithItsEdits() async throws {
+
+        try await self.withRemote(makesWindow: true) { directory, _, bed in
+            await bed.server.addFile("/srv/a.txt", "a")
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            document.replaceText(with: "edited")
+            let id = try #require(directory.tabState.entry(for: document)?.id)
+
+            #expect(directory.moveTabToNewWindow(id: id))
+            defer { document.close() }
+
+            #expect(document.directoryDocument == nil)
+            #expect(document.windowControllers.first?.window != directory.windowControllers.first?.window)
+            #expect(document.textStorage.string == "edited")
+            #expect(document.isDocumentEdited)
+            #expect(RemoteDocumentRegistry.shared.document(for: document.identity) === document)
+        }
+    }
+
+
+    // MARK: Closing
+
+    @Test(.timeLimit(.minutes(1))) func closingARemoteTabAsksAndDiscardsOnlyOnClose() async throws {
+
+        try await self.withRemote { directory, _, bed in
+            await bed.server.addFile("/srv/a.txt", "a")
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            document.replaceText(with: "edited")
+            let id = try #require(directory.tabState.entry(for: document)?.id)
+            let record = try #require(document.record?.directory)
+
+            bed.prompts.closeChoices = [.cancel]
+            await directory.closeTab(id: id)
+            #expect(directory.tabDocuments.contains { $0 === document })
+
+            bed.prompts.closeChoices = [.discard]
+            await directory.closeTab(id: id)
+            #expect(!directory.tabDocuments.contains { $0 === document })
+            try await self.wait { !FileManager.default.fileExists(atPath: record.path(percentEncoded: false)) }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aCanceledWindowCloseKeepsEarlierDiscardedRecords() async throws {
+
+        try await self.withRemote { directory, _, bed in
+            await bed.server.addFile("/srv/a.txt", "a")
+            await bed.server.addFile("/srv/b.txt", "b")
+            let first = try await bed.openInDirectory("/srv/a.txt", directory)
+            let second = try await bed.openInDirectory("/srv/b.txt", directory)
+            first.replaceText(with: "edited a")
+            second.replaceText(with: "edited b")
+            let record = try #require(first.record?.directory)
+
+            bed.prompts.closeChoices = [.discard, .cancel]
+            #expect(await !directory.canClose())
+            #expect(bed.prompts.asked == ["close", "close"])
+
+            #expect(FileManager.default.fileExists(atPath: record.path(percentEncoded: false)), "the close did not happen, so nothing was discarded")
+            #expect(directory.tabDocuments.contains { $0 === first })
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aSelectedTerminalCannotSaveAHiddenRemoteDocument() async throws {
+
+        try await self.withTerminals { directory, _, _, _ in
+            let bed = await RemoteTestBed()
+            await bed.server.addFile("/srv/a.txt", "a")
+            let document = try await bed.openInDirectory("/srv/a.txt", directory)
+            document.replaceText(with: "edited")
+
+            _ = try #require(directory.openTerminalTab())
+            #expect(directory.activeFileDocument == nil)
+            #expect(directory.windowController?.fileDocument == nil, "file commands have no document to reach")
+
+            document.close()
+            await bed.tearDown()
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func webPagesShareTheTabsWithRemoteFiles() async throws {
+
+        try await self.withRemote(makesWindow: true) { directory, urls, bed in
+            await bed.server.addFile("/srv/r.txt", "remote")
+            let document = try await bed.openInDirectory("/srv/r.txt", directory)
+            document.replaceText(with: "unsent")
+            #expect(await document.flushRecovery())
+            let page = try #require(directory.openWebPageTab())
+
+            #expect(directory.activeWebPageSession === page)
+            #expect(directory.activeFileDocument == nil)
+            #expect(directory.windowController?.fileDocument == nil, "Save has no remote document to reach")
+
+            directory.selectDocument(document)
+            #expect(directory.activeFileDocument === document)
+            directory.selectTabItem(page)
+            #expect(page.controller != nil)
+
+            // Both come back in their places without connecting to the server or loading anything.
+            let ids = directory.tabState.entries.map(\.id)
+            let data = self.encodeRestorableState(of: directory)
+            directory.close()
+            try await bed.waitUntilReleased(document.documentID)
+            await bed.server.clearLog()
+
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                try await self.wait { restored.tabState.entries.count == 2 }
+                #expect(restored.tabState.entries.map(\.id) == ids)
+                #expect(restored.activeWebPageSession?.id == page.id)
+                let remote = try #require(restored.tabDocuments.first as? RemoteDocument)
+                #expect(remote.textStorage.string == "unsent")
+                #expect(await bed.server.log.isEmpty, "restoring does not connect")
+                remote.close()
+            }
+        }
+    }
+
