@@ -0,0 +1,308 @@
+//
+//  RemoteDirectoryTransport.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// An open remote folder, for reading its entries.
+struct RemoteDirectoryHandle: Sendable {
+
+    var data: Data
+    var path: String
+}
+
+
+/// The folder operations that browsing and changing folders are built from, on one connection.
+///
+/// Errors mean what they mean for `RemoteFileTransport`: a `RemoteSFTPError` is the server's definite
+/// answer, anything else leaves the connection's state unknown.
+protocol RemoteDirectoryTransport: AnyObject, Sendable {
+
+    func realpath(_ path: String) async throws -> String
+    func lstat(_ path: String) async throws -> RemoteFileAttributes
+    func stat(_ path: String) async throws -> RemoteFileAttributes
+
+    func openDirectory(_ path: String) async throws -> RemoteDirectoryHandle
+
+    /// Reads the next batch of a folder's entries.
+    ///
+    /// - Returns: The entries, which may be none, or `nil` once the server reported the end of the folder.
+    func readDirectory(_ handle: RemoteDirectoryHandle) async throws -> [RemoteSFTPResponse.NameEntry]?
+
+    func closeDirectory(_ handle: RemoteDirectoryHandle) async throws
+
+    /// Creates a folder, failing if anything exists at the path. The server applies its umask to the permissions.
+    func makeDirectory(_ path: String, permissions: UInt32) async throws
+
+    /// Removes an empty folder.
+    func removeDirectory(_ path: String) async throws
+
+    /// Renames an item, which the server should refuse if the destination exists, unlike `rename(_:to:)`.
+    func renameWithoutReplacing(_ source: String, to destination: String) async throws
+}
+
+
+/// Both kinds of operations, as a connection to an SFTP server offers them.
+typealias RemoteTransport = RemoteFileTransport & RemoteDirectoryTransport
+
+
+/// An entry of a remote folder.
+struct RemoteDirectoryEntry: Equatable, Sendable {
+
+    /// The name, exactly as the server sent it. Two names that differ only in Unicode normalization are two entries.
+    var name: String
+    var attributes: RemoteFileAttributes
+}
+
+
+/// Which bound ended a listing early.
+enum RemoteListingLimit: Equatable, Sendable {
+
+    /// The folder has more entries than a listing reads.
+    case entries(Int)
+
+    /// The entries' names take more bytes than a listing reads.
+    case nameBytes(Int)
+}
+
+
+/// The entries of a remote folder, as far as a listing read them.
+struct RemoteDirectoryListing: Equatable, Sendable {
+
+    /// The entries in the order the server sent them, each name once.
+    var entries: [RemoteDirectoryEntry]
+
+    /// The bound that stopped the listing before the end of the folder, or `nil` if the server reported the end.
+    var limit: RemoteListingLimit?
+
+    /// Entries that cannot be shown, such as names that are not valid UTF-8.
+    var omittedCount = 0
+
+
+    /// Whether the listing reached the end of the folder.
+    var isComplete: Bool  { self.limit == nil }
+}
+
+
+extension RemoteDirectoryTransport {
+
+    /// Lists a folder, within the limits.
+    ///
+    /// The entries `.` and `..` are left out. A name that is empty, not valid UTF-8, or contains a slash,
+    /// a NUL or a control character cannot name an entry of this folder, so it is left out and counted.
+    /// A name the server sends twice is kept once. The folder's handle is closed on every way out that
+    /// leaves the connection usable.
+    ///
+    /// - Parameters:
+    ///   - path: The folder.
+    ///   - limits: The bounds on entries and name bytes, which count every entry the server sends.
+    ///   - onBatch: Called with the entries of each batch that adds any, as they arrive, before the listing is complete.
+    /// - Throws: `RemoteOperationCanceled` if the operation's control asked to stop, or the error of a failed request.
+    func listDirectory(at path: String, limits: RemoteLimits, onBatch: (@Sendable ([RemoteDirectoryEntry]) -> Void)? = nil) async throws -> RemoteDirectoryListing {
+
+        let control = RemoteOperationControl.current
+        try control?.checkCancellation()
+
+        let handle = try await self.openDirectory(path)
+
+        do {
+            let listing = try await self.readEntries(of: handle, limits: limits, onBatch: onBatch)
+            // The entries are read; a failure to close changes nothing about them.
+            try? await self.closeDirectory(handle)
+            return listing
+
+        } catch let error as RemoteSFTPError {
+            // The server answered, so the connection is fine; the handle must not leak.
+            try? await self.closeDirectory(handle)
+            throw error
+        } catch let error as RemoteOperationCanceled {
+            try? await self.closeDirectory(handle)
+            throw error
+        }
+    }
+
+
+    /// Whether the item at the path is a folder that can be listed, as a successful `OPENDIR` proves.
+    ///
+    /// For servers whose attributes do not tell the type of an item.
+    func opensAsDirectory(_ path: String) async throws -> Bool {
+
+        let handle: RemoteDirectoryHandle
+        do {
+            handle = try await self.openDirectory(path)
+        } catch let error as RemoteSFTPError where error.status == .failure || error.status == .noSuchFile {
+            // OpenSSH answers FAILURE for an item that is not a folder.
+            return false
+        }
+        try? await self.closeDirectory(handle)
+
+        return true
+    }
+
+
+    private func readEntries(of handle: RemoteDirectoryHandle, limits: RemoteLimits, onBatch: (@Sendable ([RemoteDirectoryEntry]) -> Void)?) async throws -> RemoteDirectoryListing {
+
+        let control = RemoteOperationControl.current
+        var listing = RemoteDirectoryListing(entries: [])
+        var seenNames: Set<Data> = []
+        var entryCount = 0
+        var nameBytes = 0
+        var requestCount = 0
+
+        while true {
+            try control?.checkCancellation()
+
+            // Empty batches still count, so a server sending nothing forever cannot keep the listing going.
+            requestCount += 1
+            guard requestCount <= limits.maximumListingEntries else {
+                listing.limit = .entries(limits.maximumListingEntries)
+                return listing
+            }
+
+            guard let batch = try await self.readDirectory(handle) else { return listing }
+
+            let batchStart = listing.entries.endIndex
+            defer {
+                if let onBatch, listing.entries.endIndex > batchStart {
+                    onBatch(Array(listing.entries[batchStart...]))
+                }
+            }
+            for entry in batch {
+                entryCount += 1
+                nameBytes += entry.nameBytes.count
+                guard entryCount <= limits.maximumListingEntries else {
+                    listing.limit = .entries(limits.maximumListingEntries)
+                    return listing
+                }
+                guard nameBytes <= limits.maximumListingNameBytes else {
+                    listing.limit = .nameBytes(limits.maximumListingNameBytes)
+                    return listing
+                }
+
+                guard entry.nameBytes != Data(".".utf8), entry.nameBytes != Data("..".utf8) else { continue }
+                guard let name = entry.name, RemotePath.isValidComponent(name) else {
+                    listing.omittedCount += 1
+                    continue
+                }
+                guard seenNames.insert(entry.nameBytes).inserted else { continue }
+
+                listing.entries.append(RemoteDirectoryEntry(name: name, attributes: entry.attributes))
+            }
+            control?.didTransfer(batch.count)
+        }
+    }
+}
+
+
+extension RemoteSFTPTransport: RemoteDirectoryTransport {
+
+    func openDirectory(_ path: String) async throws -> RemoteDirectoryHandle {
+
+        let handle = try await self.client.expectHandle(.opendir(path: path), operation: .openFolder, path: path)
+
+        return RemoteDirectoryHandle(data: handle, path: path)
+    }
+
+
+    func readDirectory(_ handle: RemoteDirectoryHandle) async throws -> [RemoteSFTPResponse.NameEntry]? {
+
+        try await self.client.expectNames(.readdir(handle: handle.data), path: handle.path)
+    }
+
+
+    func closeDirectory(_ handle: RemoteDirectoryHandle) async throws {
+
+        try await self.client.expectStatus(.close(handle: handle.data), operation: .close, path: handle.path)
+    }
+
+
+    func makeDirectory(_ path: String, permissions: UInt32) async throws {
+
+        try await self.client.expectStatus(.mkdir(path: path, attributes: RemoteFileAttributes(permissions: permissions)), operation: .createFolder, path: path)
+    }
+
+
+    func removeDirectory(_ path: String) async throws {
+
+        try await self.client.expectStatus(.rmdir(path: path), operation: .removeFolder, path: path)
+    }
+
+
+    func renameWithoutReplacing(_ source: String, to destination: String) async throws {
+
+        try await self.client.expectStatus(.rename(from: source, to: destination), operation: .rename, path: source)
+    }
+}
+
+
+extension RemotePath {
+
+    /// Whether a name from a folder listing can be one component of a path.
+    ///
+    /// The name is otherwise kept as it is: without case folding or Unicode normalization.
+    static func isValidComponent(_ name: String) -> Bool {
+
+        !name.isEmpty
+            && name != "." && name != ".."
+            && name.utf8.count <= 1024
+            && !name.unicodeScalars.contains { $0 == "/" || $0.value == 0 || CharacterSet.controlCharacters.contains($0) }
+    }
+
+
+    /// The path of a folder's entry, joined without any local path handling.
+    ///
+    /// - Returns: `nil` if the name cannot be one component of a path.
+    static func child(_ name: String, of folder: String) -> String? {
+
+        guard self.isValidComponent(name) else { return nil }
+
+        return self.appending(name, to: folder)
+    }
+
+
+    /// The components of an absolute path, without empty ones.
+    static func components(of path: String) -> [String] {
+
+        path.split(separator: "/", omittingEmptySubsequences: true).map(String.init)
+    }
+
+
+    /// Whether the path is the folder or inside it, compared by component and by bytes, never by string prefix.
+    static func isAncestor(_ folder: String, of path: String) -> Bool {
+
+        let folderComponents = self.components(of: folder)
+        let pathComponents = self.components(of: path)
+
+        return folderComponents.count <= pathComponents.count
+            && zip(folderComponents, pathComponents).allSatisfy { self.isSame($0, $1) }
+    }
+
+
+    /// The path relative to one of its ancestors, or `nil` if the folder is not an ancestor.
+    static func relativePath(of path: String, in folder: String) -> [String]? {
+
+        guard self.isAncestor(folder, of: path) else { return nil }
+
+        return Array(self.components(of: path).dropFirst(self.components(of: folder).count))
+    }
+}
diff --git a/CotEditor/Sources/Remote/RemoteDirectoryTree.swift b/CotEditor/Sources/Remote/RemoteDirectoryTree.swift
new file mode 100644
index 000000000..96701ca87
--- /dev/null
+++ b/CotEditor/Sources/Remote/RemoteDirectoryTree.swift
@@ -0,0 +1,1165 @@
+//
+//  RemoteDirectoryTree.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// Where a tree gets folder listings and what links and untyped entries lead to. The session gives
+/// it the window's browsing connection; tests give it scripted replies.
+protocol RemoteDirectoryTreeSource: Sendable {
+
+    /// Lists a folder. The listing runs with the control as `RemoteOperationControl.current`, so that asking it to cancel stops it.
+    func list(_ path: String, control: RemoteOperationControl) async throws -> RemoteDirectoryListing
+
+    /// Lists a folder, telling the entries of each batch as they arrive.
+    func list(_ path: String, control: RemoteOperationControl, onBatch: @escaping @Sendable ([RemoteDirectoryEntry]) -> Void) async throws -> RemoteDirectoryListing
+
+    /// Finds out what the item at the path is, following links, as the server resolves it.
+    func resolve(_ path: String, control: RemoteOperationControl) async throws -> RemoteResolvedItem
+}
+
+
+extension RemoteDirectoryTreeSource {
+
+    func list(_ path: String, control: RemoteOperationControl, onBatch: @escaping @Sendable ([RemoteDirectoryEntry]) -> Void) async throws -> RemoteDirectoryListing {
+
+        try await self.list(path, control: control)
+    }
+}
+
+
+/// What a path leads to on the server.
+struct RemoteResolvedItem: Equatable, Sendable {
+
+    /// The canonical path, as `REALPATH` returned it.
+    var target: String
+
+    /// The type of the item there. `unknown` if the server tells no type and the item cannot be listed as a folder.
+    var kind: RemoteDirectoryNode.Kind
+}
+
+
+/// One item of a remote folder tree.
+///
+/// A node's identity is its path's exact bytes below the tree's root; its `name` is also what the user
+/// sees. Everything else describes the latest listing or resolution, which is a snapshot: it does not
+/// promise that the item still exists or has the same type.
+@MainActor final class RemoteDirectoryNode {
+
+    enum Kind: Equatable, Sendable {
+
+        case directory
+        case file
+        case symbolicLink
+        /// A device, socket or FIFO, which cannot be edited.
+        case other
+        /// The server did not tell the type.
+        case unknown
+
+
+        init(_ attributes: RemoteFileAttributes) {
+
+            self = switch attributes.kind {
+                case .directory: .directory
+                case .regular: .file
+                case .symbolicLink: .symbolicLink
+                case .other: .other
+                case .unknown: .unknown
+            }
+        }
+    }
+
+
+    /// What a link or an entry without a type turned out to be.
+    enum Resolution: Equatable {
+
+        case unresolved
+        case resolving
+        /// A folder inside the root, which can expand.
+        case directory(target: String)
+        /// A folder that is this node's own ancestor, which cannot expand.
+        case loop(target: String)
+        /// A folder outside the root, which opens only in a window of its own.
+        case outsideRoot(target: String)
+        /// A file, or an item that is not a folder.
+        case file(target: String)
+        /// A special file, which cannot be edited.
+        case other(target: String)
+        /// The link is broken, or the check failed.
+        case failed(message: String)
+    }
+
+
+    /// Why a folder shows no fresh contents.
+    enum Problem: Equatable {
+
+        /// The listing failed. Retry lists it again.
+        case failed(message: String)
+        /// The window is offline, and the folder was never listed. Reconnect lists it.
+        case offline
+        /// Listing it would exceed what the window keeps.
+        case windowLimit
+        /// The folder is deeper below the root than the tree goes.
+        case tooDeep
+    }
+
+
+    let name: String
+    let path: String
+    let depth: Int
+    fileprivate(set) weak var parent: RemoteDirectoryNode?
+
+    fileprivate(set) var attributes: RemoteFileAttributes
+    fileprivate(set) var kind: Kind
+    fileprivate(set) var resolution: Resolution = .unresolved
+
+    /// The listed entries, or `nil` if the folder was never listed or its contents were discarded.
+    fileprivate(set) var children: [RemoteDirectoryNode]?
+
+    /// The bound that cut the latest listing short, if one did.
+    fileprivate(set) var limit: RemoteListingLimit?
+
+    /// Entries of the latest listing that cannot be shown, such as names that are not valid UTF-8.
+    fileprivate(set) var omittedCount = 0
+
+    fileprivate(set) var isLoading = false
+    fileprivate(set) var problem: Problem?
+
+    /// Whether the children are the batches of a first listing that is still under way.
+    fileprivate(set) var isPartial = false
+
+    /// Whether the children are from before a refresh that has not succeeded yet, or from a restored snapshot.
+    fileprivate(set) var isStale = false
+
+    /// Whether the folder's type must be confirmed before it is listed again, because a refresh reported no type for it.
+    fileprivate(set) var needsConfirmation = false
+
+    fileprivate(set) var isExpanded = false
+
+    /// Advances whenever replies for this node must no longer apply: a new listing, a collapse, a type change.
+    fileprivate var generation = 0
+
+    /// The control of the running listing or resolution, which a collapse asks to cancel.
+    fileprivate var control: RemoteOperationControl?
+
+    /// Entries of a first listing that arrived and are not shown yet.
+    fileprivate var pendingEntries: [RemoteDirectoryEntry] = []
+
+
+    fileprivate init(name: String, path: String, depth: Int, parent: RemoteDirectoryNode?, attributes: RemoteFileAttributes) {
+
+        self.name = name
+        self.path = path
+        self.depth = depth
+        self.parent = parent
+        self.attributes = attributes
+        self.kind = Kind(attributes)
+    }
+
+
+    /// Whether the node is a folder that can be listed, as far as is known.
+    var isFolder: Bool {
+
+        switch (self.kind, self.resolution) {
+            case (.directory, _): true
+            case (.symbolicLink, .directory), (.unknown, .directory): true
+            default: false
+        }
+    }
+
+
+    /// Whether the node may turn out to be a folder once resolved, and so shows a disclosure triangle.
+    var mayBeFolder: Bool {
+
+        switch self.kind {
+            case .directory:
+                true
+            case .symbolicLink, .unknown:
+                switch self.resolution {
+                    case .unresolved, .resolving, .directory, .loop, .outsideRoot, .failed: true
+                    case .file, .other: false
+                }
+            case .file, .other:
+                false
+        }
+    }
+
+
+    /// Whether the name starts with a dot.
+    var isHidden: Bool {
+
+        self.name.hasPrefix(".")
+    }
+
+
+    /// The path of the item this node stands for, with links on its way resolved, as far as known.
+    var canonicalPath: String {
+
+        switch self.resolution {
+            case .directory(let target), .loop(let target), .outsideRoot(let target), .file(let target), .other(let target):
+                return target
+            default:
+                guard let parent else { return self.path }
+                return RemotePath.appending(self.name, to: parent.canonicalPath)
+        }
+    }
+
+
+    /// The components of the path below the root.
+    var relativeComponents: [String] {
+
+        var components: [String] = []
+        var node: RemoteDirectoryNode? = self
+        while let current = node, let parent = current.parent {
+            components.append(current.name)
+            node = parent
+        }
+
+        return components.reversed()
+    }
+
+
+    /// The name's bytes, which identify the node among its siblings.
+    fileprivate var key: [UInt8] {
+
+        Array(self.name.utf8)
+    }
+}
+
+
+/// The loaded part of a remote folder's tree, for one window.
+///
+/// Folders are listed when they expand, never all at once. Every reply is checked against the
+/// generation of the tree and of its folder, so a reply that arrives after a refresh, a collapse, a
+/// type change or a reconnect is dropped rather than bringing back what was replaced. A listing
+/// replaces a folder's children only when it succeeded; a failure keeps the previous children, marked
+/// stale. The tree never downloads a file and never changes an editor.
+@MainActor final class RemoteDirectoryTree {
+
+    /// A change the view must show.
+    enum Change {
+
+        /// The children of the node changed, or the whole tree when `nil`.
+        case children(RemoteDirectoryNode?)
+        /// The node's own row changed, such as its loading state.
+        case node(RemoteDirectoryNode)
+    }
+
+
+    let root: RemoteDirectoryNode
+
+    /// The bounds of the tree; each listing's own bounds come from the source.
+    var limits: RemoteLimits
+
+    /// Called after each change.
+    var onChange: (Change) -> Void = { _ in }
+
+    /// Whether the window is offline: folders that were never listed then wait for Reconnect.
+    var isOffline = false {
+
+        didSet {
+            guard oldValue != self.isOffline else { return }
+            self.onChange(.children(nil))
+        }
+    }
+
+    /// Called when a listing fails because the connection went away, so that the window can go offline.
+    var onConnectionFailure: (any Error) -> Void = { _ in }
+
+    private var source: any RemoteDirectoryTreeSource
+    private var generation = 0
+
+    /// The folders with batches waiting to be shown, and the task that shows them.
+    private var foldersWithPendingEntries: [RemoteDirectoryNode] = []
+    private var batchTask: Task<Void, Never>?
+
+    /// How often the batches of first listings are shown, so that a large folder does not redraw for every batch.
+    var batchInterval: Duration = .milliseconds(100)
+    private(set) var nodeCount = 1
+    private(set) var nameByteCount = 0
+
+
+    /// Creates the tree of a folder.
+    ///
+    /// - Parameters:
+    ///   - rootPath: The canonical path of the root folder.
+    ///   - source: Where listings come from.
+    ///   - limits: The bounds of each listing and of the whole tree.
+    init(rootPath: String, source: any RemoteDirectoryTreeSource, limits: RemoteLimits) {
+
+        self.root = RemoteDirectoryNode(name: RemoteFileIdentity.fileName(of: rootPath), path: rootPath, depth: 0, parent: nil,
+                                        attributes: RemoteFileAttributes(permissions: UInt32(S_IFDIR)))
+        self.root.isExpanded = true
+        self.source = source
+        self.limits = limits
+    }
+
+
+    // MARK: Browsing
+
+    /// Shows a folder's children, listing it first if it was never listed, and resolving a link or an
+    /// untyped entry first if it may be a folder.
+    func expand(_ node: RemoteDirectoryNode) {
+
+        guard node.isAttached(to: self.root), node.mayBeFolder else { return }
+
+        let wasExpanded = node.isExpanded
+        node.isExpanded = true
+
+        // Expanding what is expanded and listed changes nothing, so it reports nothing: a view that
+        // reloads on every change and expands again on every reload would otherwise never settle.
+        if node.needsConfirmation || (node.kind != .directory && node.isUnresolved) {
+            self.resolve(node, thenLoad: true)
+        } else if node.isFolder, !node.isLoading, node.children == nil || node.problem != nil || node.isStale {
+            self.load(node)
+        } else if !wasExpanded {
+            self.onChange(.node(node))
+        }
+    }
+
+
+    /// Hides a folder's children and stops any listing under way below it.
+    func collapse(_ node: RemoteDirectoryNode) {
+
+        guard node !== self.root, node.isExpanded else { return }
+
+        node.isExpanded = false
+        self.cancelWork(in: node)
+        self.onChange(.node(node))
+    }
+
+
+    /// Lists one folder again, keeping its current children until the new listing is complete.
+    ///
+    /// Folders below it are not listed again; their contents are marked stale instead.
+    func reload(_ node: RemoteDirectoryNode) {
+
+        guard node.isAttached(to: self.root) else { return }
+
+        if node.needsConfirmation || (node.kind != .directory && !node.isFolder) {
+            self.resolve(node, thenLoad: true)
+        } else if node.isFolder {
+            self.load(node, cascades: false)
+        }
+    }
+
+
+    /// Lists the root and every expanded folder again. Folders that are collapsed but were listed are
+    /// only marked stale, and are listed again when they expand.
+    func refresh() {
+
+        self.refresh(self.root)
+    }
+
+
+    /// Finds out what a link or an untyped entry is.
+    ///
+    /// - Parameters:
+    ///   - node: The link or entry.
+    ///   - thenLoad: Whether to list it if it turns out to be a folder inside the root.
+    ///   - completion: Called once the resolution is known, unless the node changed meanwhile.
+    func resolve(_ node: RemoteDirectoryNode, thenLoad: Bool = false, completion: ((RemoteDirectoryNode) -> Void)? = nil) {
+
+        guard node.isAttached(to: self.root), node !== self.root else { return }
+        guard !self.isOffline else {
+            node.problem = .offline
+            return self.onChange(.node(node))
+        }
+
+        node.generation += 1
+        let generation = node.generation
+        let treeGeneration = self.generation
+        let control = RemoteOperationControl()
+        node.control?.requestCancel()
+        node.control = control
+        node.resolution = .resolving
+        node.problem = nil
+        self.onChange(.node(node))
+
+        let source = self.source
+        let path = node.path
+        Task {
+            let result = await Result { try await source.resolve(path, control: control) }
+
+            guard self.generation == treeGeneration, node.generation == generation, node.isAttached(to: self.root) else { return }
+            node.control = nil
+
+            switch result {
+                case .success(let item):
+                    let previousPath = node.canonicalPath
+                    node.resolution = self.resolution(of: item, for: node)
+                    node.needsConfirmation = false
+
+                    // A folder that now leads elsewhere, or is no folder any more, keeps nothing of what was listed for it.
+                    if node.children != nil, !node.isFolder || !RemotePath.isSame(previousPath, node.canonicalPath) {
+                        let isExpanded = node.isExpanded
+                        self.discardDescendants(of: node)
+                        node.isExpanded = isExpanded && node.isFolder
+                    }
+
+                    if thenLoad, node.isFolder, node.isExpanded {
+                        self.load(node)
+                    }
+                    completion?(node)
+                case .failure(is RemoteOperationCanceled):
+                    node.resolution = .unresolved
+                case .failure(let error):
+                    node.resolution = .failed(message: error.localizedDescription)
+                    self.noteFailure(error)
+            }
+            self.onChange(.children(node))
+        }
+    }
+
+
+    /// Makes every reply under way stale, as after reconnecting or closing the window.
+    func invalidate() {
+
+        self.generation += 1
+        self.cancelWork(in: self.root)
+    }
+
+
+    /// Replaces where listings come from, such as with a new connection after reconnecting.
+    func replaceSource(_ source: any RemoteDirectoryTreeSource) {
+
+        self.invalidate()
+        self.source = source
+    }
+
+
+    // MARK: Changes by the Window
+
+    /// Adds an item that the window created or moved here, once the server confirmed it.
+    ///
+    /// A folder that was never listed shows the item alone, marked stale, until its listing arrives.
+    ///
+    /// - Returns: The item's node, or `nil` if the folder is not part of the tree or its name cannot be a path component.
+    @discardableResult func insert(_ entry: RemoteDirectoryEntry, into folder: RemoteDirectoryNode) -> RemoteDirectoryNode? {
+
+        guard
+            folder.isAttached(to: self.root),
+            folder.isFolder || folder === self.root,
+            let path = RemotePath.child(entry.name, of: folder.path)
+        else { return nil }
+
+        if let existing = folder.children?.first(where: { RemotePath.isSame($0.name, entry.name) }) {
+            self.update(existing, with: entry.attributes)
+            self.onChange(.children(folder))
+            return existing
+        }
+
+        let node = RemoteDirectoryNode(name: entry.name, path: path, depth: folder.depth + 1, parent: folder, attributes: entry.attributes)
+        if folder.children == nil {
+            folder.children = []
+            folder.isStale = true
+        }
+        folder.children?.append(node)
+        self.nodeCount += 1
+        self.nameByteCount += entry.name.utf8.count
+        self.onChange(.children(folder))
+
+        return node
+    }
+
+
+    /// Removes an item that the window deleted or moved away, once the server confirmed it, with everything listed below it.
+    func remove(_ node: RemoteDirectoryNode) {
+
+        guard node !== self.root, node.isAttached(to: self.root), let parent = node.parent else { return }
+
+        self.nodeCount -= self.subtreeCount(node)
+        self.nameByteCount -= self.subtreeNameBytes(node)
+        parent.children?.removeAll { $0 === node }
+        self.detach(node)
+        self.onChange(.children(parent))
+    }
+
+
+    /// Lists a folder again after the window changed it, starting over if a listing is under way, so
+    /// that a reply sent before the change cannot undo it.
+    func relist(_ folder: RemoteDirectoryNode) {
+
+        guard folder.isAttached(to: self.root), folder.isFolder || folder === self.root else { return }
+
+        if folder.isLoading {
+            folder.generation += 1
+            folder.control?.requestCancel()
+            folder.control = nil
+            folder.isLoading = false
+            folder.pendingEntries.removeAll()
+        }
+        self.load(folder)
+    }
+
+
+    /// Lists the folders below the root that were never listed, level by level, without expanding them,
+    /// so that a filter can find names in the whole folder, as the local file browser's filter does.
+    ///
+    /// Links and entries without a type are not followed, and hidden folders are listed only if asked.
+    /// It stops when the task is canceled, the window goes offline, or the tree is nearly full, so that
+    /// listing more never makes the tree give up rows of collapsed folders.
+    ///
+    /// - Parameter includesHidden: Whether to list folders whose name, or a name above them, starts with a dot.
+    func listUnlistedFolders(includesHidden: Bool) async {
+
+        let concurrency = max(self.limits.browsingRequestsInFlight, 1)
+
+        // Each round lists one more level at least, so the depth bounds the rounds even if listings keep being dropped.
+        for _ in 0..<self.limits.maximumTreeDepth where !Task.isCancelled && !self.isOffline {
+            var candidates: [RemoteDirectoryNode] = []
+            func collect(_ node: RemoteDirectoryNode) {
+                for child in node.children ?? [] where child.kind == .directory && (includesHidden || !child.isHidden) {
+                    if child.children == nil {
+                        if !child.isLoading, child.problem == nil, child.depth < self.limits.maximumTreeDepth {
+                            candidates.append(child)
+                        }
+                    } else {
+                        collect(child)
+                    }
+                }
+            }
+            collect(self.root)
+            guard !candidates.isEmpty else { return }
+
+            for batch in stride(from: 0, to: candidates.count, by: concurrency).map({ candidates[$0..<min($0 + concurrency, candidates.count)] }) {
+                guard
+                    !Task.isCancelled, !self.isOffline,
+                    self.nodeCount < self.limits.maximumTreeNodes * 9 / 10,
+                    self.nameByteCount < self.limits.maximumTreeNameBytes * 9 / 10
+                else { return }
+
+                // A folder the search lists never makes others give way; one that does not fit ends the search.
+                let tasks = batch.compactMap { $0.isAttached(to: self.root) ? self.load($0, evictsOthers: false) : nil }
+                for task in tasks {
+                    await task.value
+                }
+                guard !batch.contains(where: { $0.problem == .windowLimit }) else { return }
+            }
+        }
+    }
+
+
+    /// Whether a listing or resolution is under way anywhere in the tree.
+    var isBusy: Bool {
+
+        var isBusy = false
+        self.forEachNode(self.root) { node in
+            isBusy = isBusy || node.isLoading || node.resolution == .resolving
+        }
+
+        return isBusy
+    }
+
+
+    /// The node at a path below the root, if it is loaded.
+    func node(atRelativePath components: [String]) -> RemoteDirectoryNode? {
+
+        var node = self.root
+        for component in components {
+            guard let child = node.children?.first(where: { RemotePath.isSame($0.name, component) }) else { return nil }
+            node = child
+        }
+
+        return node
+    }
+
+
+    /// The children to show, in display order: folders first, then by name, and by the names' bytes
+    /// where names compare as equal.
+    ///
+    /// - Parameters:
+    ///   - node: The folder.
+    ///   - showsHiddenFiles: Whether to include names starting with a dot.
+    func visibleChildren(of node: RemoteDirectoryNode, showsHiddenFiles: Bool) -> [RemoteDirectoryNode] {
+
+        (node.children ?? [])
+            .filter { showsHiddenFiles || !$0.isHidden }
+            .sorted(by: RemoteDirectoryNode.displayOrder)
+    }
+
+
+    // MARK: Private Methods
+
+    private func refresh(_ node: RemoteDirectoryNode) {
+
+        // A folder that was never listed is listed only if it is expanded, such as after its listing failed.
+        guard node.children != nil || node.isExpanded || node === self.root else { return }
+
+        if node.isExpanded || node === self.root {
+            // A link is resolved again, since it may now lead elsewhere; resolving also confirms a folder that lost its type.
+            if node !== self.root, node.kind == .symbolicLink || node.kind == .unknown {
+                self.resolve(node, thenLoad: true)
+            } else {
+                self.load(node, cascades: true)
+            }
+        } else {
+            self.markStale(node)
+        }
+    }
+
+
+    private func markStale(_ node: RemoteDirectoryNode) {
+
+        guard node.children != nil else { return }
+
+        node.isStale = true
+        for child in node.children ?? [] {
+            self.markStale(child)
+        }
+    }
+
+
+    /// Lists a folder and replaces its children with the listing once it is complete.
+    ///
+    /// - Parameters:
+    ///   - node: The folder.
+    ///   - cascades: Whether to list the expanded folders below it again afterwards, as a refresh does.
+    ///   - evictsOthers: Whether collapsed folders elsewhere may give up their rows to make room.
+    @discardableResult private func load(_ node: RemoteDirectoryNode, cascades: Bool = false, evictsOthers: Bool = true) -> Task<Void, Never>? {
+
+        guard !node.isLoading else { return nil }
+
+        guard !self.isOffline else {
+            if node.children == nil {
+                node.problem = .offline
+            }
+            self.onChange(.node(node))
+            return nil
+        }
+        guard node.depth < self.limits.maximumTreeDepth else {
+            node.problem = .tooDeep
+            self.onChange(.node(node))
+            return nil
+        }
+
+        node.generation += 1
+        let generation = node.generation
+        let treeGeneration = self.generation
+        let control = RemoteOperationControl()
+        node.control?.requestCancel()
+        node.control = control
+        node.isLoading = true
+        node.problem = nil
+        self.onChange(.node(node))
+
+        let source = self.source
+        let path = node.path
+        // Only a folder that shows nothing yet shows its first batches; one that was listed keeps its rows until the new listing is complete.
+        let showsBatches = (node.children == nil)
+        return Task {
+            let result = await Result {
+                if showsBatches {
+                    try await source.list(path, control: control) { entries in
+                        Task { @MainActor in
+                            self.receive(entries, for: node, generation: generation, treeGeneration: treeGeneration)
+                        }
+                    }
+                } else {
+                    try await source.list(path, control: control)
+                }
+            }
+
+            // A reply for a folder that was collapsed, replaced or refreshed since, or for an earlier connection, is dropped.
+            guard self.generation == treeGeneration, node.generation == generation, node.isAttached(to: self.root) else { return }
+            node.control = nil
+            node.isLoading = false
+            node.pendingEntries.removeAll()
+            let wasPartial = node.isPartial
+            node.isPartial = false
+
+            switch result {
+                case .success(let listing):
+                    self.apply(listing, to: node, cascades: cascades, evictsOthers: evictsOthers)
+                    if wasPartial, node.problem != nil {
+                        node.isStale = true
+                    }
+                case .failure(is RemoteOperationCanceled):
+                    if wasPartial {
+                        node.isStale = true
+                    }
+                case .failure(let error):
+                    node.problem = .failed(message: error.localizedDescription)
+                    if node.children != nil {
+                        node.isStale = true
+                    }
+                    self.noteFailure(error)
+            }
+            self.onChange(.children(node))
+        }
+    }
+
+
+    /// Keeps the entries of a batch of a first listing, to show them with the next batches.
+    private func receive(_ entries: [RemoteDirectoryEntry], for node: RemoteDirectoryNode, generation: Int, treeGeneration: Int) {
+
+        guard self.generation == treeGeneration, node.generation == generation, node.isLoading else { return }
+
+        if node.pendingEntries.isEmpty {
+            self.foldersWithPendingEntries.append(node)
+        }
+        node.pendingEntries += entries
+
+        guard self.batchTask == nil else { return }
+        self.batchTask = Task { [weak self, interval = self.batchInterval] in
+            try? await Task.sleep(for: interval)
+            self?.showPendingEntries()
+        }
+    }
+
+
+    /// Shows the batches that arrived, as the children of folders whose first listing is still under way.
+    ///
+    /// The complete listing replaces them, keeping the nodes of the entries it has too.
+    private func showPendingEntries() {
+
+        self.batchTask = nil
+        let folders = self.foldersWithPendingEntries
+        self.foldersWithPendingEntries.removeAll()
+
+        for node in folders where node.isLoading && node.isAttached(to: self.root) {
+            let entries = node.pendingEntries
+            node.pendingEntries.removeAll()
+
+            var known = Set((node.children ?? []).map(\.key))
+            var children = node.children ?? []
+            for entry in entries {
+                guard
+                    self.nodeCount < self.limits.maximumTreeNodes,
+                    self.nameByteCount + entry.name.utf8.count <= self.limits.maximumTreeNameBytes,
+                    known.insert(Array(entry.name.utf8)).inserted,
+                    let path = RemotePath.child(entry.name, of: node.path)
+                else { continue }
+
+                children.append(RemoteDirectoryNode(name: entry.name, path: path, depth: node.depth + 1, parent: node, attributes: entry.attributes))
+                self.nodeCount += 1
+                self.nameByteCount += entry.name.utf8.count
+            }
+            guard !children.isEmpty else { continue }
+
+            node.children = children
+            node.isPartial = true
+            self.onChange(.children(node))
+        }
+    }
+
+
+    /// Replaces a folder's children with a complete listing.
+    ///
+    /// Children whose name and type are unchanged stay the same nodes, so their expansion and
+    /// selection survive. A folder that became something else loses what was listed below it.
+    private func apply(_ listing: RemoteDirectoryListing, to node: RemoteDirectoryNode, cascades: Bool, evictsOthers: Bool) {
+
+        let previous = Dictionary((node.children ?? []).map { ($0.key, $0) }, uniquingKeysWith: { first, _ in first })
+        var children: [RemoteDirectoryNode] = []
+        var kept: Set<ObjectIdentifier> = []
+        var addedCount = 0
+        var addedBytes = 0
+
+        for entry in listing.entries {
+            guard let path = RemotePath.child(entry.name, of: node.path) else { continue }
+
+            if let child = previous[Array(entry.name.utf8)] {
+                kept.insert(ObjectIdentifier(child))
+                self.update(child, with: entry.attributes)
+                children.append(child)
+            } else {
+                children.append(RemoteDirectoryNode(name: entry.name, path: path, depth: node.depth + 1, parent: node, attributes: entry.attributes))
+                addedCount += 1
+                addedBytes += entry.name.utf8.count
+            }
+        }
+
+        let removed = (node.children ?? []).filter { !kept.contains(ObjectIdentifier($0)) }
+        let removedCount = removed.reduce(0) { $0 + self.subtreeCount($1) }
+        let removedBytes = removed.reduce(0) { $0 + self.subtreeNameBytes($1) }
+
+        // Collapsed branches elsewhere give way first; a folder that still does not fit shows the limit.
+        let neededCount = self.nodeCount - removedCount + addedCount - self.limits.maximumTreeNodes
+        let neededBytes = self.nameByteCount - removedBytes + addedBytes - self.limits.maximumTreeNameBytes
+        if evictsOthers, neededCount > 0 || neededBytes > 0 {
+            self.evictCollapsedBranches(sparing: node, count: neededCount, bytes: neededBytes)
+        }
+        guard
+            self.nodeCount - removedCount + addedCount <= self.limits.maximumTreeNodes,
+            self.nameByteCount - removedBytes + addedBytes <= self.limits.maximumTreeNameBytes
+        else {
+            node.problem = .windowLimit
+            return
+        }
+
+        for child in removed {
+            self.detach(child)
+        }
+        self.nodeCount += addedCount - removedCount
+        self.nameByteCount += addedBytes - removedBytes
+
+        node.children = children
+        node.isPartial = false
+        node.limit = listing.limit
+        node.omittedCount = listing.omittedCount
+        node.isStale = false
+        node.problem = nil
+
+        // What was listed below may be outdated as well: expanded folders are listed again on a refresh,
+        // and the others list again when they expand.
+        for child in children where child.children != nil || child.isExpanded {
+            if cascades, child.isExpanded {
+                self.refresh(child)
+            } else {
+                self.markStale(child)
+            }
+        }
+    }
+
+
+    /// Takes the attributes of a new listing, discarding what was listed below a folder that changed type.
+    private func update(_ node: RemoteDirectoryNode, with attributes: RemoteFileAttributes) {
+
+        let kind = RemoteDirectoryNode.Kind(attributes)
+        let previousKind = node.kind
+        node.attributes = attributes
+
+        guard kind != previousKind else { return }
+
+        if previousKind == .directory, kind == .unknown {
+            // Without a type, the folder may still be one: its children stay as context, waiting for confirmation.
+            node.kind = kind
+            node.needsConfirmation = true
+            node.resolution = .unresolved
+            self.cancelWork(in: node)
+            self.markStale(node)
+            return
+        }
+
+        node.kind = kind
+        node.resolution = .unresolved
+        node.needsConfirmation = false
+        self.discardDescendants(of: node)
+    }
+
+
+    /// Forgets everything listed below a node and stops its work, so that no late reply brings it back.
+    private func discardDescendants(of node: RemoteDirectoryNode) {
+
+        self.cancelWork(in: node)
+        for child in node.children ?? [] {
+            self.detach(child)
+            self.nodeCount -= self.subtreeCount(child)
+            self.nameByteCount -= self.subtreeNameBytes(child)
+        }
+        node.children = nil
+        node.limit = nil
+        node.omittedCount = 0
+        node.isStale = false
+        node.isExpanded = false
+        node.problem = nil
+    }
+
+
+    /// Stops the listings under way in a branch, and makes their replies stale.
+    private func cancelWork(in node: RemoteDirectoryNode) {
+
+        self.forEachNode(node) { node in
+            node.generation += 1
+            node.control?.requestCancel()
+            node.control = nil
+            node.isLoading = false
+            node.pendingEntries.removeAll()
+            if node.isPartial {
+                // What arrived of a listing that stopped is only part of the folder.
+                node.isPartial = false
+                node.isStale = true
+            }
+            if node.resolution == .resolving {
+                node.resolution = .unresolved
+            }
+        }
+    }
+
+
+    private func detach(_ node: RemoteDirectoryNode) {
+
+        self.cancelWork(in: node)
+        node.parent = nil
+    }
+
+
+    /// Discards the children of collapsed folders until enough nodes and name bytes are free.
+    private func evictCollapsedBranches(sparing spared: RemoteDirectoryNode, count: Int, bytes: Int) {
+
+        var count = count
+        var bytes = bytes
+        var candidates: [RemoteDirectoryNode] = []
+        self.forEachNode(self.root) { node in
+            if node !== self.root, !node.isExpanded, node.children != nil, node !== spared, !spared.isDescendant(of: node) {
+                candidates.append(node)
+            }
+        }
+
+        for node in candidates where count > 0 || bytes > 0 {
+            guard node.isAttached(to: self.root), node.children != nil else { continue }
+            let freedCount = self.subtreeCount(node) - 1
+            let freedBytes = self.subtreeNameBytes(node) - node.name.utf8.count
+            self.discardDescendants(of: node)
+            count -= freedCount
+            bytes -= freedBytes
+        }
+    }
+
+
+    private func resolution(of item: RemoteResolvedItem, for node: RemoteDirectoryNode) -> RemoteDirectoryNode.Resolution {
+
+        switch item.kind {
+            case .directory:
+                // The folder a link leads to must not be the link's own folder or one above it, or it would expand forever.
+                let parentPath = node.parent?.canonicalPath ?? self.root.path
+                if RemotePath.isAncestor(item.target, of: parentPath) {
+                    return .loop(target: item.target)
+                }
+                guard RemotePath.isAncestor(self.root.path, of: item.target) else { return .outsideRoot(target: item.target) }
+                return .directory(target: item.target)
+            case .file, .unknown:
+                return .file(target: item.target)
+            case .other, .symbolicLink:
+                return .other(target: item.target)
+        }
+    }
+
+
+    private func noteFailure(_ error: any Error) {
+
+        if error is RemoteConnectionError {
+            self.onConnectionFailure(error)
+        }
+    }
+
+
+    private func subtreeCount(_ node: RemoteDirectoryNode) -> Int {
+
+        1 + (node.children ?? []).reduce(0) { $0 + self.subtreeCount($1) }
+    }
+
+
+    private func subtreeNameBytes(_ node: RemoteDirectoryNode) -> Int {
+
+        node.name.utf8.count + (node.children ?? []).reduce(0) { $0 + self.subtreeNameBytes($1) }
+    }
+
+
+    private func forEachNode(_ node: RemoteDirectoryNode, _ body: (RemoteDirectoryNode) -> Void) {
+
+        body(node)
+        for child in node.children ?? [] {
+            self.forEachNode(child, body)
+        }
+    }
+}
+
+
+// MARK: Snapshot
+
+extension RemoteDirectoryTree {
+
+    /// The loaded part of a tree, as a restored window shows it before it reconnects.
+    struct Snapshot: Codable, Equatable, Sendable {
+
+        struct Entry: Codable, Equatable, Sendable {
+
+            /// The path below the root.
+            var components: [String]
+            var permissions: UInt32?
+            var isExpanded: Bool
+            /// Whether the entry is a folder whose children follow.
+            var isListed: Bool
+        }
+
+
+        /// Parents come before their children.
+        var entries: [Entry]
+    }
+
+
+    /// The loaded nodes, within the tree's own budget.
+    var snapshot: Snapshot {
+
+        var entries: [Snapshot.Entry] = []
+        var bytes = 0
+
+        func add(_ node: RemoteDirectoryNode) {
+            for child in node.children ?? [] {
+                bytes += child.relativeComponents.reduce(0) { $0 + $1.utf8.count }
+                guard entries.count < self.limits.maximumTreeNodes, bytes <= self.limits.maximumTreeNameBytes else { return }
+                entries.append(.init(components: child.relativeComponents, permissions: child.attributes.permissions,
+                                     isExpanded: child.isExpanded, isListed: child.children != nil))
+                add(child)
+            }
+        }
+        add(self.root)
+
+        return Snapshot(entries: entries)
+    }
+
+
+    /// The paths of the expanded folders below the root.
+    var expandedPaths: [[String]] {
+
+        var paths: [[String]] = []
+        self.forEachNode(self.root) { node in
+            if node !== self.root, node.isExpanded {
+                paths.append(node.relativeComponents)
+            }
+        }
+
+        return paths
+    }
+
+
+    /// Shows a snapshot as stale contents, without listing anything.
+    ///
+    /// The snapshot is untrusted: an entry whose components are invalid, too deep, beyond the budget,
+    /// or whose parent was not listed, is left out with everything below it.
+    func restore(_ snapshot: Snapshot) {
+
+        self.discardDescendants(of: self.root)
+        self.root.isExpanded = true
+
+        for entry in snapshot.entries {
+            guard
+                !entry.components.isEmpty,
+                entry.components.count < self.limits.maximumTreeDepth,
+                entry.components.allSatisfy(RemotePath.isValidComponent),
+                self.nodeCount < self.limits.maximumTreeNodes,
+                self.nameByteCount + (entry.components.last?.utf8.count ?? 0) <= self.limits.maximumTreeNameBytes
+            else { continue }
+
+            let parent: RemoteDirectoryNode
+            if entry.components.count == 1 {
+                if self.root.children == nil {
+                    self.root.children = []
+                }
+                parent = self.root
+            } else {
+                guard let found = self.node(atRelativePath: Array(entry.components.dropLast())), found.children != nil else { continue }
+                parent = found
+            }
+
+            let name = entry.components.last!
+            guard
+                !(parent.children ?? []).contains(where: { RemotePath.isSame($0.name, name) }),
+                let path = RemotePath.child(name, of: parent.path)
+            else { continue }
+
+            let node = RemoteDirectoryNode(name: name, path: path, depth: parent.depth + 1, parent: parent,
+                                           attributes: RemoteFileAttributes(permissions: entry.permissions))
+            node.isExpanded = entry.isExpanded && node.kind == .directory
+            node.isStale = true
+            if entry.isListed, node.kind == .directory {
+                node.children = []
+            }
+            parent.children?.append(node)
+            self.nodeCount += 1
+            self.nameByteCount += name.utf8.count
+        }
+        self.root.isStale = (self.root.children != nil)
+        self.onChange(.children(nil))
+    }
+
+
+    /// Expands the folders at the paths as far as they are loaded, as after restoring a snapshot.
+    func markExpanded(_ paths: [[String]]) {
+
+        for components in paths.sorted(by: { $0.count < $1.count }) {
+            guard let node = self.node(atRelativePath: components), node.mayBeFolder else { continue }
+            node.isExpanded = true
+        }
+    }
+}
+
+
+// MARK: -
+
+extension RemoteDirectoryNode {
+
+    /// The display order of a folder's entries: folders first, then by name as the Finder sorts,
+    /// then by the names' bytes, so that names differing only in normalization keep a fixed order.
+    static func displayOrder(_ lhs: RemoteDirectoryNode, _ rhs: RemoteDirectoryNode) -> Bool {
+
+        if lhs.isFolder != rhs.isFolder { return lhs.isFolder }
+
+        switch lhs.name.localizedStandardCompare(rhs.name) {
+            case .orderedAscending: return true
+            case .orderedDescending: return false
+            case .orderedSame: return lhs.name.utf8.lexicographicallyPrecedes(rhs.name.utf8)
+        }
+    }
+
+
+    /// Whether a link or untyped entry still has to be resolved before it can expand.
+    var isUnresolved: Bool {
+
+        switch self.resolution {
+            case .unresolved, .failed: true
+            default: false
+        }
+    }
+
+
+    /// Whether the node is still part of the tree with the root, rather than removed by a newer listing.
+    func isAttached(to root: RemoteDirectoryNode) -> Bool {
+
+        var node = self
+        while let parent = node.parent {
+            guard parent.children?.contains(where: { $0 === node }) == true else { return false }
+            node = parent
+        }
+
+        return node === root
+    }
+
+
+    func isDescendant(of ancestor: RemoteDirectoryNode) -> Bool {
+
+        var node = self.parent
+        while let current = node {
+            if current === ancestor { return true }
+            node = current.parent
+        }
+
+        return false
+    }
+
+}
+
+
+private extension Result where Failure == any Error {
+
+    init(catching body: () async throws -> Success) async {
+
+        do {
+            self = .success(try await body())
+        } catch {
+            self = .failure(error)
+        }
+    }
+}
