+
+    // MARK: Filter
+
+    @objc private func filterTextDidChange(_ sender: NSSearchField) {
+
+        self.filterText = sender.stringValue
+        self.reloadKeepingSelection()
+        self.updateSearch()
+    }
+
+
+    /// Lists the folders not listed yet while the filter is in use, after a moment, as the local file
+    /// browser searches its folder; clearing the filter stops it. What is listed stays, collapsed.
+    private func updateSearch() {
+
+        guard !self.filterText.isEmpty, self.session.status == .online else {
+            self.searchTask?.cancel()
+            self.searchTask = nil
+            self.searchProgressIndicator.stopAnimation(nil)
+            return
+        }
+        guard self.searchTask == nil else { return }
+
+        self.searchTask = Task { [weak self] in
+            try? await Task.sleep(for: .seconds(0.5))
+            guard let self, !Task.isCancelled else { return }
+
+            self.searchProgressIndicator.startAnimation(nil)
+            await self.session.tree.listUnlistedFolders(includesHidden: self.session.showsHiddenFiles)
+            guard !Task.isCancelled else { return }
+            self.searchProgressIndicator.stopAnimation(nil)
+            self.searchTask = nil
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    private var clickedNode: RemoteDirectoryNode? {
+
+        let row = self.outlineView.clickedRow
+        return (row >= 0) ? self.outlineView.item(atRow: row) as? RemoteDirectoryNode : nil
+    }
+
+
+    /// The node a context menu command applies to: the clicked row, or else the selected one.
+    private var targetNode: RemoteDirectoryNode? {
+
+        let row = self.outlineView.clickedRow
+        if row >= 0 {
+            return self.outlineView.item(atRow: row) as? RemoteDirectoryNode
+        }
+        return self.outlineView.item(atRow: self.outlineView.selectedRow) as? RemoteDirectoryNode
+    }
+
+
+    private func openSelection() {
+
+        guard let node = self.outlineView.item(atRow: self.outlineView.selectedRow) as? RemoteDirectoryNode else { return }
+
+        if node.isFolder {
+            if self.outlineView.isItemExpanded(node) {
+                self.outlineView.collapseItem(node)
+            } else {
+                self.outlineView.expandItem(node)
+            }
+        } else {
+            self.session.activate(node)
+        }
+    }
+
+
+    private func deleteSelection() {
+
+        guard
+            self.session.status == .online,
+            let node = self.outlineView.item(atRow: self.outlineView.selectedRow) as? RemoteDirectoryNode,
+            !self.session.isChanging(node)
+        else { return NSSound.beep() }
+
+        self.confirmDeletion(of: node)
+    }
+
+
+    /// The folder a New File or New Folder command creates the item in: the clicked or selected folder,
+    /// the folder of the clicked or selected file, or the root.
+    private func targetFolder(for sender: Any?) -> RemoteDirectoryNode? {
+
+        let root = self.session.tree.root
+        let isContextMenu = (sender as? NSMenuItem)?.menu === self.outlineView.menu
+        let node = isContextMenu ? self.targetNode : (self.outlineView.item(atRow: self.outlineView.selectedRow) as? RemoteDirectoryNode)
+
+        guard let node else { return root }
+        if node.isFolder { return node }
+        guard let parent = node.parent, parent === root || parent.isFolder else { return nil }
+
+        return parent
+    }
+
+
+    private func createItem(_ kind: RemoteFolderChanges.Kind, sender: Any?) {
+
+        guard let folder = self.targetFolder(for: sender) else { return }
+
+        if !self.filterText.isEmpty {
+            self.filterField.stringValue = ""
+            self.filterTextDidChange(self.filterField)
+        }
+
+        Task {
+            do {
+                guard let node = try await self.session.createItem(kind, in: folder) else { return }
+                self.session.onBeginRenaming(node)
+            } catch {
+                self.present(error)
+            }
+        }
+    }
+
+
+    /// Selects an item's row and starts editing its name, with the name selected up to its extension.
+    func beginRenaming(_ node: RemoteDirectoryNode) {
+
+        let row = self.outlineView.row(forItem: node)
+        guard
+            row >= 0,
+            self.session.status == .online,
+            let cell = self.outlineView.view(atColumn: 0, row: row, makeIfNecessary: true) as? RemoteFileCellView
+        else { return }
+
+        self.outlineView.selectRowIndexes([row], byExtendingSelection: false)
+        self.outlineView.scrollRowToVisible(row)
+        cell.beginEditingName(node.name, delegate: self)
+        self.outlineView.editColumn(0, row: row, with: nil, select: false)
+
+        if let editor = cell.textField?.currentEditor() {
+            let name = node.name as NSString
+            let stemLength = (node.isFolder || name.pathExtension.isEmpty || name.hasPrefix(".")) ? name.length : name.deletingPathExtension.utf16.count
+            editor.selectedRange = NSRange(location: 0, length: stemLength)
+        }
+    }
+
+
+    /// Asks whether to delete an item permanently, then deletes it.
+    private func confirmDeletion(of node: RemoteDirectoryNode) {
+
+        guard let window = self.view.window else { return }
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = String(localized: "RemoteFolder.delete.message", defaultValue: "Do you want to delete “\(node.name)” from the server?", table: "Remote",
+                                   comment: "%@ is a file name")
+        alert.informativeText = node.isFolder
+            ? String(localized: "RemoteFolder.delete.folderInformation",
+                     defaultValue: "Everything in the folder is deleted too. The server has no Trash, so this can’t be undone.", table: "Remote")
+            : String(localized: "RemoteFolder.delete.information", defaultValue: "The server has no Trash, so this can’t be undone.", table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemoteFolder.delete.button", defaultValue: "Delete", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.buttons.first?.hasDestructiveAction = true
+        alert.buttons.first?.keyEquivalent = ""
+
+        Task {
+            guard await alert.beginSheetModal(for: window) == .alertFirstButtonReturn else { return }
+            do {
+                try await self.session.delete(node)
+            } catch {
+                self.present(error)
+            }
+        }
+    }
+
+
+    /// Shows why a change failed, unless the user canceled it.
+    private func present(_ error: any Error) {
+
+        guard !(error is RemoteOperationCanceled), !(error is CancellationError) else { return }
+
+        if let directory = self.session.directory {
+            directory.presentErrorAsSheet(error)
+        } else {
+            self.presentError(error)
+        }
+    }
+
+
+    @objc private func retryClicked(_ sender: NSButton) {
+
+        let row = self.outlineView.row(for: sender)
+        guard row >= 0, let status = self.outlineView.item(atRow: row) as? StatusItem else { return }
+
+        self.retry(status)
+    }
+
+
+    private func retry(_ status: StatusItem) {
+
+        guard status.kind == .problem else { return }
+
+        if status.node.problem == .offline || self.session.status != .online {
+            self.session.reconnect()
+        } else if status.node.resolution != .unresolved, !status.node.isFolder {
+            self.session.tree.resolve(status.node, thenLoad: true)
+        } else {
+            self.session.tree.reload(status.node)
+        }
+    }
+
+
+    /// The rows below an item: its visible entries, then rows for its state.
+    private func displayedChildren(of item: Any?) -> [Any] {
+
+        guard let node = (item as? RemoteDirectoryNode) ?? (item == nil ? self.session.tree.root : nil) else { return [] }
+
+        var children: [Any] = self.session.tree.visibleChildren(of: node, showsHiddenFiles: self.session.showsHiddenFiles)
+            .filter { self.filterText.isEmpty || self.matchesFilter($0) }
+
+        // The root's state shows in the header and the message, not as rows, except while its first batches show.
+        guard node !== self.session.tree.root || node.problem != nil || node.isPartial else { return children }
+
+        if node.isLoading, node.children == nil || node.isPartial {
+            children.append(self.statusItem(.loading, for: node))
+        }
+        if node.problem != nil || self.resolutionProblem(of: node) != nil {
+            children.append(self.statusItem(.problem, for: node))
+        }
+        if node.limit != nil {
+            children.append(self.statusItem(.incomplete, for: node))
+        }
+        if node.omittedCount > 0 {
+            children.append(self.statusItem(.omitted, for: node))
+        }
+        if node !== self.session.tree.root, node.children?.isEmpty == true, node.problem == nil, self.filterText.isEmpty {
+            children.append(self.statusItem(.empty, for: node))
+        }
+
+        return children
+    }
+
+
+    private func resolutionProblem(of node: RemoteDirectoryNode) -> String? {
+
+        switch node.resolution {
+            case .failed(let message): message
+            case .loop: String(localized: "RemoteFolder.status.loop", defaultValue: "This link leads to a folder that contains it.", table: "Remote")
+            case .outsideRoot(let target):
+                String(localized: "RemoteFolder.status.outsideRoot", defaultValue: "This link leads outside the folder, to \(target).", table: "Remote",
+                       comment: "%@ is a path on the server")
+            default: nil
+        }
+    }
+
+
+    private func statusItem(_ kind: StatusItem.Kind, for node: RemoteDirectoryNode) -> StatusItem {
+
+        let id = ObjectIdentifier(node)
+        if let item = self.statusItems[id]?[kind], item.node === node { return item }
+
+        let item = StatusItem(kind: kind, node: node)
+        self.statusItems[id, default: [:]][kind] = item
+        return item
+    }
+
+
+    /// Whether a loaded node or one of its loaded descendants matches the filter.
+    private func matchesFilter(_ node: RemoteDirectoryNode) -> Bool {
+
+        if self.matchedRange(in: node) != nil { return true }
+
+        return (node.children ?? []).contains { self.matchesFilter($0) }
+    }
+
+
+    /// Where the filter matches the node's name, ignoring case, as the local file browser matches.
+    private func matchedRange(in node: RemoteDirectoryNode) -> NSRange? {
+
+        guard !self.filterText.isEmpty else { return nil }
+
+        let range = (node.name as NSString).range(of: self.filterText, options: .caseInsensitive)
+        return range.location == NSNotFound ? nil : range
+    }
+
+
+    private func treeDidChange(_ change: RemoteDirectoryTree.Change) {
+
+        // A change can come from within the outline view's own expansion; the rows are updated after it.
+        DispatchQueue.main.async { [weak self] in
+            MainActor.assumeIsolated {
+                self?.show(change)
+            }
+        }
+    }
+
+
+    private func show(_ change: RemoteDirectoryTree.Change) {
+
+        guard self.isViewLoaded else { return }
+
+        self.shownChangeCount += 1
+
+        // While filtering, a folder listed anywhere can bring matches into rows that are not shown, so the rows are reloaded, at most every so often.
+        if !self.filterText.isEmpty {
+            guard !self.isFilterReloadScheduled else { return }
+            self.isFilterReloadScheduled = true
+            Task { [weak self] in
+                try? await Task.sleep(for: .milliseconds(200))
+                guard let self else { return }
+                self.isFilterReloadScheduled = false
+                self.reloadKeepingSelection()
+            }
+            return
+        }
+
+        let selected = self.outlineView.item(atRow: self.outlineView.selectedRow) as? RemoteDirectoryNode
+        switch change {
+            case .children(let node?), .node(let node):
+                let root = self.session.tree.root
+                guard node === root || self.outlineView.row(forItem: node) >= 0 else { break }
+                if node !== root {
+                    self.outlineView.reloadItem(node, reloadChildren: false)
+                }
+                // Rows that come and go are animated by the outline view itself, in step with the space it
+                // makes for them; replacing every row while a folder opens would move them apart.
+                if !self.showChanges(below: node) {
+                    if node === root {
+                        self.reloadAll()
+                    } else {
+                        self.outlineView.reloadItem(node, reloadChildren: true)
+                    }
+                }
+                self.applyExpansion(of: node)
+            case .children(nil):
+                self.reloadAll()
+        }
+        self.restoreSelection(selected)
+        self.updateMessage()
+    }
+
+
+    /// Shows a change of the rows below a node as the rows it removes and inserts.
+    ///
+    /// - Returns: `false` if the change cannot be shown that way, because the node's rows are not shown,
+    ///   the filter decides them, or rows that stay changed their order; the caller then reloads them.
+    private func showChanges(below node: RemoteDirectoryNode) -> Bool {
+
+        let item: Any? = (node === self.session.tree.root) ? nil : node
+        let key = self.key(of: item)
+        guard
+            self.filterText.isEmpty,
+            item == nil || self.outlineView.isItemExpanded(node),
+            let old = self.shownChildren[key]
+        else { return false }
+
+        let new = self.displayedChildren(of: item)
+        let oldIDs = old.map { ObjectIdentifier($0 as AnyObject) }
+        let newIDs = new.map { ObjectIdentifier($0 as AnyObject) }
+        let kept = Set(oldIDs).intersection(newIDs)
+        guard oldIDs.filter(kept.contains) == newIDs.filter(kept.contains) else { return false }
+
+        let removed = IndexSet(oldIDs.indices.filter { !kept.contains(oldIDs[$0]) })
+        let inserted = IndexSet(newIDs.indices.filter { !kept.contains(newIDs[$0]) })
+        self.shownChildren[key] = new
+
+        self.outlineView.beginUpdates()
+        self.outlineView.removeItems(at: removed, inParent: item, withAnimation: .effectFade)
+        self.outlineView.insertItems(at: inserted, inParent: item, withAnimation: .slideDown)
+        self.outlineView.endUpdates()
+        for child in new where kept.contains(ObjectIdentifier(child as AnyObject)) {
+            self.outlineView.reloadItem(child, reloadChildren: false)
+        }
+        if !removed.isEmpty || !inserted.isEmpty {
+            self.animatedChangeCount += 1
+        }
+
+        return true
+    }
+
+
+    private func reloadAll() {
+
+        self.shownChildren.removeAll()
+        self.outlineView.reloadData()
+        self.applyExpansion(below: self.session.tree.root)
+    }
+
+
+    private func key(of item: Any?) -> ObjectIdentifier {
+
+        item.map { ObjectIdentifier($0 as AnyObject) } ?? self.rootKey
+    }
+
+
+    /// Expands or collapses a row as the model has it, then its children.
+    private func applyExpansion(of node: RemoteDirectoryNode) {
+
+        if node !== self.session.tree.root, self.filterText.isEmpty, node.isExpanded != self.outlineView.isItemExpanded(node) {
+            self.isApplyingExpansion = true
+            if node.isExpanded {
+                self.outlineView.expandItem(node)
+            } else {
+                self.outlineView.collapseItem(node)
+            }
+            self.isApplyingExpansion = false
+        }
+        self.applyExpansion(below: node)
+    }
+
+
+    /// Expands the rows the model has expanded, without the expansion asking the tree for anything.
+    private func applyExpansion(below node: RemoteDirectoryNode) {
+
+        self.isApplyingExpansion = true
+        defer { self.isApplyingExpansion = false }
+
+        func apply(_ item: Any?) {
+            for child in self.displayedChildren(of: item) {
+                guard let child = child as? RemoteDirectoryNode, child.mayBeFolder else { continue }
+                // While filtering, loaded folders open to show matches without being listed.
+                if child.isExpanded || (!self.filterText.isEmpty && child.children != nil) {
+                    self.outlineView.expandItem(child)
+                    apply(child)
+                } else if self.outlineView.isItemExpanded(child) {
+                    self.outlineView.collapseItem(child)
+                }
+            }
+        }
+        apply(node === self.session.tree.root ? nil : node)
+    }
+
+
+    private func reloadKeepingSelection() {
+
+        let selected = self.outlineView.item(atRow: self.outlineView.selectedRow) as? RemoteDirectoryNode
+        self.shownChildren.removeAll()
+        self.outlineView.reloadData()
+        self.applyExpansion(below: self.session.tree.root)
+        self.restoreSelection(selected)
+        self.updateMessage()
+    }
+
+
+    /// Selects the node again after a reload, or the closest folder above it that is still in the tree.
+    private func restoreSelection(_ node: RemoteDirectoryNode?) {
+
+        guard var node else { return }
+
+        while !node.isAttached(to: self.session.tree.root) || self.outlineView.row(forItem: node) < 0 {
+            guard let parent = node.parent else { return self.outlineView.deselectAll(nil) }
+            node = parent
+        }
+        guard node !== self.session.tree.root else { return self.outlineView.deselectAll(nil) }
+
+        let row = self.outlineView.row(forItem: node)
+        if row != self.outlineView.selectedRow {
+            self.outlineView.selectRowIndexes([row], byExtendingSelection: false)
+        }
+    }
+
+
+    /// Shows the empty, filtered or unavailable state of the whole folder.
+    private func updateMessage() {
+
+        let root = self.session.tree.root
+        let message: String? = if !self.filterText.isEmpty, self.outlineView.numberOfRows == 0 {
+            String(localized: "No Filter Results", table: "Document", comment: "filtering result message")
+        } else if let problem = root.problem, case .failed(let message) = problem {
+            message
+        } else if root.children?.isEmpty == true, root.problem == nil {
+            String(localized: "RemoteFolder.emptyFolder", defaultValue: "This folder is empty.", table: "Remote")
+        } else if root.children == nil, root.isLoading {
+            String(localized: "RemoteFolder.loading", defaultValue: "Loading…", table: "Remote")
+        } else {
+            nil
+        }
+
+        self.messageField.stringValue = message ?? ""
+        self.messageField.isHidden = (message == nil)
+    }
+
+
+    /// Highlights the file of the selected tab, if it is a loaded row.
+    private func observeSelection() {
+
+        guard self.selectionObservation == nil, let directory = self.session.directory else { return }
+
+        self.selectionObservation = Task { [weak self, weak directory] in
+            guard let directory else { return }
+            for await _ in Observations({ (directory.tabState.selectedID, directory.activeFileDocument?.displayName) }) {
+                guard let self, !Task.isCancelled else { return }
+                self.selectRow(of: directory.activeFileDocument as? RemoteDocument)
+            }
+        }
+    }
+
+
+    private func selectRow(of document: RemoteDocument?) {
+
+        guard
+            let document,
+            document.identity.endpoint == self.session.identity.endpoint,
+            let components = RemotePath.relativePath(of: document.identity.requestedPath, in: self.session.identity.path),
+            let node = self.session.tree.node(atRelativePath: components)
+        else { return }
+
+        let row = self.outlineView.row(forItem: node)
+        guard row >= 0, row != self.outlineView.selectedRow else { return }
+
+        self.outlineView.selectRowIndexes([row], byExtendingSelection: false)
+        self.outlineView.scrollRowToVisible(row)
+    }
+}
