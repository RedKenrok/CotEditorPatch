+import Foundation
+import Testing
+@testable import CotEditor
+
+struct DirectoryTabArchiveTests {
+
+    /// Stands in for security-scoped bookmarks: each "bookmark" is the UTF-8 path, and `stale` never resolves.
+    private let root = URL(filePath: "/tmp/directory", directoryHint: .isDirectory)
+
+
+    private func bookmark(_ name: String) -> Data {
+
+        Data(self.root.appending(path: name).path.utf8)
+    }
+
+
+    private func resolve(_ data: Data) -> URL? {
+
+        let path = String(decoding: data, as: UTF8.self)
+
+        return path.hasSuffix("stale") ? nil : URL(filePath: path)
+    }
+
+
+    @Test func roundTripsOrderedIDsAndSelectionThroughSecureCoding() throws {
+
+        let ids = [UUID(), UUID(), UUID()]
+        let encoded = DirectoryTabArchive.encode(zip(ids, ["a", "b", "c"].map(self.bookmark)).map { ($0, $1) }, selectedID: ids[1])
+
+        let archiver = NSKeyedArchiver(requiringSecureCoding: true)
+        archiver.encode(encoded, forKey: "tabs")
+        let unarchiver = try NSKeyedUnarchiver(forReadingFrom: archiver.encodedData)
+        unarchiver.requiresSecureCoding = true
+        let decoded = unarchiver.decodeObject(of: DirectoryTabArchive.allowedClasses, forKey: "tabs") as? [String: Any]
+
+        let archive = DirectoryTabArchive(archive: decoded, legacyBookmarks: nil, currentBookmark: nil, resolve: self.resolve)
+
+        #expect(archive.entries.map(\.id) == ids)
+        #expect(archive.entries.map(\.fileURL.lastPathComponent) == ["a", "b", "c"])
+        #expect(archive.selectedIndex == 1)
+    }
+
+
+    @Test func migratesLegacyBookmarkList() {
+
+        let archive = DirectoryTabArchive(archive: nil, legacyBookmarks: ["a", "b"].map(self.bookmark),
+                                          currentBookmark: self.bookmark("b"), resolve: self.resolve)
+
+        #expect(archive.entries.map(\.fileURL.lastPathComponent) == ["a", "b"])
+        #expect(archive.entries.allSatisfy { $0.id == nil })
+        #expect(archive.selectedIndex == 1)
+    }
+
+
+    @Test func migratesSingleCurrentDocument() {
+
+        let archive = DirectoryTabArchive(archive: nil, legacyBookmarks: nil, currentBookmark: self.bookmark("a"), resolve: self.resolve)
+
+        #expect(archive.entries.map(\.fileURL.lastPathComponent) == ["a"])
+        #expect(archive.selectedIndex == 0)
+    }
+
+
+    @Test func skipsUnresolvableAndUnknownEntries() {
+
+        let id = UUID()
+        let archive = DirectoryTabArchive(archive: [
+            "version": 1,
+            "entries": [
+                ["id": UUID().uuidString, "kind": "file", "bookmark": self.bookmark("stale")],
+                ["id": UUID().uuidString, "kind": "terminal", "bookmark": self.bookmark("b")],
+                ["id": UUID().uuidString, "kind": "file"],
+                ["id": id.uuidString, "kind": "file", "bookmark": self.bookmark("a")],
+            ],
+            "selectedID": UUID().uuidString,
+        ], legacyBookmarks: nil, currentBookmark: nil, resolve: self.resolve)
+
+        #expect(archive.entries == [.init(id: id, fileURL: self.root.appending(path: "a"))])
+        // the saved selection is gone and there is no current file to fall back to
+        #expect(archive.selectedIndex == nil)
+    }
+
+
+    @Test func repairsDuplicateIDsAndFiles() {
+
+        let id = UUID()
+        let archive = DirectoryTabArchive(archive: [
+            "version": 1,
+            "entries": [
+                ["id": id.uuidString, "kind": "file", "bookmark": self.bookmark("a")],
+                ["id": id.uuidString, "kind": "file", "bookmark": self.bookmark("b")],
+                ["id": UUID().uuidString, "kind": "file", "bookmark": self.bookmark("a")],
+                ["id": "not a UUID", "kind": "file", "bookmark": self.bookmark("c")],
+            ],
+            "selectedID": id.uuidString,
+        ], legacyBookmarks: nil, currentBookmark: nil, resolve: self.resolve)
+
+        #expect(archive.entries.map(\.fileURL.lastPathComponent) == ["a", "b", "c"])
+        #expect(archive.entries.map(\.id) == [id, nil, nil])
+        #expect(archive.selectedIndex == 0)
+    }
+
+
+    @Test func keepsTabsOfOtherKindsInOrder() {
+
+        let file = UUID()
+        let widget = UUID()
+        let gadget = UUID()
+        let archive = DirectoryTabArchive(archive: [
+            "version": 1,
+            "entries": [
+                ["id": widget.uuidString, "kind": "widget", "name": "one"],
+                ["id": file.uuidString, "kind": "file", "bookmark": self.bookmark("a")],
+                ["kind": "widget", "name": "without an ID"],
+                ["id": file.uuidString, "kind": "widget", "name": "with a repeated ID"],
+                ["id": UUID().uuidString, "name": "without a kind"],
+                ["id": gadget.uuidString, "kind": "gadget"],
+            ],
+            "selectedID": widget.uuidString,
+        ], legacyBookmarks: nil, currentBookmark: nil, resolve: self.resolve)
+
+        #expect(archive.entries.map(\.id) == [file])
+        #expect(archive.foreignEntries.map(\.id) == [widget, gadget])
+        #expect(archive.foreignEntries(ofKind: "widget").map { $0.fields["name"] as? String } == ["one"])
+        #expect(archive.order == [widget, file, gadget])
+        #expect(archive.selectedID == widget)
+        #expect(archive.selectedIndex == nil, "the selected tab is not a file")
+    }
+
+
+    @Test func encodedTabsKeepTheirOwnIDAndKind() {
+
+        let id = UUID()
+        let encoded = DirectoryTabArchive.encode([.init(id: id, kind: "widget", fields: ["id": "forged", "kind": "file", "name": "one"])],
+                                                 selectedID: id)
+        let archive = DirectoryTabArchive(archive: encoded as? [String: Any], legacyBookmarks: nil, currentBookmark: nil, resolve: self.resolve)
+
+        #expect(archive.entries.isEmpty)
+        #expect(archive.foreignEntries.map(\.id) == [id])
+        #expect(archive.foreignEntries.first?.kind == "widget")
+        #expect(archive.foreignEntries.first?.fields["name"] as? String == "one")
+    }
+
+
+    @Test func unknownVersionFallsBackToCurrentDocument() {
+
+        let archive = DirectoryTabArchive(archive: [
+            "version": 2,
+            "entries": [["id": UUID().uuidString, "kind": "file", "bookmark": self.bookmark("a")]],
+        ], legacyBookmarks: nil, currentBookmark: self.bookmark("b"), resolve: self.resolve)
+
+        #expect(archive.entries.map(\.fileURL.lastPathComponent) == ["b"])
+        #expect(archive.selectedIndex == 0)
+    }
+
+
+    @Test func emptyArchiveFallsBackToCurrentDocumentAndFailedCurrentYieldsNothing() {
+
+        let fallback = DirectoryTabArchive(archive: ["version": 1, "entries": []],
+                                           legacyBookmarks: nil, currentBookmark: self.bookmark("a"), resolve: self.resolve)
+        #expect(fallback.entries.map(\.fileURL.lastPathComponent) == ["a"])
+
+        let nothing = DirectoryTabArchive(archive: ["version": 1, "entries": []],
+                                          legacyBookmarks: nil, currentBookmark: self.bookmark("stale"), resolve: self.resolve)
+        #expect(nothing.entries.isEmpty)
+        #expect(nothing.selectedIndex == nil)
+    }
+}
