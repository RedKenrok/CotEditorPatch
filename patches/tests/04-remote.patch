+    @Test(.timeLimit(.minutes(1))) func thePoolAsksAboutAnUnknownKeyAndConnectsOnlyIfTrusted() async throws {
+
+        let server = FakeSFTPServer()
+        let attempts = FakeCounter()
+        let trusted = FakeFlag()
+        let unknown = RemoteConnectionError.hostKeyNotVerified(diagnostics: "No ED25519 host key is known for server and you have requested strict checking.")
+        let pool = RemoteConnectionPool()
+        await pool.configure(limits: RemoteLimits(), connector: { _, limits in
+            // The key is unknown until the review trusts it.
+            _ = await attempts.increment()
+            guard await trusted.isSet else { throw unknown }
+            let client = RemoteSFTPClient(channel: FakeSFTPChannel(server: server), limits: limits)
+            try await client.start()
+            return RemoteSFTPTransport(client: client, limits: limits)
+        })
+
+        let reviews = FakeCounter()
+        await pool.setHostKeyReviewer { _, _ in
+            _ = await reviews.increment()
+            return false
+        }
+        await #expect(throws: unknown) { try await pool.withConnection(to: .fake, destination: .fake) { try await $0.stat("/") } }
+        #expect(await reviews.value == 1)
+
+        await pool.setHostKeyReviewer { _, _ in
+            _ = await reviews.increment()
+            await trusted.set()
+            return true
+        }
+        _ = try await pool.withConnection(to: .fake, destination: .fake) { try await $0.stat("/") }
+        #expect(await reviews.value == 2)
+        #expect(await attempts.value == 3, "trusting the key connects again")
+        await pool.closeAll()
+    }
