+import Foundation
+
+
+/// What an SFTP server offers beyond the base protocol.
+struct RemoteServerCapabilities: Equatable, Sendable {
+
+    /// The server can replace a file with another in one atomic rename.
+    var supportsPOSIXRename: Bool
+
+    /// The server can flush an open file to its disk.
+    var supportsFsync: Bool
+}
+
+
+/// An open remote file.
+struct RemoteFileHandle: Sendable {
+
+    var data: Data
+    var path: String
+}
+
+
+/// How a file is opened for writing.
+enum RemoteWriteMode: Sendable {
+
+    /// Creates a new file with the given mode, failing if anything already exists at the path.
+    case createExclusive(permissions: UInt32)
+
+    /// Opens an existing file for writing, without creating or truncating it.
+    case existing
+}
+
+
+/// The file operations that opening and saving are built from, on one connection.
+///
+/// Each operation either succeeds, fails with the server's definite answer (`RemoteSFTPError`), or
+/// fails with the outcome unknown (`RemoteConnectionError`, a protocol error, or cancellation).
+/// Callers treat the last kind as "may have happened".
+protocol RemoteFileTransport: AnyObject, Sendable {
+
+    var capabilities: RemoteServerCapabilities { get async }
+
+    func realpath(_ path: String) async throws -> String
+    func lstat(_ path: String) async throws -> RemoteFileAttributes
+    func stat(_ path: String) async throws -> RemoteFileAttributes
+    func readlink(_ path: String) async throws -> String
+
+    /// Reads a whole regular file through one handle, with its attributes before and after reading.
+    ///
+    /// - Throws: `RemoteTransferError.tooLarge` as soon as the file is known to exceed the limit.
+    func readFile(at path: String, limit: Int) async throws -> RemoteFileContents
+
+    func open(_ path: String, mode: RemoteWriteMode) async throws -> RemoteFileHandle
+    func fstat(_ handle: RemoteFileHandle) async throws -> RemoteFileAttributes
+
+    /// Writes data from the start of the file, waiting for the status of every request.
+    func write(_ data: Data, to handle: RemoteFileHandle) async throws
+
+    func truncate(_ handle: RemoteFileHandle, to size: UInt64) async throws
+
+    /// Flushes an open file to disk. Only valid if the server supports it.
+    func fsync(_ handle: RemoteFileHandle) async throws
+
+    func close(_ handle: RemoteFileHandle) async throws
+    func setPermissions(_ permissions: UInt32, at path: String) async throws
+
+    /// Renames atomically, replacing an existing file. Only valid if the server supports it.
+    func rename(_ source: String, to destination: String) async throws
+
+    func remove(_ path: String) async throws
+
+    /// Ends the connection.
+    func disconnect() async
+
+    /// Whether the connection has ended.
+    var isDisconnected: Bool { get async }
+}
+
+
+enum RemoteTransferError: Error, Equatable {
+
+    /// The file is larger than the transfer limit.
+    case tooLarge(limit: Int)
+
+    /// The item is not a regular file.
+    case notRegularFile
+}
+
+
+extension RemoteTransferError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .tooLarge(let limit):
+                String(localized: "RemoteTransferError.tooLarge.description",
+                       defaultValue: "The file is larger than \(ByteCountFormatter.string(fromByteCount: Int64(limit), countStyle: .file)), the largest remote file CotEditor can open or save.",
+                       table: "Remote", comment: "%@ is a size such as 16 MB")
+            case .notRegularFile:
+                String(localized: "RemoteTransferError.notRegularFile.description",
+                       defaultValue: "The item is not a regular file.", table: "Remote")
+        }
+    }
+}
+
+
+/// The transport over an SFTP session.
+final class RemoteSFTPTransport: RemoteFileTransport {
+
+    let client: RemoteSFTPClient
+    private let limits: RemoteLimits
+
+
+    init(client: RemoteSFTPClient, limits: RemoteLimits) {
+
+        self.client = client
+        self.limits = limits
+    }
+
+
+    /// Connects to the endpoint through `ssh` and starts an SFTP session.
+    static func connect(to endpoint: RemoteEndpoint, limits: RemoteLimits, overrides: RemoteSSHCommand.TestOverrides? = nil) async throws -> RemoteSFTPTransport {
+        let jumpHosts = try await self.jumpHosts(for: endpoint, limits: limits, overrides: overrides)
+        let process = try RemoteSSHProcess(endpoint: endpoint, through: jumpHosts, limits: limits, overrides: overrides)
+        let client = RemoteSFTPClient(channel: process, limits: limits)
+        do {
+            try await client.start()
+        } catch {
+            await client.close()
+            // with the process reaped, its exit status can tell more
+            if case .noSFTPService(let diagnostics) = error as? RemoteConnectionError,
+               let status = process.exitStatus, status == 255
+            {
+                throw RemoteConnectionError.classify(status: status, diagnostics: diagnostics)
+            }
+            throw error
+        }
+
+        return RemoteSFTPTransport(client: client, limits: limits)
+    }
+
+
+    /// The jump hosts of the endpoint's configuration.
+    ///
+    /// The first one is reached as its own configuration says, so it must not have a jump host or proxy
+    /// command of its own; each later one is reached through the one before it.
+    static func jumpHosts(for endpoint: RemoteEndpoint, limits: RemoteLimits, overrides: RemoteSSHCommand.TestOverrides?) async throws -> [RemoteEndpoint] {
+
+        let configuration = try await RemoteSSHProcess.evaluateConfiguration(for: endpoint, limits: limits, overrides: overrides)
+        guard let jumpHosts = configuration.jumpHosts, let first = jumpHosts.first else { return [] }
+
+        let firstConfiguration = try await RemoteSSHProcess.evaluateConfiguration(for: first, limits: limits, overrides: overrides)
+        guard firstConfiguration.destination.route == nil else { throw RemoteConnectionError.proxyUnsupported }
+
+        return jumpHosts
+    }
+
+
+    var capabilities: RemoteServerCapabilities {
+
+        get async {
+            RemoteServerCapabilities(supportsPOSIXRename: await self.client.supportsPOSIXRename,
+                                     supportsFsync: await self.client.supportsFsync)
+        }
+    }
+
+
+    var isDisconnected: Bool {
+
+        get async { await self.client.isClosed }
+    }
+
+
+    func disconnect() async {
+
+        await self.client.close()
+    }
+
+
+    func realpath(_ path: String) async throws -> String {
+
+        try await self.client.expectName(.realpath(path: path), operation: .resolvePath, path: path)
+    }
+
+
+    func lstat(_ path: String) async throws -> RemoteFileAttributes {
+
+        try await self.client.expectAttributes(.lstat(path: path), operation: .stat, path: path)
+    }
+
+
+    func stat(_ path: String) async throws -> RemoteFileAttributes {
+
+        try await self.client.expectAttributes(.stat(path: path), operation: .stat, path: path)
+    }
+
+
+    func readlink(_ path: String) async throws -> String {
+
+        try await self.client.expectName(.readlink(path: path), operation: .readLink, path: path)
+    }
+
+
+    func readFile(at path: String, limit: Int) async throws -> RemoteFileContents {
+
+        let handle = try await self.client.expectHandle(.open(path: path, flags: .read, attributes: RemoteFileAttributes()),
+                                                        operation: .open, path: path)
+        let file = RemoteFileHandle(data: handle, path: path)
+
+        do {
+            let before = try await self.fstat(file)
+            guard before.kind == .regular else { throw RemoteTransferError.notRegularFile }
+            if let size = before.size, size > UInt64(limit) { throw RemoteTransferError.tooLarge(limit: limit) }
+            if let size = before.size {
+                RemoteOperationControl.current?.expect(totalBytes: Int(size))
+            }
+
+            let data = try await self.readAll(handle, path: path, limit: limit)
+            let after = try await self.fstat(file)
+            try await self.close(file)
+
+            return RemoteFileContents(data: data, attributesBefore: before, attributesAfter: after)
+        } catch let error as RemoteSFTPError {
+            // The server answered, so the connection is fine; the handle must not leak.
+            try? await self.close(file)
+            throw error
+        } catch let error as RemoteTransferError {
+            try? await self.close(file)
+            throw error
+        } catch let error as RemoteOperationCanceled {
+            try? await self.close(file)
+            throw error
+        }
+    }
+
+
+    func open(_ path: String, mode: RemoteWriteMode) async throws -> RemoteFileHandle {
+
+        let request: RemoteSFTPRequest = switch mode {
+            case .createExclusive(let permissions):
+                .open(path: path, flags: [.write, .create, .exclusive], attributes: RemoteFileAttributes(permissions: permissions))
+            case .existing:
+                .open(path: path, flags: .write, attributes: RemoteFileAttributes())
+        }
+        let handle = try await self.client.expectHandle(request, operation: .open, path: path)
+
+        return RemoteFileHandle(data: handle, path: path)
+    }
+
+
+    func fstat(_ handle: RemoteFileHandle) async throws -> RemoteFileAttributes {
+
+        try await self.client.expectAttributes(.fstat(handle: handle.data), operation: .stat, path: handle.path)
+    }
+
+
+    func write(_ data: Data, to handle: RemoteFileHandle) async throws {
+
+        let chunkSize = self.limits.chunkSize
+        let offsets = Array(stride(from: 0, to: data.count, by: chunkSize))
+        let client = self.client
+
+        // Windows of requests are in flight together. Every status is awaited, including after a
+        // failure, so that no write of this operation is still on its way when this returns. A
+        // cancellation is honored between windows, when no request is outstanding.
+        let control = RemoteOperationControl.current
+        for window in offsets.chunked(into: self.limits.requestsInFlight) {
+            try control?.checkCancellation()
+            let results = await withTaskGroup(of: Result<Void, any Error>.self) { group in
+                for offset in window {
+                    let chunk = data.subdata(in: offset..<min(offset + chunkSize, data.count))
+                    group.addTask {
+                        await Result {
+                            try await client.expectStatus(.write(handle: handle.data, offset: UInt64(offset), data: chunk),
+                                                          operation: .write, path: handle.path)
+                        }
+                    }
+                }
+                return await group.reduce(into: []) { $0.append($1) }
+            }
+            for result in results {
+                try result.get()
+            }
+            control?.didTransfer(window.reduce(0) { $0 + min(chunkSize, data.count - $1) })
+        }
+    }
+
+
+    func truncate(_ handle: RemoteFileHandle, to size: UInt64) async throws {
+
+        try await self.client.expectStatus(.fsetstat(handle: handle.data, attributes: RemoteFileAttributes(size: size)),
+                                           operation: .setAttributes, path: handle.path)
+    }
+
+
+    func fsync(_ handle: RemoteFileHandle) async throws {
+
+        try await self.client.expectStatus(.fsync(handle: handle.data), operation: .sync, path: handle.path)
+    }
+
+
+    func close(_ handle: RemoteFileHandle) async throws {
+
+        try await self.client.expectStatus(.close(handle: handle.data), operation: .close, path: handle.path)
+    }
+
+
+    func setPermissions(_ permissions: UInt32, at path: String) async throws {
+
+        try await self.client.expectStatus(.setstat(path: path, attributes: RemoteFileAttributes(permissions: permissions)),
+                                           operation: .setAttributes, path: path)
+    }
+
+
+    func rename(_ source: String, to destination: String) async throws {
+
+        try await self.client.expectStatus(.posixRename(from: source, to: destination), operation: .rename, path: destination)
+    }
+
+
+    func remove(_ path: String) async throws {
+
+        try await self.client.expectStatus(.remove(path: path), operation: .remove, path: path)
+    }
+
+
+    // MARK: Private Methods
+
+    /// Reads a file from its start to its end, several requests at a time, refusing more than the limit.
+    private func readAll(_ handle: Data, path: String, limit: Int) async throws -> Data {
+
+        let chunkSize = self.limits.chunkSize
+        let client = self.client
+        var result = Data()
+        var offset: UInt64 = 0
+        let control = RemoteOperationControl.current
+
+        while true {
+            try control?.checkCancellation()
+            let window = (0..<self.limits.requestsInFlight).map { offset + UInt64($0 * chunkSize) }
+            let replies = try await withThrowingTaskGroup(of: (UInt64, Data?).self) { group in
+                for position in window {
+                    group.addTask {
+                        (position, try await client.expectData(.read(handle: handle, offset: position, length: UInt32(chunkSize)), path: path))
+                    }
+                }
+                return try await group.reduce(into: []) { $0.append($1) }.sorted { $0.0 < $1.0 }
+            }
+
+            // Replies after a short read or the end are not contiguous with what was read, so they are dropped.
+            for (position, data) in replies {
+                guard position == offset else { break }
+                guard let data, !data.isEmpty else { return result }
+
+                result.append(data)
+                offset += UInt64(data.count)
+                control?.didTransfer(data.count)
+                // A file that grows while it is read is refused rather than filling the disk.
+                guard result.count <= limit else { throw RemoteTransferError.tooLarge(limit: limit) }
+                if data.count < chunkSize { break }
+            }
+        }
+    }
+}
+
+
+private extension Array {
+
+    func chunked(into size: Int) -> [ArraySlice<Element>] {
+
+        stride(from: 0, to: self.count, by: Swift.max(size, 1)).map { self[$0..<Swift.min($0 + size, self.count)] }
+    }
+}
+
+
+private extension Result where Failure == any Error {
+
+    init(catching body: () async throws -> Success) async {
+
+        do {
+            self = .success(try await body())
+        } catch {
+            self = .failure(error)
+        }
+    }
+}
