+import AppKit
+
+
+/// What the user decided about closing a remote document with unsent changes.
+enum RemoteCloseChoice: Equatable, Sendable {
+
+    case save
+    case keepRecoveryCopy
+    case discard
+    case cancel
+}
+
+
+/// Why a save found the server's file different from what it expected.
+enum RemoteConflictReason: Equatable, Sendable {
+
+    /// The contents differ from the version the edits are based on.
+    case contentChanged
+    /// The file changed while it was being checked.
+    case changedWhileReading
+    /// The file is gone.
+    case missing
+    /// Something other than a regular file is at the path now.
+    case typeChanged
+    /// The symbolic link the file was opened through points elsewhere now.
+    case linkRetargeted
+    /// After an interrupted save, the file matches neither the old version nor the one being saved.
+    case unknownAfterInterruption
+    /// The path chosen for Save As Remote holds a file with other contents.
+    case destinationTaken
+}
+
+
+/// A conflict found by a save, with the server's current version if it could be read.
+struct RemoteConflict: Equatable, Sendable {
+
+    var reason: RemoteConflictReason
+    var remoteData: Data?
+
+    /// Whether the conflict follows an in-place save that was interrupted, so that the server's file may be mixed.
+    var followsInterruptedInPlaceSave = false
+
+
+    var remoteDigest: String? {
+
+        self.remoteData.map(RemoteDigest.of)
+    }
+}
+
+
+/// What the user chose to do about a conflict.
+enum RemoteConflictChoice: Equatable, Sendable {
+
+    case keepEditing
+    case openRemoteVersion
+    case saveAsRemote
+    /// Overwrite the reviewed remote version with the editor's contents.
+    case replace
+    /// Write the version an interrupted in-place save started from back to the server.
+    case restoreOriginal
+}
+
+
+/// What the user chose after a save failed.
+enum RemoteFailureChoice: Equatable, Sendable {
+
+    case retry
+    case saveLocalCopy
+    case dismiss
+}
+
+
+/// The confirmations and reports remote documents need.
+///
+/// Every decision goes through this protocol so that tests can answer without showing alerts.
+@MainActor protocol RemotePrompting {
+
+    /// Asks what to do with a document's unsent changes before it closes.
+    func reviewClose(fileName: String, hasUnresolvedOperation: Bool, window: NSWindow?) async -> RemoteCloseChoice
+
+    /// Asks whether a file that cannot be replaced safely may be rewritten in place.
+    func confirmInPlaceSaving(fileName: String, window: NSWindow?) async -> Bool
+
+    /// Asks what to do about a conflict.
+    ///
+    /// - Parameter choices: The choices that apply, in addition to Keep Editing.
+    func resolveConflict(_ conflict: RemoteConflict, fileName: String, choices: [RemoteConflictChoice], window: NSWindow?) async -> RemoteConflictChoice
+
+    /// Reports a failed save and asks what to do next.
+    func reportFailure(_ error: any Error, fileName: String, canRetry: Bool, window: NSWindow?) async -> RemoteFailureChoice
+
+    /// Asks whether the edits may be discarded to download the remote version again.
+    func confirmRevert(fileName: String, window: NSWindow?) async -> Bool
+
+    /// Asks whether to open a file larger than the size the user set for this question.
+    func confirmOpeningLargeFile(fileName: String, size: Int, window: NSWindow?) async -> Bool
+
+    /// Asks whether to edit the target of a symbolic link.
+    func approveSymbolicLink(path: String, target: String, window: NSWindow?) async -> Bool
+
+    /// Asks where on the same server to save a copy.
+    ///
+    /// - Returns: The absolute path, or `nil` if canceled.
+    func askForRemotePath(suggestedPath: String, connectionName: String, window: NSWindow?) async -> String?
+
+    /// Asks whether to continue although the host now resolves to another destination.
+    func confirmDestinationChange(from old: RemoteDestination, to new: RemoteDestination, window: NSWindow?) async -> Bool
+
+    /// Asks whether to look at the folder on another server, after the SSH configuration of a folder
+    /// window's host changed. Nothing is opened or written there by agreeing.
+    func confirmFolderDestinationChange(from old: RemoteDestination, to new: RemoteDestination, folder: String, window: NSWindow?) async -> Bool
+
+    /// Reports that newer edits could not be protected on this Mac.
+    func reportRecoveryFailure(_ error: any Error, fileName: String, window: NSWindow?) async
+
+    /// Asks whether to trust the key a server offers whose key is not known yet, showing its fingerprint.
+    func confirmHostKey(_ key: RemoteOfferedHostKey, host: String, window: NSWindow?) async -> Bool
+
+    /// Asks a question of `ssh`, such as for a password, a one-time code or a key's passphrase.
+    ///
+    /// - Parameters:
+    ///   - prompt: The question as `ssh` put it.
+    ///   - isConfirmation: Whether it is a yes or no question.
+    /// - Returns: The answer, `yes` for a confirmation, or `nil` if the user canceled.
+    func answerSSHQuestion(_ prompt: String, isConfirmation: Bool, window: NSWindow?) async -> String?
+}
+
+
+/// The standard prompts, as alerts.
+@MainActor struct RemoteAlertPrompts: RemotePrompting {
+
+    func reviewClose(fileName: String, hasUnresolvedOperation: Bool, window: NSWindow?) async -> RemoteCloseChoice {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemotePrompt.close.message",
+                                   defaultValue: "Do you want to send the changes to “\(fileName)” to the server?", table: "Remote",
+                                   comment: "%@ is a file name")
+        alert.informativeText = hasUnresolvedOperation
+            ? String(localized: "RemotePrompt.close.unresolved",
+                     defaultValue: "The outcome of an earlier save is not known yet. CotEditor keeps a copy of everything needed to check it later.",
+                     table: "Remote")
+            : String(localized: "RemotePrompt.close.information",
+                     defaultValue: "The changes are not on the server yet. You can keep them on this Mac and send them later.",
+                     table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.close.save", defaultValue: "Save", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.close.keep", defaultValue: "Keep Recovery Copy", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.close.discard", defaultValue: "Discard Changes", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.buttons[2].hasDestructiveAction = true
+
+        return switch await Self.run(alert, window: window) {
+            case .alertFirstButtonReturn: .save
+            case .alertSecondButtonReturn: .keepRecoveryCopy
+            case .alertThirdButtonReturn: .discard
+            default: .cancel
+        }
+    }
+
+
+    func confirmInPlaceSaving(fileName: String, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = String(localized: "RemotePrompt.inPlace.message",
+                                   defaultValue: "Save “\(fileName)” by rewriting it in place?", table: "Remote",
+                                   comment: "%@ is a file name")
+        alert.informativeText = String(localized: "RemotePrompt.inPlace.information",
+                                       defaultValue: "The file cannot be replaced safely, for example because it belongs to another user or its folder is not writable. Rewriting it keeps its owner and permissions, but while it is written, others can briefly see a partly written file, and an interruption can leave it mixed. CotEditor keeps both versions on this Mac so that it can be repaired. You are asked once for this document.",
+                                       table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.inPlace.button", defaultValue: "Rewrite in Place", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func resolveConflict(_ conflict: RemoteConflict, fileName: String, choices: [RemoteConflictChoice], window: NSWindow?) async -> RemoteConflictChoice {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = switch conflict.reason {
+            case .missing:
+                String(localized: "RemotePrompt.conflict.missing", defaultValue: "“\(fileName)” no longer exists on the server.", table: "Remote")
+            case .typeChanged, .linkRetargeted:
+                String(localized: "RemotePrompt.conflict.moved", defaultValue: "“\(fileName)” is no longer the same file on the server.", table: "Remote")
+            case .unknownAfterInterruption:
+                String(localized: "RemotePrompt.conflict.interrupted",
+                       defaultValue: "After an interrupted save, “\(fileName)” on the server matches neither your version nor the one it had.",
+                       table: "Remote")
+            case .destinationTaken:
+                String(localized: "RemotePrompt.conflict.taken", defaultValue: "Another file already exists at that path.", table: "Remote")
+            case .contentChanged, .changedWhileReading:
+                String(localized: "RemotePrompt.conflict.changed", defaultValue: "“\(fileName)” was changed on the server.", table: "Remote")
+        }
+        alert.informativeText = choices.contains(.replace)
+            ? String(localized: "RemotePrompt.conflict.reviewed",
+                     defaultValue: "The server still has the version you reviewed. Replacing it overwrites that version with yours.", table: "Remote")
+            : String(localized: "RemotePrompt.conflict.information",
+                     defaultValue: "Nothing was overwritten. Review the server’s version before deciding whether to replace it.", table: "Remote")
+
+        let all: [RemoteConflictChoice] = [.keepEditing] + choices
+        for choice in all {
+            alert.addButton(withTitle: Self.title(of: choice))
+        }
+        if let index = all.firstIndex(of: .replace) {
+            alert.buttons[index].hasDestructiveAction = true
+        }
+
+        let index = (await Self.run(alert, window: window)).rawValue - NSApplication.ModalResponse.alertFirstButtonReturn.rawValue
+
+        return all.indices.contains(index) ? all[index] : .keepEditing
+    }
+
+
+    func reportFailure(_ error: any Error, fileName: String, canRetry: Bool, window: NSWindow?) async -> RemoteFailureChoice {
+
+        let alert = NSAlert(error: error)
+        alert.messageText = String(localized: "RemotePrompt.failure.message", defaultValue: "“\(fileName)” could not be saved to the server.", table: "Remote")
+        alert.informativeText = [error.localizedDescription, (error as? any LocalizedError)?.recoverySuggestion, (error as? RemoteConnectionError)?.diagnostics]
+            .compactMap { $0 }
+            .joined(separator: "\n\n")
+        var choices: [RemoteFailureChoice] = [.dismiss]
+        alert.buttons.first?.title = String(localized: "RemotePrompt.failure.keepEditing", defaultValue: "Keep Editing", table: "Remote", comment: "button label")
+        if canRetry {
+            alert.addButton(withTitle: String(localized: "RemotePrompt.failure.retry", defaultValue: "Retry", table: "Remote", comment: "button label"))
+            choices.append(.retry)
+        }
+        alert.addButton(withTitle: String(localized: "RemotePrompt.failure.localCopy", defaultValue: "Save a Local Copy…", table: "Remote", comment: "button label"))
+        choices.append(.saveLocalCopy)
+
+        let index = (await Self.run(alert, window: window)).rawValue - NSApplication.ModalResponse.alertFirstButtonReturn.rawValue
+
+        return choices.indices.contains(index) ? choices[index] : .dismiss
+    }
+
+
+    func confirmRevert(fileName: String, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemotePrompt.revert.message",
+                                   defaultValue: "Discard your changes and download “\(fileName)” from the server again?", table: "Remote")
+        alert.informativeText = String(localized: "RemotePrompt.revert.information", defaultValue: "Your unsent changes will be lost.", table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.revert.button", defaultValue: "Revert", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.buttons.first?.hasDestructiveAction = true
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func confirmOpeningLargeFile(fileName: String, size: Int, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemotePrompt.largeFile.message",
+                                   defaultValue: "“\(fileName)” is \(ByteCountFormatter.string(fromByteCount: Int64(size), countStyle: .file)). Do you want to open it?",
+                                   table: "Remote", comment: "%1$@ is a file name, %2$@ a size")
+        alert.informativeText = String(localized: "RemotePrompt.largeFile.information",
+                                       defaultValue: "Opening a large file can make CotEditor slow to respond.", table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.largeFile.button", defaultValue: "Open", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func approveSymbolicLink(path: String, target: String, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemotePrompt.link.message", defaultValue: "“\(path)” is a symbolic link.", table: "Remote",
+                                   comment: "%@ is a remote path")
+        alert.informativeText = String(localized: "RemotePrompt.link.information",
+                                       defaultValue: "It points to “\(target)”. Saving writes to that file and leaves the link as it is.",
+                                       table: "Remote", comment: "%@ is a remote path")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.link.button", defaultValue: "Edit Target", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func askForRemotePath(suggestedPath: String, connectionName: String, window: NSWindow?) async -> String? {
+
+        let field = NSTextField(string: suggestedPath)
+        field.frame.size.width = 360
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemotePrompt.saveAs.message", defaultValue: "Save As Remote", table: "Remote")
+        alert.informativeText = String(localized: "RemotePrompt.saveAs.information",
+                                       defaultValue: "Enter a new absolute path on \(connectionName). An existing file is never overwritten.",
+                                       table: "Remote", comment: "%@ is user@host")
+        alert.accessoryView = field
+        alert.addButton(withTitle: String(localized: "RemotePrompt.saveAs.button", defaultValue: "Save", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.window.initialFirstResponder = field
+
+        guard await Self.run(alert, window: window) == .alertFirstButtonReturn else { return nil }
+
+        return field.stringValue
+    }
+
+
+    func confirmDestinationChange(from old: RemoteDestination, to new: RemoteDestination, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = String(localized: "RemotePrompt.destination.message", defaultValue: "The host resolves to a different server.", table: "Remote")
+        alert.informativeText = String(localized: "RemotePrompt.destination.information",
+                                       defaultValue: "The file was opened from \(old.user)@\(old.hostName):\(String(old.port)), but your SSH configuration now connects to \(new.user)@\(new.hostName):\(String(new.port)). If you continue, the file there is checked against your version before anything is written.",
+                                       table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.destination.button", defaultValue: "Continue", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func confirmFolderDestinationChange(from old: RemoteDestination, to new: RemoteDestination, folder: String, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = String(localized: "RemotePrompt.folderDestination.message", defaultValue: "The host resolves to a different server.", table: "Remote")
+        alert.informativeText = String(localized: "RemotePrompt.folderDestination.information",
+                                       defaultValue: "The folder \(folder) was opened from \(old.user)@\(old.hostName):\(String(old.port)), but your SSH configuration now connects to \(new.user)@\(new.hostName):\(String(new.port)). If you continue, CotEditor looks up the folder there and offers to open it in a new window. This window keeps showing the original folder.",
+                                       table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.folderDestination.button", defaultValue: "Look Up", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func confirmHostKey(_ key: RemoteOfferedHostKey, host: String, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = String(localized: "RemotePrompt.hostKey.message", defaultValue: "“\(host)” is not a known server.", table: "Remote",
+                                   comment: "%@ is a host name")
+        alert.informativeText = String(localized: "RemotePrompt.hostKey.information",
+                                       defaultValue: "Its \(key.keyType) key has the fingerprint\n\(key.fingerprint)\n\nTrust it only if it matches the fingerprint the server’s administrator gave you. Trusting it adds it to \(key.knownHostsFile.path(percentEncoded: false)), as ssh would.",
+                                       table: "Remote", comment: "first %@ is a key type such as ED25519, second its fingerprint, third a file path")
+        alert.addButton(withTitle: String(localized: "RemotePrompt.hostKey.trust", defaultValue: "Trust and Connect", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        // Trusting a key must be a choice, not what Return does.
+        alert.buttons.first?.keyEquivalent = ""
+        alert.buttons.last?.keyEquivalent = "\r"
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func answerSSHQuestion(_ prompt: String, isConfirmation: Bool, window: NSWindow?) async -> String? {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemotePrompt.sshQuestion.message", defaultValue: "The SSH connection asks:", table: "Remote")
+        alert.informativeText = prompt
+
+        if isConfirmation {
+            alert.addButton(withTitle: String(localized: "RemotePrompt.sshQuestion.yes", defaultValue: "Yes", table: "Remote", comment: "button label"))
+            alert.addButton(withTitle: String(localized: "RemotePrompt.sshQuestion.no", defaultValue: "No", table: "Remote", comment: "button label"))
+            return await Self.run(alert, window: window) == .alertFirstButtonReturn ? "yes" : nil
+        }
+
+        // Every answer is treated as a secret: a one-time code or passphrase must not show either.
+        let field = NSSecureTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 22))
+        alert.accessoryView = field
+        alert.addButton(withTitle: String(localized: "RemotePrompt.sshQuestion.answer", defaultValue: "Continue", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.window.initialFirstResponder = field
+
+        let response = await Self.run(alert, window: window)
+        let answer = field.stringValue
+        field.stringValue = ""
+
+        return (response == .alertFirstButtonReturn) ? answer : nil
+    }
+
+
+    func reportRecoveryFailure(_ error: any Error, fileName: String, window: NSWindow?) async {
+
+        let alert = NSAlert()
+        alert.alertStyle = .critical
+        alert.messageText = String(localized: "RemotePrompt.recovery.message",
+                                   defaultValue: "Newer changes to “\(fileName)” are not protected.", table: "Remote")
+        let information = String(localized: "RemotePrompt.recovery.information",
+                                 defaultValue: "The last protected version is kept. Free some space on this Mac, or save a local copy.", table: "Remote")
+        alert.informativeText = error.localizedDescription + "\n\n" + information
+        alert.addButton(withTitle: String(localized: "RemotePrompt.ok", defaultValue: "OK", table: "Remote", comment: "button label"))
+
+        _ = await Self.run(alert, window: window)
+    }
+
+
+    private static func title(of choice: RemoteConflictChoice) -> String {
+
+        switch choice {
+            case .keepEditing:
+                String(localized: "RemotePrompt.conflict.keepEditing", defaultValue: "Keep Editing", table: "Remote", comment: "button label")
+            case .openRemoteVersion:
+                String(localized: "RemotePrompt.conflict.open", defaultValue: "Open Remote Version", table: "Remote", comment: "button label")
+            case .saveAsRemote:
+                String(localized: "RemotePrompt.conflict.saveAs", defaultValue: "Save As Remote…", table: "Remote", comment: "button label")
+            case .replace:
+                String(localized: "RemotePrompt.conflict.replace", defaultValue: "Replace", table: "Remote", comment: "button label")
+            case .restoreOriginal:
+                String(localized: "RemotePrompt.conflict.restore", defaultValue: "Restore Original", table: "Remote", comment: "button label")
+        }
+    }
+
+
+    /// Shows the alert as a sheet on the window, or as an application-modal alert without one.
+    private static func run(_ alert: NSAlert, window: NSWindow?) async -> NSApplication.ModalResponse {
+
+        // A progress sheet makes way for the question, and comes back after it.
+        let concealed = RemoteProgressSheet.conceal(on: window)
+        defer { RemoteProgressSheet.reveal(on: window, wasConcealed: concealed) }
+
+        if let window, window.isVisible, window.attachedSheet == nil {
+            return await alert.beginSheetModal(for: window)
+        } else {
+            return alert.runModal()
+        }
+    }
+}
