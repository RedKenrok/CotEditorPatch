+    @Test(.timeLimit(.minutes(1))) func quittingAsksOnceAndStopsOnlyOnTermination() async throws {
+
+        try await self.withTerminals(registersDocument: true) { directory, _, engines, prompts in
+            _ = try #require(directory.openTerminalTab())
+            defer { TerminalTermination.revokeConsent() }
+
+            prompts.answers = [false]
+            #expect(await TerminalTermination.requestConsent() == false)
+            #expect(TerminalTermination.needsConsent)
+
+            prompts.answers = [true]
+            #expect(await TerminalTermination.requestConsent())
+            #expect(await TerminalTermination.requestConsent(), "the answer holds for the rest of the attempt")
+            #expect(prompts.closeRequests == [.many(scope: .quit, liveCount: 1), .many(scope: .quit, liveCount: 1)])
+            #expect(engines.made.allSatisfy { $0.shutDownCount == 0 })
+
+            // A dirty-file prompt canceled later in the same quit.
+            TerminalTermination.revokeConsent()
+            #expect(TerminalTermination.needsConsent)
+            #expect(directory.activeTerminalSession?.isLive == true)
+
+            TerminalTermination.stopAllSessions()
+            #expect(engines.made.allSatisfy { $0.shutDownCount == 1 })
+            #expect(directory.terminalSessions.allSatisfy { $0.lifecycle == .closed })
+        }
+    }
