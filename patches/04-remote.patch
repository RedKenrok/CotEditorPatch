+//  limitations under the License.
+//
+
+import Foundation
+import OSLog
+
+
+/// What reopens a remote folder window at the next launch.
+///
+/// AppKit restores only windows whose document has a file, so each remote folder window keeps a
+/// record of its own, `<window ID>.plist` in the store's folder. A record exists while its window is
+/// open; closing the window removes it, except while the app quits. It holds where the folder is,
+/// the tabs, and what the sidebar showed. It never holds credentials, connection or folder handles,
+/// or file contents: remote documents recover from their own recovery records, which the tabs name.
+///
+/// Every value is untrusted when read, as a file in the user's folder can be changed by anyone who
+/// can write there.
+struct RemoteFolderArchive: Codable, Equatable, Sendable {
+
+    static let currentFormatVersion = 1
+
+    var formatVersion = Self.currentFormatVersion
+    var windowID: UUID
+    var identity: RemoteFolderIdentity
+
+    /// The tabs, as `DirectoryDocument.tabArchive` gives them, in a binary property list.
+    var tabs: Data?
+
+    var showsHiddenFiles = false
+
+    /// The window's frame, as `NSWindow.frameDescriptor` gives it.
+    var windowFrame: String?
+
+    /// What the sidebar showed, which a restored window shows until it reconnects.
+    var snapshot: RemoteDirectoryTree.Snapshot?
+
+    var modificationDate = Date.now
+
+
+    /// The tabs as a property list.
+    var tabArchive: [String: Any]? {
+
+        guard let tabs else { return nil }
+
+        return (try? PropertyListSerialization.propertyList(from: tabs, format: nil)) as? [String: Any]
+    }
+
+
+    /// Whether every part of the identity is valid.
+    var isValid: Bool {
+
+        self.formatVersion == Self.currentFormatVersion
+            && (try? self.identity.endpoint.validated()) == self.identity.endpoint
+            && (try? RemotePath.validated(self.identity.path)) != nil
+            && (try? RemotePath.validated(self.identity.requestedPath)) != nil
+            && RemoteEndpoint.isValidName(self.identity.destination.hostName)
+            && RemoteEndpoint.isValidName(self.identity.destination.user)
+            && (1...65535).contains(self.identity.destination.port)
+    }
+}
+
+
+/// Where remote folder windows' records are kept.
+enum RemoteFolderArchiveStore {
+
+    /// Every write and removal of records runs on this queue, in the order it was asked for, so that
+    /// an older version of a record can never replace a newer one.
+    private static let queue = DispatchQueue(label: "RemoteFolderArchiveStore")
+
+
+    /// Writes a record on the store's queue, after every earlier write.
+    static func enqueueWrite(_ archive: RemoteFolderArchive, in root: URL) {
+
+        self.queue.async {
+            do {
+                try self.write(archive, in: root)
+            } catch {
+                Logger.app.error("Failed to write a remote folder window's record: \(error)")
+            }
+        }
+    }
+
+
+    /// Writes a record right away, after every earlier write, as when the app is about to exit.
+    static func writeNow(_ archive: RemoteFolderArchive, in root: URL) throws {
+
+        try self.queue.sync {
+            try self.write(archive, in: root)
+        }
+    }
+
+
+    /// Removes a record on the store's queue, after every earlier write.
+    static func enqueueRemoval(windowID: UUID, in root: URL) {
+
+        self.queue.async {
+            self.remove(windowID: windowID, in: root)
+        }
+    }
+
+
+    /// Waits until every write and removal asked for so far is done.
+    static func waitUntilIdle() async {
+
+        await withCheckedContinuation { continuation in
+            self.queue.async { continuation.resume() }
+        }
+    }
+
+    /// `~/Library/Application Support/<bundle identifier>/RemoteFolders`.
+    static var defaultRoot: URL {
+
+        RemoteRecoveryStore.defaultRoot.deletingLastPathComponent()
+            .appending(component: "RemoteFolders", directoryHint: .isDirectory)
+    }
+
+
+    /// Writes a window's record, replacing its previous one in one step.
+    ///
+    /// The record is written to a new file that only the user can read, flushed, and renamed over the
+    /// old one, so a crash leaves either version whole.
+    static func write(_ archive: RemoteFolderArchive, in root: URL) throws {
+
+        try RemoteRecoveryStore.prepareRoot(root)
+
+        var archive = archive
+        archive.modificationDate = .now
+        let encoder = PropertyListEncoder()
+        encoder.outputFormat = .binary
+        let data = try encoder.encode(archive)
+
+        let temporaryURL = root.appending(component: "." + archive.windowID.uuidString + "-" + UUID().uuidString.lowercased() + ".tmp")
+        try RemoteRecoveryStore.writeExclusively(data, to: temporaryURL)
+
+        guard rename(temporaryURL.path(percentEncoded: false), self.url(of: archive.windowID, in: root).path(percentEncoded: false)) == 0 else {
+            let code = errno
+            unlink(temporaryURL.path(percentEncoded: false))
+            throw RemoteRecoveryError.fileSystem(code)
+        }
+        try RemoteRecoveryStore.synchronizeDirectory(root)
+    }
+
+
+    /// Removes a window's record, if it has one.
+    static func remove(windowID: UUID, in root: URL) {
+
+        unlink(self.url(of: windowID, in: root).path(percentEncoded: false))
+    }
+
+
+    /// Every valid record, newest first. Invalid ones are left out, but not deleted.
+    static func archives(in root: URL) -> [RemoteFolderArchive] {
+
+        guard let names = try? FileManager.default.contentsOfDirectory(atPath: root.path(percentEncoded: false)) else { return [] }
+
+        return names
+            .filter { $0.hasSuffix(".plist") }
+            .compactMap { UUID(uuidString: String($0.dropLast(".plist".count))) }
+            .compactMap { self.archive(of: $0, in: root) }
+            .sorted { $0.modificationDate > $1.modificationDate }
+    }
+
+
+    /// A window's record, if it is valid.
+    static func archive(of windowID: UUID, in root: URL) -> RemoteFolderArchive? {
+
+        let url = self.url(of: windowID, in: root)
+        let descriptor = Darwin.open(url.path(percentEncoded: false), O_RDONLY | O_NOFOLLOW | O_CLOEXEC)
+        guard descriptor >= 0 else { return nil }
+        let data = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true).readDataToEndOfFile()
+
+        guard
+            let archive = try? PropertyListDecoder().decode(RemoteFolderArchive.self, from: data),
+            archive.windowID == windowID,
+            archive.isValid
+        else {
+            Logger.app.error("Skipped an invalid remote folder window record \(windowID)")
+            return nil
+        }
+
+        return archive
+    }
+
+
+    private static func url(of windowID: UUID, in root: URL) -> URL {
+
+        root.appending(component: windowID.uuidString + ".plist", directoryHint: .notDirectory)
+    }
+}
