+@MainActor enum RemoteMenu {
+
+    /// Adds the remote commands to the File menu.
+    ///
+    /// The items exist before the key bindings are read, so users can assign shortcuts to them.
+    static func install(in mainMenu: NSMenu) {
+
+        guard
+            let fileMenu = mainMenu.items.lazy.compactMap(\.submenu)
+                .first(where: { $0.items.contains { $0.action == #selector(NSWindow.performClose(_:)) } })
+        else { return assertionFailure() }
+
+        if let index = fileMenu.items.firstIndex(where: { $0.action == #selector(NSDocumentController.openDocument(_:)) }) {
+            let item = NSMenuItem(title: String(localized: "RemoteMenu.openRemoteFile", defaultValue: "Open Remote File…", table: "Remote",
+                                                comment: "File menu item opening a file on an SSH server"),
+                                  action: #selector(DocumentController.openRemoteFile(_:)), keyEquivalent: "")
+            item.image = NSImage(systemSymbolName: "network", accessibilityDescription: nil)
+            let folderItem = NSMenuItem(title: String(localized: "RemoteMenu.openRemoteFolder", defaultValue: "Open Remote Folder…", table: "Remote",
+                                                      comment: "File menu item opening a folder on an SSH server in a window"),
+                                        action: #selector(DocumentController.openRemoteFolder(_:)), keyEquivalent: "")
+            let recentItem = NSMenuItem(title: String(localized: "RemoteMenu.openRecentRemoteFolder", defaultValue: "Open Recent Remote Folder", table: "Remote",
+                                                      comment: "File menu item with the recently opened remote folders"),
+                                        action: nil, keyEquivalent: "")
+            recentItem.submenu = RemoteRecentFolderMenu.makeMenu(title: recentItem.title)
+            fileMenu.insertItem(item, at: index + 1)
+            fileMenu.insertItem(folderItem, at: index + 2)
+            fileMenu.insertItem(recentItem, at: index + 3)
+        }
+
+        if let index = fileMenu.items.firstIndex(where: { $0.action == #selector(DirectoryDocument.newTerminalTab(_:)) }) {
+            let item = NSMenuItem(title: String(localized: "RemoteMenu.newRemoteShellTab", defaultValue: "New Remote Shell Tab", table: "Remote",
+                                                comment: "File menu item opening a shell on the server of a remote folder window"),
+                                  action: #selector(DirectoryDocument.newRootTerminalTab(_:)), keyEquivalent: "")
+            item.image = NSImage(systemSymbolName: "terminal", accessibilityDescription: nil)
+            fileMenu.insertItem(item, at: index + 1)
+        }
+
+        if let index = fileMenu.items.firstIndex(where: { $0.action == #selector(NSDocument.saveAs(_:)) }) {
+            let localCopy = NSMenuItem(title: String(localized: "RemoteMenu.saveLocalCopy", defaultValue: "Save a Local Copy…", table: "Remote",
+                                                     comment: "File menu item saving a remote document’s text to a file on this Mac"),
+                                       action: #selector(RemoteDocument.saveLocalCopy(_:)), keyEquivalent: "")
+            let revert = NSMenuItem(title: String(localized: "RemoteMenu.revertToRemoteVersion", defaultValue: "Revert to Remote Version", table: "Remote",
