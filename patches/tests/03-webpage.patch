+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Testing
+@testable import CotEditor
+
+/// The webpage session's navigation state and archive, driven by fake navigation events without WebKit.
+@MainActor struct WebPageSessionTests {
+
+    private let pageA = URL(string: "https://example.com/a")!
+    private let pageB = URL(string: "https://example.com/b")!
+    private let failure = URLError(.cannotConnectToHost)
+
+
+    // MARK: Presentation
+
+    @Test func titleFallsBackToTheHostAndThenToWebpage() {
+
+        let session = WebPageSession()
+        #expect(session.title == "Webpage")
+        #expect(session.lifecycle == .empty)
+
+        session.willLoad()
+        session.didUpdate(url: self.pageA, title: "", isLoading: true, canGoBack: false, canGoForward: false)
+        #expect(session.title == "example.com")
+
+        session.didUpdate(url: self.pageA, title: "  A\n page \t title ", isLoading: false, canGoBack: false, canGoForward: false)
+        #expect(session.title == "A page title", "titles become one line")
+
+        #expect(WebPageSession.sanitizedTitle(String(repeating: "x", count: 500))?.count == 201)
+    }
+
+
+    // MARK: Navigation Generations
+
+    @Test func onlyTheNewestNavigationChangesTheState() {
+
+        let session = WebPageSession()
+        let old = Token()
+        let new = Token()
+
+        session.didDecide(url: self.pageA, isSafeToRepeat: true)
+        session.didStartProvisionalNavigation(old.token, url: self.pageA)
+        session.didDecide(url: self.pageB, isSafeToRepeat: true)
+        session.didStartProvisionalNavigation(new.token, url: self.pageB)
+
+        // The old load's late failure must neither show a banner nor stop the new load.
+        session.didFail(old.token, error: self.failure)
+        #expect(session.failure == nil)
+        #expect(session.isLoading)
+
+        session.didFinish(old.token)
+        #expect(session.isLoading, "a stale completion does not end the newer load")
+
+        session.didFinish(new.token)
+        #expect(!session.isLoading)
+    }
+
+
+    @Test func cancellationsAreNotFailures() {
+
+        let session = WebPageSession()
+        let navigation = Token()
+
+        session.didStartProvisionalNavigation(navigation.token, url: self.pageA)
+        session.didFail(navigation.token, error: URLError(.cancelled))
+        #expect(session.failure == nil, "Stop and superseded loads end in a cancellation")
+
+        session.didStartProvisionalNavigation(navigation.token, url: self.pageA)
+        session.didFail(navigation.token, error: NSError(domain: "WebKitErrorDomain", code: 102))
+        #expect(session.failure == nil, "a policy refusal is not a load failure")
+        #expect(!session.isLoading)
+    }
+
+
+    @Test func stopEndsLoadingWithoutAFailure() {
+
+        let session = WebPageSession()
+        let navigation = Token()
+
+        session.didStartProvisionalNavigation(navigation.token, url: self.pageA)
+        session.didStop()
+        #expect(!session.isLoading)
+
+        session.didFail(navigation.token, error: self.failure)
+        #expect(session.failure == nil, "the stopped navigation's late callback changes nothing")
+    }
+
+
+    // MARK: Retry
+
+    @Test func onlyAPairedGETIsRetryable() throws {
+
+        let session = WebPageSession()
+
+        // a GET whose decision asked for the address that started
+        let get = Token()
+        session.didDecide(url: self.pageB, isSafeToRepeat: true)
+        session.didStartProvisionalNavigation(get.token, url: self.pageB)
+        session.didFail(get.token, error: self.failure)
+        let getFailure = try #require(session.failure)
+        #expect(getFailure.isRetryable)
+        #expect(getFailure.url == self.pageB, "Retry requests the failed page, not the one showing")
+        #expect(getFailure.keepsPreviousPage)
+
+        // a POST
+        let post = Token()
+        session.didDecide(url: self.pageB, isSafeToRepeat: false)
+        session.didStartProvisionalNavigation(post.token, url: self.pageB)
+        session.didFail(post.token, error: self.failure)
+        #expect(session.failure?.isRetryable == false)
+
+        // a navigation whose decision named another address is ambiguous
+        let ambiguous = Token()
+        session.didDecide(url: self.pageA, isSafeToRepeat: true)
+        session.didStartProvisionalNavigation(ambiguous.token, url: self.pageB)
+        session.didFail(ambiguous.token, error: self.failure)
+        #expect(session.failure?.isRetryable == false)
+
+        // a navigation without any decision
+        let undecided = Token()
+        session.didStartProvisionalNavigation(undecided.token, url: self.pageB)
+        session.didFail(undecided.token, error: self.failure)
+        #expect(session.failure?.isRetryable == false)
+    }
+
+
+    @Test func aRedirectIsRetryableOnlyIfEveryRequestWas() throws {
+
+        let session = WebPageSession()
+
+        let getChain = Token()
+        session.didDecide(url: self.pageA, isSafeToRepeat: true)
+        session.didStartProvisionalNavigation(getChain.token, url: self.pageA)
+        session.didDecide(url: self.pageB, isSafeToRepeat: true)
+        session.didReceiveRedirect(getChain.token, url: self.pageB)
+        session.didFail(getChain.token, error: self.failure)
+        #expect(session.failure?.isRetryable == true)
+        #expect(session.failure?.url == self.pageB, "the redirect's target is what failed")
+
+        let postChain = Token()
+        session.didDecide(url: self.pageA, isSafeToRepeat: false)
+        session.didStartProvisionalNavigation(postChain.token, url: self.pageA)
+        session.didDecide(url: self.pageB, isSafeToRepeat: true)
+        session.didReceiveRedirect(postChain.token, url: self.pageB)
+        session.didFail(postChain.token, error: self.failure)
+        #expect(session.failure?.isRetryable == false, "a form submission is never rebuilt from its redirect")
+    }
+
+
+    @Test func aFailureAfterCommitDoesNotClaimThePreviousPage() {
+
+        let session = WebPageSession()
+        let navigation = Token()
+
+        session.didDecide(url: self.pageB, isSafeToRepeat: true)
+        session.didStartProvisionalNavigation(navigation.token, url: self.pageB)
+        session.didCommit(navigation.token)
+        session.didFail(navigation.token, error: self.failure)
+        #expect(session.failure?.keepsPreviousPage == false)
+    }
+
+
+    @Test func processTerminationRetriesNothing() {
+
+        let session = WebPageSession()
+        let navigation = Token()
+
+        session.willLoad()
+        session.didStartProvisionalNavigation(navigation.token, url: self.pageA)
+        session.contentProcessDidTerminate()
+        #expect(session.lifecycle == .contentProcessEnded)
+        #expect(!session.isLoading)
+        #expect(session.failure == nil)
+
+        session.didFail(navigation.token, error: self.failure)
+        #expect(session.failure == nil, "callbacks of the ended process are ignored")
+    }
+
+
+    @Test func closedSessionsIgnoreLateCallbacks() {
+
+        let session = WebPageSession()
+        let navigation = Token()
+
+        session.didStartProvisionalNavigation(navigation.token, url: self.pageA)
+        session.close()
+        session.didFail(navigation.token, error: self.failure)
+        session.didUpdate(url: self.pageB, title: "Late", isLoading: true, canGoBack: true, canGoForward: false)
+        session.show(.init(message: "late"))
+
+        #expect(session.lifecycle == .closed)
+        #expect(session.failure == nil)
+        #expect(session.notice == nil)
+        #expect(session.currentURL == nil)
+    }
+
+
+    // MARK: Archive
+
+    @Test func archiveKeepsOnlyAnAllowedAddressAndTitle() throws {
+
+        #expect(WebPageTabArchive.fields(for: .init(id: UUID(), url: nil, title: "Ignored")).isEmpty, "an empty tab archives no address")
+
+        let fields = WebPageTabArchive.fields(for: .init(id: UUID(), url: self.pageA, title: "A"))
+        #expect(fields["url"] as? String == self.pageA.absoluteString)
+        #expect(fields["title"] as? String == "A")
+        #expect(fields.keys.sorted() == ["title", "url"], "nothing but the address and title")
+
+        let publicHTTP = try #require(URL(string: "http://example.com/"))
+        #expect(WebPageTabArchive.fields(for: .init(id: UUID(), url: publicHTTP, title: "A"))["url"] == nil)
+        let credentials = try #require(URL(string: "https://user:secret@example.com/"))
+        #expect(WebPageTabArchive.fields(for: .init(id: UUID(), url: credentials, title: "A"))["url"] == nil)
+    }
+
+
+    @Test func archiveDecodingSkipsMalformedEntries() throws {
+
+        let ids = (0..<7).map { _ in UUID() }
+        func entry(_ index: Int, _ fields: [String: Any], kind: String = WebPageTabArchive.kind) -> DirectoryTabArchive.ForeignEntry {
+            DirectoryTabArchive.ForeignEntry(id: ids[index], kind: kind, fields: fields as NSDictionary)
+        }
+
+        let archive = WebPageTabArchive(entries: [
+            entry(0, ["url": "http://localhost:3000/", "title": "Local"]),
+            entry(1, [:]),
+            entry(2, ["url": "http://example.com/"]),
+            entry(3, ["url": 42]),
+            entry(4, ["url": "https://user:pw@example.com/"]),
+            entry(5, ["url": "https://example.com/", "title": 7]),
+            entry(6, ["url": "https://example.com/"], kind: "terminal"),
+        ])
+
+        #expect(archive.webPages.map(\.id) == [ids[0], ids[1], ids[5]])
+        #expect(archive.webPages[0].url?.absoluteString == "http://localhost:3000/")
+        #expect(archive.webPages[0].title == "Local")
+        #expect(archive.webPages[1].url == nil, "an empty tab comes back empty")
+        #expect(archive.webPages[2].title == nil, "a title that is not a string is dropped")
+    }
+
+
+    @Test func restoredSessionsLoadNothingByThemselves() {
+
+        let session = WebPageSession(id: UUID(), restoring: self.pageA, title: "A")
+        #expect(session.lifecycle == .restored)
+        #expect(session.address == self.pageA)
+        #expect(session.title == "A")
+
+        // A restored tab's empty web view reports nothing until it loads.
+        session.didUpdate(url: nil, title: nil, isLoading: false, canGoBack: false, canGoForward: false)
+        #expect(session.title == "A")
+
+        #expect(WebPageSession(id: UUID(), restoring: nil, title: "ignored").lifecycle == .empty)
+    }
+
+
+    // MARK: Dialogs
+
+    @Test func dialogOriginsNameTheFrameNotThePage() {
+
+        #expect(WebPageDialog.origin(protocol: "https", host: "example.com", port: 443) == "https://example.com")
+        #expect(WebPageDialog.origin(protocol: "http", host: "localhost", port: 3000) == "http://localhost:3000")
+        #expect(WebPageDialog.origin(protocol: "http", host: "::1", port: 0) == "http://[::1]")
+        #expect(WebPageDialog.origin(protocol: "http", host: "[::1]", port: 8080) == "http://[::1]:8080")
+        #expect(WebPageDialog.origin(protocol: "", host: "", port: 0) == nil)
+
+        #expect(WebPageDialog(kind: .alert, message: "", origin: nil).safeResponse == .acknowledged)
+        #expect(WebPageDialog(kind: .confirmation, message: "", origin: nil).safeResponse == .confirmed(false))
+        #expect(WebPageDialog(kind: .textInput(defaultText: "x"), message: "", origin: nil).safeResponse == .text(nil))
+    }
+}
+
+
+/// An object whose identity stands for one WebKit navigation.
+private final class Token {
+
+    @MainActor var token: WebPageSession.NavigationToken  { .init(self) }
+}
