+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// The webpage part of a directory's tab archive.
+///
+/// Webpage tabs are entries of kind `webpage` in the versioned `DirectoryTabArchive` list. Only the
+/// address of the page that was showing and its title are kept, and the address only if the navigation
+/// policy allows it. Cookies, credentials, navigation history, page contents, form values and address
+/// edits are never archived.
+struct WebPageTabArchive: Equatable {
+
+    struct Entry: Equatable {
+
+        var id: UUID
+        /// The address to offer, or `nil` for a tab that showed no page.
+        var url: URL?
+        var title: String?
+    }
+
+
+    static let kind = "webpage"
+
+    var webPages: [Entry]
+
+
+    // MARK: Encoding
+
+    /// The archive fields of a webpage tab.
+    static func fields(for entry: Entry) -> [String: Any] {
+
+        var fields: [String: Any] = [:]
+        if let url = entry.url, WebPageNavigationPolicy.refusal(for: url) == nil {
+            fields["url"] = url.absoluteString
+            fields["title"] = entry.title
+        }
+        return fields
+    }
+
+
+    // MARK: Decoding
+
+    /// Reads archived webpage entries.
+    ///
+    /// Archived values are untrusted: an entry whose address is not a string, cannot be parsed, or is
+    /// refused by the navigation policy is skipped, and a title that is not a string is dropped. The
+    /// directory archive has already dropped entries without a valid and unique ID.
+    ///
+    /// - Parameter entries: The directory archive's entries.
+    init(entries: [DirectoryTabArchive.ForeignEntry]) {
+
+        self.webPages = entries.filter { $0.kind == Self.kind }.compactMap { entry in
+            let fields = entry.fields
+            let url: URL?
+            switch fields["url"] {
+                case nil:
+                    url = nil
+                case let string as String:
+                    guard let parsed = URL(string: string, encodingInvalidCharacters: false),
+                          WebPageNavigationPolicy.refusal(for: parsed) == nil
+                    else { return nil }
+                    url = parsed
+                default:
+                    return nil
+            }
+
+            return Entry(id: entry.id, url: url,
+                         title: url == nil ? nil : (fields["title"] as? String).flatMap(WebPageSession.sanitizedTitle))
+        }
+    }
+}
