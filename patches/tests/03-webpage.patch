+    @Test(.timeLimit(.minutes(1))) func refusedDestinationsKeepThePage() async throws {
+
+        try await self.withWebPages { directory, _, server, _ in
+            server.route("/a", .page("<title>Page A</title>"))
+            server.route("/to-public", .redirect("http://8.8.8.8/"))
+            server.route("/opener", .page("<title>Opener</title><script>window.open('/popped')</script>"))
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+
+            controller.load(server.url("/a"))
+            try await self.wait { session.title == "Page A" && !session.isLoading }
+
+            // a link to public HTTP
+            _ = try await self.evaluate("location.href = 'http://example.com/'", in: controller.webView)
+            try await self.wait { session.notice != nil }
+            #expect(session.notice?.message.contains("example.com") == true)
+            #expect(session.currentURL == server.url("/a"))
+            #expect(session.failure == nil, "a refusal is not a load failure")
+
+            // a redirect to public HTTP
+            session.dismissMessages()
+            controller.load(server.url("/to-public"))
+            try await self.wait { session.notice != nil && !session.isLoading }
+            #expect(session.notice?.message.contains("8.8.8.8") == true)
+            #expect(session.failure == nil)
+
+            // typed public HTTP, which never reaches WebKit
+            session.dismissMessages()
+            controller.submitAddress("http://example.com/")
+            #expect(session.notice?.message.contains("example.com") == true)
+
+            // a script that opens a window without a user gesture gets none
+            controller.load(server.url("/opener"))
+            try await self.wait { session.title == "Opener" && !session.isLoading }
+            try await Task.sleep(for: .milliseconds(300))
+            #expect(server.count("/popped") == 0)
+            #expect(session.currentURL == server.url("/opener"))
+        }
+    }
