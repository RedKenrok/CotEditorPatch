+
+import AppKit
+import Defaults
+
+
+/// The open remote documents, by identity, so that a file is never open twice.
+@MainActor final class RemoteDocumentRegistry {
+
+    static let shared = RemoteDocumentRegistry()
+
+    private struct Entry {
+
+        weak var document: RemoteDocument?
+    }
+
+    private var entries: [RemoteFileIdentity: Entry] = [:]
+
+
+    /// The document editing the file, if one is open.
+    func document(for identity: RemoteFileIdentity) -> RemoteDocument? {
+
+        self.entries[identity]?.document
+    }
+
+
+    /// The document with the recovery record, if one is open.
+    func document(documentID: UUID) -> RemoteDocument? {
+
+        self.entries.values.lazy.compactMap(\.document).first { $0.documentID == documentID }
+    }
+
+
+    /// Every open document that edits a remote file.
+    var documents: [RemoteDocument] {
+
+        self.entries.values.compactMap(\.document)
+    }
+
+
+    func register(_ document: RemoteDocument) {
+
+        guard document.role == .editor else { return }
+
+        self.entries[document.identity] = Entry(document: document)
+    }
+
+
+    func unregister(_ document: RemoteDocument) {
+
+        guard self.entries[document.identity]?.document === document else { return }
+
+        self.entries[document.identity] = nil
+    }
+}
+
+
+/// What the user asked to open.
+struct RemoteOpenRequest: Equatable, Sendable {
+
+    var profileID: UUID?
+    var endpoint: RemoteEndpoint
+    var path: String
+}
+
+
+enum RemoteOpenError: Error, Equatable {
+
+    /// The file changed or moved while it was being opened.
+    case changedWhileOpening
+}
+
+
+extension RemoteOpenError: LocalizedError {
+
+    var errorDescription: String? {
+
+        String(localized: "RemoteOpenError.changedWhileOpening", defaultValue: "The file changed on the server while it was being opened.", table: "Remote")
+    }
+
+
+    var recoverySuggestion: String? {
+
+        String(localized: "RemoteOpenError.changedWhileOpening.recoverySuggestion", defaultValue: "Try opening it again.", table: "Remote")
+    }
+}
+
+
+/// Opens remote files: downloads them, and attaches them to a directory window or a window of their own.
+@MainActor enum RemoteOpenCoordinator {
+
+    private struct PendingKey: Hashable {
+
+        var endpoint: RemoteEndpoint
+        var destination: RemoteDestination
+        /// The path's bytes: `String` equality treats composed and decomposed characters as equal,
+        /// but the server's file system generally names two different files with them.
+        var path: [UInt8]
+    }
+
+
+    /// Opens that are under way, so that asking twice at once opens the file once.
+    private static var pending: [PendingKey: Task<RemoteDocument, any Error>] = [:]
+
+
+    // MARK: Opening
+
+    /// Opens a remote file, or shows it if it is already open.
+    ///
+    /// - Parameters:
+    ///   - request: What to open.
+    ///   - directory: The directory window to open it in as a tab, if file tabs are on.
+    ///   - window: The window for questions.
+    ///   - environment: The services the document works with.
+    ///   - attach: Whether to show the document in a tab or window; tests of documents alone leave it out.
+    ///   - asMember: Whether the caller makes a new document a member of the directory itself, as a
+    ///     folder window does with its files, whatever the file tabs preference.
+    /// - Returns: The document showing the file.
+    @discardableResult static func open(_ request: RemoteOpenRequest, in directory: DirectoryDocument?, window: NSWindow?, environment: RemoteEnvironment = .current, attach: Bool = true, asMember: Bool = false) async throws -> RemoteDocument {
+
+        let endpoint = try request.endpoint.validated()
+        let path = try RemotePath.validated(request.path)
+        let destination = try await environment.pool.destination(for: endpoint)
+
+        let key = PendingKey(endpoint: endpoint, destination: destination, path: Array(path.utf8))
+        if let task = self.pending[key] {
+            let document = try await task.value
+            self.show(document)
+            return document
+        }
+
+        let isStandalone = !asMember && (directory == nil || !UserDefaults.standard[.usesDirectoryFileTabs])
+        let task = Task {
+            try await self.download(RemoteFileIdentity(profileID: request.profileID, endpoint: endpoint, destination: destination, requestedPath: path, path: path),
+                                    directory: directory, window: window, environment: environment, attach: attach, isStandalone: isStandalone)
+        }
+        self.pending[key] = task
+        defer { self.pending[key] = nil }
+
+        return try await task.value
+    }
+
+
+    /// Shows an open document, selecting its tab if it has one.
+    static func show(_ document: RemoteDocument) {
+
+        if let directory = document.directoryDocument {
+            directory.selectDocument(document)
+            directory.windowController?.showWindow(nil)
+        } else {
+            document.showWindows()
+        }
+    }
+
+
+    /// Attaches a document to the directory window as a tab, or else gives it a window of its own.
+    static func present(_ document: RemoteDocument, in directory: DirectoryDocument?) {
+
+        if let directory, UserDefaults.standard[.usesDirectoryFileTabs], directory.adoptMember(document, select: true) {
+            directory.windowController?.showWindow(nil)
+        } else {
+            if !NSDocumentController.shared.documents.contains(where: { $0 === document }) {
+                NSDocumentController.shared.addDocument(document)
+            }
+            document.makeWindowControllers()
+            document.showWindows()
+        }
+    }
+
+
+    /// Shows a document next to another one: in the same directory window, or in a window of its own.
+    static func present(_ document: RemoteDocument, beside other: RemoteDocument) {
+
+        self.present(document, in: other.directoryDocument)
+    }
+
+
+    // MARK: Restoration
+
+    /// Recreates a document from its recovery record, offline, without connecting.
+    ///
+    /// - Parameters:
+    ///   - documentID: The ID of the recovery record.
+    ///   - environment: The services the document works with.
+    /// - Returns: The document; an already open one if the record belongs to one.
+    static func restore(documentID: UUID, environment: RemoteEnvironment = .current) throws -> RemoteDocument {
+
+        if let document = RemoteDocumentRegistry.shared.document(documentID: documentID) { return document }
+
+        let record = try RemoteRecoveryRecord.open(in: environment.recoveryRoot, documentID: documentID)
+        let manifest = record.initialManifest
+
+        let document: RemoteDocument
+        do {
+            let baseline = try record.data(of: manifest.baseline.file)
+            document = try RemoteDocument(identity: manifest.identity, documentID: documentID, record: record, role: .editor, contents: baseline, environment: environment)
+            if let text = manifest.text {
+                let string = try RemoteRecoveryManifest.decodeText(try record.data(of: text.file))
+                document.applyRecoveredText(string, settings: text.settings, generation: text.generation, baseline: baseline)
+            }
+        } catch {
+            Task { await record.relinquish() }
+            throw error
+        }
+
+        RemoteDocumentRegistry.shared.register(document)
+        Task {
+            try? await record.setPresentation(isOpen: true, keepsAfterClose: false)
+            await document.refreshManifest()
+        }
+
+        return document
+    }
+
+
+    /// Replaces a placeholder, whose recovery data was gone, with the file downloaded again.
+    static func reconnect(_ placeholder: RemoteDocument) async {
+
+        let identity = placeholder.identity
+        let directory = placeholder.directoryDocument
+        let request = RemoteOpenRequest(profileID: identity.profileID, endpoint: identity.endpoint, path: identity.requestedPath)
+        let tab = directory.flatMap { directory in
+            directory.tabState.entries.firstIndex { $0.document === placeholder }.map { (index: $0, id: directory.tabState.entries[$0].id) }
+        }
+
+        do {
+            let document = try await self.open(request, window: placeholder.windowForSheet, environment: placeholder.environment)
+            if let directory, let tab {
+                _ = await directory.closeDocument(placeholder)
+                directory.adoptMember(document, tabID: tab.id, select: true)
+                if let id = directory.tabState.entry(for: document)?.id {
+                    directory.moveTab(id: id, to: tab.index)
+                }
+            } else {
+                placeholder.close()
+                self.present(document, in: nil)
+            }
+        } catch is CancellationError {
+            return
+        } catch {
+            placeholder.presentErrorAsSheet(error)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    /// Downloads a file without attaching it to a window.
+    private static func open(_ request: RemoteOpenRequest, window: NSWindow?, environment: RemoteEnvironment) async throws -> RemoteDocument {
+
+        let endpoint = try request.endpoint.validated()
+        let path = try RemotePath.validated(request.path)
+        let destination = try await environment.pool.destination(for: endpoint)
+
+        return try await self.download(RemoteFileIdentity(profileID: request.profileID, endpoint: endpoint, destination: destination, requestedPath: path, path: path),
+                                       directory: nil, window: window, environment: environment, attach: false, isStandalone: true)
+    }
+
+
+    /// Resolves, downloads and opens a file.
+    ///
+    /// - Parameters:
+    ///   - requested: The file as asked for; its `path` is resolved on the server first.
+    ///   - directory: The directory window to open it in as a tab, if file tabs are on.
+    ///   - window: The window for questions.
+    ///   - environment: The services the document works with.
+    ///   - attach: Whether to show the document in a window.
+    ///   - isStandalone: Whether a new document is shown in a window of its own rather than in a folder window.
+    private static func download(_ requested: RemoteFileIdentity, directory: DirectoryDocument?, window: NSWindow?, environment: RemoteEnvironment, attach: Bool = true, isStandalone: Bool) async throws -> RemoteDocument {
+
+        let (profileID, endpoint, destination, path) = (requested.profileID, requested.endpoint, requested.destination, requested.requestedPath)
+        let pool = environment.pool
+        let limits = await pool.limits
+
+        // Where the path leads; a symbolic link is edited through its target only with the user's approval.
+        let (resolvedPath, isLink) = try await pool.withReadingConnection(to: endpoint, destination: destination) { transport in
+            let attributes = try await transport.lstat(path)
+            return (try await transport.realpath(path), attributes.kind == .symbolicLink)
+        }
+        if isLink {
+            guard await environment.prompts.approveSymbolicLink(path: path, target: resolvedPath, window: window) else { throw CancellationError() }
+        }
+
+        let identity = RemoteFileIdentity(profileID: profileID, endpoint: endpoint, destination: destination, requestedPath: path, path: resolvedPath)
+        if let document = RemoteDocumentRegistry.shared.document(for: identity) {
+            if attach { self.show(document) }
+            return document
+        }
+
+        let contents = try await pool.withReadingConnection(to: endpoint, destination: destination) { transport in
+            guard RemotePath.isSame(try await transport.realpath(path), resolvedPath) else { throw RemoteOpenError.changedWhileOpening }
+            return try await transport.readFile(at: resolvedPath, limit: limits.transferCap)
+        }
+        guard contents.attributesBefore.matchesForChangeDetection(contents.attributesAfter) else { throw RemoteOpenError.changedWhileOpening }
+
+        let threshold = UserDefaults.standard[.largeFileAlertThreshold]
+        if threshold > 0, contents.data.count > threshold {
+            guard await environment.prompts.confirmOpeningLargeFile(fileName: identity.fileName, size: contents.data.count, window: window) else {
+                throw CancellationError()
+            }
+        }
+
+        // Another open of the same file may have finished during the download.
+        if let document = RemoteDocumentRegistry.shared.document(for: identity) {
+            if attach { self.show(document) }
+            return document
+        }
+
+        let documentID = UUID()
+        let record = try RemoteRecoveryRecord.create(in: environment.recoveryRoot, documentID: documentID, identity: identity,
+                                                     baseline: contents.data, attributes: contents.attributesAfter, isStandalone: isStandalone)
+        let document: RemoteDocument
+        do {
+            document = try RemoteDocument(identity: identity, documentID: documentID, record: record, role: .editor, contents: contents.data, environment: environment)
+        } catch {
+            try? await record.remove()
+            throw error
+        }
+
+        RemoteDocumentRegistry.shared.register(document)
+        RemoteConnectionLibrary.shared.noteRecentPath(path, for: endpoint)
+        await document.refreshManifest()
+
+        if attach {
+            self.present(document, in: directory)
+        }
+
+        return document
+    }
+}
