+    /// Adds a group-writable file of another user in a folder this user cannot write, which is saved in place.
+    private func addFileOfAnotherUser(_ path: String, _ contents: String, on server: FakeSFTPServer) async {
+
+        await server.addFile(path, contents, userID: 33, groupID: 20, mode: 0o664)
+        await server.setDirectory(RemotePath.parent(of: path), userID: 33, mode: 0o755)
+    }
