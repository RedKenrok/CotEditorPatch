+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+import Defaults
+import UserNotifications
+
+
+extension DefaultKeys {
+
+    /// Whether programs in terminals may show notifications.
+    static let terminalPostsNotifications = DefaultKey<Bool>("terminalPostsNotifications")
+}
+
+
+/// A notification that a program in a terminal asked for, such as a coding agent that finished its work.
+///
+/// Programs ask with the escape sequence `ESC ] 777 ; notify ; title ; body BEL` (OSC 777), which
+/// several terminals understand. The text comes from untrusted output, so it is cleaned and bounded.
+struct TerminalNotification: Equatable, Sendable {
+
+    static let maximumTitleLength = 120
+    static let maximumBodyLength = 400
+
+    var title: String
+    var body: String
+
+
+    init(title: String, body: String) {
+
+        self.title = Self.cleaned(title, limit: Self.maximumTitleLength)
+        self.body = Self.cleaned(body, limit: Self.maximumBodyLength)
+    }
+
+
+    /// Decodes the payload of an OSC 777 sequence, the part after `777;`.
+    ///
+    /// The body is everything after the second separator, so it may contain semicolons itself.
+    ///
+    /// - Parameter payload: The bytes between `777;` and the sequence's terminator.
+    /// - Returns: The notification, or `nil` if the payload is not a notification in UTF-8 or has no text.
+    init?(osc777 payload: ArraySlice<UInt8>) {
+
+        guard let text = String(bytes: payload, encoding: .utf8) else { return nil }
+
+        let fields = text.split(separator: ";", maxSplits: 2, omittingEmptySubsequences: false)
+
+        guard fields.count >= 2, fields[0] == "notify" else { return nil }
+
+        self.init(title: String(fields[1]), body: fields.count > 2 ? String(fields[2]) : "")
+
+        guard !self.title.isEmpty || !self.body.isEmpty else { return nil }
+    }
+
+
+    /// Makes text safe to show in a notification: one line, without controls or invisible formatting.
+    ///
+    /// Format characters include bidirectional overrides, which could make the text read differently
+    /// from what it is.
+    private static func cleaned(_ text: String, limit: Int) -> String {
+
+        let scalars = text.unicodeScalars.compactMap { scalar -> Unicode.Scalar? in
+            switch scalar.properties.generalCategory {
+                case .format: nil
+                case .control, .lineSeparator, .paragraphSeparator: " "
+                default: scalar
+            }
+        }
+        let words = String(String.UnicodeScalarView(scalars)).split(whereSeparator: \.isWhitespace)
+
+        return String(words.joined(separator: " ").prefix(limit))
+    }
+}
+
+
+/// Shows the notifications that programs in terminals ask for.
+///
+/// Every notification goes through this protocol so that tests can record them without involving
+/// Notification Center.
+@MainActor protocol TerminalNotifying {
+
+    /// Shows a notification for a terminal tab.
+    func post(_ notification: TerminalNotification, from session: TerminalSession, in directory: DirectoryDocument)
+}
+
+
+@MainActor enum TerminalNotifications {
+
+    /// The notifier in use; tests replace it.
+    static var current: any TerminalNotifying = TerminalUserNotifications.shared
+
+    /// The key in a notification's user info that names the terminal session it came from.
+    nonisolated static let sessionIDKey = "terminalSessionID"
+
+
+    /// Makes clicks on terminal notifications bring their tabs forward.
+    ///
+    /// Notification Center reports a click on a notification of an earlier launch as the app starts,
+    /// so this must run before launching finishes.
+    static func install() {
+
+        UNUserNotificationCenter.current().delegate = TerminalUserNotifications.shared
+    }
+
+
+    /// Selects the terminal tab with the given ID in its window and brings the window forward.
+    ///
+    /// - Parameters:
+    ///   - sessionID: The ID of the session the notification came from.
+    ///   - activatesApp: Whether to make the app the active one; only tests pass `false`.
+    /// - Returns: `false` if no open window has that terminal any more.
+    @discardableResult static func reveal(sessionID: UUID, activatesApp: Bool = true) -> Bool {
+
+        let directories = NSDocumentController.shared.documents.compactMap { $0 as? DirectoryDocument }
+
+        guard
+            let directory = directories.first(where: { $0.terminalSessions.contains { $0.id == sessionID } }),
+            let session = directory.terminalSessions.first(where: { $0.id == sessionID })
+        else { return false }
+
+        directory.selectTerminal(session)
+        directory.showWindows()
+        if activatesApp {
+            NSApp.activate()
+        }
+        directory.windowContentViewController?.focusActiveTab()
+
+        return true
+    }
+}
+
+
+extension DirectoryDocument {
+
+    /// Shows a notification that a program in one of the window's terminals asked for, unless the user
+    /// is looking at that terminal already or turned notifications from programs off.
+    ///
+    /// - Parameters:
+    ///   - notification: What the program asked to show.
+    ///   - session: The terminal the program runs in.
+    ///   - appIsActive: Whether the app is the active one; only tests pass this.
+    func postTerminalNotification(_ notification: TerminalNotification, from session: TerminalSession, appIsActive: Bool = NSApp.isActive) {
+
+        guard
+            UserDefaults.standard[.terminalPostsNotifications],
+            !self.isShowingTerminal(session, appIsActive: appIsActive)
+        else { return }
+
+        TerminalNotifications.current.post(notification, from: session, in: self)
+    }
+
+
+    /// Whether the user sees the terminal in front: its tab is selected in the window they work in,
+    /// while the app is active.
+    private func isShowingTerminal(_ session: TerminalSession, appIsActive: Bool) -> Bool {
+
+        guard
+            appIsActive,
+            self.activeTerminalSession === session,
+            let window = self.windowForSheet,
+            window.isVisible, !window.isMiniaturized
+        else { return false }
+
+        if window.isKeyWindow || window.isMainWindow { return true }
+
+        // The test host is never active, so it has no main window; the frontmost window stands in for it.
+        guard NSApp.mainWindow == nil else { return false }
+
+        return NSApp.orderedWindows.first { $0.isVisible && $0.canBecomeMain } === window
+    }
+}
+
+
+/// Shows terminal notifications in Notification Center and brings their tab forward when clicked.
+///
+/// Each terminal tab has at most one notification there: a newer one replaces the older, so a program
+/// that notifies after every task leaves one entry per tab rather than a growing list.
+@MainActor final class TerminalUserNotifications: NSObject, TerminalNotifying, UNUserNotificationCenterDelegate {
+
+    static let shared = TerminalUserNotifications()
+
+
+    func post(_ notification: TerminalNotification, from session: TerminalSession, in directory: DirectoryDocument) {
+
+        // The tab and folder name the source: the text alone comes from the program and could claim anything.
+        let folder: String = directory.displayName
+        let source = String(localized: "TerminalNotification.source", defaultValue: "\(session.title) in \(folder)", table: "Terminal",
+                            comment: "subtitle of a notification from a program in a terminal tab (first %@ is the tab name, second %@ the window’s folder name)")
+        let title = notification.title.isEmpty ? session.title : notification.title
+        let subtitle = notification.title.isEmpty ? folder : source
+        let body = notification.body
+        let identifier = session.id.uuidString
+
+        Task {
+            let center = UNUserNotificationCenter.current()
+
+            // Asks the user only the first time; afterwards this returns their answer at once.
+            guard (try? await center.requestAuthorization(options: [.alert, .sound])) == true else { return }
+
+            let content = UNMutableNotificationContent()
+            content.title = title
+            content.subtitle = subtitle
+            content.body = body
+            content.sound = .default
+            content.threadIdentifier = identifier
+            content.userInfo = [TerminalNotifications.sessionIDKey: identifier]
+
+            try? await center.add(UNNotificationRequest(identifier: identifier, content: content, trigger: nil))
+        }
+    }
+
+
+    nonisolated func userNotificationCenter(_ center: UNUserNotificationCenter, willPresent notification: UNNotification) async -> UNNotificationPresentationOptions {
+
+        // Posted only while the user does not see the terminal, so it shows even with the app in front.
+        [.banner, .list, .sound]
+    }
+
+
+    nonisolated func userNotificationCenter(_ center: UNUserNotificationCenter, didReceive response: UNNotificationResponse) async {
+
+        guard
+            response.actionIdentifier == UNNotificationDefaultActionIdentifier,
+            let id = (response.notification.request.content.userInfo[TerminalNotifications.sessionIDKey] as? String).flatMap(UUID.init(uuidString:))
+        else { return }
+
+        await TerminalNotifications.reveal(sessionID: id)
+    }
+}
