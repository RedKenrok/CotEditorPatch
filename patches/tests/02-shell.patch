+import AppKit
+import Testing
+@testable import CotEditor
+
+/// Terminal colors derived from CotEditor themes, without changing any setting.
+@MainActor struct TerminalColorsTests {
+
+    // MARK: Palette
+
+    @Test func programColorsTakeTheClosestThemeHues() {
+
+        let theme = Self.theme(background: 0x1E1E1E, text: 0xD4D4D4, syntax: [
+            \.keywords: 0xE0443A,    // red
+            \.strings: 0x3FA34D,     // green
+            \.numbers: 0xC9A227,     // yellow
+            \.commands: 0x3C7FE0,    // blue
+            \.types: 0xB04BD1,       // magenta
+            \.characters: 0x2AA7B8,  // cyan
+            \.comments: 0x7A7A7A,
+        ])
+        let colors = TerminalColors(theme: theme, derivesPalette: true)
+        let palette = try! #require(colors.palette)
+
+        #expect(palette.count == 16)
+        #expect(Self.hex(palette[1]) == 0xE0443A)
+        #expect(Self.hex(palette[2]) == 0x3FA34D)
+        #expect(Self.hex(palette[3]) == 0xC9A227)
+        #expect(Self.hex(palette[4]) == 0x3C7FE0)
+        #expect(Self.hex(palette[5]) == 0xB04BD1)
+        #expect(Self.hex(palette[6]) == 0x2AA7B8)
+        #expect(Self.hex(palette[8]) == 0x7A7A7A, "bright black is the comment color")
+        #expect(palette[9].brightnessComponent > palette[1].brightnessComponent, "bright variants are lighter on a dark background")
+
+        #expect(Self.hex(colors.foreground) == 0xD4D4D4)
+        #expect(Self.hex(colors.background) == 0x1E1E1E)
+    }
+
+
+    @Test func unfittingOrUnreadableColorsKeepTheStandardOnes() {
+
+        // A dark blue on a dark background is too hard to read, and nothing is green or cyan.
+        let theme = Self.theme(background: 0x101010, text: 0xE0E0E0, syntax: [
+            \.keywords: 0xE0443A,
+            \.commands: 0x14143C,
+            \.strings: 0x808080,
+        ])
+        let palette = try! #require(TerminalColors(theme: theme, derivesPalette: true).palette)
+
+        #expect(Self.hex(palette[1]) == 0xE0443A)
+        for index in [2, 4, 6] {
+            #expect(palette[index] == TerminalColors.standardPalette[index], "slot \(index) keeps the standard color")
+        }
+    }
+
+
+    @Test func lightThemesKeepBrightVariantsReadable() {
+
+        let theme = Self.theme(background: 0xFFFFFF, text: 0x202020, syntax: [\.keywords: 0xC0302A])
+        let palette = try! #require(TerminalColors(theme: theme, derivesPalette: true).palette)
+
+        #expect(Self.hex(palette[1]) == 0xC0302A)
+        #expect(Self.hex(palette[9]) == 0xC0302A, "lightening would cost contrast on a light background")
+    }
+
+
+    @Test func standardPaletteWhenNotDerived() {
+
+        let theme = Self.theme(background: 0x1E1E1E, text: 0xD4D4D4, syntax: [\.keywords: 0xE0443A])
+        let colors = TerminalColors(theme: theme, derivesPalette: false)
+
+        #expect(colors.palette == nil)
+        #expect(Self.hex(colors.background) == 0x1E1E1E, "the base colors still follow the theme")
+    }
+
+
+    // MARK: Theme Resolution
+
+    @Test func sameAsEditorFollowsTheEditorTheme() {
+
+        for isDark in [false, true] {
+            #expect(TerminalColors.themeName(setting: "", isDark: isDark, pinsAppearance: false)
+                    == ThemeManager.shared.userDefaultSettingName(inDarkMode: isDark))
+        }
+    }
+
+
+    @Test func chosenThemeSwitchesToItsAppearanceVariant() {
+
+        let usesDark = ThemeManager.shared.usesDarkAppearance(inDarkMode: true)
+
+        #expect(TerminalColors.themeName(setting: "Dendrobates", isDark: true, pinsAppearance: false)
+                == (usesDark ? "Dendrobates (Dark)" : "Dendrobates"))
+        #expect(TerminalColors.themeName(setting: "Dendrobates", isDark: true, pinsAppearance: true) == "Dendrobates",
+                "a pinned theme keeps its own appearance")
+        #expect(TerminalColors.themeName(setting: "Mono", isDark: true, pinsAppearance: false) == "Mono",
+                "a theme without a dark variant stays itself")
+        #expect(TerminalColors.themeName(setting: "Removed Theme", isDark: false, pinsAppearance: false)
+                == ThemeManager.shared.userDefaultSettingName(inDarkMode: false), "a missing theme falls back to the editor's")
+    }
+
+
+    // MARK: Helpers
+
+    private static func theme(background: Int, text: Int, syntax: [WritableKeyPath<Theme, Theme.Style>: Int]) -> Theme {
+
+        var theme = Theme()
+        theme.background = .init(color: self.color(background))
+        theme.text = .init(color: self.color(text))
+        for keyPath in [\Theme.keywords, \.commands, \.types, \.attributes, \.variables, \.values, \.numbers, \.strings, \.characters, \.comments] {
+            theme[keyPath: keyPath] = .init(color: syntax[keyPath].map(self.color) ?? self.color(text))
+        }
+        return theme
+    }
+
+
+    private static func color(_ hex: Int) -> NSColor {
+
+        NSColor(srgbRed: CGFloat((hex >> 16) & 0xFF) / 255, green: CGFloat((hex >> 8) & 0xFF) / 255, blue: CGFloat(hex & 0xFF) / 255, alpha: 1)
+    }
+
+
+    private static func hex(_ color: NSColor) -> Int {
+
+        let color = color.usingColorSpace(.sRGB)!
+        let component = { (value: CGFloat) in Int((value * 255).rounded()) }
+
+        return component(color.redComponent) << 16 | component(color.greenComponent) << 8 | component(color.blueComponent)
+    }
+}
