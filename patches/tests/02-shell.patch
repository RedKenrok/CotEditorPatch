+    @Test(.timeLimit(.minutes(1))) func aRootsLauncherStartsTheTerminalsOfAWindowWithoutALocalFolder() async throws {
+
+        let engines = FakeTerminalEngines()
+        let originalFactory = TerminalSession.defaultEngineFactory
+        TerminalSession.defaultEngineFactory = engines.make
+        let key = DefaultKeys.usesDirectoryFileTabs.rawValue
+        let original = UserDefaults.standard.object(forKey: key)
+        UserDefaults.standard[.usesDirectoryFileTabs] = true
+        let root = FakeTerminalRoot()
+        let directory = DirectoryDocument(root: root)
+        directory.makeWindowControllers()
+        directory.showWindows()
+        defer {
+            directory.close()
+            TerminalSession.defaultEngineFactory = originalFactory
+            UserDefaults.standard.set(original, forKey: key)
+        }
+
+        #expect(directory.canOpenTerminals)
+        #expect(directory.validateUserInterfaceItem(NSMenuItem(title: "", action: #selector(DirectoryDocument.newTerminalTab(_:)), keyEquivalent: "")))
+        #expect(directory.newTerminalMenuItem.isEnabled)
+
+        await directory.requestTerminalTab()
+        let session = try #require(directory.activeTerminalSession)
+        let engine = try #require(engines.made.first)
+        #expect(engine.configurations.first?.executable == "/usr/bin/true", "the launcher decides what runs")
+        #expect(session.tabToolTip.contains("elsewhere:/folder"))
+        #expect(session.archivedFields() == nil, "only the launcher could start it again")
+
+        // A failure keeps the tab with its output; starting again makes a new process.
+        engine.finish(code: 255)
+        try await self.wait { session.keepsTabAfterExit }
+        await Task.yield()
+        #expect(directory.tabItems.contains { $0 === session })
+        session.start()
+        let second = try #require(engines.made.last)
+        #expect(second !== engine)
+        #expect(root.launchCount == 2, "each start asks the launcher again")
+
+        // Ending normally closes the tab, as for a local shell.
+        second.finish(code: 0)
+        try await self.wait { !directory.tabItems.contains { $0 === session } }
+
+        // A root that cannot start a terminal opens no tab, and no local shell.
+        root.error = CocoaError(.featureUnsupported)
+        await directory.requestTerminalTab()
+        #expect(directory.tabItems.isEmpty)
+        #expect(engines.made.count == 2)
+    }
