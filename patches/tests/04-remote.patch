+                       #selector(NSDocument.move(_:)), #selector(NSDocument.lock(_:)), #selector(NSDocument.browseVersions(_:)),
+                       #selector(NSDocument.revertToSaved(_:))]
+        {
+            #expect(!document.validateUserInterfaceItem(NSMenuItem(title: "", action: action, keyEquivalent: "")), "\(action)")
+        }
+        for action in [#selector(DataDocument.copyPath), #selector(RemoteDocument.saveLocalCopy(_:)), #selector(NSDocument.save(_:)),
+                       #selector(NSDocument.saveAs(_:)), #selector(RemoteDocument.revertToRemoteVersion(_:))]
+        {
+            #expect(document.validateUserInterfaceItem(NSMenuItem(title: "", action: action, keyEquivalent: "")), "\(action)")
+        }
+        await bed.tearDown()
+    }
+
+
+    // MARK: Closing
+
+    @Test(.timeLimit(.minutes(1))) func closingAsksAboutEveryUnsentChange() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "something")
+        let document = try await bed.open("/srv/a.txt")
+
+        #expect(await document.canClose(), "a clean document closes without asking")
+        #expect(bed.prompts.asked.isEmpty)
+
+        // Emptying the file is a change like any other, unlike an empty untitled document.
+        document.replaceText(with: "")
+        bed.prompts.closeChoices = [.cancel]
+        #expect(await !document.canClose())
+        #expect(bed.prompts.asked == ["close"])
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func keepRecoveryCopyNeedsTheLatestEditsOnDisk() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "base")
+        let document = try await bed.open("/srv/a.txt")
+        document.replaceText(with: "edited")
+
+        await document.record?.setFaultInjector { step in
+            if case .dataWritten(let name) = step, name.hasPrefix("text") { throw RemoteRecoveryError.fileSystem(ENOSPC) }
+        }
+        bed.prompts.closeChoices = [.keepRecoveryCopy]
+        #expect(await !document.canClose(), "a failed write of the latest edits blocks the close")
+        #expect(document.recoveryError != nil)
+
+        await document.record?.setFaultInjector(nil)
+        bed.prompts.closeChoices = [.keepRecoveryCopy]
+        #expect(await document.canClose())
+        let documentID = document.documentID
+        document.close()
+        try await bed.waitUntilReleased(documentID)
+
+        // The kept record comes back offline, with the edits and without connecting.
+        await bed.server.clearLog()
+        let restored = try RemoteOpenCoordinator.restore(documentID: documentID, environment: bed.environment)
+        defer { restored.close() }
+        #expect(restored.textStorage.string == "edited")
+        #expect(restored.isDocumentEdited)
+        #expect(await bed.server.log.isEmpty)
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func discardingRemovesTheRecordOnlyWhenTheDocumentCloses() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "base")
+        let document = try await bed.open("/srv/a.txt")
+        document.replaceText(with: "edited")
+        let directory = try #require(document.record?.directory)
+
+        bed.prompts.closeChoices = [.discard]
+        #expect(await document.canClose())
+        #expect(FileManager.default.fileExists(atPath: directory.path(percentEncoded: false)), "approval alone deletes nothing")
+
+        document.close()
+        try await waitUntil { !FileManager.default.fileExists(atPath: directory.path(percentEncoded: false)) }
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func savingFromTheCloseReviewUploads() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "base")
+        let document = try await bed.open("/srv/a.txt")
+        document.replaceText(with: "edited")
+
+        bed.prompts.closeChoices = [.save]
+        #expect(await document.canClose())
+        #expect(await bed.server.contents(of: "/srv/a.txt") == "edited")
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func revertingDownloadsTheServerVersionAfterAsking() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "base")
+        let document = try await bed.open("/srv/a.txt")
+        document.replaceText(with: "edited")
+        await bed.server.overwrite("/srv/a.txt", with: "theirs")
+
+        bed.prompts.confirmsRevert = false
+        await document.revertToRemote()
+        #expect(document.textStorage.string == "edited")
+
+        bed.prompts.confirmsRevert = true
+        await document.revertToRemote()
+        #expect(document.textStorage.string == "theirs")
+        #expect(!document.isDocumentEdited)
+        #expect(try await document.record?.baselineData() == Data("theirs".utf8))
+        #expect(try await document.record?.text() == nil)
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func openingTwiceGivesTheSameDocument() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "a")
+        let first = try await bed.open("/srv/a.txt")
+        await bed.server.addLink("/srv/alias.txt", target: "a.txt")
+
+        #expect(try await bed.open("/srv/a.txt") === first)
+        #expect(try await bed.open("/srv/alias.txt") === first, "a link to the same file opens the same document")
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aDownloadCanBeCanceled() async throws {
+
+        let bed = await RemoteTestBed(limits: RemoteLimits(chunkSize: 4, requestsInFlight: 1))
+        await bed.server.addFile("/srv/a.txt", "contents of several chunks")
+        let gate = FakeGate()
+        await bed.server.setHook { request in
+            if case .read("/srv/a.txt", 8) = request { await gate.wait() }
+            return .proceed
+        }
+        let control = RemoteOperationControl()
+        let open = Task { try await RemoteOperationControl.$current.withValue(control) { try await bed.open("/srv/a.txt") } }
+        try await waitUntil { await gate.hasArrived }
+
+        #expect(control.snapshot.totalBytes == 26)
+        #expect(control.snapshot.completedBytes == 8)
+        control.requestCancel()
+        await gate.open()
+        await #expect(throws: RemoteOperationCanceled.self) { try await open.value }
+
+        await bed.server.setHook(nil)
+        let document = try await bed.open("/srv/a.txt")
+        #expect(document.textStorage.string == "contents of several chunks", "a later open is not affected")
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func theProgressSheetShowsOnlyWhileASlowOperationRuns() async throws {
+
+        let window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 400, height: 300), styleMask: [.titled], backing: .buffered, defer: false)
+        window.makeKeyAndOrderFront(nil)
+        defer { window.close() }
+
+        // A quick operation shows nothing.
+        await RemoteProgressSheet.run(title: "Quick", window: window) { }
+        #expect(window.attachedSheet == nil)
+
+        let gate = FakeGate()
+        let operation = Task { await RemoteProgressSheet.run(title: "Slow", window: window) { await gate.wait() } }
+        try await waitUntil { window.attachedSheet != nil }
+
+        // A question takes its place, and the sheet comes back after it.
+        let concealed = RemoteProgressSheet.conceal(on: window)
+        #expect(concealed)
+        try await waitUntil { window.attachedSheet == nil }
+        RemoteProgressSheet.reveal(on: window, wasConcealed: concealed)
+        try await waitUntil { window.attachedSheet != nil }
+
+        await gate.open()
+        await operation.value
+        try await waitUntil { window.attachedSheet == nil }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func readsAreTriedAgainOnANewConnectionAFewTimes() async throws {
+
+        // One lost connection while downloading: the open goes on with a new one.
+        do {
+            let bed = await RemoteTestBed()
+            await bed.server.addFile("/srv/a.txt", "contents")
+            let dropped = FakeFlag()
+            await bed.server.setHook { request in
+                guard case .read = request, await !dropped.isSet else { return .proceed }
+                await dropped.set()
+                return .dropBeforeHandling
+            }
+            let document = try await bed.open("/srv/a.txt")
+            #expect(document.textStorage.string == "contents")
+            await bed.tearDown()
+        }
+
+        // A connection that is lost every time: two more tries, then the error.
+        do {
+            let bed = await RemoteTestBed()
+            await bed.server.addFile("/srv/a.txt", "contents")
+            await bed.server.setHook { request in
+                if case .read = request { return .dropBeforeHandling }
+                return .proceed
+            }
+            await #expect(throws: RemoteConnectionError.connectionLost) { try await bed.open("/srv/a.txt") }
+            // Each try opens the file once; its reads are pipelined, so they are not counted.
+            #expect(await bed.server.log.count { if case .open("/srv/a.txt", _) = $0 { true } else { false } } == 3)
+            await bed.tearDown()
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aWriteIsNeverTriedAgainAfterALostConnection() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/a.txt", "old")
+        let document = try await bed.open("/srv/a.txt")
+        document.replaceText(with: "new")
+        await bed.server.setHook { request in
+            if case .write = request { return .dropBeforeHandling }
+            return .proceed
+        }
+
+        #expect(await document.saveCoordinator.perform(.save) != .saved)
+        #expect(await bed.server.log.count { if case .write = $0 { true } else { false } } == 1)
+        #expect(await bed.server.contents(of: "/srv/a.txt") == "old")
+        await bed.tearDown()
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func namesThatDifferOnlyInNormalizationAreTwoFiles() async throws {
+
+        let composed = "/srv/caf\u{E9}.txt"
+        let decomposed = "/srv/cafe\u{301}.txt"
+        #expect(composed == decomposed, "Swift's String equality treats the two spellings as one")
+
+        // one after the other
+        let bed = await RemoteTestBed()
+        await bed.server.addFile(composed, "composed")
+        await bed.server.addFile(decomposed, "decomposed")
+        #expect(await bed.server.files(in: "/srv").count == 2)
+
+        let first = try await bed.open(composed)
+        let second = try await bed.open(decomposed)
+        #expect(first !== second)
+        #expect(first.textStorage.string == "composed")
+        #expect(second.textStorage.string == "decomposed")
+
+        first.replaceText(with: "edited composed")
+        #expect(await first.saveCoordinator.perform(.save) == .saved)
+        second.replaceText(with: "edited decomposed")
+        #expect(await second.saveCoordinator.perform(.save) == .saved)
+        #expect(await bed.server.contents(of: composed) == "edited composed", "each save writes only its own path")
+        #expect(await bed.server.contents(of: decomposed) == "edited decomposed")
+        await bed.tearDown()
+
+        // at the same time
+        let concurrent = await RemoteTestBed()
+        await concurrent.server.addFile(composed, "composed")
+        await concurrent.server.addFile(decomposed, "decomposed")
+        async let composedDocument = concurrent.open(composed)
+        async let decomposedDocument = concurrent.open(decomposed)
+        let (a, b) = try await (composedDocument, decomposedDocument)
+        #expect(a !== b, "two opens under way at once are not joined")
+        #expect(a.textStorage.string == "composed")
+        #expect(b.textStorage.string == "decomposed")
+        await concurrent.tearDown()
+    }
+}
