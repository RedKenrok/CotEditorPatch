+
+    func outlineView(_ outlineView: NSOutlineView, pasteboardWriterForItem item: Any) -> (any NSPasteboardWriting)? {
+
+        guard
+            let node = item as? RemoteDirectoryNode,
+            self.session.status == .online,
+            self.filterText.isEmpty,
+            !self.session.isChanging(node)
+        else { return nil }
+
+        // A file can also go to the Finder, which asks for it to be downloaded once it is dropped there.
+        if node.kind == .file || (node.kind != .directory && node.resolution.isFile) {
+            let type = UTType(filenameExtension: (node.name as NSString).pathExtension) ?? .data
+            return RemoteFilePromiseProvider(node: node, fileType: type.identifier, delegate: self)
+        }
+
+        let pasteboardItem = NSPasteboardItem()
+        pasteboardItem.setString(node.path, forType: Self.itemPasteboardType)
+        return pasteboardItem
+    }
