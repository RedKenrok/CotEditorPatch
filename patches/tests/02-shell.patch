+    @Test(.timeLimit(.minutes(1))) func terminalHostsNoFileAndKeepsFilesIntact() async throws {
+
+        try await self.withTerminals(makesWindow: true) { directory, urls, engines, _ in
+            #expect(await directory.openDocument(at: urls[0]))
+            let file = try #require(directory.activeFileDocument)
+            let window = try #require(directory.windowControllers.first?.window)
+            let content = try #require(directory.windowContentViewController)
+            let editor = try #require(content.documentViewController)
+
+            let terminal = try #require(directory.openTerminalTab())
+            #expect(content.documentViewController == nil, "no editor is reachable while a terminal shows")
+            #expect((directory.windowController?.fileDocument) == nil)
+            #expect(window.subtitle == terminal.title)
+            let engine = try #require(engines.made.first)
+            #expect(engine.view.window === window)
+
+            let fileActions: [Selector] = [
+                #selector(NSDocument.save(_:)),
+                #selector(NSDocument.revertToSaved(_:)),
+                #selector(NSDocument.printDocument(_:)),
+                #selector(DirectoryDocument.changeEncoding(_:)),
+                #selector(DirectoryDocument.changeLineEnding(_:)),
+                #selector(DirectoryDocument.toggleEditable(_:)),
+                #selector(DirectoryDocument.showInFinder(_:)),
+            ]
+            #expect(fileActions.allSatisfy { !directory.validateUserInterfaceItem(NSMenuItem(title: "", action: $0, keyEquivalent: "")) })
+            #expect(directory.validateUserInterfaceItem(NSMenuItem(title: "", action: #selector(DirectoryDocument.renameTerminalTab(_:)), keyEquivalent: "")))
+
+            // The hidden file comes back with its own editor, and the terminal view is only detached.
+            directory.selectDocument(file)
+            #expect(content.documentViewController === editor)
+            #expect(engine.view.window == nil)
+            #expect(engine.shutDownCount == 0)
+            #expect(terminal.isLive)
+
+            directory.selectTerminal(terminal)
+            #expect(engine.view.window === window)
+            #expect(engines.made.count == 1, "switching tabs never recreates the terminal")
