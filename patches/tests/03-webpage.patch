+    @Test(.timeLimit(.minutes(1))) func dialogsOfHiddenTabsOrDuringAReviewAreAnsweredSafely() async throws {
+
+        try await self.withWebPages { directory, urls, server, prompts in
+            server.route("/a", .page("<title>Page A</title>"))
+            #expect(await directory.openDocument(at: urls[0]))
+            let file = try #require(directory.activeFileDocument)
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+            controller.load(server.url("/a"))
+            try await self.wait { session.title == "Page A" && !session.isLoading }
+
+            // a tab in the background
+            directory.selectDocument(file)
+            #expect(try await self.evaluate("String(confirm('background'))", in: controller.webView) == "false")
+            #expect(try await self.evaluate("String(prompt('background', 'x'))", in: controller.webView) == "null")
+            #expect(prompts.dialogs.isEmpty, "nothing is shown, and no tab is selected to show it")
+            #expect(directory.activeFileDocument === file)
+
+            // A pending dialog is dismissed and answered once before a review starts.
+            directory.selectTabItem(session)
+            let blocker = FakeTabKind()
+            directory.tabKinds = [.webPage, blocker.kind]
+            #expect(directory.openTabItem(FakeTabItem()))
+            directory.selectTabItem(session)
+            let answer = Task { try await self.evaluate("String(confirm('pending'))", in: controller.webView) }
+            try await self.wait { prompts.pendingHandle != nil }
+            #expect(controller.dialogPresenter.isPresenting)
+
+            let review = PendingApproval()
+            blocker.approveWindow = { await review.wait() }
+            let close = Task { await directory.canClose() }
+            try await self.wait { review.isWaiting }
+            #expect(try await answer.value == "false", "the dismissed confirmation is cancelled, although the prompt answered OK late")
+            #expect(!controller.dialogPresenter.isPresenting)
+
+            // during the review
+            #expect(try await self.evaluate("String(confirm('during review'))", in: controller.webView) == "false")
+            #expect(prompts.dialogs.map(\.message) == ["pending"])
+            review.answer(false)
+            #expect(await close.value == false)
+            #expect(session.lifecycle == .active, "dismissal neither closes nor navigates the page")
+            #expect(session.currentURL == server.url("/a"))
+        }
+    }
