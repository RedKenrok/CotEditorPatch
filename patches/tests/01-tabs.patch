+        self.accessory.view = NSView(frame: NSRect(x: 0, y: 0, width: 200, height: 30))
+        return self.accessory
+    }
+
+
+    func createFileInNewTab(in directory: DirectoryDocument) async {
+
+        self.createdFileCount += 1
+    }
+
+
+    func directoryDidChangeState(_ directory: DirectoryDocument) {
+
+        self.stateChangeCount += 1
+    }
+
+
+    func directoryDidClose(_ directory: DirectoryDocument) {
+
+        self.closeCount += 1
+    }
+}
