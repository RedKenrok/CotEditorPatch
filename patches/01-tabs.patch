+        self.hostedViewController = viewController
+        self.addChild(viewController)
+        self.viewIfLoaded?.embedSubview(viewController.view)
+    }
+    
+    
+    /// Returns each split's clip position measured from its inset-adjusted top-left corner.
+    ///
+    /// Raw origins are not stored because the topmost legal origin is negative by the content insets
+    /// (for example under the toolbar), and those insets may differ by the time the editor is shown again.
+    ///
+    /// - Parameter editor: The editor whose splits to measure.
+    /// - Returns: One offset per text view, or `nil` for a text view without a scroll view.
+    private static func viewportOffsets(of editor: DocumentViewController) -> [NSPoint?] {
+        
+        editor.textViews.map { textView in
+            textView.enclosingScrollView.map { scrollView in
+                let clip = scrollView.contentView
+                return NSPoint(x: clip.bounds.origin.x + clip.contentInsets.left,
+                               y: clip.bounds.origin.y + clip.contentInsets.top)
+            }
+        }
+    }
+    
+    
+    /// Scrolls each split to its stored offset under the current insets.
+    ///
+    /// - Parameters:
+    ///   - offsets: The offsets from `viewportOffsets(of:)`; `nil` leaves that split alone.
+    ///   - editor: The editor to scroll.
+    /// - Returns: The clip origins after scrolling, to detect later scrolling by others.
+    @discardableResult private static func applyViewportOffsets(_ offsets: [NSPoint?], to editor: DocumentViewController) -> [NSPoint?] {
+        
+        zip(editor.textViews, offsets).map { textView, offset in
+            guard let scrollView = textView.enclosingScrollView else { return nil }
+            
+            let clip = scrollView.contentView
+            guard let offset else { return clip.bounds.origin }
+            
+            // Text is laid out lazily, so the document may not yet be as tall as the offset needs, and
+            // the clamping below would pull the view up. Laying out as far as the view will show avoids that.
+            if let layoutManager = textView.layoutManager, let container = textView.textContainer {
+                layoutManager.ensureLayout(forBoundingRect: NSRect(x: 0, y: 0, width: container.size.width,
+                                                                   height: offset.y + clip.bounds.height), in: container)
+            }
+            
+            var bounds = clip.bounds
+            bounds.origin = NSPoint(x: offset.x - clip.contentInsets.left,
+                                    y: offset.y - clip.contentInsets.top)
+            // constrainBoundsRect(_:) clamps within the inset-adjusted scrollable range,
+            // so a view left at the very top returns there although that origin is negative,
+            // and an offset past the end of since-shortened content lands on the last page.
+            clip.scroll(to: clip.constrainBoundsRect(bounds).origin)
+            scrollView.reflectScrolledClipView(clip)
+            
+            return clip.bounds.origin
+        }
     }
     
     
