+import AppKit
+import Foundation
+import Testing
+import FileEncoding
+@testable import CotEditor
+
+/// The save state machine against a fake server: both save modes, conflicts, interruptions and reconciliation.
+@MainActor struct RemoteSaveTests {
+
+    // MARK: Replacing Save
+
+    @Test(.timeLimit(.minutes(1))) func replacingSaveSwapsInAVerifiedCopy() async throws {
+
+        let bed = await RemoteTestBed()
+        await bed.server.addFile("/srv/www/index.html", "old\n", mode: 0o640)
+        let document = try await bed.open("/srv/www/index.html")
+        document.replaceText(with: "new\n")
+        await bed.server.clearLog()
+
+        #expect(await document.saveCoordinator.perform(.save) == .saved)
+
+        #expect(await bed.server.contents(of: "/srv/www/index.html") == "new\n")
+        #expect(await bed.server.file(at: "/srv/www/index.html")?.mode == 0o640, "the original mode is applied")
+        #expect(await bed.server.files(in: "/srv/www") == ["/srv/www/index.html"], "no temporary file is left")
+        #expect(!document.isDocumentEdited)
+        #expect(try await document.record?.baselineData() == Data("new\n".utf8))
+
+        // upload, then every write status, fsync on the open handle, and close before verifying and renaming
+        let log = await bed.server.log
+        let temporary = try #require(log.first { if case .open(let path, _) = $0 { path.contains(".cot-") } else { false } }?.path)
