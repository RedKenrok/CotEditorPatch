+/// A counter that a fake server's hook can advance.
+actor FakeCounter {
+
+    private(set) var value = 0
+
+
+    /// Advances the counter.
+    ///
+    /// - Returns: The new value.
+    func increment() -> Int {
+
+        self.value += 1
+        return self.value
+    }
