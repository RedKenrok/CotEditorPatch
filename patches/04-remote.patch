+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import SwiftUI
+
+
+/// Which server the open sheets connect to: a saved connection, a host of the SSH configuration, or a
+/// host typed in, with optional user and port.
+@MainActor @Observable final class RemoteConnectionFields {
+
+    enum Choice: Hashable {
+
+        /// The fields as the user types them.
+        case typed
+        /// A saved connection.
+        case profile(UUID)
+        /// A host alias of the SSH configuration, whose user and port the configuration chooses.
+        case alias(String)
+    }
+
+
+    var profiles: [RemoteConnectionProfile]
+    var aliases: [String]
+    var choice: Choice = .typed  { didSet { self.applyChoice() } }
+    var host = ""
+    var user = ""
+    var port = ""
+    var savesProfile = false
+    var profileName = ""
+
+    /// What the fields connect to, according to the SSH configuration, such as `deploy@example.com, port 22`.
+    private(set) var destinationDescription: String?
+
+
+    init(profiles: [RemoteConnectionProfile] = RemoteConnectionLibrary.shared.profiles, aliases: [String] = RemoteSSHConfigHosts.userAliases) {
+
+        self.profiles = profiles
+        // A saved connection with the same name as an alias stays the only entry for it.
+        self.aliases = aliases
+    }
+
+
+    /// The saved connection that is chosen, if one is.
+    var selectedProfileID: UUID? {
+
+        if case .profile(let id) = self.choice { id } else { nil }
+    }
+
+
+    /// Whether the host is chosen rather than typed.
+    var isHostChosen: Bool  { self.choice != .typed }
+
+    /// Whether the user and port come from a saved connection rather than being typed.
+    var isProfileChosen: Bool  { self.selectedProfileID != nil }
+
+
+    /// The endpoint the fields describe, if they are valid.
+    var endpoint: RemoteEndpoint? {
+
+        try? self.validatedEndpoint()
+    }
+
+
+    /// The endpoint the fields describe.
+    ///
+    /// - Throws: `RemoteInputError` naming the first invalid field.
+    func validatedEndpoint() throws(RemoteInputError) -> RemoteEndpoint {
+
+        let port = self.port.trimmingCharacters(in: .whitespaces)
+        guard port.isEmpty || Int(port) != nil else { throw .invalidPort }
+
+        return try RemoteEndpoint(host: self.host, user: self.user.nilIfEmpty, port: Int(port)).validated()
+    }
+
+
+    /// The saved connection to record with what is opened: the chosen one, or a new one if the user asked to save the fields.
+    func profileIDSavingIfAsked(for endpoint: RemoteEndpoint) -> UUID? {
+
+        if let id = self.selectedProfileID { return id }
+        guard self.savesProfile else { return nil }
+
+        let profile = RemoteConnectionProfile(name: self.profileName.nilIfEmpty ?? endpoint.host, endpoint: endpoint)
+        RemoteConnectionLibrary.shared.save(profile)
+        self.profiles = RemoteConnectionLibrary.shared.profiles
+        self.choice = .profile(profile.id)
+
+        return profile.id
+    }
+
+
+    /// Starts with a saved connection if it still exists, or else with the endpoint's fields.
+    func prefill(profileID: UUID?, endpoint: RemoteEndpoint?) {
+
+        if let profileID, self.profiles.contains(where: { $0.id == profileID }) {
+            self.choice = .profile(profileID)
+        } else if let endpoint {
+            if endpoint.user == nil, endpoint.port == nil, self.aliases.contains(endpoint.host) {
+                self.choice = .alias(endpoint.host)
+            } else {
+                self.host = endpoint.host
+                self.user = endpoint.user ?? ""
+                self.port = endpoint.port.map(String.init) ?? ""
+            }
+        }
+    }
+
+
+    /// Finds out what the fields connect to, with `ssh -G`, which reads the configuration without connecting.
+    func describeDestination(environment: RemoteEnvironment) async {
+
+        guard let endpoint = self.endpoint else {
+            self.destinationDescription = nil
+            return
+        }
+
+        do {
+            let destination = try await environment.pool.destination(for: endpoint)
+            guard endpoint == self.endpoint else { return }
+            let description = String(localized: "RemoteConnection.destination", defaultValue: "Connects as \(destination.user)@\(destination.hostName), port \(String(destination.port))",
+                                     table: "Remote", comment: "what the SSH configuration makes of the chosen host (%@ are the user, the host name and the port)")
+            self.destinationDescription = switch destination.route {
+                case let route? where route.hasPrefix("jump "):
+                    String(localized: "RemoteConnection.destination.jump", defaultValue: "\(description), through \(String(route.dropFirst("jump ".count)))",
+                           table: "Remote", comment: "first %@ is the destination as above, second the jump hosts of the SSH configuration")
+                case _?:
+                    String(localized: "RemoteConnection.destination.command", defaultValue: "\(description), through a proxy command", table: "Remote",
+                           comment: "%@ is the destination as above")
+                case nil:
+                    description
+            }
+        } catch is CancellationError {
+            return
+        } catch {
+            guard endpoint == self.endpoint else { return }
+            self.destinationDescription = error.localizedDescription
+        }
+    }
+
+
+    private func applyChoice() {
+
+        switch self.choice {
+            case .typed:
+                break
+            case .profile(let id):
+                guard let profile = self.profiles.first(where: { $0.id == id }) else { return }
+                self.host = profile.endpoint.host
+                self.user = profile.endpoint.user ?? ""
+                self.port = profile.endpoint.port.map(String.init) ?? ""
+                self.savesProfile = false
+            case .alias(let alias):
+                // The configuration chooses the user and port, unless the user types others.
+                self.host = alias
+                self.user = ""
+                self.port = ""
+        }
+    }
+}
+
+
+/// The connection part of the open sheets.
+struct RemoteConnectionSection: View {
+
+    @Bindable var fields: RemoteConnectionFields
+    var environment: RemoteEnvironment
+
+
+    var body: some View {
+
+        Picker(String(localized: "RemoteOpen.connection", defaultValue: "Connection:", table: "Remote"), selection: $fields.choice) {
+            Text(String(localized: "RemoteOpen.connection.none", defaultValue: "Enter a Host", table: "Remote"))
+                .tag(RemoteConnectionFields.Choice.typed)
+            if !self.fields.profiles.isEmpty {
+                Section(String(localized: "RemoteOpen.connection.saved", defaultValue: "Saved Connections", table: "Remote")) {
+                    ForEach(self.fields.profiles) { profile in
+                        Text(profile.name).tag(RemoteConnectionFields.Choice.profile(profile.id))
+                    }
+                }
+            }
+            if !self.fields.aliases.isEmpty {
+                Section(String(localized: "RemoteOpen.connection.sshConfiguration", defaultValue: "SSH Configuration", table: "Remote")) {
+                    ForEach(self.fields.aliases, id: \.self) { alias in
+                        Text(alias).tag(RemoteConnectionFields.Choice.alias(alias))
+                    }
+                }
+            }
+        }
+
+        TextField(String(localized: "RemoteOpen.host", defaultValue: "Host:", table: "Remote"), text: $fields.host,
+                  prompt: Text(String(localized: "RemoteOpen.host.prompt", defaultValue: "Host name or SSH alias", table: "Remote")))
+            .disabled(self.fields.isHostChosen)
+        TextField(String(localized: "RemoteOpen.user", defaultValue: "User:", table: "Remote"), text: $fields.user,
+                  prompt: Text(String(localized: "RemoteOpen.optional", defaultValue: "From SSH configuration", table: "Remote")))
+            .disabled(self.fields.isProfileChosen)
+        TextField(String(localized: "RemoteOpen.port", defaultValue: "Port:", table: "Remote"), text: $fields.port,
+                  prompt: Text(String(localized: "RemoteOpen.optional", defaultValue: "From SSH configuration", table: "Remote")))
+            .disabled(self.fields.isProfileChosen)
+
+        if let description = self.fields.destinationDescription {
+            Text(description)
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+
+        if !self.fields.isProfileChosen {
+            Toggle(String(localized: "RemoteOpen.saveConnection", defaultValue: "Save this connection", table: "Remote"), isOn: $fields.savesProfile)
+            if self.fields.savesProfile {
+                TextField(String(localized: "RemoteOpen.connectionName", defaultValue: "Name:", table: "Remote"), text: $fields.profileName,
+                          prompt: Text(self.fields.host))
+            }
+        }
+    }
+}
+
+
+extension View {
+
+    /// Describes what the connection fields connect to, each time they settle.
+    func describesDestination(of fields: RemoteConnectionFields, environment: RemoteEnvironment) -> some View {
+
+        self.task(id: fields.endpoint) {
+            try? await Task.sleep(for: .milliseconds(300))
+            guard !Task.isCancelled else { return }
+            await fields.describeDestination(environment: environment)
+        }
+    }
+}
