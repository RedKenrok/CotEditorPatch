+                    Text(String(localized: "RemoteFolder.status.changedLocation.detail",
+                                defaultValue: "This window shows \(self.session.identity.fullLocation). The same path now leads to \(candidate.fullLocation).",
+                                table: "Remote", comment: "first %@ is the window's location, second the new one"))
+                        .font(.caption)
+                        .foregroundStyle(.secondary)
+                        .fixedSize(horizontal: false, vertical: true)
