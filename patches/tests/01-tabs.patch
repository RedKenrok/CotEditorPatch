+    @Test(.timeLimit(.minutes(1))) func trashAndDetachRemoveTabs() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            for url in urls {
+                #expect(await directory.openDocument(at: url))
+            }
+            let root = try #require(directory.fileNode)
+            let trashed = try #require(self.member(at: urls[0], in: directory))
+            try directory.trashItem(try #require(root.node(at: urls[0])))
+            #expect(!directory.tabDocuments.contains { $0 === trashed })
+            #expect(trashed.directoryDocument == nil)
+
+            let detached = try #require(self.member(at: urls[1], in: directory))
+            directory.openInWindow(at: try #require(root.node(at: urls[1])))
+            defer { detached.close() }
+            #expect(!directory.tabDocuments.contains { $0 === detached })
+            #expect(detached.directoryDocument == nil)
+            #expect(detached.windowController != nil)
+            #expect(detached.windowController !== directory.windowControllers.first)
+
+            // Closing the detached document's own window no longer affects the directory.
+            detached.close()
+            #expect(directory.tabDocuments.count == 1)
+            #expect(directory.activeFileDocument === self.member(at: urls[2], in: directory))
+        }
+    }
