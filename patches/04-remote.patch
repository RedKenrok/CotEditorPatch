+
+    // MARK: Text Field Delegate
+
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+
+        switch commandSelector {
+            case #selector(NSResponder.cancelOperation):
+                // Escape keeps the name.
+                let row = self.outlineView.row(for: control)
+                if let node = self.outlineView.item(atRow: row) as? RemoteDirectoryNode {
+                    (control as? NSTextField)?.stringValue = node.name
+                }
+                self.view.window?.makeFirstResponder(self.outlineView)
+                return true
+            case #selector(NSTextView.insertTabIgnoringFieldEditor):
+                textView.insertTab(nil)
+                return true
+            default:
+                return false
+        }
+    }
+
+
+    func controlTextDidEndEditing(_ notification: Notification) {
+
+        guard let field = notification.object as? NSTextField else { return }
+
+        field.isEditable = false
+        let row = self.outlineView.row(for: field)
+        guard row >= 0, let node = self.outlineView.item(atRow: row) as? RemoteDirectoryNode else { return }
+
+        let name = field.stringValue
+        // The row shows the name the server has until the rename is confirmed.
+        self.outlineView.reloadItem(node, reloadChildren: false)
+        guard !RemotePath.isSame(name, node.name) else { return }
+
+        Task {
+            do {
+                try await self.session.rename(node, to: name)
+            } catch {
+                self.present(error)
+            }
+        }
+    }
