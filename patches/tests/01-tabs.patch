+    @Test(.timeLimit(.minutes(1))) func tabMovesToANewWindowWithItsDocument() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            #expect(await directory.openDocument(at: urls[0]))
+            #expect(await directory.openDocument(at: urls[1]))
+            let document = try #require(directory.activeFileDocument as? Document)
+            let directoryWindow = try #require(directory.windowControllers.first?.window)
+            let textView = try #require((directoryWindow.contentViewController as? WindowContentViewController)?.documentViewController?.focusedTextView)
+            textView.insertText("edited ", replacementRange: NSRange(location: 0, length: 0))
+            textView.selectedRanges = [NSValue(range: NSRange(location: 2, length: 3))]
+            let id = try #require(directory.tabState.selectedID)
+            let visibleFrame = try #require(directoryWindow.screen?.visibleFrame)
+            let topLeft = NSPoint(x: visibleFrame.minX + 120, y: visibleFrame.maxY - 40)
+
+            #expect(directory.canMoveTabToNewWindow(id: id))
+            #expect(directory.moveTabToNewWindow(id: id, topLeft: topLeft))
+            defer { document.close() }
+
+            #expect(directory.tabDocuments.map(\.fileURL) == [urls[0]])
+            #expect(directory.activeFileDocument?.fileURL == urls[0], "the neighbor takes over the selection")
+            #expect(document.directoryDocument == nil)
+
+            let window = try #require(document.windowControllers.first?.window)
+            #expect(window !== directoryWindow)
+            #expect(window.isVisible)
+            #expect(abs(window.frame.minX - topLeft.x) < 1, "the window opens where the tab was let go")
+            #expect(document.textStorage.string.hasPrefix("edited "), "the edited document itself moves")
+            #expect(document.undoManager?.canUndo == true, "and so does its undo history")
+            let movedTextView = try #require((window.contentViewController as? WindowContentViewController)?.documentViewController?.focusedTextView)
+            #expect(movedTextView.string.hasPrefix("edited "))
+            #expect(movedTextView.selectedRange() == NSRange(location: 2, length: 3), "the selection is carried over")
+
+            // The last tab can leave too; the folder window stays.
+            let last = try #require(directory.activeFileDocument)
+            #expect(directory.moveTabToNewWindow(id: try #require(directory.tabState.selectedID)))
+            defer { last.close() }
+            #expect(directory.tabDocuments.isEmpty)
+            #expect(directoryWindow.isVisible)
+        }
+    }
