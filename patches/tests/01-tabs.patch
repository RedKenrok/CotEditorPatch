+    @Test func tabStateMovesEntriesWithoutChangingSelection() {
+
+        let state = DirectoryTabState()
+        let ids = [Document(), Document(), Document()].map { state.insert($0).id }
+        state.select(ids[1])
+
+        state.move(ids[2], to: 0)
+        #expect(state.entries.map(\.id) == [ids[2], ids[0], ids[1]])
+        state.move(ids[2], to: 99)
+        #expect(state.entries.map(\.id) == [ids[0], ids[1], ids[2]], "the index is clamped")
+        state.move(UUID(), to: 0)
+        #expect(state.entries.map(\.id) == [ids[0], ids[1], ids[2]], "an unknown tab moves nothing")
+        #expect(state.selectedID == ids[1])
+    }
+
