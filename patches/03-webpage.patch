@@ -0,0 +1,304 @@
+//
+//  WebPagePrompts.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+
+
+/// A JavaScript alert, confirmation or prompt that a website asked for.
+struct WebPageDialog: Equatable {
+
+    enum Kind: Equatable {
+
+        case alert
+        case confirmation
+        case textInput(defaultText: String?)
+    }
+
+
+    enum Response: Equatable {
+
+        case acknowledged
+        case confirmed(Bool)
+        case text(String?)
+    }
+
+
+    var kind: Kind
+    var message: String
+
+    /// The origin of the frame that asked, such as `https://example.com`, or `nil` if WebKit did not say.
+    ///
+    /// It comes from the requesting frame's security origin only; neither the page title nor the message
+    /// can supply it, since both are under the website's control.
+    var origin: String?
+
+
+    /// What the page receives when the dialog is not shown or is dismissed: alerts are acknowledged,
+    /// confirmations cancelled, and text prompts return no value.
+    var safeResponse: Response {
+
+        switch self.kind {
+            case .alert: .acknowledged
+            case .confirmation: .confirmed(false)
+            case .textInput: .text(nil)
+        }
+    }
+
+
+    /// Describes a frame's security origin for the dialog.
+    static func origin(protocol scheme: String, host: String, port: Int) -> String? {
+
+        guard !scheme.isEmpty, !host.isEmpty else { return nil }
+
+        let defaultPort = switch scheme.lowercased() {
+            case "https": 443
+            case "http": 80
+            default: 0
+        }
+        // WebKit brackets an IPv6 host already; a bare one is bracketed here, as in a URL.
+        let displayedHost = (host.contains(":") && !host.hasPrefix("[")) ? "[\(host)]" : host
+
+        return (port == 0 || port == defaultPort)
+            ? "\(scheme)://\(displayedHost)"
+            : "\(scheme)://\(displayedHost):\(port)"
+    }
+}
+
+
+/// A website dialog on screen, which its tab can take away again.
+@MainActor final class WebPageDialogHandle {
+
+    /// Takes the dialog off the screen; set by whoever shows it.
+    var dismissHandler: (() -> Void)?
+
+
+    func dismiss() {
+
+        let handler = self.dismissHandler
+        self.dismissHandler = nil
+        handler?()
+    }
+}
+
+
+/// The confirmations and dialogs webpage tabs need.
+///
+/// Every decision goes through this protocol so that tests can answer without showing alerts.
+@MainActor protocol WebPagePrompting {
+
+    /// Asks whether to turn on file tabs, which webpages need.
+    func confirmEnablingTabs(window: NSWindow?) async -> Bool
+
+    /// Asks whether to send a form again, as reloading or going back to a page made by a form submission does.
+    func confirmResubmission(to url: URL?, window: NSWindow?) async -> Bool
+
+    /// Asks whether to remove every website's cookies and stored data.
+    func confirmClearingWebsiteData(window: NSWindow?) async -> Bool
+
+    /// Shows a website dialog as a sheet on the window until the user answers or the handle dismisses it.
+    ///
+    /// - Returns: The user's answer; after a dismissal, any value, since the caller answers the page itself.
+    func present(_ dialog: WebPageDialog, window: NSWindow, handle: WebPageDialogHandle) async -> WebPageDialog.Response
+}
+
+
+@MainActor enum WebPagePrompts {
+
+    /// The prompts in use; tests replace them.
+    static var current: any WebPagePrompting = WebPageAlertPrompts()
+}
+
+
+/// The standard prompts, as alerts.
+@MainActor struct WebPageAlertPrompts: WebPagePrompting {
+
+    func confirmEnablingTabs(window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "WebPagePrompt.enableTabs.message", defaultValue: "Webpages open as tabs", table: "WebPages")
+        alert.informativeText = String(localized: "WebPagePrompt.enableTabs.information",
+                                       defaultValue: "Webpage tabs appear next to file tabs, which are turned off. Turning on file tabs applies to all folder windows.",
+                                       table: "WebPages")
+        alert.addButton(withTitle: String(localized: "WebPagePrompt.enableTabs.button", defaultValue: "Enable Tabs and Open Webpage", table: "WebPages",
+                                          comment: "button label"))
+        alert.addButton(withTitle: Self.cancelLabel)
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func confirmResubmission(to url: URL?, window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = if let host = url?.host(percentEncoded: false) {
+            String(localized: "WebPagePrompt.resubmit.message", defaultValue: "Send the form to “\(host)” again?", table: "WebPages",
+                   comment: "%@ is the website’s host name")
+        } else {
+            String(localized: "WebPagePrompt.resubmitUnknown.message", defaultValue: "Send the form again?", table: "WebPages")
+        }
+        alert.informativeText = String(localized: "WebPagePrompt.resubmit.information",
+                                       defaultValue: "This page was made by submitting a form. Showing it again sends the form again, which may repeat an action such as a purchase.",
+                                       table: "WebPages")
+        alert.addButton(withTitle: String(localized: "WebPagePrompt.resubmit.button", defaultValue: "Send Again", table: "WebPages", comment: "button label"))
+        alert.addButton(withTitle: Self.cancelLabel)
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func confirmClearingWebsiteData(window: NSWindow?) async -> Bool {
+
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = String(localized: "WebPagePrompt.clearData.message", defaultValue: "Clear all website data?", table: "WebPages")
+        alert.informativeText = String(localized: "WebPagePrompt.clearData.information",
+                                       defaultValue: "Cookies and data stored by every website are removed, including websites open in other tabs. You may be signed out of them.",
+                                       table: "WebPages")
+        alert.addButton(withTitle: String(localized: "WebPagePrompt.clearData.button", defaultValue: "Clear Website Data", table: "WebPages", comment: "button label"))
+        alert.addButton(withTitle: Self.cancelLabel)
+
+        return await Self.run(alert, window: window) == .alertFirstButtonReturn
+    }
+
+
+    func present(_ dialog: WebPageDialog, window: NSWindow, handle: WebPageDialogHandle) async -> WebPageDialog.Response {
+
+        let alert = NSAlert()
+        // The origin is the title, so that the website's own text can never pose as the app.
+        alert.messageText = if let origin = dialog.origin {
+            String(localized: "WebPageDialog.origin", defaultValue: "The website “\(origin)” says:", table: "WebPages",
+                   comment: "title of a JavaScript dialog; %@ is the website’s origin, such as https://example.com")
+        } else {
+            String(localized: "WebPageDialog.unknownOrigin", defaultValue: "A website of unknown origin says:", table: "WebPages",
+                   comment: "title of a JavaScript dialog whose origin is not known")
+        }
+        alert.informativeText = dialog.message
+
+        let field: NSTextField?
+        switch dialog.kind {
+            case .alert:
+                field = nil
+                alert.addButton(withTitle: String(localized: "WebPageDialog.ok", defaultValue: "OK", table: "WebPages", comment: "button label"))
+            case .confirmation:
+                field = nil
+                alert.addButton(withTitle: String(localized: "WebPageDialog.ok", defaultValue: "OK", table: "WebPages", comment: "button label"))
+                alert.addButton(withTitle: Self.cancelLabel)
+            case .textInput(let defaultText):
+                let textField = NSTextField(string: defaultText ?? "")
+                textField.frame.size.width = 260
+                alert.accessoryView = textField
+                alert.window.initialFirstResponder = textField
+                field = textField
+                alert.addButton(withTitle: String(localized: "WebPageDialog.ok", defaultValue: "OK", table: "WebPages", comment: "button label"))
+                alert.addButton(withTitle: Self.cancelLabel)
+        }
+
+        handle.dismissHandler = { [weak window, weak alert] in
+            guard let window, let alert, alert.window.sheetParent === window else { return }
+            window.endSheet(alert.window, returnCode: .abort)
+        }
+        let response = await alert.beginSheetModal(for: window)
+        handle.dismissHandler = nil
+
+        let accepted = (response == .alertFirstButtonReturn)
+        return switch dialog.kind {
+            case .alert: .acknowledged
+            case .confirmation: .confirmed(accepted)
+            case .textInput: .text(accepted ? field?.stringValue : nil)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    private static var cancelLabel: String {
+
+        String(localized: "WebPagePrompt.cancel", defaultValue: "Cancel", table: "WebPages", comment: "button label")
+    }
+
+
+    /// Shows the alert as a sheet on the window, or as an application-modal alert without one.
+    private static func run(_ alert: NSAlert, window: NSWindow?) async -> NSApplication.ModalResponse {
+
+        if let window, window.isVisible, window.attachedSheet == nil {
+            await alert.beginSheetModal(for: window)
+        } else {
+            alert.runModal()
+        }
+    }
+}
+
+
+/// Shows at most one website dialog for a tab, and answers every request exactly once.
+///
+/// A dialog is shown only while `presentationWindow` names a window, which the tab allows only while it
+/// is selected in the active window and nothing else is asking the user anything. Other requests are
+/// answered at once with the safe response and never queued, and nothing is selected to show them.
+@MainActor final class WebPageDialogPresenter {
+
+    /// The window to show a dialog on now, or `nil` if a dialog must not be shown.
+    var presentationWindow: () -> NSWindow? = { nil }
+
+    private var active: (handle: WebPageDialogHandle, finish: (WebPageDialog.Response?) -> Void)?
+
+    var isPresenting: Bool  { self.active != nil }
+
+
+    /// Shows a website dialog, or answers it with its safe response.
+    func run(_ dialog: WebPageDialog) async -> WebPageDialog.Response {
+
+        guard self.active == nil, let window = self.presentationWindow() else { return dialog.safeResponse }
+
+        let handle = WebPageDialogHandle()
+
+        return await withCheckedContinuation { continuation in
+            var isFinished = false
+            let finish: (WebPageDialog.Response?) -> Void = { [weak self] response in
+                guard !isFinished else { return }
+                isFinished = true
+                if self?.active?.handle === handle {
+                    self?.active = nil
+                }
+                continuation.resume(returning: response ?? dialog.safeResponse)
+            }
+            self.active = (handle, finish)
+
+            Task {
+                let response = await WebPagePrompts.current.present(dialog, window: window, handle: handle)
+                finish(response)
+            }
+        }
+    }
+
+
+    /// Takes the dialog away, answering the page with the safe response. The web view is left alone.
+    func dismiss() {
+
+        guard let active = self.active else { return }
+
+        self.active = nil
+        active.handle.dismiss()
+        active.finish(nil)
+    }
+}
