+    @Test(.timeLimit(.minutes(1))) func pagesFollowNavigationAndSurviveTabSwitches() async throws {
+
+        try await self.withWebPages { directory, urls, server, _ in
+            server.route("/a", .page("<title>Page A</title><a id=link href='/b'>B</a>"))
+            server.route("/b", .page("<title>Page B</title>"))
+            server.route("/r", .redirect("/b"))
+            #expect(await directory.openDocument(at: urls[0]))
+            let file = try #require(directory.activeFileDocument)
+            let window = try #require(directory.windowControllers.first?.window)
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+
+            controller.submitAddress(server.url("/a").absoluteString)
+            try await self.wait { session.title == "Page A" && !session.isLoading }
+            #expect(session.currentURL == server.url("/a"))
+            #expect(session.tabToolTip == server.url("/a").absoluteString)
+            try await self.wait { window.subtitle == "Page A" }
+            #expect(controller.addressField.stringValue == server.url("/a").absoluteString)
+
+            _ = try await self.evaluate("document.getElementById('link').click()", in: controller.webView)
+            try await self.wait { session.title == "Page B" && !session.isLoading }
+            #expect(session.canGoBack)
+
+            // Switching tabs keeps the same web view and history, and reloads nothing.
+            let webView = controller.webView
+            directory.selectDocument(file)
+            #expect(webView.window == nil)
+            directory.selectTabItem(session)
+            #expect(session.controller === controller)
+            #expect(controller.webView === webView)
+            #expect(webView.window === window)
+            #expect(session.canGoBack)
+            #expect(server.count("/a") == 1)
+            #expect(server.count("/b") == 1)
+
+            // Redirects update the address.
+            controller.load(server.url("/r"))
+            try await self.wait { session.currentURL == server.url("/b") && !session.isLoading }
+            #expect(controller.addressField.stringValue == server.url("/b").absoluteString)
+
+            // The address the user is editing is left alone.
+            window.makeFirstResponder(controller.addressField)
+            controller.addressField.currentEditor()?.string = "typing"
+            controller.load(server.url("/a"))
+            try await self.wait { session.currentURL == server.url("/a") && !session.isLoading }
+            #expect(controller.addressField.currentEditor()?.string == "typing")
+        }
+    }
