+
+/// Directory windows whose folder is not on this Mac, through the root contract alone, with a fake root.
+extension DirectoryTabTests {
+
+    @Test(.timeLimit(.minutes(1))) func aWindowWithARootHasItsSidebarAndNameAndNoLocalFolder() async throws {
+
+        try await self.withRootDirectory { directory, root in
+            #expect(directory.fileURL == nil)
+            #expect(directory.displayName == "Fake Folder")
+
+            let window = try #require(directory.windowController?.window)
+            #expect(window.title == "Fake Folder")
+            #expect(window.subtitle == "somewhere:/fake", "the root's subtitle shows while no tab gives one")
+            #expect(!window.isRestorable)
+            #expect(root.sidebars.count == 1)
+            #expect(directory.windowContentViewController?.splitViewItems.first?.topAlignedAccessoryViewControllers.first === root.accessory)
+            #expect(root.sidebars.first?.view.window === window)
+            #expect(directory.fileBrowserViewController == nil)
+
+            let tabBar = try #require(directory.windowContentViewController?.makeTabBar(for: directory))
+            #expect(!tabBar.addMenuItems.map(\.title).contains("New File"), "there is no local folder for a new file")
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aRootThatCreatesFilesOffersNewFileAndCreatesThem() async throws {
+
+        try await self.withRootDirectory { directory, root in
+            root.canCreateFiles = true
+
+            let tabBar = try #require(directory.windowContentViewController?.makeTabBar(for: directory))
+            #expect(tabBar.addMenuItems.map(\.title).contains("New File"))
+
+            await directory.createFileInNewTab()
+            #expect(root.createdFileCount == 1, "the root creates the file, since there is no local folder")
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aRootArchivesTheTabsAndGetsThemBack() async throws {
+
+        try await self.withRootDirectory { directory, root in
+            let kind = FakeTabKind()
+            directory.tabKinds = [kind.kind]
+            let first = FakeTabItem()
+            first.title = "First"
+            let second = FakeTabItem()
+            second.title = "Second"
+            #expect(directory.openTabItem(first))
+            #expect(directory.openTabItem(second))
+            directory.selectTabItem(first)
+            #expect(root.stateChangeCount > 0)
+
+            let archive = try #require(directory.tabArchive as? [String: Any])
+
+            try await self.withRootDirectory { restored, _ in
+                let restoredKind = FakeTabKind()
+                restored.tabKinds = [restoredKind.kind]
+                restored.restoreTabs(fromArchive: archive)
+
+                #expect(restored.tabItems.map(\.id) == [first.id, second.id])
+                #expect(restored.activeTabItem?.id == first.id)
+            }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func closingTellsTheRootOnceAndArchivesNothingOnTheWay() async throws {
+
+        try await self.withRootDirectory(closes: false) { directory, root in
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+            let changes = root.stateChangeCount
+
+            directory.close()
+
+            #expect(root.closeCount == 1)
+            #expect(root.stateChangeCount == changes, "the tabs closing one by one are not archived as a change")
+            #expect(item.tearDownCount == 1)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aWindowWithARootFollowsTheFileTabsPreference() async throws {
+
+        try await self.withRootDirectory { directory, _ in
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            #expect(directory.tabItems.isEmpty, "tabs that are not files close without tabs, as in a local folder window")
+            #expect(item.tearDownCount == 1)
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+            #expect(directory.openTabItem(FakeTabItem()))
+        }
+    }
+
+
+    // MARK: Helpers
+
+    /// Runs the body with a shown directory window whose folder is a fake root, with file tabs on.
+    func withRootDirectory(closes: Bool = true, _ body: (DirectoryDocument, FakeDirectoryRoot) async throws -> Void) async throws {
+
+        let key = DefaultKeys.usesDirectoryFileTabs.rawValue
+        let original = UserDefaults.standard.object(forKey: key)
+        UserDefaults.standard[.usesDirectoryFileTabs] = true
+
+        let root = FakeDirectoryRoot()
+        let directory = DirectoryDocument(root: root)
+        defer {
+            if closes {
+                directory.close()
+            }
+            UserDefaults.standard.set(original, forKey: key)
+        }
+        directory.makeWindowControllers()
+        directory.showWindows()
+
+        try await body(directory, root)
+    }
+}
+
+
+/// A root that records what the directory tells it.
+@MainActor final class FakeDirectoryRoot: DirectoryRoot {
+
+    private(set) var sidebars: [NSViewController] = []
+    let accessory = NSSplitViewItemAccessoryViewController()
+    private(set) var stateChangeCount = 0
+    private(set) var closeCount = 0
