+    // MARK: Helpers
+
+    private func shell(_ script: String, in directory: URL, environment: [String] = []) -> TerminalLaunchConfiguration {
+
+        TerminalLaunchConfiguration(executable: "/bin/sh", argv0: "sh", arguments: ["-c", script],
+                                    environment: Self.environment + environment,
+                                    currentDirectory: directory.path(percentEncoded: false))
+    }
+
+
+    /// A window showing the engine's view at a usable size, so that layout reaches the terminal.
+    private static func makeWindow(showing engine: SwiftTermEngine) -> NSWindow {
+        
+        let window = NSWindow(contentRect: NSRect(x: 0, y: 0, width: 800, height: 500), styleMask: [.titled, .resizable],
+                              backing: .buffered, defer: false)
+        window.isReleasedWhenClosed = false
+        engine.view.frame = window.contentView!.bounds
+        window.contentView?.addSubview(engine.view)
+        window.contentView?.layoutSubtreeIfNeeded()
+        return window
+    }
+    
+    
+    private func withDirectory(named name: String, _ body: (URL) async throws -> Void) async throws {
+
+        let url = FileManager.default.temporaryDirectory
+            .appending(path: UUID().uuidString, directoryHint: .isDirectory)
+            .appending(path: name, directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: url.deletingLastPathComponent()) }
+
+        try await body(url)
+    }
+
+
+    private func windowSize(of engine: SwiftTermEngine) -> winsize? {
+
+        var size = winsize()
+        guard ioctl(engine.pseudoTerminalDescriptor, TIOCGWINSZ, &size) == 0 else { return nil }
+        return size
+    }
+
+
+    /// Whether a process or process group with the ID still exists, reaped or not.
+    private static func exists(_ id: pid_t) -> Bool {
+
+        guard kill(id, 0) == 0 || errno == EPERM else { return false }
+
+        // A zombie still exists until reaped; count it as gone only once reaped.
+        return true
+    }
+
+
+    private static func device(of descriptor: Int32) -> dev_t? {
+
+        var info = stat()
+        guard descriptor >= 0, fstat(descriptor, &info) == 0 else { return nil }
+        return info.st_rdev
+    }
+
+
+    /// Counts this process's descriptors open on the given device, identifying a pseudo-terminal
+    /// without relying on descriptor numbers, which other tests may reuse.
+    private static func openDescriptors(for device: dev_t) -> Int {
+
+        let descriptors = (try? FileManager.default.contentsOfDirectory(atPath: "/dev/fd")) ?? []
+        return descriptors.compactMap(Int32.init).count { self.device(of: $0) == device }
+    }
+
+
+    private func wait(timeout: Duration = .seconds(5), until condition: () -> Bool) async throws {
+
+        let deadline = ContinuousClock.now + timeout
+        while !condition() {
+            guard ContinuousClock.now < deadline else {
+                Issue.record("Timed out waiting for condition")
+                return
+            }
+            try await Task.sleep(for: .milliseconds(20))
+        }
+    }
+}
