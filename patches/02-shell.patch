+import SwiftUI
+import Defaults
+
+
+/// The Terminal pane of the settings window.
+struct TerminalSettingsView: View {
+
+    @Namespace private var accessibility
+
+    @Environment(\.colorScheme) private var colorScheme
+
+    @AppStorage(.terminalTheme) private var theme
+    @AppStorage(.terminalUsesThemeColors) private var usesThemeColors
+    @AppStorage(.pinsThemeAppearance) private var pinsThemeAppearance
+    @AppStorage(.terminalPostsNotifications) private var postsNotifications
+
+
+    var body: some View {
+
+        Grid(alignment: .leadingFirstTextBaseline, verticalSpacing: 10) {
+            GridRow {
+                Text(String(localized: "TerminalSettings.theme.label", defaultValue: "Theme:", table: "Terminal",
+                            comment: "label of the terminal theme picker in the settings"))
+                    .accessibilityLabeledPair(role: .label, id: "theme", in: self.accessibility)
+                    .gridColumnAlignment(.trailing)
+
+                VStack(alignment: .leading, spacing: 6) {
+                    Picker(selection: $theme) {
+                        Text(String(localized: "TerminalSettings.theme.sameAsEditor", defaultValue: "Same as Editor", table: "Terminal",
+                                    comment: "terminal theme choice that follows the editor’s theme")).tag("")
+                        Divider()
+                        ForEach(ThemeManager.shared.settingNames, id: \.self) { name in
+                            Text(name).tag(name)
+                        }
+                    } label: {
+                        EmptyView()
+                    }
+                    .frame(maxWidth: 240)
+                    .accessibilityLabeledPair(role: .content, id: "theme", in: self.accessibility)
+
+                    Text(String(localized: "TerminalSettings.theme.description",
+                                defaultValue: "Text, background, cursor and selection colors come from the theme, including its light or dark variant.",
+                                table: "Terminal"))
+                        .foregroundStyle(.secondary)
+                        .controlSize(.small)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+            }
+
+            GridRow {
+                Color.clear.frame(width: 1, height: 1)
+
+                VStack(alignment: .leading, spacing: 6) {
+                    Toggle(String(localized: "TerminalSettings.themeColors.label", defaultValue: "Match program colors to the theme", table: "Terminal",
+                                  comment: "toggle deriving the 16 ANSI colors from the theme"),
+                           isOn: $usesThemeColors)
+
+                    Text(String(localized: "TerminalSettings.themeColors.description",
+                                defaultValue: "Programs such as ls and git choose from 16 standard colors. Each then takes the theme color closest to it in hue, as long as it stays readable; otherwise the standard color is kept.",
+                                table: "Terminal"))
+                        .foregroundStyle(.secondary)
+                        .controlSize(.small)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+            }
+
+            GridRow {
+                Color.clear.frame(width: 1, height: 1)
+
+                TerminalColorsPreview(colors: self.previewColors)
+            }
+
+            Divider()
+
+            GridRow {
+                Text(String(localized: "TerminalSettings.notifications.label", defaultValue: "Notifications:", table: "Terminal",
+                            comment: "label of the terminal notification setting in the settings"))
+                    .accessibilityLabeledPair(role: .label, id: "notifications", in: self.accessibility)
+                    .gridColumnAlignment(.trailing)
+
+                VStack(alignment: .leading, spacing: 6) {
+                    Toggle(String(localized: "TerminalSettings.notifications.toggle", defaultValue: "Show notifications from programs", table: "Terminal",
+                                  comment: "toggle letting programs in a terminal show notifications"),
+                           isOn: $postsNotifications)
+                        .accessibilityLabeledPair(role: .content, id: "notifications", in: self.accessibility)
+
+                    Text(String(localized: "TerminalSettings.notifications.description",
+                                defaultValue: "Programs such as coding agents can ask for a notification when they finish, with the OSC 777 escape sequence. It appears only while you aren’t looking at that shell tab, and clicking it brings the tab forward.",
+                                table: "Terminal"))
+                        .foregroundStyle(.secondary)
+                        .controlSize(.small)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+            }
+        }
+        .scenePadding()
+        .frame(width: SettingsPane.width)
+    }
+
+
+    /// The colors a terminal would show now, for the preview.
+    private var previewColors: TerminalColors {
+
+        // Reading the settings here makes the preview follow them.
+        _ = (self.theme, self.usesThemeColors, self.pinsThemeAppearance, ThemeManager.shared.settingNames)
+
+        return TerminalColors.current(isDark: self.colorScheme == .dark)
+    }
+}
+
+
+/// A small sample of the terminal colors: text, a cursor, and the 16 program colors.
+private struct TerminalColorsPreview: View {
+
+    let colors: TerminalColors
+
+
+    var body: some View {
+
+        let palette = self.colors.palette ?? TerminalColors.standardPalette
+
+        VStack(alignment: .leading, spacing: 6) {
+            HStack(spacing: 0) {
+                Text(verbatim: "~/project % ls ")
+                Rectangle().fill(Color(nsColor: self.colors.caret)).frame(width: 7, height: 14)
+            }
+            .foregroundStyle(Color(nsColor: self.colors.foreground))
+
+            ForEach(0..<2) { row in
+                HStack(spacing: 4) {
+                    ForEach(0..<8) { column in
+                        RoundedRectangle(cornerRadius: 2)
+                            .fill(Color(nsColor: palette[row * 8 + column]))
+                            .frame(width: 18, height: 12)
+                    }
+                }
+            }
+        }
+        .font(.system(.body, design: .monospaced))
+        .padding(10)
+        .background(Color(nsColor: self.colors.background), in: RoundedRectangle(cornerRadius: 6))
+        .accessibilityHidden(true)
+    }
+}
