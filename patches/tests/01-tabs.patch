+    @Test func dragPositionsDecideTheDropIndexAndPullOut() {
+
+        let ids = [UUID(), UUID(), UUID()]
+        let frames = [ids[0]: CGRect(x: 0, y: 0, width: 100, height: 26),
+                      ids[1]: CGRect(x: 100, y: 0, width: 100, height: 26),
+                      ids[2]: CGRect(x: 200, y: 0, width: 100, height: 26)]
+
+        // Dragging the first tab: it passes a neighbor once its middle passes the neighbor's middle.
+        #expect(DirectoryTabBar.dropIndex(for: ids[0], midX: 140, order: ids, frames: frames) == 0)
+        #expect(DirectoryTabBar.dropIndex(for: ids[0], midX: 160, order: ids, frames: frames) == 1)
+        #expect(DirectoryTabBar.dropIndex(for: ids[0], midX: 260, order: ids, frames: frames) == 2)
+        #expect(DirectoryTabBar.dropIndex(for: ids[2], midX: -20, order: ids, frames: frames) == 0)
+
+        #expect(!DirectoryTabBar.isPulledOut(CGPoint(x: 50, y: 15)))
+        #expect(!DirectoryTabBar.isPulledOut(CGPoint(x: 50, y: DirectoryTabBar.height + DirectoryTabBar.pullOutDistance - 1)))
+        #expect(DirectoryTabBar.isPulledOut(CGPoint(x: 50, y: DirectoryTabBar.height + DirectoryTabBar.pullOutDistance + 1)))
+        #expect(DirectoryTabBar.isPulledOut(CGPoint(x: 50, y: -DirectoryTabBar.pullOutDistance - 1)))
+    }
