+import AppKit
+import Foundation
+import Observation
+import Testing
+import Defaults
+@testable import CotEditor
+
+/// The contract for tabs that are not files, proven with a fake kind that has no terminal, web or remote code.
+///
+/// These are part of the serialized `DirectoryTabTests` suite, since they change the same global preference.
+extension DirectoryTabTests {
+
+    // MARK: Order, Selection and Presentation
+
+    @Test(.timeLimit(.minutes(1))) func tabItemsShareOrderAndSelectionWithFiles() async throws {
+
+        try await self.withDirectory { directory, urls in
+            let kind = FakeTabKind()
+            directory.tabKinds = [kind.kind]
+            #expect(await directory.openDocument(at: urls[0]))
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+            #expect(await directory.openDocument(at: urls[1]))
+
+            let entries = directory.tabState.entries
+            #expect(entries.map(\.id)[1] == item.id, "the tab keeps the item's ID")
+            #expect(entries[1].item === item)
+            #expect(directory.tabDocuments.map(\.fileURL) == [urls[0], urls[1]], "items are not documents")
+            #expect(item.joinCount == 1)
+
+            directory.selectTab(id: item.id)
+            #expect(directory.activeTabItem === item)
+            #expect(directory.activeFileDocument == nil)
+            #expect(directory.currentDocument == nil)
+
+            directory.selectAdjacentTab(by: 1)
+            #expect(directory.activeFileDocument?.fileURL == urls[1])
+            directory.selectAdjacentTab(by: -1)
+            #expect(directory.activeTabItem === item)
+
+            let presentation = try #require(directory.tabPresentations.first { $0.id == item.id })
+            #expect(presentation.title == item.tabTitle)
+            #expect(presentation.tooltip == item.tabToolTip)
+            #expect(presentation.canClose)
+            #expect(!presentation.canMoveToNewWindow)
+            #expect(!directory.canMoveTabToNewWindow(id: item.id))
+            #expect(directory.moveTabToNewWindow(id: item.id) == false)
+
+            // Moving the item moves only its tab; the registry keeps the files' order.
+            directory.moveTab(id: item.id, to: 0)
+            #expect(directory.tabState.entries.first?.item === item)
+            #expect(directory.tabDocuments.map(\.fileURL) == [urls[0], urls[1]])
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func tabItemsNeedTabs() async throws {
+
+        try await self.withDirectory { directory, _ in
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            #expect(directory.openTabItem(FakeTabItem()) == false)
+            #expect(directory.tabItems.isEmpty)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func hostCachesTheControllerOfEachItem() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            #expect(await directory.openDocument(at: urls[0]))
+            let file = try #require(directory.activeFileDocument)
+            let window = try #require(directory.windowControllers.first?.window)
+            let content = try #require(directory.windowContentViewController)
+            let editor = try #require(content.documentViewController)
+
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+            let controller = try #require(item.controllers.first)
+            #expect(controller.view.window === window)
+            #expect(content.documentViewController == nil, "no editor is reachable while an item shows")
+            #expect(directory.windowController?.fileDocument == nil)
+            #expect(window.subtitle == item.tabTitle)
+
+            let fileActions: [Selector] = [
+                #selector(NSDocument.save(_:)),
+                #selector(NSDocument.revertToSaved(_:)),
+                #selector(NSDocument.printDocument(_:)),
+                #selector(DirectoryDocument.changeEncoding(_:)),
+                #selector(DirectoryDocument.showInFinder(_:)),
+            ]
+            #expect(fileActions.allSatisfy { !directory.validateUserInterfaceItem(NSMenuItem(title: "", action: $0, keyEquivalent: "")) })
+
+            directory.selectDocument(file)
+            #expect(content.documentViewController === editor, "the hidden file keeps its editor")
+            #expect(controller.view.window == nil)
+            directory.selectTabItem(item)
+            // Selecting the file highlighted its row in the file browser, which must not bring the file back.
+            try await Task.sleep(for: .milliseconds(100))
+            #expect(directory.activeTabItem === item)
+            #expect(directory.windowController?.fileDocument == nil)
+            #expect(item.controllers.count == 1, "switching back reuses the controller")
+            #expect(controller.view.window === window)
+            #expect(item.tearDownCount == 0)
+
+            // The title follows the item's observable state.
+            item.title = "Renamed"
+            try await self.wait { window.subtitle == "Renamed" }
+
+            // A closed item's controller is released; a new item under the same ID gets a new one.
+            await directory.closeTab(id: item.id)
+            #expect(item.tearDownCount == 1)
+            #expect(directory.activeFileDocument === file)
+            let successor = FakeTabItem(id: item.id)
+            #expect(directory.openTabItem(successor))
+            #expect(successor.controllers.count == 1)
+            #expect(successor.controllers.first !== controller)
+        }
+    }
+
+
+    // MARK: Closing
+
+    @Test(.timeLimit(.minutes(1))) func tabItemCloseWaitsForItsApproval() async throws {
+
+        try await self.withDirectory { directory, _ in
+            let item = FakeTabItem()
+            let approval = PendingApproval()
+            item.approve = { await approval.wait() }
+            #expect(directory.openTabItem(item))
+
+            let close = Task { await directory.closeTabItem(item) }
+            try await self.wait { approval.isWaiting }
+            #expect(await directory.closeTabItem(item) == false, "a second request while one is pending is refused")
+            #expect(await directory.canClose() == false, "a window close during a pending tab close is refused")
+            #expect(item.reviewNoticeCount == 1)
+            approval.answer(false)
+            #expect(await close.value == false)
+            #expect(directory.tabItems.count == 1)
+            #expect(item.tearDownCount == 0)
+
+            item.approve = { true }
+            #expect(await directory.closeTabItem(item))
+            #expect(directory.tabItems.isEmpty)
+            #expect(item.tearDownCount == 1)
+            #expect(approval.requestCount == 1)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func windowCloseTearsItemsDownOnlyAfterEveryApproval() async throws {
+
+        try await self.withDirectory { directory, _ in
+            let kind = FakeTabKind()
+            directory.tabKinds = [kind.kind]
+            let items = [FakeTabItem(), FakeTabItem()]
+            for item in items {
+                #expect(directory.openTabItem(item))
+            }
+
+            let approval = PendingApproval()
+            kind.approveWindow = { await approval.wait() }
+            let cancelled = Task { await directory.canClose() }
+            try await self.wait { approval.isWaiting }
+            #expect(items.allSatisfy { $0.reviewNoticeCount == 1 }, "items put their sheets away before the review")
+            approval.answer(false)
+            #expect(await cancelled.value == false)
+            #expect(kind.approvedItems.last?.count == 2, "the kind is asked once for all its tabs")
+            #expect(items.allSatisfy { $0.tearDownCount == 0 }, "a cancelled close keeps every item")
+            #expect(directory.tabItems.count == 2)
+
+            kind.approveWindow = { true }
+            #expect(await directory.canClose())
+            #expect(items.allSatisfy { $0.tearDownCount == 0 }, "approval alone stops nothing")
+            directory.close()
+            #expect(items.allSatisfy { $0.tearDownCount == 1 })
+            #expect(directory.tabItems.isEmpty)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func turningTabsOffClosesItems() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, _ in
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            #expect(directory.tabItems.isEmpty)
+            #expect(item.tearDownCount == 1)
+        }
+    }
+
+
+    // MARK: Edited State
+
+    @Test(.timeLimit(.minutes(1))) func typingOutsideAFileNeverEditsTheFolder() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, _ in
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+
+            // A field that is not a file editor registers its undo steps in the window's document.
+            let window = try #require(directory.windowController?.window)
+            #expect(window.undoManager === directory.undoManager)
+            directory.updateChangeCount(.changeDone)
+
+            #expect(!directory.isDocumentEdited)
+            #expect(!directory.hasUnautosavedChanges, "AppKit would autosave the folder, which cannot be written")
+        }
+    }
+
+
+    // MARK: Menus
+
+    @Test(.timeLimit(.minutes(1))) func kindsAddMenuItems() async throws {
+
+        try await self.withDirectory(makesWindow: true) { directory, _ in
+            let kind = FakeTabKind()
+            var added = 0
+            kind.kind.addMenuItems = { _ in [DirectoryTabBar.MenuItem(title: "New Fake") { added += 1 }] }
+            directory.tabKinds = [kind.kind]
+
+            let item = FakeTabItem()
+            #expect(directory.openTabItem(item))
+            let tabBar = try #require(directory.windowContentViewController?.makeTabBar(for: directory))
+            #expect(tabBar.addMenuItems.map(\.title).last == "New Fake")
+            tabBar.addMenuItems.last?.action()
+            #expect(added == 1)
+            #expect(tabBar.contextMenuItems(item.id).map(\.title) == ["Fake Command"])
+        }
+    }
+
+
+    // MARK: Restoration
+
+    @Test(.timeLimit(.minutes(1))) func tabItemsAreArchivedAndRestoredByTheirKind() async throws {
+
+        try await self.withDirectory { directory, urls in
+            directory.tabKinds = [FakeTabKind().kind]
+            #expect(await directory.openDocument(at: urls[0]))
+            let item = FakeTabItem()
+            item.title = "Kept"
+            #expect(directory.openTabItem(item))
+            #expect(directory.openTabItem(FakeTabItem(archives: false)))
+            #expect(await directory.openDocument(at: urls[1]))
+            directory.selectTabItem(item)
+            let data = self.encodeRestorableState(of: directory)
+            let rootURL = try #require(directory.fileURL)
+            // Another directory cannot own the files while this one still has them.
+            directory.close()
+
+            let restoringKind = FakeTabKind()
+            try await self.withRestoredDirectory(at: rootURL, from: data, kinds: [restoringKind.kind]) { restored in
+                try await self.wait { restored.tabDocuments.count == 2 }
+                let entries = restored.tabState.entries
+                #expect(entries.count == 3, "the item without an archive is not restored")
+                #expect(entries[1].id == item.id)
+                let restoredItem = try #require(entries[1].item as? FakeTabItem)
+                #expect(restoredItem.title == "Kept")
+                #expect(restoredItem.joinCount == 1)
+                #expect(restored.activeTabItem === restoredItem, "the archived selection comes back")
+                #expect(restoringKind.restoredEntries.count == 1)
+                #expect(restoringKind.restoredEntries.first?.kind == FakeTabItem.kind)
+            }
+
+            // A build without the kind skips its entries and keeps the files.
+            try await self.withRestoredDirectory(at: rootURL, from: data, kinds: []) { restored in
+                try await self.wait { restored.tabDocuments.count == 2 }
+                #expect(restored.tabItems.isEmpty)
+                #expect(restored.tabState.entries.count == 2)
+            }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func kindsRestoreMemberDocumentsInOrder() async throws {
+
+        try await self.withDirectory { directory, urls in
+            #expect(await directory.openDocument(at: urls[0]))
+            let elsewhere = LocationlessDocument()
+            #expect(directory.adoptMember(elsewhere))
+            #expect(await directory.openDocument(at: urls[1]))
+            let tabID = try #require(directory.tabState.entry(for: elsewhere)?.id)
+            directory.selectDocument(elsewhere)
+            let order = directory.tabState.entries.map(\.id)
+            let data = self.encodeRestorableState(of: directory)
+            let rootURL = try #require(directory.fileURL)
+            directory.close()
+
+            var restoredEntries: [DirectoryTabArchive.ForeignEntry] = []
+            let kind = DirectoryTabKind(archiveKind: "somewhere", restoreDocuments: { entries, _ in
+                restoredEntries += entries
+                return entries.map { (tabID: $0.id, document: LocationlessDocument()) }
+            })
+            try await self.withRestoredDirectory(at: rootURL, from: data, kinds: [kind]) { restored in
+                try await self.wait { restored.tabDocuments.count == 3 }
+                #expect(restored.tabState.entries.map(\.id) == order)
+                #expect(restoredEntries.map(\.id) == [tabID])
+                #expect(restoredEntries.first?.fields["place"] as? String == "far away")
+                let document = try #require(restored.tabDocuments.first { $0 is LocationlessDocument })
+                #expect(restored.activeFileDocument === document, "the archived selection comes back")
+                #expect(restored.tabItems.isEmpty)
+            }
+        }
+    }
+
+
+    // MARK: Helpers
+
+    /// Restores a directory whose tab kinds are set before its state is read.
+    func withRestoredDirectory(at rootURL: URL, from data: Data, kinds: [DirectoryTabKind],
+                               _ body: (DirectoryDocument) async throws -> Void) async throws {
+
+        let directory = DirectoryDocument()
+        defer { directory.close() }
+        directory.tabKinds = kinds
+        directory.fileURL = rootURL
+        try directory.read(from: rootURL, ofType: "public.folder")
+
+        let unarchiver = try NSKeyedUnarchiver(forReadingFrom: data)
+        unarchiver.requiresSecureCoding = true
+        directory.restoreState(with: unarchiver)
+        unarchiver.finishDecoding()
+
+        try await body(directory)
+    }
+}
+
+
+// MARK: - Fixtures
+
+/// A tab kind whose answers and restorations the test controls.
+@MainActor final class FakeTabKind {
+
+    var approveWindow: @MainActor () async -> Bool = { true }
+    private(set) var approvedItems: [[any DirectoryTabItem]] = []
+    private(set) var restoredEntries: [DirectoryTabArchive.ForeignEntry] = []
+
+    lazy var kind = DirectoryTabKind(
+        archiveKind: FakeTabItem.kind,
+        approveClosingWindow: { [unowned self] items, _ in
+            self.approvedItems.append(items)
+            return await self.approveWindow()
+        },
+        restore: { [unowned self] entries, _ in
+            self.restoredEntries += entries
+            return entries.map { entry in
+                let item = FakeTabItem(id: entry.id)
+                item.title = (entry.fields["title"] as? String) ?? item.title
+                return item
+            }
+        })
+}
+
+
+/// A tab that is not a file, and records what the directory asks of it.
+@MainActor @Observable final class FakeTabItem: DirectoryTabItem {
+
+    static let kind = "fake"
+
+    let id: UUID
+    var title = "Fake"
+    @ObservationIgnored var approve: @MainActor () async -> Bool = { true }
+    @ObservationIgnored private let archives: Bool
+    @ObservationIgnored private(set) var controllers: [FakeTabViewController] = []
+    @ObservationIgnored private(set) var joinCount = 0
+    @ObservationIgnored private(set) var tearDownCount = 0
+    @ObservationIgnored private(set) var reviewNoticeCount = 0
+
+
+    init(id: UUID = UUID(), archives: Bool = true) {
+
+        self.id = id
+        self.archives = archives
+    }
+
+
