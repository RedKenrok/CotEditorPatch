+extension DirectoryDocument {
+
+    /// Asks for a remote file and opens it as a tab of this window, or in a window of its own if tabs are off.
+    @IBAction func openRemoteFile(_ sender: Any?) {
+
+        RemoteOpenPanel.show(for: self)
+    }
+
+
+    /// The entry of the tab strip's “+” menu that opens a remote file.
+    var openRemoteFileMenuItem: DirectoryTabBar.MenuItem {
+
+        .init(title: String(localized: "RemoteMenu.remoteFileInTab", defaultValue: "Remote File…", table: "Remote", comment: "menu item in the tab strip’s add menu that opens a file on an SSH server"), systemImage: "network") { [weak self] in
+            RemoteOpenPanel.show(for: self)
+        }
+    }
+
+
+    /// The remote folder the window shows, if it shows one.
+    var remoteFolderSession: RemoteFolderSession? {
+
+        self.root as? RemoteFolderSession
+    }
+}
+
+
+// MARK: Recent Folders
+
+/// The Open Recent Remote Folder menu, built each time it opens.
+@MainActor final class RemoteRecentFolderMenu: NSObject, NSMenuDelegate {
+
+    private static let shared = RemoteRecentFolderMenu()
+
+
+    static func makeMenu(title: String) -> NSMenu {
+
+        let menu = NSMenu(title: title)
+        menu.delegate = self.shared
+
+        return menu
+    }
+
+
+    func menuNeedsUpdate(_ menu: NSMenu) {
+
+        let folders = RemoteConnectionLibrary.shared.recentFolders
+
+        menu.items = folders.map { folder in
+            let item = NSMenuItem(title: "\(folder.connectionName):\(folder.path)", action: #selector(openRecentFolder), keyEquivalent: "")
+            item.target = self
+            item.representedObject = folder
+            item.image = NSImage(systemSymbolName: "folder", accessibilityDescription: nil)
+            return item
+        }
+        if !folders.isEmpty {
+            menu.addItem(.separator())
+        }
+        let clear = NSMenuItem(title: String(localized: "RemoteMenu.clearRecentFolders", defaultValue: "Clear Menu", table: "Remote", comment: "menu item label"),
+                               action: folders.isEmpty ? nil : #selector(clearRecentFolders), keyEquivalent: "")
+        clear.target = self
+        menu.addItem(clear)
+    }
+
+
+    /// Reopens a recent folder through the same checks as opening it anew.
+    ///
+    /// A folder opened with a saved connection that no longer exists asks for a connection; another one is never substituted.
+    @objc private func openRecentFolder(_ sender: NSMenuItem) {
+
+        guard let folder = sender.representedObject as? RemoteRecentFolder else { return }
+
+        if let profileID = folder.profileID, RemoteConnectionLibrary.shared.profile(id: profileID) == nil {
+            return RemoteFolderOpenPanel.show(path: folder.path, requiresConnection: true)
+        }
+
+        let request = RemoteFolderRequest(profileID: folder.profileID, endpoint: folder.endpoint, path: folder.path)
+        Task {
+            do {
+                try await RemoteFolderOpenCoordinator.open(request)
+            } catch is CancellationError {
+                return
+            } catch {
+                // The window lets the user correct what failed.
+                RemoteFolderOpenPanel.show(profileID: folder.profileID, endpoint: folder.endpoint, path: folder.path)
+                NSApp.presentError(error)
+            }
+        }
+    }
+
+
+    @objc private func clearRecentFolders(_ sender: Any?) {
+
+        RemoteConnectionLibrary.shared.clearRecentFolders()
+    }
+}
