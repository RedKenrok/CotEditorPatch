+#!/bin/sh
+#
+#  RemoteAskpass.sh
+#
+#  CotEditor
+#  https://coteditor.com
+#
+#  © 2026 RedKenrok <rondekker.nl>
+#
+#  Licensed under the Apache License, Version 2.0 (the "License");
+#  you may not use this file except in compliance with the License.
+#  You may obtain a copy of the License at
+#
+#  https://www.apache.org/licenses/LICENSE-2.0
+#
+#  Unless required by applicable law or agreed to in writing, software
+#  distributed under the License is distributed on an "AS IS" BASIS,
+#  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+#  See the License for the specific language governing permissions and
+#  limitations under the License.
+#
+# The askpass program of the ssh connections CotEditor starts (SSH_ASKPASS). ssh runs it with its
+# question, such as a key's passphrase, as the only argument, and reads the answer from its output.
+#
+# The question goes to CotEditor over the Unix socket it named, with the token it gave, and CotEditor
+# asks the user. Its reply starts with 1 before the answer, or is 0 if the user canceled, which ends
+# this program with a failure, so that ssh gives up rather than trying an empty answer. The answer
+# only ever passes through the socket and this program's output: never an argument, the
+# environment or a file.
+
+[ -n "$COTEDITOR_ASKPASS_SOCKET" ] && [ -n "$COTEDITOR_ASKPASS_TOKEN" ] || exit 1
+
+reply=$(printf '%s\0%s\0%s\0' "$COTEDITOR_ASKPASS_TOKEN" "${SSH_ASKPASS_PROMPT:-}" "$1" | /usr/bin/nc -U "$COTEDITOR_ASKPASS_SOCKET") || exit 1
+
+case $reply in
+    1*) printf '%s\n' "${reply#1}" ;;
+    *) exit 1 ;;
+esac
