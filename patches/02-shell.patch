@@ -0,0 +1,203 @@
+//
+//  TerminalLaunchConfiguration.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// Everything needed to spawn one terminal process, validated before the spawn.
+struct TerminalLaunchConfiguration: Equatable {
+
+    /// The shell used when the account's login shell cannot be run.
+    static let fallbackShell = "/bin/zsh"
+
+    var executable: String
+
+    /// The process name. A leading hyphen asks every common shell to act as a login shell.
+    var argv0: String
+    var arguments: [String]
+    var environment: [String]
+    var currentDirectory: String
+
+
+    /// Validates the directory and resolves the shell for a new process.
+    ///
+    /// The directory is passed to the spawn itself, so it only applies to the child: the app's own
+    /// working directory never changes, and folder names never pass through a shell command line.
+    ///
+    /// - Parameters:
+    ///   - directory: The folder to start in.
+    ///   - shellPath: A specific shell, or `nil` for the account's login shell.
+    ///   - baseEnvironment: The environment to derive the child's environment from.
+    /// - Throws: `TerminalLaunchError` if the folder or every candidate shell is unusable.
+    init(directory: URL, shellPath: String? = nil, baseEnvironment: [String: String] = ProcessInfo.processInfo.environment) throws(TerminalLaunchError) {
+
+        guard Self.isUsableDirectory(directory) else { throw .directoryUnavailable(directory) }
+
+        let shell = try Self.resolveShell(preferred: shellPath)
+
+        self.executable = shell
+        self.argv0 = "-" + (shell as NSString).lastPathComponent
+        self.arguments = []
+        self.environment = Self.environment(base: baseEnvironment, shell: shell)
+        self.currentDirectory = directory.path(percentEncoded: false)
+    }
+
+
+    /// Direct initializer for tests that launch a controlled shell.
+    init(executable: String, argv0: String, arguments: [String], environment: [String], currentDirectory: String) {
+
+        self.executable = executable
+        self.argv0 = argv0
+        self.arguments = arguments
+        self.environment = environment
+        self.currentDirectory = currentDirectory
+    }
+
+
+    // MARK: Shell
+
+    /// Picks the shell to run.
+    ///
+    /// A saved or configured shell is untrusted input, so each candidate must be an existing executable
+    /// file at an absolute path. The order is: the requested shell, the account's login shell, then `/bin/zsh`.
+    ///
+    /// - Parameter preferred: The shell requested for this session, if any.
+    /// - Returns: The path of the shell to run.
+    /// - Throws: `TerminalLaunchError.shellUnavailable` naming the first candidate if none can run.
+    static func resolveShell(preferred: String?, accountShell: String? = Self.accountShell()) throws(TerminalLaunchError) -> String {
+
+        let candidates = [preferred, accountShell, Self.fallbackShell].compactMap(\.self)
+
+        guard let shell = candidates.first(where: Self.isUsableShell) else {
+            throw .shellUnavailable(candidates.first ?? Self.fallbackShell)
+        }
+
+        return shell
+    }
+
+
+    /// The login shell recorded in the user's account.
+    ///
+    /// `$SHELL` is not used: an app launched from the Finder inherits it from launchd, not from the account.
+    static func accountShell() -> String? {
+
+        var record = passwd()
+        var result: UnsafeMutablePointer<passwd>?
+        var buffer = [CChar](repeating: 0, count: max(Int(sysconf(Int32(_SC_GETPW_R_SIZE_MAX))), 4096))
+
+        guard
+            getpwuid_r(getuid(), &record, &buffer, buffer.count, &result) == 0,
+            result != nil,
+            let shell = record.pw_shell
+        else { return nil }
+
+        return String(cString: shell)
+    }
+
+
+    static func isUsableShell(_ path: String) -> Bool {
+
+        var isDirectory: ObjCBool = false
+
+        return path.hasPrefix("/")
+            && FileManager.default.fileExists(atPath: path, isDirectory: &isDirectory)
+            && !isDirectory.boolValue
+            && FileManager.default.isExecutableFile(atPath: path)
+    }
+
+
+    // MARK: Directory
+
+    /// Whether the folder exists and can be entered.
+    static func isUsableDirectory(_ url: URL) -> Bool {
+
+        guard url.isFileURL else { return false }
+
+        let path = url.path(percentEncoded: false)
+        var isDirectory: ObjCBool = false
+
+        return FileManager.default.fileExists(atPath: path, isDirectory: &isDirectory)
+            && isDirectory.boolValue
+            && access(path, X_OK) == 0
+    }
+
+
+    // MARK: Environment
+
+    /// Variables passed through from the app's own environment.
+    ///
+    /// An allowlist rather than a copy: an app's environment also carries launch-service, debugger
+    /// and dynamic-linker variables that must not leak into the user's shell.
+    private static let inheritedVariables: Set<String> = [
+        "HOME", "USER", "LOGNAME", "TMPDIR", "PATH", "SSH_AUTH_SOCK", "__CF_USER_TEXT_ENCODING",
+        "LANG", "LC_ALL", "LC_CTYPE", "LC_COLLATE", "LC_MESSAGES", "LC_MONETARY", "LC_NUMERIC", "LC_TIME",
+    ]
+
+
+    /// Builds the child environment.
+    ///
+    /// - Parameters:
+    ///   - base: The app's environment.
+    ///   - shell: The shell being launched.
+    ///   - fallbackLocale: The locale name to use when the base names no character encoding.
+    /// - Returns: `KEY=value` pairs, sorted for a stable result.
+    static func environment(base: [String: String], shell: String, fallbackLocale: @autoclosure () -> String = Self.defaultLocaleName()) -> [String] {
+
+        var environment = base.filter { Self.inheritedVariables.contains($0.key) }
+
+        environment["SHELL"] = shell
+        environment["TERM"] = "xterm-256color"
+        environment["COLORTERM"] = "truecolor"
+        // Programs use the name to decide which escape sequences to rely on, such as OSC 777 notifications.
+        // Those are this project's additions, which plain CotEditor does not have, so the name is the project's;
+        // the version is the CotEditor release the build is based on.
+        environment["TERM_PROGRAM"] = "CotEditorPatch"
+        environment["TERM_PROGRAM_VERSION"] = Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String
+
+        // Login shells extend PATH through path_helper, but they need a working default to start from.
+        if environment["PATH"]?.isEmpty != false {
+            environment["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
+        }
+
+        // Without a UTF-8 locale, many programs print non-ASCII text as escapes.
+        if environment["LANG"] == nil, environment["LC_ALL"] == nil, environment["LC_CTYPE"] == nil {
+            environment["LANG"] = fallbackLocale()
+        }
+
+        return environment.map { "\($0.key)=\($0.value)" }.sorted()
+    }
+
+
+    /// The user's language and region as a UTF-8 locale that the system provides, or `en_US.UTF-8`.
+    static func defaultLocaleName(locale: Locale = .current, isInstalled: (String) -> Bool = { FileManager.default.fileExists(atPath: "/usr/share/locale/" + $0) }) -> String {
+
+        if let language = locale.language.languageCode?.identifier,
+           let region = locale.region?.identifier
+        {
+            let name = "\(language)_\(region).UTF-8"
+            if isInstalled(name) { return name }
+        }
+
+        return "en_US.UTF-8"
+    }
+}
diff --git a/CotEditor/Sources/Terminal/TerminalNotifications.swift b/CotEditor/Sources/Terminal/TerminalNotifications.swift
