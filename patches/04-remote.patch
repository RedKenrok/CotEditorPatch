+                                    action: #selector(RemoteDocument.revertToRemoteVersion(_:)), keyEquivalent: "")
+            fileMenu.insertItem(localCopy, at: index + 1)
+            fileMenu.insertItem(revert, at: index + 2)
+        }
+    }
