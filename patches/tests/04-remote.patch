+    private func waitForListing(_ node: RemoteDirectoryNode) async throws {
+
+        try await waitUntil { !node.isLoading && (node.children != nil || node.problem != nil) }
+    }
+
+
+    private func waitForResolution(_ node: RemoteDirectoryNode) async throws {
+
+        try await waitUntil { node.resolution != .resolving && node.resolution != .unresolved }
+    }
