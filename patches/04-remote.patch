+/// A folder window's browsing, over its destination's browsing connection.
+struct RemotePoolTreeSource: RemoteDirectoryTreeSource {
+
+    var pool: RemoteConnectionPool
+    var endpoint: RemoteEndpoint
+    var destination: RemoteDestination
+
+
+    func list(_ path: String, control: RemoteOperationControl) async throws -> RemoteDirectoryListing {
+
+        try await self.list(path, control: control, onBatch: { _ in })
+    }
+
+
+    func list(_ path: String, control: RemoteOperationControl, onBatch: @escaping @Sendable ([RemoteDirectoryEntry]) -> Void) async throws -> RemoteDirectoryListing {
+
+        let limits = await self.pool.limits
+
+        return try await RemoteOperationControl.$current.withValue(control) {
+            try await self.pool.withBrowsingConnection(to: self.endpoint, destination: self.destination) { transport in
+                try await transport.listDirectory(at: path, limits: limits, onBatch: onBatch)
+            }
+        }
+    }
+
+
+    func resolve(_ path: String, control: RemoteOperationControl) async throws -> RemoteResolvedItem {
+
+        try await RemoteOperationControl.$current.withValue(control) {
+            try await self.pool.withBrowsingConnection(to: self.endpoint, destination: self.destination) { transport in
+                try await Self.resolve(path, with: transport)
+            }
+        }
+    }
+
+
+    /// Resolves a path on the server: where it leads, and what is there.
+    ///
+    /// A server may leave out the type; a folder is then recognized by listing it, and anything else stays `unknown`.
+    static func resolve(_ path: String, with transport: any RemoteDirectoryTransport) async throws -> RemoteResolvedItem {
+
+        let target = try await transport.realpath(path)
+        let attributes = try await transport.stat(target)
+
+        var kind = RemoteDirectoryNode.Kind(attributes)
+        if kind == .unknown || kind == .symbolicLink {
+            kind = try await transport.opensAsDirectory(target) ? .directory : .unknown
+        }
+
+        return RemoteResolvedItem(target: target, kind: kind)
+    }
+}
