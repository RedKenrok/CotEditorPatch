--- /dev/null
+++ b/CotEditor/Sources/Terminal/SwiftTermEngine.swift
@@ -0,0 +1,675 @@
+//
+//  SwiftTermEngine.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
