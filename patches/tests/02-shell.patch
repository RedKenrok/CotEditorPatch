+    @Test(.timeLimit(.minutes(1))) func hiddenTerminalKeepsItsSize() async throws {
+        
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        try engine.start(self.shell("sleep 10", in: FileManager.default.temporaryDirectory))
+        let window = Self.makeWindow(showing: engine)
+        defer { window.close() }
+        let container = engine.view
+        
+        container.setFrameSize(NSSize(width: 800, height: 500))
+        container.layoutSubtreeIfNeeded()
+        let visible = try #require(self.windowSize(of: engine))
+        #expect(visible.ws_col > 20 && visible.ws_row > 5)
+        
+        // Transient layouts and hidden tabs can make the container arbitrarily small.
+        for size in [NSSize.zero, NSSize(width: 0, height: 400), NSSize(width: 30, height: 400), NSSize(width: 600, height: 10)] {
+            container.setFrameSize(size)
+            container.layoutSubtreeIfNeeded()
+            let current = try #require(self.windowSize(of: engine))
+            #expect(current.ws_col == visible.ws_col && current.ws_row == visible.ws_row, "\(size) must not reach the program")
+        }
+        
+        // Switching tabs removes the view from the window.
+        container.removeFromSuperview()
+        container.setFrameSize(.zero)
+        let detached = try #require(self.windowSize(of: engine))
+        #expect(detached.ws_col == visible.ws_col && detached.ws_row == visible.ws_row)
+        
+        window.contentView?.addSubview(container)
+        container.setFrameSize(NSSize(width: 1000, height: 600))
+        container.layoutSubtreeIfNeeded()
+        let shown = try #require(self.windowSize(of: engine))
+        #expect(shown.ws_col > visible.ws_col, "a real size still reaches the program")
+    }
