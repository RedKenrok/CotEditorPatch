@@ -0,0 +1,282 @@
+//
+//  RemoteRecoveryPanel.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+import SwiftUI
+import OSLog
+import FileEncoding
+
+
+/// What happens at launch to recovery records that no restored window claimed.
+///
+/// Standalone windows that were open at quit come back, offline, if the system reopens windows.
+/// Records with unsent changes, an unresolved save, or kept on close are offered for recovery,
+/// whether or not windows are restored. Clean records that were closed are removed; clean records
+/// that were open but not restored get one more launch before they are removed.
+@MainActor enum RemoteLaunchRecovery {
+
+    private static var hasRun = false
+    private static var observers: [any NSObjectProtocol] = []
+
+
+    /// Runs once the app has restored its windows, which may be well after it finished launching.
+    static func schedule() {
+
+        self.observers.append(NotificationCenter.default.addObserver(forName: NSApplication.didFinishRestoringWindowsNotification, object: nil, queue: .main) { _ in
+            MainActor.assumeIsolated { self.run() }
+        })
+        self.observers.append(NotificationCenter.default.addObserver(forName: NSApplication.didFinishLaunchingNotification, object: nil, queue: .main) { _ in
+            // AppKit does not always report restoring windows, for example when there was nothing to restore.
+            DispatchQueue.main.asyncAfter(deadline: .now() + .seconds(3)) {
+                MainActor.assumeIsolated { self.run() }
+            }
+        })
+    }
+
+
+    static func run() {
+
+        guard !self.hasRun else { return }
+        self.hasRun = true
+
+        // Connections may ask the user from now on: about an unknown host key, and for passwords and passphrases.
+        RemoteAskpass.shared.setAnswerer { prompt, isConfirmation in
+            await RemoteAskpass.answerWithPrompts(prompt, isConfirmation: isConfirmation)
+        }
+        Task {
+            await RemoteConnectionPool.shared.setHostKeyReviewer { endpoint, limits in
+                try await RemoteHostKeyTrust.review(endpoint, limits: limits)
+            }
+        }
+
+        let root = RemoteEnvironment.current.recoveryRoot
+        let reopensWindows = UserDefaults.standard.object(forKey: "NSQuitAlwaysKeepsWindows") as? Bool ?? true
+        var offered: [RemoteRecoveryManifest] = []
+
+        // Folder windows come first: their tabs claim their documents' records, which are then not offered here.
+        RemoteFolderRestoration.run(environment: .current, reopensWindows: reopensWindows)
+
+        for manifest in RemoteRecoveryStore.unclaimedManifests(in: root) {
+            if manifest.isOpen, manifest.isStandalone, reopensWindows,
+               let document = try? RemoteOpenCoordinator.restore(documentID: manifest.documentID)
+            {
+                RemoteOpenCoordinator.present(document, in: nil)
+                continue
+            }
+
+            if manifest.keepsAfterClose || manifest.operation != nil || Self.hasUnsentText(manifest, in: root) {
+                offered.append(manifest)
+            } else if manifest.isOpen {
+                Self.withRecord(manifest.documentID, in: root) { try await $0.setPresentation(isOpen: false) }
+            } else {
+                Self.withRecord(manifest.documentID, in: root) { try await $0.remove() }
+            }
+        }
+
+        if !offered.isEmpty {
+            RemoteRecoveryPanel.show(offered)
+        }
+    }
+
+
+    /// Whether the record's text differs from its baseline when encoded with its settings.
+    private static func hasUnsentText(_ manifest: RemoteRecoveryManifest, in root: URL) -> Bool {
+
+        guard let text = manifest.text else { return false }
+        guard let record = try? RemoteRecoveryRecord.open(in: root, documentID: manifest.documentID) else { return true }
+        defer { Task { await record.relinquish() } }
+
+        guard
+            let string = try? RemoteRecoveryManifest.decodeText(record.data(of: text.file)),
+            let baseline = try? record.data(of: manifest.baseline.file)
+        else { return true }
+
+        return RemoteTextEncoding.encode(string, settings: text.settings) != baseline
+    }
+
+
+    private static func withRecord(_ documentID: UUID, in root: URL, _ body: @escaping @Sendable (RemoteRecoveryRecord) async throws -> Void) {
+
+        guard let record = try? RemoteRecoveryRecord.open(in: root, documentID: documentID) else { return }
+
+        Task {
+            do {
+                try await body(record)
+            } catch {
+                Logger.app.error("Failed to update a remote recovery record: \(error)")
+            }
+            await record.relinquish()
+        }
+    }
+}
+
+
+enum RemoteTextEncoding {
+
+    /// Encodes text as a document with the settings would: in the encoding, with the yen sign converted
+    /// for it and a byte order mark if the settings have one.
+    static func encode(_ string: String, settings: RemoteTextSettings) -> Data {
+
+        let encoding = String.Encoding(rawValue: settings.encoding)
+        var data = string.convertYenSign(for: encoding).data(using: encoding, allowLossyConversion: true) ?? Data()
+        if encoding == .utf8, settings.hasUTF8BOM {
+            data.insert(contentsOf: [0xEF, 0xBB, 0xBF], at: 0)
+        }
+
+        return data
+    }
+}
+
+
+/// The window that offers recovered remote documents.
+@MainActor enum RemoteRecoveryPanel {
+
+    private static var window: NSWindow?
+
+
+    static func show(_ manifests: [RemoteRecoveryManifest]) {
+
+        let model = RemoteRecoveryModel(manifests: manifests)
+        let controller = NSHostingController(rootView: RemoteRecoveryView(model: model))
+        controller.sizingOptions = .preferredContentSize
+
+        let window = self.window ?? NSWindow(contentViewController: controller)
+        window.contentViewController = controller
+        window.title = String(localized: "RemoteRecovery.windowTitle", defaultValue: "Recovered Remote Files", table: "Remote")
+        window.styleMask = [.titled, .closable]
+        window.isReleasedWhenClosed = false
+        model.close = { [weak window] in window?.close() }
+        self.window = window
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+    }
+}
+
+
+@MainActor @Observable private final class RemoteRecoveryModel {
+
+    var manifests: [RemoteRecoveryManifest]
+    var errorMessage: String?
+    @ObservationIgnored var close: () -> Void = { }
+
+
+    init(manifests: [RemoteRecoveryManifest]) {
+
+        self.manifests = manifests
+    }
+
+
+    func open(_ manifest: RemoteRecoveryManifest) {
+
+        do {
+            let document = try RemoteOpenCoordinator.restore(documentID: manifest.documentID)
+            RemoteOpenCoordinator.present(document, in: nil)
+            self.remove(manifest)
+        } catch {
+            self.errorMessage = error.localizedDescription
+        }
+    }
+
+
+    func discard(_ manifest: RemoteRecoveryManifest) {
+
+        let alert = NSAlert()
+        alert.messageText = String(localized: "RemoteRecovery.discard.message",
+                                   defaultValue: "Discard the unsent changes to “\(manifest.identity.fileName)”?", table: "Remote")
+        alert.informativeText = String(localized: "RemoteRecovery.discard.information", defaultValue: "This cannot be undone.", table: "Remote")
+        alert.addButton(withTitle: String(localized: "RemoteRecovery.discard.button", defaultValue: "Discard", table: "Remote", comment: "button label"))
+        alert.addButton(withTitle: String(localized: "RemotePrompt.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label"))
+        alert.buttons.first?.hasDestructiveAction = true
+        guard alert.runModal() == .alertFirstButtonReturn else { return }
+
+        do {
+            let record = try RemoteRecoveryRecord.open(in: RemoteEnvironment.current.recoveryRoot, documentID: manifest.documentID)
+            Task { try? await record.remove() }
+            self.remove(manifest)
+        } catch {
+            self.errorMessage = error.localizedDescription
+        }
+    }
+
+
+    private func remove(_ manifest: RemoteRecoveryManifest) {
+
+        self.manifests.removeAll { $0.documentID == manifest.documentID }
+        if self.manifests.isEmpty {
+            self.close()
+        }
+    }
+}
+
+
+private struct RemoteRecoveryView: View {
+
+    @Bindable var model: RemoteRecoveryModel
+
+
+    var body: some View {
+
+        VStack(alignment: .leading, spacing: 12) {
+            Text(.init("RemoteRecovery.message", defaultValue: "These remote files have changes that were not sent to the server.", table: "Remote"))
+                .font(.headline)
+                .fixedSize(horizontal: false, vertical: true)
+
+            ForEach(self.model.manifests, id: \.documentID) { manifest in
+                HStack(alignment: .firstTextBaseline) {
+                    VStack(alignment: .leading) {
+                        Text(manifest.identity.fileName)
+                        Text(manifest.identity.displayLocation)
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                            .truncationMode(.middle)
+                            .lineLimit(1)
+                        Text(manifest.modificationDate, format: .dateTime)
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                    }
+                    Spacer()
+                    Button(.init("RemoteRecovery.discard", defaultValue: "Discard…", table: "Remote")) {
+                        self.model.discard(manifest)
+                    }
+                    Button(.init("RemoteRecovery.open", defaultValue: "Open", table: "Remote")) {
+                        self.model.open(manifest)
+                    }
+                }
+            }
+
+            if let errorMessage = self.model.errorMessage {
+                Text(errorMessage).foregroundStyle(.red)
+            }
+
+            HStack {
+                Spacer()
+                Button(.init("RemoteRecovery.later", defaultValue: "Decide Later", table: "Remote")) {
+                    self.model.close()
+                }
+                .keyboardShortcut(.cancelAction)
+            }
+        }
+        .padding(20)
+        .frame(width: 480)
+    }
+}
