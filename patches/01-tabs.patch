+///
+/// Everything else works as in a local directory window: member documents, the tabs of every kind,
+/// their order and selection, the file tabs preference, and the review before closing.
+@MainActor protocol DirectoryRoot: AnyObject {
+
+    /// The window title.
+    var displayName: String { get }
+
+    /// The window subtitle while no tab gives one, such as the folder's full location.
+    var subtitle: String { get }
+
+    /// Makes the sidebar. The window asks once, when it loads.
+    func makeSidebarViewController(for directory: DirectoryDocument) -> NSViewController
+
+    /// Makes what the sidebar shows at its top, if anything, which the window places right below its
+    /// title bar and lets the sidebar's content scroll under, as the local sidebar's pane switcher.
+    func makeSidebarAccessoryViewController(for directory: DirectoryDocument) -> NSSplitViewItemAccessoryViewController?
+
+    /// Whether New File in the tab strip's “+” menu can create a file in the root, as it can in a local folder.
+    var canCreateFiles: Bool { get }
+
+    /// Creates an empty file and opens it in a new tab, as New File does for a local folder.
+    func createFileInNewTab(in directory: DirectoryDocument) async
+
+    /// Called when the directory's tabs, their order or their selection changed, so that the root can
+    /// archive them. It is not called any more once the directory has started closing.
+    func directoryDidChangeState(_ directory: DirectoryDocument)
+
+    /// Called once the directory has closed, after every approval.
+    func directoryDidClose(_ directory: DirectoryDocument)
+}
+
+
+extension DirectoryRoot {
+
+    func makeSidebarAccessoryViewController(for directory: DirectoryDocument) -> NSSplitViewItemAccessoryViewController? { nil }
+
+    var canCreateFiles: Bool  { false }
+
+    func createFileInNewTab(in directory: DirectoryDocument) async { }
+}
