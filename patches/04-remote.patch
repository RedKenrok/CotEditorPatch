+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Defaults
+
+
+/// The remote part of a directory's tab archive.
+///
+/// A remote file's tab is an entry of kind `remoteFile` in the versioned `DirectoryTabArchive` list,
+/// so it keeps its place among the other tabs, and builds without remote editing skip it. It names
+/// the recovery record and where the file is, and holds no credentials. It never names a local cache
+/// file, so it can never reopen as a local file.
+enum RemoteTabArchive {
+
+    struct Entry: Equatable {
+
+        var tabID: UUID
+        var documentID: UUID
+        var identity: RemoteFileIdentity
+    }
+
+
+    static let kind = "remoteFile"
+
+
+    /// The archive fields of a document's tab.
+    @MainActor static func fields(for document: RemoteDocument) -> [String: Any] {
+
+        let identity = document.identity
+        var fields: [String: Any] = [
+            "document": document.documentID.uuidString,
+            "host": identity.endpoint.host,
+            "requestedPath": identity.requestedPath,
+            "path": identity.path,
+            "destinationHost": identity.destination.hostName,
+            "destinationUser": identity.destination.user,
+            "destinationPort": identity.destination.port,
+        ]
+        fields["user"] = identity.endpoint.user
+        fields["port"] = identity.endpoint.port
+        fields["profile"] = identity.profileID?.uuidString
+
+        return fields
+    }
+
+
+    /// Reads the remote entries of an archive.
+    ///
+    /// Archived values are untrusted: an entry is kept only if every part of its identity validates.
+    static func entries(in archive: DirectoryTabArchive) -> [Entry] {
+
+        self.entries(in: archive.foreignEntries(ofKind: Self.kind))
+    }
+
+
+    /// Reads the remote entries among archived entries, as `entries(in:)` does for a whole archive.
+    static func entries(in entries: [DirectoryTabArchive.ForeignEntry]) -> [Entry] {
+
+        entries.filter { $0.kind == Self.kind }.compactMap { entry in
+            let fields = entry.fields
+            guard
+                let documentID = (fields["document"] as? String).flatMap(UUID.init(uuidString:)),
+                let host = fields["host"] as? String,
+                let requestedPath = (fields["requestedPath"] as? String).flatMap({ try? RemotePath.validated($0) }),
+                let path = (fields["path"] as? String).flatMap({ try? RemotePath.validated($0) }),
+                let destinationHost = fields["destinationHost"] as? String,
+                let destinationUser = fields["destinationUser"] as? String,
+                let destinationPort = fields["destinationPort"] as? Int,
+                let endpoint = try? RemoteEndpoint(host: host, user: fields["user"] as? String, port: fields["port"] as? Int).validated()
+            else { return nil }
+
+            let identity = RemoteFileIdentity(profileID: (fields["profile"] as? String).flatMap(UUID.init(uuidString:)), endpoint: endpoint, destination: RemoteDestination(hostName: destinationHost, user: destinationUser, port: destinationPort), requestedPath: requestedPath, path: path)
+
+            return Entry(tabID: entry.id, documentID: documentID, identity: identity)
+        }
+    }
+}
+
+
+extension DirectoryTabKind {
+
+    /// Remote file tabs, which are member documents rather than items.
+    ///
+    /// Archived tabs reopen offline from their recovery records, without connecting. A tab whose record
+    /// is gone becomes a placeholder that downloads the file only when the user reconnects.
+    static let remoteFile = DirectoryTabKind(
+        archiveKind: RemoteTabArchive.kind,
+        restoreDocuments: { entries, _ in
+            RemoteTabArchive.entries(in: entries).compactMap { entry in
+                // The record, which holds the edits, is the authority on what the tab shows; the archive only points to it.
+                let document = (try? RemoteOpenCoordinator.restore(documentID: entry.documentID))
+                    ?? RemoteDocument.placeholder(identity: entry.identity, documentID: entry.documentID, environment: .current)
+                return document.map { (tabID: entry.tabID, document: $0) }
+            }
+        },
+        addMenuItems: { [$0.openRemoteFileMenuItem] })
+}
