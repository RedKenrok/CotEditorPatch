+            directory.close()
+
+            try await self.withRestoredDirectory(at: rootURL, from: data, kinds: DirectoryTabKind.registered) { restored in
+                try await self.wait { restored.tabDocuments.count == 2 }
+                #expect(restored.tabState.entries.map(\.id) == order)
+                let pages = restored.webPageSessions
+                #expect(pages.count == 2)
+                let page = try #require(restored.activeWebPageSession)
+                #expect(page.id == session.id)
+                #expect(page.lifecycle == .restored)
+                #expect(page.title == "Page A")
+                #expect(page.restoredURL == server.url("/a"))
+                #expect(pages[1].lifecycle == .empty)
+
+                restored.makeWindowControllers()
+                restored.showWindows()
+                let controller = try #require(page.controller)
+                try await Task.sleep(for: .milliseconds(300))
+                #expect(server.count("/a") == 1, "restoring contacts no website")
+                #expect(!controller.webView.canGoBack, "history starts empty")
+
+                controller.load(try #require(page.restoredURL))
+                try await self.wait { server.count("/a") == 2 && !page.isLoading }
+                #expect(page.lifecycle == .active)
+            }
+        }
+    }
