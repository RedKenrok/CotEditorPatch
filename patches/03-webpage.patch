@@ -0,0 +1,251 @@
+//
+//  WebPageNavigationPolicy.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Darwin
+
+
+/// Which web addresses a webpage tab may show.
+///
+/// HTTPS is accepted everywhere, HTTP only for local development servers. This describes what the
+/// feature supports; it is not a security boundary, since DNS decides where a name leads. It applies
+/// to typed addresses, links, redirects, history navigation, new-window requests and restored tabs.
+/// Subresources, fetches and WebSockets are governed by App Transport Security and WebKit instead.
+enum WebPageNavigationPolicy {
+
+    /// Why an address is not shown.
+    enum Refusal: Error, Equatable {
+
+        /// The text is not a web address.
+        case invalidAddress
+        /// The address uses a scheme other than HTTPS or HTTP.
+        case unsupportedScheme(String)
+        /// An HTTP address that is not a local development server.
+        case requiresHTTPS(host: String)
+        /// The address carries a user name or password.
+        case embeddedCredentials
+    }
+
+
+    // MARK: Addresses
+
+    /// Turns what the user typed into an address to load.
+    ///
+    /// An address without a scheme gets HTTPS, including local ones such as `localhost:3000`; a local
+    /// development server is entered with `http://` explicitly. The field takes addresses only, so text
+    /// with spaces is refused rather than searched for.
+    ///
+    /// - Parameter text: The typed text.
+    /// - Returns: The address, or why it cannot be loaded.
+    static func url(fromTypedAddress text: String) -> Result<URL, Refusal> {
+
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+
+        guard !text.isEmpty, !text.contains(where: { $0.isWhitespace || $0.isNewline }) else { return .failure(.invalidAddress) }
+
+        let hasScheme = text.firstMatch(of: /^[A-Za-z][A-Za-z0-9+.\-]*:\/\//) != nil
+            || text.firstMatch(of: /^(?i:about|data|javascript|file|mailto|blob|ftp|tel|sms):/) != nil
+        let candidate = hasScheme ? text : "https://" + text
+
+        guard let url = URL(string: candidate, encodingInvalidCharacters: false) else { return .failure(.invalidAddress) }
+
+        if let refusal = self.refusal(for: url) { return .failure(refusal) }
+
+        return .success(url)
+    }
+
+
+    /// Checks an address that a tab is about to show.
+    ///
+    /// - Parameter url: The address.
+    /// - Returns: Why it may not be shown, or `nil` if it may.
+    static func refusal(for url: URL) -> Refusal? {
+
+        guard let components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              let scheme = components.scheme?.lowercased()
+        else { return .invalidAddress }
+
+        guard scheme == "https" || scheme == "http" else { return .unsupportedScheme(scheme) }
+
+        guard components.user == nil, components.password == nil else { return .embeddedCredentials }
+
+        guard let host = components.host, !host.isEmpty else { return .invalidAddress }
+
+        guard let classification = Host(host) else { return .invalidAddress }
+
+        if scheme == "http", !classification.isLocal {
+            return .requiresHTTPS(host: host)
+        }
+
+        return nil
+    }
+
+
+    /// Whether a frame inside a page may show an address.
+    ///
+    /// Pages build frames from `about:`, `data:` and `blob:` content of their own; those are allowed,
+    /// since they reach no server. Anything else follows the same rules as the page itself.
+    static func allowsSubframe(_ url: URL) -> Bool {
+
+        switch url.scheme?.lowercased() {
+            case "about", "data", "blob": true
+            default: self.refusal(for: url) == nil
+        }
+    }
+
+
+    // MARK: Hosts
+
+    /// A host name or IP address, parsed by its structure rather than by matching text.
+    ///
+    /// Names are classified by their labels, so that `localhost.example.com` and `10.0.0.1.example.com`
+    /// are ordinary qualified names. Numeric hosts are parsed as WebKit's URL parser reads them, including
+    /// shortened and hexadecimal IPv4 forms, since WebKit would otherwise turn such a name into an address.
+    enum Host: Equatable {
+
+        case ipv4(UInt32)
+        case ipv6([UInt8])
+        case name([String])
+
+
+        /// Parses a host as it appears in a URL, with or without the brackets around an IPv6 address.
+        ///
+        /// - Returns: The host, or `nil` if it is not a valid host.
+        init?(_ text: String) {
+
+            var text = text
+            if text.hasPrefix("["), text.hasSuffix("]") {
+                text = String(text.dropFirst().dropLast())
+            }
+
+            if text.contains(":") {
+                // A zone identifier (`fe80::1%en0`) names the interface, not part of the address.
+                let address = text.split(separator: "%", maxSplits: 1, omittingEmptySubsequences: false).first.map(String.init) ?? text
+                var storage = in6_addr()
+                guard inet_pton(AF_INET6, address, &storage) == 1 else { return nil }
+                self = .ipv6(withUnsafeBytes(of: storage) { Array($0) })
+                return
+            }
+
+            var labels = text.lowercased().split(separator: ".", omittingEmptySubsequences: false).map(String.init)
+            // A single trailing dot marks a fully qualified name and changes nothing else.
+            if labels.count > 1, labels.last?.isEmpty == true {
+                labels.removeLast()
+            }
+            guard !labels.isEmpty, labels.allSatisfy({ !$0.isEmpty }) else { return nil }
+
+            if let last = labels.last, Self.isNumericLabel(last) {
+                guard let address = Self.parseIPv4(labels) else { return nil }
+                self = .ipv4(address)
+                return
+            }
+
+            let allowed = CharacterSet(charactersIn: "abcdefghijklmnopqrstuvwxyz0123456789-_")
+            guard labels.allSatisfy({ $0.unicodeScalars.allSatisfy(allowed.contains) || $0.hasPrefix("xn--") }) else { return nil }
+
+            self = .name(labels)
+        }
+
+
+        /// Whether HTTP is supported for this host: `localhost`, loopback, private and link-local
+        /// addresses, unqualified names and names under `.local`.
+        var isLocal: Bool {
+
+            switch self {
+                case .ipv4(let address):
+                    return Self.isLocalIPv4(address)
+
+                case .ipv6(let bytes):
+                    // loopback ::1
+                    if bytes == Array(repeating: 0, count: 15) + [1] { return true }
+                    // unique local fc00::/7, the IPv6 private range
+                    if bytes[0] & 0xfe == 0xfc { return true }
+                    // link-local fe80::/10
+                    if bytes[0] == 0xfe, bytes[1] & 0xc0 == 0x80 { return true }
+                    // an IPv4 address mapped into IPv6, ::ffff:a.b.c.d
+                    if bytes[0..<10].allSatisfy({ $0 == 0 }), bytes[10] == 0xff, bytes[11] == 0xff {
+                        return Self.isLocalIPv4(bytes[12...].reduce(0) { $0 << 8 | UInt32($1) })
+                    }
+                    return false
+
+                case .name(let labels):
+                    return labels.count == 1 || labels == ["localhost"] || labels.last == "local"
+            }
+        }
+
+
+        private static func isLocalIPv4(_ address: UInt32) -> Bool {
+
+            let octets = (UInt8(address >> 24), UInt8(address >> 16 & 0xff))
+
+            return switch octets {
+                case (127, _): true  // loopback
+                case (10, _): true  // private
+                case (172, 16...31): true  // private
+                case (192, 168): true  // private
+                case (169, 254): true  // link-local
+                default: false
+            }
+        }
+
+
+        /// Whether a label reads as a number, which makes the whole host an IPv4 address.
+        private static func isNumericLabel(_ label: String) -> Bool {
+
+            if label.lowercased().hasPrefix("0x") {
+                return label.dropFirst(2).allSatisfy(\.isHexDigit)
+            }
+            return label.allSatisfy { $0.isASCII && $0.isNumber }
+        }
+
+
+        /// Reads an IPv4 address of one to four parts, each decimal, octal (`0` prefix) or hexadecimal (`0x` prefix).
+        private static func parseIPv4(_ labels: [String]) -> UInt32? {
+
+            guard labels.count <= 4 else { return nil }
+
+            var numbers: [UInt64] = []
+            for label in labels {
+                let lowercased = label.lowercased()
+                let number: UInt64?
+                if lowercased.hasPrefix("0x") {
+                    number = lowercased.count == 2 ? 0 : UInt64(lowercased.dropFirst(2), radix: 16)
+                } else if lowercased.count > 1, lowercased.hasPrefix("0") {
+                    number = UInt64(lowercased.dropFirst(), radix: 8)
+                } else {
+                    number = UInt64(lowercased, radix: 10)
+                }
+                guard let number else { return nil }
+                numbers.append(number)
+            }
+
+            let last = numbers.removeLast()
+            guard numbers.allSatisfy({ $0 <= 255 }) else { return nil }
+            guard last < (1 << (8 * (4 - UInt64(numbers.count)))) else { return nil }
+
+            let leading = numbers.enumerated().reduce(UInt64(0)) { $0 | $1.element << (8 * (3 - UInt64($1.offset))) }
+
+            return UInt32(leading | last)
+        }
+    }
+}
