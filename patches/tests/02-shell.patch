+
+import AppKit
+import Foundation
+import Testing
+@testable import CotEditor
+
+/// Real pseudo-terminal sessions with controlled shells.
+///
+/// The shells run without user startup files (`/bin/sh -c` or `zsh -f`) and with a fixed environment,
+/// so results never depend on the developer's shell configuration. Every wait is bounded, and every
+/// engine is shut down even when an expectation fails.
+@Suite(.serialized) @MainActor struct TerminalPTYTests {
+
+    private static let environment = ["TERM=xterm-256color", "PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LANG=en_US.UTF-8"]
+
+
+    @Test(.timeLimit(.minutes(1))) func runsInItsOwnDirectoryWithUnicode() async throws {
+
+        // A name that would break if it were ever passed through a shell command line.
+        try await self.withDirectory(named: "pty test $(false) ✓ ü") { directory in
+            let engine = SwiftTermEngine()
+            defer { engine.shutDown() }
+            var status: TerminalExitStatus?
+            engine.onExit = { status = $0 }
+
+            try engine.start(self.shell("pwd -P; echo \"TERM=$TERM\"; printf 'h\\303\\251llo \\342\\234\\223\\n'; printf 'nfd u\\314\\210 end\\n'; exit 3", in: directory))
+
+            // The exit can be reported before the last output has been drawn, so wait for both.
+            try await self.wait { status != nil && engine.bufferText.contains(" end") }
+            #expect(status == TerminalExitStatus(code: 3))
+            // Long paths wrap at the terminal width.
+            let text = engine.bufferText.replacing("\n", with: "").replacing("\0", with: "")
+            let components = directory.pathComponents.suffix(2).joined(separator: "/")
+            #expect(text.contains(components), "the folder name reaches the shell literally")
+            #expect(text.contains("TERM=xterm-256color"))
+            #expect(text.contains("héllo ✓"))
+            #expect(text.contains("nfd u\u{0308} end"), "a combining accent stays with its letter")
+            
+            // Copying what the terminal shows keeps the same characters.
+            let pasteboard = NSPasteboard.general
+            let saved = pasteboard.string(forType: .string)
+            defer {
+                pasteboard.clearContents()
+                if let saved { pasteboard.setString(saved, forType: .string) }
+            }
+            NSApp.sendAction(#selector(NSText.selectAll(_:)), to: engine.focusView, from: nil)
+            NSApp.sendAction(#selector(NSText.copy(_:)), to: engine.focusView, from: nil)
+            let copied = try #require(pasteboard.string(forType: .string))
+            #expect(copied.contains("héllo ✓"))
+            #expect(copied.contains("nfd u\u{0308} end"))
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func concurrentSessionsAreIndependent() async throws {
+
+        try await self.withDirectory(named: "first") { first in
+            try await self.withDirectory(named: "second") { second in
+                let engines = [SwiftTermEngine(), SwiftTermEngine()]
+                defer { engines.forEach { $0.shutDown() } }
+                var exits = 0
+                for engine in engines {
+                    engine.onExit = { _ in exits += 1 }
+                }
+
+                try engines[0].start(self.shell("pwd -P; echo \"MARK=$MARK\"; sleep 0.2", in: first, environment: ["MARK=one"]))
+                try engines[1].start(self.shell("pwd -P; echo \"MARK=$MARK\"; sleep 0.2", in: second, environment: ["MARK=two"]))
+
+                try await self.wait { exits == 2 && engines.allSatisfy { $0.bufferText.contains("MARK=") } }
+                #expect(engines[0].processID != engines[1].processID)
+                #expect(engines[0].bufferText.contains("/first") && engines[0].bufferText.contains("MARK=one"))
+                #expect(engines[1].bufferText.contains("/second") && engines[1].bufferText.contains("MARK=two"))
+                #expect(!engines[0].bufferText.contains("MARK=two"))
+            }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func resizeReachesThePseudoTerminal() async throws {
+
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        try engine.start(self.shell("sleep 10", in: FileManager.default.temporaryDirectory))
+
+        let before = try #require(self.windowSize(of: engine))
+        engine.focusView.setFrameSize(NSSize(width: 1400, height: 900))
+        let after = try #require(self.windowSize(of: engine))
+
+        #expect(after.ws_col > before.ws_col)
+        #expect(after.ws_row > before.ws_row)
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func exitStatusesAndLaunchErrorsAreReported() async throws {
+
+        let signaled = SwiftTermEngine()
+        let missing = SwiftTermEngine()
+        defer {
+            signaled.shutDown()
+            missing.shutDown()
+        }
+        var signalStatus: TerminalExitStatus?
+        var missingStatus: TerminalExitStatus?
+        signaled.onExit = { signalStatus = $0 }
+        missing.onExit = { missingStatus = $0 }
+
+        try signaled.start(self.shell("kill -9 $$", in: FileManager.default.temporaryDirectory))
+        try missing.start(TerminalLaunchConfiguration(executable: "/nonexistent/shell", argv0: "shell", arguments: [],
+                                                      environment: Self.environment, currentDirectory: NSTemporaryDirectory()))
+
+        try await self.wait { signalStatus != nil && missingStatus != nil }
+        #expect(signalStatus == TerminalExitStatus(code: nil, signal: SIGKILL))
+        #expect(missingStatus == TerminalExitStatus(code: 127), "a shell that cannot be executed exits the child with 127")
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func shutdownStopsForegroundJobs() async throws {
+
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        var didExit = false
+        engine.onExit = { _ in didExit = true }
+
+        // An interactive shell with job control runs the job in its own foreground process group.
+        try engine.start(TerminalLaunchConfiguration(executable: "/bin/zsh", argv0: "zsh", arguments: ["-f", "-i"],
+                                                     environment: Self.environment, currentDirectory: NSTemporaryDirectory()))
+        let shell = engine.processID
+        try await self.wait { !engine.bufferText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty }
+        engine.type("sleep 60\r")
+        try await self.wait { tcgetpgrp(engine.pseudoTerminalDescriptor) != shell }
+        let job = tcgetpgrp(engine.pseudoTerminalDescriptor)
+        #expect(job > 1)
+
+        engine.shutDown()
+
+        try await self.wait(timeout: .seconds(10)) { !Self.exists(shell) && !Self.exists(job) }
+        #expect(!didExit, "no callback reaches a closed tab")
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func shutdownForcesSessionsThatIgnoreHangup() async throws {
+
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        try engine.start(self.shell("trap '' HUP TERM; while :; do sleep 0.1; done", in: FileManager.default.temporaryDirectory))
+        let shell = engine.processID
+        try await Task.sleep(for: .milliseconds(200))
+
+        engine.shutDown()
+        try await Task.sleep(for: .milliseconds(500))
+        #expect(Self.exists(shell), "the session gets a grace period first")
+
+        try await self.wait(timeout: .seconds(10)) { !Self.exists(shell) }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func pseudoTerminalIsReleased() async throws {
+
+        // A live session closed by the user, and one whose shell exited on its own.
+        for script in ["sleep 10", "exit 0"] {
+            var engine: SwiftTermEngine? = SwiftTermEngine()
+            var didExit = false
+            engine?.onExit = { _ in didExit = true }
+            try engine?.start(self.shell(script, in: FileManager.default.temporaryDirectory))
+            let device = try #require(engine.flatMap { Self.device(of: $0.pseudoTerminalDescriptor) })
+            #expect(Self.openDescriptors(for: device) > 0)
+
+            if script == "exit 0" {
+                try await self.wait { didExit }
+            }
+            engine?.shutDown()
+            engine = nil
+
+            try await self.wait { Self.openDescriptors(for: device) == 0 }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func bracketedPasteWrapsMultilineInput() async throws {
+
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        var didExit = false
+        engine.onExit = { _ in didExit = true }
+
+        // The program turns bracketed paste on, then echoes the raw bytes it reads as hex.
+        try engine.start(self.shell("stty raw -echo; printf '\\033[?2004h'; echo READY; head -c 17 | od -An -tx1; stty sane", in: FileManager.default.temporaryDirectory))
+        try await self.wait { engine.bufferText.contains("READY") }
+
+        let pasteboard = NSPasteboard.general
+        let saved = pasteboard.string(forType: .string)
+        defer {
+            pasteboard.clearContents()
+            if let saved { pasteboard.setString(saved, forType: .string) }
+        }
+        pasteboard.clearContents()
+        pasteboard.setString("ab\ncd", forType: .string)
+        NSApp.sendAction(#selector(NSText.paste(_:)), to: engine.focusView, from: nil)
+
+        try await self.wait { didExit && engine.bufferText.contains("7e") }
+        // The dump wraps at the terminal width and the buffer pads cells with NUL, so keep only the digits.
+        let hex = String(try #require(engine.bufferText.components(separatedBy: "READY").last).filter(\.isHexDigit))
+        // ESC [ 2 0 0 ~  a b LF c d  ESC [ 2 0 1 ~
+        #expect(hex.contains("1b5b3230307e61620a63641b5b3230317e"))
+    }
