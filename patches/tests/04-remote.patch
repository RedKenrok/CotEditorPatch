@@ -0,0 +1,193 @@
+//
+//  RemoteSFTPCodecTests.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
