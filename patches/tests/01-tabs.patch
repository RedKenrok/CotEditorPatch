+import AppKit
+import Foundation
+import Testing
+import Defaults
+@testable import CotEditor
+
+/// Drives a real directory window, because viewport drift only appears once AppKit
+/// has run layout, inset and first-responder passes on an attached editor.
+extension DirectoryTabTests {
+
+    @Test(.timeLimit(.minutes(1)), arguments: [
+        (showsLineNumbers: true, showsNavigationBar: true),
+        (showsLineNumbers: false, showsNavigationBar: true),
+        (showsLineNumbers: true, showsNavigationBar: false),
+        (showsLineNumbers: false, showsNavigationBar: false),
+    ])
+    func topEdgeSurvivesRepeatedSwitching(showsLineNumbers: Bool, showsNavigationBar: Bool) async throws {
+
+        try await self.withDirectoryWindow(defaults: [.showLineNumbers: showsLineNumbers, .showNavigationBar: showsNavigationBar]) { window in
+            let textView = try #require(window.textViews.first)
+            // A caret far below the viewport proves restoration does not fall back to scrolling to the selection.
+            textView.setSelectedRange(NSRange(location: (textView.string as NSString).length, length: 0))
+            window.scroll(textView, to: .zero)
+            await window.settle()
+            #expect(window.offset(of: textView) == .zero)
+
+            for _ in 0..<4 {
+                window.directory.selectDocument(window.second)
+                window.directory.selectDocument(window.first)
+                let reattached = try #require(window.textViews.first)
+                #expect(reattached === textView)
+                #expect(window.offset(of: reattached) == .zero, "immediately after attach")
+                await window.settle()
+                #expect(window.offset(of: reattached) == .zero, "after layout")
+                #expect(reattached.selectedRange.location == (reattached.string as NSString).length)
+            }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func independentOffsetsAwayFromCaretSurviveSwitching() async throws {
+
+        try await self.withDirectoryWindow(defaults: [.wrapLines: false]) { window in
+            let textView = try #require(window.textViews.first)
+            textView.setSelectedRange(NSRange(location: 0, length: 0))
+            let target = NSPoint(x: 120, y: 2_400)
+            window.scroll(textView, to: target)
+            await window.settle()
+            let expected = window.offset(of: textView)
+            #expect(expected.x > 0)
+            #expect(expected.y > 0)
+
+            for _ in 0..<3 {
+                window.directory.selectDocument(window.second)
+                await window.settle()
+                window.directory.selectDocument(window.first)
+                await window.settle()
+                #expect(window.textViews.first.map(window.offset(of:)) == expected)
+            }
+            #expect(textView.selectedRange == NSRange(location: 0, length: 0))
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func splitEditorsKeepTheirOwnViewportsAndFocus() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let editor = try #require(window.documentViewController)
+            editor.openSplitTextView(nil)
+            await window.settle()
+            let textViews = window.textViews
+            try #require(textViews.count == 2)
+
+            // Multiple selected ranges are a property of the retained text view, not something restored separately.
+            let ranges = [NSRange(location: 10, length: 4), NSRange(location: 400, length: 6)]
+            textViews[1].selectedRanges = ranges as [NSValue]
+            window.scroll(textViews[0], to: .zero)
+            window.scroll(textViews[1], to: NSPoint(x: 0, y: 1_800))
+            window.window.makeFirstResponder(textViews[1])
+            await window.settle()
+            let expected = textViews.map(window.offset(of:))
+            #expect(expected[0] == .zero)
+            #expect(expected[1].y > 0)
+
+            window.directory.selectDocument(window.second)
+            await window.settle()
+            window.directory.selectDocument(window.first)
+            await window.settle()
+
+            #expect(window.textViews.map(window.offset(of:)) == expected)
+            #expect(window.textViews[1].selectedRanges as? [NSRange] == ranges)
+            #expect(window.documentViewController?.focusedTextView === textViews[1])
+            #expect(window.window.firstResponder === textViews[1])
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func verticalLayoutOffsetSurvivesSwitching() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let editor = try #require(window.documentViewController)
+            editor.verticalLayoutOrientation = true
+            await window.settle()
+            let textView = try #require(window.textViews.first)
+            window.scroll(textView, to: NSPoint(x: 600, y: 0))
+            await window.settle()
+            let expected = window.offset(of: textView)
+
+            window.directory.selectDocument(window.second)
+            await window.settle()
+            window.directory.selectDocument(window.first)
+            await window.settle()
+
+            #expect(window.textViews.first.map(window.offset(of:)) == expected)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func rapidSwitchingAndReselectionDoNotMoveViewports() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let first = try #require(window.textViews.first)
+            window.scroll(first, to: .zero)
+            window.directory.selectDocument(window.second)
+            let second = try #require(window.textViews.first)
+            window.scroll(second, to: NSPoint(x: 0, y: 3_000))
+            await window.settle()
+            let secondOffset = window.offset(of: second)
+
+            // A → B → A → B within one run-loop turn: deferred work from an earlier switch must not act on a later tab.
+            window.directory.selectDocument(window.first)
+            window.directory.selectDocument(window.second)
+            window.directory.selectDocument(window.first)
+            window.directory.selectDocument(window.second)
+            await window.settle()
+            #expect(window.textViews.first.map(window.offset(of:)) == secondOffset)
+
+            // Selecting the tab that is already active is a no-op.
+            window.directory.selectDocument(window.second)
+            await window.settle()
+            #expect(window.textViews.first.map(window.offset(of:)) == secondOffset)
+
+            window.directory.selectDocument(window.first)
+            await window.settle()
+            #expect(window.textViews.first.map(window.offset(of:)) == .zero)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func editingInactiveContentClampsRetainedState() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let textView = try #require(window.textViews.first)
+            let length = (textView.string as NSString).length
+            textView.setSelectedRange(NSRange(location: length - 10, length: 5))
+            window.scroll(textView, to: NSPoint(x: 0, y: 1_000_000))
+            await window.settle()
+
+            window.directory.selectDocument(window.second)
+            await window.settle()
+            // Shrink the hidden document so both the retained selection and the stored offset are out of range.
+            let document = try #require(window.first as? Document)
+            document.textStorage.replaceCharacters(in: NSRange(location: 0, length: document.textStorage.length), with: "short")
+            window.directory.selectDocument(window.first)
+            await window.settle()
+
+            let reattached = try #require(window.textViews.first)
+            #expect(NSMaxRange(reattached.selectedRange) <= (reattached.string as NSString).length)
+            let clip = try #require(reattached.enclosingScrollView?.contentView)
+            #expect(clip.bounds == clip.constrainBoundsRect(clip.bounds))
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func closingReleasesRetainedEditorState() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let textView = try #require(window.textViews.first)
+            window.scroll(textView, to: NSPoint(x: 0, y: 2_000))
+            window.directory.selectDocument(window.second)
+            await window.settle()
+
+            #expect(await window.directory.closeDocument(window.first))
+            #expect(await window.directory.openDocument(at: window.urls[0]))
+            await window.settle()
+
+            let reopened = try #require(window.textViews.first)
+            #expect(reopened !== textView)
+            // A new editor must start at the top edge under the toolbar and tab bar, not scrolled under them.
+            #expect(window.offset(of: reopened) == .zero)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func renamingInactiveFileKeepsItsEditor() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let textView = try #require(window.textViews.first)
+            window.scroll(textView, to: NSPoint(x: 0, y: 1_500))
+            await window.settle()
+            let expected = window.offset(of: textView)
+            window.directory.selectDocument(window.second)
+
+            let node = try #require(window.directory.fileNode?.node(at: window.urls[0]))
+            try window.directory.renameItem(at: node, with: "renamed.txt")
+            try await self.wait { window.first.fileURL?.lastPathComponent == "renamed.txt" }
+
+            window.directory.selectDocument(window.first)
+            await window.settle()
+            #expect(window.textViews.first === textView)
+            #expect(window.textViews.first.map(window.offset(of:)) == expected)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func sidebarFocusIsNotStolenBySwitching() async throws {
+
+        try await self.withDirectoryWindow { window in
+            let sidebarView = try #require((window.window.contentViewController as? NSSplitViewController)?.splitViewItems.first?.viewController.view)
+            let outlineView = try #require(Self.firstDescendant(of: sidebarView) { $0 is NSOutlineView })
+            window.window.makeFirstResponder(outlineView)
+
+            window.directory.selectDocument(window.second)
+            await window.settle()
+            #expect(window.window.firstResponder === outlineView)
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func emptyHostShowsPlaceholderAndRestoresEditor() async throws {
+
+        try await self.withDirectoryWindow { window in
+            #expect(await window.directory.closeDocument(window.second))
+            #expect(await window.directory.closeDocument(window.first))
+            await window.settle()
+            #expect(window.directory.activeFileDocument == nil)
+            #expect(window.documentViewController == nil)
+
+            #expect(await window.directory.openDocument(at: window.urls[1]))
+            await window.settle()
+            #expect(window.documentViewController?.document === window.directory.activeFileDocument)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    private static func firstDescendant(of view: NSView, where predicate: (NSView) -> Bool) -> NSView? {
+
+        for subview in view.subviews {
+            if predicate(subview) { return subview }
+            if let found = Self.firstDescendant(of: subview, where: predicate) { return found }
+        }
+        return nil
+    }
+
+
+    /// Opens two long files in a visible directory window with file tabs enabled.
+    private func withDirectoryWindow(defaults overrides: [DefaultKey<Bool>: Bool] = [:], _ body: (DirectoryWindowFixture) async throws -> Void) async throws {
+
+        let keys = [DefaultKeys.usesDirectoryFileTabs] + overrides.keys
+        let originals = keys.map { UserDefaults.standard.object(forKey: $0.rawValue) }
+        UserDefaults.standard[.usesDirectoryFileTabs] = true
+        for (key, value) in overrides {
+            UserDefaults.standard[key] = value
+        }
+
+        let rootURL = FileManager.default.temporaryDirectory.appending(path: UUID().uuidString, directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: rootURL, withIntermediateDirectories: true)
+        let longLine = String(repeating: "horizontal content ", count: 40)
+        let contents = (0..<600).map { "line \($0) \(longLine)" }.joined(separator: "\n")
+        let urls = ["first.txt", "second.txt"].map { rootURL.appending(path: $0, directoryHint: .notDirectory) }
+        for url in urls {
+            try Data(contents.utf8).write(to: url)
+        }
+
+        let directory = DirectoryDocument()
+        defer {
+            directory.close()
+            for (key, original) in zip(keys, originals) {
+                UserDefaults.standard.set(original, forKey: key.rawValue)
+            }
+            try? FileManager.default.removeItem(at: rootURL)
+        }
+        directory.fileURL = rootURL
+        try directory.read(from: rootURL, ofType: "public.folder")
+        directory.makeWindowControllers()
+        directory.showWindows()
+
+        try #require(await directory.openDocument(at: urls[0]))
+        try #require(await directory.openDocument(at: urls[1]))
+        let root = try #require(directory.fileNode)
+        let firstNode = try #require(root.node(at: urls[0]))
+        let secondNode = try #require(root.node(at: urls[1]))
+        let first = try #require(directory.openedDocument(at: firstNode))
+        let second = try #require(directory.openedDocument(at: secondNode))
+        directory.selectDocument(first)
+
+        let window = try #require(directory.windowControllers.first?.window)
+        let fixture = DirectoryWindowFixture(directory: directory, window: window, urls: urls, first: first, second: second)
+        await fixture.settle()
+
+        try await body(fixture)
+    }
+}
+
+
+@MainActor private struct DirectoryWindowFixture {
+
+    let directory: DirectoryDocument
+    let window: NSWindow
+    let urls: [URL]
+    let first: DataDocument
+    let second: DataDocument
+
+
+    var documentViewController: DocumentViewController? {
+
+        (self.window.contentViewController as? WindowContentViewController)?.documentViewController
+    }
+
+
+    var textViews: [EditorTextView] {
+
+        self.documentViewController?.textViews ?? []
+    }
+
+
+    /// Lets AppKit run layout, display and deferred main-queue work.
+    func settle() async {
+
+        for _ in 0..<3 {
+            self.window.layoutIfNeeded()
+            self.window.displayIfNeeded()
+            try? await Task.sleep(for: .milliseconds(50))
+        }
+    }
+
+
+    /// The clip-view position measured from the inset-adjusted top-left, where `.zero` is the very top.
+    func offset(of textView: NSTextView) -> NSPoint {
+
+        guard let clip = textView.enclosingScrollView?.contentView else { return NSPoint(x: CGFloat.nan, y: CGFloat.nan) }
+
+        return NSPoint(x: clip.bounds.origin.x + clip.contentInsets.left,
+                       y: clip.bounds.origin.y + clip.contentInsets.top)
+    }
+
+
+    func scroll(_ textView: NSTextView, to offset: NSPoint) {
+
+        guard let scrollView = textView.enclosingScrollView else { return }
+
+        let clip = scrollView.contentView
+        var bounds = clip.bounds
+        bounds.origin = NSPoint(x: offset.x - clip.contentInsets.left, y: offset.y - clip.contentInsets.top)
+        clip.scroll(to: clip.constrainBoundsRect(bounds).origin)
+        scrollView.reflectScrolledClipView(clip)
+    }
+}
