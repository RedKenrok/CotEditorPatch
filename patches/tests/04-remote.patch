+    @Test func jumpHostsGetTheSafetyOptionsThroughCommandsOfTheirOwn() throws {
+
+        let hosts = [RemoteEndpoint(host: "first", user: "o'neil", port: 2200), RemoteEndpoint(host: "second", user: nil, port: nil)]
+        let arguments = RemoteSSHCommand.connectionArguments(for: RemoteEndpoint(host: "target", user: nil, port: nil), through: hosts)
+        #expect(arguments.prefix(5) == ["-T", "-a", "-x", "-s", "-o"])
+        let proxy = try #require(arguments.first { $0.hasPrefix("ProxyCommand=") }?.dropFirst("ProxyCommand=".count))
+
+        // The target's ssh runs this command in a shell: it reaches the second jump host, which forwards to the target.
+        let second = try Self.shellWords(String(proxy))
+        #expect(second.first == "/usr/bin/ssh")
+        #expect(second.suffix(4) == ["-W", "[%h]:%p", "--", "second"])
+        let inner = try #require(second.first { $0.hasPrefix("ProxyCommand=") }?.dropFirst("ProxyCommand=".count))
+        #expect(inner.contains("[%%h]:%%p"), "the target's ssh expands the tokens once, leaving them for the second jump host's")
+
+        // The second jump host's ssh gets its own command with the tokens as they were before the target's ssh expanded them.
+        let first = try Self.shellWords(String(inner).replacing("%%", with: "%"))
+        #expect(first.suffix(4) == ["-W", "[%h]:%p", "--", "first"], "the first jump host forwards to the second")
+        #expect(first.contains("o'neil"), "arguments are quoted for the shell")
+        #expect(first.firstIndex(of: "-p").map { first[$0 + 1] } == "2200")
+        for option in RemoteSSHCommand.safetyOptions {
+            #expect(second.contains(option) && first.contains(option), "each jump host gets \(option)")
+        }
+        #expect(!first.contains { $0.hasPrefix("ProxyCommand") }, "the first jump host is reached as its configuration says")
+        #expect(RemoteSSHCommand.connectionArguments(for: RemoteEndpoint(host: "target", user: nil, port: nil)).first { $0.hasPrefix("ProxyCommand") } == nil)
+    }
+
+
+    /// The words `/bin/sh` makes of a command.
+    private static func shellWords(_ command: String) throws -> [String] {
+
+        let process = Process()
+        process.executableURL = URL(filePath: "/bin/sh")
+        process.arguments = ["-c", "for word in " + command + "; do printf '%s\\0' \"$word\"; done"]
+        let pipe = Pipe()
+        process.standardOutput = pipe
+        try process.run()
+        process.waitUntilExit()
+
+        let output = pipe.fileHandleForReading.readDataToEndOfFile()
+        return output.split(separator: 0).compactMap { String(bytes: $0, encoding: .utf8) }
+    }
