+    @Test func exitKeepsOutputAndRestartMakesNewProcess() throws {
+
+        let engines = FakeTerminalEngines()
+        let session = TerminalSession(defaultTitle: "Shell", startingDirectory: FileManager.default.temporaryDirectory, makeEngine: engines.make)
+        session.start()
+        let first = try #require(engines.made.first)
+
+        first.finish(code: 3)
+        #expect(session.lifecycle == .exited(TerminalExitStatus(code: 3)))
+        #expect(!session.isLive)
+        #expect(session.engine === first, "the exited terminal stays readable")
+        #expect(first.shutDownCount == 0)
+
+        session.start()
+        let second = try #require(engines.made.last)
+        #expect(second !== first)
+        #expect(first.shutDownCount == 1)
+        #expect(session.engine === second)
+        #expect(session.lifecycle == .running)
+        #expect(second.configurations.count == 1, "a restart starts a new shell; nothing is replayed")
+    }
