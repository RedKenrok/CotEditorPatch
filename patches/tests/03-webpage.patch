+    // MARK: Helpers
+
+    /// Runs the body with a directory window, scripted webpage prompts and a local HTTP server.
+    func withWebPages(_ body: (DirectoryDocument, [URL], WebPageTestServer, ScriptedWebPagePrompts) async throws -> Void) async throws {
+
+        let prompts = ScriptedWebPagePrompts()
+        let originalPrompts = WebPagePrompts.current
+        WebPagePrompts.current = prompts
+        defer { WebPagePrompts.current = originalPrompts }
+
+        let server = try WebPageTestServer()
+        try await server.start()
+        defer { server.stop() }
+
+        try await self.withDirectory(makesWindow: true) { directory, urls in
+            // Dialogs show only on the frontmost window while the app is not active, which an untitled
+            // document the app opened at launch would be; only this serialized suite opens windows.
+            for document in NSDocumentController.shared.documents
+            where type(of: document) == Document.self && document.fileURL == nil && !document.isDocumentEdited && (document as? Document)?.directoryDocument == nil {
+                document.close()
+            }
+            directory.windowController?.window?.orderFrontRegardless()
+            try await body(directory, urls, server, prompts)
+        }
+    }
+
+
+    /// Runs a script in the page's main frame and returns its result as a string.
+    func evaluate(_ script: String, in webView: WKWebView) async throws -> String? {
+
+        try await withCheckedThrowingContinuation { continuation in
+            webView.evaluateJavaScript(script) { result, error in
+                if let error = error as? WKError, error.code == .javaScriptResultTypeIsUnsupported {
+                    // a script that ends in `undefined`, such as a click
+                    continuation.resume(returning: nil)
+                } else if let error {
+                    continuation.resume(throwing: error)
+                } else {
+                    continuation.resume(returning: result.map { "\($0)" })
+                }
+            }
+        }
+    }
+
+
+    /// Polls until the asynchronous condition holds.
+    func waitAsync(timeout: Duration = .seconds(5), until condition: () async -> Bool) async throws {
+
+        let deadline = ContinuousClock.now + timeout
+        while await !condition() {
+            guard ContinuousClock.now < deadline else {
+                Issue.record("Timed out waiting for condition")
+                return
+            }
+            try await Task.sleep(for: .milliseconds(20))
+        }
+    }
+}
+
+
+// MARK: - Fixtures
+
+/// Webpage prompts that answer as the test says, and record what was asked.
+@MainActor final class ScriptedWebPagePrompts: WebPagePrompting {
+
+    var enablesTabs = true
+    var resubmits = false
+    var clearsData = true
+    /// The answer to website dialogs, or `nil` to keep each one on screen until it is dismissed.
+    var dialogResponse: WebPageDialog.Response?
+
+    private(set) var enableRequestCount = 0
+    private(set) var resubmissionRequests: [URL?] = []
+    private(set) var clearRequestCount = 0
+    private(set) var dialogs: [WebPageDialog] = []
+    private(set) var pendingHandle: WebPageDialogHandle?
+
+    var totalRequestCount: Int  { self.enableRequestCount + self.resubmissionRequests.count + self.clearRequestCount + self.dialogs.count }
+
+
+    func confirmEnablingTabs(window: NSWindow?) async -> Bool {
+
+        self.enableRequestCount += 1
+        return self.enablesTabs
+    }
+
+
+    func confirmResubmission(to url: URL?, window: NSWindow?) async -> Bool {
+
+        self.resubmissionRequests.append(url)
+        return self.resubmits
+    }
+
+
+    func confirmClearingWebsiteData(window: NSWindow?) async -> Bool {
+
+        self.clearRequestCount += 1
+        return self.clearsData
+    }
+
+
+    func present(_ dialog: WebPageDialog, window: NSWindow, handle: WebPageDialogHandle) async -> WebPageDialog.Response {
+
+        self.dialogs.append(dialog)
+        if let dialogResponse { return dialogResponse }
+
+        return await withCheckedContinuation { continuation in
+            self.pendingHandle = handle
+            // After a dismissal the prompt reports an answer the user never gave;
+            // the presenter must answer the page with the safe response regardless.
+            handle.dismissHandler = { [weak self] in
+                self?.pendingHandle = nil
+                continuation.resume(returning: .confirmed(true))
+            }
+        }
+    }
+}
