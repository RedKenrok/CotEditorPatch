+
+        let drafts = try URL(for: .autosavedInformationDirectory, in: .userDomainMask, create: true)
+        let draftsBefore = Set((try? FileManager.default.contentsOfDirectory(atPath: drafts.path(percentEncoded: false))) ?? [])
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, any Error>) in
+            document.autosave(withImplicitCancellability: false) { error in
+                if let error { continuation.resume(throwing: error) } else { continuation.resume() }
+            }
