+//  limitations under the License.
+//
+
+import AppKit
+import SwiftUI
+
+
+/// Presents the sheet that asks which remote file to open.
+@MainActor enum RemoteOpenPanel {
+
+    /// Shows the sheet on the directory's window, or as a window of its own without one.
+    ///
+    /// - Parameter directory: The directory window to open the file in as a tab, if any.
+    static func show(for directory: DirectoryDocument?) {
+
+        let model = RemoteOpenModel(directory: directory)
+        let controller = NSHostingController(rootView: RemoteOpenView(model: model))
+        controller.sizingOptions = .preferredContentSize
+        model.dismiss = { [weak controller] in
+            guard let controller else { return }
+            controller.presentingViewController?.dismiss(controller)
+            controller.view.window?.close()
+        }
+
+        if let presenter = directory?.windowController?.window?.contentViewController, presenter.view.window?.attachedSheet == nil {
+            presenter.presentAsSheet(controller)
+        } else {
+            let window = NSWindow(contentViewController: controller)
+            window.title = String(localized: "RemoteOpen.windowTitle", defaultValue: "Open Remote File", table: "Remote")
+            window.styleMask = [.titled, .closable]
+            window.isReleasedWhenClosed = false
+            window.center()
+            window.makeKeyAndOrderFront(nil)
+        }
+    }
+}
+
+
+/// The state of the open sheet.
+@MainActor @Observable final class RemoteOpenModel {
+
+    let fields = RemoteConnectionFields()
+    var path = ""
+
+    private(set) var isOpening = false
+    private(set) var errorMessage: String?
+
+    @ObservationIgnored var dismiss: () -> Void = { }
+    let environment: RemoteEnvironment = .current
+    @ObservationIgnored private weak var directory: DirectoryDocument?
+    @ObservationIgnored private var task: Task<Void, Never>?
+
+
+    init(directory: DirectoryDocument?) {
+
+        self.directory = directory
+
+        // In a remote folder window, the folder's connection and path are the likely start.
+        if let identity = directory?.remoteFolderSession?.identity {
+            self.fields.prefill(profileID: identity.profileID, endpoint: identity.endpoint)
+            self.path = RemotePath.appending("", to: identity.path)
+        }
+    }
+
+
+    var recentPaths: [String] {
+
+        self.fields.endpoint.map { RemoteConnectionLibrary.shared.recentPaths(for: $0) } ?? []
+    }
+
+
+    var canOpen: Bool {
+
+        !self.isOpening && self.fields.endpoint != nil && (try? RemotePath.validated(self.path)) != nil
+    }
+
+
+    func open() {
+
+        let endpoint: RemoteEndpoint
+        let path: String
+        do {
+            endpoint = try self.fields.validatedEndpoint()
+            path = try RemotePath.validated(self.path)
+        } catch {
+            self.errorMessage = error.localizedDescription
+            return
+        }
+
+        let profileID = self.fields.profileIDSavingIfAsked(for: endpoint)
+
+        self.errorMessage = nil
+        self.isOpening = true
+        let request = RemoteOpenRequest(profileID: profileID, endpoint: endpoint, path: path)
+        let directory = self.directory
+
+        self.task = Task {
+            defer { self.isOpening = false }
+            do {
+                let window = directory?.windowForSheet
+                let title = String(localized: "RemoteProgress.opening", defaultValue: "Opening “\(RemoteFileIdentity.fileName(of: request.path))”…", table: "Remote",
+                                   comment: "title of the progress sheet of a remote open (%@ is the file name)")
+                try await RemoteProgressSheet.run(title: title, window: window) {
+                    try await RemoteOpenCoordinator.open(request, in: directory, window: window)
+                }
+                self.dismiss()
+            } catch is CancellationError, is RemoteOperationCanceled {
+                return
+            } catch {
+                self.errorMessage = RemoteFolderOpenModel.message(for: error)
+            }
+        }
+    }
+
+
+    func cancel() {
+
+        self.task?.cancel()
+        self.dismiss()
+    }
+}
+
+
+struct RemoteOpenView: View {
+
+    @Bindable var model: RemoteOpenModel
+
+
+    var body: some View {
+
+        VStack(alignment: .leading, spacing: 12) {
+            Text(.init("RemoteOpen.title", defaultValue: "Open Remote File", table: "Remote"))
+                .font(.headline)
+
+            Form {
+                RemoteConnectionSection(fields: self.model.fields, environment: self.model.environment)
+
+                HStack {
+                    TextField(.init("RemoteOpen.path", defaultValue: "Path:", table: "Remote"), text: $model.path, prompt: Text(verbatim: "/var/www/index.html"))
+                    if !self.model.recentPaths.isEmpty {
+                        Menu {
+                            ForEach(self.model.recentPaths, id: \.self) { path in
+                                Button(path) { self.model.path = path }
+                            }
+                        } label: {
+                            Image(systemName: "clock")
+                        }
+                        .menuStyle(.borderlessButton)
+                        .fixedSize()
+                        .help(Text(.init("RemoteOpen.recent", defaultValue: "Recent Paths", table: "Remote")))
+                    }
+                }
+            }
+
+            Text(.init("RemoteOpen.note", defaultValue: "CotEditor connects with your SSH configuration and keys or agent. The server must already be in your known hosts.", table: "Remote"))
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+
+            if let errorMessage = self.model.errorMessage {
+                Text(errorMessage)
+                    .foregroundStyle(.red)
+                    .textSelection(.enabled)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+
+            HStack {
+                if self.model.isOpening {
+                    ProgressView().controlSize(.small)
+                }
+                Spacer()
+                Button(.init("RemoteOpen.cancel", defaultValue: "Cancel", table: "Remote"), role: .cancel) {
+                    self.model.cancel()
+                }
+                .keyboardShortcut(.cancelAction)
+                Button(.init("RemoteOpen.open", defaultValue: "Open", table: "Remote")) {
+                    self.model.open()
+                }
+                .keyboardShortcut(.defaultAction)
+                .disabled(!self.model.canOpen)
+            }
+        }
+        .padding(20)
+        .frame(width: 440)
+        .describesDestination(of: self.model.fields, environment: self.model.environment)
+    }
+}
