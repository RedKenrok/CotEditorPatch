+//
+//  RemoteOperationControl.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// The progress of one remote save or open, and what the user asked of it: to cancel, or to allow more time.
+///
+/// The control travels with the operation as a task-local value (`current`), so the transport reports
+/// transferred bytes and checks for cancellation without every call passing it along.
+///
+/// Cancellation is honored only while nothing the operation does can have reached the target yet.
+/// Before a step that may change the target (a replacing rename, a write in place, a creation), the
+/// operation makes itself not cancellable, and a later request to cancel is ignored: the operation
+/// finishes or is reconciled, and is never reported as undone.
+final class RemoteOperationControl: Sendable {
+
+    enum Phase: Equatable, Sendable {
+
+        case connecting
+        case downloading
+        case checking
+        case uploading
+        case verifying
+        /// The step that changes the target; it cannot be canceled.
+        case committing
+    }
+
+
+    struct Snapshot: Equatable, Sendable {
+
+        var phase: Phase
+        var completedBytes: Int
+        /// The bytes the phase transfers, if known.
+        var totalBytes: Int?
+        var isCancellable: Bool
+        var isCancelRequested: Bool
+        /// When the operation times out, once it has started.
+        var deadline: ContinuousClock.Instant?
+    }
+
+
+    /// The control of the operation the current task belongs to.
+    @TaskLocal static var current: RemoteOperationControl?
+
+    private let state = RemoteLockedValue(Snapshot(phase: .connecting, completedBytes: 0, totalBytes: nil,
+                                                   isCancellable: true, isCancelRequested: false, deadline: nil))
+
+
+    var snapshot: Snapshot  { self.state.withLock { $0 } }
+
+
+    // MARK: Requests
+
+    /// Asks the operation to stop at its next safe point. Ignored once it can no longer stop safely.
+    func requestCancel() {
+
+        self.state.withLock { state in
+            guard state.isCancellable else { return }
+            state.isCancelRequested = true
+        }
+    }
+
+
+    /// Moves the time limit later by the duration.
+    func allowMoreTime(_ duration: Duration) {
+
+        self.state.withLock { state in
+            state.deadline = (state.deadline ?? .now) + duration
+        }
+    }
+
+
+    // MARK: Reporting
+
+    /// Starts a phase. Its byte count starts at zero.
+    func begin(_ phase: Phase, totalBytes: Int? = nil) {
+
+        self.state.withLock { state in
+            state.phase = phase
+            state.completedBytes = 0
+            state.totalBytes = totalBytes
+        }
+    }
+
+
+    /// Sets how many bytes the current phase transfers, if it did not know yet.
+    func expect(totalBytes: Int) {
+
+        self.state.withLock { state in
+            if state.totalBytes == nil {
+                state.totalBytes = totalBytes
+            }
+        }
+    }
+
+
+    func didTransfer(_ count: Int) {
+
+        self.state.withLock { $0.completedBytes += count }
+    }
+
+
+    /// Ends the time in which the operation may stop. A request to cancel made before is still honored
+    /// by the check that comes right before this.
+    func disallowCancellation() {
+
+        self.state.withLock { state in
+            state.isCancellable = false
+            state.isCancelRequested = false
+        }
+    }
+
+
+    /// Throws if the user asked to cancel and the operation may still stop.
+    func checkCancellation() throws(RemoteOperationCanceled) {
+
+        let canceled = self.state.withLock { $0.isCancellable && $0.isCancelRequested }
+
+        if canceled { throw RemoteOperationCanceled() }
+    }
+
+
+    // MARK: Time Limit
+
+    /// Waits until the operation's time limit, which starts now and may be extended meanwhile, and throws.
+    ///
+    /// - Throws: `RemoteConnectionError.timedOut` when the limit is reached, or `CancellationError`.
+    func waitForDeadline(startingWith timeout: Duration) async throws -> Never {
+
+        self.state.withLock { state in
+            if state.deadline == nil {
+                state.deadline = .now + timeout
+            }
+        }
+        while true {
+            let deadline = self.state.withLock { $0.deadline } ?? .now
+            guard ContinuousClock.now < deadline else { throw RemoteConnectionError.timedOut }
+            try await Task.sleep(until: min(deadline, .now + .milliseconds(250)))
+        }
+    }
+}
+
+
+/// The user canceled a remote operation at a point where it had changed nothing on the server.
+struct RemoteOperationCanceled: Error, Equatable { }
