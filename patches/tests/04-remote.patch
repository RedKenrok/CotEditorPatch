+    @Test(.timeLimit(.minutes(1))) func moreTimeKeepsASlowSaveGoing() async throws {
+
+        for allowsMoreTime in [false, true] {
+            let bed = await RemoteTestBed(limits: RemoteLimits(operationTimeout: .milliseconds(400)))
+            await bed.server.addFile("/srv/a.txt", "old")
+            let document = try await bed.open("/srv/a.txt")
+            document.replaceText(with: "new")
+            let gate = FakeGate()
+            await bed.server.setHook { request in
+                if case .write(let path, _, _) = request, path.contains(".cot-") { await gate.wait() }
+                return .proceed
+            }
+            let control = RemoteOperationControl()
+            let save = Task { await RemoteOperationControl.$current.withValue(control) { await document.saveCoordinator.perform(.save) } }
+            try await waitUntil { await gate.hasArrived }
+            if allowsMoreTime {
+                control.allowMoreTime(.seconds(5))
+            }
+            try await Task.sleep(for: .milliseconds(700))
+            await gate.open()
+
+            let outcome = await save.value
+            if allowsMoreTime {
+                #expect(outcome == .saved)
+                #expect(await bed.server.contents(of: "/srv/a.txt") == "new")
+            } else {
+                #expect(outcome != .saved, "without more time the save ends at the limit")
+                #expect(await bed.server.contents(of: "/srv/a.txt") == "old")
+            }
+            await bed.tearDown()
+        }
+    }
