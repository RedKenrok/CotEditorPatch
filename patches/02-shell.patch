+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// Stops and reaps the processes of one terminal session.
+///
+/// Every signal here targets a process group that is provably ours. The shell is spawned as the
+/// leader of a new session, so its process group ID equals its PID. As long as the shell has not been
+/// reaped, the kernel keeps that PID reserved (a zombie still holds it), so neither the PID nor the
+/// group ID can belong to an unrelated process. Once the shell is reaped, nothing is signaled again.
+///
+/// A job the user deliberately detached (for example with `nohup`, `disown` or `setsid`) leaves the
+/// session's control and may outlive the terminal. That is intended; no attempt is made to hunt down
+/// every descendant.
+struct TerminalProcessReaper: Sendable {
+
+    /// The shell's PID, which is also its process group and session ID.
+    let shell: pid_t
+
+    /// The terminal's foreground process group when shutdown began, if different from the shell's.
+    let foreground: pid_t?
+
+
+    init(shell: pid_t, foreground: pid_t) {
+
+        self.shell = shell
+        self.foreground = (foreground > 1 && foreground != shell) ? foreground : nil
+    }
+
+
+    /// Asks the session to end, the same way closing a terminal window does.
+    ///
+    /// SIGHUP makes interactive shells exit and pass the hangup on to their jobs. SIGCONT lets a
+    /// stopped job receive it.
+    func hangUp() {
+
+        for group in [self.foreground, self.shell].compactMap(\.self) {
+            killpg(group, SIGHUP)
+            killpg(group, SIGCONT)
+        }
+    }
+
+
+    /// Waits for the shell to exit, then forcibly stops what is left of the session if it has not.
+    ///
+    /// - Parameter grace: How long the session may take to exit on its own.
+    /// - Returns: `true` if the shell exited within the grace period.
+    @discardableResult func reap(grace: Duration) -> Bool {
+
+        let deadline = ContinuousClock.now + grace
+        repeat {
+            if self.reapIfExited() { return true }
+            usleep(10_000)
+        } while ContinuousClock.now < deadline
+
+        if self.reapIfExited() { return true }
+
+        // Still unreaped, so the IDs checked below cannot have been reused.
+        if let foreground, getsid(foreground) == self.shell {
+            killpg(foreground, SIGKILL)
+        }
+        killpg(self.shell, SIGKILL)
+
+        var status: Int32 = 0
+        while waitpid(self.shell, &status, 0) == -1, errno == EINTR {}
+
+        return false
+    }
+
+
+    /// Reaps the shell without blocking.
+    ///
+    /// - Returns: `true` if the shell has been reaped, by this call or before it.
+    private func reapIfExited() -> Bool {
+
+        var status: Int32 = 0
+        let result = waitpid(self.shell, &status, WNOHANG)
+
+        // ECHILD: already reaped elsewhere, so it must not be signaled any more.
+        return result == self.shell || (result == -1 && errno == ECHILD)
+    }
+}
diff --git a/CotEditor/Sources/Terminal/TerminalPrompts.swift b/CotEditor/Sources/Terminal/TerminalPrompts.swift
