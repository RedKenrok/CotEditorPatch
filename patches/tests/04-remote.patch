+    // MARK: Restoration
+
+    @Test(.timeLimit(.minutes(1))) func remoteTabsComeBackOfflineInTheirPlace() async throws {
+
+        try await self.withRemote { directory, urls, bed in
+            await bed.server.addFile("/srv/r.txt", "remote")
+            #expect(await directory.openDocument(at: urls[0]))
+            let document = try await bed.openInDirectory("/srv/r.txt", directory)
+            #expect(await directory.openDocument(at: urls[1]))
+            document.replaceText(with: "unsent")
+            #expect(await document.flushRecovery())
+            directory.selectDocument(document)
+            let ids = directory.tabState.entries.map(\.id)
+
+            let data = self.encodeRestorableState(of: directory)
+            directory.close()
+            try await bed.waitUntilReleased(document.documentID)
+            await bed.server.clearLog()
+
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                try await self.wait { restored.tabDocuments.count == 3 }
+                #expect(restored.tabState.entries.map(\.id) == ids)
+                let remote = try #require(restored.tabDocuments[1] as? RemoteDocument)
+                #expect(restored.activeFileDocument === remote)
+                #expect(remote.textStorage.string == "unsent")
+                #expect(remote.isDocumentEdited)
+                #expect(await bed.server.log.isEmpty, "restoring does not connect")
+                remote.close()
+            }
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aTabWhoseRecoveryIsGoneBecomesAPlaceholder() async throws {
+
+        try await self.withRemote { directory, urls, bed in
+            await bed.server.addFile("/srv/r.txt", "remote")
+            let document = try await bed.openInDirectory("/srv/r.txt", directory)
+            let record = try #require(document.record?.directory)
+            let data = self.encodeRestorableState(of: directory)
+            directory.close()
+            // closing a clean document removes its record by itself
+            try await self.wait { !FileManager.default.fileExists(atPath: record.path(percentEncoded: false)) }
+            await bed.server.clearLog()
+
+            try await self.withRestoredDirectory(at: urls[0].deletingLastPathComponent(), from: data) { restored in
+                let placeholder = try #require(restored.tabDocuments.first as? RemoteDocument)
+                #expect(placeholder.role == .placeholder)
+                #expect(!placeholder.isEditable)
+                #expect(placeholder.displayName.contains("r.txt"))
+                #expect(await bed.server.log.isEmpty, "nothing is downloaded until the user reconnects")
+
+                let id = try #require(restored.tabState.entry(for: placeholder)?.id)
+                await RemoteOpenCoordinator.reconnect(placeholder)
+                let reconnected = try #require(restored.tabDocuments.first as? RemoteDocument)
+                #expect(reconnected.role == .editor)
+                #expect(reconnected.textStorage.string == "remote")
+                #expect(restored.tabState.entries.first?.id == id, "the tab keeps its place and identity")
+                reconnected.close()
+            }
+        }
+    }
+
