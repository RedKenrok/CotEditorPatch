+//
+//  RemoteConnectionPool.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// The open connections, one per endpoint, destination and role, shared by the documents and folder
+/// windows that use them.
+///
+/// A connection for files runs one operation at a time: a save's steps never interleave with another
+/// document's operation. A connection for browsing runs a few folder listings at once. File operations
+/// and listings never share a connection, so a long listing cannot delay a save, and a listing that
+/// fails or ends cannot interrupt one.
+///
+/// A connection that fails is dropped, and the next operation connects anew; the generation of a
+/// connection keeps a late result from a dropped one from being mistaken for the current one's.
+/// Unused connections close after a while.
+actor RemoteConnectionPool {
+
+    /// What a connection is used for.
+    enum Role: Hashable, Sendable {
+
+        /// Opening and saving files, and changing folders.
+        case files
+        /// Listing folders.
+        case browsing
+    }
+
+
+    /// Makes a connection. Tests replace it with one to a fake server.
+    typealias Connector = @Sendable (RemoteEndpoint, RemoteLimits) async throws -> any RemoteTransport
+
+    /// Evaluates the SSH configuration of an endpoint. Tests replace it.
+    typealias Evaluator = @Sendable (RemoteEndpoint, RemoteLimits) async throws -> RemoteSSHConfiguration
+
+    /// Asks the user about the key of a server that is not known yet, and adds it if the user trusts it.
+    ///
+    /// - Returns: Whether the key was added, so that connecting again can succeed.
+    typealias HostKeyReviewer = @Sendable (RemoteEndpoint, RemoteLimits) async throws -> Bool
+
+
+    private struct Key: Hashable {
+
+        var endpoint: RemoteEndpoint
+        var destination: RemoteDestination
+        var role: Role
+    }
+
+
+    private final class Connection: Sendable {
+
+        let transport: any RemoteTransport
+        let generation: Int
+        let lock: RemoteAsyncLock
+
+
+        init(transport: any RemoteTransport, generation: Int, capacity: Int) {
+
+            self.transport = transport
+            self.generation = generation
+            self.lock = RemoteAsyncLock(capacity: capacity)
+        }
+    }
+
+
+    static let shared = RemoteConnectionPool()
+
+    private(set) var limits = RemoteLimits()
+    private var connector: Connector = { endpoint, limits in try await RemoteSFTPTransport.connect(to: endpoint, limits: limits) }
+    private var evaluator: Evaluator = { endpoint, limits in try await RemoteSSHProcess.evaluateConfiguration(for: endpoint, limits: limits) }
+    private var hostKeyReviewer: HostKeyReviewer?
+    private var connections: [Key: Connection] = [:]
+    private var connecting: [Key: Task<Connection, any Error>] = [:]
+    private var idleTasks: [Key: Task<Void, Never>] = [:]
+    private var generation = 0
+
+
+    // MARK: Configuration
+
+    /// Replaces how connections are made and configurations evaluated, and closes every connection.
+    func configure(limits: RemoteLimits, connector: Connector? = nil, evaluator: Evaluator? = nil) async {
+
+        await self.closeAll()
+        self.limits = limits
+        self.connector = connector ?? { endpoint, limits in try await RemoteSFTPTransport.connect(to: endpoint, limits: limits) }
+        self.evaluator = evaluator ?? { endpoint, limits in try await RemoteSSHProcess.evaluateConfiguration(for: endpoint, limits: limits) }
+    }
+
+
+    /// Sets who is asked about the key of a server that is not known yet; without one, such a connection fails.
+    func setHostKeyReviewer(_ reviewer: HostKeyReviewer?) {
+
+        self.hostKeyReviewer = reviewer
+    }
+
+
+    // MARK: Public Methods
+
+    /// The effective configuration of the endpoint, as the user's SSH configuration makes it.
+    func configuration(for endpoint: RemoteEndpoint) async throws -> RemoteSSHConfiguration {
+
+        let configuration = try await self.evaluator(endpoint, self.limits)
+        try configuration.checkSupported()
+
+        return configuration
+    }
+
+
+    /// Where the endpoint's connection goes, according to the user's SSH configuration.
+    ///
+    /// - Throws: `RemoteConnectionError.proxyUnsupported` for configurations with a jump host or proxy command.
+    func destination(for endpoint: RemoteEndpoint) async throws -> RemoteDestination {
+
+        let configuration = try await self.evaluator(endpoint, self.limits)
+        try configuration.checkSupported()
+
+        return configuration.destination
+    }
+
+
+    /// Runs an operation on the connection to the destination, alone, connecting first if needed.
+    ///
+    /// A connection error or protocol error drops the connection, since its state is then unknown.
+    /// Errors the server reported leave it open.
+    func withConnection<T: Sendable>(to endpoint: RemoteEndpoint, destination: RemoteDestination, _ operation: @escaping @Sendable (any RemoteFileTransport) async throws -> T) async throws -> T {
+
+        try await self.run(on: Key(endpoint: endpoint, destination: destination, role: .files), operation)
+    }
+
+
+    /// Runs an operation that only reads, trying it again on a new connection if the connection was lost.
+    ///
+    /// Only an operation that changes nothing on the server may be repeated: after a lost connection,
+    /// whether a write arrived is unknown, so writes go through `withConnection` and are never retried.
+    /// Errors the server reported, timeouts and failures to connect are not retried either.
+    func withReadingConnection<T: Sendable>(to endpoint: RemoteEndpoint, destination: RemoteDestination, _ operation: @escaping @Sendable (any RemoteFileTransport) async throws -> T) async throws -> T {
+        try await self.retryingLostConnections {
+            try await self.withConnection(to: endpoint, destination: destination, operation)
+        }
+    }
+
+
+    /// Runs an operation that changes folders, such as creating or renaming an item, on the connection
+    /// for files, alone, connecting first if needed.
+    ///
+    /// It waits for the file operation under way and is never tried again, as a write through `withConnection`.
+    func withFolderEditingConnection<T: Sendable>(to endpoint: RemoteEndpoint, destination: RemoteDestination, _ operation: @escaping @Sendable (any RemoteTransport) async throws -> T) async throws -> T {
+
+        try await self.run(on: Key(endpoint: endpoint, destination: destination, role: .files), operation)
+    }
+
+
+    /// Runs a folder operation on the destination's browsing connection, connecting first if needed.
+    ///
+    /// Browsing only reads, so an operation is tried again on a new connection if the connection was lost,
+    /// as `withReadingConnection` does. Several operations may run at once.
+    func withBrowsingConnection<T: Sendable>(to endpoint: RemoteEndpoint, destination: RemoteDestination, _ operation: @escaping @Sendable (any RemoteDirectoryTransport) async throws -> T) async throws -> T {
+        try await self.retryingLostConnections {
+            try await self.run(on: Key(endpoint: endpoint, destination: destination, role: .browsing), operation)
+        }
+    }
+
+
+    /// Closes every connection.
+    func closeAll() async {
+
+        let connections = self.connections.values
+        self.connections.removeAll()
+        for task in self.connecting.values {
+            task.cancel()
+        }
+        self.connecting.removeAll()
+
+        for task in self.idleTasks.values {
+            task.cancel()
+        }
+        self.idleTasks.removeAll()
+        for connection in connections {
+            await connection.transport.disconnect()
+        }
+    }
+
+
+    /// Whether a connection of the role to the destination is open, for tests that check which connection an operation used.
+    func hasConnection(to endpoint: RemoteEndpoint, destination: RemoteDestination, role: Role) -> Bool {
+
+        self.connections[Key(endpoint: endpoint, destination: destination, role: role)] != nil
+    }
+
+
+    // MARK: Private Methods
+
+    /// Runs an operation on the connection of the key, connecting first if needed.
+    ///
+    /// A connection error or protocol error drops the connection, since its state is then unknown.
+    /// Errors the server reported leave it open.
+    private func run<T: Sendable>(on key: Key, _ operation: @escaping @Sendable (any RemoteTransport) async throws -> T) async throws -> T {
+
+        let connection = try await self.connection(for: key)
+
+        await connection.lock.lock()
+        self.idleTasks.removeValue(forKey: key)?.cancel()
+        defer {
+            Task { await self.release(connection, key: key) }
+        }
+
+        let transport = connection.transport
+        let timeout = self.limits.operationTimeout
+        do {
+            return try await withThrowingTaskGroup(of: T.self) { group in
+                group.addTask { try await operation(transport) }
+                group.addTask {
+                    // The user can allow an operation more time through its control.
+                    if let control = RemoteOperationControl.current {
+                        try await control.waitForDeadline(startingWith: timeout)
+                    }
+                    try await Task.sleep(for: timeout)
+                    throw RemoteConnectionError.timedOut
+                }
+                defer { group.cancelAll() }
+                return try await group.next()!
+            }
+        } catch {
+            // A cancellation stops between requests, so the session is still in order.
+            if !(error is RemoteSFTPError || error is RemoteTransferError || error is RemoteOperationCanceled) {
+                await self.drop(connection, key: key)
+            }
+            throw error
+        }
+    }
+
+
+    /// Runs an operation again, up to the retry limit, each time it fails because the connection was lost.
+    private func retryingLostConnections<T: Sendable>(_ operation: () async throws -> T) async throws -> T {
+
+        var retries = self.limits.readRetries
+        while true {
+            do {
+                return try await operation()
+            } catch let error as RemoteConnectionError where error == .connectionLost && retries > 0 && !Task.isCancelled {
+                retries -= 1
+            }
+        }
+    }
+
+
+    private func connection(for key: Key) async throws -> Connection {
+
+        if let connection = self.connections[key], await !connection.transport.isDisconnected {
+            return connection
+        }
+        if let task = self.connecting[key] {
+            return try await task.value
+        }
+
+        self.generation += 1
+        let generation = self.generation
+        let connector = self.connector
+        let limits = self.limits
+        let capacity = (key.role == .files) ? 1 : max(limits.browsingRequestsInFlight, 1)
+        let reviewer = self.hostKeyReviewer
+        let task = Task {
+            do {
+                return Connection(transport: try await connector(key.endpoint, limits), generation: generation, capacity: capacity)
+            } catch let error as RemoteConnectionError where error.isUnknownHostKey {
+                // A key the user trusts now is checked strictly by the next attempt, like any known key.
+                guard let reviewer, try await reviewer(key.endpoint, limits) else { throw error }
+                return Connection(transport: try await connector(key.endpoint, limits), generation: generation, capacity: capacity)
+            }
+        }
+        self.connecting[key] = task
+        defer { self.connecting[key] = nil }
+
+        let connection = try await task.value
+        self.connections[key] = connection
+
+        return connection
+    }
+
+
+    private func release(_ connection: Connection, key: Key) async {
+
+        await connection.lock.unlock()
+
+        guard self.connections[key]?.generation == connection.generation else { return }
+
+        let idleTimeout = self.limits.idleTimeout
+        self.idleTasks[key]?.cancel()
+        self.idleTasks[key] = Task {
+            try? await Task.sleep(for: idleTimeout)
+            guard !Task.isCancelled else { return }
+            await self.closeIdle(connection, key: key)
+        }
+    }
+
+
+    private func closeIdle(_ connection: Connection, key: Key) async {
+
+        guard
+            self.connections[key]?.generation == connection.generation,
+            await connection.lock.isFree
+        else { return }
+
+        self.connections[key] = nil
+        await connection.transport.disconnect()
+    }
+
+
+    private func drop(_ connection: Connection, key: Key) async {
+
+        if self.connections[key]?.generation == connection.generation {
+            self.connections[key] = nil
+        }
+        await connection.transport.disconnect()
+    }
+}
+
+
+/// A lock for asynchronous code that grants access in the order it was asked for, to one holder or
+/// to up to a given number of holders at once.
+actor RemoteAsyncLock {
+
+    private let capacity: Int
+    private var holders = 0
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+
+
+    init(capacity: Int = 1) {
+
+        self.capacity = capacity
+    }
+
+
+    var isFree: Bool {
+
+        self.holders == 0 && self.waiters.isEmpty
+    }
+
+
+    func lock() async {
+
+        guard self.holders >= self.capacity else {
+            self.holders += 1
+            return
+        }
+
+        await withCheckedContinuation { self.waiters.append($0) }
+    }
+
+
+    func unlock() {
+
+        if self.waiters.isEmpty {
+            self.holders -= 1
+        } else {
+            // The place passes straight to the next waiter.
+            self.waiters.removeFirst().resume()
+        }
+    }
+}
