+
+import AppKit
+import SwiftUI
+
+
+/// The document inspector's section about a remote file: where it is and whether the server has the editor's text.
+struct RemoteInspectorView: View {
+
+    var document: RemoteDocument
+
+    @State private var model = RemoteInspectorModel()
+    @State private var isExpanded = true
+
+
+    var body: some View {
+
+        DisclosureGroup(.init("RemoteInspector.title", defaultValue: "Remote File", table: "Remote", comment: "section title in inspector"), isExpanded: $isExpanded) {
+            Form {
+                LabeledContent(.init("RemoteInspector.server", defaultValue: "Server", table: "Remote", comment: "label in document inspector")) {
+                    Text(self.model.connection)
+                        .textSelection(.enabled)
+                }
+                LabeledContent(.init("RemoteInspector.path", defaultValue: "Path", table: "Remote", comment: "label in document inspector")) {
+                    Text(self.model.path)
+                        .lineLimit(5)
+                        .truncationMode(.middle)
+                        .textSelection(.enabled)
+                }
+                LabeledContent(.init("RemoteInspector.status", defaultValue: "Status", table: "Remote", comment: "label in document inspector")) {
+                    Text(self.model.status)
+                }
+                if let size = self.model.confirmedSize {
+                    LabeledContent(.init("RemoteInspector.confirmedSize", defaultValue: "Size on Server", table: "Remote", comment: "label in document inspector"), value: size)
+                }
+                if !self.model.retainedTemporaryPaths.isEmpty {
+                    LabeledContent(.init("RemoteInspector.retained", defaultValue: "Left on Server", table: "Remote", comment: "label for temporary files a save could not remove")) {
+                        VStack(alignment: .trailing) {
+                            ForEach(self.model.retainedTemporaryPaths, id: \.self) { path in
+                                Text(path).textSelection(.enabled)
+                            }
+                        }
+                    }
+                }
+                if self.model.isPlaceholder {
+                    Button(String(localized: "RemoteMenu.reconnect", defaultValue: "Reconnect", table: "Remote", comment: "menu item label")) {
+                        Task { await RemoteOpenCoordinator.reconnect(self.document) }
+                    }
+                }
+            }
+        }
+        .onChange(of: ObjectIdentifier(self.document), initial: true) {
+            self.model.observe(self.document)
+        }
+    }
+}
+
+
+/// What the inspector shows, kept up to date with the document.
+@MainActor @Observable private final class RemoteInspectorModel {
+
+    private(set) var connection = ""
+    private(set) var path = ""
+    private(set) var status = ""
+    private(set) var confirmedSize: String?
+    private(set) var retainedTemporaryPaths: [String] = []
+    private(set) var isPlaceholder = false
+
+    @ObservationIgnored private var observers: [NotificationCenter.ObservationToken] = []
+
+
+    func observe(_ document: RemoteDocument) {
+
+        self.observers = [
+            NotificationCenter.default.addObserver(of: document, for: RemoteDocument.DidChangeStateMessage.self) { [weak self, weak document] _ in
+                guard let document else { return }
+                self?.update(from: document)
+            },
+            NotificationCenter.default.addObserver(of: document, for: Document.DidUpdateChangeMessage.self) { [weak self, weak document] _ in
+                guard let document else { return }
+                self?.update(from: document)
+            },
+        ]
+        self.update(from: document)
+    }
+
+
+    private func update(from document: RemoteDocument) {
+
+        self.connection = document.identity.connectionName
+        self.path = document.identity.path
+        self.isPlaceholder = document.role == .placeholder
+        self.confirmedSize = document.manifest?.baseline.attributes?.size
+            .map { Int64($0).formatted(.byteCount(style: .file, includesActualByteCount: true)) }
+        self.retainedTemporaryPaths = document.manifest?.retainedTemporaryPaths ?? []
+
+        self.status = if document.role == .placeholder {
+            String(localized: "RemoteInspector.status.notDownloaded", defaultValue: "Not downloaded", table: "Remote")
+        } else if document.role == .remoteVersion {
+            String(localized: "RemoteInspector.status.remoteVersion", defaultValue: "Read-only copy of the server’s version", table: "Remote")
+        } else if document.saveCoordinator.isBusy {
+            String(localized: "RemoteInspector.status.saving", defaultValue: "Saving to the server…", table: "Remote")
+        } else if document.manifest?.operation?.mayHaveChangedTarget == true {
+            String(localized: "RemoteInspector.status.unresolved", defaultValue: "Outcome of the last save unknown", table: "Remote")
+        } else if document.recoveryError != nil {
+            String(localized: "RemoteInspector.status.unprotected", defaultValue: "Newer changes not protected on this Mac", table: "Remote")
+        } else if document.isDocumentEdited {
+            String(localized: "RemoteInspector.status.unsent", defaultValue: "Changes not sent", table: "Remote")
+        } else {
+            String(localized: "RemoteInspector.status.saved", defaultValue: "Saved on the server", table: "Remote")
+        }
+    }
+}
