+    @Test(.timeLimit(.minutes(1))) func outputCannotWriteTheClipboard() async throws {
+        
+        let pasteboard = NSPasteboard.general
+        let saved = pasteboard.string(forType: .string)
+        defer {
+            pasteboard.clearContents()
+            if let saved { pasteboard.setString(saved, forType: .string) }
+        }
+        pasteboard.clearContents()
+        pasteboard.setString("copied by the user", forType: .string)
+        
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        var didExit = false
+        engine.onExit = { _ in didExit = true }
+        
+        // OSC 52 asks the terminal to put "hello" (base64) on the clipboard.
+        try engine.start(self.shell("printf '\\033]52;c;aGVsbG8=\\007'; echo DONE", in: FileManager.default.temporaryDirectory))
+        try await self.wait { didExit && engine.bufferText.contains("DONE") }
+        #expect(pasteboard.string(forType: .string) == "copied by the user")
+    }
+    
+    
+    @Test(.timeLimit(.minutes(1))) func outputCannotReadTheClipboard() async throws {
+        
+        let pasteboard = NSPasteboard.general
+        let saved = pasteboard.string(forType: .string)
+        defer {
+            pasteboard.clearContents()
+            if let saved { pasteboard.setString(saved, forType: .string) }
+        }
+        pasteboard.clearContents()
+        pasteboard.setString("secret", forType: .string)
+        
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        var didExit = false
+        engine.onExit = { _ in didExit = true }
+        
+        // OSC 52 with "?" asks the terminal to send the clipboard back as input. The program waits a
+        // second for any reply and dumps what arrived.
+        try engine.start(self.shell("stty raw -echo min 0 time 10; printf '\\033]52;c;?\\007'; head -c 64 | od -An -c; stty sane; echo END",
+                                    in: FileManager.default.temporaryDirectory))
+        try await self.wait(timeout: .seconds(10)) { didExit && engine.bufferText.contains("END") }
+        let text = engine.bufferText
+        #expect(!text.contains("5   2"), "no clipboard reply reached the program")
+        #expect(!text.contains("c   2   V   j"), "the clipboard contents never reach the program")
+    }
