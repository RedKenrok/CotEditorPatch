+    @Test(.timeLimit(.minutes(1))) func terminalsShareTabOrderAndSelection() async throws {
+
+        try await self.withTerminals { directory, urls, _, _ in
+            #expect(await directory.openDocument(at: urls[0]))
+            let terminal = try #require(directory.openTerminalTab())
+            #expect(await directory.openDocument(at: urls[1]))
+            let entries = directory.tabState.entries
+            #expect(entries.count == 3)
+            #expect(entries[1].terminalSession === terminal)
+            #expect(directory.tabDocuments.map(\.fileURL) == [urls[0], urls[1]], "terminals are not documents")
+
+            directory.selectTab(id: entries[1].id)
+            #expect(directory.activeTerminalSession === terminal)
+            #expect(directory.activeFileDocument == nil)
+            #expect(directory.currentDocument == nil)
+
+            directory.selectAdjacentTab(by: 1)
+            #expect(directory.activeFileDocument?.fileURL == urls[1])
+            directory.selectAdjacentTab(by: -1)
+            #expect(directory.activeTerminalSession === terminal)
+            directory.selectAdjacentTab(by: -1)
+            #expect(directory.activeFileDocument?.fileURL == urls[0])
+            #expect(directory.currentDocument?.fileURL == urls[0])
+        }
+    }
