+    @Test(.timeLimit(.minutes(1))) func selectingATerminalMovesKeyboardFocusIntoIt() async throws {
+        
+        try await self.withTerminals(makesWindow: true) { directory, urls, engines, _ in
+            engines.makeView = { FocusableTerminalView() }
