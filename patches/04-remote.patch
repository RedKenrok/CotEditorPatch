+import AppKit
+import SwiftUI
+
+
+/// Presents the window that asks which remote folder to open.
+@MainActor enum RemoteFolderOpenPanel {
+
+    private static var windows: [NSWindow] = []
+
+
+    /// Shows the window.
+    ///
+    /// - Parameters:
+    ///   - profileID: The saved connection to start with, if any.
+    ///   - endpoint: The host to start with when there is no saved connection.
+    ///   - path: The folder path to fill in.
+    ///   - requiresConnection: Whether the user must choose a connection first, because the saved one is gone.
+    static func show(profileID: UUID? = nil, endpoint: RemoteEndpoint? = nil, path: String? = nil, requiresConnection: Bool = false) {
+
+        // Windows closed with their close button are let go here.
+        self.windows.removeAll { !$0.isVisible }
+
+        let model = RemoteFolderOpenModel(environment: .current)
+        model.prefill(profileID: profileID, endpoint: endpoint, path: path, requiresConnection: requiresConnection)
+
+        let controller = NSHostingController(rootView: RemoteFolderOpenView(model: model))
+        controller.sizingOptions = .preferredContentSize
+
+        let window = NSWindow(contentViewController: controller)
+        window.title = String(localized: "RemoteFolderOpen.windowTitle", defaultValue: "Open Remote Folder", table: "Remote")
+        window.styleMask = [.titled, .closable]
+        window.isReleasedWhenClosed = false
+        model.dismiss = { [weak window] in
+            window?.close()
+            self.windows.removeAll { $0 === window }
+        }
+        self.windows.append(window)
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+    }
+}
+
+
+/// The state of the Open Remote Folder window.
+@MainActor @Observable final class RemoteFolderOpenModel {
+
+    let fields = RemoteConnectionFields()
+
+    /// The folder to open; empty for the server's starting folder.
+    var path = ""
+
+    /// The folder browser, while the user browses.
+    private(set) var picker: RemoteFolderPickerModel?
+
+    private(set) var isOpening = false
+    private(set) var errorMessage: String?
+
+    /// Set when the saved connection of a recent folder is gone, so that a connection must be chosen.
+    private(set) var connectionHint: String?
+
+    @ObservationIgnored var dismiss: () -> Void = { }
+    let environment: RemoteEnvironment
+    @ObservationIgnored private var task: Task<Void, Never>?
+
+
+    init(environment: RemoteEnvironment) {
+
+        self.environment = environment
+    }
+
+
+    func prefill(profileID: UUID?, endpoint: RemoteEndpoint?, path: String?, requiresConnection: Bool) {
+
+        if !requiresConnection {
+            self.fields.prefill(profileID: profileID, endpoint: endpoint)
+        }
+        if requiresConnection {
+            self.connectionHint = String(localized: "RemoteFolderOpen.missingConnection",
+                                         defaultValue: "The saved connection of this folder no longer exists. Choose a connection.", table: "Remote")
+        }
+        self.path = path ?? ""
+    }
+
+
+    var recentPaths: [String] {
+
+        self.fields.endpoint.map { RemoteConnectionLibrary.shared.recentFolderPaths(for: $0) } ?? []
+    }
+
+
+    var canOpen: Bool {
+
+        !self.isOpening && self.fields.endpoint != nil && (self.trimmedPath.isEmpty || (try? RemotePath.validated(self.trimmedPath)) != nil)
+    }
+
+
+    var canBrowse: Bool {
+
+        !self.isOpening && self.fields.endpoint != nil
+    }
+
+
+    private var trimmedPath: String {
+
+        self.path.trimmingCharacters(in: .whitespaces)
+    }
+
+
+    /// Opens the folder at the typed path, or the server's starting folder if none is typed.
+    func open() {
+
+        guard let request = self.makeRequest(path: self.trimmedPath.isEmpty ? RemoteFolderRequest.startingFolder : self.trimmedPath) else { return }
+
+        self.open(request)
+    }
+
+
+    /// Starts browsing the server, at the last folder chosen for the connection or else the starting folder.
+    func browse() {
+
+        guard let endpoint = self.validatedEndpoint() else { return }
+
+        self.errorMessage = nil
+        let picker = RemoteFolderPickerModel(profileID: self.fields.selectedProfileID, endpoint: endpoint, environment: self.environment)
+        picker.onOpen = { [weak self] path in
+            guard let self, let request = self.makeRequest(path: path) else { return }
+            self.open(request)
+        }
+        picker.onCancel = { [weak self] in
+            self?.picker = nil
+        }
+        self.picker = picker
+
+        let lastPath = (try? RemotePath.validated(self.path)) ?? RemoteConnectionLibrary.shared.recentFolderPaths(for: endpoint).first
+        picker.start(at: lastPath)
+    }
+
+
+    func cancel() {
+
+        self.task?.cancel()
+        self.picker?.cancel()
+        self.dismiss()
+    }
+
+
+    // MARK: Private Methods
+
+    private func validatedEndpoint() -> RemoteEndpoint? {
+
+        do {
+            return try self.fields.validatedEndpoint()
+        } catch {
+            self.errorMessage = error.localizedDescription
+            return nil
+        }
+    }
+
+
+    private func makeRequest(path: String) -> RemoteFolderRequest? {
+
+        guard let endpoint = self.validatedEndpoint() else { return nil }
+        let validatedPath: String
+        do {
+            validatedPath = (path == RemoteFolderRequest.startingFolder) ? path : try RemotePath.validated(path)
+        } catch {
+            self.errorMessage = error.localizedDescription
+            return nil
+        }
+
+        return RemoteFolderRequest(profileID: self.fields.profileIDSavingIfAsked(for: endpoint), endpoint: endpoint, path: validatedPath)
+    }
+
+
+    private func open(_ request: RemoteFolderRequest) {
+
+        self.errorMessage = nil
+        self.isOpening = true
+        let environment = self.environment
+
+        self.task?.cancel()
+        self.task = Task {
+            defer { self.isOpening = false }
+            do {
+                try await RemoteFolderOpenCoordinator.open(request, environment: environment)
+                self.dismiss()
+            } catch is CancellationError, is RemoteOperationCanceled {
+                return
+            } catch {
+                // The fields stay as they are, for correcting them.
+                self.errorMessage = Self.message(for: error)
+                self.picker?.showError(self.errorMessage)
+            }
+        }
+    }
+
+
+    static func message(for error: any Error) -> String {
+
+        [error.localizedDescription, (error as? any LocalizedError)?.recoverySuggestion, (error as? RemoteConnectionError)?.diagnostics]
+            .compactMap { $0 }
+            .joined(separator: "\n")
+    }
+}
+
+
+/// A folder browser on a server, for choosing the folder to open.
+///
+/// It lists one folder at a time. Files are shown so that the user can recognize a folder by its
+/// contents, but cannot be chosen. Entering an entry whose type is unknown, or a link, resolves it
+/// first; only a confirmed folder is entered. Open Folder always opens the folder that is shown.
+@MainActor @Observable final class RemoteFolderPickerModel {
+
+    struct Entry: Identifiable, Equatable {
+
+        enum State: Equatable {
+
+            case ready
+            case resolving
+            case notAFolder
+            case failed(String)
+        }
+
+
+        var id: String  { self.path }
+        var name: String
+        var path: String
+        var kind: RemoteDirectoryNode.Kind
+        var state: State = .ready
+
+
+        /// Whether the entry is known to be a folder.
+        var isFolder: Bool  { self.kind == .directory }
+
+        /// Whether the entry might be a folder, and entering it resolves it.
+        var mayBeFolder: Bool  { (self.kind == .directory || self.kind == .symbolicLink || self.kind == .unknown) && self.state != .notAFolder }
+
+        var isHidden: Bool  { self.name.hasPrefix(".") }
+    }
+
+
+    let endpoint: RemoteEndpoint
+    let profileID: UUID?
+
+    /// The canonical path of the folder that is shown.
+    private(set) var currentPath: String?
+    private(set) var entries: [Entry] = []
+    private(set) var limit: RemoteListingLimit?
+    private(set) var isLoading = false
+    private(set) var errorMessage: String?
+
+    /// Whether the error came from the last folder of the connection, so that the starting folder can be offered.
+    private(set) var offersStartingFolder = false
+
+    var showsHiddenFiles = false
+    var pathField = ""
+    var selection: Entry.ID?
+
+    @ObservationIgnored var onOpen: (String) -> Void = { _ in }
+    @ObservationIgnored var onCancel: () -> Void = { }
+    @ObservationIgnored private let environment: RemoteEnvironment
+    @ObservationIgnored private var destination: RemoteDestination?
+    @ObservationIgnored private var task: Task<Void, Never>?
+    @ObservationIgnored private var control: RemoteOperationControl?
+    @ObservationIgnored private var generation = 0
+
+
+    init(profileID: UUID?, endpoint: RemoteEndpoint, environment: RemoteEnvironment) {
+
+        self.profileID = profileID
+        self.endpoint = endpoint
+        self.environment = environment
+    }
+
+
+    /// The entries to show, folders first.
+    var visibleEntries: [Entry] {
+
+        self.entries
+            .filter { self.showsHiddenFiles || !$0.isHidden }
+            .sorted { lhs, rhs in
+                if lhs.isFolder != rhs.isFolder { return lhs.isFolder }
+                switch lhs.name.localizedStandardCompare(rhs.name) {
+                    case .orderedAscending: return true
+                    case .orderedDescending: return false
+                    case .orderedSame: return lhs.name.utf8.lexicographicallyPrecedes(rhs.name.utf8)
+                }
+            }
+    }
+
+
+    /// The folders from the file system's root to the shown one, as (name, path).
+    var breadcrumbs: [(name: String, path: String)] {
+
+        guard let currentPath else { return [] }
+
+        var crumbs: [(String, String)] = [("/", "/")]
+        var path = ""
+        for component in RemotePath.components(of: currentPath) {
+            path += "/" + component
+            crumbs.append((component, path))
+        }
+
+        return crumbs
+    }
+
+
+    var canGoUp: Bool {
+
+        self.currentPath.map { $0 != "/" } ?? false
+    }
+
+
+    /// Starts at a folder, or at the server's starting folder, `REALPATH(".")`.
+    func start(at path: String?) {
+
+        if let path {
+            self.navigate(to: path, fallsBackToStart: true)
+        } else {
+            self.navigate(to: ".", fallsBackToStart: false)
+        }
+    }
+
+
+    /// Shows the starting folder, after the last folder of the connection failed.
+    func showStartingFolder() {
+
+        self.navigate(to: ".", fallsBackToStart: false)
+    }
+
+
+    /// Goes to the typed path.
+    func goToTypedPath() {
+
+        do {
+            self.navigate(to: try RemotePath.validated(self.pathField.trimmingCharacters(in: .whitespaces)), fallsBackToStart: false)
+        } catch {
+            self.errorMessage = error.localizedDescription
+        }
+    }
+
+
+    func goUp() {
+
+        guard let currentPath, self.canGoUp else { return }
+
+        self.navigate(to: RemotePath.parent(of: currentPath), fallsBackToStart: false)
+    }
+
+
+    func go(to path: String) {
+
+        self.navigate(to: path, fallsBackToStart: false)
+    }
+
+
+    /// Enters an entry: a known folder at once, anything that may be a folder once resolved.
+    func enter(_ id: Entry.ID?) {
+
+        guard let id, let index = self.entries.firstIndex(where: { $0.id == id }) else { return }
+        let entry = self.entries[index]
+
+        guard entry.mayBeFolder else { return }
+
+        if entry.isFolder {
+            return self.navigate(to: entry.path, fallsBackToStart: false)
+        }
+
+        self.entries[index].state = .resolving
+        let environment = self.environment
+        let endpoint = self.endpoint
+        let generation = self.generation
+        self.task = Task {
+            do {
+                let destination = try await self.resolvedDestination()
+                let item = try await environment.pool.withBrowsingConnection(to: endpoint, destination: destination) { transport in
+                    try await RemotePoolTreeSource.resolve(entry.path, with: transport)
+                }
+                guard generation == self.generation, let index = self.entries.firstIndex(where: { $0.id == id }) else { return }
+                if item.kind == .directory {
+                    self.entries[index].state = .ready
+                    self.navigate(to: item.target, fallsBackToStart: false)
+                } else {
+                    self.entries[index].state = .notAFolder
+                }
+            } catch is CancellationError {
+                return
+            } catch {
+                guard generation == self.generation, let index = self.entries.firstIndex(where: { $0.id == id }) else { return }
+                self.entries[index].state = .failed(RemoteFolderOpenModel.message(for: error))
+            }
+        }
+    }
+
+
+    /// Opens the folder that is shown, never the selected entry.
+    func openCurrentFolder() {
+
+        guard let currentPath, !self.isLoading else { return }
+
+        self.onOpen(currentPath)
+    }
+
+
+    func showError(_ message: String?) {
+
+        self.errorMessage = message
+    }
+
+
+    func cancel() {
+
+        self.generation += 1
+        self.control?.requestCancel()
+        self.task?.cancel()
+    }
+
+
+    // MARK: Private Methods
+
+    private func navigate(to path: String, fallsBackToStart: Bool) {
+
+        self.generation += 1
+        let generation = self.generation
+        self.control?.requestCancel()
+        let control = RemoteOperationControl()
+        self.control = control
+        self.isLoading = true
+        self.errorMessage = nil
+        self.offersStartingFolder = false
+
+        let environment = self.environment
+        let endpoint = self.endpoint
+        self.task?.cancel()
+        self.task = Task {
+            do {
+                let destination = try await self.resolvedDestination()
+                let limits = await environment.pool.limits
+                let (canonicalPath, listing) = try await RemoteOperationControl.$current.withValue(control) {
+                    try await environment.pool.withBrowsingConnection(to: endpoint, destination: destination) { transport in
+                        let canonicalPath = try await RemoteFolderOpenCoordinator.resolveFolder(path, with: transport)
+                        return (canonicalPath, try await transport.listDirectory(at: canonicalPath, limits: limits))
+                    }
+                }
+                guard generation == self.generation else { return }
+
+                self.currentPath = canonicalPath
+                self.pathField = canonicalPath
+                self.entries = listing.entries.compactMap { entry in
+                    RemotePath.child(entry.name, of: canonicalPath).map { Entry(name: entry.name, path: $0, kind: RemoteDirectoryNode.Kind(entry.attributes)) }
+                }
+                self.limit = listing.limit
+                self.selection = nil
+                self.isLoading = false
+            } catch is CancellationError, is RemoteOperationCanceled {
+                return
+            } catch {
+                guard generation == self.generation else { return }
+                self.isLoading = false
+                self.errorMessage = RemoteFolderOpenModel.message(for: error)
+                self.offersStartingFolder = fallsBackToStart
+            }
+        }
+    }
+
+
+    private func resolvedDestination() async throws -> RemoteDestination {
+
+        if let destination { return destination }
+
+        let destination = try await self.environment.pool.destination(for: self.endpoint)
+        self.destination = destination
+        return destination
+    }
+}
