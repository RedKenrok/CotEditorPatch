+    @Test(.timeLimit(.minutes(1))) func aCrashDuringARepairLeavesAConsistentRecord() async throws {
+
+        struct SimulatedCrash: Error { }
+
+        let steps: [(String, @Sendable (RemoteRecoveryRecord.Step) -> Bool)] = [
+            ("after a data file", { if case .dataWritten = $0 { true } else { false } }),
+            ("after writing the manifest", { $0 == .manifestWritten }),
+            ("after replacing the manifest", { $0 == .manifestReplaced }),
+            ("before cleanup", { $0 == .cleanup }),
+        ]
+        for (name, matches) in steps {
+            let bed = await RemoteTestBed(limits: RemoteLimits(chunkSize: 4, requestsInFlight: 1))
+            await self.addFileOfAnotherUser("/srv/site/page.txt", "original text", on: bed.server)
+            let document = try await bed.open("/srv/site/page.txt")
+            document.replaceText(with: "replacement!!")
+            await bed.server.setHook { request in
+                if case .write("/srv/site/page.txt", 0, _) = request { return .dropAfterHandling }
+                return .proceed
+            }
+            _ = await document.saveCoordinator.perform(.save)
+            await bed.server.setHook(nil)
+            guard case .conflict(let conflict) = await document.saveCoordinator.perform(.save) else { Issue.record("\(name): expected a conflict"); return }
+            try await document.markReviewed(try #require(conflict.remoteData))
+
+            // Every record change of the repair crashes at this step.
+            let record = try #require(document.record)
+            await record.setFaultInjector { if matches($0) { throw SimulatedCrash() } }
+            #expect(await document.saveCoordinator.perform(.retryInPlace) != .saved, "\(name)")
+            await record.setFaultInjector(nil)
+            await record.relinquish()
+
+            // What is on disk is a complete record that still says the repair is not confirmed,
+            // or the confirmed result; never a record that forgets the unresolved write.
+            let restarted = try RemoteRecoveryRecord.open(in: bed.recoveryRoot, documentID: document.documentID)
+            let manifest = restarted.initialManifest
+            let files = [manifest.baseline.file, manifest.text?.file, manifest.reviewed, manifest.operation?.snapshot,
+                         manifest.operation?.original, manifest.operation?.restoreCopy].compactMap(\.self)
+            for file in files {
+                #expect(throws: Never.self, "\(name): \(file.name) is complete") { try restarted.data(of: file) }
+            }
+            let serverContents = await bed.server.contents(of: "/srv/site/page.txt")
+            let isConfirmed = manifest.operation == nil && (try? restarted.data(of: manifest.baseline.file)) == Data("replacement!!".utf8)
+            // A repair that has not written yet keeps the interrupted write as the superseded operation, which returns if the repair is abandoned.
+            let keepsTheInterruptedWrite = manifest.operation?.mayHaveChangedTarget == true || manifest.supersededOperation?.mayHaveChangedTarget == true
+            #expect(keepsTheInterruptedWrite || isConfirmed, "\(name)")
+            #expect(isConfirmed ? serverContents == "replacement!!" : true, "\(name)")
+            await restarted.relinquish()
+            await bed.tearDown()
+        }
+    }
