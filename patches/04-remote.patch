+
+    func validateMenuItem(_ menuItem: NSMenuItem) -> Bool {
+
+        let node = self.targetNode
+
+        switch menuItem.action {
+            case #selector(openClicked):
+                return node.map { !$0.isFolder } ?? false
+            case #selector(cancelOpeningClicked):
+                menuItem.isHidden = !(node.map(self.session.isOpening) ?? false)
+                return !menuItem.isHidden
+            case #selector(openFolderInNewWindow):
+                return node?.isFolder == true
+            case #selector(refreshFolder):
+                return node == nil || node?.isFolder == true
+            case #selector(renameClicked), #selector(deleteClicked):
+                return node.map { self.session.status == .online && !self.session.isChanging($0) } ?? false
+            case #selector(addFile), #selector(addFolder):
+                return self.session.status == .online && self.targetFolder(for: menuItem) != nil
+            case #selector(copyRemoteLocation):
+                return true
+            case #selector(toggleHiddenFiles):
+                menuItem.state = self.session.showsHiddenFiles ? .on : .off
+                return true
+            default:
+                return true
+        }
+    }
