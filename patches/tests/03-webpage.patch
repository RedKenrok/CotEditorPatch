+    @Test(.timeLimit(.minutes(1))) func webPageTabsJoinTheTabsWithoutAFile() async throws {
+
+        try await self.withWebPages { directory, urls, server, _ in
+            #expect(await directory.openDocument(at: urls[0]))
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+            let window = try #require(directory.windowControllers.first?.window)
+
+            #expect(directory.tabState.entries.map(\.id).last == session.id)
+            #expect(directory.activeWebPageSession === session)
+            #expect(directory.activeFileDocument == nil)
+            #expect(directory.windowController?.fileDocument == nil)
+            #expect(session.title == "Webpage")
+            #expect(window.subtitle == "Webpage")
+            #expect((window.firstResponder as? NSTextView)?.delegate === controller.addressField, "a new tab starts in its address field")
+
+            let fileActions: [Selector] = [
+                #selector(NSDocument.save(_:)),
+                #selector(NSDocument.revertToSaved(_:)),
+                #selector(DirectoryDocument.changeEncoding(_:)),
+                #selector(DirectoryDocument.showInFinder(_:)),
+            ]
+            #expect(fileActions.allSatisfy { !directory.validateUserInterfaceItem(NSMenuItem(title: "", action: $0, keyEquivalent: "")) })
+            #expect(directory.validateUserInterfaceItem(NSMenuItem(title: "", action: #selector(DirectoryDocument.newWebPageTab(_:)), keyEquivalent: "")))
+            #expect(!directory.canMoveTabToNewWindow(id: session.id))
+
+            let tabBar = try #require(directory.windowContentViewController?.makeTabBar(for: directory))
+            #expect(tabBar.addMenuItems.map(\.title).contains("New Webpage"))
+            #expect(tabBar.contextMenuItems(session.id).map(\.title) == ["Clear Website Data…"])
+            #expect(server.count("/") == 0, "a new tab loads nothing")
+        }
+    }
