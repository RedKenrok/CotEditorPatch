+import Foundation
+import Testing
+@testable import CotEditor
+
+/// Which addresses webpage tabs accept, from typed text and from URLs of every other origin.
+struct WebPageNavigationPolicyTests {
+
+    private typealias Policy = WebPageNavigationPolicy
+
+
+    // MARK: Typed Addresses
+
+    @Test func typedAddressesWithoutSchemeUseHTTPS() throws {
+
+        #expect(try Policy.url(fromTypedAddress: "example.com").get().absoluteString == "https://example.com")
+        #expect(try Policy.url(fromTypedAddress: "  example.com/path?q=1  ").get().absoluteString == "https://example.com/path?q=1")
+        #expect(try Policy.url(fromTypedAddress: "localhost:3000").get().absoluteString == "https://localhost:3000",
+                "a local server is entered with http:// explicitly")
+        #expect(try Policy.url(fromTypedAddress: "http://localhost:3000/app").get().absoluteString == "http://localhost:3000/app")
+        #expect(try Policy.url(fromTypedAddress: "HTTPS://Example.com").get().host() == "Example.com")
+    }
+
+
+    @Test func typedTextThatIsNotAnAddressIsRefused() {
+
+        #expect(Policy.url(fromTypedAddress: "") == .failure(.invalidAddress))
+        #expect(Policy.url(fromTypedAddress: "   ") == .failure(.invalidAddress))
+        #expect(Policy.url(fromTypedAddress: "how to write swift") == .failure(.invalidAddress), "the field is not a search field")
+        #expect(Policy.url(fromTypedAddress: "https://") == .failure(.invalidAddress))
+        #expect(Policy.url(fromTypedAddress: "exa mple.com") == .failure(.invalidAddress))
+    }
+
+
+    @Test func otherSchemesAreUnsupported() {
+
+        #expect(Policy.url(fromTypedAddress: "ftp://example.com") == .failure(.unsupportedScheme("ftp")))
+        #expect(Policy.url(fromTypedAddress: "mailto:someone@example.com") == .failure(.unsupportedScheme("mailto")))
+        #expect(Policy.url(fromTypedAddress: "javascript:alert(1)") == .failure(.unsupportedScheme("javascript")))
+        #expect(Policy.url(fromTypedAddress: "file:///etc/hosts") == .failure(.unsupportedScheme("file")))
+        #expect(Policy.url(fromTypedAddress: "data:text/html,hi") == .failure(.unsupportedScheme("data")))
+    }
+
+
+    @Test func embeddedCredentialsAreRefusedEverywhere() {
+
+        #expect(Policy.url(fromTypedAddress: "https://user:secret@example.com") == .failure(.embeddedCredentials))
+        #expect(Policy.url(fromTypedAddress: "user@example.com") == .failure(.embeddedCredentials))
+        #expect(Policy.refusal(for: URL(string: "http://user@localhost:3000")!) == .embeddedCredentials)
+    }
+
+
+    // MARK: Local HTTP
+
+    @Test(arguments: [
+        "http://localhost",
+        "http://localhost:3000/path",
+        "http://LOCALHOST.",
+        "http://127.0.0.1:8080",
+        "http://127.255.0.1",
+        "http://10.1.2.3",
+        "http://172.16.0.1",
+        "http://172.31.255.255",
+        "http://192.168.1.20:5173",
+        "http://169.254.10.1",
+        "http://devbox",
+        "http://devbox:8000",
+        "http://printer.local",
+        "http://my-mac.local.:3000",
+        "http://[::1]:3000",
+        "http://[fe80::1%25en0]:8080/",
+        "http://[fd12:3456::1]",
+        "http://[::ffff:192.168.0.1]",
+        "http://0x7f.1/",
+        "http://2130706433/",
+    ])
+    func localHTTPIsAllowed(address: String) throws {
+
+        let url = try #require(URL(string: address))
+        #expect(Policy.refusal(for: url) == nil)
+    }
+
+
+    @Test(arguments: [
+        "http://example.com",
+        "http://localhost.example.com",
+        "http://10.0.0.1.example.com",
+        "http://app.test",
+        "http://foo.localhost",
+        "http://dev.internal",
+        "http://172.32.0.1",
+        "http://8.8.8.8",
+        "http://100.64.0.1",
+        "http://0.0.0.0",
+        "http://[2001:db8::1]",
+        "http://[::ffff:8.8.8.8]",
+        "http://134744072/",
+        "http://0x08080808/",
+    ])
+    func publicHTTPRequiresHTTPS(address: String) throws {
+
+        let url = try #require(URL(string: address))
+        #expect({ if case .requiresHTTPS = Policy.refusal(for: url) { true } else { false } }())
+        #expect(Policy.refusal(for: try #require(URL(string: address.replacing("http://", with: "https://")))) == nil,
+                "the same host is fine over HTTPS")
+    }
+
+
+    @Test func malformedNumericHostsAreInvalid() throws {
+
+        #expect(Policy.refusal(for: try #require(URL(string: "http://256.1.1.1"))) == .invalidAddress)
+        #expect(Policy.refusal(for: try #require(URL(string: "http://1.2.3.4.5"))) == .invalidAddress)
+        #expect(Policy.refusal(for: try #require(URL(string: "http://example.123"))) == .invalidAddress)
+    }
+
+
+    @Test func hostsAreParsedStructurally() {
+
+        #expect(WebPageNavigationPolicy.Host("10.0.0.1") == .ipv4(0x0a00_0001))
+        #expect(WebPageNavigationPolicy.Host("10.1") == .ipv4(0x0a00_0001), "shortened forms are read as WebKit reads them")
+        #expect(WebPageNavigationPolicy.Host("012.0.0.1") == .ipv4(0x0a00_0001), "a leading zero means octal")
+        #expect(WebPageNavigationPolicy.Host("localhost.example.com") == .name(["localhost", "example", "com"]))
+        #expect(WebPageNavigationPolicy.Host("fe80::1%en0")?.isLocal == true)
+        #expect(WebPageNavigationPolicy.Host("[::1]")?.isLocal == true)
+        #expect(WebPageNavigationPolicy.Host("a..b") == nil)
+        #expect(WebPageNavigationPolicy.Host("bad host") == nil)
+    }
+
+
+    // MARK: Frames
+
+    @Test func subframesMayShowTheirOwnContent() throws {
+
+        #expect(Policy.allowsSubframe(try #require(URL(string: "about:blank"))))
+        #expect(Policy.allowsSubframe(try #require(URL(string: "about:srcdoc"))))
+        #expect(Policy.allowsSubframe(try #require(URL(string: "data:text/html,hi"))))
+        #expect(Policy.allowsSubframe(try #require(URL(string: "https://example.com/embed"))))
+        #expect(Policy.allowsSubframe(try #require(URL(string: "http://localhost:3000/embed"))))
+        #expect(!Policy.allowsSubframe(try #require(URL(string: "http://example.com/embed"))))
+        #expect(!Policy.allowsSubframe(try #require(URL(string: "file:///etc/hosts"))))
+    }
+}
