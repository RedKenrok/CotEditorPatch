+import AppKit
+import Foundation
+import Testing
+@testable import CotEditor
+
+
+// MARK: Fake SFTP Server
+
+/// A request as the fake server saw it, for checking what a client sent and in which order.
+enum FakeSFTPRequest: Equatable, Sendable {
+
+    case open(path: String, flags: UInt32)
+    case close(path: String)
+    case read(path: String, offset: UInt64)
+    case write(path: String, offset: UInt64, count: Int)
+    case lstat(path: String)
+    case fstat(path: String)
+    case stat(path: String)
+    case setstat(path: String)
+    case fsetstat(path: String, size: UInt64?)
+    case remove(path: String)
+    case realpath(path: String)
+    case readlink(path: String)
+    case rename(from: String, to: String)
+    case fsync(path: String)
+    case opendir(path: String)
+    case readdir(path: String)
+    case mkdir(path: String)
+    case rmdir(path: String)
+    /// The plain `RENAME` request, which refuses an existing destination, unlike the `posix-rename` extension (`rename`).
+    case plainRename(from: String, to: String)
+
+
+    var path: String {
+
+        switch self {
+            case .open(let path, _), .close(let path), .read(let path, _), .write(let path, _, _), .lstat(let path), .fstat(let path),
+                 .stat(let path), .setstat(let path), .fsetstat(let path, _), .remove(let path), .realpath(let path),
+                 .readlink(let path), .fsync(let path), .opendir(let path), .readdir(let path), .mkdir(let path), .rmdir(let path):
+                path
+            case .rename(_, let to), .plainRename(_, let to):
+                to
+        }
+    }
+
+
+    /// Whether the request can change what is stored on the server.
+    var isMutation: Bool {
+
+        switch self {
+            case .open(_, let flags): flags & (RemoteOpenFlags.write.rawValue | RemoteOpenFlags.create.rawValue) != 0
+            case .write, .setstat, .fsetstat, .remove, .rename, .mkdir, .rmdir, .plainRename: true
+            default: false
+        }
+    }
+}
+
+
+/// What the fake server does with a request.
+enum FakeSFTPAction: Sendable {
+
+    /// Handles it normally.
+    case proceed
+    /// Answers with a failure status without doing anything.
+    case fail(RemoteSFTPStatusCode)
+    /// Ends the connection without doing anything, so that the reply is lost.
+    case dropBeforeHandling
+    /// Does the operation, then ends the connection before replying.
+    case dropAfterHandling
+}
+
+
+/// An SFTP version 3 server with an in-memory file system, for tests.
+/// A table of paths that tells paths apart by their bytes, unlike a dictionary of `String`.
+struct FakePathTable<Value: Sendable>: Sendable {
+
+    private var storage: [[UInt8]: (path: String, value: Value)] = [:]
+
+
+    init(_ entries: [String: Value] = [:]) {
+
+        for (path, value) in entries {
+            self[path] = value
+        }
+    }
+
+
+    subscript(path: String) -> Value? {
+
+        get { self.storage[Array(path.utf8)]?.value }
+        set { self.storage[Array(path.utf8)] = newValue.map { (path, $0) } }
+    }
+
+
+    var keys: [String]  { self.storage.values.map(\.path) }
+}
+
+
+actor FakeSFTPServer {
+
+    struct File: Sendable {
+
+        var data: Data
+        var userID: UInt32
+        var groupID: UInt32
+        var mode: UInt32
+        var modificationTime: UInt32
+    }
+
+
+    enum Node: Sendable {
+
+        case file(File)
+        case directory(userID: UInt32, groupID: UInt32, mode: UInt32)
+        case link(target: String)
+    }
+
+
+    private struct Handle {
+
+        var path: String
+        var flags: UInt32
+
+        /// A folder's entries as of `OPENDIR`, and how many were sent.
+        var entries: [(name: Data, attributes: RemoteFileAttributes)]?
+        var cursor = 0
+    }
+
+
+    /// The user the client signs in as.
+    var userID: UInt32 = 501
+    var groupID: UInt32 = 20
+
+    /// Owner and group given to files created by the client, which a server may choose differently.
+    var createdUserID: UInt32?
+    var createdGroupID: UInt32?
+
+    var supportsPOSIXRename = true
+    var supportsFsync = true
+
+    /// Answers reads with at most this many bytes, as servers may.
+    var maximumReadLength: Int?
+
+    /// The umask applied to the mode of created files and folders, as a server applies its own.
+    var umask: UInt32 = 0
+
+    /// Whether the plain `RENAME` replaces an existing destination, as some servers other than OpenSSH do.
+    var plainRenameReplaces = false
+
+    /// How many entries each `READDIR` answer holds at most.
+    var directoryBatchSize = 64
+
+    /// Leaves the type out of the attributes of listed entries, as some servers do.
+    var omitsListingTypes = false
+
+    /// Leaves the type out of `STAT` and `LSTAT` answers too.
+    var omitsStatTypes = false
+
+    /// Names added to a folder's listing as files, byte for byte, such as names that are not valid UTF-8.
+    var rawEntries: [String: [Data]] = [:]
+
+    /// Folders whose listing never ends: every `READDIR` answers with no entries.
+    var endlessFolders: Set<String> = []
+
+    /// Decides what happens to each request before it is handled.
+    var hook: (@Sendable (FakeSFTPRequest) async -> FakeSFTPAction)?
+
+    /// Keyed by the path's bytes, as a server's file system names files: `café` composed and decomposed are two files.
+    private(set) var nodes = FakePathTable<Node>(["/": .directory(userID: 0, groupID: 0, mode: 0o755)])
+    private(set) var log: [FakeSFTPRequest] = []
+    private var handles: [Data: Handle] = [:]
+
+    /// The handles the client has open, of files and folders.
+    var openHandleCount: Int  { self.handles.count }
+    private var nextHandle: UInt32 = 1
+    private var clock: UInt32 = 1_700_000_000
+
+
+    // MARK: Setting Up
+
+    func setHook(_ hook: (@Sendable (FakeSFTPRequest) async -> FakeSFTPAction)?) {
+
+        self.hook = hook
+    }
+
+
+    func configure(_ body: @Sendable (isolated FakeSFTPServer) -> Void) {
+
+        body(self)
+    }
+
+
+    /// Adds a file, creating its folders, owned by the signed-in user unless given otherwise.
+    func addFile(_ path: String, _ contents: String, userID: UInt32? = nil, groupID: UInt32? = nil, mode: UInt32 = 0o644) {
+
+        self.addFile(path, data: Data(contents.utf8), userID: userID, groupID: groupID, mode: mode)
+    }
+
+
+    func addFile(_ path: String, data: Data, userID: UInt32? = nil, groupID: UInt32? = nil, mode: UInt32 = 0o644) {
+
+        self.addDirectory(RemotePath.parent(of: path))
+        self.clock += 1
+        self.nodes[path] = .file(File(data: data, userID: userID ?? self.userID, groupID: groupID ?? self.groupID, mode: mode, modificationTime: self.clock))
+    }
+
+
+    func addDirectory(_ path: String, userID: UInt32? = nil, mode: UInt32 = 0o755) {
+
+        guard path != "/", self.nodes[path] == nil else { return }
+
+        self.addDirectory(RemotePath.parent(of: path))
+        self.nodes[path] = .directory(userID: userID ?? self.userID, groupID: self.groupID, mode: mode)
+    }
+
+
+    /// Replaces whatever is at the path with a file, as another client could.
+    func replaceWithFile(_ path: String, _ contents: String) {
+
+        self.clock += 1
+        self.nodes[path] = .file(File(data: Data(contents.utf8), userID: self.userID, groupID: self.groupID, mode: 0o644, modificationTime: self.clock))
+    }
+
+
+    /// Removes an item and everything below it.
+    func removeTree(_ path: String) {
+
+        for key in self.nodes.keys where RemotePath.isAncestor(path, of: key) {
+            self.nodes[key] = nil
+        }
+    }
+
+
+    func setDirectory(_ path: String, userID: UInt32, mode: UInt32) {
+
+        self.nodes[path] = .directory(userID: userID, groupID: self.groupID, mode: mode)
+    }
+
+
+    func addLink(_ path: String, target: String) {
+
+        self.addDirectory(RemotePath.parent(of: path))
+        self.nodes[path] = .link(target: target)
+    }
+
+
+    func remove(_ path: String) {
+
+        self.nodes[path] = nil
+    }
+
+
+    /// Replaces a file's bytes, keeping its size and modification time if asked to, as a careless
+    /// writer or a coarse clock can.
+    func overwrite(_ path: String, with contents: String, keepingModificationTime: Bool = false) {
+
+        guard case .file(var file) = self.nodes[path] else { Issue.record("no file at \(path)"); return }
+
+        file.data = Data(contents.utf8)
+        if !keepingModificationTime {
+            self.clock += 1
+            file.modificationTime = self.clock
+        }
+        self.nodes[path] = .file(file)
+    }
+
+
+    // MARK: Inspecting
+
+    func contents(of path: String) -> String? {
+
+        guard case .file(let file) = self.nodes[path] else { return nil }
+
+        return String(data: file.data, encoding: .utf8)
+    }
+
+
+    func file(at path: String) -> File? {
+
+        guard case .file(let file) = self.nodes[path] else { return nil }
+
+        return file
+    }
+
+
+    /// The paths of every file in the folder.
+    func files(in folder: String) -> [String] {
+
+        self.nodes.keys.filter { RemotePath.isSame(RemotePath.parent(of: $0), folder) && self.file(at: $0) != nil }.sorted()
+    }
+
+
+    func clearLog() {
+
+        self.log.removeAll()
+    }
+
+
+    /// Whether any request since the log was cleared could have changed stored files.
+    var hasMutated: Bool {
+
+        self.log.contains(where: \.isMutation)
+    }
+
+
+    // MARK: Protocol
+
+    /// Handles one packet from the client.
+    ///
+    /// - Returns: The reply to send, and whether the connection ends afterwards (before or after sending it).
+    func handle(type: UInt8, payload: Data) async -> (reply: Data?, dropsConnection: Bool) {
+
+        var reader = RemoteSFTPReader(payload)
+
+        if type == RemoteSFTPPacketType.initialize.rawValue {
+            var writer = RemoteSFTPWriter()
+            writer.write(UInt32(3))
+            if self.supportsPOSIXRename {
+                writer.write(string: RemoteSFTPExtension.posixRename)
+                writer.write(string: "1")
+            }
+            if self.supportsFsync {
+                writer.write(string: RemoteSFTPExtension.fsync)
+                writer.write(string: "1")
+            }
+            return (RemoteSFTPCodec.frame(type: .version, payload: writer.data), false)
+        }
+
+        do {
+            let id = try reader.readUInt32()
+            let (request, perform) = try self.parse(type: type, reader: &reader)
+            self.log.append(request)
+
+            switch await self.hook?(request) ?? .proceed {
+                case .proceed:
+                    return (self.reply(id: id, perform()), false)
+                case .fail(let code):
+                    return (self.status(id: id, code), false)
+                case .dropBeforeHandling:
+                    return (nil, true)
+                case .dropAfterHandling:
+                    _ = perform()
+                    return (nil, true)
+            }
+        } catch {
+            return (nil, true)
+        }
+    }
+
+
+    // MARK: Private Methods
+
+    private enum Outcome {
+
+        case status(RemoteSFTPStatusCode)
+        case handle(Data)
+        case data(Data)
+        case name(String, RemoteFileAttributes)
+        case names([(name: Data, attributes: RemoteFileAttributes)])
+        case attributes(RemoteFileAttributes)
+    }
+
+
+    private func parse(type: UInt8, reader: inout RemoteSFTPReader) throws -> (FakeSFTPRequest, () -> Outcome) {
+
+        switch RemoteSFTPPacketType(rawValue: type) {
+            case .open:
+                let path = try reader.readUTF8String()
+                let flags = try reader.readUInt32()
+                let attributes = try reader.readAttributes()
+                return (.open(path: path, flags: flags), { self.open(path, flags: flags, attributes: attributes) })
+            case .close:
+                let handle = try reader.readString()
+                return (.close(path: self.handles[handle]?.path ?? "?"), { self.handles.removeValue(forKey: handle) != nil ? .status(.ok) : .status(.failure) })
+            case .read:
+                let handle = try reader.readString()
+                let offset = try reader.readUInt64()
+                let length = try reader.readUInt32()
+                return (.read(path: self.handles[handle]?.path ?? "?", offset: offset), { self.read(handle, offset: offset, length: length) })
+            case .write:
+                let handle = try reader.readString()
+                let offset = try reader.readUInt64()
+                let data = try reader.readString()
+                return (.write(path: self.handles[handle]?.path ?? "?", offset: offset, count: data.count), { self.write(handle, offset: offset, data: data) })
+            case .lstat:
+                let path = try reader.readUTF8String()
+                return (.lstat(path: path), { self.attributes(at: path, followsLinks: false) })
+            case .stat:
+                let path = try reader.readUTF8String()
+                return (.stat(path: path), { self.attributes(at: path, followsLinks: true) })
+            case .fstat:
+                let handle = try reader.readString()
+                return (.fstat(path: self.handles[handle]?.path ?? "?"), {
+                    guard let path = self.handles[handle]?.path else { return .status(.failure) }
+                    return self.attributes(at: path, followsLinks: true)
+                })
+            case .setstat:
+                let path = try reader.readUTF8String()
+                let attributes = try reader.readAttributes()
+                return (.setstat(path: path), { self.setAttributes(attributes, at: path) })
+            case .fsetstat:
+                let handle = try reader.readString()
+                let attributes = try reader.readAttributes()
+                return (.fsetstat(path: self.handles[handle]?.path ?? "?", size: attributes.size), {
+                    guard let open = self.handles[handle] else { return .status(.failure) }
+                    // Truncating through a handle opened for writing is ftruncate(2), which needs no ownership.
+                    let truncatesOnly = attributes.size != nil && attributes.permissions == nil
+                        && open.flags & RemoteOpenFlags.write.rawValue != 0
+                    return self.setAttributes(attributes, at: open.path, ownershipRequired: !truncatesOnly)
+                })
+            case .remove:
+                let path = try reader.readUTF8String()
+                return (.remove(path: path), {
+                    guard self.file(at: path) != nil || self.isLink(path) else { return .status(.noSuchFile) }
+                    guard self.canWriteFolder(of: path) else { return .status(.permissionDenied) }
+                    self.nodes[path] = nil
+                    return .status(.ok)
+                })
+            case .realpath:
+                let path = try reader.readUTF8String()
+                return (.realpath(path: path), {
+                    guard let resolved = self.resolve(path), self.nodes[resolved] != nil else { return .status(.noSuchFile) }
+                    return .name(resolved, RemoteFileAttributes())
+                })
+            case .readlink:
+                let path = try reader.readUTF8String()
+                return (.readlink(path: path), {
+                    guard case .link(let target) = self.nodes[path] else { return .status(.failure) }
+                    return .name(target, RemoteFileAttributes())
+                })
+            case .extended:
+                let name = try reader.readUTF8String()
+                switch name {
+                    case RemoteSFTPExtension.posixRename where self.supportsPOSIXRename:
+                        let from = try reader.readUTF8String()
+                        let to = try reader.readUTF8String()
+                        return (.rename(from: from, to: to), { self.rename(from, to: to) })
+                    case RemoteSFTPExtension.fsync where self.supportsFsync:
+                        let handle = try reader.readString()
+                        return (.fsync(path: self.handles[handle]?.path ?? "?"), { self.handles[handle] != nil ? .status(.ok) : .status(.failure) })
+                    default:
+                        throw RemoteSFTPProtocolError(description: "unsupported extension \(name)")
+                }
+            case .opendir:
+                let path = try reader.readUTF8String()
+                return (.opendir(path: path), { self.openDirectory(path) })
+            case .readdir:
+                let handle = try reader.readString()
+                return (.readdir(path: self.handles[handle]?.path ?? "?"), { self.readDirectory(handle) })
+            case .mkdir:
+                let path = try reader.readUTF8String()
+                let attributes = try reader.readAttributes()
+                return (.mkdir(path: path), {
+                    // OpenSSH answers FAILURE for a name that is taken, as SFTP version 3 has no better status.
+                    guard self.nodes[path] == nil else { return .status(.failure) }
+                    guard self.canWriteFolder(of: path) else { return .status(.permissionDenied) }
+                    self.nodes[path] = .directory(userID: self.createdUserID ?? self.userID, groupID: self.createdGroupID ?? self.groupID,
+                                                  mode: (attributes.permissions ?? 0o755) & 0o7777 & ~self.umask)
+                    return .status(.ok)
+                })
+            case .rmdir:
+                let path = try reader.readUTF8String()
+                return (.rmdir(path: path), {
+                    guard case .directory = self.nodes[path] else { return .status(self.nodes[path] == nil ? .noSuchFile : .failure) }
+                    guard self.canWriteFolder(of: path) else { return .status(.permissionDenied) }
+                    guard !self.nodes.keys.contains(where: { !RemotePath.isSame($0, path) && RemotePath.isAncestor(path, of: $0) }) else { return .status(.failure) }
+                    self.nodes[path] = nil
+                    return .status(.ok)
+                })
+            case .rename:
+                let from = try reader.readUTF8String()
+                let to = try reader.readUTF8String()
+                return (.plainRename(from: from, to: to), { self.renameRefusingExisting(from, to: to) })
+            default:
+                throw RemoteSFTPProtocolError(description: "unsupported packet \(type)")
+        }
+    }
+
+
+    private func reply(id: UInt32, _ outcome: Outcome) -> Data {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(id)
+
+        switch outcome {
+            case .status(let code):
+                return self.status(id: id, code)
+            case .handle(let handle):
+                writer.write(string: handle)
+                return RemoteSFTPCodec.frame(type: .handle, payload: writer.data)
+            case .data(let data):
+                writer.write(string: data)
+                return RemoteSFTPCodec.frame(type: .data, payload: writer.data)
+            case .name(let name, let attributes):
+                writer.write(UInt32(1))
+                writer.write(string: name)
+                writer.write(string: name)
+                writer.write(attributes)
+                return RemoteSFTPCodec.frame(type: .name, payload: writer.data)
+            case .names(let entries):
+                writer.write(UInt32(entries.count))
+                for entry in entries {
+                    writer.write(string: entry.name)
+                    writer.write(string: entry.name)
+                    writer.write(entry.attributes)
+                }
+                return RemoteSFTPCodec.frame(type: .name, payload: writer.data)
+            case .attributes(let attributes):
+                writer.write(attributes)
+                return RemoteSFTPCodec.frame(type: .attributes, payload: writer.data)
+        }
+    }
+
+
+    private func status(id: UInt32, _ code: RemoteSFTPStatusCode) -> Data {
+
+        var writer = RemoteSFTPWriter()
+        writer.write(id)
+        writer.write(code.rawValue)
+        writer.write(string: "status \(code.rawValue)")
+        writer.write(string: "en")
+
+        return RemoteSFTPCodec.frame(type: .status, payload: writer.data)
+    }
+
+
+    /// Follows links and normalizes a path, as `realpath(3)` would.
+    private func resolve(_ path: String, depth: Int = 0) -> String? {
+
+        guard depth < 8 else { return nil }
+
+        var resolved = ""
+        for component in path.split(separator: "/") where component != "." {
+            if component == ".." {
+                resolved = RemotePath.parent(of: resolved.isEmpty ? "/" : resolved)
+                if resolved == "/" { resolved = "" }
+                continue
+            }
+            let candidate = resolved + "/" + component
+            if case .link(let target) = self.nodes[candidate] {
+                let absolute = target.hasPrefix("/") ? target : RemotePath.appending(target, to: resolved.isEmpty ? "/" : resolved)
+                guard let next = self.resolve(absolute, depth: depth + 1) else { return nil }
+                resolved = next == "/" ? "" : next
+            } else {
+                resolved = candidate
+            }
+        }
+
+        return resolved.isEmpty ? "/" : resolved
+    }
+
+
+    private func isLink(_ path: String) -> Bool {
+
+        if case .link = self.nodes[path] { true } else { false }
+    }
+
+
+    private func attributes(at path: String, followsLinks: Bool) -> Outcome {
+
+        guard case .attributes(var attributes) = self.plainAttributes(at: path, followsLinks: followsLinks) else {
+            return self.plainAttributes(at: path, followsLinks: followsLinks)
+        }
+        if self.omitsStatTypes {
+            attributes.permissions = attributes.permissions.map { $0 & 0o7777 }
+        }
+
+        return .attributes(attributes)
+    }
+
+
+    private func plainAttributes(at path: String, followsLinks: Bool) -> Outcome {
+
+        let path = followsLinks ? (self.resolve(path) ?? path) : path
+
+        switch self.nodes[path] {
+            case .file(let file):
+                return .attributes(RemoteFileAttributes(size: UInt64(file.data.count), userID: file.userID, groupID: file.groupID,
+                                                        permissions: UInt32(S_IFREG) | file.mode, accessTime: file.modificationTime,
+                                                        modificationTime: file.modificationTime))
+            case .directory(let userID, let groupID, let mode):
+                return .attributes(RemoteFileAttributes(size: 0, userID: userID, groupID: groupID, permissions: UInt32(S_IFDIR) | mode,
+                                                        accessTime: 0, modificationTime: 0))
+            case .link:
+                return .attributes(RemoteFileAttributes(size: 0, userID: self.userID, groupID: self.groupID, permissions: UInt32(S_IFLNK) | 0o777,
+                                                        accessTime: 0, modificationTime: 0))
+            case nil:
+                return .status(.noSuchFile)
+        }
+    }
+
+
+    private func openDirectory(_ path: String) -> Outcome {
+
+        let resolved = self.resolve(path) ?? path
+
+        switch self.nodes[resolved] {
+            case .directory(let userID, _, let mode):
+                let canRead = (userID == self.userID) ? mode & 0o400 != 0 : mode & 0o004 != 0
+                guard canRead else { return .status(.permissionDenied) }
+            case nil:
+                return .status(.noSuchFile)
+            default:
+                // OpenSSH answers so for an item that is not a folder.
+                return .status(.failure)
+        }
+
+        var entries: [(name: Data, attributes: RemoteFileAttributes)] = [
+            (Data(".".utf8), RemoteFileAttributes(permissions: UInt32(S_IFDIR) | 0o755)),
+            (Data("..".utf8), RemoteFileAttributes(permissions: UInt32(S_IFDIR) | 0o755)),
+        ]
+        let children = self.nodes.keys
+            .filter { !RemotePath.isSame($0, resolved) && RemotePath.isSame(RemotePath.parent(of: $0), resolved) }
+            .sorted { $0.utf8.lexicographicallyPrecedes($1.utf8) }
+        for child in children {
+            guard case .attributes(var attributes) = self.plainAttributes(at: child, followsLinks: false) else { continue }
+            if self.omitsListingTypes {
+                attributes.permissions = attributes.permissions.map { $0 & 0o7777 }
+            }
+            entries.append((Data(RemoteFileIdentity.fileName(of: child).utf8), attributes))
+        }
+        for name in self.rawEntries[path] ?? [] {
+            entries.append((name, RemoteFileAttributes(size: 0, permissions: UInt32(S_IFREG) | 0o644)))
+        }
+
+        let handle = Data("handle-\(self.nextHandle)".utf8)
+        self.nextHandle += 1
+        self.handles[handle] = Handle(path: path, flags: 0, entries: entries)
+
+        return .handle(handle)
+    }
+
+
+    private func readDirectory(_ handle: Data) -> Outcome {
+
+        guard var open = self.handles[handle], let entries = open.entries else { return .status(.failure) }
+
+        if self.endlessFolders.contains(open.path) { return .names([]) }
+        guard open.cursor < entries.count else { return .status(.endOfFile) }
+
+        let batch = Array(entries[open.cursor..<min(open.cursor + self.directoryBatchSize, entries.count)])
+        open.cursor += batch.count
+        self.handles[handle] = open
+
+        return .names(batch)
+    }
+
+
+    private func canWrite(_ file: File) -> Bool {
+
+        if file.userID == self.userID { return file.mode & 0o200 != 0 }
+        if file.groupID == self.groupID { return file.mode & 0o020 != 0 }
+        return file.mode & 0o002 != 0
+    }
+
+
+    private func canWriteFolder(of path: String) -> Bool {
+
+        guard case .directory(let userID, _, let mode) = self.nodes[RemotePath.parent(of: path)] else { return false }
+
+        return userID == self.userID ? mode & 0o200 != 0 : mode & 0o002 != 0
+    }
+
+
+    private func open(_ path: String, flags: UInt32, attributes: RemoteFileAttributes) -> Outcome {
+
+        let flags = RemoteOpenFlags(rawValue: flags)
+        let path = self.resolve(path) ?? path
+
+        if let file = self.file(at: path) {
+            if flags.contains(.exclusive) { return .status(.failure) }
+            if flags.contains(.write), !self.canWrite(file) { return .status(.permissionDenied) }
+            if flags.contains(.truncate) {
+                var file = file
+                file.data = Data()
+                self.nodes[path] = .file(file)
+            }
+        } else if self.nodes[path] != nil {
+            return .status(.failure)
+        } else {
+            guard flags.contains(.create) else { return .status(.noSuchFile) }
+            guard self.canWriteFolder(of: path) else { return .status(.permissionDenied) }
+            self.clock += 1
+            self.nodes[path] = .file(File(data: Data(), userID: self.createdUserID ?? self.userID, groupID: self.createdGroupID ?? self.groupID,
+                                          mode: (attributes.permissions ?? 0o644) & 0o7777 & ~self.umask, modificationTime: self.clock))
+        }
+
+        let handle = Data("handle-\(self.nextHandle)".utf8)
+        self.nextHandle += 1
+        self.handles[handle] = Handle(path: path, flags: flags.rawValue)
+
+        return .handle(handle)
+    }
+
+
+    private func read(_ handle: Data, offset: UInt64, length: UInt32) -> Outcome {
+
+        guard let path = self.handles[handle]?.path, let file = self.file(at: path) else { return .status(.failure) }
+        guard offset < UInt64(file.data.count) else { return .status(.endOfFile) }
+
+        let start = Int(offset)
+        let length = min(Int(length), self.maximumReadLength ?? .max)
+        return .data(file.data.subdata(in: start..<min(start + length, file.data.count)))
+    }
+
+
+    private func write(_ handle: Data, offset: UInt64, data: Data) -> Outcome {
+
+        guard
+            let entry = self.handles[handle], entry.flags & RemoteOpenFlags.write.rawValue != 0,
+            var file = self.file(at: entry.path)
+        else { return .status(.failure) }
+
+        let start = Int(offset)
+        if file.data.count < start {
+            file.data.append(Data(count: start - file.data.count))
+        }
+        let end = min(start + data.count, file.data.count)
+        file.data.replaceSubrange(start..<end, with: data)
+        self.clock += 1
+        file.modificationTime = self.clock
+        self.nodes[entry.path] = .file(file)
+
+        return .status(.ok)
+    }
+
+
+    private func setAttributes(_ attributes: RemoteFileAttributes, at path: String, ownershipRequired: Bool = true) -> Outcome {
+
+        guard var file = self.file(at: path) else { return .status(.noSuchFile) }
+        guard !ownershipRequired || file.userID == self.userID else { return .status(.permissionDenied) }
+
+        if let size = attributes.size {
+            file.data = file.data.prefix(Int(size)) + Data(count: max(0, Int(size) - file.data.count))
+        }
+        if let permissions = attributes.permissions {
+            file.mode = permissions & 0o7777
+        }
+        self.nodes[path] = .file(file)
+
+        return .status(.ok)
+    }
+
+
+    /// Renames an item with everything below it, refusing an existing destination unless told to replace it.
+    private func renameRefusingExisting(_ source: String, to destination: String) -> Outcome {
+
+        guard self.nodes[source] != nil else { return .status(.noSuchFile) }
+        guard self.plainRenameReplaces || self.nodes[destination] == nil else { return .status(.failure) }
+        guard self.canWriteFolder(of: source), self.canWriteFolder(of: destination) else { return .status(.permissionDenied) }
+
+        if self.plainRenameReplaces {
+            self.removeTree(destination)
+        }
+        for path in self.nodes.keys where RemotePath.isAncestor(source, of: path) {
+            let rest = RemotePath.relativePath(of: path, in: source) ?? []
+            let moved = rest.reduce(destination) { RemotePath.appending($1, to: $0) }
+            self.nodes[moved] = self.nodes[path]
+            self.nodes[path] = nil
+        }
+
+        return .status(.ok)
+    }
+
+
+    private func rename(_ source: String, to destination: String) -> Outcome {
+
+        guard let node = self.nodes[source] else { return .status(.noSuchFile) }
+        guard self.canWriteFolder(of: source), self.canWriteFolder(of: destination) else { return .status(.permissionDenied) }
+
+        self.nodes[destination] = node
+        self.nodes[source] = nil
+
+        return .status(.ok)
+    }
+}
