@@ -0,0 +1,450 @@
+//
+//  RemoteFolderChanges.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
