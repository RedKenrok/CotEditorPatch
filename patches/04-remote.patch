+
+    func outlineView(_ outlineView: NSOutlineView, draggingSession session: NSDraggingSession, willBeginAt screenPoint: NSPoint, forItems draggedItems: [Any]) {
+
+        self.draggedNode = draggedItems.first as? RemoteDirectoryNode
+    }
+
+
+    func outlineView(_ outlineView: NSOutlineView, draggingSession session: NSDraggingSession, endedAt screenPoint: NSPoint, operation: NSDragOperation) {
+
+        self.draggedNode = nil
+    }
+
+
+    func outlineView(_ outlineView: NSOutlineView, validateDrop info: any NSDraggingInfo, proposedItem item: Any?, proposedChildIndex index: Int) -> NSDragOperation {
+
+        let isInternal = info.draggingSource as? NSOutlineView === self.outlineView
+        guard
+            self.session.status == .online,
+            self.filterText.isEmpty,
+            isInternal ? self.draggedNode != nil : info.draggingPasteboard.canReadObject(forClasses: [NSURL.self], options: [.urlReadingFileURLsOnly: true])
+        else { return [] }
+
+        // A drop between rows or on a file goes into the folder they are in.
+        let root = self.session.tree.root
+        var destination = (item as? RemoteDirectoryNode) ?? (item as? StatusItem)?.node ?? root
+        if destination !== root, !destination.isFolder {
+            destination = destination.parent ?? root
+        }
+        outlineView.setDropItem((destination === root) ? nil : destination, dropChildIndex: NSOutlineViewDropOnItemIndex)
+
+        guard let node = self.draggedNode, isInternal else {
+            return self.session.isChanging(destination) ? [] : .copy
+        }
+        guard
+            destination !== node.parent,
+            destination !== node,
+            !destination.isDescendant(of: node),
+            !self.session.isChanging(destination)
+        else { return [] }
+
+        return .move
+    }
+
+
+    func outlineView(_ outlineView: NSOutlineView, acceptDrop info: any NSDraggingInfo, item: Any?, childIndex index: Int) -> Bool {
+
+        let destination = (item as? RemoteDirectoryNode) ?? self.session.tree.root
+
+        if info.draggingSource as? NSOutlineView === self.outlineView {
+            guard let node = self.draggedNode else { return false }
+            Task {
+                do {
+                    try await self.session.move(node, into: destination)
+                } catch {
+                    self.present(error)
+                }
+            }
+            return true
+        }
+
+        guard
+            let urls = info.draggingPasteboard.readObjects(forClasses: [NSURL.self], options: [.urlReadingFileURLsOnly: true]) as? [URL],
+            !urls.isEmpty
+        else { return false }
+
+        Task {
+            do {
+                try await self.session.upload(urls, into: destination)
+            } catch {
+                self.present(error)
+            }
+        }
+        return true
+    }
+
+
+    // MARK: File Promise Provider Delegate
+
+    nonisolated func filePromiseProvider(_ filePromiseProvider: NSFilePromiseProvider, fileNameForType fileType: String) -> String {
+
+        // The promise's work is on the main queue (`operationQueue(for:)`), as the node's is.
+        nonisolated(unsafe) let provider = filePromiseProvider
+        return MainActor.assumeIsolated {
+            RemotePath.localFileName(for: (provider as? RemoteFilePromiseProvider)?.node?.name ?? "")
+        }
+    }
+
+
+    nonisolated func operationQueue(for filePromiseProvider: NSFilePromiseProvider) -> OperationQueue {
+
+        .main
+    }
+
+
+    nonisolated func filePromiseProvider(_ filePromiseProvider: NSFilePromiseProvider, writePromiseTo url: URL, completionHandler: @escaping ((any Error)?) -> Void) {
+
+        nonisolated(unsafe) let completionHandler = completionHandler
+        nonisolated(unsafe) let provider = filePromiseProvider
+        MainActor.assumeIsolated {
+            guard let node = (provider as? RemoteFilePromiseProvider)?.node else {
+                return completionHandler(CocoaError(.fileNoSuchFile))
+            }
+            Task {
+                do {
+                    let data = try await self.session.download(node)
+                    try data.write(to: url, options: .withoutOverwriting)
+                    completionHandler(nil)
+                } catch {
+                    completionHandler(error)
+                }
+            }
+        }
+    }
+
+
+    // MARK: Outline View Delegate
+
+    func outlineView(_ outlineView: NSOutlineView, viewFor tableColumn: NSTableColumn?, item: Any) -> NSView? {
+
+        let cell = outlineView.makeView(withIdentifier: RemoteFileCellView.identifier, owner: self) as? RemoteFileCellView ?? RemoteFileCellView()
+
+        switch item {
+            case let node as RemoteDirectoryNode:
+                cell.configure(node: node, isOpening: self.session.isOpening(node) || self.session.isBeingChanged(node), isFiltering: !self.filterText.isEmpty,
+                               matchedRange: self.matchedRange(in: node))
+            case let status as StatusItem:
+                cell.configure(status: status, target: self, retryAction: #selector(retryClicked))
+            default:
+                break
+        }
+
+        return cell
+    }
