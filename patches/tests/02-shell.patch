+    @Test(.timeLimit(.minutes(1))) func closingRunningTerminalAsksFirst() async throws {
+
+        try await self.withTerminals(makesWindow: true) { directory, urls, engines, prompts in
+            #expect(await directory.openDocument(at: urls[0]))
