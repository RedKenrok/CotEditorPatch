+
+    func outlineViewItemWillExpand(_ notification: Notification) {
+
+        guard !self.isApplyingExpansion, self.filterText.isEmpty, let node = notification.userInfo?["NSObject"] as? RemoteDirectoryNode else { return }
+
+        // Reloading an expanded row expands it again; only the user's expansion is news for the tree.
+        guard !node.isExpanded else { return }
+
+        self.session.tree.expand(node)
+    }
+
