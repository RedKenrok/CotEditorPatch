+import AppKit
+import SwiftUI
+
+
+/// A sheet that shows a slow remote save or open, and lets the user cancel it or allow it more time.
+///
+/// The sheet appears only once the operation has taken a moment, so quick ones show nothing. A
+/// question the operation asks meanwhile takes its place, and the sheet comes back after it.
+@MainActor final class RemoteProgressSheet {
+
+    /// How long an operation runs before the sheet appears.
+    static let delay: Duration = .seconds(1)
+
+    /// How much more time Allow More Time gives.
+    static let additionalTime: Duration = .seconds(600)
+
+    private static var active: [ObjectIdentifier: RemoteProgressSheet] = [:]
+
+    private let window: NSWindow
+    private let sheet: NSWindow
+    private var isShown = false
+
+
+    private init(window: NSWindow, title: String, control: RemoteOperationControl) {
+
+        self.window = window
+
+        let controller = NSHostingController(rootView: RemoteProgressView(title: title, control: control))
+        controller.sizingOptions = .preferredContentSize
+        self.sheet = NSWindow(contentViewController: controller)
+    }
+
+
+    // MARK: Running
+
+    /// Runs a remote operation with a control of its own, showing the sheet on the window while it is slow.
+    ///
+    /// - Parameters:
+    ///   - title: What the operation does, such as “Saving “index.html”…”.
+    ///   - window: The window to show the sheet on, or `nil` to show none.
+    ///   - operation: The operation.
+    @discardableResult static func run<T>(title: String, window: NSWindow?, _ operation: () async throws -> T) async rethrows -> T {
+
+        let control = RemoteOperationControl()
+
+        var presentation: Task<Void, Never>?
+        var sheet: RemoteProgressSheet?
+        if let window, self.active[ObjectIdentifier(window)] == nil {
+            let progressSheet = RemoteProgressSheet(window: window, title: title, control: control)
+            sheet = progressSheet
+            self.active[ObjectIdentifier(window)] = progressSheet
+            presentation = Task {
+                try? await Task.sleep(for: self.delay)
+                guard !Task.isCancelled else { return }
+                progressSheet.show()
+            }
+        }
+        defer {
+            presentation?.cancel()
+            if let sheet {
+                sheet.hide()
+                self.active[ObjectIdentifier(sheet.window)] = nil
+            }
+        }
+
+        return try await RemoteOperationControl.$current.withValue(control) {
+            try await operation()
+        }
+    }
+
+
+    /// Takes the sheet of the window away while something else asks the user a question.
+    ///
+    /// - Returns: Whether a sheet was taken away, to pass to `reveal(on:)`.
+    static func conceal(on window: NSWindow?) -> Bool {
+
+        guard let window, let sheet = self.active[ObjectIdentifier(window)], sheet.isShown else { return false }
+
+        sheet.hide()
+        return true
+    }
+
+
+    /// Shows the sheet again after `conceal(on:)` took it away, if the operation still runs.
+    static func reveal(on window: NSWindow?, wasConcealed: Bool) {
+
+        guard wasConcealed, let window, let sheet = self.active[ObjectIdentifier(window)] else { return }
+
+        sheet.show()
+    }
+
+
+    // MARK: Private Methods
+
+    private func show() {
+
+        guard !self.isShown else { return }
+
+        // An open sheet, such as the one that asked for the file, gets the progress sheet on top of it.
+        let parent = self.window.attachedSheet ?? self.window
+        guard parent.isVisible else { return }
+
+        self.isShown = true
+        parent.beginSheet(self.sheet)
+    }
+
+
+    private func hide() {
+
+        guard self.isShown else { return }
+
+        self.isShown = false
+        self.sheet.sheetParent?.endSheet(self.sheet)
+    }
+}
+
+
+/// The contents of the progress sheet.
+struct RemoteProgressView: View {
+
+    let title: String
+    let control: RemoteOperationControl
+
+
+    var body: some View {
+
+        TimelineView(.periodic(from: .now, by: 0.2)) { _ in
+            let snapshot = self.control.snapshot
+
+            VStack(alignment: .leading, spacing: 12) {
+                Text(self.title)
+                    .font(.headline)
+
+                if let total = snapshot.totalBytes, total > 0 {
+                    ProgressView(value: Double(min(snapshot.completedBytes, total)), total: Double(total))
+                } else {
+                    ProgressView()
+                        .progressViewStyle(.linear)
+                }
+
+                Text(Self.description(of: snapshot))
+                    .font(.callout)
+                    .foregroundStyle(.secondary)
+                    .monospacedDigit()
+
+                if !snapshot.isCancellable {
+                    Text(String(localized: "RemoteProgress.notCancellable",
+                                defaultValue: "The file on the server is being changed, so this can no longer be canceled.",
+                                table: "Remote"))
+                        .font(.callout)
+                        .foregroundStyle(.secondary)
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+
+                HStack {
+                    Button(String(localized: "RemoteProgress.moreTime", defaultValue: "Allow 10 More Minutes", table: "Remote",
+                                  comment: "button label extending the time limit of a remote save or open")) {
+                        self.control.allowMoreTime(RemoteProgressSheet.additionalTime)
+                    }
+                    .help(String(localized: "RemoteProgress.moreTime.help",
+                                 defaultValue: "A remote save or open stops after 10 minutes unless it is given more time.",
+                                 table: "Remote"))
+                    Spacer()
+                    Button(snapshot.isCancelRequested
+                           ? String(localized: "RemoteProgress.canceling", defaultValue: "Canceling…", table: "Remote", comment: "button label")
+                           : String(localized: "RemoteProgress.cancel", defaultValue: "Cancel", table: "Remote", comment: "button label")) {
+                        self.control.requestCancel()
+                    }
+                    .keyboardShortcut(.cancelAction)
+                    .disabled(!snapshot.isCancellable || snapshot.isCancelRequested)
+                }
+            }
+            .padding(20)
+            .frame(width: 380)
+        }
+    }
+
+
+    /// Describes the phase and how far it is, such as “Uploading: 3.2 MB of 16 MB”.
+    private static func description(of snapshot: RemoteOperationControl.Snapshot) -> String {
+
+        let phase = switch snapshot.phase {
+            case .connecting:
+                String(localized: "RemoteProgress.phase.connecting", defaultValue: "Connecting", table: "Remote")
+            case .downloading:
+                String(localized: "RemoteProgress.phase.downloading", defaultValue: "Downloading", table: "Remote")
+            case .checking:
+                String(localized: "RemoteProgress.phase.checking", defaultValue: "Checking the file on the server", table: "Remote")
+            case .uploading:
+                String(localized: "RemoteProgress.phase.uploading", defaultValue: "Uploading", table: "Remote")
+            case .verifying:
+                String(localized: "RemoteProgress.phase.verifying", defaultValue: "Verifying the upload", table: "Remote")
+            case .committing:
+                String(localized: "RemoteProgress.phase.committing", defaultValue: "Writing the file on the server", table: "Remote")
+        }
+
+        let completed = snapshot.completedBytes.formatted(.byteCount(style: .file))
+        guard let total = snapshot.totalBytes else {
+            return snapshot.completedBytes > 0
+                ? String(localized: "RemoteProgress.progressUnknownTotal", defaultValue: "\(phase): \(completed)", table: "Remote",
+                         comment: "first %@ is the phase, second the bytes transferred so far")
+                : phase
+        }
+
+        return String(localized: "RemoteProgress.progress", defaultValue: "\(phase): \(completed) of \(total.formatted(.byteCount(style: .file)))",
+                      table: "Remote", comment: "first %@ is the phase, then the bytes transferred and the total")
+    }
+}
