+    var closeChoices: [RemoteCloseChoice] = []
+    var consentsToInPlaceSaving = true
+    var conflictChoices: [RemoteConflictChoice] = []
+    var failureChoice: RemoteFailureChoice = .dismiss
+    var confirmsRevert = true
+    var approvesLinks = true
+
+    /// Holds the question about a symbolic link until the gate opens, as a user who takes a while to answer.
+    var linkQuestionGate: FakeGate?
+    var remotePath: String?
+    var confirmsDestinationChange = true
+    var confirmsFolderDestinationChange = true
+    var trustsHostKeys = false
+    private(set) var offeredHostKeys: [RemoteOfferedHostKey] = []
+
+    private(set) var asked: [String] = []
