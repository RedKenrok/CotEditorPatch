+import AppKit
+import SwiftUI
+
+
+// MARK: Main Menu
+
+@MainActor enum TerminalMenu {
+
+    /// Adds the terminal commands to the File menu.
+    ///
+    /// No shortcut is assigned to New Shell Tab: the common ⌃⇧` already moves the focus between
+    /// split editors here. Users can assign one in the Shortcuts settings, since the items exist
+    /// before the key bindings are read.
+    static func install(in mainMenu: NSMenu) {
+
+        guard
+            let fileMenu = mainMenu.items.lazy.compactMap(\.submenu)
+                .first(where: { $0.items.contains { $0.action == #selector(NSWindow.performClose(_:)) } })
+        else { return assertionFailure() }
+
+        if let index = fileMenu.items.firstIndex(where: { $0.action == Selector(("newDocumentAsTab:")) }) {
+            let newTerminal = NSMenuItem(title: String(localized: "TerminalMenu.newTerminalTab", defaultValue: "New Shell Tab", table: "Terminal",
+                                                       comment: "File menu item opening a terminal tab in the folder window"),
+                                         action: #selector(DirectoryDocument.newTerminalTab(_:)), keyEquivalent: "")
+            newTerminal.image = NSImage(systemSymbolName: "apple.terminal", accessibilityDescription: nil)
+            let rename = NSMenuItem(title: String(localized: "TerminalMenu.renameTerminalTab", defaultValue: "Rename Shell Tab…", table: "Terminal",
+                                                  comment: "File menu item"),
+                                    action: #selector(DirectoryDocument.renameTerminalTab(_:)), keyEquivalent: "")
+            fileMenu.insertItem(newTerminal, at: index + 1)
+            fileMenu.insertItem(rename, at: index + 2)
+        }
+    }
+}
+
+
+// MARK: Directory Commands
+
+extension DirectoryDocument {
+
+    @IBAction func newTerminalTab(_ sender: Any?) {
+
+        Task {
+            await self.requestTerminalTab()
+        }
+    }
+
+
+    /// Opens a terminal where the window's root runs them; only a root that does offers a menu item for it.
+    @IBAction func newRootTerminalTab(_ sender: Any?) {
+
+        Task {
+            await self.requestRootTerminalTab()
+        }
+    }
+
+
+    @IBAction func renameTerminalTab(_ sender: Any?) {
+
+        guard let session = self.activeTerminalSession else { return }
+
+        self.rename(session)
+    }
+
+
+    /// Validates the terminal commands.
+    ///
+    /// - Returns: The validation result, or `nil` for other commands.
+    func validateTerminalItem(_ item: any NSValidatedUserInterfaceItem) -> Bool? {
+
+        switch item.action {
+            case #selector(newTerminalTab(_:)):
+                return !self.isClosed
+            case #selector(newRootTerminalTab(_:)):
+                return !self.isClosed && self.root is any TerminalLaunchProviding
+            case #selector(renameTerminalTab(_:)):
+                return self.activeTerminalSession != nil
+            default:
+                return nil
+        }
+    }
+
+
+    /// The commands in a terminal tab's context menu.
+    func terminalContextMenuItems(for session: TerminalSession) -> [DirectoryTabBar.MenuItem] {
+
+        [
+            .init(title: String(localized: "TerminalMenu.rename", defaultValue: "Rename…", table: "Terminal",
+                                comment: "context menu item of a terminal tab")) { [weak self, weak session] in
+                guard let self, let session else { return }
+                self.rename(session)
+            },
+        ]
+    }
+
+
+    private func rename(_ session: TerminalSession) {
+
+        Task {
+            guard let title = await TerminalPrompts.current.askForTitle(current: session.customTitle ?? session.title, window: self.windowForSheet) else { return }
+
+            session.rename(to: title)
+            self.invalidateRestorableState()
+        }
+    }
+}
+
+
+// MARK: Tab Bar
+
+extension DirectoryDocument {
+    
+    /// The entries of the tab strip's “+” menu that open terminal tabs: one on this Mac, and one where
+    /// the window's root runs its terminals, if it does.
+    var newTerminalMenuItems: [DirectoryTabBar.MenuItem] {
+
+        var items: [DirectoryTabBar.MenuItem] = [
+            .init(title: String(localized: "TerminalMenu.newTerminal", defaultValue: "New Shell", table: "Terminal",
+                                comment: "menu item in the tab strip’s add menu"),
+                  systemImage: "apple.terminal") { [weak self] in
+                Task { await self?.requestTerminalTab() }
+            },
+        ]
+        if let provider = self.root as? any TerminalLaunchProviding {
+            items.append(.init(title: provider.terminalMenuItemTitle, systemImage: provider.terminalMenuItemSystemImage) { [weak self] in
+                Task { await self?.requestRootTerminalTab() }
+            })
+        }
+
+        return items
+    }
+
+
+    /// The folder a terminal on this Mac starts in: the window's folder, or the home folder for a window
+    /// whose folder is elsewhere, such as on a server. The tab's tooltip names it, so the shell is not
+    /// mistaken for one in the window's folder.
+    var localTerminalDirectory: URL {
+
+        self.fileURL ?? FileManager.default.homeDirectoryForCurrentUser
+    }
+}
