+// MARK: - Fakes
+
+/// Makes fake engines and keeps them for inspection.
+@MainActor final class FakeTerminalEngines {
+
+    private(set) var made: [FakeTerminalEngine] = []
+    var nextStartError: TerminalLaunchError?
+    
+    /// Makes the view each engine shows, for example a real terminal view for layout tests.
+    var makeView: @MainActor () -> NSView = { NSView() }
+
+
+    var make: @MainActor () -> any TerminalEngine {
+
+        { [unowned self] in
+            let engine = FakeTerminalEngine(startError: self.nextStartError, view: self.makeView())
+            self.nextStartError = nil
+            self.made.append(engine)
+            return engine
+        }
+    }
+}
+
+
+@MainActor final class FakeTerminalEngine: TerminalEngine {
+
+    let view: NSView
+    var focusView: NSView { self.view }
+    var onExit: ((TerminalExitStatus) -> Void)?
+    var onTitleChange: ((String) -> Void)?
+
+    let startError: TerminalLaunchError?
+    private(set) var configurations: [TerminalLaunchConfiguration] = []
+    private(set) var shutDownCount = 0
+
+
+    init(startError: TerminalLaunchError? = nil, view: NSView = NSView()) {
+
+        self.startError = startError
+        self.view = view
+    }
+
+
+    func start(_ configuration: TerminalLaunchConfiguration) throws(TerminalLaunchError) {
+
+        if let startError { throw startError }
+        self.configurations.append(configuration)
+    }
+
+
+    func shutDown() {
+
+        self.shutDownCount += 1
+    }
+
+
+    /// Simulates the shell exiting on its own.
+    func finish(code: Int32) {
+
+        self.onExit?(TerminalExitStatus(code: code))
+    }
+}
