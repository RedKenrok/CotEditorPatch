+// MARK: - Placeholder
+
+/// What a webpage tab shows while it has no page: a new tab, a restored tab, a page whose process
+/// ended, or a first navigation that failed.
+struct WebPagePlaceholderView: View {
+
+    let session: WebPageSession
+    let load: () -> Void
+    let reload: () -> Void
+    let retry: () -> Void
+    let editAddress: () -> Void
+
+
+    var body: some View {
+
+        VStack(spacing: 12) {
+            switch self.session.lifecycle {
+                case .restored:
+                    self.header(systemImage: "globe", title: self.session.title,
+                                message: String(localized: "WebPagePlaceholder.restored.message",
+                                                defaultValue: "Webpages are not loaded again by themselves after CotEditor quits.", table: "WebPages"))
+                    if let url = self.session.restoredURL {
+                        Text(url.absoluteString)
+                            .font(.callout)
+                            .foregroundStyle(.secondary)
+                            .textSelection(.enabled)
+                            .lineLimit(3)
+                    }
+                    Button(String(localized: "WebPagePlaceholder.load", defaultValue: "Load Webpage", table: "WebPages", comment: "button label"),
+                           action: self.load)
+                        .keyboardShortcut(.defaultAction)
+
+                case .contentProcessEnded:
+                    self.header(systemImage: "exclamationmark.triangle",
+                                title: String(localized: "WebPagePlaceholder.processEnded.title", defaultValue: "The webpage stopped", table: "WebPages"),
+                                message: String(localized: "WebPagePlaceholder.processEnded.message",
+                                                defaultValue: "The page and anything entered on it are gone. Reloading loads it again.", table: "WebPages"))
+                    Button(String(localized: "WebPageView.reload", defaultValue: "Reload", table: "WebPages", comment: "button label"),
+                           action: self.reload)
+
+                case .active where self.session.failure != nil:
+                    let failure = self.session.failure!
+                    self.header(systemImage: "exclamationmark.triangle",
+                                title: String(localized: "WebPagePlaceholder.failed.title", defaultValue: "The webpage couldn’t be opened", table: "WebPages"),
+                                message: failure.description)
+                    if failure.isRetryable {
+                        Button(String(localized: "WebPageView.retry", defaultValue: "Try Again", table: "WebPages", comment: "button label"),
+                               action: self.retry)
+                    }
+
+                default:
+                    self.header(systemImage: "globe",
+                                title: String(localized: "WebPagePlaceholder.empty.title", defaultValue: "Enter a website address", table: "WebPages"),
+                                message: String(localized: "WebPagePlaceholder.empty.message",
+                                                defaultValue: "HTTPS addresses open anywhere. HTTP works for local development servers, such as http://localhost:3000.",
+                                                table: "WebPages"))
+                    Button(String(localized: "WebPagePlaceholder.editAddress", defaultValue: "Edit Address", table: "WebPages", comment: "button label"),
+                           action: self.editAddress)
+            }
+        }
+        .padding(24)
+        .frame(maxWidth: 480)
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+        .accessibilityElement(children: .contain)
+    }
+
+
+    private func header(systemImage: String, title: String, message: String) -> some View {
+
+        VStack(spacing: 8) {
+            Image(systemName: systemImage)
+                .font(.system(size: 36))
+                .foregroundStyle(.secondary)
+                .accessibilityHidden(true)
+            Text(title)
+                .font(.headline)
+                .multilineTextAlignment(.center)
+            Text(message)
+                .foregroundStyle(.secondary)
+                .multilineTextAlignment(.center)
+        }
+    }
+}
