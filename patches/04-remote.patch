+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// The terminals of a remote folder window: a shell on the window's server, in the window's folder.
+enum RemoteTerminalCommand {
+
+    /// The status with which the command ends if the folder cannot be entered, so that no shell starts anywhere else.
+    static let folderFailureStatus: Int32 = 97
+
+    /// Decodes the folder's path, enters the folder, and runs the account's shell as a login shell.
+    ///
+    /// `ssh` joins its command into one string, which the server runs with the account's login shell,
+    /// whose kind CotEditor cannot know: sh, bash, zsh, fish and csh each quote differently. So this
+    /// script contains no backslash, single quote or `!`, which lets every one of them pass it to
+    /// `/bin/sh` unchanged in single quotes, and the path comes as hexadecimal digits, which no shell
+    /// treats specially. `awk` turns the digits back into the path's bytes, in the C locale so that each
+    /// value is one byte; a path never holds a control character, so none is lost to the command
+    /// substitution.
+    static let script = [
+        #"d=$(LC_ALL=C awk -v h="$1" -v x=0123456789abcdef -v f=%c "#
+            + #""BEGIN{for(i=1;i<length(h);i+=2)printf(f,(index(x,substr(h,i,1))-1)*16+index(x,substr(h,i+1,1))-1)}")"#,
+        #"&& cd -- "$d" && exec "$SHELL" -l"#,
+        "; echo \"CotEditor: the folder could not be entered on the server.\" >&2",
+        "; exit \(folderFailureStatus)",
+    ].joined(separator: " ")
+
+
+    /// The command `ssh` runs on the server to start the shell in the folder.
+    static func remoteCommand(forFolder path: String) -> String {
+
+        "exec /bin/sh -c '\(self.script)' sh \(self.hexadecimal(path))"
+    }
+
+
+    /// The bytes of a path as lower-case hexadecimal digits.
+    static func hexadecimal(_ path: String) -> String {
+
+        path.utf8.map { String(format: "%02x", $0) }.joined()
+    }
+}
+
+
+// MARK: - Folder Window
+
+extension RemoteFolderSession: TerminalLaunchProviding {
+
+    var terminalMenuItemTitle: String {
+
+        String(localized: "RemoteTerminal.menuItem", defaultValue: "Remote Shell", table: "Remote",
+               comment: "menu item in the tab strip’s add menu that opens a shell on the server of a remote folder window")
+    }
+
+
+    var terminalMenuItemSystemImage: String  { "terminal" }
+
+
+    /// Prepares a terminal on the window's server, in its folder.
+    ///
+    /// The destination is checked first: if the SSH configuration now leads elsewhere, no terminal
+    /// starts, and Reconnect reviews the change. Each terminal is its own `ssh` connection, apart from
+    /// the pool, so that neither delays nor ends the other.
+    func makeTerminalLauncher(for directory: DirectoryDocument) async throws -> TerminalLauncher {
+
+        switch self.status {
+            case .unavailable, .changedLocation: throw RemoteFolderLocationError.folderUnavailable
+            case .online, .connecting, .offline: break
+        }
+
+        let identity = self.identity
+        let environment = self.environment
+        let overrides = environment.sshOverrides
+
+        let configuration = try await environment.pool.configuration(for: identity.endpoint)
+        guard configuration.destination == identity.destination else { throw RemoteFolderLocationError.destinationChanged }
+        // The first jump host is reached as its own configuration says, so it must not pass through another.
+        let jumpHosts = configuration.jumpHosts ?? []
+        if let first = jumpHosts.first, try await environment.pool.configuration(for: first).destination.route != nil {
+            throw RemoteConnectionError.proxyUnsupported
+        }
+
+        let arguments = RemoteSSHCommand.terminalArguments(for: identity.endpoint, through: jumpHosts,
+                                                           command: RemoteTerminalCommand.remoteCommand(forFolder: identity.path), overrides: overrides)
+
+        return TerminalLauncher(location: identity.displayLocation) {
+            // The askpass program is looked up at each start, since who answers can change meanwhile.
+            let variables = RemoteSSHCommand.environment(from: ProcessInfo.processInfo.environment, askpass: RemoteSSHCommand.askpass(overrides).environment)
+                .merging(["TERM": "xterm-256color"]) { $1 }
+
+            return TerminalLaunchConfiguration(executable: RemoteSSHCommand.executableURL.path(percentEncoded: false), argv0: "ssh", arguments: arguments,
+                                               environment: variables.map { "\($0.key)=\($0.value)" }.sorted(),
+                                               currentDirectory: FileManager.default.homeDirectoryForCurrentUser.path(percentEncoded: false))
+        }
+    }
+}
