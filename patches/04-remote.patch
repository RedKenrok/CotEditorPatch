+import AppKit
+import OSLog
+import UniformTypeIdentifiers
+import FileEncoding
+import LineEnding
+
+
+/// When unsent edits are written to the recovery record.
+struct RemoteRecoveryTiming: Sendable {
+
+    /// How long editing must pause before the edits are written.
+    var debounce: Duration = .seconds(1)
+
+    /// The longest continuous editing may go without a write.
+    var maximumDelay: Duration = .seconds(5)
+
+
+    /// When to write, given when the first unwritten change and the latest change happened.
+    func deadline(firstChange: ContinuousClock.Instant, latestChange: ContinuousClock.Instant) -> ContinuousClock.Instant {
+
+        min(latestChange + self.debounce, firstChange + self.maximumDelay)
+    }
+}
+
+
+/// A document whose file is on an SSH server.
+///
+/// Its `fileURL` is always `nil`. With a local cache file as its URL, AppKit and CotEditor would treat
+/// that cache as the real file: save to it, watch it, list it in Open Recent, and offer it to Reveal
+/// in Finder, Rename, Move To, Lock, Versions and Share. Without a URL none of that applies, and the
+/// few things that need a replacement are overridden here: the display name, saving, autosaving,
+/// closing and reverting.
+///
+/// The editor's text is "edited" until the server has confirmed it. Unsent edits are kept in the
+/// document's recovery record, never in AppKit's autosave files, and writing them there never clears
+/// the edited state.
+final class RemoteDocument: Document {
+
+    /// What the document is for.
+    enum Role: Sendable {
+
+        /// Editing the remote file.
+        case editor
+        /// Showing a version of the remote file that the user wants to review, read-only.
+        case remoteVersion
+        /// Standing in for a restored tab whose recovery data is gone, until the user reconnects.
+        case placeholder
+    }
+
+
+    /// How the user decided to close the document.
+    enum CloseDecision {
+
+        case keep
+        case discard
+    }
+
+
+    struct DidChangeStateMessage: NotificationCenter.MainActorMessage {
+
+        typealias Subject = RemoteDocument
+    }
+
+
+    // MARK: Public Properties
+
+    let documentID: UUID
+    let role: Role
+    let environment: RemoteEnvironment
+    private(set) var identity: RemoteFileIdentity
+    private(set) var record: RemoteRecoveryRecord?
+
+    /// The latest recorded state of the record, for display.
+    private(set) var manifest: RemoteRecoveryManifest?
+
+    /// Counts every change of text or settings, including undo, so that recovery writes are ordered.
+    private(set) var generation = 0
+
+    /// The latest generation that is durable in the recovery record.
+    private(set) var durableGeneration = 0
+
+    /// Why the latest edits could not be made durable, if they could not.
+    private(set) var recoveryError: (any Error)?
+
+    private(set) lazy var saveCoordinator = RemoteSaveCoordinator(document: self)
+
+
+    // MARK: Private Properties
+
+    private var closeDecision: CloseDecision?
+    private var firstUnwrittenChange: ContinuousClock.Instant?
+    private var recoveryTask: Task<Void, Never>?
+    private var settingsTask: Task<Void, Never>?
+    private var textObserver: (any NSObjectProtocol)?
+    private var hasReportedRecoveryFailure = false
+    private var isClosing = false
+
+
+    // MARK: Lifecycle
+
+    /// Creates a document for downloaded or recovered contents.
+    ///
+    /// - Parameters:
+    ///   - identity: The remote file.
+    ///   - documentID: The ID of the recovery record, or a new one for a remote version.
+    ///   - record: The recovery record, or `nil` for a remote version, which has none.
+    ///   - role: What the document is for.
+    ///   - contents: The file's bytes, decoded as a local file would be.
+    ///   - environment: The services the document works with.
+    init(identity: RemoteFileIdentity, documentID: UUID, record: RemoteRecoveryRecord?, role: Role, contents: Data, environment: RemoteEnvironment) throws {
+
+        self.identity = identity
+        self.documentID = documentID
+        self.record = record
+        self.role = role
+        self.environment = environment
+
+        super.init()
+
+        try self.load(contents)
+        if role != .editor {
+            self.isEditable = false
+        }
+        self.startObservingChanges()
+    }
+
+
+    /// A stand-in for a restored tab whose recovery data is gone. Nothing is downloaded until the user reconnects.
+    static func placeholder(identity: RemoteFileIdentity, documentID: UUID, environment: RemoteEnvironment) -> RemoteDocument? {
+
+        try? RemoteDocument(identity: identity, documentID: documentID, record: nil, role: .placeholder, contents: Data(), environment: environment)
+    }
+
+
+    // MARK: Document Methods
+
+
+    // AppKit writes no draft for a document without a file; unsent edits live in the recovery record.
+    override static var autosavesDrafts: Bool  { false }
+
+
+    override var displayName: String! {
+
+        get {
+            switch self.role {
+                case .editor:
+                    self.identity.fileName
+                case .remoteVersion:
+                    String(localized: "RemoteDocument.remoteVersionName", defaultValue: "\(self.identity.fileName) (Server Version)",
+                           table: "Remote", comment: "name of a read-only copy of the version on the server (%@ is the file name)")
+                case .placeholder:
+                    String(localized: "RemoteDocument.placeholderName", defaultValue: "\(self.identity.fileName) (Not Downloaded)",
+                           table: "Remote", comment: "name of a restored remote tab whose local copy is gone (%@ is the file name)")
+            }
+        }
+        set { }
+    }
+
+
+    override func save(withDelegate delegate: Any?, didSave didSaveSelector: Selector?, contextInfo: UnsafeMutableRawPointer?) {
+
+        let context = DelegateContext(delegate: delegate, selector: didSaveSelector, contextInfo: contextInfo)
+
+        guard self.role == .editor else { return context.perform(from: self, flag: false) }
+
+        Task {
+            context.perform(from: self, flag: await self.saveCoordinator.save())
+        }
+    }
+
+
+    @IBAction override func saveAs(_ sender: Any?) {
+
+        guard self.role == .editor else { return }
+
+        Task {
+            await self.saveCoordinator.saveAsRemote()
+        }
+    }
+
+
+    override func autosave(withImplicitCancellability autosavingIsImplicitlyCancellable: Bool, completionHandler: @escaping (any Error?) -> Void) {
+
+        // Autosaving means local recovery; only an explicit Save uploads.
+        //
+        // A failure is reported by the document itself, once per streak of failures. Only an autosave
+        // that cannot be canceled, such as when the app quits, also hands the error to AppKit, so that
+        // AppKit can stop what it was doing; for routine autosaves it would show a second, generic alert.
+        let reportsError = !autosavingIsImplicitlyCancellable
+
+        guard self.role == .editor, self.record != nil, self.generation > self.durableGeneration else {
+            return completionHandler(reportsError ? self.recoveryError : nil)
+        }
+
+        Task {
+            let succeeded = await self.flushRecovery()
+            completionHandler(succeeded || !reportsError ? nil : self.recoveryError)
+        }
+    }
+
+
+    override func canClose(withDelegate delegate: Any, shouldClose shouldCloseSelector: Selector?, contextInfo: UnsafeMutableRawPointer?) {
+
+        let context = DelegateContext(delegate: delegate, selector: shouldCloseSelector, contextInfo: contextInfo)
+
+        Task {
+            context.perform(from: self, flag: await self.reviewClose())
+        }
+    }
+
+
+    override func makeWindowControllers() {
+
+        super.makeWindowControllers()
+
+        // AppKit can reopen only documents with a file or an autosave draft. A window of its own is
+        // reopened from the recovery record instead, so AppKit must not try to restore it.
+        for windowController in self.windowControllers {
+            windowController.window?.isRestorable = false
+        }
+    }
+
+
+    override func close() {
+
+        // Closing the document's own window closes the document again from within `super.close()`.
+        guard !self.isClosing else { return super.close() }
+        self.isClosing = true
+
+        let decision = self.closeDecision
+        let hasUnsentChanges = self.hasUnsentChanges
+
+        super.close()
+
+        self.recoveryTask?.cancel()
+        self.settingsTask?.cancel()
+        if let textObserver {
+            NotificationCenter.default.removeObserver(textObserver)
+        }
+        RemoteDocumentRegistry.shared.unregister(self)
+
+        guard let record else { return }
+
+        Task {
+            await Self.dispose(record, decision: decision, hasUnsentChanges: hasUnsentChanges)
+        }
+    }
+
+
+    override func duplicate() throws -> NSDocument {
+
+        // The document controller makes the duplicate from the document class of the file type, so it is
+        // an ordinary untitled document with the text and editor settings, without a link to the server.
+        let duplicate = try super.duplicate()
+        assert(!(duplicate is RemoteDocument))
+
+        return duplicate
+    }
+
+
+    override func validateUserInterfaceItem(_ item: any NSValidatedUserInterfaceItem) -> Bool {
+
+        switch item.action {
+            case #selector(showInFinder),
+                 #selector(shareDocument),
+                 #selector(NSDocument.rename(_:)),
+                 #selector(NSDocument.move(_:)),
+                 #selector(NSDocument.lock(_:)),
+                 #selector(NSDocument.unlock(_:)),
+                 #selector(NSDocument.browseVersions(_:)),
+                 #selector(NSDocument.revertToSaved(_:)):
+                return false
+
+            case #selector(copyPath):
+                return true
+
+            case #selector(NSDocument.save(_:)),
+                 #selector(NSDocument.saveAs(_:)):
+                return self.role == .editor
+
+            case #selector(revertToRemoteVersion):
+                if let item = item as? NSMenuItem {
+                    item.title = (self.role == .placeholder)
+                        ? String(localized: "RemoteMenu.reconnect", defaultValue: "Reconnect", table: "Remote", comment: "menu item label")
+                        : String(localized: "RemoteMenu.revertToRemoteVersion", defaultValue: "Revert to Remote Version", table: "Remote",
+                                 comment: "menu item label")
+                }
+                return self.role != .remoteVersion && !self.saveCoordinator.isBusy
+
+            case #selector(saveLocalCopy):
+                return true
+
+            default:
+                return super.validateUserInterfaceItem(item)
+        }
+    }
+
+
+    // MARK: Presentation
+
+    override var tabToolTip: String  { self.identity.displayLocation }
+
+    override var tabIcon: NSImage?  { NSWorkspace.shared.icon(for: self.contentType) }
+
+    override var subtitleName: String  { self.displayName }
+
+    override var standaloneWindowSubtitle: String?  { self.identity.connectionName }
+
+    override var tabArchiveRepresentation: (kind: String, fields: [String: Any])? {
+
+        guard self.role != .remoteVersion else { return nil }
+
+        return (RemoteTabArchive.kind, RemoteTabArchive.fields(for: self))
+    }
+
+
+    // MARK: Actions
+
+    /// Copies the location in the form `user@host:/path`.
+    @IBAction override func copyPath(_ sender: Any?) {
+
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(self.identity.displayLocation, forType: .string)
+    }
+
+
+    /// Discards the edits, after asking, and downloads the file again; a placeholder downloads it for the first time.
+    @IBAction func revertToRemoteVersion(_ sender: Any?) {
+
+        Task {
+            if self.role == .placeholder {
+                await RemoteOpenCoordinator.reconnect(self)
+            } else {
+                await self.revertToRemote()
+            }
+        }
+    }
+
+
+    /// Saves the text to a local file, leaving the remote file and the unsent edits as they are.
+    @IBAction func saveLocalCopy(_ sender: Any?) {
+
+        self.saveTo(sender)
+    }
+
+
+    // MARK: Recovery
+
+    /// The settings that decide how the text is encoded.
+    var textSettings: RemoteTextSettings {
+
+        RemoteTextSettings(encoding: self.fileEncoding.encoding.rawValue, hasUTF8BOM: self.fileEncoding.withUTF8BOM,
+                           lineEnding: self.lineEnding.index, syntaxName: self.syntaxName)
+    }
+
+
+    /// Whether anything is not confirmed on the server: edits, or an operation whose outcome is unknown.
+    var hasUnsentChanges: Bool {
+
+        self.role == .editor && (self.isDocumentEdited || self.hasUnresolvedOperation)
+    }
+
+
+    /// Whether a save's outcome is unknown, for this file or for one the document edited before Save As Remote.
+    var hasUnresolvedOperation: Bool {
+
+        self.manifest?.operation?.mayHaveChangedTarget == true || self.manifest?.detachedOperations.isEmpty == false
+    }
+
+
+    /// Writes the latest text generation to the recovery record.
+    ///
+    /// - Returns: `true` if the generation current when this returns is durable.
+    @discardableResult func flushRecovery() async -> Bool {
+
+        guard self.role == .editor, let record = self.record else { return true }
+
+        self.firstUnwrittenChange = nil
+        self.recoveryTask?.cancel()
+
+        let generation = self.generation
+        guard generation > self.durableGeneration else { return self.recoveryError == nil }
+
+        let string = self.textStorage.string
+        let settings = self.textSettings
+        do {
+            try await record.writeText(string, settings: settings, generation: generation)
+            self.durableGeneration = max(self.durableGeneration, generation)
+            if self.durableGeneration >= self.generation {
+                self.recoveryError = nil
+                self.hasReportedRecoveryFailure = false
+            }
+            await self.refreshManifest()
+        } catch {
+            self.recoveryError = error
+            self.saveStateDidChange()
+            self.reportRecoveryFailure(error)
+            return false
+        }
+
+        return self.durableGeneration >= self.generation
+    }
+
+
+    /// Writes generations until the latest one is durable, as closing with Keep Recovery Copy requires.
+    ///
+    /// - Returns: `false` if a write failed; the previous durable generation is then still intact.
+    func persistLatestGeneration() async -> Bool {
+
+        while self.durableGeneration < self.generation {
+            guard await self.flushRecovery() else { return false }
+        }
+
+        return true
+    }
+
+
+    // MARK: Internal Methods
+
+    /// Asks what to do with unsent changes before closing.
+    ///
+    /// - Returns: `true` if the document may close.
+    func reviewClose() async -> Bool {
+
+        guard self.role == .editor else { return true }
+
+        // A save that runs now decides whether anything is still unsent.
+        await self.saveCoordinator.waitUntilIdle()
+        await self.refreshManifest()
+
+        while self.hasUnsentChanges {
+            let hasUnresolvedOperation = self.hasUnresolvedOperation
+
+            let choice = await self.environment.prompts.reviewClose(fileName: self.identity.fileName, hasUnresolvedOperation: hasUnresolvedOperation, window: self.windowForSheet)
+            switch choice {
+                case .save:
+                    guard await self.saveCoordinator.save() else { return false }
+                    // Edits made during the save are asked about again.
+                    await self.refreshManifest()
+
+                case .keepRecoveryCopy:
+                    guard await self.persistLatestGeneration() else { return false }
+                    self.closeDecision = .keep
+                    return true
+
+                case .discard:
+                    // The record goes only when the close actually happens; a later Cancel keeps it.
+                    self.closeDecision = .discard
+                    return true
+
+                case .cancel:
+                    self.closeDecision = nil
+                    return false
+            }
+        }
+
+        self.closeDecision = nil
+        return true
+    }
+
+
+    /// Makes the document edit the file at a new identity, after Save As Remote or a destination change.
+    func adoptIdentity(_ identity: RemoteFileIdentity) {
+
+        RemoteDocumentRegistry.shared.unregister(self)
+        self.identity = identity
+        RemoteDocumentRegistry.shared.register(self)
+
+        self.windowController?.synchronizeWindowTitleWithDocumentName()
+        self.directoryDocument?.windowController?.synchronizeWindowTitleWithDocumentName()
+        self.directoryDocument?.invalidateRestorableState()
+        self.saveStateDidChange()
+    }
+
+
+    /// Marks the editor saved if its text encodes to the baseline, as after reconciling following a relaunch.
+    func synchronizeEditedStateWithBaseline() {
+
+        Task {
+            guard let data = try? await self.record?.baselineData() else { return }
+            if self.encodedContents() == data {
+                self.updateChangeCount(.changeCleared)
+            }
+        }
+    }
+
+
+    /// Notes that a save reached the server.
+    func didConfirmSave() {
+
+        self.closeDecision = nil
+        Task { await self.refreshManifest() }
+    }
+
+
+    /// Updates the displayed state after a save started or ended.
+    func saveStateDidChange() {
+
+        NotificationCenter.default.post(DidChangeStateMessage(), subject: self)
+    }
+
+
+    /// Presents an error whose recovery options may allow saving anyway.
+    ///
+    /// - Returns: `true` if the user chose a recovery option that allows trying again.
+    func presentErrorForRecovery(_ error: any Error) async -> Bool {
+
+        await withCheckedContinuation { continuation in
+            self.presentErrorAsSheet(error) { didRecover in
+                continuation.resume(returning: didRecover)
+            }
+        }
+    }
+
+
+    /// Stores the conflicting remote version as reviewed and opens it read-only next to the document.
+    func openRemoteVersion(_ conflict: RemoteConflict) async {
+
+        guard let data = conflict.remoteData else { return }
+
+        do {
+            try await self.markReviewed(data)
+            let version = try RemoteDocument(identity: self.identity, documentID: UUID(), record: nil, role: .remoteVersion, contents: data, environment: self.environment)
+            RemoteOpenCoordinator.present(version, beside: self)
+        } catch {
+            self.presentErrorAsSheet(error)
+        }
+    }
+
+
+    /// Records that the user reviewed a remote version, which a later Replace or repair may then overwrite.
+    ///
+    /// The bytes are kept on this Mac before anything overwrites them.
+    func markReviewed(_ data: Data) async throws {
+
+        _ = try await self.record?.storeReviewedVersion(data)
+        await self.refreshManifest()
+    }
+
+
+    /// Discards the edits, after asking, and downloads the file again.
+    func revertToRemote() async {
+
+        guard self.role == .editor, let record else { return }
+
+        await self.refreshManifest()
+        guard self.manifest?.operation?.mayHaveChangedTarget != true else {
+            return self.presentErrorAsSheet(RemoteSaveError.outcomeUnknown)
+        }
+        if self.isDocumentEdited {
+            guard await self.environment.prompts.confirmRevert(fileName: self.identity.fileName, window: self.windowForSheet) else { return }
+        }
+
+        do {
+            let title = String(localized: "RemoteProgress.reverting", defaultValue: "Downloading “\(self.identity.fileName)”…", table: "Remote",
+                               comment: "title of the progress sheet while the server's version of a remote file is downloaded (%@ is the file name)")
+            let contents = try await RemoteProgressSheet.run(title: title, window: self.windowForSheet) {
+                try await self.saveCoordinator.downloadCurrentVersion()
+            }
+            try await record.adoptRemoteVersion(contents.data, attributes: contents.attributesAfter)
+            self.undoManager?.removeAllActions()
+            try self.load(contents.data)
+            self.updateChangeCount(.changeCleared)
+            self.durableGeneration = self.generation
+            await self.refreshManifest()
+        } catch is RemoteOperationCanceled {
+            return
+        } catch {
+            self.presentErrorAsSheet(error)
+        }
+    }
+
+
+    /// Applies recovered text and settings on top of the loaded baseline.
+    ///
+    /// The document is edited if the recovered text encodes to something other than the baseline.
+    func applyRecoveredText(_ string: String, settings: RemoteTextSettings, generation: Int, baseline: Data) {
+
+        self.undoManager?.disableUndoRegistration()
+        defer { self.undoManager?.enableUndoRegistration() }
+
+        let encoding = FileEncoding(encoding: String.Encoding(rawValue: settings.encoding),
+                                    withUTF8BOM: settings.hasUTF8BOM && String.Encoding(rawValue: settings.encoding) == .utf8)
+        if encoding != self.fileEncoding {
+            self.changeEncoding(to: encoding)
+        }
+        if let lineEnding = LineEnding.allCases[safe: settings.lineEnding], lineEnding != self.lineEnding {
+            self.changeLineEnding(to: lineEnding)
+        }
+        if settings.syntaxName != self.syntaxName {
+            self.setSyntax(name: settings.syntaxName)
+        }
+        if string != self.textStorage.string {
+            self.textStorage.replaceCharacters(in: NSRange(location: 0, length: (self.textStorage.string as NSString).length), with: string)
+        }
+
+        self.generation = max(self.generation, generation)
+        self.durableGeneration = self.generation
+        if self.encodedContents() != baseline {
+            self.updateChangeCount(.changeDone)
+        }
+    }
+
+
+    /// Reads the record's manifest again for display.
+    func refreshManifest() async {
+
+        self.manifest = await self.record?.manifest
+        self.saveStateDidChange()
+    }
+
+
+    // MARK: Private Methods
+
+    /// The content type that the remote file name suggests.
+    private var contentType: UTType {
+
+        UTType(filenameExtension: (self.identity.fileName as NSString).pathExtension) ?? .plainText
+    }
+
+
+    /// Decodes bytes into the editor as upstream decodes a file, choosing the syntax from the remote name.
+    ///
+    /// The bytes go through a private temporary file named after the remote file, because the decoding
+    /// reads from a URL and takes the syntax from its name. The file is removed right away and is never
+    /// the document's file.
+    private func load(_ contents: Data) throws {
+
+        let folder = FileManager.default.temporaryDirectory.appending(component: "RemoteDocument-" + UUID().uuidString, directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        defer { try? FileManager.default.removeItem(at: folder) }
+
+        let url = folder.appending(component: RemotePath.localFileName(for: self.identity.fileName), directoryHint: .notDirectory)
+        try contents.write(to: url, options: .withoutOverwriting)
+
+        self.fileType = self.contentType.identifier
+        try self.read(from: url, ofType: self.contentType.identifier)
+    }
+
+
+    private func startObservingChanges() {
+
+        guard self.role == .editor else { return }
+
+        self.textObserver = NotificationCenter.default.addObserver(forName: NSTextStorage.didProcessEditingNotification,
+                                                                   object: self.textStorage, queue: .main)
+        { [weak self] notification in
+            guard (notification.object as? NSTextStorage)?.editedMask.contains(.editedCharacters) == true else { return }
+            MainActor.assumeIsolated {
+                self?.noteChange()
+            }
+        }
+
+        self.settingsTask = Task { [weak self] in
+            guard let self else { return }
+            var isFirst = true
+            for await _ in Observations({ (self.fileEncoding, self.lineEnding, self.syntaxName) }) {
+                // the first value is the current one, not a change
+                if isFirst {
+                    isFirst = false
+                    continue
+                }
+                self.noteChange()
+            }
+        }
+    }
+
+
+    /// Counts a change of text or settings and schedules writing it to the recovery record.
+    private func noteChange() {
+
+        self.generation += 1
+        self.closeDecision = nil
+
+        let now = ContinuousClock.now
+        let firstChange = self.firstUnwrittenChange ?? now
+        self.firstUnwrittenChange = firstChange
+        let deadline = self.environment.recoveryTiming.deadline(firstChange: firstChange, latestChange: now)
+
+        self.recoveryTask?.cancel()
+        self.recoveryTask = Task { [weak self] in
+            try? await Task.sleep(until: deadline)
+            guard !Task.isCancelled else { return }
+            await self?.flushRecovery()
+        }
+    }
+
+
+    /// Tells the user once per failure streak that newer edits are not protected.
+    private func reportRecoveryFailure(_ error: any Error) {
+
+        guard !self.hasReportedRecoveryFailure else { return }
+
+        // Reported again only after a write has succeeded in between.
+        self.hasReportedRecoveryFailure = true
+        Task {
+            await self.environment.prompts.reportRecoveryFailure(error, fileName: self.identity.fileName, window: self.windowForSheet)
+        }
+    }
+
+
+    /// Deletes or keeps a closed document's record.
+    ///
+    /// A record is deleted only when it holds nothing unsent and no operation with an unknown outcome,
+    /// or when the user discarded its changes. A clean record of a document closed while the app quits
+    /// is kept, so that the window can come back.
+    private static func dispose(_ record: RemoteRecoveryRecord, decision: CloseDecision?, hasUnsentChanges: Bool) async {
+
+        let manifest = await record.manifest
+        let isUnresolved = manifest.operation?.mayHaveChangedTarget == true || !manifest.detachedOperations.isEmpty
+        let removes = !isUnresolved && (decision == .discard || (!hasUnsentChanges && !RemoteTermination.isInProgress))
+
+        do {
+            if removes {
+                try await record.remove()
+            } else {
+                try await record.setPresentation(isOpen: RemoteTermination.isInProgress && decision == nil,
+                                                 keepsAfterClose: hasUnsentChanges || isUnresolved)
+                await record.relinquish()
+            }
+        } catch {
+            Logger.app.error("Failed to dispose of a remote recovery record: \(error)")
+            await record.relinquish()
+        }
+    }
+}
+
+
+/// Whether the app is quitting, so that closing documents keeps what restoration needs.
+@MainActor enum RemoteTermination {
+
+    static var isInProgress = false
+}
