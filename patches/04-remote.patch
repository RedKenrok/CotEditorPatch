+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+
+
+/// Why a change to a remote folder was not made, or may not have been.
+enum RemoteItemChangeError: Error, Equatable {
+
+    /// The name cannot be one component of a path.
+    case invalidName(String)
+    /// An item with the name exists in the folder.
+    case nameTaken(String)
+    /// Every numbered variant of the name is taken.
+    case noAvailableName(String)
+    /// An open file would be affected while it has changes that are not on the server, or while it is being saved or opened.
+    case fileInUse(String)
+    /// Another change of the item, or of a folder above or below it, is under way.
+    case changeUnderWay(String)
+    /// The folder to delete could not be listed completely, so nothing in it was deleted.
+    case incompleteFolder(String)
+    /// Some dropped items were not uploaded, since only files and folders within the limits are.
+    case notUploaded([String])
+    /// The window is offline.
+    case offline
+    /// The connection ended before the server answered, so whether the change was made is not known.
+    case outcomeUnknown
+}
+
+
+extension RemoteItemChangeError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .invalidName(let name):
+                String(localized: "RemoteItemChangeError.invalidName", defaultValue: "“\(name)” can’t be used as a name on the server.", table: "Remote",
+                       comment: "%@ is the name the user entered")
+            case .nameTaken(let name):
+                String(localized: "RemoteItemChangeError.nameTaken", defaultValue: "An item named “\(name)” already exists in this folder.", table: "Remote",
+                       comment: "%@ is a file name")
+            case .noAvailableName(let name):
+                String(localized: "RemoteItemChangeError.noAvailableName", defaultValue: "No free name like “\(name)” was found in this folder.", table: "Remote",
+                       comment: "%@ is a file name")
+            case .fileInUse(let name):
+                String(localized: "RemoteItemChangeError.fileInUse", defaultValue: "“\(name)” has changes that are not on the server, or is being saved or opened.",
+                       table: "Remote", comment: "%@ is a file name")
+            case .changeUnderWay(let name):
+                String(localized: "RemoteItemChangeError.changeUnderWay", defaultValue: "“\(name)” is already being changed.", table: "Remote",
+                       comment: "%@ is a file name")
+            case .incompleteFolder(let name):
+                String(localized: "RemoteItemChangeError.incompleteFolder",
+                       defaultValue: "The contents of “\(name)” could not all be listed, so nothing in it was deleted.", table: "Remote",
+                       comment: "%@ is a folder name")
+            case .notUploaded(let names):
+                String(localized: "RemoteItemChangeError.notUploaded", defaultValue: "These items were not uploaded: \(names.formatted(.list(type: .and)))", table: "Remote",
+                       comment: "%@ is a list of file names")
+            case .offline:
+                String(localized: "RemoteItemChangeError.offline", defaultValue: "The folder is offline.", table: "Remote")
+            case .outcomeUnknown:
+                String(localized: "RemoteItemChangeError.outcomeUnknown",
+                       defaultValue: "The connection ended before the server answered, so it is not known whether the change was made.", table: "Remote")
+        }
+    }
+
+
+    var recoverySuggestion: String? {
+
+        switch self {
+            case .invalidName:
+                String(localized: "RemoteItemChangeError.invalidName.recoverySuggestion",
+                       defaultValue: "Use a name without “/” or control characters, other than “.” and “..”.", table: "Remote")
+            case .nameTaken, .noAvailableName:
+                String(localized: "RemoteItemChangeError.nameTaken.recoverySuggestion", defaultValue: "Choose another name.", table: "Remote")
+            case .fileInUse:
+                String(localized: "RemoteItemChangeError.fileInUse.recoverySuggestion", defaultValue: "Save or close it first.", table: "Remote")
+            case .changeUnderWay:
+                String(localized: "RemoteItemChangeError.changeUnderWay.recoverySuggestion", defaultValue: "Wait until that change is done.", table: "Remote")
+            case .incompleteFolder:
+                nil
+            case .notUploaded:
+                String(localized: "RemoteItemChangeError.notUploaded.recoverySuggestion",
+                       defaultValue: "Files and folders are uploaded, up to \(RemoteFolderChanges.maximumUploadItems) items at once and \(ByteCountFormatter.string(fromByteCount: Int64(RemoteLimits().transferCap), countStyle: .file)) per file. Links and other items are not.",
+                       table: "Remote", comment: "%lld is a number of items, %@ a size such as 16 MB")
+            case .offline:
+                String(localized: "RemoteItemChangeError.offline.recoverySuggestion", defaultValue: "Reconnect, then try again.", table: "Remote")
+            case .outcomeUnknown:
+                String(localized: "RemoteItemChangeError.outcomeUnknown.recoverySuggestion",
+                       defaultValue: "The folder is listed again, so that it shows what the server has.", table: "Remote")
+        }
+    }
+}
+
+
+/// The server's side of creating, renaming, moving and deleting items in a remote folder.
+///
+/// Every request runs on one connection, and none is tried again: after a lost reply, whether it took
+/// effect is unknown. Nothing here ever replaces an existing item.
+enum RemoteFolderChanges {
+
+    enum Kind: Sendable {
+
+        case file
+        case folder
+    }
+
+
+    /// How many numbered variants of a name are tried before giving up.
+    static let maximumNameAttempts = 100
+
+    /// How many local items one drop uploads at most.
+    static let maximumUploadItems = 1_000
+
+
+    /// Creates an empty file or folder under the first free variant of a name.
+    ///
+    /// The file is created with mode `0666` and the folder with `0777`, which the server narrows with its umask.
+    ///
+    /// - Returns: The item as the server now lists it.
+    static func create(_ kind: Kind, named name: String, in folder: String, with transport: any RemoteTransport) async throws -> RemoteDirectoryEntry {
+
+        for candidate in RemoteItemName.variants(of: name).prefix(self.maximumNameAttempts) {
+            guard let path = RemotePath.child(candidate, of: folder) else { throw RemoteItemChangeError.invalidName(candidate) }
+            try RemoteOperationControl.current?.checkCancellation()
+
+            do {
+                switch kind {
+                    case .file:
+                        let handle = try await transport.open(path, mode: .createExclusive(permissions: 0o666))
+                        // The file exists once it is open; a failure to close changes nothing about that.
+                        try? await transport.close(handle)
+                    case .folder:
+                        try await transport.makeDirectory(path, permissions: 0o777)
+                }
+            } catch let error as RemoteSFTPError {
+                // SFTP version 3 has no status for a name that is taken, so a failure means one only if something is there.
+                if (try? await transport.lstat(path)) != nil { continue }
+                throw error
+            }
+
+            let fallback = RemoteFileAttributes(permissions: (kind == .folder) ? UInt32(S_IFDIR) | 0o755 : UInt32(S_IFREG) | 0o644)
+            let attributes = (try? await transport.lstat(path)) ?? fallback
+
+            return RemoteDirectoryEntry(name: candidate, attributes: attributes)
+        }
+
+        throw RemoteItemChangeError.noAvailableName(name)
+    }
+
+
+    /// Renames an item, refusing a destination that exists.
+    ///
+    /// The destination is checked first, since a server other than OpenSSH may replace an existing item
+    /// even with the plain rename request, which OpenSSH refuses.
+    static func rename(_ source: String, to destination: String, with transport: any RemoteTransport) async throws {
+
+        try await self.requireAbsent(destination, with: transport)
+
+        do {
+            try await transport.renameWithoutReplacing(source, to: destination)
+        } catch let error as RemoteSFTPError {
+            if (try? await transport.lstat(destination)) != nil {
+                throw RemoteItemChangeError.nameTaken(RemoteFileIdentity.fileName(of: destination))
+            }
+            throw error
+        }
+    }
+
+
+    /// Moves an item into a folder, under the first free variant of its name.
+    ///
+    /// - Returns: The item's name in the folder.
+    static func move(_ source: String, into folder: String, with transport: any RemoteTransport) async throws -> String {
+
+        let name = RemoteFileIdentity.fileName(of: source)
+
+        for candidate in RemoteItemName.variants(of: name).prefix(self.maximumNameAttempts) {
+            guard let destination = RemotePath.child(candidate, of: folder) else { throw RemoteItemChangeError.invalidName(candidate) }
+            try RemoteOperationControl.current?.checkCancellation()
+
+            do {
+                try await self.rename(source, to: destination, with: transport)
+                return candidate
+            } catch RemoteItemChangeError.nameTaken {
+                continue
+            }
+        }
+
+        throw RemoteItemChangeError.noAvailableName(name)
+    }
+
+
+    /// Deletes an item, and a folder with everything in it.
+    ///
+    /// A folder's whole contents are listed before anything is deleted, and nothing is deleted if they
+    /// cannot all be listed within the limits or an entry's type stays unknown. Links are deleted as
+    /// links and never followed. Files and links go first, then the folders, deepest first.
+    ///
+    /// - Returns: How many items were deleted.
+    static func delete(_ path: String, limits: RemoteLimits, with transport: any RemoteTransport) async throws -> Int {
+
+        let control = RemoteOperationControl.current
+        let name = RemoteFileIdentity.fileName(of: path)
+
+        guard try await transport.lstat(path).kind == .directory else {
+            try await transport.remove(path)
+            return 1
+        }
+
+        // Parents are always found before their children, so the reversed list removes children first.
+        var folders: [String] = [path]
+        var files: [String] = []
+        var pending: [(path: String, depth: Int)] = [(path, 0)]
+
+        while let (folder, depth) = pending.popLast() {
+            guard depth < limits.maximumTreeDepth else { throw RemoteItemChangeError.incompleteFolder(name) }
+
+            let listing = try await transport.listDirectory(at: folder, limits: limits)
+            guard listing.isComplete, listing.omittedCount == 0 else { throw RemoteItemChangeError.incompleteFolder(name) }
+
+            for entry in listing.entries {
+                guard
+                    folders.count + files.count < limits.maximumTreeNodes,
+                    let child = RemotePath.child(entry.name, of: folder)
+                else { throw RemoteItemChangeError.incompleteFolder(name) }
+
+                var kind = entry.attributes.kind
+                if kind == .unknown {
+                    kind = try await transport.lstat(child).kind
+                }
+                switch kind {
+                    case .directory:
+                        folders.append(child)
+                        pending.append((child, depth + 1))
+                    case .unknown:
+                        throw RemoteItemChangeError.incompleteFolder(name)
+                    case .regular, .symbolicLink, .other:
+                        files.append(child)
+                }
+            }
+        }
+
+        for file in files {
+            try control?.checkCancellation()
+            try await transport.remove(file)
+        }
+        for folder in folders.reversed() {
+            try control?.checkCancellation()
+            try await transport.removeDirectory(folder)
+        }
+
+        return files.count + folders.count
+    }
+
+
+    /// Uploads a local file or folder into a folder, under the first free variant of its name there.
+    ///
+    /// A folder's items keep their names, since the folder is new. A file is created exclusively with its
+    /// local permissions, written, flushed if the server can, and closed; a file that fails before it is
+    /// complete is removed again, unless the connection was lost, since then its state is unknown.
+    ///
+    /// - Returns: The uploaded item as the server now lists it.
+    static func upload(_ item: RemoteUploadItem, into folder: String, with transport: any RemoteTransport) async throws -> RemoteDirectoryEntry {
+
+        try await self.upload(item, into: folder, numbers: true, with: transport)
+    }
+
+
+    // MARK: Private Methods
+
+    private static func upload(_ item: RemoteUploadItem, into folder: String, numbers: Bool, with transport: any RemoteTransport) async throws -> RemoteDirectoryEntry {
+
+        let names = numbers ? Array(RemoteItemName.variants(of: item.name).prefix(self.maximumNameAttempts)) : [item.name]
+
+        for candidate in names {
+            guard let path = RemotePath.child(candidate, of: folder) else { throw RemoteItemChangeError.invalidName(candidate) }
+            try RemoteOperationControl.current?.checkCancellation()
+
+            switch item {
+                case .file(_, let url, let permissions):
+                    let handle: RemoteFileHandle
+                    do {
+                        handle = try await transport.open(path, mode: .createExclusive(permissions: permissions))
+                    } catch let error as RemoteSFTPError {
+                        if numbers, (try? await transport.lstat(path)) != nil { continue }
+                        throw error
+                    }
+                    do {
+                        let data = try Data(contentsOf: url, options: .mappedIfSafe)
+                        RemoteOperationControl.current?.expect(totalBytes: data.count)
+                        try await transport.write(data, to: handle)
+                        if await transport.capabilities.supportsFsync {
+                            try await transport.fsync(handle)
+                        }
+                        try await transport.close(handle)
+                    } catch let error where error is RemoteSFTPError || error is CocoaError || error is RemoteOperationCanceled {
+                        // The server answered, so the incomplete file this upload created can go.
+                        try? await transport.close(handle)
+                        try? await transport.remove(path)
+                        throw error
+                    }
+
+                case .folder(_, let permissions, let items):
+                    do {
+                        try await transport.makeDirectory(path, permissions: permissions)
+                    } catch let error as RemoteSFTPError {
+                        if numbers, (try? await transport.lstat(path)) != nil { continue }
+                        throw error
+                    }
+                    for child in items {
+                        _ = try await self.upload(child, into: path, numbers: false, with: transport)
+                    }
+            }
+
+            let attributes = (try? await transport.lstat(path)) ?? RemoteFileAttributes()
+            return RemoteDirectoryEntry(name: candidate, attributes: attributes)
+        }
+
+        throw RemoteItemChangeError.noAvailableName(item.name)
+    }
+
+
+    /// Throws `nameTaken` if an item exists at the path.
+    private static func requireAbsent(_ path: String, with transport: any RemoteTransport) async throws {
+
+        do {
+            _ = try await transport.lstat(path)
+        } catch let error as RemoteSFTPError where error.status == .noSuchFile {
+            return
+        }
+
+        throw RemoteItemChangeError.nameTaken(RemoteFileIdentity.fileName(of: path))
+    }
+}
+
+
+/// A local file or folder to upload, as found when it was dropped.
+indirect enum RemoteUploadItem: Sendable {
+
+    case file(name: String, url: URL, permissions: UInt32)
+    case folder(name: String, permissions: UInt32, items: [RemoteUploadItem])
+
+
+    var name: String {
+
+        switch self {
+            case .file(let name, _, _), .folder(let name, _, _): name
+        }
+    }
+
+
+    /// Finds what dropped local items would upload, without following links.
+    ///
+    /// - Parameters:
+    ///   - urls: The dropped items.
+    ///   - transferCap: The largest file that is uploaded.
+    /// - Returns: The items to upload, and the names of those that are not uploaded: links, special files,
+    ///   files over the cap, names that cannot be used on a server, and everything past the item limit.
+    static func scan(_ urls: [URL], transferCap: Int) -> (items: [RemoteUploadItem], skipped: [String]) {
+
+        var count = 0
+        var skipped: [String] = []
+
+        func scan(_ url: URL) -> RemoteUploadItem? {
+            let name = url.lastPathComponent
+            guard
+                count < RemoteFolderChanges.maximumUploadItems,
+                RemotePath.isValidComponent(name),
+                let attributes = try? FileManager.default.attributesOfItem(atPath: url.path(percentEncoded: false))
+            else {
+                skipped.append(name)
+                return nil
+            }
+            let permissions = ((attributes[.posixPermissions] as? NSNumber)?.uint32Value ?? 0o644) & 0o777
+
+            switch attributes[.type] as? FileAttributeType {
+                case .typeRegular:
+                    guard ((attributes[.size] as? NSNumber)?.intValue ?? 0) <= transferCap else {
+                        skipped.append(name)
+                        return nil
+                    }
+                    count += 1
+                    return .file(name: name, url: url, permissions: permissions)
+                case .typeDirectory:
+                    count += 1
+                    let children = (try? FileManager.default.contentsOfDirectory(at: url, includingPropertiesForKeys: nil)) ?? []
+                    let items = children.sorted { $0.lastPathComponent < $1.lastPathComponent }.compactMap(scan)
+                    return .folder(name: name, permissions: permissions | 0o700, items: items)
+                default:
+                    skipped.append(name)
+                    return nil
+            }
+        }
+
+        return (urls.compactMap(scan), skipped)
+    }
+}
+
+
+/// Names of items that the user creates, renames or moves on a server.
+enum RemoteItemName {
+
+    /// The name, then its numbered variants, as the local file browser numbers them: `Untitled.txt`,
+    /// `Untitled 2.txt`, `Untitled 3.txt`, and so on. A name that already ends with a number counts on from it.
+    static func variants(of name: String) -> some Sequence<String> {
+
+        let (stem, pathExtension) = self.split(name)
+        let match = stem.wholeMatch(of: /(?<base>.+?) (?<number>[0-9]+)/)
+        let base = match.map { String($0.base) } ?? stem
+        let start = match.flatMap { Int($0.number) } ?? 1
+
+        return (start...).lazy.map { number in
+            let numbered = (number < 2) ? base : "\(base) \(number)"
+            return pathExtension.map { numbered + "." + $0 } ?? numbered
+        }
+    }
+
+
+    /// Splits a name into its stem and extension. A leading dot starts the stem, not an extension.
+    private static func split(_ name: String) -> (stem: String, pathExtension: String?) {
+
+        guard
+            let dot = name.lastIndex(of: "."),
+            dot != name.startIndex,
+            name.index(after: dot) != name.endIndex
+        else { return (name, nil) }
+
+        return (String(name[..<dot]), String(name[name.index(after: dot)...]))
+    }
+}
