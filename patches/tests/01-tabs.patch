+    @Test(.timeLimit(.minutes(1))) func directoryFileTabsRespectPreference() async throws {
+
+        try await self.withDirectory(files: ["first.txt", "second.txt", "third.txt", "fourth.txt"]) { document, urls in
+            let didOpenFirst = await document.openDocument(at: urls[0])
+            let didOpenSecond = await document.openDocument(at: urls[1])
+            #expect(didOpenFirst)
+            #expect(didOpenSecond)
+            let firstDocument = try #require(self.member(at: urls[0], in: document))
+            let secondDocument = try #require(self.member(at: urls[1], in: document))
+            #expect(document.currentDocument === secondDocument)
+            #expect(document.tabDocuments.map(\.fileURL) == [urls[0], urls[1]])
+
+            document.selectDocument(firstDocument)
+            #expect(document.currentDocument === firstDocument)
+
+            let didCloseFirst = await document.closeDocument(firstDocument)
+            #expect(didCloseFirst)
+            #expect(self.member(at: urls[0], in: document) == nil)
+            #expect(document.currentDocument === secondDocument)
+            #expect(document.tabDocuments.map(\.fileURL) == [urls[1]])
+
+            let didCloseSecond = await document.closeDocument(secondDocument)
+            #expect(didCloseSecond)
+            #expect(document.currentDocument == nil)
+            #expect(document.tabDocuments.isEmpty)
+
+            UserDefaults.standard[.usesDirectoryFileTabs] = false
+            let didOpenThird = await document.openDocument(at: urls[2])
+            let didOpenFourth = await document.openDocument(at: urls[3])
+            #expect(didOpenThird)
+            #expect(didOpenFourth)
+            let fourthDocument = try #require(self.member(at: urls[3], in: document))
+            #expect(document.currentDocument === fourthDocument)
+            // Unused documents are closed when tabs are disabled.
+            #expect(self.member(at: urls[2], in: document) == nil)
+            #expect(document.tabDocuments.isEmpty)
+
+            let didCloseFourth = await document.closeDocument(fourthDocument)
+            #expect(didCloseFourth)
+            #expect(document.currentDocument == nil)
+            #expect(document.tabDocuments.isEmpty)
+        }
+    }
