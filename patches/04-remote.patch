+/// The outline view of the remote sidebar, which opens the selected file with Return and deletes the selected item with Delete.
+private final class RemoteOutlineView: NSOutlineView {
+
+    var onReturn: () -> Void = { }
+    var onDelete: () -> Void = { }
+
+
+    override func keyDown(with event: NSEvent) {
+
+        let hasNoModifier = event.modifierFlags.isDisjoint(with: [.shift, .control, .option, .command])
+
+        switch event.charactersIgnoringModifiers?.unicodeScalars.first?.value {
+            case 0x0D, 0x03:  // Return, Enter
+                self.onReturn()
+            case 0x7F where hasNoModifier:  // Delete
+                self.onDelete()
+            default:
+                super.keyDown(with: event)
+        }
+    }
+}
