+    @Test(.timeLimit(.minutes(1))) func dialogsNameTheFrameThatAsked() async throws {
+
+        try await self.withWebPages { directory, _, server, prompts in
+            // A second server on the IPv6 loopback address is another origin.
+            let other = try WebPageTestServer(host: "::1")
+            try await other.start()
+            defer { other.stop() }
+            server.route("/a", .page("<title>Page A</title>"))
+            server.route("/parent", .page("<title>Parent</title><iframe src='\(other.url("/child").absoluteString)'></iframe>"))
+            other.route("/child", .page("<script>alert('from the child')</script>"))
+            let session = try #require(directory.openWebPageTab())
+            let controller = try #require(session.controller)
+            prompts.dialogResponse = .acknowledged
+
+            controller.load(server.url("/a"))
+            try await self.wait { session.title == "Page A" && !session.isLoading }
+            _ = try await self.evaluate("alert('hello'); 'done'", in: controller.webView)
+            let dialog = try #require(prompts.dialogs.last)
+            #expect(dialog.kind == .alert)
+            #expect(dialog.message == "hello")
+            #expect(dialog.origin == "http://127.0.0.1:\(server.port)")
+
+            controller.load(server.url("/parent"))
+            try await self.wait { prompts.dialogs.count == 2 }
+            #expect(prompts.dialogs.last?.message == "from the child")
+            #expect(prompts.dialogs.last?.origin == "http://[::1]:\(other.port)", "the child frame's own origin, not the page's")
+        }
+    }
