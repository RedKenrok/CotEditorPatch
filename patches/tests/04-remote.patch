+import AppKit
+import Foundation
+import Testing
+import Defaults
+import SwiftUI
+@testable import CotEditor
+
+/// Remote folder windows, with a fake server and scripted prompts.
+///
+/// These are part of the serialized `DirectoryTabTests` suite: they change the file tabs preference,
+/// the environment that restoration uses, and the termination state.
+extension DirectoryTabTests {
+
+    // MARK: Window
+
+    @Test(.timeLimit(.minutes(1))) func aRemoteFolderOpensInAWindowWithoutALocalFolder() async throws {
+
+        try await self.withRemoteFolder { session, directory, bed in
+            #expect(directory.fileURL == nil)
+            #expect(directory.root === session)
+            #expect(directory.fileNode == nil)
+            #expect(directory.fileBrowserViewController == nil, "the local file browser is not made")
+            #expect(directory.displayName == "site")
+
+            let window = try #require(directory.windowController?.window)
+            #expect(window.title == "site")
+            #expect(window.subtitle == "editor@\(bed.endpoint.host):/srv/site")
+            #expect(!window.isRestorable, "AppKit cannot restore a document without a file")
+
+            // The header is the sidebar's top accessory, as the local sidebar's pane switcher is, with no safe area of its own.
+            let sidebarItem = try #require(directory.windowContentViewController?.splitViewItems.first)
+            let header = try #require(sidebarItem.topAlignedAccessoryViewControllers.first?.view as? NSHostingView<RemoteFolderHeader>)
+            #expect(header.safeAreaRegions.isEmpty)
+
+            try await self.waitForNode(["index.html"], in: session)
+            #expect(session.tree.root.children?.map(\.name).sorted() == ["index.html", "src"])
+            #expect(session.status == .online)
+            #expect(await bed.pool.hasConnection(to: bed.endpoint, destination: .fake, role: .browsing))
+            #expect(await !bed.pool.hasConnection(to: bed.endpoint, destination: .fake, role: .files), "listing uses no file connection")
+        }
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aRemoteFolderWindowsTerminalsRunOnItsServerInItsFolder() async throws {
+
+        let engines = FakeTerminalEngines()
+        let originalFactory = TerminalSession.defaultEngineFactory
+        TerminalSession.defaultEngineFactory = engines.make
+        defer { TerminalSession.defaultEngineFactory = originalFactory }
+
+        try await self.withRemoteFolder { session, directory, bed in
+            #expect(directory.validateUserInterfaceItem(NSMenuItem(title: "", action: #selector(DirectoryDocument.newTerminalTab(_:)), keyEquivalent: "")))
+            #expect(directory.openTerminalTab() == nil, "no terminal starts in some local folder instead")
+
+            await directory.requestTerminalTab()
+            let terminal = try #require(directory.activeTerminalSession)
