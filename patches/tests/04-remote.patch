+    /// A session of a folder window, without the window, with its root listed.
+    private func makeSession(_ bed: RemoteTestBed, path: String = "/srv") async throws -> RemoteFolderSession {
+
+        let identity = RemoteFolderIdentity(profileID: nil, endpoint: bed.endpoint, destination: .fake, requestedPath: path, path: path)
+        let session = RemoteFolderSession(identity: identity, environment: bed.environment)
+        session.start()
+        try await waitUntil { session.tree.root.children != nil && !session.tree.root.isLoading }
+
+        return session
+    }
