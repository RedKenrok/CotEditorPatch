+
+import AppKit
+import SwiftUI
+
+
+/// Display-only metadata. The directory retains document and tab ownership.
+struct DirectoryTabPresentation: Identifiable {
+
+    let id: UUID
+    let title: String
+    let icon: NSImage?
+    let tooltip: String
+    let isModified: Bool
+    let canClose: Bool
+    let canMoveToNewWindow: Bool
+    /// A symbol after the title that points out where the tab's document lives.
+    var badgeSymbolName: String?
+}
+
+
+struct DirectoryTabBar: View {
+
+    /// A command offered in the tab strip's “+” menu or in a tab's context menu.
+    struct MenuItem: Identifiable {
+
+        let id = UUID()
+        var title: String
+        var systemImage: String?
+        var isEnabled = true
+        var action: () -> Void
+    }
+
+
+    /// A tab being dragged along or out of the strip.
+    private struct TabDrag: Equatable {
+
+        var id: UUID
+        /// The pointer's distance from the tab's leading edge when the drag began.
+        var grabOffset: CGFloat
+        /// The pointer, in the strip's coordinate space.
+        var location: CGPoint
+    }
+
+
+    /// The height of the strip.
+    static let height: CGFloat = 30
+
+    /// How far above or below the strip a tab must be pulled to move to a window of its own.
+    static let pullOutDistance: CGFloat = 24
+
+    private static let stripSpace = "DirectoryTabBar.strip"
+
+
+    let presentations: [DirectoryTabPresentation]
+    let selectedID: UUID?
+    let onSelect: (UUID) -> Void
+    let onClose: (UUID) -> Void
+    /// Moves a tab to an index among all tabs.
+    var onMove: (UUID, Int) -> Void = { _, _ in }
+    /// Moves a tab to a window of its own whose top-left corner is at the given screen point.
+    var onMoveToNewWindow: (UUID, NSPoint) -> Void = { _, _ in }
+    /// The commands of the “+” menu after the tabs; the menu is hidden when there are none.
+    var addMenuItems: [MenuItem] = []
+    var contextMenuItems: (UUID) -> [MenuItem] = { _ in [] }
+
+    @State private var drag: TabDrag?
+    @State private var tabFrames: [UUID: CGRect] = [:]
+
+    /// The order shown while a tab is dragged, ahead of the model catching up.
+    ///
+    /// Reordering changes this in a single animated transaction, so every part of every tab moves
+    /// together. Animating the model's order instead would animate each later rebuild of the strip
+    /// again, and parts of the tabs, such as their icons, would trail behind their titles.
+    @State private var dragOrder: [UUID]?
+
+
+    /// The tabs in the order shown.
+    private var displayedPresentations: [DirectoryTabPresentation] {
+
+        guard let dragOrder else { return self.presentations }
+
+        return self.presentations.enumerated()
+            .sorted { (dragOrder.firstIndex(of: $0.element.id) ?? dragOrder.count + $0.offset)
+                < (dragOrder.firstIndex(of: $1.element.id) ?? dragOrder.count + $1.offset) }
+            .map(\.element)
+    }
+
+    var body: some View {
+        HStack(spacing: 0) {
+            ScrollViewReader { proxy in
+                ScrollView(.horizontal) {
+                    HStack(spacing: 2) {
+                        ForEach(self.displayedPresentations) { presentation in
+                            tab(presentation)
+                                .id(presentation.id)
+                        }
+                    }
+                    .padding(.horizontal, 4)
+                    .padding(.vertical, 1)
+                    .coordinateSpace(.named(Self.stripSpace))
+                    .onPreferenceChange(TabFramesKey.self) { self.tabFrames = $0 }
+                }
+                .scrollIndicators(.hidden)
+                // No scrolling while a tab is dragged: it would move the strip under the pointer.
+                .onChange(of: self.selectedID) { _, id in
+                    guard self.drag == nil, let id else { return }
+                    withAnimation(.easeInOut(duration: 0.2)) { proxy.scrollTo(id, anchor: .trailing) }
+                }
+                .onChange(of: self.presentations.map(\.id)) { _, _ in
+                    guard self.drag == nil else { return }
+                    // The model has caught up with the drag, or changed in some other way.
+                    self.dragOrder = nil
+                    if let selectedID { proxy.scrollTo(selectedID, anchor: .trailing) }
+                }
+                .onAppear {
+                    if let selectedID { proxy.scrollTo(selectedID, anchor: .trailing) }
+                }
+            }
+            if !self.addMenuItems.isEmpty {
+                self.addMenu
+            }
+        }
+        // No background of its own: the bar stays visible in an empty window,
+        // so it must take on whatever the window shows beneath it, editor or placeholder.
+        .frame(height: Self.height)
+        .accessibilityElement(children: .contain)
+        .accessibilityLabel(String(localized: "DirectoryTabBar.accessibilityLabel", defaultValue: "File Tabs", table: "Document",
+                                   comment: "accessibility label for the tab bar listing the files open in a folder window"))
+    }
+
+    /// The accessibility label and tooltip of the “+” menu.
+    static var addMenuLabel: String {
+
+        String(localized: "DirectoryTabBar.add.accessibilityLabel", defaultValue: "New Tab", table: "Document",
+               comment: "accessibility label and tooltip of the menu at the end of the tab bar that opens a new tab")
+    }
+
+
+    static var moveToNewWindowLabel: String {
+
+        String(localized: "DirectoryTabBar.moveToNewWindow", defaultValue: "Move to New Window", table: "Document",
+               comment: "context menu item and accessibility action moving a tab into a window of its own")
+    }
+
+
+    static var moveLeftLabel: String {
+
+        String(localized: "DirectoryTabBar.moveLeft", defaultValue: "Move Left", table: "Document",
+               comment: "accessibility action moving a tab one place to the left")
+    }
+
+
+    static var moveRightLabel: String {
+
+        String(localized: "DirectoryTabBar.moveRight", defaultValue: "Move Right", table: "Document",
+               comment: "accessibility action moving a tab one place to the right")
+    }
+
+
+    /// The index a dragged tab belongs at: after every other tab whose middle lies before the dragged tab's middle.
+    ///
+    /// Comparing middles gives natural hysteresis: once the tabs have swapped, the dragged tab has to travel
+    /// back past the other tab's new middle to swap again, so it does not flicker at the boundary.
+    ///
+    /// - Parameters:
+    ///   - id: The dragged tab.
+    ///   - midX: The middle of the dragged tab where the pointer puts it.
+    ///   - order: All tab IDs in their current order.
+    ///   - frames: The current frames of the tabs.
+    /// - Returns: The index among all tabs.
+    static func dropIndex(for id: UUID, midX: CGFloat, order: [UUID], frames: [UUID: CGRect]) -> Int {
+
+        order.lazy
+            .filter { $0 != id }
+            .count { (frames[$0]?.midX ?? .infinity) < midX }
+    }
+
+
+    /// Whether a pointer at this location, in the strip's coordinate space, pulls a tab out of the strip.
+    static func isPulledOut(_ location: CGPoint) -> Bool {
+
+        location.y < -Self.pullOutDistance || location.y > Self.height + Self.pullOutDistance
+    }
+
+
+    /// The accessibility label and tooltip of a tab's close button, which must name the file it closes.
+    ///
+    /// - Parameter presentation: The tab.
+    /// - Returns: A localized label.
+    static func closeLabel(for presentation: DirectoryTabPresentation) -> String {
+
+        String(localized: "DirectoryTabBar.close.accessibilityLabel", defaultValue: "Close \(presentation.title)", table: "Document",
+               comment: "accessibility label and tooltip for the button closing a file tab (%@ is the file name)")
+    }
+
+
+    private var addMenu: some View {
+
+        Menu {
+            ForEach(self.addMenuItems) { item in
+                Self.button(for: item)
+            }
+        } label: {
+            Image(systemName: "plus")
+        }
+        .menuStyle(.button)
+        .buttonStyle(.borderless)
+        .menuIndicator(.hidden)
+        .fixedSize()
+        .padding(.horizontal, 6)
+        .accessibilityLabel(Self.addMenuLabel)
+        .help(Self.addMenuLabel)
+    }
+
+
+    @ViewBuilder private static func button(for item: MenuItem) -> some View {
+
+        Group {
+            if let systemImage = item.systemImage {
+                Button(item.title, systemImage: systemImage, action: item.action)
+            } else {
+                Button(item.title, action: item.action)
+            }
+        }
+        .disabled(!item.isEnabled)
+    }
+
+
+    private func tab(_ presentation: DirectoryTabPresentation) -> some View {
+
+        HStack(spacing: 4) {
+            Button { self.onSelect(presentation.id) } label: {
+                HStack(spacing: 6) {
+                    if let icon = presentation.icon {
+                        Image(nsImage: icon).resizable().frame(width: 14, height: 14)
+                    }
+                    Text(presentation.title).lineLimit(1).truncationMode(.middle)
+                    if let badgeSymbolName = presentation.badgeSymbolName {
+                        Image(systemName: badgeSymbolName)
+                            .font(.system(size: 9))
+                            .foregroundStyle(.secondary)
+                            .accessibilityHidden(true)
+                    }
+                    if presentation.isModified {
+                        Circle().fill(.primary).frame(width: 6, height: 6).accessibilityHidden(true)
+                    }
+                }
+                .frame(maxWidth: 180, alignment: .leading)
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+            .accessibilityLabel(presentation.title)
+            .accessibilityValue(presentation.isModified
+                                ? String(localized: "DirectoryTabBar.edited.accessibilityValue", defaultValue: "Edited", table: "Document",
+                                         comment: "accessibility value of a file tab whose document has unsaved changes")
+                                : "")
+            .accessibilityAddTraits(presentation.id == self.selectedID ? .isSelected : [])
+
+            if presentation.canClose {
+                Button { self.onClose(presentation.id) } label: {
+                    Image(systemName: "xmark")
+                        .font(.system(size: 9, weight: .semibold))
+                        .frame(width: 16, height: 16)
+                        .contentShape(Rectangle())
+                }
+                .buttonStyle(.plain)
+                .accessibilityLabel(Self.closeLabel(for: presentation))
+                .help(Self.closeLabel(for: presentation))
+            }
+        }
+        .padding(.leading, 7)
+        .padding(.trailing, 4)
+        .padding(.vertical, 2)
+        .background {
+            ZStack {
+                // Tabs have no background of their own, so a dragged tab needs an opaque one while it
+                // slides over its neighbors; otherwise both titles would show through each other.
+                if self.drag?.id == presentation.id {
+                    RoundedRectangle(cornerRadius: 5)
+                        .fill(Color(nsColor: .windowBackgroundColor))
+                        .shadow(color: .black.opacity(0.25), radius: 2, y: 1)
+                }
+                RoundedRectangle(cornerRadius: 5)
+                    .fill(presentation.id == self.selectedID ? Color.accentColor.opacity(0.22) : .clear)
+            }
+        }
+        .help(presentation.tooltip)
+        .contextMenu {
+            ForEach(self.contextMenuItems(presentation.id)) { item in
+                Self.button(for: item)
+            }
+        }
+        .accessibilityActions {
+            if let index = self.displayedPresentations.firstIndex(where: { $0.id == presentation.id }) {
+                if index > 0 {
+                    Button(Self.moveLeftLabel) { self.onMove(presentation.id, index - 1) }
+                }
+                if index < self.displayedPresentations.count - 1 {
+                    Button(Self.moveRightLabel) { self.onMove(presentation.id, index + 1) }
+                }
+            }
+            if presentation.canMoveToNewWindow {
+                Button(Self.moveToNewWindowLabel) { self.onMoveToNewWindow(presentation.id, NSEvent.mouseLocation) }
+            }
+        }
+        .offset(self.dragOffset(of: presentation))
+        // Measured outside the offset: the reported frame must be the tab's place in the strip. Measured
+        // inside, it would move with the drag offset that is computed from it, and the tab would jitter.
+        .background {
+            GeometryReader { geometry in
+                Color.clear.preference(key: TabFramesKey.self, value: [presentation.id: geometry.frame(in: .named(Self.stripSpace))])
+            }
+        }
+        .opacity(self.isPulledOut(presentation) ? 0.6 : 1)
+        .zIndex(self.drag?.id == presentation.id ? 1 : 0)
+        // The dragged tab follows the pointer directly; only the others animate into place.
+        .transaction { if self.drag?.id == presentation.id { $0.animation = nil } }
+        .simultaneousGesture(self.dragGesture(for: presentation))
+    }
+
+
+    private func isPulledOut(_ presentation: DirectoryTabPresentation) -> Bool {
+
+        guard let drag, drag.id == presentation.id, presentation.canMoveToNewWindow else { return false }
+
+        return Self.isPulledOut(drag.location)
+    }
+
+
+    /// Where the dragged tab is drawn relative to its place in the strip.
+    private func dragOffset(of presentation: DirectoryTabPresentation) -> CGSize {
+
+        guard let drag, drag.id == presentation.id, let frame = self.tabFrames[presentation.id] else { return .zero }
+
+        return CGSize(width: drag.location.x - drag.grabOffset - frame.minX,
+                      height: self.isPulledOut(presentation) ? drag.location.y - frame.midY : 0)
+    }
+
+
+    /// Reorders the tab while it is dragged along the strip, and moves it to a new window when it is let go
+    /// away from the strip.
+    private func dragGesture(for presentation: DirectoryTabPresentation) -> some Gesture {
+
+        DragGesture(minimumDistance: 4, coordinateSpace: .named(Self.stripSpace))
+            .onChanged { value in
+                if self.drag?.id != presentation.id {
+                    let leadingEdge = self.tabFrames[presentation.id]?.minX ?? value.startLocation.x
+                    self.drag = TabDrag(id: presentation.id, grabOffset: value.startLocation.x - leadingEdge, location: value.location)
+                    self.onSelect(presentation.id)
+                }
+                self.drag?.location = value.location
+
+                guard
+                    !Self.isPulledOut(value.location),
+                    let drag = self.drag,
+                    let frame = self.tabFrames[presentation.id]
+                else { return }
+
+                var order = self.displayedPresentations.map(\.id)
+                let index = Self.dropIndex(for: presentation.id, midX: value.location.x - drag.grabOffset + frame.width / 2,
+                                           order: order, frames: self.tabFrames)
+                guard let current = order.firstIndex(of: presentation.id), index != current else { return }
+
+                order.insert(order.remove(at: current), at: index)
+                withAnimation(.easeInOut(duration: 0.15)) {
+                    self.dragOrder = order
+                }
+                self.onMove(presentation.id, index)
+            }
+            .onEnded { value in
+                defer {
+                    self.drag = nil
+                    // Keep showing the dragged order until the model has caught up, to avoid a flash of the old order.
+                    if self.presentations.map(\.id) == self.dragOrder {
+                        self.dragOrder = nil
+                    }
+                }
+
+                guard presentation.canMoveToNewWindow, Self.isPulledOut(value.location) else { return }
+
+                // Put the new window's title bar under the pointer.
+                let pointer = NSEvent.mouseLocation
+                self.onMoveToNewWindow(presentation.id, NSPoint(x: pointer.x - 60, y: pointer.y + 12))
+            }
+    }
+}
+
+
+/// Collects the frames of the tabs in the strip's coordinate space.
+private struct TabFramesKey: PreferenceKey {
+
+    static let defaultValue: [UUID: CGRect] = [:]
+
+
+    static func reduce(value: inout [UUID: CGRect], nextValue: () -> [UUID: CGRect]) {
+
+        value.merge(nextValue()) { $1 }
+    }
+}
