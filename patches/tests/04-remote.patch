+extension RemoteDocument {
+
+    /// Replaces the whole text, as typing would.
+    func replaceText(with string: String) {
+
+        self.textStorage.replaceCharacters(in: NSRange(location: 0, length: (self.textStorage.string as NSString).length), with: string)
+        self.updateChangeCount(.changeDone)
+    }
+}
