+extension DirectoryTabTests {
+
+    /// Runs the body with a directory of small text files and file tabs enabled, then restores the preference.
+    func withDirectory(files: [String] = ["first.txt", "second.txt", "third.txt"], makesWindow: Bool = false,
+                       _ body: (DirectoryDocument, [URL]) async throws -> Void) async throws {
+
+        let key = DefaultKeys.usesDirectoryFileTabs.rawValue
+        let original = UserDefaults.standard.object(forKey: key)
+        UserDefaults.standard[.usesDirectoryFileTabs] = true
+
+        let rootURL = FileManager.default.temporaryDirectory.appending(path: UUID().uuidString, directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: rootURL, withIntermediateDirectories: true)
+        let urls = files.map { rootURL.appending(path: $0, directoryHint: .notDirectory) }
+        for url in urls {
+            try Data("test".utf8).write(to: url)
+        }
+
+        let directory = DirectoryDocument()
+        defer {
+            directory.close()
+            UserDefaults.standard.set(original, forKey: key)
+            try? FileManager.default.removeItem(at: rootURL)
+        }
+        directory.fileURL = rootURL
+        try directory.read(from: rootURL, ofType: "public.folder")
+        if makesWindow {
+            directory.makeWindowControllers()
+            directory.showWindows()
+        }
+
+        try await body(directory, urls)
+    }
+
+
+    /// Runs the body with a new directory restored from archived restorable state.
+    func withRestoredDirectory(at rootURL: URL, from data: Data, _ body: (DirectoryDocument) async throws -> Void) async throws {
+
+        let directory = DirectoryDocument()
+        defer { directory.close() }
+        directory.fileURL = rootURL
+        try directory.read(from: rootURL, ofType: "public.folder")
+
+        let unarchiver = try NSKeyedUnarchiver(forReadingFrom: data)
+        unarchiver.requiresSecureCoding = true
+        directory.restoreState(with: unarchiver)
+        unarchiver.finishDecoding()
+
+        try await body(directory)
+    }
+
+
+    func encodeRestorableState(of directory: DirectoryDocument) -> Data {
+
+        // AppKit may add encoding work to the background queue, as it does for documents without a file,
+        // so the archive is finished only after that work, as AppKit's own restoration does.
+        let archiver = NSKeyedArchiver(requiringSecureCoding: true)
+        let queue = OperationQueue()
+        directory.encodeRestorableState(with: archiver, backgroundQueue: queue)
+        queue.waitUntilAllOperationsAreFinished()
+        archiver.finishEncoding()
+
+        return archiver.encodedData
+    }
+
+
+    func member(at fileURL: URL, in directory: DirectoryDocument) -> DataDocument? {
+
+        guard let node = directory.fileNode?.node(at: fileURL) else { return nil }
+
+        return directory.openedDocument(at: node)
+    }
+
+
+    /// Polls until the condition holds, letting the main run loop and file presenters make progress.
+    func wait(timeout: Duration = .seconds(5), until condition: () -> Bool) async throws {
+
+        let deadline = ContinuousClock.now + timeout
+        while !condition() {
+            guard ContinuousClock.now < deadline else {
+                Issue.record("Timed out waiting for condition")
+                return
+            }
+            try await Task.sleep(for: .milliseconds(20))
+        }
+    }
+}
