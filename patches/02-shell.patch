+
+import AppKit
+import Observation
+
+
+/// The terminal emulator and process behind one terminal tab.
+///
+/// The session talks to its engine only through this protocol, so tests can drive the whole tab
+/// lifecycle with a fake engine instead of spawning processes.
+@MainActor protocol TerminalEngine: AnyObject {
+
+    /// The view showing the terminal. It lives as long as the engine, so hiding a tab never recreates it.
+    var view: NSView { get }
+    
+    /// The view that takes keyboard input.
+    var focusView: NSView { get }
+
+    /// Called at most once, when the process has exited and been reaped. Never called after `shutDown()`.
+    var onExit: ((TerminalExitStatus) -> Void)? { get set }
+
+    /// Called when the program in the terminal sets the window title.
+    var onTitleChange: ((String) -> Void)? { get set }
+
+    /// Called when the program in the terminal asks for a notification.
+    var onNotification: ((TerminalNotification) -> Void)? { get set }
+
+    /// Launches the process.
+    func start(_ configuration: TerminalLaunchConfiguration) throws(TerminalLaunchError)
+
+    /// Stops the processes this engine owns and releases the pseudo-terminal.
+    ///
+    /// Must be idempotent: a close and a quit can both reach the same engine.
+    func shutDown()
+    
+    /// Starts stopping the processes for application termination and returns what remains to wait for.
+    ///
+    /// The app is about to exit, so waiting happens once for all sessions instead of in the background.
+    func shutDownForTermination() -> TerminalProcessReaper?
+}
+
+
+extension TerminalEngine {
+    
+    func shutDownForTermination() -> TerminalProcessReaper? {
+        
+        self.shutDown()
+        return nil
+    }
+}
+
+
+/// How a terminal process ended.
+struct TerminalExitStatus: Equatable {
+
+    /// The exit code, or `nil` if a signal ended the process.
+    var code: Int32?
+
+    /// The signal that ended the process, if any.
+    var signal: Int32?
+
+
+    /// Decodes a raw `waitpid(2)` status.
+    init(waitStatus status: Int32) {
+
+        // Swift does not import the WIFEXITED family of macros, so decode the status layout directly.
+        let signal = status & 0x7f
+        if signal == 0 {
+            self.code = (status >> 8) & 0xff
+            self.signal = nil
+        } else {
+            self.code = nil
+            self.signal = signal
+        }
+    }
+
+
+    init(code: Int32?, signal: Int32? = nil) {
+
+        self.code = code
+        self.signal = signal
+    }
+}
+
+
+/// Why a terminal could not start.
+enum TerminalLaunchError: Error, Equatable {
+
+    case directoryUnavailable(URL)
+    case shellUnavailable(String)
+    case spawnFailed
+}
+
+
+extension TerminalLaunchError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .directoryUnavailable(let url):
+                String(localized: "TerminalLaunchError.directoryUnavailable.description",
+                       defaultValue: "The folder “\(url.lastPathComponent)” is no longer available.", table: "Terminal",
+                       comment: "error shown in a terminal tab whose starting folder was renamed, moved or deleted (%@ is the folder name)")
+            case .shellUnavailable(let path):
+                String(localized: "TerminalLaunchError.shellUnavailable.description",
+                       defaultValue: "The shell “\(path)” can’t be run.", table: "Terminal",
+                       comment: "error shown in a terminal tab (%@ is the path to the shell program)")
+            case .spawnFailed:
+                String(localized: "TerminalLaunchError.spawnFailed.description",
+                       defaultValue: "The shell session couldn’t be started.", table: "Terminal",
+                       comment: "error shown in a terminal tab when the system refused to create the process")
+        }
+    }
+
+
+    var recoverySuggestion: String? {
+
+        switch self {
+            case .directoryUnavailable:
+                String(localized: "TerminalLaunchError.directoryUnavailable.recoverySuggestion",
+                       defaultValue: "Choose another folder to start the shell in.", table: "Terminal")
+            case .shellUnavailable, .spawnFailed:
+                String(localized: "TerminalLaunchError.retry.recoverySuggestion",
+                       defaultValue: "Try again, or close this tab.", table: "Terminal")
+        }
+    }
+}
+
+
+/// Where the processes of a terminal run when it is not a shell in a folder on this Mac, such as a shell
+/// on the server a folder window's folder is on.
+///
+/// A launcher's terminals are not archived, since only the launcher knows how to start them again, and
+/// one whose process fails keeps its tab and output, which usually say why.
+struct TerminalLauncher {
+
+    /// Where the terminal runs, such as `user@host:/path`, for its tooltip and status.
+    var location: String
+
+    /// Makes the launch configuration of each start.
+    var configuration: @MainActor () throws(TerminalLaunchError) -> TerminalLaunchConfiguration
+}
+
+
+/// A folder window's root that can also run terminals elsewhere, such as on the server its folder is on.
+///
+/// Such a window offers both kinds: New Shell still starts a shell on this Mac, and the root's own
+/// command (`DirectoryDocument.newRootTerminalTab(_:)`) starts one where the root says.
+@MainActor protocol TerminalLaunchProviding {
+
+    /// The label of the tab strip's “+” menu item that opens one of the root's terminals.
+    var terminalMenuItemTitle: String { get }
+
+    /// The symbol of that menu item.
+    var terminalMenuItemSystemImage: String { get }
+
+    /// Prepares the launcher of a new terminal of the window.
+    ///
+    /// - Throws: An error to show if no terminal can start, such as when the folder's location changed.
+    func makeTerminalLauncher(for directory: DirectoryDocument) async throws -> TerminalLauncher
+}
+
+
+/// One terminal tab: its title, starting folder, and at most one running process.
+///
+/// A session starts either immediately or, when restored, as an inactive placeholder that the user
+/// starts explicitly. It never replays commands: a restart is a new process in the saved folder.
+@MainActor @Observable final class TerminalSession: Identifiable {
+
+    enum Lifecycle: Equatable {
+
+        /// Not started, for example restored after relaunch. Processes and output are never restored.
+        case inactive
+        case running
+        case exited(TerminalExitStatus)
+        case failed(TerminalLaunchError)
+        /// Closed for good; the session never runs again.
+        case closed
+    }
+
+
+    /// Creates the engine for new sessions' processes.
+    ///
+    /// Tests replace it with a fake so that no process is spawned.
+    static var defaultEngineFactory: @MainActor () -> any TerminalEngine = { SwiftTermEngine() }
+
+
+    let id: UUID
+
+    /// The generated title such as “Terminal 2”, unique within its window.
+    let defaultTitle: String
+
+    /// A name the user gave the tab. It wins over titles the shell sets.
+    private(set) var customTitle: String?
+
+    /// The folder every process of this session starts in.
+    private(set) var startingDirectory: URL
+
+    /// The shell to run, or `nil` for the user's login shell at launch time.
+    let shellPath: String?
+
+    /// Where the processes run instead of a shell in the starting folder, if anywhere else.
+    let launcher: TerminalLauncher?
+
+    private(set) var lifecycle: Lifecycle
+    private(set) var shellTitle: String?
+
+    /// The current engine. It is replaced on restart so that a new process never inherits the old output.
+    @ObservationIgnored private(set) var engine: (any TerminalEngine)?
+
+    /// Increments whenever `engine` changes, so that views can observe engine replacement.
+    private(set) var engineGeneration = 0
+
+    /// Called once the process has exited on its own, for the owner to close the tab.
+    @ObservationIgnored var onExit: (() -> Void)?
+
+    /// Called when the program asks for a notification, at most once per `notificationInterval`.
+    @ObservationIgnored var onNotification: ((TerminalNotification) -> Void)?
+
+    /// The shortest time between two notifications of one session. Output is untrusted, and a program
+    /// that prints the sequence in a loop must not flood Notification Center.
+    static let notificationInterval: Duration = .seconds(1)
+
+    @ObservationIgnored private var lastNotification: ContinuousClock.Instant?
+    
+    @ObservationIgnored private var holdsSuddenTerminationBlock = false
+    @ObservationIgnored private let makeEngine: @MainActor () -> any TerminalEngine
+
+
+    init(id: UUID = UUID(), defaultTitle: String, customTitle: String? = nil, startingDirectory: URL, shellPath: String? = nil, launcher: TerminalLauncher? = nil,
+         makeEngine: @escaping @MainActor () -> any TerminalEngine = TerminalSession.defaultEngineFactory)
+    {
+        self.makeEngine = makeEngine
+        self.launcher = launcher
+        self.id = id
+        self.defaultTitle = defaultTitle
+        self.customTitle = customTitle.flatMap(Self.sanitizedTitle)
+        self.startingDirectory = startingDirectory
+        self.shellPath = shellPath
+        self.lifecycle = .inactive
+    }
+
+
+    // MARK: Public Properties
+
+    var title: String {
+
+        self.customTitle ?? self.shellTitle ?? self.defaultTitle
+    }
+
+
+    /// Whether closing the session would stop running work.
+    var isLive: Bool {
+
+        self.lifecycle == .running
+    }
+
+
+    /// Whether the process ended with a failure that the tab stays open to show, as a launcher's does.
+    var keepsTabAfterExit: Bool {
+
+        guard self.launcher != nil, case .exited(let status) = self.lifecycle else { return false }
+
+        return status.code != 0
+    }
+
+
+    // MARK: Public Methods
+
+    /// Starts a new process in the starting directory, replacing an exited or failed one.
+    ///
+    /// A running or closed session does nothing.
+    func start() {
+
+        switch self.lifecycle {
+            case .running, .closed: return
+            case .inactive, .exited, .failed: break
+        }
+
+        self.releaseEngine()
+
+        let configuration: TerminalLaunchConfiguration
+        do {
+            if let launcher = self.launcher {
+                configuration = try launcher.configuration()
+            } else {
+                configuration = try TerminalLaunchConfiguration(directory: self.startingDirectory, shellPath: self.shellPath)
+            }
+        } catch {
+            self.lifecycle = .failed(error)
+            return
+        }
+
+        let engine = self.makeEngine()
+        engine.onExit = { [weak self, weak engine] status in
+            // A late callback from a replaced engine must not change the new process's state.
+            guard let self, let engine, self.engine === engine else { return }
+            self.processDidExit(status)
+        }
+        engine.onTitleChange = { [weak self, weak engine] title in
+            guard let self, let engine, self.engine === engine else { return }
+            self.shellTitle = Self.sanitizedTitle(title)
+        }
+        engine.onNotification = { [weak self, weak engine] notification in
+            guard let self, let engine, self.engine === engine else { return }
+            self.programDidRequestNotification(notification)
+        }
+        self.engine = engine
+        self.engineGeneration += 1
+
+        do {
+            try engine.start(configuration)
+        } catch {
+            self.releaseEngine()
+            self.lifecycle = .failed(error)
+            return
+        }
+
+        self.shellTitle = nil
+        self.lifecycle = .running
+        self.setBlocksSuddenTermination(true)
+    }
+
+
+    /// Renames the tab.
+    ///
+    /// - Parameter title: The new name, or an empty string to return to the automatic title.
+    func rename(to title: String) {
+
+        self.customTitle = Self.sanitizedTitle(title)
+    }
+
+
+    /// Changes the folder that the next start uses, for example after the old one was deleted.
+    ///
+    /// - Parameter url: The new starting folder.
+    func changeStartingDirectory(to url: URL) {
+
+        guard !self.isLive, self.lifecycle != .closed else { return }
+
+        self.startingDirectory = url
+    }
+
+
+    /// Stops the process and releases every resource. The session cannot be started again.
+    func close() {
+
+        guard self.lifecycle != .closed else { return }
+
+        self.lifecycle = .closed
+        self.releaseEngine()
+    }
+
+
+    /// Stops the process because the app is terminating.
+    ///
+    /// - Returns: The reaper to wait on, if a process is still running.
+    func closeForTermination() -> TerminalProcessReaper? {
+
+        guard self.lifecycle != .closed else { return nil }
+
+        self.lifecycle = .closed
+        self.setBlocksSuddenTermination(false)
+
+        guard let engine = self.engine else { return nil }
+
+        engine.onExit = nil
+        engine.onTitleChange = nil
+        engine.onNotification = nil
+        self.engine = nil
+        self.engineGeneration += 1
+
+        return engine.shutDownForTermination()
+    }
+
+
+    // MARK: Private Methods
+
+    private func processDidExit(_ status: TerminalExitStatus) {
+
+        guard self.lifecycle == .running else { return }
+
+        self.lifecycle = .exited(status)
+        self.setBlocksSuddenTermination(false)
+        self.onExit?()
+    }
+
+
+    private func programDidRequestNotification(_ notification: TerminalNotification) {
+
+        let now = ContinuousClock.now
+        if let lastNotification, now - lastNotification < Self.notificationInterval { return }
+
+        self.lastNotification = now
+        self.onNotification?(notification)
+    }
+
+
+    private func releaseEngine() {
+
+        self.setBlocksSuddenTermination(false)
+
+        guard let engine = self.engine else { return }
+
+        engine.onExit = nil
+        engine.onTitleChange = nil
+        engine.onNotification = nil
+        engine.shutDown()
+        self.engine = nil
+        self.engineGeneration += 1
+    }
+
+
+    /// Keeps the system from killing the app without asking while a process runs.
+    ///
+    /// The app enables sudden termination because documents autosave, but a running shell has no
+    /// autosave: the app must get the chance to confirm and to stop the process properly.
+    private func setBlocksSuddenTermination(_ blocks: Bool) {
+
+        guard blocks != self.holdsSuddenTerminationBlock else { return }
+
+        self.holdsSuddenTerminationBlock = blocks
+        if blocks {
+            ProcessInfo.processInfo.disableSuddenTermination()
+        } else {
+            ProcessInfo.processInfo.enableSuddenTermination()
+        }
+    }
+
+
+    /// Removes control characters from a title and bounds its length.
+    ///
+    /// Titles come from escape sequences the shell prints, so they are untrusted and may contain anything.
+    ///
+    /// - Parameter title: The raw title.
+    /// - Returns: The cleaned title, or `nil` if nothing printable remains.
+    nonisolated static func sanitizedTitle(_ title: String) -> String? {
+
+        let printable = String(String.UnicodeScalarView(title.unicodeScalars.filter { !CharacterSet.controlCharacters.contains($0) }))
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+
+        guard !printable.isEmpty else { return nil }
+
+        return String(printable.prefix(120))
+    }
+}
