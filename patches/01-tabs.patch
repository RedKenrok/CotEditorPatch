+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import Foundation
+import Observation
+
+
+/// Ordered tabs owned by a directory window. For files, the document registry remains the source of truth.
+@MainActor @Observable final class DirectoryTabState {
+
+    struct Entry: Identifiable {
+
+        enum Content {
+
+            case file(DataDocument)
+            case item(any DirectoryTabItem)
+        }
+
+        let id: UUID
+        let content: Content
+
+        /// The file document, or `nil` for a tab that shows something other than a file.
+        var document: DataDocument? {
+
+            switch self.content {
+                case .file(let document): document
+                case .item: nil
+            }
+        }
+
+        /// The tab's item, or `nil` for a file tab.
+        var item: (any DirectoryTabItem)? {
+
+            switch self.content {
+                case .file: nil
+                case .item(let item): item
+            }
+        }
+    }
+
+    private(set) var entries: [Entry] = []
+    private(set) var selectedID: UUID?
+
+
+    /// Appends a file unless it already has a tab. Existing IDs are never replaced.
+    ///
+    /// Inserting never selects: the selection must always name the file the window is showing,
+    /// so only the directory, which also switches the content host, calls `select(_:)`.
+    @discardableResult func insert(_ document: DataDocument, id: UUID? = nil) -> Entry {
+
+        if let existing = self.entry(for: document) { return existing }
+
+        let requestedID = id ?? UUID()
+        let entry = Entry(id: self.entries.contains(where: { $0.id == requestedID }) ? UUID() : requestedID,
+                          content: .file(document))
+        self.entries.append(entry)
+
+        return entry
+    }
+
+
+    func select(_ id: UUID) {
+
+        guard self.entries.contains(where: { $0.id == id }) else { return }
+        self.selectedID = id
+    }
+
+
+    @discardableResult func remove(_ document: DataDocument) -> Entry? {
+
+        guard let index = self.entries.firstIndex(where: { $0.document === document }) else { return nil }
+
+        return self.remove(at: index)
+    }
+
+
+    /// Removes the entry at the index; a removed selection passes to the next neighbor, then to the previous one.
+    private func remove(at index: Int) -> Entry {
+
+        let removed = self.entries.remove(at: index)
+
+        if self.selectedID == removed.id {
+            self.selectedID = self.entries.indices.contains(index) ? self.entries[index].id : self.entries.last?.id
+        }
+
+        return removed
+    }
+
+
+    /// Moves a tab to another position. The selection does not change.
+    ///
+    /// - Parameters:
+    ///   - id: The tab to move.
+    ///   - index: Its new index, clamped to the valid range.
+    func move(_ id: UUID, to index: Int) {
+
+        guard let source = self.entries.firstIndex(where: { $0.id == id }) else { return }
+
+        let destination = min(max(index, 0), self.entries.count - 1)
+        guard source != destination else { return }
+
+        self.entries.insert(self.entries.remove(at: source), at: destination)
+    }
+
+
+    func entry(for document: DataDocument) -> Entry? {
+
+        self.entries.first { $0.document === document }
+    }
+
+
+    /// Matches the registry's order and membership while retaining IDs for documents still open.
+    ///
+    /// Tabs that are not files are not in the registry, so they keep their place among the files.
+    func reconcile(with documents: [DataDocument]) {
+
+        let previous = self.entries
+        var reconciled: [Entry] = []
+
+        for document in documents {
+            guard !reconciled.contains(where: { $0.document === document }) else { continue }
+            let entry = previous.first(where: { $0.document === document })
+                ?? Entry(id: UUID(), content: .file(document))
+            reconciled.append(entry)
+        }
+        for (index, entry) in previous.enumerated() where entry.document == nil {
+            reconciled.insert(entry, at: min(index, reconciled.count))
+        }
+
+        let previousSelectedIndex = previous.firstIndex(where: { $0.id == self.selectedID })
+        self.entries = reconciled
+        if !reconciled.contains(where: { $0.id == self.selectedID }) {
+            self.selectedID = previousSelectedIndex.flatMap { index in
+                reconciled.indices.contains(index) ? reconciled[index].id : reconciled.last?.id
+            } ?? reconciled.first?.id
+        }
+    }
+
+
+    /// Appends a tab that is not a file under the item's ID. Like file tabs, it is not selected.
+    @discardableResult func insert(_ item: any DirectoryTabItem) -> Entry {
+
+        if let existing = self.entry(for: item) { return existing }
+
+        let entry = Entry(id: self.entries.contains(where: { $0.id == item.id }) ? UUID() : item.id,
+                          content: .item(item))
+        self.entries.append(entry)
+
+        return entry
+    }
+
+
+    @discardableResult func remove(_ item: any DirectoryTabItem) -> Entry? {
+
+        guard let index = self.entries.firstIndex(where: { $0.item === item }) else { return nil }
+
+        return self.remove(at: index)
+    }
+
+
+    func entry(for item: any DirectoryTabItem) -> Entry? {
+
+        self.entries.first { $0.item === item }
+    }
+
+
+    /// Puts entries whose IDs appear in `order` into that order, keeping the others after them.
+    ///
+    /// Restoration reopens tabs of different kinds at different times, for example files
+    /// asynchronously, so the archived order is applied again as each one arrives.
+    func arrange(by order: [UUID]) {
+
+        let rank = Dictionary(order.enumerated().map { ($1, $0) }, uniquingKeysWith: { first, _ in first })
+        let arranged = self.entries.enumerated()
+            .sorted { (rank[$0.element.id] ?? order.count + $0.offset) < (rank[$1.element.id] ?? order.count + $1.offset) }
+            .map(\.element)
+
+        if arranged.map(\.id) != self.entries.map(\.id) {
+            self.entries = arranged
+        }
+    }
+}
+
+
+/// The versioned restorable-state form of a directory's tabs.
+///
+/// It is kept apart from `DirectoryDocument` so that damaged or legacy archives can be tested
+/// without going through AppKit state restoration.
+///
+/// Every tab is one entry with an ID and a kind. This type reads the `file` kind itself. Entries of
+/// the kinds that later patches add are kept, in order, as `foreignEntries` for those patches to
+/// reopen, so that one list holds the tabs of every kind in the order the user arranged them.
+struct DirectoryTabArchive: Equatable {
+
+    struct Entry: Equatable {
+
+        var id: UUID?
+        var fileURL: URL
+    }
+
+
+    /// An archived tab of a kind that this type does not reopen itself.
+    struct ForeignEntry: Equatable {
+
+        var id: UUID
+        var kind: String
+
+        /// The whole archived entry. Its values are untrusted input for the patch that reads the kind.
+        var fields: NSDictionary
+    }
+
+
+    /// A tab to archive: its ID, its kind, and the fields that kind needs to reopen it.
+    struct Tab {
+
+        var id: UUID
+        var kind: String
+        var fields: [String: Any]
+    }
+
+
+    static let version = 1
+    static let fileKind = "file"
+
+    /// The classes an archive may contain, for decoding under secure coding.
+    static let allowedClasses: [AnyClass] = [NSDictionary.self, NSArray.self, NSString.self, NSData.self, NSNumber.self]
+
+    var entries: [Entry]
+
+    /// The entry to show once it reopens, or `nil` when neither the saved selection nor the current file survived.
+    var selectedIndex: Int?
+
+    /// The archived entries of other kinds, in archived order, each with a valid and unique ID.
+    var foreignEntries: [ForeignEntry]
+
+    /// The ID of every archived tab of every kind, in display order.
+    ///
+    /// Tabs of different kinds reopen at different times, so the order is applied again as each one arrives.
+    var order: [UUID]
+
+    /// The archived selection, whatever the kind of its tab.
+    var selectedID: UUID?
+
+
+    /// Builds the property list stored in the restorable state.
+    ///
+    /// - Parameters:
+    ///   - tabs: The tabs in display order.
+    ///   - selectedID: The ID of the selected tab.
+    /// - Returns: A property list compatible with secure coding.
+    static func encode(_ tabs: [Tab], selectedID: UUID?) -> NSDictionary {
+
+        [
+            "version": Self.version,
+            "entries": tabs.map { tab in
+                // The ID and kind always come from the tab, never from its fields.
+                tab.fields.merging(["id": tab.id.uuidString, "kind": tab.kind]) { _, reserved in reserved }
+            },
+            "selectedID": selectedID?.uuidString ?? "",
+        ]
+    }
+
+
+    /// Builds the property list for file tabs only.
+    ///
+    /// - Parameters:
+    ///   - entries: The tab IDs and security-scoped bookmarks in display order.
+    ///   - selectedID: The ID of the selected tab.
+    /// - Returns: A property list compatible with secure coding.
+    static func encode(_ entries: [(id: UUID, bookmark: Data)], selectedID: UUID?) -> NSDictionary {
+
+        self.encode(entries.map { Tab(id: $0.id, kind: Self.fileKind, fields: ["bookmark": $0.bookmark]) }, selectedID: selectedID)
+    }
+
+
+    /// Reads the archived tabs, falling back to the legacy bookmark list and then to the single current-file bookmark.
+    ///
+    /// A damaged archive degrades to fewer tabs rather than failing: entries without a kind and
+    /// unresolvable bookmarks are skipped, a repeated file keeps only its first tab, and a repeated ID
+    /// is dropped so that the tab receives a fresh one. An entry of another kind needs a valid ID
+    /// of its own, since only its ID can put it back in order.
+    ///
+    /// - Parameters:
+    ///   - archive: The versioned archive, or `nil` if absent.
+    ///   - legacyBookmarks: The bookmark list written before the versioned archive existed.
+    ///   - currentBookmark: The bookmark of the file that was showing.
+    ///   - resolve: Resolves a bookmark to a file URL inside the directory, or returns `nil`.
+    init(archive: [String: Any]?, legacyBookmarks: [Data]?, currentBookmark: Data?, resolve: (Data) -> URL?) {
+
+        var entries: [Entry] = []
+        var foreignEntries: [ForeignEntry] = []
+        var order: [UUID] = []
+        var seenURLs: Set<URL> = []
+        var seenIDs: Set<UUID> = []
+        func claim(_ id: UUID?) -> UUID? {
+            guard let id, seenIDs.insert(id).inserted else { return nil }
+            order.append(id)
+            return id
+        }
+        func append(_ fileURL: URL?, id: UUID?) {
+            guard let fileURL, seenURLs.insert(fileURL.standardizedFileURL).inserted else { return }
+            entries.append(Entry(id: claim(id), fileURL: fileURL))
+        }
+
+        var selectedID: UUID?
+        if archive?["version"] as? Int == Self.version, let archivedEntries = archive?["entries"] as? [[String: Any]] {
+            for entry in archivedEntries {
+                let id = (entry["id"] as? String).flatMap(UUID.init(uuidString:))
+                switch entry["kind"] as? String {
+                    case Self.fileKind:
+                        append((entry["bookmark"] as? Data).flatMap(resolve), id: id)
+                    case let kind? where !kind.isEmpty:
+                        guard let id = claim(id) else { continue }
+                        foreignEntries.append(ForeignEntry(id: id, kind: kind, fields: entry as NSDictionary))
+                    default:
+                        continue
+                }
+            }
+            selectedID = (archive?["selectedID"] as? String).flatMap(UUID.init(uuidString:))
+        } else if let legacyBookmarks {
+            for bookmark in legacyBookmarks {
+                append(resolve(bookmark), id: nil)
+            }
+        }
+
+        let currentURL = currentBookmark.flatMap(resolve)
+        if entries.isEmpty {
+            append(currentURL, id: nil)
+        }
+
+        self.entries = entries
+        self.foreignEntries = foreignEntries
+        self.order = order
+        self.selectedID = selectedID
+        self.selectedIndex = selectedID.flatMap { id in entries.firstIndex { $0.id == id } }
+            ?? currentURL.flatMap { url in entries.firstIndex { $0.fileURL.standardizedFileURL == url.standardizedFileURL } }
+    }
+
+
+    /// The archived entries of one kind, in archived order.
+    func foreignEntries(ofKind kind: String) -> [ForeignEntry] {
+
+        self.foreignEntries.filter { $0.kind == kind }
+    }
+}
