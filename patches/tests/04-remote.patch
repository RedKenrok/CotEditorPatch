+/// A byte channel to a fake server in the same process.
+final class FakeSFTPChannel: RemoteByteChannel, @unchecked Sendable {
+
+    let server: FakeSFTPServer
+
+    private let replies: AsyncStream<Data>
+    private let continuation: AsyncStream<Data>.Continuation
+    private var framer = RemoteSFTPFramer(maximumPacketLength: 1 << 20)
+    private var iterator: AsyncStream<Data>.AsyncIterator
+    private let queue = RemoteAsyncLock()
+    private let isClosed = RemoteLockedValue(false)
+
+
+    init(server: FakeSFTPServer) {
+
+        self.server = server
+        (self.replies, self.continuation) = AsyncStream<Data>.makeStream()
+        self.iterator = self.replies.makeAsyncIterator()
+    }
+
+
+    func write(_ data: Data) async throws {
+
+        guard !self.isClosed.withLock({ $0 }) else { throw RemoteConnectionError.connectionLost }
+
+        // Requests are handled one at a time, in the order they arrive, as a real server does.
+        await self.queue.lock()
+        defer { Task { await self.queue.unlock() } }
+
+        self.framer.append(data)
+        while let packet = try self.framer.nextPacket() {
+            let (reply, dropsConnection) = await self.server.handle(type: packet.type, payload: packet.payload)
+            if let reply {
+                self.continuation.yield(reply)
+            }
+            if dropsConnection {
+                await self.close()
+                return
+            }
+        }
+    }
+
+
+    func read() async throws -> Data? {
+
+        await self.iterator.next()
+    }
+
+
+    func close() async {
+
+        self.isClosed.withLock { $0 = true }
+        self.continuation.finish()
+    }
+
+
+    func diagnostics() async -> String {
+
+        ""
+    }
+}
+
+
+extension FakeSFTPServer {
+
+    /// A connection pool whose connections go to this server, with a fixed destination.
+    func makePool(limits: RemoteLimits = RemoteLimits(), destination: RemoteDestination = .fake) async -> RemoteConnectionPool {
+
+        let pool = RemoteConnectionPool()
+        await self.connect(pool, limits: limits, destination: destination)
+
+        return pool
+    }
+
+
+    /// Makes a pool's connections go to this server, with the destination the SSH configuration now names.
+    func connect(_ pool: RemoteConnectionPool, limits: RemoteLimits = RemoteLimits(), destination: RemoteDestination) async {
+
+        await pool.configure(limits: limits, connector: { [self] _, limits in
+            let client = RemoteSFTPClient(channel: FakeSFTPChannel(server: self), limits: limits)
+            try await client.start()
+            return RemoteSFTPTransport(client: client, limits: limits)
+        }, evaluator: { endpoint, _ in
+            try RemoteSSHConfiguration(evaluationOutput: "hostname \(destination.hostName)\nuser \(endpoint.user ?? destination.user)\nport \(destination.port)\n")
+        })
+    }
+}
