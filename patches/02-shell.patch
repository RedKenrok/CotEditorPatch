+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+import Defaults
+
+
+extension DefaultKeys {
+
+    /// The theme for terminals, or an empty string to use the editor's theme.
+    static let terminalTheme = DefaultKey<String>("terminalTheme")
+
+    /// Whether the colors programs choose from are derived from the terminal theme.
+    static let terminalUsesThemeColors = DefaultKey<Bool>("terminalUsesThemeColors")
+}
+
+
+/// The terminal settings and their defaults.
+enum TerminalSettings {
+
+    /// Registers the terminal settings' default values. Kept apart from `DefaultSettings`, whose list
+    /// is shared with the builds without terminals.
+    static func registerDefaults() {
+
+        UserDefaults.standard.register(defaults: [
+            DefaultKeys.terminalTheme.rawValue: "",
+            DefaultKeys.terminalUsesThemeColors.rawValue: true,
+            DefaultKeys.terminalPostsNotifications.rawValue: true,
+        ])
+    }
+}
+
+
+/// The colors of a terminal, taken from a CotEditor theme.
+///
+/// CotEditor themes describe text, background, selection and caret, and ten syntax colors, but not the
+/// 16 ANSI colors that programs such as `ls` or `git` choose from. Those can be derived from the syntax
+/// colors: each ANSI color takes the theme color closest to it in hue, so that red still reads as an
+/// error, as long as it stays readable on the background; otherwise it keeps the standard color.
+struct TerminalColors: Equatable {
+
+    var foreground: NSColor
+    var background: NSColor
+    var caret: NSColor
+    var selection: NSColor
+
+    /// The 16 ANSI colors in order (black, red, green, yellow, blue, magenta, cyan, white, then the
+    /// bright variants), or `nil` for the standard palette.
+    var palette: [NSColor]?
+
+
+    /// The standard palette, as in Terminal.app, which is also what the terminal uses by default.
+    static let standardPalette: [NSColor] = [
+        (0, 0, 0), (194, 54, 33), (37, 188, 36), (173, 173, 39), (73, 46, 225), (211, 56, 211), (51, 187, 200), (203, 204, 205),
+        (129, 131, 131), (252, 57, 31), (49, 231, 34), (234, 236, 35), (88, 51, 255), (249, 53, 248), (20, 240, 240), (233, 235, 235),
+    ].map { NSColor(srgbRed: CGFloat($0.0) / 255, green: CGFloat($0.1) / 255, blue: CGFloat($0.2) / 255, alpha: 1) }
+
+    /// The minimum contrast ratio against the background for a theme color to replace a standard one.
+    static let minimumContrast: Double = 3
+
+
+    /// Takes the colors from a theme.
+    ///
+    /// Themes can use dynamic system colors, for the selection for example. They are resolved to plain
+    /// sRGB colors here, for the current drawing appearance, so that the terminal gets fixed values and
+    /// equal settings give equal colors.
+    init(theme: Theme, derivesPalette: Bool) {
+
+        self.foreground = theme.text.color.srgb
+        self.background = theme.background.color.srgb
+        self.caret = theme.insertionPointColor.srgb
+        self.selection = theme.selectionColor.srgb
+        self.palette = derivesPalette ? Self.palette(for: theme) : nil
+    }
+
+
+    // MARK: Theme Resolution
+
+    /// The terminal colors for the current settings.
+    ///
+    /// - Parameter isDark: Whether the terminal is shown in a dark appearance.
+    @MainActor static func current(isDark: Bool) -> Self {
+
+        let name = self.themeName(setting: UserDefaults.standard[.terminalTheme], isDark: isDark,
+                                  pinsAppearance: UserDefaults.standard[.pinsThemeAppearance])
+        let theme = (try? ThemeManager.shared.setting(name: name)) ?? Theme()
+
+        return Self(theme: theme, derivesPalette: UserDefaults.standard[.terminalUsesThemeColors])
+    }
+
+
+    /// The theme a terminal uses.
+    ///
+    /// An empty setting follows the editor's theme exactly as editors do. A chosen theme switches to its
+    /// light or dark variant with the appearance, like the editor's theme, unless the user pinned themes
+    /// to their appearance. A theme that no longer exists falls back to the editor's theme.
+    ///
+    /// - Parameters:
+    ///   - setting: The terminal theme setting.
+    ///   - isDark: Whether the terminal is shown in a dark appearance.
+    ///   - pinsAppearance: Whether themes keep their own appearance.
+    /// - Returns: A theme name.
+    @MainActor static func themeName(setting: String, isDark: Bool, pinsAppearance: Bool) -> String {
+
+        let manager = ThemeManager.shared
+
+        guard !setting.isEmpty, manager.settingNames.contains(setting) else {
+            return manager.userDefaultSettingName(inDarkMode: isDark)
+        }
+
+        if !pinsAppearance, let equivalent = manager.equivalentSettingName(to: setting, forDark: manager.usesDarkAppearance(inDarkMode: isDark)) {
+            return equivalent
+        }
+
+        return setting
+    }
+
+
+    // MARK: Palette
+
+    /// Derives the 16 ANSI colors from a theme.
+    static func palette(for theme: Theme) -> [NSColor] {
+
+        let background = theme.background.color.srgb
+        let text = theme.text.color.srgb
+        let isDark = theme.isDarkTheme
+        let candidates = [theme.keywords, theme.commands, theme.types, theme.attributes, theme.variables,
+                          theme.values, theme.numbers, theme.strings, theme.characters, theme.comments]
+            .map(\.color.srgb)
+            .filter { $0.saturationComponent >= 0.25 && $0.contrastRatio(to: background) >= Self.minimumContrast }
+
+        // The hues of red, green, yellow, blue, magenta and cyan, in ANSI order.
+        let hues: [CGFloat] = [0, 120, 60, 240, 300, 180]
+        let chromatic = hues.enumerated().map { index, hue in
+            candidates
+                .map { (color: $0, distance: $0.hueDistance(to: hue)) }
+                .filter { $0.distance <= 35 }
+                .min { $0.distance < $1.distance }?
+                .color ?? Self.standardPalette[index + 1]
+        }
+
+        let black = isDark ? background.blended(with: text, fraction: 0.25) : text.blended(with: background, fraction: 0.1)
+        let white = isDark ? text.blended(with: background, fraction: 0.15) : background.blended(with: text, fraction: 0.25)
+        let comments = theme.comments.color.srgb
+        let brightBlack = comments.contrastRatio(to: background) >= 2 ? comments : background.blended(with: text, fraction: 0.5)
+        let brightWhite = isDark ? text.blended(with: .white, fraction: 0.5) : background.blended(with: text, fraction: 0.1)
+        // Bright variants are lighter on dark backgrounds; on light ones lightening would cost readability.
+        let brightChromatic = chromatic.map { isDark ? $0.blended(with: .white, fraction: 0.25) : $0 }
+
+        return [black] + chromatic + [white, brightBlack] + brightChromatic + [brightWhite]
+    }
+}
+
+
+private extension NSColor {
+
+    /// The color in the sRGB color space, which the hue and contrast calculations assume.
+    var srgb: NSColor {
+
+        self.usingColorSpace(.sRGB) ?? self
+    }
+
+
+    /// The shortest distance in degrees between the color's hue and the given hue.
+    func hueDistance(to hue: CGFloat) -> CGFloat {
+
+        let distance = abs(self.hueComponent * 360 - hue).truncatingRemainder(dividingBy: 360)
+
+        return min(distance, 360 - distance)
+    }
+
+
+    /// The relative luminance as defined for contrast ratios in WCAG 2.
+    var relativeLuminance: Double {
+
+        func linear(_ component: CGFloat) -> Double {
+            let value = Double(component)
+            return value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4)
+        }
+
+        return 0.2126 * linear(self.redComponent) + 0.7152 * linear(self.greenComponent) + 0.0722 * linear(self.blueComponent)
+    }
+
+
+    /// The WCAG 2 contrast ratio between two colors, from 1 to 21.
+    func contrastRatio(to other: NSColor) -> Double {
+
+        let luminances = [self.relativeLuminance, other.relativeLuminance].sorted()
+
+        return (luminances[1] + 0.05) / (luminances[0] + 0.05)
+    }
+
+
+    func blended(with color: NSColor, fraction: CGFloat) -> NSColor {
+
+        self.blended(withFraction: fraction, of: color)?.srgb ?? self
+    }
+}
