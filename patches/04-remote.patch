+
+import Foundation
+import Synchronization
+import OSLog
+
+
+/// A two-way byte stream to an SFTP server.
+///
+/// The real stream runs through an `ssh` process; tests use one to a fake server in the same process.
+protocol RemoteByteChannel: AnyObject, Sendable {
+
+    /// Sends bytes. Each call is written whole, never interleaved with another.
+    func write(_ data: Data) async throws
+
+    /// The next bytes from the server, or `nil` once the stream has ended.
+    func read() async throws -> Data?
+
+    /// Ends the stream and releases everything it holds. Calling it again does nothing.
+    func close() async
+
+    /// A short, sanitized excerpt of diagnostic output for error messages, if there is any.
+    func diagnostics() async -> String
+}
+
+
+/// How `ssh` is launched.
+///
+/// OpenSSH makes the connection with the user's own configuration, keys and agent. The options
+/// here override only what would make the connection unsafe or not CotEditor's own: prompting,
+/// forwarding, connection sharing, and commands the configuration would run.
+enum RemoteSSHCommand {
+
+    static let executableURL = URL(filePath: "/usr/bin/ssh")
+
+    /// The SFTP subsystem. Remote paths never appear on the command line; they travel only inside SFTP packets.
+    static let subsystem = "sftp"
+
+    static let safetyOptions = [
+        // an unknown or changed host key stops the connection; it is never retried with checking relaxed
+        "StrictHostKeyChecking=yes",
+        "ClearAllForwardings=yes",
+        "ForwardAgent=no",
+        "ForwardX11=no",
+        // a master connection CotEditor does not own could outlive it or be replaced by someone else's
+        "ControlMaster=no",
+        "ControlPath=none",
+        "PermitLocalCommand=no",
+        // a configured RemoteCommand would make the subsystem request fail
+        "RemoteCommand=none",
+        "RequestTTY=no",
+        "ConnectTimeout=15",
+        "ServerAliveInterval=15",
+        "ServerAliveCountMax=2",
+    ]
+
+
+    /// Settings that only tests may change, so that they never depend on the developer's SSH setup.
+    struct TestOverrides: Sendable {
+
+        /// A configuration file used instead of the user's (`-F`).
+        var configurationFile: URL?
+
+        /// Further `-o` options, such as a `UserKnownHostsFile` of the test server.
+        var options: [String] = []
+
+        /// The askpass server to use instead of the app's. Each test has one of its own, which nobody
+        /// answers unless the test sets an answerer, so that no test asks through the app's prompts.
+        var askpass: RemoteAskpass? = RemoteAskpass()
+    }
+
+
+    /// The askpass server the connections use.
+    static func askpass(_ overrides: TestOverrides?) -> RemoteAskpass {
+
+        overrides?.askpass ?? .shared
+    }
+
+
+    /// The arguments to connect to the endpoint's SFTP subsystem.
+    ///
+    /// - Parameters:
+    ///   - endpoint: The host, user and port to connect to.
+    ///   - jumpHosts: The hosts to pass through first, in order, as the configuration's `ProxyJump` names them.
+    ///   - overrides: Settings of the tests.
+    static func connectionArguments(for endpoint: RemoteEndpoint, through jumpHosts: [RemoteEndpoint] = [], overrides: TestOverrides? = nil) -> [String] {
+
+        let proxy = self.proxyCommand(through: jumpHosts, overrides: overrides).map { ["-o", "ProxyCommand=" + $0] } ?? []
+
+        return ["-T", "-a", "-x", "-s"] + proxy + self.commonArguments(for: endpoint, overrides: overrides) + ["--", endpoint.host, self.subsystem]
+    }
+
+
+    /// The arguments of a terminal: a login shell on the endpoint's server with a terminal of its own,
+    /// running the command, through the jump hosts.
+    ///
+    /// The safety options apply as for SFTP, except that a terminal is requested, which the command
+    /// line's first value of `RequestTTY` decides.
+    static func terminalArguments(for endpoint: RemoteEndpoint, through jumpHosts: [RemoteEndpoint], command: String, overrides: TestOverrides?) -> [String] {
+
+        let proxy = self.proxyCommand(through: jumpHosts, overrides: overrides).map { ["-o", "ProxyCommand=" + $0] } ?? []
+
+        return ["-tt", "-a", "-x", "-o", "RequestTTY=force"] + proxy + self.commonArguments(for: endpoint, overrides: overrides) + ["--", endpoint.host, command]
+    }
+
+
+    /// The command that reaches the next host through jump hosts, for `ProxyCommand`.
+    ///
+    /// `ssh` makes a `ProxyJump` connection with a command of its own that leaves out the options given
+    /// on the command line, so a jump host could ask for a password or accept an unknown host key.
+    /// CotEditor gives each jump host its own `ssh` with the safety options instead, which forwards the
+    /// connection to the next host (`-W`), and reaches the jump host before it the same way.
+    ///
+    /// Each command runs in a shell, so every argument is quoted; and each `ssh` expands `%` tokens in
+    /// its `ProxyCommand`, so a command nested in another has its `%` doubled once more per level.
+    ///
+    /// - Returns: The command, or `nil` without jump hosts.
+    static func proxyCommand(through jumpHosts: [RemoteEndpoint], overrides: TestOverrides?) -> String? {
+
+        guard let last = jumpHosts.last else { return nil }
+
+        let previous = self.proxyCommand(through: Array(jumpHosts.dropLast()), overrides: overrides)
+            .map { ["-o", "ProxyCommand=" + $0.replacing("%", with: "%%")] } ?? []
+        let arguments = [self.executableURL.path(percentEncoded: false), "-T", "-a", "-x"] + previous
+            + self.commonArguments(for: last, overrides: overrides) + ["-W", "[%h]:%p", "--", last.host]
+
+        return arguments.map(self.shellQuoted).joined(separator: " ")
+    }
+
+
+    /// The arguments of a connection that only learns the host key the server offers, into a known hosts
+    /// file of its own, and then fails without authenticating: every method of authentication is off, so
+    /// no key, agent or password is offered to a server that is not trusted yet.
+    static func hostKeyLearningArguments(for endpoint: RemoteEndpoint, through jumpHosts: [RemoteEndpoint], knownHostsFile: URL, overrides: TestOverrides?) -> [String] {
+
+        // The first value of an option wins, so these come before the safety options, which check strictly.
+        let learning = [
+            "BatchMode=yes",
+            "UserKnownHostsFile=" + knownHostsFile.path(percentEncoded: false),
+            "GlobalKnownHostsFile=/dev/null",
+            "StrictHostKeyChecking=accept-new",
+            "HashKnownHosts=no",
+            "UpdateHostKeys=no",
+            "PubkeyAuthentication=no",
+            "PasswordAuthentication=no",
+            "KbdInteractiveAuthentication=no",
+            "HostbasedAuthentication=no",
+            "GSSAPIAuthentication=no",
+            "IdentityAgent=none",
+            "NumberOfPasswordPrompts=0",
+        ]
+        let proxy = self.proxyCommand(through: jumpHosts, overrides: overrides).map { ["-o", "ProxyCommand=" + $0] } ?? []
+
+        return ["-T", "-a", "-x"] + learning.flatMap { ["-o", $0] } + proxy + self.commonArguments(for: endpoint, overrides: overrides) + ["--", endpoint.host, "true"]
+    }
+
+
+    /// Quotes an argument for `/bin/sh`, in single quotes, so that nothing in it is interpreted.
+    private static func shellQuoted(_ argument: String) -> String {
+
+        "'" + argument.replacing("'", with: #"'\''"#) + "'"
+    }
+
+
+    /// The arguments that print the effective configuration for the endpoint (`ssh -G`).
+    static func evaluationArguments(for endpoint: RemoteEndpoint, overrides: TestOverrides? = nil) -> [String] {
+
+        ["-G", "-T", "-a", "-x", "-s"] + self.commonArguments(for: endpoint, overrides: overrides) + ["--", endpoint.host, self.subsystem]
+    }
+
+
+    /// The environment of the `ssh` process: only what OpenSSH needs to find the user's configuration,
+    /// keys and agent, and CotEditor's own askpass program while someone answers its questions.
+    /// Dynamic-linker variables, other askpass programs and display settings are never passed.
+    ///
+    /// - Parameters:
+    ///   - environment: The app's environment.
+    ///   - askpass: The variables of CotEditor's askpass program, if questions are answered.
+    static func environment(from environment: [String: String], askpass: [String: String]?) -> [String: String] {
+
+        var result = ["PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
+                      "SSH_ASKPASS_REQUIRE": "never"]
+        for key in ["HOME", "USER", "LOGNAME", "SSH_AUTH_SOCK", "LANG"] {
+            result[key] = environment[key]
+        }
+        result.merge(askpass ?? [:]) { $1 }
+
+        return result
+    }
+
+
+    /// Whether `ssh` may ask questions, such as for a passphrase: only through CotEditor's askpass
+    /// program, and only while someone answers them. Otherwise batch mode makes it fail instead, since a
+    /// question on a terminal or a pipe would wait for nobody.
+    static func batchModeOption(_ overrides: TestOverrides?) -> String {
+
+        (self.askpass(overrides).environment != nil) ? "BatchMode=no" : "BatchMode=yes"
+    }
+
+
+    private static func commonArguments(for endpoint: RemoteEndpoint, overrides: TestOverrides?) -> [String] {
+
+        var arguments: [String] = []
+        if let configurationFile = overrides?.configurationFile {
+            arguments += ["-F", configurationFile.path(percentEncoded: false)]
+        }
+        for option in [self.batchModeOption(overrides)] + self.safetyOptions + (overrides?.options ?? []) {
+            arguments += ["-o", option]
+        }
+        if let user = endpoint.user {
+            arguments += ["-l", user]
+        }
+        if let port = endpoint.port {
+            arguments += ["-p", String(port)]
+        }
+
+        return arguments
+    }
+}
+
+
+/// The part of the effective configuration that decides where a connection goes.
+struct RemoteSSHConfiguration: Equatable, Sendable {
+
+    var destination: RemoteDestination
+    var proxyJump: String?
+    var proxyCommand: String?
+
+    /// The jump hosts of `ProxyJump`, in order, if it could be read.
+    var jumpHosts: [RemoteEndpoint]?
+
+    /// The first of the user's known hosts files, where a host key the user trusts is added.
+    var userKnownHostsFile: String?
+
+    /// Whether the user's configuration hashes the host names it adds to known hosts files.
+    var hashesKnownHosts = false
+
+
+    /// Reads the output of `ssh -G`.
+    init(evaluationOutput output: String) throws(RemoteConnectionError) {
+
+        var values: [String: String] = [:]
+        for line in output.split(whereSeparator: \.isNewline) {
+            let parts = line.split(separator: " ", maxSplits: 1)
+            guard parts.count == 2 else { continue }
+            let key = parts[0].lowercased()
+            // the first value is the effective one, as in the configuration files
+            if values[key] == nil {
+                values[key] = String(parts[1])
+            }
+        }
+
+        guard
+            let hostName = values["hostname"],
+            let user = values["user"],
+            let port = values["port"].flatMap(Int.init),
+            (1...65535).contains(port)
+        else { throw .unreadableConfiguration }
+
+        self.proxyJump = values["proxyjump"].flatMap { $0.lowercased() == "none" ? nil : $0 }
+        self.proxyCommand = values["proxycommand"].flatMap { $0.lowercased() == "none" ? nil : $0 }
+        self.jumpHosts = self.proxyJump.map(Self.jumpHosts(in:)) ?? []
+        self.userKnownHostsFile = values["userknownhostsfile"]?.split(separator: " ").first.map(String.init)
+        self.hashesKnownHosts = values["hashknownhosts"]?.lowercased() == "yes"
+        // The route is part of where a connection goes: through another jump host or command, the same
+        // name can lead to another server.
+        let route = self.proxyJump.map { "jump " + $0 } ?? self.proxyCommand.map { "command " + $0 }
+        self.destination = RemoteDestination(hostName: hostName, user: user, port: port, route: route)
+    }
+
+
+    /// Refuses a `ProxyJump` that cannot be read, or that names a host that could not be passed to `ssh`.
+    ///
+    /// A `ProxyCommand` is the user's own command, and runs as `ssh` would run it.
+    func checkSupported() throws(RemoteConnectionError) {
+
+        if self.jumpHosts == nil {
+            throw .proxyUnsupported
+        }
+    }
+
+
+    /// The hosts of a `ProxyJump` value: `[user@]host[:port]`, or `ssh://[user@]host[:port]`, separated by commas.
+    ///
+    /// - Returns: The hosts, or `nil` if one of them cannot be read or used.
+    static func jumpHosts(in value: String) -> [RemoteEndpoint]? {
+
+        var hosts: [RemoteEndpoint] = []
+        for part in value.split(separator: ",", omittingEmptySubsequences: false) {
+            var spec = Substring(part.trimmingCharacters(in: .whitespaces))
+            if spec.hasPrefix("ssh://") {
+                spec = spec.dropFirst("ssh://".count)
+            }
+
+            var user: String?
+            if let at = spec.lastIndex(of: "@") {
+                user = String(spec[..<at])
+                spec = spec[spec.index(after: at)...]
+            }
+
+            var port: Int?
+            let host: Substring
+            if spec.hasPrefix("[") {
+                // An IPv6 address, in brackets so that its colons are not taken for the port.
+                guard let close = spec.firstIndex(of: "]") else { return nil }
+                host = spec[spec.index(after: spec.startIndex)..<close]
+                let rest = spec[spec.index(after: close)...]
+                if !rest.isEmpty {
+                    guard rest.hasPrefix(":"), let number = Int(rest.dropFirst()) else { return nil }
+                    port = number
+                }
+            } else if let colon = spec.lastIndex(of: ":"), spec.firstIndex(of: ":") == colon {
+                host = spec[..<colon]
+                guard let number = Int(spec[spec.index(after: colon)...]) else { return nil }
+                port = number
+            } else {
+                host = spec
+            }
+
+            guard let endpoint = try? RemoteEndpoint(host: String(host), user: user, port: port).validated() else { return nil }
+            hosts.append(endpoint)
+        }
+
+        return hosts
+    }
+}
+
+
+/// An `ssh` process speaking SFTP on its standard input and output.
+///
+/// The process runs without a shell and without a terminal. Its lifetime belongs to this object:
+/// `close()` ends the pipes, gives `ssh` a moment to exit, then terminates it and waits until it has
+/// been reaped.
+///
+/// Mutable state is guarded by `state`, except the output iterator, which only the one task that
+/// reads the stream uses.
+final class RemoteSSHProcess: RemoteByteChannel, @unchecked Sendable {
+
+    private struct State {
+
+        var isClosed = false
+        var diagnostics = Data()
+        /// Whether ssh's diagnostic output has ended, so that `diagnostics` holds all of it.
+        var hasDiagnosticsEnded = false
+        var exitStatus: Int32?
+    }
+
+
+    private let process: Process
+    private let input: FileHandle
+    private let limits: RemoteLimits
+    private let writeQueue = DispatchQueue(label: "com.coteditor.CotEditor.RemoteSSHProcess.write")
+    private var outputIterator: AsyncThrowingStream<Data, any Error>.AsyncIterator
+    private let state = RemoteLockedValue(State())
+
+
+    /// Starts `ssh` for the endpoint's SFTP subsystem.
+    ///
+    /// - Throws: An error if the process cannot be launched.
+    init(endpoint: RemoteEndpoint, through jumpHosts: [RemoteEndpoint] = [], limits: RemoteLimits, overrides: RemoteSSHCommand.TestOverrides? = nil) throws {
+
+        let process = Process()
+        process.executableURL = RemoteSSHCommand.executableURL
+        process.arguments = RemoteSSHCommand.connectionArguments(for: endpoint, through: jumpHosts, overrides: overrides)
+        process.environment = RemoteSSHCommand.environment(from: ProcessInfo.processInfo.environment, askpass: RemoteSSHCommand.askpass(overrides).environment)
+        process.currentDirectoryURL = URL(filePath: "/", directoryHint: .isDirectory)
+
+        let inputPipe = Pipe()
+        let outputPipe = Pipe()
+        let errorPipe = Pipe()
+        process.standardInput = inputPipe
+        process.standardOutput = outputPipe
+        process.standardError = errorPipe
+
+        // A write after ssh has exited must fail with EPIPE instead of killing the app with SIGPIPE.
+        _ = fcntl(inputPipe.fileHandleForWriting.fileDescriptor, F_SETNOSIGPIPE, 1)
+
+        self.process = process
+        self.input = inputPipe.fileHandleForWriting
+        self.limits = limits
+
+        let (stream, continuation) = AsyncThrowingStream<Data, any Error>.makeStream()
+        self.outputIterator = stream.makeAsyncIterator()
+        outputPipe.fileHandleForReading.readabilityHandler = { handle in
+            let data = handle.availableData
+            if data.isEmpty {
+                handle.readabilityHandler = nil
+                continuation.finish()
+            } else {
+                continuation.yield(data)
+            }
+        }
+
+        let state = self.state
+        let diagnosticsLength = limits.diagnosticsLength
+        errorPipe.fileHandleForReading.readabilityHandler = { handle in
+            let data = handle.availableData
+            guard !data.isEmpty else {
+                handle.readabilityHandler = nil
+                state.withLock { $0.hasDiagnosticsEnded = true }
+                return
+            }
+            state.withLock { state in
+                state.diagnostics.append(data)
+                if state.diagnostics.count > diagnosticsLength {
+                    state.diagnostics.removeFirst(state.diagnostics.count - diagnosticsLength)
+                }
+            }
+        }
+
+        process.terminationHandler = { process in
+            state.withLock { $0.exitStatus = process.terminationStatus }
+        }
+
+        try process.run()
+
+        // The child has its own copies; keeping the parent's would hide the end of the streams.
+        try? inputPipe.fileHandleForReading.close()
+        try? outputPipe.fileHandleForWriting.close()
+        try? errorPipe.fileHandleForWriting.close()
+    }
+
+
+    deinit {
+        // The process must never outlive the object that owns it.
+        if self.process.isRunning {
+            self.process.terminate()
+        }
+    }
+
+
+    /// The process ID of `ssh`.
+    var processIdentifier: Int32 {
+
+        self.process.processIdentifier
+    }
+
+
+    /// The exit status, once the process has been reaped.
+    var exitStatus: Int32? {
+
+        self.state.withLock(\.exitStatus)
+    }
+
+
+    func write(_ data: Data) async throws {
+
+        guard !self.state.withLock(\.isClosed) else { throw RemoteConnectionError.connectionLost }
+
+        let descriptor = self.input.fileDescriptor
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, any Error>) in
+            self.writeQueue.async {
+                var offset = 0
+                let result: Result<Void, any Error> = data.withUnsafeBytes { buffer in
+                    while offset < buffer.count {
+                        let written = Darwin.write(descriptor, buffer.baseAddress! + offset, buffer.count - offset)
+                        if written < 0 {
+                            if errno == EINTR { continue }
+                            return .failure(RemoteConnectionError.connectionLost)
+                        }
+                        offset += written
+                    }
+                    return .success(())
+                }
+                continuation.resume(with: result)
+            }
+        }
+    }
+
+
+    func read() async throws -> Data? {
+
+        try await self.outputIterator.next()
+    }
+
+
+    func close() async {
+
+        let wasClosed = self.state.withLock { state in
+            defer { state.isClosed = true }
+            return state.isClosed
+        }
+        guard !wasClosed else {
+            _ = await self.waitForExit(within: .seconds(3600))
+            return
+        }
+
+        // Ending the input makes ssh close the session and exit by itself.
+        self.writeQueue.sync {
+            try? self.input.close()
+        }
+
+        if await !self.waitForExit(within: self.limits.shutdownGracePeriod) {
+            self.process.terminate()
+            if await !self.waitForExit(within: self.limits.shutdownGracePeriod) {
+                // The process is a child that has not been reaped, so its ID cannot belong to another process yet.
+                kill(self.process.processIdentifier, SIGKILL)
+                _ = await self.waitForExit(within: .seconds(3600))
+            }
+        }
+    }
+
+
+    func diagnostics() async -> String {
+
+        // The output and the diagnostics end separately. When the output ends because ssh gave up, its
+        // reason may not have been read yet, so wait a little for the diagnostics to end too.
+        let deadline = ContinuousClock.now + self.limits.shutdownGracePeriod
+        while !self.state.withLock(\.hasDiagnosticsEnded), ContinuousClock.now < deadline {
+            await withCheckedContinuation { continuation in
+                DispatchQueue.global().asyncAfter(deadline: .now() + .milliseconds(10)) { continuation.resume() }
+            }
+        }
+
+        let data = self.state.withLock(\.diagnostics)
+
+        return Self.sanitized(Self.lossyString(data))
+    }
+
+
+    /// Text for messages from bytes that should be UTF-8 but come from outside, never failing.
+    static func lossyString(_ data: Data) -> String {
+
+        String(data: data, encoding: .utf8) ?? String(data: data, encoding: .isoLatin1) ?? ""
+    }
+
+
+    /// Removes control characters other than line breaks and surrounding white space.
+    static func sanitized(_ text: String) -> String {
+
+        String(String.UnicodeScalarView(text.unicodeScalars.filter { $0 == "\n" || !CharacterSet.controlCharacters.contains($0) }))
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+
+    // MARK: Private Methods
+
+    /// Waits until the process has been reaped or the time is up.
+    ///
+    /// Foundation reaps the process and then runs the termination handler, which records the status.
+    ///
+    /// - Returns: `true` if the process has exited.
+    private func waitForExit(within timeout: Duration) async -> Bool {
+
+        let deadline = ContinuousClock.now + timeout
+        while self.exitStatus == nil {
+            guard ContinuousClock.now < deadline else { return false }
+            // Not cancellable: shutting down must finish even when the task that asked for it was canceled.
+            await withCheckedContinuation { continuation in
+                DispatchQueue.global().asyncAfter(deadline: .now() + .milliseconds(20)) { continuation.resume() }
+            }
+        }
+
+        return true
+    }
+}
+
+
+extension RemoteSSHProcess {
+
+    /// Runs `ssh -G` for the endpoint and reads where the connection would go.
+    ///
+    /// The user's SSH configuration is trusted local configuration: `Match exec` can run programs even
+    /// here, exactly as for any `ssh` the user runs.
+    static func evaluateConfiguration(for endpoint: RemoteEndpoint, limits: RemoteLimits, overrides: RemoteSSHCommand.TestOverrides? = nil) async throws -> RemoteSSHConfiguration {
+        let process = Process()
+        process.executableURL = RemoteSSHCommand.executableURL
+        process.arguments = RemoteSSHCommand.evaluationArguments(for: endpoint, overrides: overrides)
+        process.environment = RemoteSSHCommand.environment(from: ProcessInfo.processInfo.environment, askpass: RemoteSSHCommand.askpass(overrides).environment)
+        process.currentDirectoryURL = URL(filePath: "/", directoryHint: .isDirectory)
+        let outputPipe = Pipe()
+        let errorPipe = Pipe()
+        process.standardInput = FileHandle.nullDevice
+        process.standardOutput = outputPipe
+        process.standardError = errorPipe
+
+        let status: Int32 = try await withCheckedThrowingContinuation { continuation in
+            process.terminationHandler = { continuation.resume(returning: $0.terminationStatus) }
+            do {
+                try process.run()
+            } catch {
+                process.terminationHandler = nil
+                continuation.resume(throwing: error)
+            }
+        }
+
+        // The output of -G is a few kilobytes, so it is read after the process has ended.
+        let output = Self.lossyString((try? outputPipe.fileHandleForReading.readToEnd()) ?? Data())
+        let errorOutput = Self.lossyString((try? errorPipe.fileHandleForReading.readToEnd()) ?? Data())
+
+        guard status == 0 else {
+            throw RemoteConnectionError.sshFailed(status: status, diagnostics: Self.sanitized(String(errorOutput.suffix(limits.diagnosticsLength))))
+        }
+
+        let configuration = try RemoteSSHConfiguration(evaluationOutput: output)
+        try configuration.checkSupported()
+
+        return configuration
+    }
+}
+
+
+/// Why a connection could not be made or used.
+enum RemoteConnectionError: Error, Equatable {
+
+    case unreadableConfiguration
+    case proxyUnsupported
+    case hostKeyNotVerified(diagnostics: String)
+    case authenticationFailed(diagnostics: String)
+    case unreachable(diagnostics: String)
+    case noSFTPService(diagnostics: String)
+    case sshFailed(status: Int32, diagnostics: String)
+    case connectionLost
+    case timedOut
+    case destinationChanged
+
+
+    /// Describes a failed start of `ssh` from its exit and diagnostic output.
+    ///
+    /// The text of the diagnostics only chooses the message. No save decision ever depends on it.
+    /// Whether the host key is not known yet, as opposed to known and different, which is never offered for trust.
+    var isUnknownHostKey: Bool {
+
+        guard case .hostKeyNotVerified(let diagnostics) = self else { return false }
+
+        let text = diagnostics.lowercased()
+        return text.contains("host key is known for") && !text.contains("identification has changed")
+    }
+
+
+    static func classify(status: Int32?, diagnostics: String) -> Self {
+
+        let text = diagnostics.lowercased()
+
+        if text.contains("host key verification failed") || text.contains("no matching host key")
+            || text.contains("remote host identification has changed") || text.contains("host key for")
+        {
+            return .hostKeyNotVerified(diagnostics: diagnostics)
+        }
+        if text.contains("permission denied") || text.contains("too many authentication failures") {
+            return .authenticationFailed(diagnostics: diagnostics)
+        }
+        if text.contains("subsystem request failed") {
+            return .noSFTPService(diagnostics: diagnostics)
+        }
+        if text.contains("could not resolve hostname") || text.contains("connection refused")
+            || text.contains("timed out") || text.contains("no route to host") || text.contains("network is unreachable")
+        {
+            return .unreachable(diagnostics: diagnostics)
+        }
+
+        return .sshFailed(status: status ?? -1, diagnostics: diagnostics)
+    }
+}
+
+
+extension RemoteConnectionError: LocalizedError {
+
+    var errorDescription: String? {
+
+        switch self {
+            case .unreadableConfiguration:
+                String(localized: "RemoteConnectionError.unreadableConfiguration.description",
+                       defaultValue: "The SSH configuration for this host could not be read.", table: "Remote")
+            case .proxyUnsupported:
+                String(localized: "RemoteConnectionError.proxyUnsupported.description",
+                       defaultValue: "The jump host of this connection can’t be used.", table: "Remote")
+            case .hostKeyNotVerified:
+                String(localized: "RemoteConnectionError.hostKeyNotVerified.description",
+                       defaultValue: "The server’s identity could not be verified.", table: "Remote")
+            case .authenticationFailed:
+                String(localized: "RemoteConnectionError.authenticationFailed.description",
+                       defaultValue: "The server did not accept your SSH key.", table: "Remote")
+            case .unreachable:
+                String(localized: "RemoteConnectionError.unreachable.description",
+                       defaultValue: "The server could not be reached.", table: "Remote")
+            case .noSFTPService:
+                String(localized: "RemoteConnectionError.noSFTPService.description",
+                       defaultValue: "The server did not provide an SFTP service.", table: "Remote")
+            case .sshFailed(let status, _):
+                String(localized: "RemoteConnectionError.sshFailed.description",
+                       defaultValue: "The connection failed (ssh exited with status \(Int(status))).", table: "Remote",
+                       comment: "%lld is the exit status of the ssh program")
+            case .connectionLost:
+                String(localized: "RemoteConnectionError.connectionLost.description",
+                       defaultValue: "The connection to the server was lost.", table: "Remote")
+            case .timedOut:
+                String(localized: "RemoteConnectionError.timedOut.description",
+                       defaultValue: "The server stopped responding.", table: "Remote")
+            case .destinationChanged:
+                String(localized: "RemoteConnectionError.destinationChanged.description",
+                       defaultValue: "The host now resolves to a different server, user or port than when the file was opened.",
+                       table: "Remote")
+        }
+    }
+
+
+    var recoverySuggestion: String? {
+
+        switch self {
+            case .proxyUnsupported:
+                String(localized: "RemoteConnectionError.proxyUnsupported.recoverySuggestion",
+                       defaultValue: "Your SSH configuration sets a ProxyJump that CotEditor can’t read, or a jump host that is itself reached through another. Name every jump host in the ProxyJump of this host, as user@host:port.",
+                       table: "Remote")
+            case .hostKeyNotVerified:
+                self.isUnknownHostKey
+                    ? String(localized: "RemoteConnectionError.hostKeyNotVerified.unknown.recoverySuggestion",
+                             defaultValue: "The server’s key was not trusted. Try again to see its fingerprint, and trust it if it matches the one its administrator gave you.",
+                             table: "Remote")
+                    : String(localized: "RemoteConnectionError.hostKeyNotVerified.recoverySuggestion",
+                             defaultValue: "The server’s key is not the one your known_hosts file has for it. Check with the server’s administrator before you remove the old key.",
+                             table: "Remote")
+            case .authenticationFailed:
+                String(localized: "RemoteConnectionError.authenticationFailed.recoverySuggestion",
+                       defaultValue: "CotEditor signs in with your SSH keys or agent only. Passwords and one-time codes are not supported yet. Check that your key is loaded, for example with “ssh-add”.",
+                       table: "Remote")
+            case .noSFTPService:
+                String(localized: "RemoteConnectionError.noSFTPService.recoverySuggestion",
+                       defaultValue: "Ask the server’s administrator to enable SFTP.", table: "Remote")
+            case .destinationChanged:
+                String(localized: "RemoteConnectionError.destinationChanged.recoverySuggestion",
+                       defaultValue: "Check your SSH configuration. If the change is intended, open the file again.", table: "Remote")
+            case .unreadableConfiguration, .unreachable, .sshFailed, .connectionLost, .timedOut:
+                nil
+        }
+    }
+
+
+    /// The output of ssh that explains the error, if any.
+    var diagnostics: String? {
+
+        switch self {
+            case .hostKeyNotVerified(let diagnostics),
+                 .authenticationFailed(let diagnostics),
+                 .unreachable(let diagnostics),
+                 .noSFTPService(let diagnostics),
+                 .sshFailed(_, let diagnostics):
+                diagnostics.isEmpty ? nil : diagnostics
+            default:
+                nil
+        }
+    }
+}
+
+
+/// A value behind a lock that several closures can share.
+final class RemoteLockedValue<Value: Sendable>: Sendable {
+
+    private let mutex: Mutex<Value>
+
+
+    init(_ value: Value) {
+
+        self.mutex = Mutex(value)
+    }
+
+
+    func withLock<Result>(_ body: (inout Value) throws -> Result) rethrows -> Result {
+
+        try self.mutex.withLock { try body(&$0) }
+    }
+}
