+import Foundation
+import os
+import Testing
+@testable import CotEditor
+
+/// The askpass program and its server, which answer the questions of `ssh` by asking the user.
+/// Each test has a server of its own, so that nothing app-wide changes.
+struct RemoteAskpassTests {
+
+    @Test(.timeLimit(.minutes(1))) func aQuestionGoesToTheServerAndItsAnswerOnlyToTheOutput() async throws {
+
+        let questions = OSAllocatedUnfairLock(initialState: [(prompt: String, isConfirmation: Bool)]())
+        let askpass = RemoteAskpass()
+        askpass.setAnswerer { prompt, isConfirmation in
+            questions.withLock { $0.append((prompt, isConfirmation)) }
+            return isConfirmation ? "yes" : "s3cret with 'quotes' and spaces"
+        }
+        defer { askpass.stop() }
+        let environment = try #require(askpass.environment)
+        #expect(environment["SSH_ASKPASS_REQUIRE"] == "force")
+        #expect(!environment.values.contains { $0.contains("s3cret") })
+
+        let answer = try await Self.runHelper("Enter passphrase for key '/k':", environment: environment)
+        #expect(answer.status == 0)
+        #expect(answer.output == "s3cret with 'quotes' and spaces\n")
+
+        var confirming = environment
+        confirming["SSH_ASKPASS_PROMPT"] = "confirm"
+        #expect(try await Self.runHelper("Allow?", environment: confirming).output == "yes\n")
+
+        #expect(questions.withLock { $0.map(\.prompt) } == ["Enter passphrase for key '/k':", "Allow?"])
+        #expect(questions.withLock { $0.map(\.isConfirmation) } == [false, true])
+    }
+
+
+    @Test(.timeLimit(.minutes(1))) func aWrongTokenIsNotAskedAndCancelingFails() async throws {
+
+        let asked = OSAllocatedUnfairLock(initialState: 0)
+        let askpass = RemoteAskpass()
+        askpass.setAnswerer { _, _ in
+            asked.withLock { $0 += 1 }
+            return nil
+        }
+        defer { askpass.stop() }
+        let environment = try #require(askpass.environment)
+
+        var intruder = environment
+        intruder["COTEDITOR_ASKPASS_TOKEN"] = String(repeating: "0", count: 64)
+        let refused = try await Self.runHelper("Password:", environment: intruder)
+        #expect(refused.status != 0)
+        #expect(refused.output.isEmpty)
+        #expect(asked.withLock(\.self) == 0, "a client without the token asks nothing")
+
+        let canceled = try await Self.runHelper("Password:", environment: environment)
+        #expect(canceled.status != 0, "a canceled question makes ssh give up rather than try an empty answer")
+        #expect(canceled.output.isEmpty)
+        #expect(asked.withLock(\.self) == 1)
+    }
+
+
+    @Test func withoutAnAnswererSSHRunsInBatchMode() {
+
+        let askpass = RemoteAskpass()
+        let overrides = RemoteSSHCommand.TestOverrides(askpass: askpass)
+        #expect(askpass.environment == nil)
+        #expect(RemoteSSHCommand.connectionArguments(for: RemoteEndpoint(host: "h", user: nil, port: nil), overrides: overrides).contains("BatchMode=yes"))
+        #expect(RemoteSSHCommand.environment(from: [:], askpass: askpass.environment)["SSH_ASKPASS_REQUIRE"] == "never")
+
+        askpass.setAnswerer { _, _ in nil }
+        defer { askpass.stop() }
+        #expect(RemoteSSHCommand.connectionArguments(for: RemoteEndpoint(host: "h", user: nil, port: nil), overrides: overrides).contains("BatchMode=no"))
+    }
+
+
+    // MARK: Private Methods
+
+    /// Runs the bundled askpass program as `ssh` would.
+    private static func runHelper(_ prompt: String, environment: [String: String]) async throws -> (status: Int32, output: String) {
+
+        let process = Process()
+        process.executableURL = try #require(RemoteAskpass.helperURL)
+        process.arguments = [prompt]
+        process.environment = environment.merging(["PATH": "/usr/bin:/bin"]) { $1 }
+        let pipe = Pipe()
+        process.standardOutput = pipe
+        process.standardInput = FileHandle.nullDevice
+
+        let status: Int32 = try await withCheckedThrowingContinuation { continuation in
+            process.terminationHandler = { continuation.resume(returning: $0.terminationStatus) }
+            do {
+                try process.run()
+            } catch {
+                continuation.resume(throwing: error)
+            }
+        }
+        let output = String(bytes: pipe.fileHandleForReading.readDataToEndOfFile(), encoding: .utf8) ?? ""
+
+        return (status, output)
+    }
+}
