@@ -0,0 +1,194 @@
+//
+//  RemoteHostKeyTrust.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
