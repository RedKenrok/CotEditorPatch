+// MARK: - Host View
+
+/// The terminal view with the app's keyboard and appearance adjustments.
+final class TerminalHostView: LocalProcessTerminalView {
+
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+
+        // Control-key combinations such as ⌃C, ⌃D and ⌃Z belong to the shell. Without this, a menu item
+        // that the user bound to a Control shortcut would take them before the terminal sees them.
+        let modifiers = event.modifierFlags.intersection(.deviceIndependentFlagsMask)
+        if self.window?.firstResponder === self,
+           modifiers.contains(.control), !modifiers.contains(.command)
+        {
+            self.keyDown(with: event)
+            return true
+        }
+
+        return super.performKeyEquivalent(with: event)
+    }
+
+
+    /// Starts handing the Mac's text editing shortcuts to whichever terminal view is the first responder.
+    ///
+    /// A key event monitor is the only place that sees these keys before both the main menu and SwiftTerm:
+    /// SwiftTerm's `keyDown(with:)` cannot be overridden, and while a program uses the kitty keyboard
+    /// protocol, it encodes the keys itself without passing them through `interpretKeyEvents(_:)`.
+    /// One monitor serves every terminal, so no view has to remove its own when it goes away.
+    static func installEditingShortcutMonitor() {
+
+        guard Self.editingShortcutMonitor == nil else { return }
+
+        Self.editingShortcutMonitor = NSEvent.addLocalMonitorForEvents(matching: .keyDown) { event in
+            Self.handleKeyDown(event)
+        }
+    }
+
+    private static var editingShortcutMonitor: Any?
+
+
+    /// Sends a text editing shortcut to the terminal view that is the first responder of the event's window.
+    ///
+    /// - Parameter event: A key down event.
+    /// - Returns: `nil` if a terminal handled the event, otherwise the event for AppKit to deliver.
+    static func handleKeyDown(_ event: NSEvent) -> NSEvent? {
+
+        guard
+            let view = event.window?.firstResponder as? TerminalHostView,
+            view.handleEditingShortcut(event)
+        else { return event }
+
+        return nil
+    }
+
+
+    /// Sends the bytes of a Mac text editing shortcut to the program.
+    ///
+    /// - Parameter event: A key down event for this view.
+    /// - Returns: Whether the event was a text editing shortcut and has been handled.
+    private func handleEditingShortcut(_ event: NSEvent) -> Bool {
+
+        // An input method that is composing text gets the keys to move within its own text.
+        guard !self.hasMarkedText(), let sequence = self.editingSequence(for: event) else { return false }
+
+        self.send(sequence)
+        return true
+    }
+
+
+    /// The bytes for the Mac's word and line editing keys, or `nil` to leave the event to SwiftTerm.
+    ///
+    /// These keys send what shells and line editors expect, as Terminal and iTerm's natural text editing do:
+    ///
+    /// - ⌥← and ⌥→: Emacs word movement (ESC b, ESC f).
+    /// - ⌘← and ⌘→: the start and end of the line (⌃A, ⌃E).
+    /// - ⌥⌫ and ⌘⌫: delete the word or the line before the cursor (⌃W, ⌃U).
+    /// - ⌥⌦ and ⌘⌦: delete the word or the line after the cursor (ESC d, ⌃K).
+    ///
+    /// SwiftTerm would otherwise send none of these: with Option not acting as Meta, it ignores Cocoa's word
+    /// commands, sends ⌘← and ⌘→ as word movement, and under the kitty keyboard protocol sends ⌥← as a plain ←
+    /// and ⌘← as Super-←, which programs do not bind. The same bytes therefore go to every program, whatever
+    /// keyboard protocol it asked for; programs that use that protocol still read these legacy bytes, since
+    /// most terminals send nothing else.
+    ///
+    /// A full-screen program that switches the cursor keys to application mode, such as vim, gets
+    /// Home and End for ⌘← and ⌘→ instead, since ⌃A means something else there (vim increments a number).
+    /// With Shift or Control added, the keys keep SwiftTerm's behavior.
+    private func editingSequence(for event: NSEvent) -> [UInt8]? {
+
+        guard
+            event.type == .keyDown,
+            let key = event.charactersIgnoringModifiers?.unicodeScalars.first.map({ Int($0.value) })
+        else { return nil }
+
+        let isCommand: Bool
+        switch event.modifierFlags.intersection([.shift, .control, .option, .command]) {
+            case .option: isCommand = false
+            case .command: isCommand = true
+            default: return nil
+        }
+
+        let applicationCursor = self.getTerminal().applicationCursor
+        switch (key, isCommand) {
+            case (NSLeftArrowFunctionKey, false): return EscapeSequences.emacsBack
+            case (NSRightArrowFunctionKey, false): return EscapeSequences.emacsForward
+            case (NSLeftArrowFunctionKey, true): return applicationCursor ? EscapeSequences.moveHomeApp : [0x01]
+            case (NSRightArrowFunctionKey, true): return applicationCursor ? EscapeSequences.moveEndApp : [0x05]
+            case (0x7F, false): return [0x17]
+            case (0x7F, true): return [0x15]
+            case (NSDeleteFunctionKey, false): return [0x1B, 0x64]
+            case (NSDeleteFunctionKey, true): return [0x0B]
+            default: return nil
+        }
+    }
+
+
+    override func viewDidChangeEffectiveAppearance() {
+
+        super.viewDidChangeEffectiveAppearance()
+
+        self.applyThemeColors()
+    }
+
+
+    /// The colors currently applied, to skip redrawing when nothing changed.
+    private(set) var themeColors: TerminalColors?
+
+
+    /// Applies the terminal theme for the current light or dark appearance.
+    func applyThemeColors() {
+
+        var colors = TerminalColors.current(isDark: false)
+        self.effectiveAppearance.performAsCurrentDrawingAppearance {
+            colors = TerminalColors.current(isDark: self.effectiveAppearance.isDark)
+        }
+
+        guard colors != self.themeColors else { return }
+        self.themeColors = colors
+
+        self.nativeForegroundColor = colors.foreground.usingColorSpace(.sRGB) ?? colors.foreground
+        self.nativeBackgroundColor = colors.background.usingColorSpace(.sRGB) ?? colors.background
+        self.caretColor = colors.caret.usingColorSpace(.sRGB) ?? colors.caret
+        self.selectedTextBackgroundColor = colors.selection.usingColorSpace(.sRGB) ?? colors.selection
+        self.installColors((colors.palette ?? TerminalColors.standardPalette).map(Color.init(color:)))
+
+        // The container paints the margins around the grid in the same color.
+        self.superview?.needsDisplay = true
+    }
+
+
+    /// The width that SwiftTerm keeps free on the trailing edge for its scroller.
+    ///
+    /// SwiftTerm reserves it whether or not the scroller is visible, so no column is ever drawn there.
+    var reservedScrollerWidth: CGFloat {
+
+        NSScroller.scrollerWidth(for: .regular, scrollerStyle: self.scrollerStyle)
+    }
+
+
+    /// The size of one character cell, or `nil` before the terminal has a size.
+    var cellSize: NSSize? {
+
+        // SwiftTerm snaps its cell size to the pixel grid internally and exposes it only through
+        // the optimal frame, so it is recovered from there rather than measured from the font again.
+        let terminal = self.getTerminal()
+        guard terminal.cols > 0, terminal.rows > 0 else { return nil }
+
+        let frame = self.getOptimalFrameSize()
+        let size = NSSize(width: (frame.width - self.reservedScrollerWidth) / CGFloat(terminal.cols),
+                          height: frame.height / CGFloat(terminal.rows))
+
+        guard size.width > 0, size.height > 0 else { return nil }
+
+        return size
+    }
+}
+
+
+// MARK: - Container
+
+/// Holds the terminal view, centers its character grid, and only passes usable sizes on to it.
+///
+/// Every size change of the terminal view resizes the pseudo-terminal, which the program inside sees.
+/// While the tab is hidden, or during a transient layout pass, the container can be arbitrarily small;
+/// such sizes are not forwarded, so a full-screen program never redraws for a zero-sized screen.
+///
+/// The terminal fits only whole cells, so the space left over is split evenly on all four edges
+/// instead of collecting at the trailing and bottom edges. SwiftTerm draws its scroller in a strip of
+/// its own beside the grid, so every margin is at least that wide: the strip then lies inside the
+/// trailing margin, and the grid still looks centered.
+final class TerminalContainerView: NSView {
+
+    /// The smallest size worth telling the program about.
+    private static let minimumSize = NSSize(width: 40, height: 20)
+
+    let terminalView: TerminalHostView
+
+
+    init(terminalView: TerminalHostView) {
+
+        self.terminalView = terminalView
+
+        super.init(frame: terminalView.frame)
+
+        // In a pane too small for the margins, the scroller strip would otherwise reach past the edge.
+        self.clipsToBounds = true
+
+        terminalView.autoresizingMask = []
+        self.addSubview(terminalView)
+    }
+
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+
+        fatalError("init(coder:) has not been implemented")
+    }
+
+
+    override func resizeSubviews(withOldSize oldSize: NSSize) {
+
+        super.resizeSubviews(withOldSize: oldSize)
+
+        self.fitTerminalView()
+    }
+
+
+    override func layout() {
+
+        super.layout()
+
+        self.fitTerminalView()
+    }
+
+
+    override var isOpaque: Bool {
+
+        true
+    }
+
+
+    override func draw(_ dirtyRect: NSRect) {
+
+        self.terminalView.nativeBackgroundColor.setFill()
+        dirtyRect.fill()
+    }
+
+
+    override func mouseDown(with event: NSEvent) {
+
+        // A click in the margin should work like a click on the terminal itself.
+        self.window?.makeFirstResponder(self.terminalView)
+    }
+
+
+    override func viewDidChangeBackingProperties() {
+
+        super.viewDidChangeBackingProperties()
+
+        // The cell size and the pixel grid that the margins snap to both depend on the scale.
+        self.needsLayout = true
+    }
+
+
+    private func fitTerminalView() {
+
+        guard
+            self.window != nil,
+            self.bounds.width >= Self.minimumSize.width,
+            self.bounds.height >= Self.minimumSize.height
+        else { return }
+
+        let frame = self.terminalFrame(in: self.bounds)
+
+        guard self.terminalView.frame != frame else { return }
+
+        self.terminalView.frame = frame
+    }
+
+
+    /// The frame of the terminal view that centers the largest grid of whole cells in the given bounds.
+    private func terminalFrame(in bounds: NSRect) -> NSRect {
+
+        guard let cell = self.terminalView.cellSize else { return bounds }
+
+        let scrollerWidth = self.terminalView.reservedScrollerWidth
+        let scale = self.window?.backingScaleFactor ?? 2
+        let alignToPixel = { (value: CGFloat) in (value * scale).rounded(.down) / scale }
+
+        let columns = max(1, ((bounds.width - 2 * scrollerWidth) / cell.width).rounded(.down))
+        let rows = max(1, ((bounds.height - 2 * scrollerWidth) / cell.height).rounded(.down))
+        let grid = NSSize(width: columns * cell.width, height: rows * cell.height)
+
+        let leading = alignToPixel((bounds.width - grid.width) / 2)
+        let top = alignToPixel((bounds.height - grid.height) / 2)
+
+        // SwiftTerm derives its row and column counts by dividing its size by the cell size.
+        // Half a pixel more keeps rounding errors from losing a row or column, and stays invisible:
+        // the grid is laid out from the top leading corner, which is on the pixel grid.
+        let slack = 0.5 / scale
+        let size = NSSize(width: grid.width + scrollerWidth + slack, height: grid.height + slack)
+
+        return NSRect(x: bounds.minX + leading,
+                      y: bounds.maxY - top - size.height,
+                      width: size.width,
+                      height: size.height)
+    }
+}
+
+
+private extension SwiftTerm.Color {
+    
+    /// A terminal color with the same sRGB components.
+    convenience init(color: NSColor) {
+        
+        let color = color.usingColorSpace(.sRGB) ?? color
+        let component = { (value: CGFloat) in UInt16((min(max(value, 0), 1) * 65535).rounded()) }
+        
+        self.init(red: component(color.redComponent), green: component(color.greenComponent), blue: component(color.blueComponent))
+    }
+}
