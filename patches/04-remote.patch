diff --git a/Configurations/CotEditor.xcconfig b/Configurations/CotEditor.xcconfig
index 7aa31cd21..85efb7e42 100644
--- a/Configurations/CotEditor.xcconfig
+++ b/Configurations/CotEditor.xcconfig
@@ -26,16 +26,17 @@
 // Configuration settings file format documentation can be found at:
 // https://help.apple.com/xcode/#/dev745c5c974
 
-// A shell is only useful outside the App Sandbox, so the entitlements do not enable it, and have no
-// iCloud container, which only a sandboxed app can use. The hardened runtime stays in force.
+// Shells, and the Mac's own OpenSSH client with the user's SSH configuration, keys and agent socket,
+// are only usable outside the App Sandbox, so the entitlements do not enable it, and have no iCloud
+// container, which only a sandboxed app can use. The hardened runtime stays in force.
 CODE_SIGN_ENTITLEMENTS = CotEditor/$(PRODUCT_NAME)$(CODE_SIGN_ENTITLEMENTS_SUFFIX).entitlements
 
 EXCLUDED_SOURCE_FILE_NAMES = $(inherited) Sparkle*
 
-// A separate identity keeps a development install from replacing, or sharing preferences and
-// saved window state with, a regular CotEditor installation. Anyone distributing this app must
-// replace it with an identifier in a domain they control.
-PRODUCT_BUNDLE_IDENTIFIER = local.coteditor-tabs.CotEditor-Web
+// A separate identity keeps a development install from replacing, or sharing preferences, saved
+// window state and remote recovery records with, a regular CotEditor installation or the Shell
+// or Web app. Anyone distributing this app must replace it with an identifier in a domain they control.
+PRODUCT_BUNDLE_IDENTIFIER = local.coteditor-tabs.CotEditor-Remote
 
 // Code signing may need to override any predefined values.
 // Therefore, it should be included at the end.
