+    @Test(.timeLimit(.minutes(1))) func terminalFollowsTheThemeSetting() async throws {
+        
+        let key = DefaultKeys.terminalTheme.rawValue
+        let original = UserDefaults.standard.object(forKey: key)
+        defer { UserDefaults.standard.set(original, forKey: key) }
+        UserDefaults.standard[.terminalTheme] = ""
+        
+        let engine = SwiftTermEngine()
+        defer { engine.shutDown() }
+        let host = try #require(engine.focusView as? TerminalHostView)
+        let expectedColors = {
+            var colors: TerminalColors?
+            host.effectiveAppearance.performAsCurrentDrawingAppearance {
+                colors = TerminalColors.current(isDark: host.effectiveAppearance.isDark)
+            }
+            return colors
+        }
+        #expect(host.themeColors == expectedColors(), "a new terminal starts with the theme")
+        
+        // Classic has no dark variant, so it is used in either appearance.
+        UserDefaults.standard[.terminalTheme] = "Classic"
+        #expect(TerminalColors.themeName(setting: "Classic", isDark: host.effectiveAppearance.isDark, pinsAppearance: false) == "Classic")
+        let classic = try #require(try? ThemeManager.shared.setting(name: "Classic"))
+        try await self.wait { host.themeColors == expectedColors() }
+        #expect(host.themeColors?.background == TerminalColors(theme: classic, derivesPalette: false).background, "the chosen theme is applied")
+    }
