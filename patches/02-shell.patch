+import AppKit
+import Defaults
+
+
+/// Coordinates terminals across all windows when the app quits.
+///
+/// Quitting does not close documents, so window-close confirmations never run. Instead, consent is
+/// asked once, before the unsaved-document review, and remembered until the termination either
+/// happens or is canceled. Processes are stopped only in `applicationWillTerminate`.
+@MainActor enum TerminalTermination {
+
+    private static var hasConsent = false
+    private static var isAsking = false
+
+
+    /// Every terminal in every directory window.
+    static var allSessions: [TerminalSession] {
+
+        NSDocumentController.shared.documents
+            .compactMap { $0 as? DirectoryDocument }
+            .flatMap(\.terminalSessions)
+    }
+
+
+    /// Whether quitting now would stop running work the user has not agreed to stop.
+    static var needsConsent: Bool {
+
+        !self.hasConsent && self.allSessions.contains(where: \.isLive)
+    }
+
+
+    /// Asks, once per termination attempt, whether running terminals may be stopped.
+    ///
+    /// - Returns: `true` if nothing is running or the user agreed.
+    static func requestConsent() async -> Bool {
+
+        guard self.needsConsent else { return true }
+        // A second request while the alert is up belongs to the same attempt.
+        guard !self.isAsking else { return false }
+
+        self.isAsking = true
+        defer { self.isAsking = false }
+
+        let liveCount = self.allSessions.count(where: \.isLive)
+        self.hasConsent = await TerminalPrompts.current.confirmClosing(.many(scope: .quit, liveCount: liveCount), window: nil)
+
+        return self.hasConsent
+    }
+
+
+    /// Forgets the consent after a canceled termination, so that the next attempt asks again.
+    static func revokeConsent() {
+
+        self.hasConsent = false
+    }
+
+
+    /// Stops every terminal process, waiting a bounded time in total before forcing owned groups to stop.
+    static func stopAllSessions(grace: Duration = .seconds(1)) {
+
+        let reapers = self.allSessions.compactMap { $0.closeForTermination() }
+
+        guard !reapers.isEmpty else { return }
+
+        let deadline = ContinuousClock.now + grace
+        for reaper in reapers {
+            reaper.reap(grace: max(deadline - ContinuousClock.now, .zero))
+        }
+    }
+}
+
+
+/// Changes the file-tabs preference in a way terminal tabs can survive.
+@MainActor enum TerminalTabsPreference {
+
+    private static var isChanging = false
+
+
+    /// Sets the preference, first closing every terminal tab with the user's approval when turning tabs off.
+    ///
+    /// Nothing changes before the approval, and canceling leaves the preference and every terminal as
+    /// they were. Placeholders that run nothing are closed too, since they cannot be shown without tabs.
+    ///
+    /// - Parameter usesTabs: The new value.
+    /// - Returns: `true` if the preference now has the requested value.
+    @discardableResult static func setUsesDirectoryFileTabs(_ usesTabs: Bool) async -> Bool {
+
+        guard !self.isChanging else { return false }
+
+        guard !usesTabs else {
+            UserDefaults.standard[.usesDirectoryFileTabs] = true
+            return true
+        }
+
+        let directories = NSDocumentController.shared.documents.compactMap { $0 as? DirectoryDocument }
+        let sessions = directories.flatMap(\.terminalSessions)
+
+        if !sessions.isEmpty {
+            self.isChanging = true
+            defer { self.isChanging = false }
+
+            let request = TerminalCloseRequest.many(scope: .disablingTabs, liveCount: sessions.count(where: \.isLive))
+            guard await TerminalPrompts.current.confirmClosing(request, window: nil) else { return false }
+
+            for directory in directories {
+                directory.closeAllTerminals()
+            }
+        }
+
+        UserDefaults.standard[.usesDirectoryFileTabs] = false
+
+        return true
+    }
+}
