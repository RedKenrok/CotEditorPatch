+    func outlineViewItemDidCollapse(_ notification: Notification) {
+
+        guard !self.isApplyingExpansion, self.filterText.isEmpty, let node = notification.userInfo?["NSObject"] as? RemoteDirectoryNode else { return }
+
+        guard node.isExpanded else { return }
