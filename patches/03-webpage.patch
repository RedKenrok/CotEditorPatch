+//
+//  WebPageViewController.swift
+//
+//  CotEditor
+//  https://coteditor.com
+//
+//  ---------------------------------------------------------------------------
+//
+//  © 2026 RedKenrok <rondekker.nl>
+//
+//  Licensed under the Apache License, Version 2.0 (the "License");
+//  you may not use this file except in compliance with the License.
+//  You may obtain a copy of the License at
+//
+//  https://www.apache.org/licenses/LICENSE-2.0
+//
+//  Unless required by applicable law or agreed to in writing, software
+//  distributed under the License is distributed on an "AS IS" BASIS,
+//  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+//  See the License for the specific language governing permissions and
+//  limitations under the License.
+//
+
+import AppKit
+import SwiftUI
+import WebKit
+
+
+/// Shows one webpage tab: a navigation bar, a message bar, and the tab's web view.
+///
+/// The controller owns the web view for the tab's whole life. The window keeps the controller while
+/// the tab is open, so switching tabs only moves it in and out of the window, and the page and its
+/// navigation history stay as they are. Nothing is loaded until the user submits an address or asks
+/// a restored tab to load.
+final class WebPageViewController: NSViewController, DirectoryTabViewController, NSTextFieldDelegate, WKNavigationDelegate, WKUIDelegate {
+
+    let session: WebPageSession
+
+    private weak var directoryDocument: DirectoryDocument?
+
+    private(set) lazy var webView: WKWebView = Self.makeWebView()
+    let dialogPresenter = WebPageDialogPresenter()
+
+    private let backButton = NSButton()
+    private let forwardButton = NSButton()
+    private let reloadButton = NSButton()
+    let addressField = NSTextField()
+    private let messageBar = NSStackView()
+    private let messageLabel = NSTextField(wrappingLabelWithString: "")
+    private let retryButton = NSButton()
+    private let dismissButton = NSButton()
+    private var placeholderView: NSHostingView<WebPagePlaceholderView>?
+
+    private var webViewObservations: [NSKeyValueObservation] = []
+    private var observationTask: Task<Void, Never>?
+    private var isConfirmingResubmission = false
+    private var isTornDown = false
+
+
+    // MARK: Lifecycle
+
+    init(session: WebPageSession, directoryDocument: DirectoryDocument?) {
+
+        self.session = session
+        self.directoryDocument = directoryDocument
+
+        super.init(nibName: nil, bundle: nil)
+
+        self.dialogPresenter.presentationWindow = { [weak self] in self?.dialogWindow }
+    }
+
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+
+        fatalError("init(coder:) has not been implemented")
+    }
+
+
+    isolated deinit {
+        self.observationTask?.cancel()
+    }
+
+
+    override func loadView() {
+
+        let view = NSView()
+        view.setAccessibilityElement(true)
+        view.setAccessibilityRole(.group)
+        self.view = view
+
+        let navigationBar = self.makeNavigationBar()
+        self.configureMessageBar()
+
+        self.webView.navigationDelegate = self
+        self.webView.uiDelegate = self
+        self.webView.translatesAutoresizingMaskIntoConstraints = false
+
+        let placeholderView = NSHostingView(rootView: self.makePlaceholder())
+        // The placeholder fills the content area; its content's size must never constrain the split view.
+        placeholderView.sizingOptions = []
+        placeholderView.translatesAutoresizingMaskIntoConstraints = false
+        self.placeholderView = placeholderView
+
+        let stack = NSStackView(views: [navigationBar, self.messageBar])
+        stack.orientation = .vertical
+        stack.spacing = 0
+        stack.alignment = .leading
+        stack.setHuggingPriority(.defaultHigh, for: .vertical)
+        stack.translatesAutoresizingMaskIntoConstraints = false
+
+        view.addSubview(self.webView)
+        view.addSubview(placeholderView)
+        view.addSubview(stack)
+
+        NSLayoutConstraint.activate([
+            stack.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
+            stack.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            stack.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            navigationBar.widthAnchor.constraint(equalTo: stack.widthAnchor),
+            self.messageBar.widthAnchor.constraint(equalTo: stack.widthAnchor),
+
+            self.webView.topAnchor.constraint(equalTo: stack.bottomAnchor),
+            self.webView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            self.webView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            self.webView.bottomAnchor.constraint(equalTo: view.safeAreaLayoutGuide.bottomAnchor),
+
+            placeholderView.topAnchor.constraint(equalTo: stack.bottomAnchor),
+            placeholderView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            placeholderView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            placeholderView.bottomAnchor.constraint(equalTo: view.safeAreaLayoutGuide.bottomAnchor),
+        ])
+
+        self.observeWebView()
+        self.update()
+    }
+
+
+    override func viewWillAppear() {
+
+        super.viewWillAppear()
+
+        self.update()
+
+        self.observationTask?.cancel()
+        self.observationTask = Task { [weak self, session] in
+            for await _ in Observations({ (session.lifecycle, session.failure, session.notice, session.currentURL, session.title,
+                                           session.isLoading, session.canGoBack, session.canGoForward) }) {
+                guard !Task.isCancelled else { return }
+                self?.update()
+            }
+        }
+    }
+
+
+    override func viewWillDisappear() {
+
+        super.viewWillDisappear()
+
+        // A dialog belongs to the tab on screen; switching away or closing the window takes it away.
+        self.dialogPresenter.dismiss()
+    }
+
+
+    override func viewDidDisappear() {
+
+        super.viewDidDisappear()
+
+        self.observationTask?.cancel()
+        self.observationTask = nil
+    }
+
+
+    // MARK: Public Methods
+
+    func focusTabContent() {
+
+        guard let window = self.view.window else { return }
+
+        switch self.session.lifecycle {
+            case .empty:
+                window.makeFirstResponder(self.addressField)
+            case .restored, .contentProcessEnded:
+                window.makeFirstResponder(self.placeholderView)
+            case .active, .closed:
+                window.makeFirstResponder(self.webView)
+        }
+    }
+
+
+    /// Loads what the user typed, or explains why it cannot be loaded.
+    func submitAddress(_ text: String) {
+
+        switch WebPageNavigationPolicy.url(fromTypedAddress: text) {
+            case .success(let url):
+                self.load(url)
+                self.view.window?.makeFirstResponder(self.webView)
+            case .failure(let refusal):
+                self.session.show(.init(message: refusal.message))
+        }
+    }
+
+
+    /// Loads an address that passed the navigation policy.
+    func load(_ url: URL) {
+
+        guard !self.isTornDown, WebPageNavigationPolicy.refusal(for: url) == nil else { return }
+
+        self.session.willLoad()
+        self.webView.load(URLRequest(url: url))
+        self.update()
+    }
+
+
+    /// Sends the failed navigation's request again, if it is a GET that can safely be repeated.
+    func retry() {
+
+        guard let failure = self.session.failure, failure.isRetryable, let url = failure.url else { return }
+
+        self.load(url)
+    }
+
+
+    /// Stops everything, releases the web view's delegates and observations, and takes away any dialog.
+    func tearDown() {
+
+        guard !self.isTornDown else { return }
+
+        self.isTornDown = true
+        self.dialogPresenter.dismiss()
+        self.observationTask?.cancel()
+        self.observationTask = nil
+        self.webViewObservations.removeAll()
+        if self.isViewLoaded {
+            self.webView.stopLoading()
+            self.webView.navigationDelegate = nil
+            self.webView.uiDelegate = nil
+        }
+    }
+
+
+    // MARK: Navigation Delegate
+
+    func webView(_ webView: WKWebView, decidePolicyFor navigationAction: WKNavigationAction, preferences: WKWebpagePreferences) async -> (WKNavigationActionPolicy, WKWebpagePreferences) {
+
+        guard !self.isTornDown, let url = navigationAction.request.url else { return (.cancel, preferences) }
+
+        if navigationAction.shouldPerformDownload {
+            self.session.show(.init(message: Self.downloadsUnsupportedMessage))
+            return (.cancel, preferences)
+        }
+
+        guard navigationAction.targetFrame?.isMainFrame ?? true else {
+            return (WebPageNavigationPolicy.allowsSubframe(url) ? .allow : .cancel, preferences)
+        }
+
+        if let refusal = WebPageNavigationPolicy.refusal(for: url) {
+            // The page that is showing stays as it is; a refused destination is never rewritten or retried.
+            self.session.show(.init(message: refusal.message))
+            return (.cancel, preferences)
+        }
+
+        if navigationAction.navigationType == .formResubmitted {
+            guard !self.isConfirmingResubmission else { return (.cancel, preferences) }
+            self.isConfirmingResubmission = true
+            defer { self.isConfirmingResubmission = false }
+            guard await WebPagePrompts.current.confirmResubmission(to: url, window: self.view.window), !self.isTornDown else {
+                return (.cancel, preferences)
+            }
+        }
+
+        let request = navigationAction.request
+        let isSafeToRepeat = (request.httpMethod ?? "GET").uppercased() == "GET" && request.httpBody == nil && request.httpBodyStream == nil
+            && navigationAction.navigationType != .formSubmitted && navigationAction.navigationType != .formResubmitted
+        self.session.didDecide(url: url, isSafeToRepeat: isSafeToRepeat)
+
+        return (.allow, preferences)
+    }
+
+
+    func webView(_ webView: WKWebView, decidePolicyFor navigationResponse: WKNavigationResponse) async -> WKNavigationResponsePolicy {
+
+        guard navigationResponse.isForMainFrame else { return .allow }
+
+        if !navigationResponse.canShowMIMEType {
+            self.session.show(.init(message: Self.downloadsUnsupportedMessage))
+            return .cancel
+        }
+        return .allow
+    }
+
+
+    func webView(_ webView: WKWebView, didStartProvisionalNavigation navigation: WKNavigation!) {
+
+        self.session.didStartProvisionalNavigation(Self.token(navigation, in: webView), url: webView.url)
+    }
+
+
+    func webView(_ webView: WKWebView, didReceiveServerRedirectForProvisionalNavigation navigation: WKNavigation!) {
+
+        self.session.didReceiveRedirect(Self.token(navigation, in: webView), url: webView.url)
+    }
+
+
+    func webView(_ webView: WKWebView, didCommit navigation: WKNavigation!) {
+
+        self.session.didCommit(Self.token(navigation, in: webView))
+        self.synchronizeWithWebView()
+    }
+
+
+    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
+
+        self.session.didFinish(Self.token(navigation, in: webView))
+        self.synchronizeWithWebView()
+    }
+
+
+    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: any Error) {
+
+        self.session.didFail(Self.token(navigation, in: webView), error: error)
+        self.synchronizeWithWebView()
+    }
+
+
+    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: any Error) {
+
+        self.session.didFail(Self.token(navigation, in: webView), error: error)
+        self.synchronizeWithWebView()
+    }
+
+
+    func webViewWebContentProcessDidTerminate(_ webView: WKWebView) {
+
+        self.dialogPresenter.dismiss()
+        self.session.contentProcessDidTerminate()
+        self.synchronizeWithWebView()
+    }
+
+
+    // MARK: UI Delegate
+
+    /// Loads a request for a new window in this tab, if the policy allows it.
+    ///
+    /// Scripts cannot open windows without a user gesture, so WebKit only asks here for a click. A page
+    /// that expects to talk to the new window through `window.opener` does not get one.
+    func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration, for navigationAction: WKNavigationAction, windowFeatures: WKWindowFeatures) -> WKWebView? {
+
+        guard !self.isTornDown, navigationAction.targetFrame == nil, let url = navigationAction.request.url else { return nil }
+
+        if let refusal = WebPageNavigationPolicy.refusal(for: url) {
+            self.session.show(.init(message: refusal.message))
+        } else {
+            self.session.willLoad()
+            webView.load(navigationAction.request)
+        }
+        return nil
+    }
+
+
+    func webView(_ webView: WKWebView, runJavaScriptAlertPanelWithMessage message: String, initiatedByFrame frame: WKFrameInfo) async {
+
+        _ = await self.dialogPresenter.run(WebPageDialog(kind: .alert, message: message, origin: Self.origin(of: frame)))
+    }
+
+
+    func webView(_ webView: WKWebView, runJavaScriptConfirmPanelWithMessage message: String, initiatedByFrame frame: WKFrameInfo) async -> Bool {
+
+        let response = await self.dialogPresenter.run(WebPageDialog(kind: .confirmation, message: message, origin: Self.origin(of: frame)))
+
+        return response == .confirmed(true)
+    }
+
+
+    func webView(_ webView: WKWebView, runJavaScriptTextInputPanelWithPrompt prompt: String, defaultText: String?, initiatedByFrame frame: WKFrameInfo) async -> String? {
+
+        let response = await self.dialogPresenter.run(WebPageDialog(kind: .textInput(defaultText: defaultText), message: prompt, origin: Self.origin(of: frame)))
+
+        return if case .text(let text) = response { text } else { nil }
+    }
+
+
+    // MARK: Text Field Delegate
+
+    func control(_ control: NSControl, textView: NSTextView, doCommandBy commandSelector: Selector) -> Bool {
+
+        guard control === self.addressField else { return false }
+
+        switch commandSelector {
+            case #selector(NSResponder.insertNewline(_:)):
+                self.submitAddress(self.addressField.stringValue)
+                return true
+            case #selector(NSResponder.cancelOperation(_:)):
+                // Escape gives up the edit and shows the current address again.
+                self.addressField.abortEditing()
+                self.addressField.stringValue = self.session.address?.absoluteString ?? ""
+                if self.session.lifecycle == .active {
+                    self.view.window?.makeFirstResponder(self.webView)
+                }
+                return true
+            default:
+                return false
+        }
+    }
+
+
+    func controlTextDidEndEditing(_ obj: Notification) {
+
+        self.updateAddressField()
+    }
+
+
+    // MARK: Private Methods
+
+    /// The window a website dialog may be shown on now, or `nil` if it must be answered without showing.
+    private var dialogWindow: NSWindow? {
+
+        guard
+            !self.isTornDown,
+            let window = self.view.window,
+            Self.isActiveWindow(window),
+            window.attachedSheet == nil,
+            NSApp.modalWindow == nil,
+            let directoryDocument,
+            directoryDocument.activeTabItem === self.session,
+            !directoryDocument.isConfirmingClose,
+            directoryDocument.pendingItemCloses.isEmpty
+        else { return nil }
+
+        return window
+    }
+
+
+    /// Whether the window is the one the user works in: the key or main window, or, while the app has
+    /// no main window, as when it is not active, its frontmost window.
+    private static func isActiveWindow(_ window: NSWindow) -> Bool {
+
+        if window.isKeyWindow || window.isMainWindow { return true }
+
+        guard NSApp.mainWindow == nil else { return false }
+
+        return NSApp.orderedWindows.first { $0.isVisible && $0.canBecomeMain } === window
+    }
+
+
+    private static func makeWebView() -> WKWebView {
+
+        let configuration = WKWebViewConfiguration()
+        // The app's own data store is private to its bundle identifier, and separate from Safari.
+        configuration.websiteDataStore = .default()
+        // Scripts can ask for a new window only for a user gesture.
+        configuration.preferences.javaScriptCanOpenWindowsAutomatically = false
+
+        let webView = WKWebView(frame: .zero, configuration: configuration)
+        webView.allowsBackForwardNavigationGestures = true
+        webView.setAccessibilityLabel(String(localized: "WebPageView.content.accessibilityLabel", defaultValue: "Webpage Content", table: "WebPages"))
+
+        return webView
+    }
+
+
+    private static func token(_ navigation: WKNavigation?, in webView: WKWebView) -> WebPageSession.NavigationToken {
+
+        WebPageSession.NavigationToken(navigation ?? webView)
+    }
+
+
+    private static func origin(of frame: WKFrameInfo) -> String? {
+
+        let origin = frame.securityOrigin
+
+        return WebPageDialog.origin(protocol: origin.protocol, host: origin.host, port: origin.port)
+    }
+
+
+    private static var downloadsUnsupportedMessage: String {
+
+        String(localized: "WebPageView.downloadUnsupported", defaultValue: "Webpage tabs can’t download files.", table: "WebPages",
+               comment: "message shown when a link or response in a webpage tab would download a file")
+    }
+
+
+    private func observeWebView() {
+
+        let update: @Sendable (WKWebView, Any) -> Void = { [weak self] _, _ in
+            MainActor.assumeIsolated {
+                self?.synchronizeWithWebView()
+            }
+        }
+        self.webViewObservations = [
+            self.webView.observe(\.title, changeHandler: update),
+            self.webView.observe(\.url, changeHandler: update),
+            self.webView.observe(\.isLoading, changeHandler: update),
+            self.webView.observe(\.canGoBack, changeHandler: update),
+            self.webView.observe(\.canGoForward, changeHandler: update),
+        ]
+    }
+
+
+    private func synchronizeWithWebView() {
+
+        guard !self.isTornDown else { return }
+
+        self.session.didUpdate(url: self.webView.url, title: self.webView.title, isLoading: self.webView.isLoading,
+                               canGoBack: self.webView.canGoBack, canGoForward: self.webView.canGoForward)
+        self.update()
+    }
+
+
+    private func update() {
+
+        guard self.isViewLoaded else { return }
+
+        let session = self.session
+        let isActive = (session.lifecycle == .active)
+
+        self.backButton.isEnabled = isActive && session.canGoBack
+        self.forwardButton.isEnabled = isActive && session.canGoForward
+        self.reloadButton.isEnabled = isActive || session.lifecycle == .contentProcessEnded
+        let reloadLabel = session.isLoading
+            ? String(localized: "WebPageView.stop", defaultValue: "Stop", table: "WebPages", comment: "button label")
+            : String(localized: "WebPageView.reload", defaultValue: "Reload", table: "WebPages", comment: "button label")
+        self.reloadButton.image = NSImage(systemSymbolName: session.isLoading ? "xmark" : "arrow.clockwise", accessibilityDescription: reloadLabel)
+        self.reloadButton.setAccessibilityLabel(reloadLabel)
+        self.reloadButton.toolTip = reloadLabel
+
+        self.updateAddressField()
+        self.updateMessageBar()
+
+        let showsPlaceholder = switch session.lifecycle {
+            case .empty, .restored, .contentProcessEnded: true
+            case .active: session.currentURL == nil && session.failure != nil
+            case .closed: false
+        }
+        self.placeholderView?.rootView = self.makePlaceholder()
+        self.placeholderView?.isHidden = !showsPlaceholder
+        self.webView.isHidden = showsPlaceholder && session.lifecycle != .contentProcessEnded
+
+        self.view.setAccessibilityLabel(session.title)
+    }
+
+
+    /// Shows the current address, unless the user is editing it.
+    private func updateAddressField() {
+
+        guard self.addressField.currentEditor() == nil else { return }
+
+        self.addressField.stringValue = self.session.address?.absoluteString ?? ""
+    }
+
+
+    private func updateMessageBar() {
+
+        let session = self.session
+        let showsInPlaceholder = session.failure != nil && session.currentURL == nil
+
+        if let failure = session.failure, !showsInPlaceholder {
+            self.messageLabel.stringValue = failure.description
+            self.retryButton.isHidden = !failure.isRetryable
+            self.messageBar.isHidden = false
+        } else if let notice = session.notice {
+            self.messageLabel.stringValue = notice.message
+            self.retryButton.isHidden = true
+            self.messageBar.isHidden = false
+        } else {
+            self.messageBar.isHidden = true
+        }
+    }
+
+
+    private func makePlaceholder() -> WebPagePlaceholderView {
+
+        WebPagePlaceholderView(session: self.session,
+                               load: { [weak self] in
+                                   guard let self, let url = self.session.restoredURL else { return }
+                                   self.load(url)
+                               },
+                               reload: { [weak self] in self?.reload() },
+                               retry: { [weak self] in self?.retry() },
+                               editAddress: { [weak self] in
+                                   guard let self else { return }
+                                   self.view.window?.makeFirstResponder(self.addressField)
+                               })
+    }
+
+
+    private func makeNavigationBar() -> NSView {
+
+        func configure(_ button: NSButton, symbol: String, label: String, action: Selector) {
+            button.bezelStyle = .accessoryBarAction
+            button.isBordered = false
+            button.image = NSImage(systemSymbolName: symbol, accessibilityDescription: label)
+            button.imagePosition = .imageOnly
+            button.setAccessibilityLabel(label)
+            button.toolTip = label
+            button.target = self
+            button.action = action
+            button.setContentHuggingPriority(.required, for: .horizontal)
+        }
+
+        configure(self.backButton, symbol: "chevron.backward",
+                  label: String(localized: "WebPageView.back", defaultValue: "Back", table: "WebPages", comment: "button label"),
+                  action: #selector(goBack))
+        configure(self.forwardButton, symbol: "chevron.forward",
+                  label: String(localized: "WebPageView.forward", defaultValue: "Forward", table: "WebPages", comment: "button label"),
+                  action: #selector(goForward))
+        configure(self.reloadButton, symbol: "arrow.clockwise",
+                  label: String(localized: "WebPageView.reload", defaultValue: "Reload", table: "WebPages", comment: "button label"),
+                  action: #selector(reloadOrStop))
+
+        self.addressField.placeholderString = String(localized: "WebPageView.address.placeholder", defaultValue: "Website Address", table: "WebPages",
+                                                     comment: "placeholder of the address field of a webpage tab")
+        self.addressField.setAccessibilityLabel(String(localized: "WebPageView.address.accessibilityLabel", defaultValue: "Address", table: "WebPages"))
+        self.addressField.bezelStyle = .roundedBezel
+        self.addressField.lineBreakMode = .byTruncatingTail
+        self.addressField.usesSingleLineMode = true
+        self.addressField.cell?.isScrollable = true
+        self.addressField.delegate = self
+        self.addressField.setContentHuggingPriority(.defaultLow, for: .horizontal)
+        self.addressField.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+
+        let bar = NSStackView(views: [self.backButton, self.forwardButton, self.reloadButton, self.addressField])
+        bar.orientation = .horizontal
+        bar.spacing = 4
+        // The extra space below keeps the address field from touching the page, which starts right under the bar.
+        bar.edgeInsets = NSEdgeInsets(top: 4, left: 8, bottom: 8, right: 8)
+        bar.setAccessibilityElement(true)
+        bar.setAccessibilityRole(.toolbar)
+        bar.setAccessibilityLabel(String(localized: "WebPageView.navigationBar.accessibilityLabel", defaultValue: "Navigation", table: "WebPages"))
+
+        return bar
+    }
+
+
+    private func configureMessageBar() {
+
+        self.messageLabel.textColor = .secondaryLabelColor
+        self.messageLabel.font = .preferredFont(forTextStyle: .callout)
+        self.messageLabel.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+        self.messageLabel.isSelectable = true
+
+        let icon = NSImageView(image: NSImage(systemSymbolName: "exclamationmark.triangle", accessibilityDescription: nil)!)
+        icon.contentTintColor = .systemOrange
+        icon.setContentHuggingPriority(.required, for: .horizontal)
+
+        self.retryButton.title = String(localized: "WebPageView.retry", defaultValue: "Try Again", table: "WebPages", comment: "button label")
+        self.retryButton.bezelStyle = .push
+        self.retryButton.controlSize = .small
+        self.retryButton.target = self
+        self.retryButton.action = #selector(retryFailedNavigation)
+
+        let dismissLabel = String(localized: "WebPageView.dismissMessage", defaultValue: "Dismiss", table: "WebPages", comment: "button label")
+        self.dismissButton.bezelStyle = .accessoryBarAction
+        self.dismissButton.isBordered = false
+        self.dismissButton.image = NSImage(systemSymbolName: "xmark.circle.fill", accessibilityDescription: dismissLabel)
+        self.dismissButton.imagePosition = .imageOnly
+        self.dismissButton.setAccessibilityLabel(dismissLabel)
+        self.dismissButton.toolTip = dismissLabel
+        self.dismissButton.target = self
+        self.dismissButton.action = #selector(dismissMessage)
+
+        self.messageBar.setViews([icon, self.messageLabel, self.retryButton, self.dismissButton], in: .leading)
+        self.messageBar.orientation = .horizontal
+        self.messageBar.spacing = 8
+        self.messageBar.edgeInsets = NSEdgeInsets(top: 4, left: 12, bottom: 6, right: 8)
+        self.messageBar.isHidden = true
+    }
+
+
+    private func reload() {
+
+        guard !self.isTornDown else { return }
+
+        self.session.willLoad()
+        if self.webView.url != nil {
+            self.webView.reload()
+        } else if let url = self.session.address {
+            self.load(url)
+        }
+        self.update()
+    }
+
+
+    // MARK: Action Messages
+
+    @objc private func goBack(_ sender: Any?) {
+
+        self.webView.goBack()
+    }
+
+
+    @objc private func goForward(_ sender: Any?) {
+
+        self.webView.goForward()
+    }
+
+
+    @objc private func reloadOrStop(_ sender: Any?) {
+
+        if self.session.isLoading {
+            self.webView.stopLoading()
+            self.session.didStop()
+            self.update()
+        } else {
+            self.reload()
+        }
+    }
+
+
+    @objc private func retryFailedNavigation(_ sender: Any?) {
+
+        self.retry()
+    }
+
+
+    @objc private func dismissMessage(_ sender: Any?) {
+
+        self.session.dismissMessages()
+    }
+}
+
+
+// MARK: - Messages
+
+extension WebPageNavigationPolicy.Refusal {
+
+    var message: String {
+
+        switch self {
+            case .invalidAddress:
+                String(localized: "WebPageRefusal.invalidAddress", defaultValue: "Enter a website address, such as https://example.com.", table: "WebPages")
+            case .unsupportedScheme(let scheme):
+                String(localized: "WebPageRefusal.unsupportedScheme", defaultValue: "Webpage tabs can’t open “\(scheme):” addresses.", table: "WebPages",
+                       comment: "%@ is a URL scheme such as mailto")
+            case .requiresHTTPS(let host):
+                String(localized: "WebPageRefusal.requiresHTTPS",
+                       defaultValue: "“\(host)” requires HTTPS. HTTP is only supported for local development servers.", table: "WebPages",
+                       comment: "%@ is a host name")
+            case .embeddedCredentials:
+                String(localized: "WebPageRefusal.embeddedCredentials", defaultValue: "Addresses with a user name or password aren’t supported.", table: "WebPages")
+        }
+    }
+}
+
+
+extension WebPageSession.Failure: CustomStringConvertible {
+
+    var description: String {
+
+        var text = if let url {
+            String(localized: "WebPageFailure.message", defaultValue: "“\(url.absoluteString)” couldn’t be opened: \(self.message)", table: "WebPages",
+                   comment: "first %@ is the address that failed, second %@ the reason")
+        } else {
+            self.message
+        }
+        if !self.isRetryable {
+            text += " " + String(localized: "WebPageFailure.notRetried",
+                                 defaultValue: "The request was not sent again. To try again, go back and submit it again.", table: "WebPages",
+                                 comment: "explanation after a failed form submission or other request that is not repeated automatically")
+        }
+        return text
+    }
+}
